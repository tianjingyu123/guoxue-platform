{
  "name": "guoxue-platform",
  "private": true,
  "description": "国学传统文化综合平台",
  "scripts": {
    "dev:server": "pnpm --filter @guoxue/server dev",
    "dev:admin": "pnpm --filter @guoxue/admin dev",
    "dev:mobile": "pnpm --filter @guoxue/mobile dev",
    "build:server": "pnpm --filter @guoxue/server build",
    "build:admin": "pnpm --filter @guoxue/admin build",
    "lint": "eslint . --ext .ts,.vue",
    "lint:fix": "eslint . --ext .ts,.vue --fix",
    "lint:packages": "pnpm -r lint",
    "db:migrate": "pnpm --filter @guoxue/server db:migrate",
    "db:generate": "pnpm --filter @guoxue/server db:generate",
    "test:server": "pnpm --filter @guoxue/server exec jest --config jest.config.ts --testPathPattern \"src/\"",
    "test:e2e": "pnpm --filter @guoxue/server exec jest --config jest.config.ts --testPathPattern \"test/\" --runInBand",
    "test:coverage": "pnpm --filter @guoxue/server exec jest --config jest.config.ts --coverage",
    "typecheck": "pnpm --filter @guoxue/server exec tsc --noEmit",
    "precommit": "bash scripts/pre-commit.sh",
    "prepare": "npx husky install 2>/dev/null || echo 'husky 初始化跳过（非 git 环境）'"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "form-data": "2.5.4",
      "fast-xml-parser": "4.5.4",
      "lodash": "4.18.1"
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "vue-eslint-parser": "^9.4.3"
  }
}
