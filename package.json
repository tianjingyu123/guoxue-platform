{
  "name": "guoxue-platform",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "description": "国学传统文化综合平台",
  "scripts": {
    "quickstart": "bash scripts/quick-start.sh",
    "dev:setup": "bash scripts/dev-setup.sh",
    "dev:server": "pnpm --filter @guoxue/server dev",
    "dev:admin": "pnpm --filter @guoxue/admin dev",
    "dev:mobile": "pnpm --filter @guoxue/mobile dev",
    "build:server": "pnpm --filter @guoxue/server build",
    "build:admin": "pnpm --filter @guoxue/admin build",
    "build:mobile:h5": "pnpm --filter @guoxue/mobile build:h5",
    "build:mobile:mp-weixin": "pnpm --filter @guoxue/mobile build:mp-weixin",
    "build:mobile:app": "pnpm --filter @guoxue/mobile build:app && node scripts/release/audit-mobile-native-bundle.mjs",
    "build:mobile:app-harmony": "pnpm --filter @guoxue/mobile build:app-harmony",
    "build:mobile:all": "pnpm build:mobile:h5 && pnpm build:mobile:mp-weixin && pnpm build:mobile:app && pnpm build:mobile:app-harmony",
    "build:prerequisites": "pnpm db:generate && pnpm --filter @guoxue/shared build && pnpm --filter @guoxue/bazi-engine build && pnpm --filter @guoxue/ziwei-engine build",
    "format": "prettier --write \"apps/**/*.{ts,vue,json}\" \"packages/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.{ts,vue,json}\" \"packages/**/*.ts\"",
    "lint": "eslint . --ext .ts,.vue",
    "lint:fix": "eslint . --ext .ts,.vue --fix",
    "lint:all": "eslint apps packages --ext .ts,.vue --quiet",
    "lint:packages": "pnpm -r lint",
    "db:migrate": "pnpm --filter @guoxue/server db:migrate",
    "db:generate": "pnpm --filter @guoxue/server db:generate",
    "test:server": "pnpm --filter @guoxue/server exec jest --config jest.config.ts --testPathPattern \"src/\"",
    "test:e2e": "pnpm --filter @guoxue/server exec jest --config jest.config.ts --testPathPattern \"test/\" --runInBand",
    "test:coverage": "pnpm --filter @guoxue/server exec jest --config jest.config.ts --coverage",
    "test:engines": "pnpm --filter @guoxue/bazi-engine exec jest --runInBand && pnpm --filter @guoxue/ziwei-engine exec jest --runInBand",
    "test:algorithms": "pnpm --filter @guoxue/mobile verify",
    "typecheck": "pnpm --filter @guoxue/server exec tsc --noEmit",
    "typecheck:all": "pnpm build:prerequisites && pnpm --filter @guoxue/server exec tsc --noEmit && pnpm --filter @guoxue/admin exec vue-tsc --noEmit && pnpm --filter @guoxue/mobile type-check",
    "migration:audit-domain": "node scripts/migration/audit-domain.mjs",
    "migration:test-domain-audit": "node --test tests/release/audit-domain-policy.test.mjs",
    "migration:backfill-unified-accounts": "pnpm --filter @guoxue/server exec ts-node scripts/backfill-unified-accounts.ts",
    "migration:check-env": "node scripts/migration/check-env.mjs",
    "migration:check-client-artifacts": "node scripts/migration/check-client-artifacts.mjs",
    "migration:audit-legacy-export": "node --max-old-space-size=4096 scripts/migration/audit-legacy-export.mjs",
    "release:baseline": "node scripts/release/capture-baseline.mjs",
    "release:package": "node scripts/release/create-fixed-package.mjs",
    "release:verify:package": "node scripts/release/verify-fixed-package.mjs",
    "release:audit": "node scripts/release/audit-launch-readiness.mjs",
    "release:test-launch-audit": "node --test tests/release/audit-launch-readiness.test.mjs",
    "release:audit-capabilities": "node scripts/release/audit-capability-readiness.mjs",
    "release:test-capability-audit": "node --test tests/release/audit-capability-readiness.test.mjs",
    "release:verify-business-journeys": "node scripts/release/verify-business-journeys.mjs",
    "release:test-business-journeys": "node --test tests/release/verify-business-journeys.test.mjs",
    "release:audit-public-content": "node scripts/release/audit-public-content-freshness.mjs",
    "release:test-public-content": "node --test tests/release/audit-public-content-freshness.test.mjs tests/release/verify-public-content-remediation.test.mjs",
    "release:verify-public-content-remediation": "node scripts/release/verify-public-content-remediation.mjs",
    "release:audit-interactions": "node scripts/release/audit-interaction-safety.mjs",
    "release:audit-overlays": "node scripts/release/audit-overlay-safety.mjs",
    "release:audit-merchant-fulfillment": "node scripts/release/audit-merchant-fulfillment.mjs",
    "release:audit-deps": "node scripts/release/audit-dependencies.mjs",
    "release:audit-db-baseline": "node scripts/release/audit-database-baseline.mjs",
    "release:generate-db-baseline": "node scripts/release/generate-database-baseline.mjs",
    "release:test-db-baseline-generator": "node --test tests/release/database-baseline-generator.test.mjs",
    "release:audit-infra-migration": "node scripts/release/audit-infrastructure-migration.mjs",
    "release:audit-container-images": "node scripts/release/audit-container-images.mjs",
    "release:test-container-images": "node --test tests/release/audit-container-images.test.mjs tests/release/compose-third-party-env.test.mjs tests/release/admin-qa-environment.test.mjs tests/release/prisma-cli-config.test.mjs",
    "release:verify-container-runtime": "node -- scripts/release/verify-container-images.mjs",
    "release:test-container-runtime": "node --test tests/release/verify-container-images.test.mjs",
    "release:audit-workflow-supply-chain": "node scripts/release/audit-workflow-supply-chain.mjs",
    "release:test-workflow-supply-chain": "node --test tests/release/audit-workflow-supply-chain.test.mjs",
    "release:audit-infra-intake": "node -- scripts/release/audit-infrastructure-intake.mjs",
    "release:prepare-infra-intake": "node scripts/release/prepare-infrastructure-intake.mjs",
    "release:build-app-links": "node -- scripts/release/build-app-link-associations.mjs",
    "release:probe-app-links": "node -- scripts/release/probe-app-link-associations.mjs",
    "release:test-app-links": "node --test tests/release/app-link-associations.test.mjs",
    "release:test-mobile-native-bundle": "node --test tests/release/mobile-auth-interest-onboarding.test.mjs tests/release/mobile-auth-guest-entry.test.mjs tests/release/mobile-video-gesture-ownership.test.mjs tests/release/mobile-video-viewer-state.test.mjs tests/release/mobile-video-comment-keyboard.test.mjs tests/release/mobile-short-video-app-layer.test.mjs tests/release/mobile-renderjs-runtime.test.mjs tests/release/mobile-wechat-app-payment.test.mjs tests/release/mobile-legacy-paipan-payment.test.mjs tests/release/mobile-legacy-paipan-share.test.mjs tests/release/mobile-native-bundle.test.mjs tests/release/mobile-course-text-player.test.mjs tests/release/mobile-classics-overlay-scroll.test.mjs tests/release/mobile-native-share-channels.test.mjs tests/release/mobile-shop-checkout-address.test.mjs tests/release/mobile-shop-trust-labels.test.mjs tests/release/mobile-comment-entry-focus.test.mjs tests/release/mobile-vip-error-state.test.mjs tests/release/mobile-paipan-tool-routes.test.mjs tests/release/paipan-legacy-isolation.test.mjs tests/release/mobile-main-tab-scroll-safe-area.test.mjs tests/release/frontend-accessibility-baseline.test.mjs tests/release/mobile-mp-wxml-validator.test.mjs tests/release/mobile-app-entry-link.test.mjs tests/release/mobile-live-safe-area.test.mjs tests/release/live-commerce-integrity.test.mjs tests/release/mobile-legacy-paipan-return.test.mjs tests/release/mobile-legacy-paipan-auth-gate.test.mjs tests/release/mobile-custom-navigation-safe-area.test.mjs tests/release/mobile-ios-startup-recovery.test.mjs tests/release/mobile-apple-login.test.mjs",
    "release:test-admin-console": "node --test --test-isolation=none tests/release/admin-console-governance.test.mjs tests/release/admin-category-statistics.test.mjs tests/release/admin-pending-queues.test.mjs tests/release/admin-unified-integration.test.mjs apps/admin/tests/platform-permission-snapshot.test.mjs apps/admin/tests/platform-permission-reactivity.test.mjs apps/admin/tests/topic-screen.test.mjs",
    "release:test-infra-intake": "node --test tests/release/audit-infrastructure-intake.test.mjs tests/release/prepare-infrastructure-intake.test.mjs tests/release/storage-inventory.test.mjs tests/release/app-link-associations.test.mjs tests/release/sanitize-wechat-payment-env.test.mjs",
    "release:inventory-storage": "node scripts/release/build-storage-inventory.mjs",
    "release:compare-storage-inventory": "node scripts/release/compare-storage-inventories.mjs",
    "release:test-storage-inventory": "node --test tests/release/storage-inventory.test.mjs",
    "release:test-migration-export": "node --test tests/release/export-postgres-snapshot.test.mjs",
    "release:test-pg-backup-target": "node --test tests/release/pg-backup-target.test.mjs",
    "release:test-tls-renewal": "node --test tests/release/tls-renewal.test.mjs",
    "release:test-migration-verification": "node --test tests/release/verify-postgres-evidence.test.mjs",
    "release:test-env-checker": "node --test tests/release/check-env.test.mjs",
    "release:test-source-freeze": "node --test tests/release/audit-source-freeze.test.mjs tests/release/resolve-pnpm-invocation.test.mjs tests/release/run-full-gate.test.mjs",
    "release:audit-source-freeze": "node scripts/release/audit-source-freeze.mjs",
    "release:audit-retention": "node scripts/release/audit-release-retention.mjs",
    "release:validate-dispatch": "node scripts/release/validate-production-dispatch.mjs",
    "release:test-dispatch-gate": "node --test tests/release/validate-production-dispatch.test.mjs tests/release/predeploy-readiness-workflow.test.mjs",
    "release:test-package-verifier": "node --test tests/release/verify-fixed-package.test.mjs tests/release/client-evidence-consistency.test.mjs",
    "release:test-retention": "node --test tests/release/audit-release-retention.test.mjs",
    "release:test-client-artifacts": "node --test tests/release/audit-client-artifacts.test.mjs tests/release/verify-client-artifacts.test.mjs",
    "release:aggregate-evidence": "node scripts/release/aggregate-launch-evidence.mjs",
    "release:aggregate-predeploy": "node scripts/release/aggregate-predeploy-evidence.mjs",
    "release:finalize-launch": "node scripts/release/finalize-launch-acceptance.mjs",
    "release:test-evidence": "node --test tests/release/aggregate-launch-evidence.test.mjs tests/release/finalize-launch-acceptance.test.mjs",
    "release:verify-predeploy-decision": "node scripts/release/verify-predeploy-decision.mjs",
    "release:test-predeploy-evidence": "node --test tests/release/aggregate-predeploy-evidence.test.mjs tests/release/verify-predeploy-decision.test.mjs",
    "release:audit-monitoring": "node scripts/release/audit-monitoring-readiness.mjs",
    "release:test-monitoring-renderer": "node --test tests/release/render-monitoring-config.test.mjs",
    "release:test-tencent-cloud-audit": "node --test tests/release/audit-tencent-cloud-readiness.test.mjs",
    "release:audit-runtime": "node scripts/release/audit-runtime-readiness.mjs",
    "release:render-monitoring": "node scripts/release/render-monitoring-config.mjs",
    "release:preflight:host": "bash scripts/release/preflight-host.sh",
    "release:audit-host-preflight": "node -- scripts/release/audit-host-preflight.mjs",
    "release:test-host-preflight": "node --test tests/release/audit-host-preflight.test.mjs",
    "release:test-layout": "node --test tests/release/validate-release-layout.test.mjs",
    "release:test-cutover": "node --test tests/release/verify-production-cutover.test.mjs",
    "release:test-rollback": "node --test tests/release/rollback-fixed-release.test.mjs",
    "release:verify:runtime": "node scripts/release/verify-runtime.mjs",
    "release:test-public-dns": "node --test tests/release/public-dns.test.mjs",
    "release:test-public-tls": "node --test tests/release/public-tls.test.mjs",
    "release:audit-client-artifacts": "node scripts/release/audit-client-artifacts.mjs",
    "release:verify-client-artifacts": "node scripts/release/verify-client-artifacts.mjs",
    "release:create-client-config-binding": "node scripts/release/create-client-config-binding.mjs",
    "release:verify-client-config-binding": "node scripts/release/verify-client-config-binding.mjs",
    "release:test-client-config-binding": "node --test tests/release/client-config-binding.test.mjs",
    "release:audit-nginx": "node scripts/release/audit-nginx-readiness.mjs",
    "release:audit-store": "node scripts/release/audit-store-readiness.mjs",
    "release:test-store-audit": "node --test tests/release/audit-store-readiness.test.mjs",
    "release:audit-migration": "node scripts/release/audit-migration-readiness.mjs",
    "release:check-nav": "node --test tests/release/check-nav-paths.test.mjs && node scripts/check-nav-paths.js",
    "release:gate:code": "pnpm release:audit -- --strict && pnpm release:test-launch-audit && pnpm release:audit-capabilities && pnpm release:test-capability-audit && pnpm release:test-business-journeys && pnpm release:test-public-content && pnpm release:audit-interactions && pnpm release:audit-overlays && pnpm release:audit-merchant-fulfillment && pnpm release:audit-migration && pnpm release:audit-infra-migration && pnpm release:audit-container-images && pnpm release:test-container-images && pnpm release:test-container-runtime && pnpm release:audit-workflow-supply-chain && pnpm release:test-workflow-supply-chain && pnpm release:test-infra-intake && pnpm release:test-migration-export && pnpm release:test-pg-backup-target && pnpm release:test-tls-renewal && pnpm release:test-public-dns && pnpm release:test-public-tls && pnpm release:test-migration-verification && pnpm release:test-env-checker && pnpm release:test-source-freeze && pnpm release:test-predeploy-evidence && pnpm release:test-dispatch-gate && pnpm release:test-package-verifier && pnpm release:test-retention && pnpm release:test-client-artifacts && pnpm release:test-client-config-binding && pnpm release:test-host-preflight && pnpm release:test-layout && pnpm release:test-cutover && pnpm release:test-rollback && pnpm release:test-evidence && pnpm release:audit-monitoring && pnpm release:test-monitoring-renderer && pnpm release:test-tencent-cloud-audit && pnpm release:test-store-audit && pnpm release:audit-runtime && pnpm release:test-mobile-native-bundle && pnpm release:test-admin-console && pnpm release:check-nav && pnpm migration:test-domain-audit && pnpm migration:audit-domain && pnpm release:test-db-baseline-generator && pnpm release:audit-db-baseline && pnpm release:audit-nginx && pnpm release:audit-deps",
    "release:gate:store": "pnpm release:test-store-audit && pnpm release:audit-store -- --strict",
    "release:gate": "pnpm release:gate:code && pnpm migration:check-env",
    "release:verify:local": "pnpm release:gate:code && pnpm lint:all && pnpm typecheck:all && pnpm test:engines && pnpm test:algorithms && pnpm test:server && pnpm test:e2e && pnpm build:server && pnpm build:admin && pnpm build:mobile:all",
    "release:build:clients": "node scripts/release/build-clients-with-env.mjs",
    "release:gate:predeploy": "node -- scripts/release/run-full-gate.mjs --stage predeploy",
    "release:gate:full": "node -- scripts/release/run-full-gate.mjs",
    "precommit": "bash scripts/pre-commit.sh",
    "prepare": "npx husky install 2>/dev/null || echo 'husky 初始化跳过（非 git 环境）'"
  },
  "engines": {
    "node": ">=22 <23 || >=24 <25",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sweph",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ],
    "overrides": {
      "fast-xml-parser": "4.5.5",
      "@grpc/grpc-js": "1.14.4",
      "@intlify/message-resolver": "9.1.11",
      "@opentelemetry/propagator-jaeger": "2.9.0",
      "adm-zip": "0.6.0",
      "form-data": "2.5.6",
      "immutable": "5.1.8",
      "jpeg-js": "0.4.4",
      "js-yaml": "4.3.1",
      "lodash": "4.18.1",
      "multer": "2.2.0",
      "nanoid": "3.3.18",
      "deepmerge-ts": "8.0.0",
      "picomatch": "4.0.4",
      "postcss": "8.5.18",
      "browserslist": "4.28.7",
      "rollup": "4.59.0",
      "protobufjs": "8.4.1",
      "glob": "10.5.0",
      "vod-js-sdk-v6>axios": "1.18.0",
      "subscriptions-transport-ws>ws": "7.5.11",
      "@dcloudio/uni-mp-weixin>ws": "8.21.0",
      "@nestjs/graphql>ws": "8.21.0",
      "engine.io>ws": "8.21.0",
      "socket.io-adapter>ws": "8.21.0",
      "socket.io-parser": "4.2.7",
      "@intlify/core-base": "9.14.5",
      "@intlify/message-compiler": "9.14.5",
      "@intlify/shared": "9.14.5"
    }
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "libsodium-wrappers": "^0.8.4",
    "prettier": "^3.8.3",
    "pretty-quick": "^4.2.2",
    "puppeteer": "^25.2.0",
    "vue-eslint-parser": "^9.4.3"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3"
  }
}
