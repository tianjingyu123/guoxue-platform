+<template>
+  <view class="min-h-screen bg-primary flex flex-col items-center justify-center relative overflow-hidden">
+    <!-- 背景装饰 -->
+    <view class="absolute inset-0">
+      <view v-for="i in 20" :key="i" class="absolute w-1 h-1 bg-primary-foreground/20 rounded-full" :style="`top:${Math.random()*100}%;left:${Math.random()*100}%;`" />
+    </view>
+
+    <!-- 山峦 SVG 装饰 -->
+    <view class="absolute bottom-0 left-0 right-0 opacity-10">
+      <svg viewBox="0 0 375 120" xmlns="http://www.w3.org/2000/svg" class="w-full">
+        <path d="M0 120 L80 40 L160 80 L240 20 L320 60 L375 30 L375 120 Z" fill="currentColor" class="text-primary-foreground"/>
+      </svg>
+    </view>
+
+    <!-- Logo 和品牌 -->
+    <view class="relative z-10 flex flex-col items-center gap-6 text-primary-foreground">
+      <!-- 太极图标 -->
+      <view class="w-24 h-24 rounded-full border-4 border-primary-foreground/40 flex items-center justify-center relative">
+        <view class="w-16 h-16 rounded-full overflow-hidden relative">
+          <view class="absolute left-0 top-0 w-8 h-16 bg-primary-foreground" />
+          <view class="absolute right-0 top-0 w-8 h-16 bg-primary" />
+          <view class="absolute top-2 left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-primary" />
+          <view class="absolute bottom-2 left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-primary-foreground" />
+        </view>
+      </view>
+
+      <view class="text-center">
+        <text class="text-3xl font-bold block tracking-widest">玄易阁</text>
+        <text class="text-primary-foreground/70 text-sm mt-2 block tracking-wider">传统文化·智慧传承</text>
+      </view>
+
+      <!-- 加载进度 -->
+      <view class="w-48 mt-4">
+        <view class="h-1 bg-primary-foreground/20 rounded-full overflow-hidden">
+          <view class="h-full bg-primary-foreground rounded-full transition-all duration-300" :style="`width:${progress}%`" />
+        </view>
+        <text class="text-primary-foreground/50 text-xs text-center block mt-2">{{ progress }}%</text>
+      </view>
+    </view>
+
+    <!-- 跳过按钮 -->
+    <view class="absolute top-12 right-4 bg-black/20 px-3 py-1.5 rounded-full" @tap="handleSkip">
+      <text class="text-primary-foreground text-xs">跳过 {{ countdown }}s</text>
+    </view>
+  </view>
+</template>
+
+<script setup lang="ts">
+import { ref, onMounted, onUnmounted } from 'vue'
+
+const progress = ref(0)
+const countdown = ref(3)
+let progressTimer: ReturnType<typeof setInterval>
+let countTimer: ReturnType<typeof setInterval>
+
+const handleSkip = () => {
+  clearInterval(progressTimer)
+  clearInterval(countTimer)
+  uni.switchTab({ url: '/pages/index/index' })
+}
+
+onMounted(() => {
+  progressTimer = setInterval(() => {
+    progress.value = Math.min(progress.value + 5, 100)
+    if (progress.value >= 100) clearInterval(progressTimer)
+  }, 80)
+
+  countTimer = setInterval(() => {
+    countdown.value--
+    if (countdown.value <= 0) {
+      clearInterval(countTimer)
+      uni.switchTab({ url: '/pages/index/index' })
+    }
+  }, 1000)
+})
+
+onUnmounted(() => {
+  clearInterval(progressTimer)
+  clearInterval(countTimer)
+})
+</script>
