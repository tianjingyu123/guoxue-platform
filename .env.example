# ═══════════════════════════════════════════
# 国学平台 — 环境变量配置
# ═══════════════════════════════════════════
# 复制此文件为 .env 并按需修改配置

# ────────── 数据库 ──────────
DATABASE_URL=postgresql://guoxue:guoxue123@localhost:5432/guoxue

# ────────── Redis ──────────
REDIS_URL=redis://localhost:6379

# ────────── JWT ──────────
JWT_SECRET=change-me-in-production-use-random-64-char-string
# JWT 密钥轮换历史（逗号分隔，旧密钥在过渡期内仍可验证）
JWT_PREVIOUS_SECRETS=

# ────────── 数据加密密钥 (AES-256-GCM, 必须32字节) ──────────
ENCRYPTION_KEY=change-me-in-production-use-32-char-key!

# ────────── 大屏展示认证 ──────────
BIGSCREEN_SECRET=change-me-in-production

# ────────── 服务 ──────────
PORT=3000
NODE_ENV=development
PRISMA_SLOW_QUERY_MS=500
CORS_ORIGIN=

# ────────── 公网入口（换域名只改这里；URL 不带结尾斜杠，H5 可带） ──────────
PUBLIC_DOMAIN=api.example.com
PUBLIC_API_URL=https://api.example.com
PUBLIC_H5_URL=https://api.example.com/h5/
PUBLIC_ASSET_ORIGIN=https://cdn.example.com
COOKIE_DOMAIN=.example.com
WS_CORS_ORIGIN=https://api.example.com
# Vite 构建时注入，须与服务端公网入口一致；不要带 /api/v1，客户端会自动追加。
VITE_API_URL=https://api.example.com
VITE_PUBLIC_H5_URL=https://api.example.com/h5/
VITE_PUBLIC_ASSET_ORIGIN=https://cdn.example.com

# ────────── 腾讯云基础凭证 (AI/OCR/ASR/NLP/SMS/Live/VOD 共用) ──────────
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_CREDENTIAL_MODE=static
TENCENT_CVM_ROLE_NAME=
TENCENT_APP_ID=
TENCENT_TTS_REGION=ap-guangzhou

# ────────── 腾讯云 COS (对象存储/文件上传) ──────────
# auto=开发环境可回退本地盘；腾讯云双节点部署强制为 cos。
STORAGE_PROVIDER=auto
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_CDN_BASE=

# ────────── 腾讯云 IM ──────────
IM_APP_ID=
IM_ADMIN_KEY=
IM_ADMIN_ID=
IM_PRIVATE_KEY=
IM_PUBLIC_KEY=

# ────────── 腾讯云 TRTC (真人通话/AI 实时语音) ──────────
# 只能放在服务端；客户端 UserSig 必须由后端临时签发，严禁把 SecretKey 打进 H5/小程序/App。
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=
LIVE_MULTI_GUEST_MIXING_ENABLED=false
LIVE_OBS_TRTC_INGEST_ENABLED=false
TRTC_CALLBACK_KEY=

# ────────── 腾讯云直播 ──────────
LIVE_PUSH_DOMAIN=
LIVE_PLAY_DOMAIN=
LIVE_PUSH_KEY=
LIVE_PLAY_KEY=
LIVE_APP_NAME=

# ────────── 腾讯云点播 ──────────
VOD_SUB_APP_ID=

# ────────── 腾讯云短信 ──────────
SMS_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
SMS_CHURN_TEMPLATE_ID=

# ────────── 腾讯地图 ──────────
TENCENT_MAP_KEY=

# ────────── 微信开放平台 ──────────
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_OFFICIAL_APPID=
WECHAT_OFFICIAL_APP_SECRET=
# 小程序 AppId (不同小程序共用时配置)
WECHAT_MINI_APP_ID=
MINIPROGRAM_APP_SECRET=
# 公众号 AppId
WECHAT_MP_APP_ID=

# 同一套后端接入多个小程序/公众号/APP 时使用。clientKey 可自定义；同一微信开放平台下
# openPlatformId 必须一致。JSON 只配置在服务端，严禁放入 VITE_* 前端变量。
# WECHAT_LOGIN_CLIENTS_JSON={"rebu-mini":{"type":"miniprogram","appId":"wx...","appSecret":"...","openPlatformId":"rebu","isDefault":true},"rebu-h5":{"type":"h5","appId":"wx...","appSecret":"...","openPlatformId":"rebu","isDefault":true},"rebu-app":{"type":"app","appId":"wx...","appSecret":"...","openPlatformId":"rebu","isDefault":true}}
WECHAT_LOGIN_CLIENTS_JSON=
WECHAT_OPEN_PLATFORM_ID=
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
# 可选：额外允许的公众号 OAuth 回调源，逗号分隔；默认已允许 PUBLIC_H5_URL/PUBLIC_API_URL 同源
WECHAT_OAUTH_ALLOWED_ORIGINS=

# 客户端仅保存公开 clientKey（或留空，由微信小程序运行时自动上送 appId）
VITE_WECHAT_CLIENT_KEY=

# Sign in with Apple identityToken 的服务端 audience，必须与 iOS Bundle ID 完全一致
APPLE_LOGIN_AUDIENCE=com.rebu.iosapprebu

# ────────── 微信支付 V3 ──────────
WECHAT_PAY_MCH_ID=
WECHAT_PAY_ALLOWED_MCH_ID=
WECHAT_PAY_DB_CONFIG_VERIFIED=false
WECHAT_PAY_CALLBACK_KEY_MODE=PLATFORM_CERT
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_API_V3_KEY=
# 私钥内容 (PEM 格式) 或私钥文件路径 (二选一)
WECHAT_PAY_PRIVATE_KEY=
# WECHAT_PAY_PRIVATE_KEY_PATH=
# 新商户默认使用微信支付公钥模式：公钥内容/路径 + 公钥ID必须成对配置
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_REFUND_NOTIFY_URL=
WECHAT_PAY_TRANSFER_NOTIFY_URL=

# ────────── 支付宝 ──────────
ALIPAY_APP_ID=
ALIPAY_SANDBOX=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 或使用证书路径 (二选一)
# ALIPAY_PRIVATE_KEY_PATH=
# ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_NOTIFY_URL=

# ────────── 银联支付 ──────────
UNIONPAY_MER_ID=
UNIONPAY_SANDBOX=
UNIONPAY_PRIVATE_KEY=
UNIONPAY_PUBLIC_KEY=
# 或使用证书路径 (二选一)
# UNIONPAY_PFX_PATH=
# UNIONPAY_PFX_PASSWORD=
# UNIONPAY_PUBLIC_KEY_PATH=
UNIONPAY_NOTIFY_URL=

# ────────── 汇付聚合支付（密钥建议通过后台加密保存）──────────
HUIFU_DB_CONFIG_VERIFIED=false
HUIFU_MIGRATE_LEGACY_CONFIG=false
HUIFU_BASE_URL=https://api.huifu.com
HUIFU_APP_ID=
HUIFU_MERCHANT_ID=
HUIFU_UPPER_HUIFU_ID=
HUIFU_PRODUCT_ID=
HUIFU_SECRET_KEY=
HUIFU_RSA_PRIVATE_KEY=
HUIFU_RSA_PUBLIC_KEY=
HUIFU_NOTIFY_URL=

# ────────── 快递物流 ──────────
KUAIDI100_API_KEY=
KUAIDI100_CUSTOMER=
KUAIDI100_CALLBACK_URL=
KUAIDI100_SALT=

# ────────── AI ──────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Claude/Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# 阿里云 DashScope (通义千问)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 本地模型 (Ollama/vLLM)
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL_API_KEY=

# ────────── COZE 智能体 ──────────
COZE_API_KEY=
COZE_BOT_ID=

# ────────── 邮件服务 ──────────
EMAIL_MODE=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# ────────── 企业微信机器人 ──────────
WEWORK_WEBHOOK_URL=
WEWORK_WEBHOOK_ALERT_URL=
# 首发期旧排盘兼容：生产初期设 true，稳定迁移后通过灰度关闭。
PAIPAN_MODE=legacy
PAIPAN_LEGACY_DISPLAY_VERSION=1
PAIPAN_NATIVE_QA_ENABLED=false
PAIPAN_NATIVE_QA_HOST=pre-api.rebugx.cn
PAIPAN_NATIVE_QA_ALLOWLIST=
PAIPAN_OPERATION_H5_BASE=https://www.yrydai.cn/guoxueApp.php
PAIPAN_USER_LOOKUP_URL=https://www.yrydai.cn/recommend/mobileUser.php
PAIPAN_PARTNER_OPEN_URL=https://www.yrydai.cn/recommend/partner.php
PAIPAN_PARTNER_OAUTH_URL=https://www.yrydai.cn/my.php?mod=member&act=addPartner
PAIPAN_REFERRAL_BASE=https://www.yrydai.com/p1.php
# 兼容旧部署变量；新部署以 PAIPAN_MODE/PAIPAN_OPERATION_H5_BASE 为准。
PAIPAN_LEGACY_MODE=true
PAIPAN_H5_BASE=https://www.yrydai.cn/guoxueApp.php
