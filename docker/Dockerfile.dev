# ─────────────────────────────────────────────
# 开发镜像 — 热重载 + 全量依赖
# ─────────────────────────────────────────────
FROM node:24.18.0-alpine3.23@sha256:595398b0081eacda8e1c4c5b97b76cd1020e4d58a8ebcb4843b9bca1e79e7436 AS builder
RUN corepack enable && corepack prepare pnpm@10.33.3 --activate
WORKDIR /app

# 依赖缓存层
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/server/package.json apps/server/
COPY packages/shared/package.json packages/shared/
COPY packages/bazi-engine/package.json packages/bazi-engine/
COPY packages/ziwei-engine/package.json packages/ziwei-engine/

RUN pnpm install --frozen-lockfile

# 源代码 + 构建
COPY . .
RUN npx prisma generate --schema=apps/server/prisma/schema.prisma
RUN pnpm --filter @guoxue/bazi-engine build
RUN pnpm --filter @guoxue/ziwei-engine build
RUN pnpm build:server

# ── 开发运行阶段 ──
FROM node:24.18.0-alpine3.23@sha256:595398b0081eacda8e1c4c5b97b76cd1020e4d58a8ebcb4843b9bca1e79e7436
RUN corepack enable && corepack prepare pnpm@10.33.3 --activate
RUN apk add --no-cache curl
WORKDIR /app

# 复制全量 node_modules（含 devDeps，支持热重载 + 测试）
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/server/node_modules ./apps/server/node_modules
COPY --from=builder /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=builder /app/packages/bazi-engine/node_modules ./packages/bazi-engine/node_modules
COPY --from=builder /app/packages/ziwei-engine/node_modules ./packages/ziwei-engine/node_modules

# 构建产物
COPY --from=builder /app/apps/server/dist ./apps/server/dist
COPY --from=builder /app/apps/server/prisma ./apps/server/prisma
COPY --from=builder /app/apps/server/package.json ./apps/server/
COPY --from=builder /app/packages/bazi-engine/dist ./packages/bazi-engine/dist
COPY --from=builder /app/packages/bazi-engine/package.json ./packages/bazi-engine/
COPY --from=builder /app/packages/ziwei-engine/dist ./packages/ziwei-engine/dist
COPY --from=builder /app/packages/ziwei-engine/package.json ./packages/ziwei-engine/
COPY --from=builder /app/package.json ./

# 入口
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 3000
ENTRYPOINT ["/entrypoint.sh"]
# 默认由 dev compose 覆盖为 node --watch
CMD ["node", "apps/server/dist/main.js"]
