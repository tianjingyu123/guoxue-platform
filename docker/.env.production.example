SMTP_USER=
SMTP_PASS=
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=
WEWORK_WEBHOOK_URL=
WEWORK_WEBHOOK_ALERT_URL=

# ── 可观测性与值班告警 ──
MONITORING_ENABLED=true
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me-use-a-long-random-grafana-password
# Alertmanager 使用企业微信“自建应用”，不是群机器人 webhook。
WEWORK_CORP_ID=
WEWORK_AGENT_ID=
WEWORK_AGENT_SECRET=
DBA_WEWORK_USER_IDS=
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318/v1/traces
OTEL_SERVICE_NAME=guoxue-platform
# 新系统首发默认使用自研排盘；仅在明确执行第三方旧排盘回滚时临时改为 true。
PAIPAN_MODE=native
PAIPAN_LEGACY_DISPLAY_VERSION=1
PAIPAN_NATIVE_QA_ENABLED=false
PAIPAN_NATIVE_QA_HOST=pre-api.rebugx.cn
PAIPAN_NATIVE_QA_ALLOWLIST=
PAIPAN_OPERATION_H5_BASE=https://www.yrydai.cn/guoxueApp.php
