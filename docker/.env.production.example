# 国学平台生产环境模板
# 复制为 docker/.env.production 后填写真实值。所有 change-me / example.com 均会被发布门禁拒绝。

# ── 运行环境 ──
# DEPLOY_TARGET 不从本文件静默推断。运行 setup/deploy/health-check/backup/rollback 时，
# 必须在命令或受控服务环境中显式传入同一个 standard 或 tencent。
NODE_ENV=production
COMPOSE_PROJECT_NAME=guoxue
RUN_DB_MIGRATIONS=false
PRISMA_SLOW_QUERY_MS=500

# ── 数据库与缓存 ──
# standard：可使用容器内主机名 postgres / redis，DB_PASSWORD 供本机 PostgreSQL 使用。
# tencent：DATABASE_URL / DATABASE_REPLICA_URL / REDIS_URL 必须改成已验收的托管服务私网地址，
#           并按供应商要求配置 TLS；不得保留 postgres / redis 容器名或本地回环地址。
DB_PASSWORD=change-me-use-a-long-random-database-password
DATABASE_URL=postgresql://guoxue:change-me-use-a-long-random-database-password@postgres:5432/guoxue?connection_limit=20&pool_timeout=10
DATABASE_REPLICA_URL=
REDIS_URL=redis://redis:6379

# ── 应用密钥 ──
# JWT_SECRET / BIGSCREEN_SECRET 建议使用 64 字节以上随机串；ENCRYPTION_KEY 必须恰好 32 字节。
JWT_SECRET=change-me-use-a-random-string-with-at-least-64-bytes
JWT_PREVIOUS_SECRETS=
ENCRYPTION_KEY=change-me-exactly-32-byte-key!!
BIGSCREEN_SECRET=change-me-use-a-random-string-with-at-least-32-bytes

# ── 新域名与跨域 ──
PUBLIC_DOMAIN=api.example.com
PUBLIC_API_URL=https://api.example.com
PUBLIC_H5_URL=https://api.example.com/h5/
PUBLIC_ASSET_ORIGIN=https://cdn.example.com
COOKIE_DOMAIN=.example.com
CORS_ORIGIN=https://api.example.com
WS_CORS_ORIGIN=https://api.example.com
NGINX_SERVER_NAMES=api.example.com

# Vite 构建时注入，必须与上方公网入口一致；不要带 /api/v1，客户端会自动追加。
VITE_API_URL=https://api.example.com
VITE_PUBLIC_H5_URL=https://api.example.com/h5/
VITE_PUBLIC_ASSET_ORIGIN=https://cdn.example.com

# 迁移双域并行期旧来源，逗号分隔；正式切换完成后清空。
MIGRATION_OLD_ORIGINS=

# ── 腾讯云通用凭证（内容审核 / OCR / ASR / TTS / 短信 / 直播 / 点播） ──
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_CREDENTIAL_MODE=static
TENCENT_CVM_ROLE_NAME=
TENCENT_APP_ID=
TENCENT_TTS_REGION=ap-guangzhou
TENCENT_ASR_REGION=ap-guangzhou
TENCENT_ASR_ENGINE=16k_zh

# ── 对象存储 ──
# 腾讯云双节点必须使用 COS，禁止本地盘静默兜底
STORAGE_PROVIDER=cos
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_BUCKET=your-bucket-name-1250000000
COS_REGION=ap-beijing
COS_CDN_BASE=https://static.example.com

# ── 即时通讯与实时语音 ──
IM_APP_ID=
IM_ADMIN_KEY=
IM_ADMIN_ID=administrator
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=

# ── 直播与点播 ──
LIVE_PUSH_DOMAIN=
LIVE_PLAY_DOMAIN=
LIVE_PUSH_KEY=
LIVE_PLAY_KEY=
LIVE_APP_NAME=live
VOD_SUB_APP_ID=

# ── 短信与地图 ──
SMS_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
SMS_CHURN_TEMPLATE_ID=
TENCENT_MAP_KEY=
TENCENT_MAP_SK=

# ── 微信 ──
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_OFFICIAL_APPID=
WECHAT_OFFICIAL_APP_SECRET=
WECHAT_MINI_APP_ID=
MINIPROGRAM_APP_SECRET=
WECHAT_MP_APP_ID=

# ── 微信支付 V3 ──
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/v1/shop/pay/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://api.example.com/api/v1/shop/refund/notify

# ── 支付宝 / 银联 / 汇付 ──
ALIPAY_APP_ID=
ALIPAY_SANDBOX=false
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://api.example.com/api/v1/shop/alipay/notify
UNIONPAY_MER_ID=
UNIONPAY_SANDBOX=false
UNIONPAY_PRIVATE_KEY=
UNIONPAY_PUBLIC_KEY=
UNIONPAY_NOTIFY_URL=https://api.example.com/api/v1/shop/unionpay/notify
HUIFU_NOTIFY_URL=https://api.example.com/api/v1/huifu/notify

# ── 快递物流 ──
KUAIDI100_API_KEY=
KUAIDI100_CUSTOMER=
KUAIDI100_CALLBACK_URL=https://api.example.com/api/v1/shop/logistics/kuaidi100/callback
KUAIDI100_SALT=

# ── AI（至少启用一个生产模型） ──
DEEPSEEK_API_KEY=<change_me>
DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_API_KEY=
COZE_API_KEY=
COZE_BOT_ID=

# ── 邮件与告警 ──
EMAIL_MODE=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
WEWORK_WEBHOOK_URL=
WEWORK_WEBHOOK_ALERT_URL=

# ── 可观测性与值班告警 ──
MONITORING_ENABLED=true
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me-use-a-long-random-grafana-password
# Alertmanager 使用企业微信“自建应用”，不是群机器人 webhook。
WEWORK_CORP_ID=
WEWORK_AGENT_ID=
WEWORK_AGENT_SECRET=
DBA_WEWORK_USER_IDS=
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318/v1/traces
OTEL_SERVICE_NAME=guoxue-platform
# 首发切换时保持 true；确认旧排盘用户与分站归属稳定后再灰度关闭。
PAIPAN_LEGACY_MODE=true
PAIPAN_H5_BASE=https://www.yrydai.com/guoxueApp.php
