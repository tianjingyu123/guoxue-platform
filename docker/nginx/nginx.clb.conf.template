# 国学平台 — Nginx CLB 回源配置
# 用途：CLB 在上游终止 HTTPS，Nginx 仅监听 HTTP 80 作为回源后端
# 与 nginx.conf.template 的关键区别:
#   - 无 SSL 证书、无 HSTS、无 ACME 验证
#   - 无 HTTP→HTTPS 301 跳转
#   - 新增 /socket.io/ WebSocket Upgrade 支持
#   - X-Forwarded-Proto 从 CLB 透传头获取真实协议
#   - 健康检查端点同时提供 /api/v1/health 和 /api/v1/health/ready

worker_processes auto;
worker_rlimit_nofile 65535;

events {
  worker_connections 4096;
  use epoll;
  multi_accept on;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                  '$status $body_bytes_sent "$http_referer" '
                  '"$http_user_agent" "$http_x_forwarded_for" '
                  'rt=$request_time uct="$upstream_connect_time" '
                  'uht="$upstream_header_time" urt="$upstream_response_time"';

  access_log /var/log/nginx/access.log main buffer=16k flush=5s;
  error_log /var/log/nginx/error.log warn;

  # 仅信任腾讯云 CLB 回源网段提供的 X-Forwarded-For。
  # 恢复真实客户端 IP 后，限流与后端 X-Real-IP 才不会把所有用户视为同一个 CLB 节点。
  set_real_ip_from 100.64.0.0/10;
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  sendfile on;
  tcp_nopush on;
  tcp_nodelay on;
  keepalive_timeout 65;
  keepalive_requests 100;
  types_hash_max_size 2048;
  server_tokens off;
  client_max_body_size 10m;
  client_body_buffer_size 128k;

  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_comp_level 5;
  gzip_min_length 256;
  gzip_types
    text/plain
    text/css
    text/xml
    text/javascript
    application/javascript
    application/json
    application/xml
    application/rss+xml
    image/svg+xml;

  # ── 限流区域 ──
  limit_req_zone $binary_remote_addr zone=api_limit:10m rate=60r/s;
  limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/s;
  limit_conn_zone $binary_remote_addr zone=conn_limit:10m;

  # ── 上游服务 ──
  upstream server_backend {
    least_conn;
    server server:3000 max_fails=3 fail_timeout=30s;
    keepalive 32;
  }

  map $host $domain_type {
    default  "MAIN";
    ~^shop\. "SHOP";
    ~^live\. "LIVE";
  }

  # ── 从 X-Forwarded-Proto 获取真实协议（CLB 透传，始终为 https）──
  map $http_x_forwarded_proto $real_scheme {
    default $scheme;
    https   "https";
  }

  # ── HTTP 80 主站 ──
  server {
    listen 80;
    server_name ${NGINX_SERVER_NAMES};

    # TLS 在 CLB 终止，但浏览器收到的响应仍需具备与直连 HTTPS 相同的安全头。
    include /etc/nginx/snippets/security-headers.conf;

    # ── 基础健康检查（Nginx 进程存活）──
    location /nginx-health {
      return 200 'ok';
      add_header Content-Type text/plain;
      include /etc/nginx/snippets/security-headers.conf;
    }

    limit_conn conn_limit 20;

    # ── 静态资源 (uploads) ──
    location /uploads/ {
      alias /var/www/uploads/;
      expires 30d;
      add_header Cache-Control "public, immutable";
      include /etc/nginx/snippets/security-headers.conf;
      limit_req zone=api_limit burst=60;
    }

    # ── 静态资源 (static) ──
    location /static/ {
      alias /var/www/static/;
      expires 7d;
      add_header Cache-Control "public";
      include /etc/nginx/snippets/security-headers.conf;
      limit_req zone=api_limit burst=60;
    }

    # 微信公众平台 JS 接口安全域名校验文件。
    # 必须由域名根路径原样返回，不能落入下方 API JSON 兜底。
    location = /MP_verify_OsVx8T2FCe2gXl62.txt {
      default_type text/plain;
      charset off;
      return 200 'OsVx8T2FCe2gXl62';
      add_header Cache-Control "no-store";
      include /etc/nginx/snippets/security-headers.conf;
    }

    # ── H5 SPA ──
    location = /h5 {
      return 301 https://$host/h5/;
    }

    location /h5/assets/ {
      root /var/www;
      try_files $uri =404;
      expires 365d;
      add_header Cache-Control "public, immutable";
      include /etc/nginx/snippets/security-headers.conf;
    }

    location /h5/ {
      root /var/www;
      try_files $uri $uri/ /h5/index.html;
      expires -1;
      add_header Cache-Control "no-cache";
      include /etc/nginx/snippets/security-headers.conf;
    }

    # ── 应用健康检查（不限流，供 CLB 和监控使用）──
    location /api/v1/health {
      proxy_pass http://server_backend;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $real_scheme;
    }

    location /api/v1/health/ready {
      proxy_pass http://server_backend;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $real_scheme;
    }

    # ── Socket.IO WebSocket ──
    location /socket.io/ {
      proxy_pass http://server_backend;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $real_scheme;
      proxy_read_timeout 86400s;
      proxy_send_timeout 86400s;
      proxy_buffering off;
    }

    # ── API ──
    location /api/ {
      limit_req zone=api_limit burst=30 nodelay;
      proxy_pass http://server_backend;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $real_scheme;
      proxy_set_header X-Domain-Type $domain_type;
      proxy_read_timeout 60s;
      proxy_send_timeout 60s;
      proxy_buffering on;
      proxy_buffer_size 4k;
      proxy_buffers 8 16k;

      # 登录/注册额外限流
      location ~ ^/api/v1/auth/(login|register|sms/send|sms/verify) {
        limit_req zone=auth_limit burst=5 nodelay;
        proxy_pass http://server_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $real_scheme;
      }
    }

    # ── 管理后台 SPA ──
    location = /admin {
      return 301 https://$host/admin/;
    }

    location ~ ^/admin/assets/(.+)$ {
      root /var/www;
      try_files /admin/assets/$1 =404;
      expires 365d;
      add_header Cache-Control "public, immutable";
      include /etc/nginx/snippets/security-headers.conf;
    }

    location = /admin/index.html {
      root /var/www;
      expires -1;
      add_header Cache-Control "no-cache";
      include /etc/nginx/snippets/security-headers.conf;
    }

    location /admin/ {
      root /var/www;
      try_files $uri $uri/ /admin/index.html;
      expires -1;
      add_header Cache-Control "no-cache";
      include /etc/nginx/snippets/security-headers.conf;
      limit_req zone=api_limit burst=60 nodelay;
    }

    # ── Swagger 文档（仅内网访问）──
    location /api-docs {
      satisfy any;
      allow 10.0.0.0/8;
      allow 172.16.0.0/12;
      allow 192.168.0.0/16;
      deny all;
      proxy_pass http://server_backend;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
    }

    # ── 根路径 ──
    location / {
      return 200 '{"status":"ok","message":"国学平台 API"}';
      add_header Content-Type application/json;
      include /etc/nginx/snippets/security-headers.conf;
    }
  }
}
