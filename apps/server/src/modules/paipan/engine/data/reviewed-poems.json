{
  "强": {"source": "周易 · 乾卦", "quote": "天行健，君子以自强不息。", "raw_quote": "天行健，君子以自強不息。", "origin": "zhouyi/乾.txt"},
  "厚": {"source": "周易 · 坤卦", "quote": "地势坤，君子以厚德载物。", "raw_quote": "地勢坤，君子以厚德載物。", "origin": "zhouyi/坤.txt"},
