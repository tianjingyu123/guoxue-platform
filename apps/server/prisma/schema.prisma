  scene              String // circle_assistant|customer_service|smart_search|course_assistant
  templateName       String // 模板名称
  systemPrompt       String   @db.Text // 系统提示词
  userPromptTemplate String?  @db.Text // 用户提示词模板（支持 {{variable}} 占位）
  variables          Json? // 可用变量列表 [{name, description, required}]
  status             String   @default("ACTIVE") // ACTIVE/INACTIVE
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([scene])
  @@index([status])
}

// ─────────────────────────────────────────────────
// 对外数字大屏 Token
// ─────────────────────────────────────────────────

model BigScreenToken {
  id          String    @id @default(uuid())
  type        String // platform|transactions|content_eco|ai_capability|offline_map
  token       String    @unique // HMAC-SHA256 签名
  validFrom   DateTime  @default(now())
  validTo     DateTime // 过期时间
  ipWhitelist String? // 允许IP白名单（逗号分隔）
  status      String    @default("PENDING") // PENDING/APPROVED/REVOKED
  createdBy   String
  approvedBy  String?
  revokedBy   String?
  createdAt   DateTime  @default(now())
  approvedAt  DateTime?
  revokedAt   DateTime?

  @@index([token])
  @@index([status])
  @@index([validTo])
}

// ─────────────────────────────────────────────────
// 直播分钟级数据快照
// ─────────────────────────────────────────────────

model LiveMinuteData {
  id           String   @id @default(uuid())
  roomId       String
  minute       DateTime // 数据对应分钟（精确到分钟）
  onlineCount  Int      @default(0)
  gmw          Int      @default(0) // 成交金额（分）
  orderCount   Int      @default(0)
  commentCount Int      @default(0)
  likeCount    Int      @default(0)
  shareCount   Int      @default(0)
  giftAmount   Int      @default(0) // 打赏金额（分）
  createdAt    DateTime @default(now())

  @@index([roomId])
  @@index([roomId, minute])
  @@index([minute])
}

// ─────────────────────────────────────────────────
// 平台抽成记录 — 每笔交易平台抽取的费用
// ─────────────────────────────────────────────────
model PlatformFeeRecord {
  id           String   @id @default(uuid())
  type         String // gift / circle_join / course / product / question / bounty / knowledge_revenue
  sourceId     String // 来源记录ID（如 giftRecord.id, order.id 等）
  sourceAmount Decimal  @db.Decimal(10, 2) // 原始金额
  platformRate Decimal  @db.Decimal(5, 4) // 平台抽成比例
  platformFee  Decimal  @db.Decimal(10, 2) // 平台抽成金额
  circleId     String? // 关联圈子（圈内交易时记录）
  circleShare  Decimal? @db.Decimal(10, 2) // 圈主分得金额
  createdAt    DateTime @default(now())

  @@index([type])
  @@index([circleId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────
// 圈主收益记录 — 圈子产生的收益分账
// ─────────────────────────────────────────────────
model CircleRevenueRecord {
  id          String    @id @default(uuid())
  circleId    String
  type        String // gift / circle_join / course / product / knowledge_revenue
  sourceId    String // 来源记录ID
  amount      Decimal   @db.Decimal(10, 2) // 原始金额
  platformFee Decimal   @db.Decimal(10, 2) // 平台抽成
  ownerShare  Decimal   @db.Decimal(10, 2) // 圈主实得
  splitRate   Decimal   @db.Decimal(5, 4) // 圈主分成比例
  settled     Boolean   @default(false) // 是否已结算
  settledAt   DateTime?
  createdAt   DateTime  @default(now())

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([circleId, createdAt])
  @@index([settled])
  @@index([type])
}

// 圈主——嘉宾分账配置（圈主在圈子内自助设计分配方案）
model CircleRevenueSplit {
  id        String   @id @default(uuid())
  circleId  String
  guestId   String // 嘉宾用户ID（CircleMember role=GUEST）
  scene     String   @default("ALL") // ALL / COURSE / QUESTION / LIVE / BOT / CUSTOM
  splitRate Decimal  @db.Decimal(5, 4) // 嘉宾分成比例（如 0.3 = 30%）
  status    String   @default("ACTIVE") // ACTIVE / DISABLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([circleId, guestId, scene])
  @@index([circleId])
  @@index([guestId])
}

// 嘉宾收益记录（圈内消费按分账方案分配给嘉宾的实际记录）
model CircleGuestEarning {
  id        String    @id @default(uuid())
  circleId  String
  guestId   String // 嘉宾用户ID
  scene     String // COURSE / QUESTION / LIVE / BOT
  sourceId  String // 来源业务ID
  amount    Decimal   @db.Decimal(10, 2) // 原始金额
  splitRate Decimal   @db.Decimal(5, 4) // 分账比例
  earned    Decimal   @db.Decimal(10, 2) // 嘉宾实得
  settled   Boolean   @default(false) // 是否已结算
  settledAt DateTime?
  createdAt DateTime  @default(now())

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([circleId, createdAt])
  @@index([guestId, settled])
  @@index([scene])
  @@index([sourceId])
}

model CircleExpertBooking {
  id           String   @id @default(uuid())
  circleId     String
  expertUserId String // 达人用户ID（CircleMember with expert config）
  bookerUserId String // 预约人用户ID
  slotDate     String // 预约日期 YYYY-MM-DD
  slotStart    String // 开始时间 HH:mm
  slotEnd      String // 结束时间 HH:mm
  topic        String? // 咨询主题
  notes        String? // 备注
  status       String   @default("PENDING") // PENDING/CONFIRMED/CANCELLED/COMPLETED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expertUserId, slotDate])
  @@index([bookerUserId])
  @@index([circleId, status])
}

model CircleEvent {
  id        String   @id @default(uuid())
  circleId  String
  title     String
  date      DateTime @db.Date
  time      String // HH:mm
  circle    String // 圈子名称冗余
  type      String   @default("activity") // activity / live / offline
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  circleRel Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([circleId, date])
}

// ─────────────────────────────────────────────────
// 平台知识库 — 聚合全平台知识沉淀
// ─────────────────────────────────────────────────
model PlatformKnowledge {
  id            String    @id @default(uuid())
  title         String
  content       String    @db.Text
  sourceType    String // circle_knowledge / search_query / question / commentary / classic / bazi
  sourceId      String? // 来源记录ID
  circleId      String? // 来源圈子
  tags          String[]  @default([])
  category      String? // 分类：儒学/道学/佛学/中医/诗词/历史/易学/...
  qualityScore  Float? // 质量评分
  // embedding     Unsupported("vector(1536)")? // pgvector 向量（需 pgvector 扩展）
  embeddingJson String? // JSON向量降级
  usageCount    Int       @default(0)
  lastUsedAt    DateTime?
  exportedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([sourceType])
  @@index([sourceType, sourceId])
  @@index([category])
  @@index([qualityScore])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════
// 赛事系统 — 通用竞赛平台
// ═══════════════════════════════════════════════════════

enum CompetitionType {
  BAZI_PREDICT // 八字预测赛
  LIUYAO // 六爻断卦赛
  QIMEN_DUNJIA // 奇门遁甲赛
  MEIHUA_YISHU // 梅花易数赛
  ZIWEI_DOUSHU // 紫微斗数赛
  FENGSHUI // 风水堪舆赛
  NAME_ANALYSIS // 姓名学赛
  POETRY // 诗词大赛
  COUPLET // 对联大赛
  CALLIGRAPHY // 书法大赛
  PAINTING // 国画大赛
  MUSIC // 民乐/古琴大赛
  GO_CHESS // 围棋/象棋赛
  TEA_CEREMONY // 茶道赛
  INCENSE // 香道赛
  MARTIAL_ARTS // 武术/太极赛
  TCM_DIAGNOSIS // 中医辨证赛
  CLASSIC_RECITE // 经典诵读赛
  GEWU_PERCEIVE // 格物感知赛
  UNKNOWN_PREDICT // 未知预测赛
}

enum CompetitionStatus {
  DRAFT // 草稿
  PUBLISHED // 已发布（报名中）
  IN_PROGRESS // 进行中
  FINISHED // 已结束
  CANCELLED // 已取消
}

enum CompetitionLevel {
  S // 平台官方赛（全平台推广）
  A // 圈子联合赛
  B // 圈子内部赛
}

enum PrizeType {
  CASH // 现金奖金
  PHYSICAL // 实物奖品
  VIRTUAL // 虚拟商品
  MIXED // 混合（现金+实物/虚拟）
}

enum RoundType {
  REGISTRATION // 报名期
  PRELIMINARY // 初赛
  SEMIFINAL // 复赛
  FINAL // 总决赛
}

enum RoundStatus {
  PENDING // 未开始
  IN_PROGRESS // 进行中
  FINISHED // 已完成
}

enum QuestionType {
  SINGLE_CHOICE // 单选题
  MULTI_CHOICE // 多选题
  FILL_IN // 填空题
  SCALE // 量表题（吉凶程度等）
  CASE_ANALYSIS // 案例分析题（主观题）
  ESSAY // 论述题
}

enum ScoringModel {
  A // 客观题全自动评分
  B // AI+评委混合评分
  C // 纯评委评分
  D // 对弈引擎判定
}

enum RegistrationStatus {
  REGISTERED // 已报名
  QUALIFIED // 资格审核通过
  DISQUALIFIED // 资格审核不通过
  WITHDRAWN // 已退赛
}

enum PromotionStatus {
  ELIMINATED // 已淘汰
  PROMOTED // 已晋级
  CHAMPION // 冠军
  RUNNER_UP // 亚军
  THIRD_PLACE // 季军
}

model Competition {
  id                      String            @id @default(cuid())
  title                   String // 赛事标题
  titleEn                 String? // 英文标题（国际化预留）
  type                    CompetitionType // 赛事类型
  level                   CompetitionLevel  @default(B) // 赛事级别
  status                  CompetitionStatus @default(DRAFT)
  description             String?           @db.Text
  descriptionEn           String?           @db.Text // 英文描述（国际化预留）
  coverImage              String? // 封面图
  rules                   String?           @db.Text // 赛事规则（Markdown）
  rulesEn                 String?           @db.Text // 英文规则（国际化预留）
  scoringModel            ScoringModel      @default(A) // 评分模型
  maxParticipants         Int               @default(0) // 0=不限
  entryFee                Int               @default(0) // 报名费（分）
  isInviteOnly            Boolean           @default(false) // 是否邀请制
  requireIdentity         Boolean           @default(false) // 是否要求实名
  minLevel                Int               @default(0) // 最低用户等级要求
  organizerId             String? // 承办圈主/圈子ID
  organizerType           String? // circle / platform
  tags                    String[]          @default([])
  totalPrize              Int               @default(0) // 总奖金池（分）
  prizeType               PrizeType         @default(CASH) // 奖品类型
  prizeConfig             Json? // 奖品分配规则 [{rank, title, prize, prizeItem, prizeType, description}]
  invitationShare         Int               @default(0) // 邀请分润比例（千分比，如50=5%）
  // ── 二期·赛事创建系统（赛-P1）增量 ──
  format                  String            @default("QUIZ") // 赛制：QUIZ答题 | LIVE_PK直播PK | HYBRID混合
  stagesConfig            Json? // 阶段配置数组 [{seq,name,format,startAt,endAt,advanceRule:{type:"count"|"percent",value}}]
  judgePanel              Json? // 评审团 [{userId,title,weight}]
  voteWeight              Float             @default(0.2) // 观众票权重（0-0.3）
  prizes                  Json? // 奖品配置（二期结构化：[{rank,title,prize,description}]）
  shareCommitmentRequired Boolean           @default(false) // 报名是否必须勾选《赛后分享承诺》
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  publishedAt             DateTime?
  startedAt               DateTime?
  finishedAt              DateTime?

  rounds        CompetitionRound[]
  registrations CompetitionRegistration[]
  questions     CompetitionQuestion[]
  rankings      CompetitionRanking[]
  invitations   CompetitionInvitation[]
  articles      CompetitionArticle[]
  stages        CompetitionStage[]

  @@index([type])
  @@index([status])
  @@index([level])
  @@index([organizerId])
  @@index([createdAt])
}

// 赛事阶段（二期·状态机驱动的多阶段赛程，由 stagesConfig 生成）
model CompetitionStage {
  id            String   @id @default(cuid())
  competitionId String
  seq           Int // 阶段序号（1 起递增）
  name          String // 阶段名称，如"海选·答题"
  format        String   @default("QUIZ") // 阶段赛制：QUIZ | LIVE_PK
  startAt       DateTime // 阶段开始时间
  endAt         DateTime // 阶段结束时间
  advanceRule   Json? // 晋级规则 {type:"count"|"percent", value:Int}（最后阶段可空）
  status        String   @default("PENDING") // PENDING | RUNNING | JUDGING | DONE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@unique([competitionId, seq])
  @@index([competitionId, status])
  @@index([status, startAt])
}

model CompetitionRound {
  id            String      @id @default(cuid())
  competitionId String
  type          RoundType
  status        RoundStatus @default(PENDING)
  title         String // 轮次名称，如"初赛·问卷答题"
  titleEn       String? // 英文标题（国际化预留）
  description   String?     @db.Text
  descriptionEn String?     @db.Text // 英文描述（国际化预留）
  sortOrder     Int         @default(0)
  startAt       DateTime // 开始时间
  endAt         DateTime // 结束时间
  duration      Int         @default(0) // 限时（分钟），0=不限
  passCount     Int         @default(0) // 晋级人数，0=不限
  passPercent   Int         @default(0) // 晋级比例（千分比），0=不限
  scoringConfig Json? // 评分规则JSON
  liveConfig    Json? // 直播配置JSON（推流地址等）
  createdAt     DateTime    @default(now())

  competition Competition           @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  answers     CompetitionAnswer[]
  questions   CompetitionQuestion[]

  @@index([competitionId, sortOrder])
}

model CompetitionRegistration {
  id            String             @id @default(cuid())
  competitionId String
  userId        String
  status        RegistrationStatus @default(REGISTERED)
  inviterId     String? // 邀请人ID
  inviteCode    String? // 邀请码
  paidFee       Int                @default(0) // 实付报名费
  extraData     Json? // 附加信息（如书法赛初稿URL）
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  competition Competition         @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviter     User?               @relation("CompetitionInviter", fields: [inviterId], references: [id])
  answers     CompetitionAnswer[]
  scores      CompetitionScore[]

  @@unique([competitionId, userId])
  @@index([competitionId, status])
  @@index([inviterId])
}

model CompetitionQuestion {
  id            String       @id @default(cuid())
  competitionId String
  roundId       String? // null=所有轮次可用
  type          QuestionType
  score         Int          @default(10) // 分值
  difficulty    Int          @default(1) // 难度 1-5
  stem          String       @db.Text // 题干
  options       Json? // 选项JSON [{key:"A",text:"..."}]
  answer        Json         @default("{}") // 标准答案JSON（客观题直接对比，主观题存评分要点）
  analysis      String?      @db.Text // 解析
  source        String? // 案例来源说明
  tags          String[]     @default([]) // 知识点标签
  sortOrder     Int          @default(0)
  isPublished   Boolean      @default(false)
  usageCount    Int          @default(0) // 被引用次数
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  competition Competition         @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  round       CompetitionRound?   @relation(fields: [roundId], references: [id])
  answers     CompetitionAnswer[]

  @@index([competitionId])
  @@index([roundId])
  @@index([type])
  @@index([difficulty])
}

model CompetitionAnswer {
  id             String    @id @default(cuid())
  registrationId String
  roundId        String
  questionId     String
  answer         Json      @default("{}") // 选手提交的答案JSON
  isCorrect      Boolean? // 客观题自动判定
  score          Int? // 得分
  graderId       String? // 评分人（评委或AI）
  comment        String?   @db.Text // 评语
  duration       Int       @default(0) // 答题耗时（秒）
  submittedAt    DateTime  @default(now())
  gradedAt       DateTime?

  registration CompetitionRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  round        CompetitionRound        @relation(fields: [roundId], references: [id])
  question     CompetitionQuestion     @relation(fields: [questionId], references: [id])

  @@unique([registrationId, questionId])
  @@index([roundId, registrationId])
}

model CompetitionScore {
  id             String   @id @default(cuid())
  registrationId String
  roundId        String?
  totalScore     Int      @default(0) // 总分
  autoScore      Int      @default(0) // 客观题得分
  judgeScore     Int      @default(0) // 评委打分
  bonusScore     Int      @default(0) // 附加分（邀请/人气等）
  rank           Int? // 本轮排名
  detail         Json? // 得分明细JSON
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  registration CompetitionRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user         User?                   @relation(fields: [userId], references: [id])
  userId       String?

  @@unique([registrationId, roundId])
  @@index([registrationId])
}

model CompetitionRanking {
  id             String          @id @default(cuid())
  competitionId  String
  userId         String
  roundId        String? // null=最终排名
  rank           Int
  score          Int
  status         PromotionStatus
  prize          Int             @default(0) // 获得奖金（分）
  prizeInfo      Json? // 奖品详情JSON
  certificateUrl String? // 电子证书URL
  createdAt      DateTime        @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId, roundId])
  @@index([competitionId, rank])
  @@index([userId])
}

model CompetitionInvitation {
  id            String              @id @default(cuid())
  competitionId String
  inviterId     String // 邀请人
  inviteeId     String // 被邀请人
  inviteCode    String              @unique
  inviteeStatus RegistrationStatus? // 被邀请人参赛状态
  rewardType    String? // cash / points / coupon
  rewardAmount  Int                 @default(0) // 奖励金额（分）
  rewardStatus  String              @default("pending") // pending / settled / cancelled
  settledAt     DateTime?
  createdAt     DateTime            @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  inviter     User        @relation("CompetitionInviterLink", fields: [inviterId], references: [id])
  invitee     User        @relation("CompetitionInviteeLink", fields: [inviteeId], references: [id])

  @@unique([competitionId, inviteeId])
  @@index([competitionId, inviterId])
  @@index([inviteCode])
}

// 邀请码表（用户维度的全局邀请码）
model CompetitionInviteCode {
  id          String   @id @default(cuid())
  userId      String   @unique // 每个用户一个唯一邀请码
  code        String   @unique
  shareCount  Int      @default(0) // 累计分享次数
  clickCount  Int      @default(0) // 累计点击次数
  regCount    Int      @default(0) // 累计成功报名数
  totalReward Int      @default(0) // 累计获得奖励（分）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@index([code])
}

// 赛事分享文章（赛后知识沉淀）
model CompetitionArticle {
  id            String    @id @default(cuid())
  competitionId String
  userId        String
  title         String
  content       String    @db.Text
  isPremium     Boolean   @default(false) // 是否付费解锁
  unlockPrice   Int       @default(0) // 解锁价格（分）
  unlockCount   Int       @default(0)
  viewCount     Int       @default(0)
  likeCount     Int       @default(0)
  qualityRating Float? // 用户评分
  isFeatured    Boolean   @default(false) // 是否精选
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([competitionId])
  @@index([isFeatured])
  @@index([qualityRating])
}

// 赛事人才档案（二期·赛-P4 人才沉淀：赛事 FINISHED 收官时重算·生态出口=人才→讲师转化）
model CompetitionTalent {
  id                String   @id @default(cuid())
  userId            String   @unique // 一人一档
  bestRank          Int? // 历史最好名次（1=冠军；null=尚无终榜名次）
  totalCompetitions Int      @default(0) // 累计参赛数（收官赛事计数·badges 判重防重复累计）
  totalWins         Int      @default(0) // 累计夺冠数
  talentScore       Int      @default(0) // 人才积分：冠军100/亚军60/季军40/每次晋级10/参与2 加权累计
  level             String   @default("TRAINEE") // 易学分析师段位（收官重算按 talentScore 阈值自动晋级·前端读真值）：TRAINEE见习/JUNIOR初级/INTERMEDIATE中级/SENIOR高级/MASTER资深
  badges            Json     @default("[]") // 战绩徽章 [{competitionId,title,status,rank,score,finishedAt}]（含 competitionId 判重幂等）
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([talentScore])
}

// 特约老师评定记录
model SpecialTeacher {
  id               String    @id @default(cuid())
  userId           String    @unique
  competitionWins  Int       @default(0) // 赛事获奖次数
  featuredArticles Int       @default(0) // 精选文章数
  totalScore       Float     @default(0) // 综合评分
  level            String    @default("candidate") // candidate/junior/senior/master
  certificates     String[]  @default([]) // 资质证书URL
  invitedAt        DateTime?
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([level])
  @@index([totalScore])
}

// ── 浏览历史 ──
model BrowseHistory {
  id         String   @id @default(cuid())
  userId     String
  targetType String // content/course/circle/classic/ebook/video/live/article/product/poetry
  targetId   String
  title      String
  cover      String?
  duration   Int      @default(0) // 浏览时长(秒)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, targetType, createdAt])
