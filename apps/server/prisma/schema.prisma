generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────
// 用户系统
// ─────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MemberLevel {
  NONE
  MONTHLY
  YEARLY
  LIFETIME
}

model User {
  id            String     @id @default(uuid())
  phone         String?    @unique
  email         String?    @unique
  nickname      String
  avatar        String?
  bio           String?
  gender        Int?
  birthday      DateTime?
  memberLevel   MemberLevel @default(NONE)
  memberExpire  DateTime?
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  auths          Auth[]
  roles          UserRole[]
  memberPurchases MemberPurchase[]
  circles        Circle[]
  circleMembers  CircleMember[]
  posts          Post[]
  articles       Article[]
  courses        Course[]
  courseWorks    CourseWork[]
  courseReviews  CourseReview[]
  orders         Order[]
  liveRooms      LiveRoom[]
  videos         Video[]
  paipanRecords  PaipanRecord[]
  aiAnalysisRecords AiAnalysisRecord[]
  likes          Like[]
  comments       Comment[]
  collects       Collect[]
  notifications  Notification[]
  searchHistories SearchHistory[]
  readingProgresses ReadingProgress[]
  bookmarks         Bookmark[]
  station        Station?
  operator       Operator?
  stationOffline StationOffline?
  instituteMember InstituteMember?
  sentReports    Report[]          @relation("Reporter")
  followings     Follow[]          @relation("Follower")
  followers      Follow[]          @relation("FollowedUser")
  referralUsers  ReferralRelation[] @relation("ReferredUser")
  referralRefs   ReferralRelation[] @relation("Referrer")
  withdrawals    Withdrawal[]
  referralLinks  ReferralLink[]
  coinAccount        VirtualCoinAccount?
  coinTransactions   VirtualCoinTransaction[]
  coinRecharges      VirtualCoinRecharge[]
  askedQuestions     PaidQuestion[]     @relation("QuestionAsker")
  answeredQuestions  PaidQuestion[]     @relation("QuestionAnswerer")
  audioCallsMade     AudioCallRecord[]  @relation("Caller")
  audioCallsReceived AudioCallRecord[]  @relation("Callee")
  giftRecords        GiftRecord[]
  ebookProgresses    EbookProgress[]
  ebookBookmarks     EbookBookmark[]
  ebookNotes         EbookNote[]
  ebookPurchases     EbookPurchase[]
  merchant           Merchant?

  @@index([phone])
  @@index([memberLevel])
  @@index([status, createdAt])
}

model Auth {
  id           String   @id @default(uuid())
  userId       String
  provider     String   // PASSWORD, WECHAT, PHONE
  openId       String?  @unique
  unionId      String?
  credential   String?  // password hash or access_token
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
}

enum RoleType {
  SUPER_ADMIN
  OPERATION_ADMIN
  CONTENT_AUDITOR
  FINANCE_ADMIN
  CUSTOMER_SERVICE
  GOODS_AUDITOR
  CIRCLE_OWNER
  LECTURER
  STATION_MASTER
  OPERATOR
  STATION_OFFLINE_OWNER
  INSTITUTE_MEMBER
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleType  RoleType
  bindId    String?  // 关联的业务ID（圈子ID/分站ID等）
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleType, bindId])
  @@index([roleType])
}

model MemberPurchase {
  id         String     @id @default(uuid())
  userId     String
  memberType MemberLevel
  amount     Decimal    @db.Decimal(10, 2)
  sourcePage String?    // 来源页面追踪
  referrerId String?
  paidAt     DateTime   @default(now())
  expireAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────
// 推荐关系
// ─────────────────────────────────────────────────

enum ReferrerType {
  STATION_MASTER
  OPERATOR
  USER
}

model ReferralRelation {
  id             String       @id @default(uuid())
  userId         String       // 被推荐人
  referrerId     String       // 推荐人
  referrerType   ReferrerType
  sourceChannel  String?      // 渠道来源
  relationStatus String       @default("ACTIVE") // ACTIVE, DISABLED
  createdAt      DateTime     @default(now())

  user     User @relation("ReferredUser", fields: [userId], references: [id], onDelete: Cascade)
  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([userId, referrerId])
  @@index([referrerId])
  @@index([userId, relationStatus])
}

model Follow {
  id             String   @id @default(uuid())
  userId         String
  followedUserId String
  createdAt      DateTime @default(now())

  user         User @relation("Follower", fields: [userId], references: [id], onDelete: Cascade)
  followedUser User @relation("FollowedUser", fields: [followedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, followedUserId])
  @@index([followedUserId])
  @@index([userId, createdAt])
  @@index([followedUserId, createdAt])
}

// ─────────────────────────────────────────────────
// 圈子系统
// ─────────────────────────────────────────────────

enum CircleType {
  FREE
  PAID
  YEARLY
}

enum CircleStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum CircleMemberRole {
  OWNER
  PARTNER
  ADMIN
  GUEST
  VOLUNTEER
  MEMBER
}

model Circle {
  id             String       @id @default(uuid())
  name           String
  intro          String
  cover          String?
  tags           String[]
  type           CircleType   @default(FREE)
  price          Decimal      @default(0) @db.Decimal(10, 2)
  depositAmount  Decimal      @default(0) @db.Decimal(10, 2)
  ownerId        String
  memberCount    Int          @default(0)
  postCount      Int          @default(0)
  status         CircleStatus @default(PENDING)
  stationId      String?      // 分站数据隔离（null = 平台级）
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  owner    User           @relation(fields: [ownerId], references: [id])
  station  Station?       @relation(fields: [stationId], references: [id])
  members  CircleMember[]
  posts    Post[]
  articles Article[]
  courses  Course[]
  videos   Video[]
  products Product[]
  liveRooms     LiveRoom[]
  paidQuestions PaidQuestion[]
  bot           CircleBot?
  knowledgeItems CircleKnowledge[]

  @@index([ownerId])
  @@index([status])
  @@index([stationId])
}

model CircleMember {
  id                    String           @id @default(uuid())
  circleId              String
  userId                String
  role                  CircleMemberRole @default(MEMBER)
  joinedAt              DateTime         @default(now())
  expireAt              DateTime?
  questionPriceCoin     Int              @default(0) // 提问价格（币），0=不接提问
  questionTimeoutHours  Int              @default(72) // 超时退款时间（小时）
  callPricePerMinuteCoin Int             @default(0) // 连麦价格（币/分钟），0=不接连麦
  callAvailableHours    Json?            // 可接连麦时段 [{day, start, end}]

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([userId])
  @@index([userId, joinedAt])
}

// ─────────────────────────────────────────────────
// 帖子
// ─────────────────────────────────────────────────

enum PostType {
  TEXT
  IMAGE
  VIDEO
  FILE
  LINK
}

model Post {
  id        String   @id @default(uuid())
  circleId  String
  userId    String
  type      PostType @default(TEXT)
  title     String?
  content   String
  images    String[] @default([])
  videoUrl  String?
  fileUrl   String?
  linkUrl   String?
  isEssence Boolean  @default(false)
  isTop     Boolean  @default(false)
  status    String   @default("PUBLISHED") // PUBLISHED, DRAFT, AUDITING, HIDDEN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  circle   Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([circleId, createdAt])
  @@index([circleId, status, createdAt])
  @@index([userId])
}

// ─────────────────────────────────────────────────
// 内容管理（后台管理用）
// ─────────────────────────────────────────────────

model Content {
  id          String   @id @default(uuid())
  title       String
  type        String   @default("ARTICLE") // ARTICLE, POEM, CLASSIC
  author      String?
  dynasty     String?
  excerpt     String?
  body        String   // 正文/富文本HTML
  cover       String?  // 封面图URL
  tags        String[]
  viewCount   Int      @default(0)
  likeCount   Int      @default(0)
  status      String   @default("PUBLISHED") // PUBLISHED, DRAFT, PENDING, APPROVED, REJECTED
  auditReason String?  // 审核驳回原因
  stationId   String?  // 分站数据隔离（null = 平台级）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  station Station? @relation(fields: [stationId], references: [id])

  @@index([type, createdAt])
  @@index([status])
  @@index([status, viewCount])
  @@index([stationId])
}

// ─────────────────────────────────────────────────
// 文章系统
// ─────────────────────────────────────────────────

model Article {
  id          String   @id @default(uuid())
  circleId    String
  userId      String
  title       String
  content     String   // 富文本HTML
  cover       String?
  excerpt     String?
  tags        String[]
  isPushHome  Boolean  @default(false)
  auditStatus String   @default("PENDING") // PENDING, APPROVED, REJECTED
  viewCount   Int      @default(0)
  likeCount   Int      @default(0)
  collectCount Int     @default(0)
  commentCount Int     @default(0)
  stationId   String?  // 分站数据隔离（null = 平台级）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  circle     Circle             @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  station    Station?           @relation(fields: [stationId], references: [id])
  recommends ArticleRecommend[]

  @@index([circleId, createdAt])
  @@index([isPushHome, auditStatus])
  @@index([userId, createdAt])
  @@index([stationId])
  @@index([auditStatus, createdAt])
  @@index([circleId, auditStatus, createdAt])
}

model ArticleRecommend {
  id            String @id @default(uuid())
  articleId     String
  recommendType String // CIRCLE, COURSE, PRODUCT, PAIPAN, BOT
  targetId      String
  title         String?
  cover         String?
  sortOrder     Int    @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

// ─────────────────────────────────────────────────
// 课程系统
// ─────────────────────────────────────────────────

enum CourseType {
  VIDEO
  AUDIO
  TEXT
  EBOOK
  COMBO
}

model Course {
  id            String     @id @default(uuid())
  circleId      String?
  userId        String     // 创建者
  title         String
  cover         String?
  intro         String?
  type          CourseType @default(VIDEO)
  price         Decimal    @default(0) @db.Decimal(10, 2)
  originalPrice Decimal?   @db.Decimal(10, 2)
  tags          String[]   @default([])
  studentCount  Int        @default(0)
  auditStatus   String     @default("PENDING")
  validityDays  Int        @default(0) // 购买后有效期（天），0=永久
  stationId     String?    // 分站数据隔离（null = 平台级）
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  circle     Circle?           @relation(fields: [circleId], references: [id])
  user       User              @relation(fields: [userId], references: [id])
  station    Station?          @relation(fields: [stationId], references: [id])
  chapters   CourseChapter[]
  progresses CourseProgress[]
  works      CourseWork[]
  reviews    CourseReview[]
  liveRooms  LiveRoom[]

  @@index([circleId])
  @@index([auditStatus])
  @@index([userId, createdAt])
  @@index([stationId])
  @@index([type, auditStatus])
  @@index([circleId, auditStatus, createdAt])
}

model CourseChapter {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  content   String?  // 视频URL/音频URL/文本内容
  mediaUrl  String?
  duration  Int?     // 秒
  sortOrder Int      @default(0)
  freeTrial Boolean  @default(false)
  createdAt DateTime @default(now())

  course    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progresses CourseProgress[]
  works     CourseWork[]

  @@index([courseId, sortOrder])
}

model CourseProgress {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  chapterId String
  progress  Float    @default(0) // 0-100
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  chapter CourseChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([userId, courseId])
}

model CourseWork {
  id        String   @id @default(uuid())
  courseId  String
  chapterId String
  userId    String
  content   String
  score     Float?
  feedback  String?
  createdAt DateTime @default(now())

  chapter CourseChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chapterId, userId])
}

// ─────────────────────────────────────────────────
// 商城系统
// ─────────────────────────────────────────────────

enum SupplierType {
  PLATFORM
  CIRCLE_OWNER
  STATION_OFFLINE
  CERTIFIED_MERCHANT
}

model Product {
  id           String       @id @default(uuid())
  circleId     String?
  userId       String?      // 供应商
  title        String
  categoryId   String?
  intro        String?
  detail       String       // 详情HTML
  images       String[]     @default([])
  videoUrl     String?
  tags         String[]     @default([])
  price        Decimal      @db.Decimal(10, 2)
  stock        Int          @default(0)
  salesCount   Int          @default(0)
  isPlatform   Boolean      @default(true)
  supplierType SupplierType @default(PLATFORM)
  status       String       @default("PENDING") // PENDING, ON_SALE, OFF_SHELF
  stationId    String?      // 分站数据隔离（null = 平台级）
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  circle  Circle?      @relation(fields: [circleId], references: [id])
  station Station?     @relation(fields: [stationId], references: [id])
  skus    ProductSku[]
  reviews ProductReview[]

  @@index([categoryId])
  @@index([status])
  @@index([stationId])
  @@index([status, createdAt])
  @@index([circleId])
  @@index([supplierType, status])
}

model ProductSku {
  id        String  @id @default(uuid())
  productId String
  specs     Json    // { 规格名: 规格值 }
  price     Decimal @db.Decimal(10, 2)
  stock     Int     @default(0)
  skuCode   String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ─────────────────────────────────────────────────
// 订单与优惠券
// ─────────────────────────────────────────────────

enum OrderType {
  MEMBER
  COURSE
  PRODUCT
  CIRCLE_JOIN
  STATION_MASTER
  OPERATOR
  BOT_SERVICE
  PAIPAN
  LIVESTREAM
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  REFUNDED
  CANCELLED
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  type            OrderType
  targetId        String      // 购买目标ID（课程ID/商品ID等）
  skuId           String?
  amount          Decimal     @db.Decimal(10, 2)
  payAmount       Decimal?    @db.Decimal(10, 2) // 实付金额
  couponId        String?
  merchantId      String?     // 商家ID（商家商品订单，用于分佣和数据隔离）
  status          OrderStatus @default(PENDING)
  referrerId      String?     // 永久推荐人
  tempReferrerId  String?     // 临时推荐人
  payMethod       String?     // WECHAT, ALIPAY
  payTransactionId String?
  paidAt          DateTime?
  shippedAt       DateTime?
  completedAt     DateTime?
  refundedAt      DateTime?
  frozenAmount    Decimal?   @db.Decimal(10, 2) // 冻结金额
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user    User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([referrerId])
  @@index([tempReferrerId])
  @@index([payTransactionId])
  @@index([type, status])
  @@index([userId, type, targetId, status])
  @@index([userId, status])
  @@index([type])
  @@index([userId, type, status, createdAt])
  @@index([merchantId, status])
}

enum CouponType {
  FULL_REDUCE
  DISCOUNT
  NO_THRESHOLD
}

model Coupon {
  id             String     @id @default(uuid())
  type           CouponType
  name           String?    // 优惠券名称
  value          Decimal    @db.Decimal(10, 2) // 兼容旧字段: 满减金额/折扣率
  discountAmount Decimal?   @db.Decimal(10, 2) // 满减金额（新字段）
  discountRate   Decimal?   @db.Decimal(5, 4)  // 折扣率（新字段，如0.85=85折）
  minAmount      Decimal?   @db.Decimal(10, 2) // 最低使用金额
  scope          String     @default("ALL") // ALL, PRODUCT, COURSE, CIRCLE, MEMBER
  scopeId        String?    // 指定商品/课程ID
  totalCount     Int        @default(-1) // -1=不限量
  usedCount      Int        @default(0)
  status         String     @default("ACTIVE") // ACTIVE, EXPIRED, DISABLED
  validStart     DateTime
  validEnd       DateTime
  createdAt      DateTime   @default(now())

  userCoupons UserCoupon[]

  @@index([status])
  @@index([validStart, validEnd])
}

model UserCoupon {
  id        String   @id @default(uuid())
  userId    String
  couponId  String
  used      Boolean  @default(false)
  usedAt    DateTime?
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([userId, used])
  @@index([couponId])
}

// ─────────────────────────────────────────────────
// 商品评价
// ─────────────────────────────────────────────────

model ProductReview {
  id        String   @id @default(uuid())
  productId String
  userId    String
  orderId   String?
  rating    Int      // 1-5 星
  content   String
  images    String[] @default([])
  status    String   @default("PUBLISHED") // PUBLISHED, HIDDEN
  reply     String?  // 管理员回复
  repliedAt DateTime?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([userId])
}

// ─────────────────────────────────────────────────
// 课程评价
// ─────────────────────────────────────────────────

model CourseReview {
  id        String   @id @default(uuid())
  courseId  String
  userId    String
  orderId   String?
  rating    Int      // 1-5 星
  content   String
  status    String   @default("PUBLISHED") // PUBLISHED, HIDDEN
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
  @@index([userId])
}

// ─────────────────────────────────────────────────
// 物流追踪
// ─────────────────────────────────────────────────

model OrderLogistics {
  id               String   @id @default(uuid())
  orderId          String   @unique
  company          String?  // 物流公司
  logisticsNo      String?  // 物流单号
  contactName      String?  // 联系人
  contactPhone     String?  // 联系电话
  province         String?  // 省
  city             String?  // 市
  district         String?  // 区
  address          String?  // 详细地址
  zipCode          String?  // 邮编
  status           String   @default("PENDING") // PENDING, SHIPPED, IN_TRANSIT, DELIVERED, SIGNED
  trackingData     Json?    // 物流追踪轨迹 [{time, status, desc}]
  remark           String?  // 备注
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orderId])
}

// ─────────────────────────────────────────────────
// 直播系统
// ─────────────────────────────────────────────────

enum LiveHostType {
  CIRCLE_OWNER
  STATION_MASTER
}

enum LiveStatus {
  WAITING
  LIVING
  ENDED
  REPLAY
}

model LiveRoom {
  id          String       @id @default(uuid())
  circleId    String?
  userId      String       // 发起人
  title       String
  cover       String?
  hostType    LiveHostType @default(CIRCLE_OWNER)
  hostUserId  String       // 主播
  coHostIds   String[]     @default([])
  pushUrl     String?      // 腾讯云推流地址
  pullUrl     String?      // CDN播放地址
  trtcRoomId  String?      // TRTC房间ID
  imGroupId   String?
  status      LiveStatus   @default(WAITING)
  viewCount   Int          @default(0)
  chargeType  String       @default("FREE") // FREE, PAID, CIRCLE_ONLY, MEMBER_FREE
  chargePrice Decimal?     @db.Decimal(10, 2)
  startTime   DateTime?
  endTime     DateTime?
  replayUrl   String?
  courseId    String?      // 关联课程（课程直播联动）
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  circle      Circle?        @relation(fields: [circleId], references: [id])
  user        User           @relation(fields: [userId], references: [id])
  course      Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
  products    LiveProduct[]
  giftRecords GiftRecord[]
  mics        LiveMic[]
  slides      LiveSlide[]
  mutedUsers  LiveMutedUser[]
  flashSales  LiveFlashSale[]
  auditLogs   LiveAuditLog[]

  @@index([status])
  @@index([circleId])
  @@index([circleId, status])
  @@index([courseId])
  @@index([status, startTime])
  @@index([hostUserId, status])
}

model LiveProduct {
  id        String @id @default(uuid())
  liveId    String
  productId String
  sortOrder Int    @default(0)

  liveRoom LiveRoom @relation(fields: [liveId], references: [id], onDelete: Cascade)

  @@unique([liveId, productId])
}

// 直播麦位管理（最多6麦位）
model LiveMic {
  id         String   @id @default(uuid())
  liveRoomId String
  userId     String
  position   Int      // 麦位序号 (1-6)
  status     String   @default("OCCUPIED") // OCCUPIED, MUTED, LOCKED, OPEN
  joinedAt   DateTime @default(now())

  liveRoom LiveRoom @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)

  @@unique([liveRoomId, position])
  @@index([liveRoomId])
  @@index([userId])
}

// 直播课件
model LiveSlide {
  id         String   @id @default(uuid())
  liveRoomId String
  title      String   // 课件标题
  url        String   // 课件URL（COS地址）
  type       String   @default("IMAGE") // PPT, PDF, IMAGE
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  liveRoom LiveRoom @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)

  @@index([liveRoomId])
}

// 直播间禁言用户
model LiveMutedUser {
  id         String    @id @default(uuid())
  liveRoomId String
  userId     String
  mutedBy    String    // 操作人
  mutedAt    DateTime  @default(now())
  expiresAt  DateTime? // 为空=永久禁言

  liveRoom LiveRoom @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)

  @@unique([liveRoomId, userId])
  @@index([liveRoomId])
}

// 直播限时秒杀
model LiveFlashSale {
  id         String    @id @default(uuid())
  liveRoomId String
  productId  String
  flashPrice Int       // 秒杀价（币）
  stock      Int       // 秒杀库存
  soldCount  Int       @default(0)
  status     String    @default("WAITING") // WAITING, ACTIVE, ENDED
  startTime  DateTime
  endTime    DateTime
  createdAt  DateTime  @default(now())

  liveRoom LiveRoom @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)

  @@index([liveRoomId, status])
  @@index([productId])
}

// 直播内容审核日志
model LiveAuditLog {
  id            String   @id @default(uuid())
  liveRoomId    String
  screenshotUrl String?  // 截帧图片URL
  auditResult   String   @default("PENDING") // PENDING, PASS, BLOCK
  label         String?  // 违规标签
  rawData       Json?    // 腾讯云CMS原始回调数据
  createdAt     DateTime @default(now())

  liveRoom LiveRoom @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)

  @@index([liveRoomId, createdAt])
}

// ─────────────────────────────────────────────────
// 短视频系统
// ─────────────────────────────────────────────────

model Video {
  id         String   @id @default(uuid())
  circleId   String?
  userId     String
  title      String?
  videoUrl   String
  coverUrl   String?
  duration   Int?     // 秒
  tags       String[] @default([])
  viewCount     Int      @default(0)
  likeCount     Int      @default(0)
  commentCount  Int      @default(0)
  shareCount    Int      @default(0)
  collectCount  Int      @default(0)
  status        String   @default("PUBLISHED") // PUBLISHED, AUDITING, HIDDEN
  stationId  String?  // 分站数据隔离（null = 平台级）
  createdAt  DateTime @default(now())

  circle   Circle?        @relation(fields: [circleId], references: [id])
  user     User           @relation(fields: [userId], references: [id])
  station  Station?       @relation(fields: [stationId], references: [id])
  products VideoProduct[]

  @@index([userId])
  @@index([status])
  @@index([stationId])
  @@index([status, createdAt])
  @@index([circleId, status, createdAt])
}

model VideoProduct {
  id        String @id @default(uuid())
  videoId   String
  productId String
  sortOrder Int    @default(0)

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, productId])
}

// ─────────────────────────────────────────────────
// 智能体系统
// ─────────────────────────────────────────────────

model BotConfig {
  id          String   @id @default(uuid())
  name        String
  type        String   // CUSTOMER_SERVICE, CIRCLE_ASSISTANT, CONTENT_WRITER, etc.
  avatar      String?
  intro       String
  botId       String   // Coze Bot ID
  apiKey      String   // Coze API Key (加密存储)
  isFree      Boolean  @default(true)
  dailyLimit  Int      @default(5) // 每日免费次数
  price       Decimal? @db.Decimal(10, 2) // 付费调用单价
  monthlyPrice Decimal? @db.Decimal(10, 2)
  sortOrder    Int      @default(0)
  voiceEnabled Boolean? @default(false) // Coze 语音通话开关
  status       String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  circleBots        CircleBot[]
  knowledgeBases    BotKnowledgeBase[]

  @@index([status, type])
}

model CircleBot {
  id              String   @id @default(uuid())
  circleId        String
  botConfigId     String
  knowledgeBaseId String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())

  circle   Circle    @relation(fields: [circleId], references: [id], onDelete: Cascade)
  botConfig BotConfig @relation(fields: [botConfigId], references: [id])

  @@unique([circleId])
}

model BotKnowledgeBase {
  id          String   @id @default(uuid())
  botConfigId String
  title       String
  content     String
  sourceType  String?  // POST, ARTICLE, COURSE, MANUAL
  sourceId    String?
  createdAt   DateTime @default(now())

  botConfig BotConfig @relation(fields: [botConfigId], references: [id], onDelete: Cascade)

  @@index([botConfigId])
}

model BotChatLog {
  id             String   @id @default(uuid())
  userId         String
  botConfigId    String
  query          String
  response       String
  conversationId String?
  chatId         String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([botConfigId])
  @@index([conversationId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────
// 排盘系统
// ─────────────────────────────────────────────────

model PaipanRecord {
  id           String   @id @default(uuid())
  userId       String
  clientName   String?  // 被排盘人姓名
  clientBirth  String   // 生辰信息（AES加密）
  paipanType   String   // BAZI, ZIWEI, FENGSHUI, NAME
  inputParams  Json     // 输入参数
  resultData   Json     // 排盘结果JSON
  createdAt    DateTime @default(now())

  user       User               @relation(fields: [userId], references: [id])
  aiAnalysis AiAnalysisRecord[]

  @@index([userId, createdAt])
  @@index([userId, paipanType, createdAt])
  @@index([createdAt])
  @@index([paipanType])
}

model AiAnalysisRecord {
  id             String   @id @default(uuid())
  userId         String
  paipanRecordId String?
  analyzeType    String   // CAREER, LOVE, WEALTH, HEALTH, GENERAL
  analysisContent String  // 分析全文
  modelName      String   @default("deepseek-v4-pro")
  tokenUsage     Json?    // { promptTokens, completionTokens }
  isCached       Boolean  @default(false)
  // AI网关扩展字段
  scene          String?  // 调用场景：circle_assistant / customer_service / smart_search / classic_qa
  modelUsed      String?  // 实际使用的模型
  fallbackUsed   Boolean  @default(false) // 是否触发降级
  fallbackModel  String?  // 降级后模型
  latency        Int?     // 响应延迟（ms）
  cost           Float?   // 费用（元）
  inputSummary   String?  // 输入内容摘要（前200字符）
  outputSummary  String?  // 输出内容摘要（前200字符）
  userAccepted   Boolean? // 用户是否采纳（创作辅助类）
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id])
  paipanRecord PaipanRecord? @relation(fields: [paipanRecordId], references: [id])

  @@index([userId, analyzeType, createdAt])
  @@index([createdAt])
  @@index([scene, createdAt])
  @@index([modelUsed, createdAt])
}

// ─────────────────────────────────────────────────
// 分站与运营商
// ─────────────────────────────────────────────────

enum OperatorLevel {
  SILVER
  GOLD
  DIAMOND
  BLACK_GOLD
}

model Station {
  id          String   @id @default(uuid())
  userId      String   @unique
  name        String
  code        String   @unique // 推广码
  logo        String?  // 分站Logo
  themeColor  String?  @default("#8B4513") // 主题色
  intro       String?
  status      String   @default("ACTIVE")
  totalEarning Decimal @default(0) @db.Decimal(12, 2)
  // 多小程序配置
  miniAppId   String?  // 分站独立小程序 AppId
  mpAppId     String?  // 分站公众号 AppId（H5 兜底分享）
  miniPages   Json?    // 小程序页面自定义配置 { homePath, sharePath, ... }
  // 模版系统
  templateId       String?  @default("default") // 模版ID: default/paipan/lecturer/ecommerce/minimal
  templateConfig   Json?    // 模版个性化参数 { modules, order, hero, tabs, showSections }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id])
  earnings    StationEarning[]
  withdrawals Withdrawal[]
  contents    Content[]
  products    Product[]
  articles    Article[]
  courses     Course[]
  videos      Video[]
  circles     Circle[]
  picks       StationPick[]

  @@index([code])
}

// ─────────────────────────────────────────────────
// 站长内容精选
// ─────────────────────────────────────────────────

model StationPick {
  id          String   @id @default(uuid())
  stationId   String
  contentType String   // ARTICLE / COURSE / PRODUCT / CIRCLE / VIDEO
  contentId   String
  sortOrder   Int      @default(0)
  remark      String?  // 站长推荐语
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, contentType, contentId])
  @@index([stationId, sortOrder])
}

model Operator {
  id             String       @id @default(uuid())
  userId         String       @unique
  level          OperatorLevel
  containQuota   Int          @default(0) // 包含的站长名额
  usedQuota      Int          @default(0) // 已使用名额
  parentOperatorId String?
  status         String       @default("ACTIVE")
  // 运营商独立小程序
  miniAppId      String?      // 独立小程序 AppId
  mpAppId        String?      // 公众号 AppId
  miniPages      Json?        // 页面配置
  brandName      String?      // 品牌名称
  brandLogo      String?      // 品牌Logo
  brandThemeColor String?     @default("#8B4513")
  purchasedAt    DateTime     @default(now())
  expireAt       DateTime?
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([parentOperatorId])
}

model StationEarning {
  id        String   @id @default(uuid())
  stationId String
  orderId   String
  amount    Decimal  @db.Decimal(10, 2)
  rate      Decimal  @db.Decimal(5, 4) // 佣金比例
  earned    Decimal  @db.Decimal(10, 2)
  type      String   // COURSE, PRODUCT, MEMBER, CIRCLE, BOT
  createdAt DateTime @default(now())

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, createdAt])
  @@index([orderId])
}

// ─────────────────────────────────────────────────
// 线下驿站系统
// ─────────────────────────────────────────────────

model StationOffline {
  id           String   @id @default(uuid())
  name         String
  city         String
  address      String
  phone        String
  cover        String?
  ownerUserId  String   @unique
  depositAmount Decimal @default(0) @db.Decimal(10, 2)
  status       String   @default("PENDING") // PENDING, ACTIVE, DISABLED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner          User                         @relation(fields: [ownerUserId], references: [id])
  courses        OfflineCourse[]
  products       StationProduct[]
  orders         StationOrder[]
  teacherBookings StationTeacherBooking[]
  settlements    StationSettlement[]
}

model OfflineCourse {
  id          String   @id @default(uuid())
  stationId   String
  title       String
  cover       String?
  intro       String?
  teacherId   String?
  courseId    String?  // 关联线上课程
  type        String   @default("OFFLINE") // OFFLINE, HYBRID
  price       Decimal  @default(0) @db.Decimal(10, 2)
  maxStudents Int
  startTime   DateTime
  endTime     DateTime
  location    String
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())

  station        StationOffline               @relation(fields: [stationId], references: [id])
  registrations  OfflineCourseRegistration[]

  @@index([stationId, startTime])
}

model OfflineCourseRegistration {
  id        String   @id @default(uuid())
  courseId  String
  userId    String
  status    String   @default("REGISTERED") // REGISTERED, SIGNED_IN, CANCELLED
  qrCode    String?
  signedAt  DateTime?
  createdAt DateTime @default(now())

  course OfflineCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
}

model StationProduct {
  id          String  @id @default(uuid())
  stationId   String
  productId   String?
  name        String
  price       Decimal @db.Decimal(10, 2)
  stock       Int     @default(0)
  isPlatform  Boolean @default(false) // 驿站自有 vs 平台代销
  status      String  @default("ACTIVE")
  createdAt   DateTime @default(now())

  station StationOffline @relation(fields: [stationId], references: [id])

  @@index([stationId])
}

model StationOrder {
  id            String   @id @default(uuid())
  stationId     String
  orderType     String   // OFFLINE_COURSE, PRODUCT, SERVICE
  targetId      String
  amount        Decimal  @db.Decimal(10, 2)
  stationIncome Decimal  @db.Decimal(10, 2)
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())

  station StationOffline @relation(fields: [stationId], references: [id])

  @@index([stationId])
}

model StationTeacherBooking {
  id          String   @id @default(uuid())
  stationId   String
  teacherId   String
  courseId    String?
  bookingDate DateTime
  status      String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  remark      String?
  createdAt   DateTime @default(now())

  station StationOffline @relation(fields: [stationId], references: [id])

  @@index([stationId])
  @@index([teacherId])
}

model StationSettlement {
  id            String   @id @default(uuid())
  stationId     String
  period        String   // 结算周期 如 "2026-05"
  totalIncome   Decimal  @db.Decimal(12, 2)
  stationShare  Decimal  @db.Decimal(12, 2)
  platformShare Decimal  @db.Decimal(12, 2)
  settled       Boolean  @default(false)
  settledAt     DateTime?
  createdAt     DateTime @default(now())

  station StationOffline @relation(fields: [stationId], references: [id])

  @@index([stationId, period])
}

// ─────────────────────────────────────────────────
// 研究院
// ─────────────────────────────────────────────────

enum InstituteRole {
  INITIATOR
  TYPE_A // 潜力讲师
  TYPE_B // 深造者
}

model InstituteMember {
  id             String        @id @default(uuid())
  userId         String        @unique
  role           InstituteRole
  deposit        Decimal       @default(0) @db.Decimal(10, 2) // 保证金
  depositRefunded Boolean      @default(false) // 是否已退保证金
  joinYear       Int           // 加入年份
  tasksCompleted Int           @default(0)
  tasksRequired  Int           @default(3) // 年度任务要求
  lecturerLevel  String        @default("NONE") // NONE, PREPARATORY, JUNIOR, SENIOR, SIGNED
  status         String        @default("ACTIVE") // ACTIVE, GRADUATED, SUSPENDED
  joinedAt       DateTime      @default(now())

  user   User             @relation(fields: [userId], references: [id])
  tasks  InstituteTask[]

  @@index([role, status])
  @@index([joinYear])
}

// 研究院年度任务
model InstituteTask {
  id          String    @id @default(uuid())
  memberId    String
  taskType    String    // SALON, LIVE, ARTICLE
  title       String    // 任务标题
  description String?   // 说明
  status      String    @default("PENDING") // PENDING, COMPLETED, VERIFIED
  completedAt DateTime?
  verifiedBy  String?   // 验证人ID
  createdAt   DateTime  @default(now())

  member InstituteMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, status])
}

// 研究院活动排期
model InstituteEvent {
  id          String    @id @default(uuid())
  title       String
  type        String    // SALON, LIVE, COURSE
  lecturerId  String?   // 讲师用户ID
  description String?
  location    String?   // 线下地点 / 线上链接
  scheduleAt  DateTime
  maxAttendees Int      @default(50)
  status      String    @default("SCHEDULED") // SCHEDULED, ONGOING, COMPLETED, CANCELLED
  createdAt   DateTime  @default(now())

  @@index([scheduleAt])
  @@index([lecturerId])
  @@index([type, status])
}

// ─────────────────────────────────────────────────
// 互动系统
// ─────────────────────────────────────────────────

model Like {
  id         String   @id @default(uuid())
  userId     String
  targetType String   // POST, ARTICLE, COURSE, VIDEO, COMMENT
  targetId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([targetType, createdAt])
  @@index([userId, createdAt])
}

model Comment {
  id         String   @id @default(uuid())
  userId     String
  targetType String   // POST, ARTICLE, COURSE, VIDEO, LIVESTREAM
  targetId   String
  parentId   String?
  content    String
  likeCount  Int      @default(0)
  status     String   @default("PUBLISHED") // PUBLISHED, HIDDEN
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")

  @@index([targetType, targetId, createdAt])
  @@index([parentId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
}

model Collect {
  id         String   @id @default(uuid())
  userId     String
  targetType String   // POST, ARTICLE, COURSE, PRODUCT, VIDEO
  targetId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId, createdAt])
  @@index([targetType, targetId])
  @@index([targetType, createdAt])
}

model Report {
  id         String   @id @default(uuid())
  reporterId String   // 举报人
  targetType String   // POST, ARTICLE, COMMENT, CIRCLE, USER, LIVE, VIDEO
  targetId   String
  reason     String
  status     String   @default("PENDING") // PENDING, PROCESSED, DISMISSED
  result     String?
  createdAt  DateTime @default(now())
  processedAt DateTime?

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([targetType, targetId])
  @@index([reporterId, createdAt])
}

// ─────────────────────────────────────────────────
// 审计日志
// ─────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  executor   String?  // "CLAUDE" | 用户ID（区分自动化/人工操作）
  action     String
  targetType String?
  targetId   String?
  detail     String?
  rollbackData Json?  // 回滚数据快照
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([executor, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ─────────────────────────────────────────────────
// 系统配置与通知
// ─────────────────────────────────────────────────

model ConfigSystem {
  id          String   @id @default(uuid())
  configKey   String   @unique
  configValue String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // SYSTEM, COMMENT, LIKE, FOLLOW, PURCHASE, EARNING, AUDIT
  title     String
  content   String
  targetType String? // 跳转目标类型
  targetId  String?  // 跳转目标ID
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, type, createdAt])
}

model SearchHistory {
  id        String   @id @default(uuid())
  userId    String
  keyword   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([keyword])
}

// 搜索权重配置 — 按实体类型和字段调整搜索排序权重
model SearchWeight {
  id         String   @id @default(uuid())
  entityType String   // article | course | product | circle | video | user | classic | content
  fieldName  String   @default("all") // all | title | excerpt | intro | name | nickname | author
  weight     Float    @default(1.0) // 权重系数，默认 1.0
  enabled    Boolean  @default(true)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([entityType, fieldName])
}

// ─────────────────────────────────────────────────
// 古籍阅读系统
// ─────────────────────────────────────────────────

model ClassicBook {
  id           String   @id @default(uuid())
  title        String
  author       String?  // 作者/编者
  dynasty      String?  // 朝代
  category     String   @default("子") // 经/史/子/集/释/道
  cover        String?
  intro        String?
  source       String?  // 版本来源
  chapterCount Int      @default(0)
  viewCount    Int      @default(0)
  status       String   @default("PUBLISHED") // DRAFT, PUBLISHED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chapters   ClassicChapter[]
  progresses ReadingProgress[]
  bookmarks  Bookmark[]

  @@index([category])
  @@index([status])
}

model ClassicChapter {
  id          String   @id @default(uuid())
  bookId      String
  title       String   // 章/卷标题
  content     String   // 原文
  translation String?  // 白话译文
  annotation  String?  // 注释
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  book      ClassicBook       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  progresses ReadingProgress[]
  bookmarks Bookmark[]

  @@index([bookId, sortOrder])
}

model ReadingProgress {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  chapterId String
  progress  Float    @default(0) // 阅读进度 0-100
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    ClassicBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter ClassicChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  chapterId String
  position  Int      @default(0) // 文中位置（字符偏移）
  note      String?  // 笔记
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    ClassicBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter ClassicChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([userId, bookId])
  @@index([chapterId])
}

// ─────────────────────────────────────────────────
// 分佣系统
// ─────────────────────────────────────────────────

model CommissionConfig {
  id          String   @id @default(uuid())
  configKey   String   @unique // course_basic / course_premium / course_high / product_platform / product_circle / station_course / station_member / circle_join / bot_call / temp_referral
  configName  String   // 配置名称
  rateA       Decimal  @db.Decimal(10, 4) // 讲师/圈主/站长佣金比例
  rateB       Decimal  @db.Decimal(10, 4) // 平台佣金比例
  rateC       Decimal? @db.Decimal(10, 4) // 第三角色比例（驿站等）
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model Withdrawal {
  id            String   @id @default(uuid())
  userId        String
  stationId     String?  // 关联分站
  amount        Decimal  @db.Decimal(10, 2)
  bankName      String?  // 银行名称
  bankAccount   String?  // 银行卡号
  bankHolder    String?  // 开户人
  alipayAccount String?  // 支付宝账号
  status        String   @default("PENDING") // PENDING, APPROVED, PAID, REJECTED
  remark        String?  // 审核备注
  processedAt   DateTime?
  createdAt     DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  station Station? @relation(fields: [stationId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([stationId])
}

// 推荐链接追踪
model ReferralLink {
  id         String   @id @default(uuid())
  userId     String   // 分享人
  targetType String   // COURSE, PRODUCT, CIRCLE, LIVE, ARTICLE
  targetId   String
  code       String   @unique // 短链接码
  channel    String   @default("DIRECT") // DIRECT, WECHAT, POSTER, QR
  clickCount Int      @default(0)
  orderCount Int      @default(0)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([code])
}

// ─────────────────────────────────────────────────
// 虚拟币体系
// ─────────────────────────────────────────────────

model VirtualCoinAccount {
  id             String @id @default(uuid())
  userId         String @unique
  balance        Int    @default(0) // 当前余额（币数）
  frozen         Int    @default(0) // 冻结币数（悬赏等）
  totalRecharged Int    @default(0) // 累计充值币数
  totalSpent     Int    @default(0) // 累计消费币数
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VirtualCoinFrozen {
  id         String   @id @default(uuid())
  userId     String
  amountCoin Int      // 冻结币数
  scene      String   // BOUNTY/REFUND/DISPUTE
  refId      String?  // 关联ID（如悬赏问题ID）
  status     String   @default("FROZEN") // FROZEN/TRANSFERRED/UNFROZEN
  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  @@index([userId, status])
  @@index([refId])
}

enum CoinTransType {
  RECHARGE  // 充值
  SPEND     // 消费
  REFUND    // 退款
  GRANT     // 平台赠送
}

enum CoinScene {
  RECHARGE        // 充值
  CIRCLE_JOIN     // 付费入圈
  PAID_QUESTION   // 付费提问
  PEEK_ANSWER     // 围观答案
  AUDIO_CALL      // 音频连麦
  LIVE_GIFT       // 直播打赏
  BOT_CALL        // 智能体调用
  REFUND          // 退款
  PLATFORM_GRANT  // 平台赠送
}

model VirtualCoinTransaction {
  id           String        @id @default(uuid())
  userId       String
  type         CoinTransType
  amountCoin   Int           // 变动币数（正数为增加，负数为减少）
  balanceAfter Int           // 变动后余额
  scene        CoinScene     // 消费场景
  refId        String?       // 关联业务ID（订单号/问答ID/通话ID等）
  description  String?       // 描述
  createdAt    DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([refId])
  @@index([userId, type, createdAt])
}

model VirtualCoinRecharge {
  id         String   @id @default(uuid())
  userId     String
  amountRmb  Decimal  @db.Decimal(10, 2) // 人民币金额
  amountCoin Int      // 币数
  payMethod  String   @default("WECHAT") // WECHAT, ALIPAY
  orderNo    String   @unique // 外部支付订单号
  status     String   @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  paidAt     DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([orderNo])
}

// ─────────────────────────────────────────────────
// 付费问答
// ─────────────────────────────────────────────────

model PaidQuestion {
  id             String   @id @default(uuid())
  circleId       String
  askerId        String   // 提问者
  answererId     String   // 回答者
  questionTitle  String   @default("") // 问题标题
  question       String   // 问题详细描述
  images         String[] @default([])
  answer         String?  // 回答内容（富文本）
  answerAudioUrl String?  // 回答语音URL
  priceCoin      Int      // 提问价格（币）
  peekPriceCoin  Int      @default(0) // 围观价格（币）
  peekCount      Int      @default(0) // 围观次数
  isPublic       Boolean  @default(true) // 是否公开（公开后可被围观）
  timeoutHours   Int      @default(72) // 超时时间（小时）
  status         String   @default("PENDING") // PENDING, ANSWERED, REJECTED, REFUNDED, EXPIRED, CLOSED
  answeredAt     DateTime?
  createdAt      DateTime @default(now())

  circle   Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  asker    User   @relation("QuestionAsker", fields: [askerId], references: [id], onDelete: Cascade)
  answerer User   @relation("QuestionAnswerer", fields: [answererId], references: [id], onDelete: Cascade)

  @@index([circleId, status])
  @@index([askerId])
  @@index([answererId])
}

// ─────────────────────────────────────────────────
// 音频连麦记录
// ─────────────────────────────────────────────────

model AudioCallRecord {
  id                 String   @id @default(uuid())
  callerId           String   // 发起方
  calleeId           String   // 接收方
  circleId           String?
  pricePerMinuteCoin Int      // 每分钟价格（币）
  durationSeconds    Int      @default(0) // 通话时长（秒）
  totalCoin          Int      @default(0) // 总消费币数
  status             String   @default("WAITING") // WAITING, IN_PROGRESS, COMPLETED, CANCELLED
  roomId             String?  // TRTC房间ID
  startedAt          DateTime?
  endedAt            DateTime?
  createdAt          DateTime @default(now())

  caller      User                @relation("Caller", fields: [callerId], references: [id], onDelete: Cascade)
  callee      User                @relation("Callee", fields: [calleeId], references: [id], onDelete: Cascade)
  billings    AudioCallBilling[]

  @@index([callerId, createdAt])
  @@index([calleeId])
  @@index([status])
}

// 连麦按分钟扣费明细
model AudioCallBilling {
  id               String   @id @default(uuid())
  callRecordId     String   // 关联通话记录
  billingMinute    Int      // 扣费分钟序号（第几分钟）
  coinDeducted     Int      // 本次扣费金额（币）
  balanceBefore    Int      // 扣费前余额
  balanceAfter     Int      // 扣费后余额
  createdAt        DateTime @default(now())

  callRecord AudioCallRecord @relation(fields: [callRecordId], references: [id], onDelete: Cascade)

  @@index([callRecordId])
}

// ─────────────────────────────────────────────────
// 直播礼物打赏
// ─────────────────────────────────────────────────

model Gift {
  id        String  @id @default(uuid())
  name      String  // 礼物名称
  icon      String? // 图标URL
  priceCoin Int     // 价格（币）
  level     String  @default("BASIC") // BASIC, MID, HIGH, TOP
  effectUrl String? // 特效资源URL
  sortOrder Int     @default(0)
  status    String  @default("ACTIVE")
  createdAt DateTime @default(now())

  records GiftRecord[]
}

model GiftRecord {
  id         String   @id @default(uuid())
  userId     String   // 赠送者
  liveRoomId String   // 直播间
  toUserId   String   // 接收者（主播）
  giftId     String   // 礼物ID
  quantity   Int      @default(1) // 数量
  totalCoin  Int      // 总消费币数
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  liveRoom LiveRoom @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  gift     Gift     @relation(fields: [giftId], references: [id])

  @@index([liveRoomId, createdAt])
  @@index([userId])
}

// ─────────────────────────────────────────────────
// 收益分账
// ─────────────────────────────────────────────────

enum EarningScene {
  QUESTION       // 付费提问
  PEEK           // 围观答案
  AUDIO_CALL     // 音频连麦
  LIVE_GIFT      // 直播打赏
}

model UserEarning {
  id         String       @id @default(uuid())
  userId     String       // 收益人
  scene      EarningScene // 场景
  refId      String       // 关联业务ID（问答ID/通话ID/礼物记录ID）
  amountCoin Int          // 关联币数
  amountRmb  Decimal      @db.Decimal(10, 2) // 折算人民币收益
  rate       Decimal      @db.Decimal(5, 4)  // 分佣比例（如0.8=80%）
  createdAt  DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([refId])
}

// ─────────────────────────────────────────────────
// 推荐系统
// ─────────────────────────────────────────────────

enum BehaviorType {
  VIEW
  LIKE
  COLLECT
  COMMENT
  PURCHASE
  LEARN
  SEARCH
  SHARE
  FOLLOW
}

model UserBehavior {
  id         String       @id @default(uuid())
  userId     String
  targetType String       // ARTICLE, COURSE, PRODUCT, VIDEO, CIRCLE, CONTENT
  targetId   String
  behavior   BehaviorType
  weight     Float        @default(1.0)
  scene      String?
  createdAt  DateTime     @default(now())

  @@index([userId, behavior, createdAt])
  @@index([userId, targetType, targetId], name: "idx_user_target")
  @@index([targetType, targetId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model UserInterest {
  id        String   @id @default(uuid())
  userId    String
  tag       String
  score     Float    @default(1.0)
  source    String   @default("BEHAVIOR") // TAG_MATCH, PURCHASE, BEHAVIOR, ADMIN
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, tag])
  @@index([userId, score])
  @@index([tag, score])
  @@index([tag])
}

model RecommendRule {
  id             String   @id @default(uuid())
  scene          String   // paipan_result, course_detail, product_detail, article_detail, payment_success, search_empty, empty_state, guess_like, ALL
  targetType     String   // COURSE, PRODUCT, ARTICLE, CIRCLE, VIDEO
  targetId       String
  ruleType       String   // PIN, BOOST, MUTE, BAN, INSERT
  ruleValue      Float?
  position       Int?      // 分区强插位置（第N位）
  priority       Int      @default(0)
  conditionJson  Json?
  startAt        DateTime?
  endAt          DateTime?
  remark         String?
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([scene, targetType, targetId])
  @@index([scene, ruleType])
  @@index([ruleType, priority])
}

model RecommendLog {
  id          String   @id @default(uuid())
  userId      String?
  scene       String
  itemType    String
  itemId      String
  position    Int
  strategy    String
  recommendId String?
  isClick     Boolean  @default(false)
  staySeconds Int?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([scene, createdAt])
  @@index([recommendId])
  @@index([strategy])
}

// ─────────────────────────────────────────────────
// Webhook 系统
// ─────────────────────────────────────────────────

enum WebhookEvent {
  ORDER_PAID
  ORDER_REFUNDED
  USER_REGISTERED
  CONTENT_PUBLISHED
  WITHDRAWAL_REQUESTED
  COURSE_ENROLLED
  LIVE_STARTED
  LIVE_ENDED
}

model WebhookSubscription {
  id          String       @id @default(uuid())
  event       WebhookEvent
  url         String       // 回调URL
  secret      String?      // HMAC-SHA256 签名密钥
  description String?      // 备注
  isActive    Boolean      @default(true)
  lastSentAt  DateTime?
  lastStatus  Int?         // 最后一次发送HTTP状态码
  retryCount  Int          @default(0) // 累计重试次数
  maxRetries  Int          @default(3)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([event, isActive])
  @@index([url])
}

model FeatureFlag {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  description   String?
  enabled       Boolean  @default(false)
  percentage    Int      @default(100)
  targetUserIds String[] @default([])
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────────────
// 电子书系统（通用电子书，区别于 ClassicBook 古籍）
// ─────────────────────────────────────────────────

enum EbookStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

model EbookCategory {
  id        String   @id @default(uuid())
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  books Ebook[]

  @@unique([name])
}

model Ebook {
  id            String     @id @default(uuid())
  title         String
  author        String?
  cover         String?
  description   String?
  categoryId    String?
  price         Decimal    @default(0) @db.Decimal(10, 2)
  originalPrice Decimal?   @db.Decimal(10, 2)
  fileUrl       String?                        // PDF/EPUB 存储地址
  fileType      String     @default("PDF")     // PDF, EPUB
  fileSize      Int?                           // 文件大小 (bytes)
  totalChapters Int        @default(0)
  language      String     @default("zh-CN")   // AI 翻译目标语言
  hasWatermark  Boolean    @default(true)      // 版权水印
  memberFree    Boolean    @default(false)     // 会员免费读
  status        EbookStatus @default(DRAFT)
  viewCount     Int        @default(0)
  purchaseCount Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  category  EbookCategory?  @relation(fields: [categoryId], references: [id])
  chapters  EbookChapter[]
  purchases EbookPurchase[]
  progress  EbookProgress[]
  bookmarks EbookBookmark[]
  notes     EbookNote[]

  @@index([categoryId])
  @@index([status])
}

model EbookChapter {
  id        String   @id @default(uuid())
  ebookId   String
  title     String
  content   String?                          // 纯文本章节内容
  pageStart Int      @default(0)
  pageEnd   Int      @default(0)
  sortOrder Int      @default(0)
  freeTrial Boolean  @default(false)         // 免费试读章节
  createdAt DateTime @default(now())

  ebook    Ebook            @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  progress EbookProgress[]
  bookmarks EbookBookmark[]
  notes    EbookNote[]

  @@index([ebookId, sortOrder])
}

model EbookProgress {
  id           String   @id @default(uuid())
  userId       String
  ebookId      String
  chapterId    String?
  progress     Int      @default(0)          // 0-100 百分比
  currentPage  Int      @default(0)
  completed    Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebook   Ebook         @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  chapter EbookChapter? @relation(fields: [chapterId], references: [id])

  @@unique([userId, ebookId])
  @@index([userId])
}

model EbookBookmark {
  id        String   @id @default(uuid())
  userId    String
  ebookId   String
  chapterId String?
  page      Int      @default(0)
  note      String?                          // 书签备注
  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebook   Ebook         @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  chapter EbookChapter? @relation(fields: [chapterId], references: [id])

  @@index([userId, ebookId])
}

model EbookNote {
  id        String   @id @default(uuid())
  userId    String
  ebookId   String
  chapterId String?
  content   String
  page      Int      @default(0)
  isPublic  Boolean  @default(false)         // 是否公开笔记
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebook   Ebook         @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  chapter EbookChapter? @relation(fields: [chapterId], references: [id])

  @@index([userId, ebookId])
  @@index([ebookId])
}

model EbookPurchase {
  id       String   @id @default(uuid())
  userId   String
  ebookId  String
  amount   Decimal  @db.Decimal(10, 2)
  paidAt   DateTime @default(now())
  expireAt DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebook Ebook @relation(fields: [ebookId], references: [id], onDelete: Cascade)

  @@unique([userId, ebookId])
  @@index([userId])
}

// ─────────────────────────────────────────────────
// 平台操作日志（区别于 AuditLog 审计日志）
// ─────────────────────────────────────────────────

model OperationLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String                           // 操作动作（如 config.update, user.ban）
  targetType String?                          // 操作目标类型
  targetId   String?                          // 操作目标ID
  detail     Json?                            // 操作详情（变更前后对比等）
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────
// 营销管理
// ─────────────────────────────────────────────────

model FlashSale {
  id           String   @id @default(uuid())
  name         String   @default("")           // 活动名称
  startTime    DateTime                        // 秒杀开始时间
  endTime      DateTime                        // 秒杀结束时间
  warmupMinutes Int     @default(0)            // 预热提前分钟数
  status       String   @default("DRAFT")      // DRAFT/UPCOMING/ACTIVE/ENDED/CANCELLED
  items        FlashSaleItem[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, startTime])
}

model FlashSaleItem {
  id          String    @id @default(uuid())
  flashSaleId String
  productId   String
  skuId       String?
  flashPrice  Decimal   @db.Decimal(10, 2)    // 秒杀价
  limitCount  Int       @default(1)           // 每人限购
  stock       Int                              // 秒杀库存
  sold        Int       @default(0)           // 已售
  sortOrder   Int       @default(0)

  flashSale FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)

  @@unique([flashSaleId, productId])
}

model GroupBuy {
  id             String   @id @default(uuid())
  productId      String
  skuId          String?
  groupPrice     Decimal  @db.Decimal(10, 2)   // 拼团价
  minMembers     Int      @default(2)         // 成团人数
  expireMinutes  Int      @default(1440)       // 拼团有效期（分钟）
  status         String   @default("DRAFT")   // DRAFT/ACTIVE/ENDED
  autoComplete   Boolean  @default(false)     // AI模拟成团
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  participants GroupBuyParticipant[]

  @@index([status])
}

model GroupBuyParticipant {
  id          String   @id @default(uuid())
  groupBuyId  String
  userId      String
  groupId     String                          // 同一个拼团组的标识
  isLeader    Boolean  @default(false)        // 是否是团长
  status      String   @default("WAITING")    // WAITING/SUCCESS/REFUNDED
  createdAt   DateTime @default(now())

  groupBuy GroupBuy @relation(fields: [groupBuyId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([userId])
}

model CouponTemplate {
  id           String   @id @default(uuid())
  name         String                          // 优惠券名称
  type         String                          // FIXED(满减)/PERCENT(折扣)/SHIPPING(免邮)
  faceValue    Decimal  @db.Decimal(10, 2)    // 面额（元）/折扣率
  threshold    Decimal? @db.Decimal(10, 2)    // 使用门槛（元）
  totalCount   Int      @default(0)           // 发行总量，0=不限
  claimedCount Int      @default(0)
  usedCount    Int      @default(0)
  startTime    DateTime                        // 领取开始时间
  endTime      DateTime                        // 领取结束时间
  validDays    Int      @default(7)            // 领取后有效期（天）
  scope        Json?                           // 适用范围：{ productIds, categoryIds, circles }
  aiPrecision  Boolean  @default(false)        // AI精准发券
  status       String   @default("DRAFT")      // DRAFT/ACTIVE/ENDED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  records CouponRecord[]

  @@index([status, endTime])
}

model CouponRecord {
  id          String   @id @default(uuid())
  couponId    String
  userId      String
  status      String   @default("UNUSED")     // UNUSED/USED/EXPIRED
  claimedAt   DateTime @default(now())
  usedAt      DateTime?

  coupon CouponTemplate @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId, status])
  @@index([userId])
}

model DiscountActivity {
  id          String   @id @default(uuid())
  name        String
  discountPct Int                              // 折扣百分比（1-99）
  startTime   DateTime
  endTime     DateTime
  productIds  String[]                         // 适用商品ID列表
  status      String   @default("DRAFT")       // DRAFT/ACTIVE/ENDED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, startTime])
}

model MarketingPage {
  id          String   @id @default(uuid())
  name        String                          // 页面名称
  route       String   @unique               // 路由路径
  status      String   @default("DRAFT")     // DRAFT/PUBLISHED/OFFLINE
  version     Int      @default(1)           // 当前版本号
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  components MarketingPageComponent[]
}

model MarketingPageComponent {
  id          String   @id @default(uuid())
  pageId      String
  type        String                          // banner/countdown/flashsale/groupbuy/coupon/recommend/richtext/tabs
  title       String?
  config      Json                            // 组件配置JSON
  sortOrder   Int      @default(0)
  startTime   DateTime?
  endTime     DateTime?
