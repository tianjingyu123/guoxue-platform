/// 资金审批流：研究院分红/汇付退款/灵石充值/分佣比例变更 等资金操作发起后落此表，
/// 待 SUPER_ADMIN / FINANCE_ADMIN 审批通过后才真正执行。
model FundApproval {
  id          String    @id @default(uuid())
  type        String // DIVIDEND | REFUND | RECHARGE | COMMISSION_CONFIG
  payload     Json // 执行所需参数（按 type 区分结构）
  amount      Decimal?  @db.Decimal(12, 2) // 涉及金额（部分类型如分佣变更可为空）
  summary     String // 人类可读摘要
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedBy String // 发起人 userId
  reviewedBy  String? // 审批人 userId
  reviewNote  String? // 审批备注
  createdAt   DateTime  @default(now())
  processedAt DateTime? // 审批处理时间

  @@index([status, createdAt])
  @@map("fund_approval")
}

// ─────────────────────────────────────────────────
// 统一结算引擎（T1）：场景规则 + 统一分账总账
// 合规硬约束见 modules/settlement/settlement.service.ts（L1-L5 铁律）
// ─────────────────────────────────────────────────

/// 结算场景规则：每个资金场景一条，splits 定义各角色分成；修改须走 FundApproval(COMMISSION_CONFIG)
model SettlementRule {
  id                String   @id @default(uuid())
  scene             String   @unique // QUESTION / PEEK / AUDIO_CALL / LIVE_GIFT / CONSULT_CALL / MEMBER_PURCHASE / COURSE_ORDER ...
  splits            Json // [{ role, rate, basis: GROSS|PARENT_SPLIT, category: COMMISSION|SERVICE|PLATFORM, parentRole? }]
  bufferDays        Int      @default(7) // 结算缓冲期天数（0=实时可提）
  requireApproval   Boolean  @default(false) // 大额人工复核开关
  approvalThreshold Decimal? @db.Decimal(10, 2) // 单笔收益冻结复核阈值（元）
  enabled           Boolean  @default(true)
  remark            String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// 统一分账总账（影子账本起步）：每笔分账一条，正=入账 负=冲正；可提现口径最终以 SETTLED 为准
model LedgerEntry {
  id              String   @id @default(uuid())
  scene           String
  refType         String // 交易凭据类型：ORDER / GIFT_RECORD / CONSULT_CALL / QUESTION ...（真实交易计酬铁律）
  refId           String
  beneficiaryType String // USER / STATION / OPERATOR / MERCHANT / PLATFORM
  beneficiaryId   String
  role            String // PROVIDER / CIRCLE_OWNER / STATION / OPERATOR / PLATFORM
  category        String // COMMISSION 推广计酬 / SERVICE 劳务对价 / PLATFORM 平台留存
  amount          Decimal  @db.Decimal(12, 2)
  rate            Decimal  @db.Decimal(5, 4)
  status          String   @default("PENDING") // PENDING / SETTLED / FROZEN / REVERSED
  availableAt     DateTime // 缓冲期到期时间，过期由 settlePending 批量置为 SETTLED
  batchId         String?
  reason          String? // 冻结/冲正原因
  createdAt       DateTime @default(now())

  @@index([refType, refId])
  @@index([beneficiaryType, beneficiaryId, status])
  @@index([status, availableAt])
  @@index([scene, createdAt])
}

/// 渠道主体临时链接点击（佣-V2-P2·2026-07-04 拍板）：
/// 三类可锁佣渠道主体（STATION 分站 / CIRCLE 圈子 / OFFLINE_STATION 驿站）的推广链接点击落库，
/// 7 天有效窗·同 user+subject+target 重复点击更新 clickedAt/expiresAt（last-click 语义·不堆行）。
/// 下单归因：取该用户对该商品（targetId 精确优先，其次 SHOP_ALL）未过期最新一条 → Order.tempReferrerId
model ChannelClick {
  id                String   @id @default(cuid())
  subjectType       String // STATION / CIRCLE / OFFLINE_STATION
  subjectId         String // 渠道主体id（Station.id / Circle.id / StationOffline.id）
  beneficiaryUserId String // 受益人userId（站长/圈主/驿站主·点击时解析好，下单时直接用）
  userId            String // 被触达用户
  targetType        String // PRODUCT / SHOP_ALL(全店) 等
  targetId          String?
  clickedAt         DateTime @default(now())
  expiresAt         DateTime // clickedAt + 7天

  @@index([userId, targetType, targetId, clickedAt])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────
// 智能商业顾问（T2）：诊断规则 + 建议实例
// ─────────────────────────────────────────────────

/// 顾问规则（后台可运营）：一条规则 = 一类经营问题的检测器
model AdvisorRule {
  id         String   @id @default(uuid())
  roleType   String // CIRCLE_OWNER / LECTURER / STATION_MASTER / OPERATOR / STATION_OFFLINE_OWNER
  ruleKey    String   @unique // 如 station_earning_wow_drop / offline_stock_low
  metric     String // 探针名（AdvisorService PROBES 支持的 key）
  condition  Json // 探针参数 { thresholdPct, days, ... }
  severity   String   @default("INFO") // INFO / WARN / CRITICAL
  suggestion String // 模板建议文案（{{占位符}} 用 facts 渲染；P2 接 AI 个性化）
  actions    Json // [{ label, type: "NAVIGATE", target }]
  enabled    Boolean  @default(true)
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([roleType, enabled])
}

// ─────────────────────────────────────────────────
// 平台级成长体系（T4 游戏化·2026-07-03）：学分/功名等级/连续学习/成就
// 与圈子级 growth（CircleMemberGrowth）互不干扰；积分（UserPoints）是可消费货币，学分（totalExp）是不可消费的成长值
// ─────────────────────────────────────────────────

/// 用户成长档案：学分与功名等级（书童→童生→秀才→…→宗师，阶梯定义在 user-growth.service）
model UserGrowth {
  id               String    @id @default(uuid())
  userId           String    @unique
  totalExp         Int       @default(0) // 累计学分（只增不减）
  level            Int       @default(1)
  currentStreak    Int       @default(0) // 当前连续学习天数（与签到联动）
  maxStreak        Int       @default(0)
  lastCheckinDate  DateTime?
  mentorshipPoints Int       @default(0) // 师徒传承·传道值（纯荣誉·累计各徒弟贡献·不可兑换任何财物）
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// 师徒传承关系（V5·纯荣誉体系）
/// 合规隔离铁律：完全独立于 ReferralRelation/commission/settlement 计酬链路，
/// 拜师不产生任何资金关系，传道值不可兑换现金/国学币/任何财物，师徒单层不嵌套计酬。
/// 「一人一师」约束按 ACTIVE 计（应用层校验：无 ACTIVE 师父方可拜师），
/// GRADUATED 出师后不占位、可再拜新师，故不加表级 @@unique([discipleId])。
model Mentorship {
  id               String    @id @default(uuid())
  mentorId         String // 师父 userId
  discipleId       String // 徒弟 userId
  status           String    @default("ACTIVE") // ACTIVE | GRADUATED
  mentorshipPoints Int       @default(0) // 该徒弟累计为师父贡献的传道值（归属明细）
  disciplePledge   String? // 拜师寄语
  createdAt        DateTime  @default(now())
  graduatedAt      DateTime?

  @@index([mentorId])
  @@index([discipleId])
}

/// 用户-智能体追问额度（AI 计费·2026-07-03 拍板）：免费试用消耗 + 已购追问包余量
model UserBotQuota {
  id            String   @id @default(uuid())
  userId        String
  botConfigId   String
  freeUsed      Int      @default(0)
  paidRemaining Int      @default(0)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([userId, botConfigId])
}

/// AI 内容质量评分（T7·四维：深度/原创/实用/吸引，各 0-25 总分 0-100）：高分流量倾斜、低分降权
model ContentQualityScore {
  id          String   @id @default(uuid())
  targetType  String // ARTICLE / POST
  targetId    String
  depth       Int
  originality Int
  utility     Int
  appeal      Int
  total       Int // 四维之和 0-100
  grade       String // A(>=80) / B(>=60) / C(>=40) / D(<40)
  reason      String? // AI 一句话评语（后台可见）
  model       String? // 打分模型标识
  scoredAt    DateTime @default(now())

  @@unique([targetType, targetId])
  @@index([targetType, total])
}

/// 成就记录（成就定义为代码常量，沿用圈子徽章范式；分享卡=V1 裂变载体）
model UserAchievement {
  id       String   @id @default(uuid())
  userId   String
  code     String
  earnedAt DateTime @default(now())

  @@unique([userId, code])
  @@index([userId, earnedAt])
}

/// 平台级称号（B1 游戏化打磨 · 2026-07-03）：可收集可佩戴的荣誉头衔（等级里程碑/特殊成就自动颁发·幂等）。
/// 与 GrowthValue.levelName（当前等级名）区别：称号是永久收藏品，用户可选一枚佩戴展示。纯荣誉不可兑现。
model UserTitle {
  id       String   @id @default(uuid())
  userId   String
  code     String // TITLES 目录 code
  equipped Boolean  @default(false) // 每用户至多一枚佩戴（应用层保证）
  earnedAt DateTime @default(now())

  @@unique([userId, code])
  @@index([userId, equipped])
}

/// 顾问建议实例：每日 cron 按规则评估生成，工作台「经营顾问」卡拉取
model AdvisorInsight {
  id        String    @id @default(uuid())
  ruleKey   String
  roleType  String
  subjectId String // 主体ID（分站ID/驿站ID/圈子ID/讲师userId）
  severity  String
  facts     Json // 结构化事实 { current, baseline, deltaPct, ... }
  content   String // 最终建议文案
  actions   Json
  status    String    @default("OPEN") // OPEN / READ / ACTED / DISMISSED / EXPIRED
  actedAt   DateTime?
  feedback  Json? // 效果回访（P2：7天后回填指标变化）
  createdAt DateTime  @default(now())

  @@index([roleType, subjectId, status])
  @@index([ruleKey, subjectId, createdAt])
}

/// V3 共读拼团（纯学习激励·无资金）：一组用户约定共读某古籍并在周期内完成目标章节
/// 与商城 GroupBuy（支付拼团）物理隔离；奖励是 user-growth 荣誉学分，不可兑现。无 FK（拉取式对接进度）。
model SharedReadingGroup {
  id             String    @id @default(uuid())
  classicBookId  String // 关联古籍 ClassicBook.id（无 FK·拉取式）
  bookTitle      String // 冗余书名（避免每次联查）
  initiatorId    String // 发起人 User.id
  targetChapters Int // 目标完成章节数
  minMembers     Int       @default(3)
  maxMembers     Int       @default(5)
  durationDays   Int       @default(7)
  startAt        DateTime? // 开读时间（转 READING 时写入）
  deadline       DateTime? // 截止时间（startAt + durationDays）
  status         String    @default("RECRUITING") // RECRUITING | READING | COMPLETED | EXPIRED
  inviteToken    String    @unique // 邀请分享 token（随机32位）
  createdAt      DateTime  @default(now())

  @@index([status])
  @@index([initiatorId])
}

/// 共读组成员：完成进度快照由 GET 详情时实时统计（拉取式），结算时持久化+发奖
model SharedReadingMember {
  id                String    @id @default(uuid())
  groupId           String
  userId            String
  isLeader          Boolean   @default(false)
  joinedAt          DateTime  @default(now())
  completedChapters Int       @default(0) // 已完成目标内章节数（结算时持久化）
  completed         Boolean   @default(false)
  rewardedAt        DateTime? // 学分发放时间（防重发）

  @@unique([groupId, userId])
  @@index([groupId])
}

/// V8 节气仪式参与记录（纯荣誉·无资金）：每人每节气每年一条，防重；无 FK
model SolarTermParticipation {
  id             String   @id @default(cuid())
  userId         String
  termName       String // 节气名（中文，与 calcAllJieQi 键一致）
  year           Int
  participatedAt DateTime @default(now())

  @@unique([userId, termName, year])
  @@index([userId])
}

/// 运营看板天级聚合表（看-P1）：每日 00:30 cron 聚合昨日指标写一行，看板查询永不打原始大表；
/// date 为 Asia/Shanghai 日期串 YYYY-MM-DD（唯一·upsert 幂等）；metrics 按「能便宜聚合到的先做」诚实降级，取不到的字段省略
model DashboardDaily {
  id        String   @id @default(uuid())
  date      String   @unique // Asia/Shanghai 日期 YYYY-MM-DD
  metrics   Json // { dau, pv, newUsers, d1Retention?, gmv, ordersPaid, memberNew, commissionSum, moduleHeat: [{path,pv}], errors24h }
  createdAt DateTime @default(now())
}

/// 课-P1 AI 获客内容套件：营销内容类型
enum MarketingContentKind {
  SHORT_VIDEO // 短视频脚本
  MOMENTS // 朋友圈文案
  XIAOHONGSHU // 小红书图文
}

/// 课-P1 AI 获客内容套件：从业者营销内容生成记录（AI 生成→过三层审核漏斗→落库·passedAudit=true 为过审留痕）；
/// 内容尾部自动拼从业者 ref 归因短链；月限额按 (userId, 当月 createdAt) count 判定；无 FK
model MarketingContent {
  id          String               @id @default(cuid())
  userId      String
  kind        MarketingContentKind
  topic       String // 选题/主题（≤100 字）
  content     String // 生成的最终文案（含尾部 ref 短链）
  passedAudit Boolean              @default(false)
  createdAt   DateTime             @default(now())

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────
// 课-P3 客户经营 CRM（服务环）—— 设计 docs/design/课题一补完-从业者全链路SaaS工具链-20260704.md §四
// 合规红线（设计即合规）：客户数据归从业者私有（全部查询强制 ownerId 隔离）；
// phoneEnc/birthEnc 走 M4 AES-256-GCM 加密存储；平台层禁跨从业者聚合个体（R3）；
// 禁导出端点（防数据贩卖）；客户可要求删除 → 硬删 + AuditLog 留痕。
// ─────────────────────────────────────────────────

/// 客户档案（归属从业者·ownerId 逻辑关联 User 不建 FK，与 AdvisorInsight 同范式）
model ClientBook {
  id           String    @id @default(cuid())
  ownerId      String // 归属从业者 userId（数据隔离主键·所有查询必须带）
  name         String // 客户称呼/昵称
  phoneEnc     String? // 手机号密文（M4 AES-256-GCM·展示时 decrypt，列表脱敏）
  birthEnc     String? // 生辰密文（M4·明文格式 YYYY-MM-DD[ HH:mm]·仅用于生日/流年提醒）
  gender       String? // male / female
  tags         String[]  @default([]) // 客户标签（如 事业/婚恋/老客）
  source       String    @default("manual") // manual手工 / card名片 / order订单归因
  sourceUserId String? // 订单归因入库时的平台买家 userId（判「已入库」防重复建议·手工客户为空）
  lastServeAt  DateTime? // 最近服务时间（RFM·R·由服务记录聚合回写）
  serveCount   Int       @default(0) // 服务次数（RFM·F）
  totalSpend   Decimal   @default(0) @db.Decimal(12, 2) // 累计消费（RFM·M）
  notes        String? // 从业者私人备注
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  serveLogs ClientServeLog[]
  reminders ClientReminder[]

  @@unique([ownerId, sourceUserId]) // 同一买家对同一从业者只入库一次（NULL 不受约束·手工客户不限）
  @@index([ownerId, createdAt])
  @@index([ownerId, lastServeAt])
}

/// 服务记录：写入后在同事务内聚合回写 ClientBook 的 lastServeAt/serveCount/totalSpend
model ClientServeLog {
  id        String   @id @default(cuid())
  clientId  String
  ownerId   String // 冗余归属·隔离校验双保险（避免 join 才能判归属）
  type      String // consult咨询 / course课程 / product商品 / paipan排盘
  amount    Decimal? @db.Decimal(10, 2) // 本次服务金额（可空·免费服务）
  summary   String // 服务摘要（≤200 字）
  servedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  client ClientBook @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, servedAt])
  @@index([ownerId, servedAt])
}

/// 客户提醒：cron 幂等生成（生日/立春流年/复购·大运切换=TODO 需盘存档深度联动）；aiDraft 按需生成（便宜档·失败降级模板话术）
model ClientReminder {
  id        String    @id @default(cuid())
  clientId  String
  ownerId   String
  kind      String // BIRTHDAY生日 / LICHUN立春流年 / REPURCHASE复购 / DAYUN大运切换(暂不生成)
  dueAt     DateTime // 应跟进日期（生日=当年生日当天·立春=当年2月4日·复购=生成当日）
  status    String    @default("PENDING") // PENDING / DONE
  aiDraft   String? // AI 草拟话术（按需生成·合规定性约束内置 prompt）
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  client ClientBook @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([ownerId, status, dueAt])
  @@index([clientId, kind, dueAt])
}

/// 后台运营反馈（智能助手收集员工遇到的问题→董事长审阅拍板→优化）
model AdminFeedback {
  id        String   @id @default(cuid())
  userId    String // 提交人（员工/管理员）
  userName  String   @default("") // 提交人昵称快照
  page      String   @default("") // 提交时所在后台页面路由（供定位）
  category  String   @default("OTHER") // BUG问题 / OPTIMIZE优化建议 / QUESTION操作疑问 / OTHER
  title     String
  detail    String   @db.Text
  images    String[] @default([]) // 员工上传的截图 URL（截图标注问题更易定位）
  status    String   @default("PENDING") // PENDING待审 / REVIEWED已阅 / ADOPTED采纳 / REJECTED不采纳 / DONE已优化
  reply     String   @default("") @db.Text // 董事长/处理人的批复
  source    String   @default("MANUAL") // MANUAL员工手动 / ASSISTANT助手代记
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([category, status])
}

/// 收款主体（分账接收方）—— 资金架构的地基，见 docs/design/资金与分账架构-设计文档-20260714.md
///
/// 【为什么统一成一张表，而不在 Merchant/StationOffline/Circle 各加字段】
/// 进件流程对所有主体是同一套（采资质 → 提渠道 → 回调落号 → 状态机）；分散建模就要写三遍，
/// 且分账时还得写三个分支去找收款方身份。统一后分账只问一句「这个主体的 PayeeAccount 是谁」。
///
/// 【它解决的根因】此前 Merchant/StationOffline/Circle 一个渠道商户号字段都没有 ——
/// 商家/驿站/圈主在支付渠道眼里根本不存在，这是所有分账接不通的唯一根因。
///
/// 【二清红线】平台永不做「收了再转」。SELF_COLLECT 的钱直接进主体自己的渠道账户，
/// 由持牌机构（汇付/微信）执行分账把平台那份分过来；平台只下指令，不碰资金分发。
model PayeeAccount {
  id String @id @default(uuid())

  // ── 主体 ──
  subjectType String // MERCHANT / OFFLINE_STATION / CIRCLE / INSTITUTE
  subjectId   String // 对应业务表的主键
  userId      String // 主体负责人（法人/圈主/驿站长）——代付与责任归属

  // ── 结算模式：决定「谁是收款主体」，也就决定了责任归属 ──
  // PLATFORM_COLLECT 平台收款 → 平台是经营者，担商品/内容/纠纷责任（无照主体只能走这条）
  // SELF_COLLECT     主体自收 → 责任随钱外移到主体（须有营业执照才能进件）
  settlementMode String @default("PLATFORM_COLLECT")

  /// 平台分成比例。圈子双轨的落点：无照 0.5 / 有照 0.2（费率差驱动圈主自己去办执照）；
  /// 驿站 0.3（微信分账硬顶 30% 且基数是扣费后金额，故驿站默认走汇付）；商家按类目。
  platformRate Decimal @default(0) @db.Decimal(5, 4)

  // ── 资质（SELF_COLLECT 必需·进件材料）──
  subjectName  String? // 主体名称（须与营业执照一致）
  licenseNo    String? // 统一社会信用代码
  licenseImage String? // 营业执照图
  legalName    String? // 法人姓名
  legalIdCard  String? // 法人身份证号（加密存储·crypto.util encrypt）
  legalIdFront String?
  legalIdBack  String?
  bankName     String? // 结算银行
  bankBranch   String? // 支行
  bankAccount  String? // 结算账号（加密存储）
  bankHolder   String? // 户名

  // ── 渠道身份（进件成功后由渠道回调回填·分账接收方就靠这几个 ID）──
  huifuId     String? @unique // 汇付商户号（主通道：无 30% 上限，且我们是服务商可开户）
  wxSubMchId  String? // 微信特约商户号
  alipayPid   String? // 支付宝 PID
  payeeOpenid String? // 微信代付/分账用 openid（个人接收方）

  // ── 进件状态机 ──
  // DRAFT 资料待完善 → SUBMITTED 已提交渠道 → APPROVING 渠道审核中
  //   → ACTIVE 可收款可分账 / REJECTED 被拒 / DISABLED 停用
  status         String    @default("DRAFT")
  channel        String    @default("HUIFU") // HUIFU / WECHAT / ALIPAY
  channelApplyId String? // 渠道返回的进件申请单号（查进度用）
  submittedAt    DateTime?
  activatedAt    DateTime?
  rejectReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([subjectType, subjectId]) // 一个主体一个收款账户
  @@index([status])
  @@index([userId])
  @@index([settlementMode, status])
}
