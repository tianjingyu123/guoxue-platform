// ─────────────────────────────────────────────────
// 排盘系统
// ─────────────────────────────────────────────────

// 【分区候选】P2阶段按月分区(createdAt)，分片键userId，90天后归档
model PaipanRecord {
  id          String   @id @default(uuid())
  userId      String
  clientName  String? // 被排盘人姓名
  clientBirth String // 生辰信息（AES加密）
  paipanType  String // 工具ID：bazi/ziwei/qimen-yang/.../daliuren/... 等32种，向后兼容旧值 BAZI/ZIWEI/FENGSHUI/NAME
  inputParams Json // 输入参数
  groupName   String? // 用户自定义分组
  resultData  Json // 排盘结果JSON
  createdAt   DateTime @default(now())

  user       User               @relation(fields: [userId], references: [id])
  aiAnalysis AiAnalysisRecord[]

  @@index([userId, createdAt])
  @@index([userId, paipanType, createdAt])
  @@index([createdAt])
  @@index([paipanType])
}

// V4 双人合盘（合婚/合作盘裂变）——邀请授权流 + R3 最小授权
// 发起方只有自己的盘，必须拉对方进来授权；双方唯一共享内容=合婚报告文本
// 生辰/原始盘绝不互相暴露（任何端点都不返回对方 recordId/四柱/生辰）
model CoupleChart {
  id                String   @id @default(uuid())
  initiatorId       String // 发起方 userId
  partnerId         String? // 被邀请方 userId（授权后填）
  status            String   @default("PENDING_INVITE") // PENDING_INVITE | AUTHORIZED | REJECTED | EXPIRED
  initiatorRecordId String // 发起方自己的 BAZI 盘 id（裸 String，无 FK）
  partnerRecordId   String? // 对方授权时提供的 BAZI 盘 id（裸 String，无 FK）
  inviteToken       String // 邀请链接令牌（随机 32 位 hex）·唯一约束见 @@unique
  analysisId        String? // 关联 AiAnalysisRecord.id（合婚报告）
  initiatorDeleted  Boolean  @default(false) // 发起方单侧软删可见性
  partnerDeleted    Boolean  @default(false) // 被邀请方单侧软删可见性
  expiresAt         DateTime // 邀请过期时间（now + 7 天）
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  initiator User  @relation("CoupleChartInitiator", fields: [initiatorId], references: [id])
  partner   User? @relation("CoupleChartPartner", fields: [partnerId], references: [id])

  @@unique([inviteToken])
  @@index([initiatorId])
  @@index([partnerId])
}

// 用户自定义分组（跨排盘工具）
model PaipanGroup {
  id         String   @id @default(uuid())
  userId     String
  paipanType String // BAZI / QIMEN / YANGPAN
  name       String
  color      String? // 分组颜色（可选）
  createdAt  DateTime @default(now())

  @@unique([userId, paipanType, name])
  @@index([userId, paipanType])
}

// 八字案例库（名人案例 + 大众案例）
model CelebrityCase {
  id           String   @id @default(uuid())
  name         String
  gender       String // male / female
  description  String // 朝代/时代
  subtitle     String // 身份/特点
  primaryCat   String // 名人案例 / 大众案例
  secondaryCat String // 君主/商界/文艺/体育/历史/军事/僧道/财运/事业/婚姻/健康/学业/灾厄/长寿
  bazi         String[] // [年干,月干,日干,时干,年支,月支,日支,时支] 共8字
  letter       String // 姓名拼音首字母大写
  zodiac       String // 生肖
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([primaryCat, secondaryCat])
  @@index([letter])
  @@index([sortOrder])
}

// ── 八字命理专业知识库（RAG 第3层） ──
model BaziKnowledge {
  id          String   @id @default(uuid())
  title       String
  category    String // 天干地支/五行生克/十神/格局/用神/神煞/大运流年/实战案例
  content     String   @db.Text
  tags        String[] @default([])
  source      String? // 来源古籍（渊海子平/三命通会/滴天髓/etc.）
  contentHash String? // 去重哈希
  status      String   @default("PUBLISHED") // DRAFT/PUBLISHED/HIDDEN
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([title, category])
  @@index([category])
  @@index([status])
  @@index([createdAt])
}

model ZiweiKnowledge {
  id          String   @id @default(uuid())
  title       String
  category    String // 十四主星/辅星煞星/四化/十二宫/格局/实战案例
  content     String   @db.Text
  tags        String[] @default([])
  source      String? // 来源古籍（紫微斗数全书/太微赋/骨髓赋/etc.）
  contentHash String?
  status      String   @default("PUBLISHED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([title, category])
  @@index([category])
  @@index([status])
}

// 【分区候选】P2阶段按月分区(createdAt)，分片键userId，90天后归档
model AiAnalysisRecord {
  id              String   @id @default(uuid())
  userId          String
  paipanRecordId  String?
  toolId          String? // 工具ID（如 bazi, qimen-yang），用于统一工具AI分析
  analyzeType     String // CAREER, LOVE, WEALTH, HEALTH, GENERAL, BAZI_SCHOOL
  school          String? // AI 师徒流派 id（ziping/mangpai/xinpai），analyzeType=BAZI_SCHOOL 时非空
  analysisContent String // 分析全文
  modelName       String   @default("deepseek-v4-pro")
  tokenUsage      Json? // { promptTokens, completionTokens }
  isCached        Boolean  @default(false)
  // AI网关扩展字段
  scene           String? // 调用场景：circle_assistant / customer_service / smart_search / classic_qa
  modelUsed       String? // 实际使用的模型
  fallbackUsed    Boolean  @default(false) // 是否触发降级
  fallbackModel   String? // 降级后模型
  latency         Int? // 响应延迟（ms）
  cost            Decimal? @db.Decimal(10, 4) // 费用（元）
  inputSummary    String? // 输入内容摘要（前200字符）
  outputSummary   String? // 输出内容摘要（前200字符）
  userAccepted    Boolean? // 用户是否采纳（创作辅助类）
  createdAt       DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id])
  paipanRecord PaipanRecord? @relation(fields: [paipanRecordId], references: [id])

  // 防并发双扣：同用户同盘同流派点评仅一份（T11 C-6·配套 manual-sql 20260703_t11_unique_constraints.sql）
  // 注：Postgres 唯一索引对 NULL 不去重——通用分析(school=null)与合婚(paipanRecordId=固定串)不受约束，正合语义；
  //     仅流派点评(BAZI_SCHOOL·school 非空·paipanRecordId 非空)受约束
  @@unique([userId, paipanRecordId, analyzeType, school])
  @@index([userId, analyzeType, createdAt])
  @@index([createdAt])
  @@index([scene, createdAt])
  @@index([modelUsed, createdAt])
  @@index([paipanRecordId])
  @@index([paipanRecordId, school])
}

// 【语义缓存】相似问题命中缓存直接返回，降本50%+
model AiCacheEntry {
  id              String    @id @default(uuid())
  scene           String // 调用场景
  queryHash       String // 规范化查询的MD5（精确匹配用）
  queryText       String // 原始用户查询（用于调试/统计）
  // queryVector     Unsupported("vector(1536)")? // pgvector 向量（语义匹配用，需 pgvector 扩展）
  queryVectorJson String? // 向量JSON降级存储
  response        String    @db.Text // AI 响应内容
  model           String // 生成此响应的模型
  tokenUsage      Json? // { promptTokens, completionTokens }
  hitCount        Int       @default(0) // 缓存命中次数
  lastHitAt       DateTime? // 最近一次命中时间
  createdAt       DateTime  @default(now())
  expiresAt       DateTime // 过期时间

  @@index([scene, queryHash])
  @@index([scene, expiresAt])
  @@index([hitCount])
}

// ─────────────────────────────────────────────────
// 全维度AI基础设施（P11）
// ─────────────────────────────────────────────────

// AI事件总线 — 系统事件发布/订阅
model AiEvent {
  id            String    @id @default(uuid())
  type          String // 事件类型: user.registered / order.paid / system.error_burst
  source        String // 来源维度: user / admin / marketing / ops / dev
  severity      String    @default("info") // info / warning / critical
  payload       Json // 事件载荷
  context       Json? // 上下文: userId / stationId / traceId / metrics
  status        String    @default("published") // published / processing / processed / failed
  processedBy   String[]  @default([]) // 处理了此事件的Agent列表
  processResult Json? // 处理结果汇总
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  @@index([type, createdAt])
  @@index([source, createdAt])
  @@index([severity, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

// AI能力注册中心 — 统一的AI能力目录
model AiCapability {
  id              String    @id @default(uuid())
  name            String    @unique // 能力名称: admin-data-explorer / churn-predictor
  description     String // 中文描述
  scene           String[] // 适用场景: 管理端 / 营销端 / 运维端 / 用户端
  modality        String[] // 模态: text / image / audio
  capabilityType  String // 能力类型: generation / analysis / detection / recommendation
  provider        String // 提供者: deepseek / openai / coze / internal
  model           String // 模型: deepseek-v4-pro / gpt-4o
  inputSchema     Json // 输入JSON Schema
  outputSchema    Json // 输出JSON Schema
  costPerCall     Decimal   @default(0) @db.Decimal(10, 4) // 单次调用成本（元）
  avgLatency      Int       @default(0) // 平均延迟（ms）
  qualityScore    Float     @default(0) // 质量评分 0-100
  totalCalls      Int       @default(0) // 总调用次数
  successRate     Float     @default(100) // 成功率 %
  status          String    @default("active") // active / degraded / offline
  lastHealthCheck DateTime?
  registeredAt    DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([scene])
  @@index([capabilityType])
  @@index([status])
  @@index([provider])
}

// AI决策记录与回溯 — 每个AI决策可追溯可复盘
model AiDecision {
  id                String    @id @default(uuid())
  agentId           String // 做出决策的Agent标识
  capabilityId      String? // 关联的AI能力ID
  modelId           String // 使用的模型
  modelVersion      String // 模型版本
  inputSummary      String // 输入摘要（脱敏）
  contextKeys       String[] // 使用的上下文字段
  reasoning         Json? // 推理链: { chainOfThought, confidence, alternatives }
  output            Json // 决策输出
  confidence        Float // 0-1 置信度
  riskLevel         String    @default("low") // low / medium / high
  humanAction       String? // approved / rejected / modified
  humanReviewer     String? // 审核人
  humanNote         String? // 审核备注
  humanReviewedAt   DateTime?
  outcomeMetric     String? // 效果评估指标名
  outcomeExpected   Float? // 预期值
  outcomeActual     Float? // 实际值
  outcomeMeasuredAt DateTime? // 效果测量时间
  createdAt         DateTime  @default(now())

  @@index([agentId, createdAt])
  @@index([capabilityId, createdAt])
  @@index([riskLevel, createdAt])
  @@index([humanAction, createdAt])
  @@index([createdAt])
}

// 人机协作协议 — AI建议→审核→执行→反馈闭环
model AiCollaboration {
  id              String    @id @default(uuid())
  type            String // 建议类型: config_change / content_publish / user_action / marketing_campaign
  title           String // 人类可读的建议标题
  description     String    @db.Text // AI对建议的详细解释
  proposedBy      String // 提议Agent: ai-agent:admin-advisor
  confidence      Float // 0-1 置信度
  impactScope     Json // 影响范围评估
  alternatives    Json      @default("[]") // 替代方案列表
  riskLevel       String    @default("medium") // low / medium / high
  executionPlan   Json // 执行步骤
  rollbackPlan    Json? // 回滚方案
  status          String    @default("pending_review") // pending_review / approved / rejected / modified / executing / executed / rolled_back / failed
  decisionId      String? // 关联的决策记录ID
  reviewedBy      String? // 审核人
  reviewedAt      DateTime?
  executedAt      DateTime?
  executionResult Json? // 执行结果
  rolledBackAt    DateTime?
  feedbackRating  Int? // 1-5 反馈评分
  feedbackComment String? // 反馈备注
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([riskLevel, status])
  @@index([type, createdAt])
  @@index([proposedBy, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────
// 排盘工具系统（32工具全集）
// ─────────────────────────────────────────────────

// 工具使用记录（覆盖全部32工具，替代旧PaipanRecord局限字段）
model ToolRecord {
  id          String   @id @default(uuid())
  userId      String
  toolId      String // 工具ID：bazi/ziwei/qimen-yang/... 等32个
  input       Json // 输入参数快照
  result      Json // 排盘/计算结果JSON
  stationId   String? // 分站ID（千人千面）
  durationMs  Int? // 排盘计算耗时
  ip          String? // 用户IP（风控）
  userAgent   String? // 设备UA
  sourceScene String? // home/circle_post/livestream/article/im/course/qa/comment
  sourceId    String? // 来源ID（帖子/直播ID等）
  createdAt   DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  station Station? @relation(fields: [stationId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, toolId, createdAt])
  @@index([toolId, createdAt])
  @@index([stationId, createdAt])
}

// 工具收藏
model ToolFavorite {
  id        String   @id @default(uuid())
  userId    String
  toolId    String
  sortOrder Int      @default(0) // 用户自定义排序
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, toolId])
}

// 工具结果分享
model ToolShare {
  id           String    @id @default(uuid())
  userId       String
  toolId       String
  toolRecordId String
  shareToken   String    @unique
  title        String? // 分享标题
  expiresAt    DateTime?
  viewCount    Int       @default(0)
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([shareToken])
  @@index([toolRecordId])
  @@index([userId])
}

// 工具付费解锁记录
model ToolPayRecord {
  id           String   @id @default(uuid())
  userId       String
  toolId       String
  toolRecordId String // 关联的具体排盘记录
  orderId      String? // 订单ID
  amount       Decimal  @db.Decimal(10, 2) // 付费金额
  paidAt       DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId, toolId])
  @@index([orderId])
  @@index([toolRecordId])
}

// 分站工具配置（千人千面——每个分站可自定义工具偏好）
model StationToolConfig {
  id             String   @id @default(uuid())
  stationId      String
  toolId         String
  visible        Boolean  @default(true) // 是否在首页展示
  sortOrder      Int      @default(0) // 本分站内部排序
  customName     String? // 分站自定义工具名
  customSubtitle String? // 分站自定义副标题
  methods        Json? // 分站预设方法偏好（如默认排盘方式）
  feeConfig      Json? // 分站收费配置 { enabled, amount, currency }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  station Station @relation(fields: [stationId], references: [id])

  @@unique([stationId, toolId])
  @@index([stationId])
}

// ─────────────────────────────────────────────────
// AI 质量评分
// ─────────────────────────────────────────────────

model QualityScoreRecord {
  id              String   @id @default(uuid())
  contentSnippet  String   @db.Text // 被评分内容片段（前2000字）
  scene           String? // 场景
  context         String? // 上下文（用户问题等）
  accuracy        Float // 准确性 0-100
  completeness    Float // 完整性 0-100
  readability     Float // 可读性 0-100
  professionalism Float // 专业性 0-100
  overall         Float // 综合分
  feedback        String?  @db.Text // 改进建议
  model           String? // 生成内容的模型
  createdAt       DateTime @default(now())
  createdBy       String? // 评分触发者

  @@index([scene, createdAt])
  @@index([overall])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────
// 分站与运营商
// ─────────────────────────────────────────────────

enum OperatorLevel {
  SILVER
  GOLD
  DIAMOND
  BLACK_GOLD
}

model Station {
  id              String    @id @default(uuid())
  userId          String    @unique
  name            String
  code            String    @unique // 推广码
  logo            String? // 分站Logo
  themeColor      String?   @default("#8B4513") // 主题色
  intro           String?
  status          String    @default("ACTIVE")
  totalEarning    Decimal   @default(0) @db.Decimal(12, 2)
  // 多小程序配置
  miniAppId       String? // 分站独立小程序 AppId
  mpAppId         String? // 分站公众号 AppId（H5 兜底分享）
  miniPages       Json? // 小程序页面自定义配置 { homePath, sharePath, ... }
  // 模版系统
  templateId      String?   @default("default") // 模版ID: default/paipan/lecturer/ecommerce/minimal
  templateConfig  Json? // 模版个性化参数 { modules, order, hero, tabs, showSections }
  paipanLink      String? // 分站在旧排盘系统的专属推广链接（含分站ID参数）
  paipanUserId    String? // 分站在旧排盘系统的用户ID（用于佣金结算同步）
  expireAt        DateTime? // 到期时间
  pinnedUpdatedAt DateTime? // 最近一次主推位更新时间（S1 工作台展示·主推位自服务）
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  operatorId String? // 归属运营商ID

  // ═══════════════════════════════════════════
  // 多租户 SaaS 扩展字段（预留）
  // ═══════════════════════════════════════════

  /**
   * 租户类型：
   * INTERNAL — 内部租户（分站/运营商），共享主数据库，共享小程序
   * SAAS     — 外部购买客户，独立 schema，独立小程序，品牌完全自定义
   * HOLDING  — 控股租户（战略合作方），独立 schema，独立小程序，平台有监督权
   */
  tenantType String @default("INTERNAL") // INTERNAL / SAAS / HOLDING

  /**
   * SAAS/HOLDING 租户的独立 PostgreSQL schema 名称（tenantType=INTERNAL 时为空）
   */
  schemaName String?

  /**
   * 独立数据库连接字符串（预留，当前用同一数据库的不同 schema 隔离）
   */
  dbConnString String?

  /**
   * 租户级别的功能开关 JSON（可配置每个租户开放的功能模块）
   * 如: { "paipan": true, "course": true, "live": false, "shop": true }
   */
  featureFlags Json?

  /**
   * API 每日调用配额（0=不限制），防止单个租户占用过多资源
   */
  apiDailyQuota Int @default(0)

  /**
   * 到期后数据保留天数（默认 90 天，到期后自动软删除）
   */
  dataRetentionDays Int @default(90)

  /**
   * 独立支付配置 JSON（SAAS/HOLDING 可配自己的商户号）
   * 如: { "wechatMchId": "xxx", "wechatApiKey": "xxx", "alipayAppId": "xxx" }
   */
  paymentConfig Json?

  /**
   * 是否到期自动停用
   */
  autoSuspendOnExpiry Boolean @default(true)

  user            User                   @relation(fields: [userId], references: [id])
  operator        Operator?              @relation("OperatorStations", fields: [operatorId], references: [id])
  earnings        StationEarning[]
  withdrawals     Withdrawal[]
  contents        Content[]
  products        Product[]
  articles        Article[]
  courses         Course[]
  videos          Video[]
  circles         Circle[]
  liveRooms       LiveRoom[]
  picks           StationPick[]
  pinnedContents  StationPinnedContent[]
  toolConfigs     StationToolConfig[]
  toolRecords     ToolRecord[]
  bountyQuestions BountyQuestion[]
  paidQuestions   PaidQuestion[]
  audioCalls      AudioCallRecord[]
  marketingPages  MarketingPage[]

  @@index([code])
  @@index([operatorId])
}

// ─────────────────────────────────────────────────
// 站长内容精选
// ─────────────────────────────────────────────────

model StationPick {
  id          String   @id @default(uuid())
  stationId   String
  contentType String // ARTICLE / COURSE / PRODUCT / CIRCLE / VIDEO
  contentId   String
  sortOrder   Int      @default(0)
  remark      String? // 站长推荐语
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, contentType, contentId])
  @@index([stationId, sortOrder])
}

// ─────────────────────────────────────────────────
// 分站主推位（V0 重构·三个「没有」模型的灵魂）
// 站长把平台内容锁定到「9 板块 × 每板块 6 位」的主推位，
// 分散注入平台各板块主推位，展示给该站长引流来的归属用户。
// 无分站装修 / 无独立分站页 / 无独立账号。
// ─────────────────────────────────────────────────

model StationPinnedContent {
  id          String   @id @default(uuid())
  stationId   String
  board       String // 板块：home/mall/course/circle/agent/ebook/article/video/live
  slotIndex   Int // 位序 0–5（每板块 6 个主推位）
  contentType String // 内容类型：course/product/post/agent/ebook/article/video/live_room
  contentId   String // 对应内容表主键
  lockedAt    DateTime @default(now()) // 锁定时间
  lockedBy    String // 操作站长 userId
  isActive    Boolean  @default(true) // 软删除 / 直播结束后自动置 false
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, board, slotIndex])
  @@index([stationId, board])
  @@index([board, contentType, contentId]) // 直播结束批量失活用
}

model Operator {
  id               String        @id @default(uuid())
  userId           String        @unique
  level            OperatorLevel
  containQuota     Int           @default(0) // 包含的站长名额
  usedQuota        Int           @default(0) // 已使用名额
  parentOperatorId String?
  totalEarning     Decimal       @default(0) @db.Decimal(12, 2)
  status           String        @default("ACTIVE")
  channelType      String        @default("ONLINE") // 渠道类型：ONLINE 线上运营商 / OFFLINE 线下运营商（驿站开通赠送"高级线下运营商"）佣-V2-P1
  mgmtRate         Decimal?      @db.Decimal(5, 4) // 管理奖比率（基数=名下站长实得佣金额·空=按 channelType 默认 ONLINE 0.10 / OFFLINE 0.20）佣-V2-P1
  // 运营商独立小程序
  miniAppId        String? // 独立小程序 AppId
  mpAppId          String? // 公众号 AppId
  miniPages        Json? // 页面配置
  brandName        String? // 品牌名称
  brandLogo        String? // 品牌Logo
  brandThemeColor  String?       @default("#8B4513")
  purchasedAt      DateTime      @default(now())
  expireAt         DateTime?
  createdAt        DateTime      @default(now())

  user           User              @relation(fields: [userId], references: [id])
  parentOperator Operator?         @relation("OperatorHierarchy", fields: [parentOperatorId], references: [id])
  childOperators Operator[]        @relation("OperatorHierarchy")
  stations       Station[]         @relation("OperatorStations")
  earnings       OperatorEarning[]
  teamTasks      TeamTask[]

  @@index([parentOperatorId])
}

model StationEarning {
  id        String   @id @default(uuid())
  stationId String
  orderId   String
  amount    Decimal  @db.Decimal(10, 2)
  rate      Decimal  @db.Decimal(5, 4) // 佣金比例
  earned    Decimal  @db.Decimal(10, 2)
  type      String // COURSE, PRODUCT, MEMBER, CIRCLE, BOT
  createdAt DateTime @default(now())

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, createdAt])
  @@index([orderId])
}

model OperatorEarning {
  id               String   @id @default(uuid())
  operatorId       String
  orderId          String
  source           String // MGMT_BONUS（唯一计酬来源，计酬≤两级硬约束；历史数据可能残留已废止的 UPPER_MGMT_BONUS）
  amount           Decimal  @db.Decimal(10, 2) // 订单原始金额
  rate             Decimal  @db.Decimal(5, 4) // 管理奖比例
  earned           Decimal  @db.Decimal(10, 2) // 实际所得
  sourceStationId  String? // 产生佣金的站点
  sourceOperatorId String? // 自营分站管理奖上浮至上级时，记录产生佣金的下级运营商（审计追溯）
  createdAt        DateTime @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId, createdAt])
  @@index([orderId])
}

// ─────────────────────────────────────────────────
// 运营商团队任务下发（商-P2 指挥室）
// 合规红线 R1：任务奖励仅限荣誉/资源位，禁止现金奖励字段
// ─────────────────────────────────────────────────

enum TeamTaskType {
  PROMOTE // 推广拉新：任务期内该站长 ref 新注册数（ReferralRelation）
  RECRUIT // 招募站长：任务期内新增下级站长数
  SALES // 销售冲刺：任务期内分站归因 GMV（元，取整）
  CUSTOM // 自定义：站长手动标记完成
}

enum TeamTaskStatus {
  OPEN
  CLOSED
}

model TeamTask {
  id          String         @id @default(uuid())
  operatorId  String
  title       String
  desc        String? // 任务说明（奖励仅荣誉/资源位，创建时校验不得含现金类承诺）
  type        TeamTaskType
  targetValue Int? // 目标值（PROMOTE=人数/RECRUIT=站长数/SALES=元；CUSTOM 可空）
  deadline    DateTime
  status      TeamTaskStatus @default(OPEN)
  createdAt   DateTime       @default(now())

  operator   Operator           @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  progresses TeamTaskProgress[]

  @@index([operatorId, status])
  @@index([status, deadline])
}

model TeamTaskProgress {
  id              String    @id @default(uuid())
  taskId          String
  stationMasterId String // 站长 userId（Station.userId）
  currentValue    Int       @default(0)
  completedAt     DateTime?

  task          TeamTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stationMaster User     @relation("TeamTaskStationMaster", fields: [stationMasterId], references: [id], onDelete: Cascade)

  @@unique([taskId, stationMasterId])
  @@index([stationMasterId])
}

// ─────────────────────────────────────────────────
// 线下驿站系统
// ─────────────────────────────────────────────────

model StationOffline {
  id                 String   @id @default(uuid())
  name               String
  city               String
  address            String
  phone              String
  cover              String?
  type               String? // 驿站类型 center/academy/studio/partner
  intro              String? // 驿站简介
  businessHours      Json? // 营业时间 [{day,open,close,isOpen}]
  images             String[] @default([]) // 图集
  tags               String[] @default([]) // 标签
  facilities         String[] @default([]) // 设施 wifi/parking/tea/library/meditation/classroom/consultation
  ownerUserId        String   @unique
  depositAmount      Decimal  @default(0) @db.Decimal(10, 2)
  status             String   @default("PENDING") // PENDING, ACTIVE, DISABLED
  operatorId         String? // 驿站开通(ACTIVE)时系统赠送的"高级线下运营商"回链（Operator.id·channelType=OFFLINE·佣-V2-P3·拍板规则3）
  // ── 品牌主页（驿-P1·驿站对外"店面"）──
  brandStory         String? // 驿站故事（品牌主页正文）
  photos             String[] @default([]) // 品牌相册（环境照片墙 URL）
  featuredTeacherIds String[] @default([]) // 讲师阵容（StationTeacher.id 数组·驿站长挑选展示顺序）
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  teacherRequests StationTeacherRequest[]

  owner           User                    @relation(fields: [ownerUserId], references: [id])
  courses         OfflineCourse[]
  products        StationProduct[]
  orders          StationOrder[]
  teachers        StationTeacher[]
  teacherBookings StationTeacherBooking[]
  settlements     StationSettlement[]
  events          StationEvent[]
}

model OfflineCourse {
  id            String    @id @default(uuid())
  stationId     String
  title         String
  cover         String?
  intro         String?
  teacherId     String?
  courseId      String? // 关联线上课程
  type          String    @default("OFFLINE") // OFFLINE, HYBRID
  price         Decimal   @default(0) @db.Decimal(10, 2)
  maxStudents   Int
  startTime     DateTime
  endTime       DateTime
  location      String
  status        String    @default("DRAFT")
  auditStatus   String    @default("PENDING") // PENDING/APPROVED/REJECTED
  auditReason   String?
  isRecommended Boolean   @default(false)
  recommendedAt DateTime?
  circleId      String? // 课后同学圈（T8 OMO：建圈后回写，幂等依据）
  createdAt     DateTime  @default(now())

  station       StationOffline              @relation(fields: [stationId], references: [id])
  registrations OfflineCourseRegistration[]
  reviews       OfflineCourseReview[]

  @@index([stationId, startTime])
  @@index([auditStatus])
}

model OfflineCourseReview {
  id             String   @id @default(uuid())
  courseId       String
  stationId      String // 冗余驿站 id，便于驿站维度评分聚合
  userId         String
  registrationId String   @unique // 一条报名记录只能评一次（防二评）
  rating         Int // 1-5 星
  content        String?
  createdAt      DateTime @default(now())

  course OfflineCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
  @@index([stationId])
  @@index([userId])
}

model OfflineCourseRegistration {
  id         String    @id @default(uuid())
  courseId   String
  userId     String
  status     String    @default("REGISTERED") // REGISTERED, SIGNED_IN, CANCELLED
  qrCode     String?
  verifyCode String? // 6位到店核销码（扫码不便时口报·同课程内唯一·当天有效·核销即作废）
  signedAt   DateTime?
  createdAt  DateTime  @default(now())

  course OfflineCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@unique([courseId, verifyCode]) // 同课程内6位码唯一（null 不参与唯一约束，存量记录无码不冲突）
  @@index([userId])
}

// ───────── 驿站活动系统（T8 OMO P1a）─────────

model StationEvent {
  id           String   @id @default(uuid())
  stationId    String
  title        String
  type         String // YAJI雅集 / SALON沙龙 / READING读书会 / SOLAR_TERM节气活动 / EXPERIENCE体验课
  cover        String?
  intro        String?
  price        Decimal  @default(0) @db.Decimal(10, 2) // 本期免费报名，价格字段留支付门控后启用
  maxAttendees Int
  startTime    DateTime
  endTime      DateTime
  location     String
  status       String   @default("DRAFT") // DRAFT / PUBLISHED / CANCELLED / FINISHED
  photos       Json? // 回顾照片墙（URL 数组，≤30 张，FINISHED/进行后可传）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  station       StationOffline             @relation(fields: [stationId], references: [id])
  registrations StationEventRegistration[]

  @@index([stationId, startTime])
  @@index([status, startTime])
}

model StationEventRegistration {
  id        String    @id @default(uuid())
  eventId   String
  userId    String
  status    String    @default("REGISTERED") // REGISTERED / SIGNED_IN / CANCELLED
  qrCode    String?
  signedAt  DateTime?
  createdAt DateTime  @default(now())

  event StationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model StationProduct {
  id         String   @id @default(uuid())
  stationId  String
  productId  String?
  name       String
  price      Decimal  @db.Decimal(10, 2)
  stock      Int      @default(0)
  isPlatform Boolean  @default(false) // 驿站自有 vs 平台代销
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())

  station StationOffline @relation(fields: [stationId], references: [id])

  @@index([stationId])
}

model StationOrder {
  id            String   @id @default(uuid())
  stationId     String
  orderType     String // OFFLINE_COURSE, PRODUCT, SERVICE
  targetId      String
  amount        Decimal  @db.Decimal(10, 2)
  stationIncome Decimal  @db.Decimal(10, 2)
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())

  station StationOffline @relation(fields: [stationId], references: [id])

  @@index([stationId])
}

model StationTeacher {
  id           String   @id @default(uuid())
  name         String
  avatar       String?
  specialties  String[] @default([])
  bio          String?
  stationId    String
  sourceUserId String? // 来源签约讲师的 userId（null=驿站自建；非 null=来自研究院签约讲师 lecturerLevel=SIGNED）
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  station  StationOffline          @relation(fields: [stationId], references: [id])
  bookings StationTeacherBooking[]

  @@index([stationId])
  @@index([sourceUserId])
}

model StationTeacherBooking {
  id          String   @id @default(uuid())
  stationId   String
  teacherId   String
  courseId    String?
  bookingDate DateTime
  status      String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  price       Decimal  @default(0) @db.Decimal(10, 2)
  remark      String?
  createdAt   DateTime @default(now())

  station StationOffline @relation(fields: [stationId], references: [id])
  teacher StationTeacher @relation(fields: [teacherId], references: [id])

  @@index([stationId])
  @@index([teacherId])
}

model StationSettlement {
  id            String    @id @default(uuid())
  stationId     String
  period        String // 结算周期 如 "2026-05"
  totalIncome   Decimal   @db.Decimal(12, 2)
  stationShare  Decimal   @db.Decimal(12, 2)
  platformShare Decimal   @db.Decimal(12, 2)
  settled       Boolean   @default(false)
  settledAt     DateTime?
  createdAt     DateTime  @default(now())

  station StationOffline @relation(fields: [stationId], references: [id])

  @@index([stationId, period])
}

// ─────────────────────────────────────────────────
// 研究院
// ─────────────────────────────────────────────────

enum InstituteRole {
  INITIATOR
  TYPE_A // 潜力讲师
  TYPE_B // 深造者
  PRESIDENT // 主席
  VICE_PRESIDENT // 副主席
  SECRETARY_GENERAL // 秘书长
}

// 研究院实体（可能是独立公司/组织，有专属圈子和管理员）
model Institute {
  id           String   @id @default(uuid())
  name         String
  intro        String?
  logo         String?
  circleId     String?  @unique // 研究院专属圈子
  adminUserId  String // 研究院管理员（和平台管理员分开）
  contactName  String? // 联系人
  contactPhone String? // 联系电话
  legalEntity  String? // 法人实体名称（如公司名）
  status       String   @default("ACTIVE") // ACTIVE, SUSPENDED, CLOSED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  circle      Circle?               @relation(fields: [circleId], references: [id])
  admin       User                  @relation(fields: [adminUserId], references: [id])
  members     InstituteMember[]
  events      InstituteEvent[]
  courses     InstituteCourse[]
  revenues    InstituteRevenue[]
  dividends   InstituteDividend[]
  boardGroups InstituteBoardGroup[]

  @@index([adminUserId])
  @@index([status])
}

// 研究院线下课程（研究院签约老师的线下授课）
model InstituteCourse {
  id           String   @id @default(uuid())
  instituteId  String
  teacherId    String // 线下老师用户ID
  title        String
  cover        String?
  intro        String?
  price        Decimal  @default(0) @db.Decimal(10, 2)
  teacherShare Decimal  @default(0) @db.Decimal(5, 4) // 老师分成比例
  maxStudents  Int      @default(20)
  location     String? // 授课地点
  startTime    DateTime
  endTime      DateTime
  status       String   @default("DRAFT") // DRAFT, PUBLISHED, CANCELLED, COMPLETED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  institute     Institute                     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  registrations InstituteCourseRegistration[]

  @@index([instituteId, startTime])
  @@index([teacherId])
}

model InstituteCourseRegistration {
  id        String    @id @default(uuid())
  courseId  String
  userId    String
  status    String    @default("REGISTERED") // REGISTERED, SIGNED_IN, CANCELLED
  signedAt  DateTime?
  createdAt DateTime  @default(now())

  course InstituteCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId])
}

model InstituteMember {
  id              String        @id @default(uuid())
  instituteId     String // 归属研究院
  userId          String
  role            InstituteRole
  seatType        String        @default("LECTURE") // LECTURE讲席（分享席·年度积分考核） / STUDY研修席（学习席·无分享考核）——T9-P1 双轨席位制
  deposit         Decimal       @default(0) @db.Decimal(10, 2) // 保证金
  depositRefunded Boolean       @default(false) // 是否已退保证金
  expireAt        DateTime? // 年度会员到期时间
  joinYear        Int // 加入年份
  tasksCompleted  Int           @default(0)
  tasksRequired   Int           @default(3) // 年度任务要求
  lecturerLevel   String        @default("NONE") // NONE, PREPARATORY, JUNIOR, SENIOR, SIGNED
  status          String        @default("ACTIVE") // ACTIVE, GRADUATED, SUSPENDED
  feeExempt       Boolean       @default(false) // 永久免会费（特邀名师·豁免返还与转席逻辑·分享积分照记·T9-P1 特邀席位 §3.2 V6）
  invitedBy       String? // 特邀操作者 userId（非空即特邀成员·操作留痕）
  inviteRemark    String? // 特邀备注（引入缘由留痕）
  joinedAt        DateTime      @default(now())

  user        User                  @relation(fields: [userId], references: [id])
  institute   Institute             @relation(fields: [instituteId], references: [id])
  tasks       InstituteTask[]
  sharePoints InstituteSharePoint[]

  @@unique([instituteId, userId]) // 分院制：一人可入多院，同院内唯一（V4 拍板·取代原 userId 全局唯一）
  @@index([userId])
  @@index([role, status])
  @@index([joinYear])
}

// 私董会小组（T9 §3.6.5：6-12 人闭门小组·轮流出题·众人拆解事业课题·承载=私密子圈，一组一圈）
model InstituteBoardGroup {
  id          String   @id @default(uuid())
  instituteId String // 归属研究院
  circleId    String   @unique // 承载私密圈（FREE + needApproval，圈主=组长）
  name        String // 小组名（≤20 字，圈名为「私董会·{name}」）
  topic       String? // 当期课题/小组主题
  leaderId    String // 组长 userId（即圈主·须为本院 ACTIVE 讲席成员）
  memberLimit Int      @default(12) // 满员软约束（6-20·入组硬闸在圈主审批，列表满员标注 full）
  status      String   @default("ACTIVE") // ACTIVE, DISBANDED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id])
  circle    Circle    @relation(fields: [circleId], references: [id])

  @@index([instituteId, status])
  @@index([leaderId])
}

// 研究院分享积分流水（T9-P1 考核制度 V5：分享行为自动/人工记分，负分=人工纠错）
model InstituteSharePoint {
  id          String   @id @default(uuid())
  instituteId String
  memberId    String
  userId      String
  pointType   String // OFFLINE_STATION旗舰驿站分享 / SALON_MONTHLY月度沙龙 / QUARTERLY_EVENT季度高规格会 / INSTITUTE_SALON院内沙龙 / LIVE_COURSE直播课 / ARTICLE文章 / MENTORING带教 / QA答疑 / MANUAL人工调整
  points      Int // 积分（可负·人工纠错）
  refId       String? // 关联来源ID（如 InstituteEvent.id·自动记分幂等查重键）
  remark      String? // 备注
  verifiedBy  String? // 人工记分/质量验证操作者用户ID
  createdAt   DateTime @default(now())

  member InstituteMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@index([userId])
}

// 研究院年度任务
model InstituteTask {
  id          String    @id @default(uuid())
  memberId    String
  taskType    String // SALON, LIVE, ARTICLE
  title       String // 任务标题
  description String? // 说明
  status      String    @default("PENDING") // PENDING, COMPLETED, VERIFIED
  completedAt DateTime?
  verifiedBy  String? // 验证人ID
  createdAt   DateTime  @default(now())

  member InstituteMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, status])
}

// 研究院统一任务模板（平台级标准，所有成员共享）
model InstituteTaskTemplate {
  id            String   @id @default(uuid())
  taskType      String // SALON, LIVE, ARTICLE, OFFLINE_EVENT, CIRCLE_MEMBER_COUNT, CIRCLE_DAYS
  title         String // 任务标题
  description   String? // 说明
  requiredCount Int      @default(1) // 年度要求完成次数
  periodUnit    String   @default("YEAR") // MONTH, QUARTER, YEAR
  sortOrder     Int      @default(0)
  status        String   @default("ACTIVE") // ACTIVE, DISABLED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([taskType, periodUnit])
  @@index([status])
}

// 研究院活动排期
model InstituteEvent {
  id           String     @id @default(uuid())
  title        String
  type         String // SALON, LIVE, COURSE
  lecturerId   String? // 讲师用户ID
  description  String?
  location     String? // 线下地点 / 线上链接
  scheduleAt   DateTime
  maxAttendees Int        @default(50)
  status       String     @default("SCHEDULED") // SCHEDULED, ONGOING, COMPLETED, CANCELLED
  createdAt    DateTime   @default(now())
  institute    Institute? @relation(fields: [instituteId], references: [id])
  instituteId  String?

  @@index([scheduleAt])
  @@index([lecturerId])
  @@index([type, status])
}

// 研究院收入记录
model InstituteRevenue {
  id          String   @id @default(uuid())
  instituteId String
  sourceType  String // COURSE, CONTENT, MEMBERSHIP, OTHER
  sourceId    String? // 关联的课程/内容ID
  amount      Decimal  @db.Decimal(10, 2)
  description String? // 收入说明
  createdAt   DateTime @default(now())

  institute Institute @relation(fields: [instituteId], references: [id])

  @@index([instituteId, createdAt])
  @@index([sourceType])
}

// 研究院分红/奖励记录
model InstituteDividend {
  id          String   @id @default(uuid())
  instituteId String
  userId      String // 分红对象
  type        String // MGMT_BONUS（管理层分红）, TEACHER_AWARD（优秀老师奖励）, OPERATION（运营费用）
  amount      Decimal  @db.Decimal(10, 2)
  description String? // 说明
  period      String? // 结算周期 如 2026-Q1
  createdAt   DateTime @default(now())

  institute Institute @relation(fields: [instituteId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([instituteId, period])
  @@index([userId])
  @@index([type])
}

// 驿站-老师双向选择请求
model StationTeacherRequest {
  id          String    @id @default(uuid())
  stationId   String // 驿站ID
  teacherId   String? // 目标老师ID（驿站指定邀请时填写）
  courseTitle String? // 课程意向标题
  courseIntro String? // 课程需求描述
  proposedFee Decimal?  @db.Decimal(10, 2) // 建议课时费
  proposeDate DateTime? // 建议授课日期
  status      String    @default("PENDING") // PENDING, ACCEPTED, REJECTED, CANCELLED
  initiator   String    @default("STATION") // STATION, TEACHER
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  station StationOffline @relation(fields: [stationId], references: [id])

  @@index([stationId, status])
  @@index([teacherId])
  @@index([status])
}

// 续费记录
model RenewalRecord {
  id           String   @id @default(uuid())
  userId       String
  targetType   String // CIRCLE_MEMBER, STATION, INSTITUTE_MEMBER, VIP_MEMBER
  targetId     String // 圈子ID/分站ID/研究院ID等
  amount       Decimal  @db.Decimal(10, 2)
  periodDays   Int      @default(365) // 续费天数
  prevExpireAt DateTime // 续费前到期时间
  newExpireAt  DateTime // 续费后到期时间
  orderId      String? // 关联订单ID
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, targetType])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────
// 互动系统
// ─────────────────────────────────────────────────

model Like {
  id         String   @id @default(uuid())
  userId     String
  targetType String // POST, ARTICLE, COURSE, VIDEO, COMMENT
  targetId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([targetType, createdAt])
  @@index([userId, createdAt])
}

model Comment {
  id         String    @id @default(uuid())
  userId     String
  targetType String // POST, ARTICLE, COURSE, VIDEO, LIVESTREAM
  targetId   String
  parentId   String?
  content    String
  likeCount  Int       @default(0)
  status     String    @default("PUBLISHED") // PUBLISHED, HIDDEN
  deletedAt  DateTime? // 软删除
  createdAt  DateTime  @default(now())

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([targetType, targetId, createdAt])
  @@index([targetType, targetId, parentId, status, createdAt])
  @@index([parentId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
}

model Collect {
  id         String   @id @default(uuid())
  userId     String
  targetType String // POST, ARTICLE, COURSE, PRODUCT, VIDEO
  targetId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId, createdAt])
  @@index([targetType, targetId])
  @@index([targetType, createdAt])
}

model Report {
  id          String    @id @default(uuid())
  reporterId  String // 举报人
  targetType  String // POST, ARTICLE, COMMENT, CIRCLE, USER, LIVE, VIDEO
  targetId    String
  reason      String
  status      String    @default("PENDING") // PENDING, PROCESSED, DISMISSED
  result      String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([targetType, targetId])
  @@index([reporterId, createdAt])
}

// ─────────────────────────────────────────────────
// 用户反馈
// ─────────────────────────────────────────────────

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  type      String // bug / suggestion / complaint / other
  content   String // 反馈正文
  contact   String? // 联系方式（可选）
  images    String[] @default([]) // 截图URL列表
  status    String   @default("pending") // pending / processing / resolved
  result    String? // 处理结果备注
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@index([type, createdAt])
}

// ─────────────────────────────────────────────────
// 短信日志
// ─────────────────────────────────────────────────

model SmsLog {
  id        String   @id @default(uuid())
  phone     String // 已脱敏手机号
  scene     String   @default("LOGIN") // 场景：LOGIN/REGISTER/RESET_PWD/BIND
  status    String   @default("SUCCESS") // SUCCESS/FAIL
  errorMsg  String? // 失败原因
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────
// 审计日志
// ─────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  executor      String? // "CLAUDE" | 用户ID（区分自动化/人工操作）
  autonomyLevel String? // L1/L2/L3 自主分级（治理护栏 §2.1，自动化动作记录其执行档位）
  action        String
  targetType    String?
  targetId      String?
  detail        String?
  rollbackData  Json? // 回滚数据快照
  ip            String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([executor, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ─────────────────────────────────────────────────
// 敏感词库（合-P1：DB 真源·分级·合规词带替换建议）
// ─────────────────────────────────────────────────

model SensitiveWord {
  id          String   @id @default(uuid())
  word        String   @unique
  category    String   @default("GENERAL") // GENERAL(通用拦截)/COMPLIANCE_A(合规A级·禁止)/COMPLIANCE_B(合规B级·替换建议)
  replacement String? // B 级替换建议（如 算命→命理文化分析）
  enabled     Boolean  @default(true)
  remark      String? // 备注（如豁免边界说明）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, enabled])
}

// ─────────────────────────────────────────────────
// 合规扫描记录（合-P1：DB 内容域违禁词扫描报告·admin 复核队列）
// 豁免规则：古籍/诗词正文域（ClassicChapter/Poetry）为引用豁免域，不入扫描范围
// ─────────────────────────────────────────────────

model ComplianceScanRecord {
  id         String    @id @default(uuid())
  scanAt     DateTime  @default(now()) // 首次发现时间
  targetType String // PRODUCT/COURSE/POST/COUPON_TEMPLATE/MARKETING_PAGE/MARKETING_PAGE_COMPONENT
  targetId   String
  field      String // 命中字段（title/intro/detail/content/name/description/config）
  word       String // 命中的违禁词
  level      String // A(禁止·建议下架整改)/B(替换建议·人工确认)
  suggestion String? // 处置建议（B 级为替换建议文案）
  snippet    String? // 命中上下文片段（便于复核定位）
  status     String    @default("OPEN") // OPEN/RESOLVED/IGNORED
  resolvedBy String? // 处理人
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([targetType, targetId, field, word]) // 幂等：同目标同字段同词不重复产出
  @@index([status, level, scanAt])
  @@index([targetType, targetId])
}

// ─────────────────────────────────────────────────
// 系统配置与通知
// ─────────────────────────────────────────────────

model ConfigSystem {
  id          String   @id @default(uuid())
  configKey   String   @unique
  configValue String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
  createdAt   DateTime @default(now())
}

/// 品牌配置（多租户 T0 品牌抽象·单行表 id 固定 "default"）
/// 全端品牌露出（站名/Logo/主色/客服/协议主体六项）的唯一配置来源，收敛散落的"热卜"硬编码
model BrandConfig {
  id            String   @id @default("default")
  siteName      String   @default("热卜国学") // 站名（全称）
  siteNameShort String   @default("热卜") // 站名（简称·印章两字）
  siteNameEn    String   @default("REBU") // 英文名
  slogan        String   @default("探寻东方智慧") // 主标语
  sloganAlt     String   @default("观天地 · 明心性") // 备用标语
  tagline       String   @default("国学知识平台") // 副标题
  copyright     String   @default("热卜国学 · 让国学回归生活") // 版权/页脚文案
  qrGuide       String   @default("长按识别 · 开启国学之旅") // 二维码引导语
  logoUrl       String   @default("") // Logo 图片地址（空=使用内置印章 Logo）
  primaryColor  String   @default("#c41e3a") // 品牌主色
  domain        String   @default("api.rebugx.cn") // 主域名
  h5Url         String   @default("https://api.rebugx.cn/h5/") // H5 入口地址
  servicePhone  String   @default("") // 客服电话
  serviceEmail  String   @default("") // 客服邮箱
  serviceWechat String   @default("") // 客服微信
  companyName   String   @default("") // 协议主体：公司全称
  platformName  String   @default("热卜国学") // 协议主体：平台名
  websiteUrl    String   @default("") // 协议主体：网址
  contactPerson String   @default("") // 协议主体：联系人
  contactPhone  String   @default("") // 协议主体：联系电话
  contactEmail  String   @default("") // 协议主体：联系邮箱
  updatedBy     String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  type       String // SYSTEM, COMMENT, LIKE, FOLLOW, PURCHASE, EARNING, AUDIT
  title      String
  content    String
  targetType String? // 跳转目标类型
  targetId   String? // 跳转目标ID
  category   String? // 圈内事件四分类 INTERACT/TRADE/GOVERN/LIVE；非圈子通知为 NULL（列由 manual/2026-07-11-circle-notifications.sql 添加·代码经原生 SQL 访问）
  circleId   String? // 事件所属圈子（无外键）
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, type, createdAt])
  @@index([userId, category, createdAt])
}

/// 行为埋点事件（page_view/click/purchase/search/share/custom）。
/// 千人千面推荐与运营分析的原始数据；userId 可空（匿名也采集）；不建外键以免阻塞用户删除。
model TrackEvent {
  id         String   @id @default(cuid())
  userId     String? // 匿名时为 null
  action     String // page_view / click / purchase / search / share / custom
  path       String? // 触发页面路径
  payload    Json? // 事件附加字段（productId/keyword/orderId 等）
  occurredAt DateTime // 客户端事件时间（由毫秒时间戳转换）
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([userId, createdAt])
}

/**
 * 用户标签（D-T2·数据运营引擎）：每日批量计算·FACT=行为直推 DERIVED=规则推导。
 * 【R2 红线】标签只可用于内容推荐/发放优惠/运营圈人，严禁用于差异化定价（大数据杀熟）。
 */
model UserTag {
  id        String   @id @default(uuid())
  userId    String
  tag       String // active_7d / pay_member / role_station / pref_yijing / whale / ...
  type      String // FACT / DERIVED
  updatedAt DateTime @updatedAt

  @@unique([userId, tag])
  @@index([tag])
}

/**
 * 转化漏斗日聚合（D-T1·数据运营引擎）：4 条核心漏斗按日按步骤计数·date+funnel+step 唯一幂等
 */
model FunnelDaily {
  id      String @id @default(uuid())
  date    String // YYYY-MM-DD（Asia/Shanghai）
  funnel  String // F1_activation / F2_member / F3_commerce / F4_practitioner
  step    Int // 步骤序号（1 起）
  stepKey String // 步骤键（register/first_paipan/...）
  count   Int

  @@unique([date, funnel, step])
  @@index([funnel, date])
}

/**
 * 业务哨兵告警（O-T1·运维守护体系）：规则触发记录+去重+处置状态
 */
model SentinelAlert {
  id         String    @id @default(uuid())
  rule       String // 规则键：pay_success_rate / dau_drop / disk_watermark 等
  level      String // P1(资金/全站) / P2(功能性) / P3(降级类)
  message    String
  context    Json? // 触发时的指标快照（样本数/比率/阈值）
  firedAt    DateTime  @default(now())
  resolvedAt DateTime? // 人工/自动标记解除
  notified   Boolean   @default(false)

  @@index([rule, resolvedAt])
  @@index([firedAt])
}

model SearchHistory {
  id        String   @id @default(uuid())
  userId    String
  keyword   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([keyword])
}

// 搜索权重配置 — 按实体类型和字段调整搜索排序权重
model SearchWeight {
  id         String   @id @default(uuid())
  entityType String // article | course | product | circle | video | user | classic | content
  fieldName  String   @default("all") // all | title | excerpt | intro | name | nickname | author
  weight     Float    @default(1.0) // 权重系数，默认 1.0
  enabled    Boolean  @default(true)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([entityType, fieldName])
}

// ─────────────────────────────────────────────────
// 古籍阅读系统
// ─────────────────────────────────────────────────

model ClassicBook {
  id             String    @id @default(uuid())
  title          String
  titleEn        String? // 英文标题（国际化预留）
  author         String? // 作者/编者
  dynasty        String? // 朝代
  category       String    @default("子") // 经/史/子/集/释/道/命（命理）
  cover          String?
  intro          String?
  introEn        String? // 英文简介（国际化预留）
  source         String? // 版本来源
  versionGroupId String? // 同书多版本分组ID（用于关联不同版本）
  chapterCount   Int       @default(0)
  viewCount      Int       @default(0)
  status         String    @default("PUBLISHED") // DRAFT, PUBLISHED
  deletedAt      DateTime? // 软删除
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  chapters           ClassicChapter[]
  commentaries       ClassicCommentary[]
  progresses         ReadingProgress[]
  bookmarks          Bookmark[]
  images             ClassicImage[]
  annotations        ClassicAnnotation[]
  ClassicReadingNote ClassicReadingNote[]

  @@index([category])
  @@index([status])
  @@index([status, viewCount])
  @@index([title])
}

model ClassicChapter {
  id            String    @id @default(uuid())
  bookId        String
  title         String // 章/卷标题
  titleEn       String? // 英文标题（国际化预留）
  content       String // 原文
  contentEn     String? // 英文原文（国际化预留）
  translation   String? // 白话译文
  translationEn String? // 英文译文（国际化预留）
  annotation    String? // 注释
  tags          Json? // 八字命理标签 ["格局:正官格","十神:伤官","神煞:天乙贵人"]
  sortOrder     Int       @default(0)
  deletedAt     DateTime? // 软删除
  createdAt     DateTime  @default(now())

  book               ClassicBook          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  commentaries       ClassicCommentary[]
  progresses         ReadingProgress[]
  bookmarks          Bookmark[]
  annotations        ClassicAnnotation[]
  ClassicReadingNote ClassicReadingNote[]

  @@index([bookId, sortOrder])
}

model ClassicCommentary {
  id          String   @id @default(uuid())
  bookId      String
  chapterId   String? // 可选：关联到具体章节
  title       String // 注解标题
  author      String? // 注者/学者
  dynasty     String? // 注者朝代
  school      String? // 学派：儒家/道家/佛学/中医/兵法/易学
  type        String   @default("注释") // 注释/白话翻译/现代解读/学术论文/讲义
  content     String   @db.Text
  sourceUrl   String? // 出处链接
  contentHash String? // 用于知识库去重
  status      String   @default("PUBLISHED") // DRAFT/PUBLISHED/HIDDEN
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  book    ClassicBook     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter ClassicChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@unique([bookId, chapterId, author, title])
  @@index([bookId])
  @@index([chapterId])
  @@index([type])
  @@index([school])
}

model ReadingProgress {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  chapterId String
  progress  Float    @default(0) // 阅读进度 0-100
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    ClassicBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter ClassicChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([chapterId])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  chapterId String
  position  Int      @default(0) // 文中位置（字符偏移）
  note      String? // 笔记
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    ClassicBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter ClassicChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([userId, bookId])
  @@index([chapterId])
}

// ─────────────────────────────────────────────────
// 古籍原图对照 & 注疏系统
// ─────────────────────────────────────────────────

model ClassicImage {
  id          String   @id @default(uuid())
  bookId      String
  pageNumber  Int // 页码序号
  label       String? // 页面标签（如"卷一·第一页"）
  iiifUrl     String? // IIIF 图像基础 URL
  manifestUrl String? // IIIF Manifest URL
  width       Int? // 图像宽（像素）
  height      Int? // 图像高（像素）
  source      String? // 来源（harvard/shuge/internet_archive）
  createdAt   DateTime @default(now())

  book     ClassicBook      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  ocrTexts ClassicOcrText[]

  @@unique([bookId, pageNumber])
  @@index([bookId])
}

model ClassicOcrText {
  id         String @id @default(uuid())
  imageId    String
  content    String // 该图区域对应的文字
  x          Int // 边界框坐标
  y          Int
  w          Int
  h          Int
  pageNumber Int
  lineNumber Int // 行号（竖排从右到左）
  charIndex  Int // 行内序号（从上到下）
  confidence Float? // OCR 置信度 0-1

  image ClassicImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([imageId, pageNumber])
  @@index([imageId, lineNumber, charIndex])
}

model ClassicAnnotation {
  id        String   @id @default(uuid())
  bookId    String
  chapterId String?
  type      String   @default("注疏") // 注疏/夹注/眉批/校勘记
  startPos  Int // 正文中标注起始位置（字符偏移）
  endPos    Int // 正文中标注结束位置
  content   String   @db.Text // 注疏内容
  author    String? // 注者
  dynasty   String? // 注者朝代
  createdAt DateTime @default(now())

  book    ClassicBook     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter ClassicChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@index([bookId])
  @@index([chapterId])
  @@index([bookId, startPos])
}

model ClassicReadingNote {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  chapterId String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    ClassicBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter ClassicChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, bookId])
  @@index([chapterId])
}

// 古籍馆·策划书单（运营内容，bookIds 为 ClassicBook id 数组，无外键便于灵活编排）
model ClassicBookList {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  curator     String? // 策划人/编辑部
  coverColor  String   @default("brown") // 前端 CoverColor
  tags        Json? // string[]
  bookIds     Json     @default("[]") // string[] 关联 ClassicBook id（有序）
  viewCount   Int      @default(0)
  likeCount   Int      @default(0)
  sortOrder   Int      @default(0)
  status      String   @default("PUBLISHED") // DRAFT/PUBLISHED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, sortOrder])
}

// 古籍馆·我的收藏（用户收藏的古籍，无外键关系便于独立维护）
model ClassicFavorite {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  createdAt DateTime @default(now())

  @@unique([userId, bookId])
  @@index([userId])
}

/// 识典伴读会话（E3 多轮带记忆·2026-07-03）：每用户每书一条，跨章节/跨登录持续陪读。
/// summary=滚动记忆摘要（每积累一批对话异步压缩，注入后续对话让 AI「记得」此前共读内容）。
model ClassicCompanionSession {
  id           String   @id @default(uuid())
  userId       String
  bookId       String
  summary      String? // 滚动记忆摘要（AI 压缩生成）
  messageCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, bookId])
}

model ClassicCompanionMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      String // user / assistant
  content   String
  chapterId String? // 提问时所在章节（跨章追溯用）
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

// ─────────────────────────────────────────────────
// 分佣系统
// ─────────────────────────────────────────────────

model CommissionConfig {
  id          String   @id @default(uuid())
  configKey   String   @unique // course_basic / course_premium / course_high / product_platform / product_circle / station_course / station_member / circle_join / bot_call / temp_referral
  configName  String // 配置名称
  rateA       Decimal  @db.Decimal(10, 4) // 讲师/圈主/站长佣金比例
  rateB       Decimal  @db.Decimal(10, 4) // 平台佣金比例
  rateC       Decimal? @db.Decimal(10, 4) // 第三角色比例（驿站等）
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model Withdrawal {
  id            String    @id @default(uuid())
  userId        String
  stationId     String? // 关联分站
  amount        Decimal   @db.Decimal(10, 2)
  bankName      String? // 银行名称
  bankAccount   String? // 银行卡号
  bankHolder    String? // 开户人
  alipayAccount String? // 支付宝账号
  status        String    @default("PENDING") // PENDING, APPROVED, PAID, REJECTED
  remark        String? // 审核备注
  /// 出款幂等键：线下打款=银行/支付宝流水号；接入自动代付后=渠道 out_bill_no。
  /// 唯一约束是防重复打款的最后一道兜底——同一笔流水不可能被记两次。
  payoutRef     String?   @unique
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  station Station? @relation(fields: [stationId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([stationId])
}

// 推荐链接追踪
model ReferralLink {
  id         String   @id @default(uuid())
  userId     String // 分享人
  targetType String // COURSE, PRODUCT, CIRCLE, LIVE, ARTICLE
  targetId   String
  code       String   @unique // 短链接码
  channel    String   @default("DIRECT") // DIRECT, WECHAT, POSTER, QR
  clickCount Int      @default(0)
  orderCount Int      @default(0)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([code])
}

// ─────────────────────────────────────────────────
// 虚拟币体系
// ─────────────────────────────────────────────────

model VirtualCoinAccount {
  id             String   @id @default(uuid())
  userId         String   @unique
  balance        Int      @default(0) // 当前余额（币数）
  frozen         Int      @default(0) // 冻结币数（悬赏等）
  totalRecharged Int      @default(0) // 累计充值币数
  totalSpent     Int      @default(0) // 累计消费币数
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VirtualCoinFrozen {
  id         String    @id @default(uuid())
  userId     String
  amountCoin Int // 冻结币数
  scene      String // BOUNTY/REFUND/DISPUTE
  refId      String? // 关联ID（如悬赏问题ID）
  status     String    @default("FROZEN") // FROZEN/TRANSFERRED/UNFROZEN
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([userId, status])
  @@index([refId])
}

enum CoinTransType {
  RECHARGE // 充值
  SPEND // 消费
  REFUND // 退款
  GRANT // 平台赠送
  INCOME // 收入（打赏分成等·可直接消费——董事长拍板 2026-07-10 打赏金币与虚拟币消费通用）
}

enum CoinScene {
  RECHARGE // 充值
  CIRCLE_JOIN // 付费入圈
  PAID_QUESTION // 付费提问
  PEEK_ANSWER // 围观答案
  AUDIO_CALL // 音频连麦
  LIVE_GIFT // 直播打赏
  LIVE_QUALITY_PACKAGE // 直播画质时长包购买
  BOT_CALL // 智能体调用
  REFUND // 退款
  PLATFORM_GRANT // 平台赠送
  BOUNTY // 悬赏咨询
  BOUNTY_UNFREEZE // 悬赏解冻
  POST_REWARD // 帖子打赏（2026-07-03 补：代码早在用但枚举缺失，落库被 DB 拒）
  CONSULT_CALL_PREPAY // 咨询通话预扣（同上）
  LIVE_GIFT_INCOME // （预留）直播打赏分成直接入币·终版拍板改走 UserEarning+收益转金币
  EARNING_CONVERT // 收益转金币（可提现 RMB 收益 → 金币·单向·董事长拍板 2026-07-10）
}

model VirtualCoinTransaction {
  id           String        @id @default(uuid())
  userId       String
  type         CoinTransType
  amountCoin   Int // 变动币数（正数为增加，负数为减少）
  balanceAfter Int // 变动后余额
  scene        CoinScene // 消费场景
  refId        String? // 关联业务ID（订单号/问答ID/通话ID等）
  description  String? // 描述
  createdAt    DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([refId])
  @@index([userId, type, createdAt])
}

// 创作者提现申请（虚拟币结算）— 申请→审核→打款 真审批流。
// 申请时冻结对应币数（balance→frozen + VirtualCoinFrozen 记录），审批通过/打款时真实 SPEND，拒绝时解冻。
model VideoCreatorWithdrawal {
  id          String    @id @default(uuid())
  userId      String
  amountCoin  Int // 提现币数（正数）
  method      String    @db.VarChar(50) // 提现方式（银行卡/支付宝/微信）
  account     String    @db.VarChar(255) // 收款账号
  status      String    @default("PENDING") // PENDING|APPROVED|REJECTED|PAID
  reviewNote  String? // 审核备注（拒绝原因等）
  reviewedBy  String? // 审核人 userId
  createdAt   DateTime  @default(now())
  processedAt DateTime? // 审核/打款时间

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model VirtualCoinRecharge {
  id         String    @id @default(uuid())
  userId     String
  amountRmb  Decimal   @db.Decimal(10, 2) // 人民币金额
  amountCoin Int // 币数
  payMethod  String    @default("WECHAT") // WECHAT, ALIPAY
  orderNo    String    @unique // 外部支付订单号
  status     String    @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  paidAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([orderNo])
}

// ─────────────────────────────────────────────────
// 付费问答
// ─────────────────────────────────────────────────

model PaidQuestion {
  id             String    @id @default(uuid())
  circleId       String
  askerId        String // 提问者
  answererId     String // 回答者
  questionTitle  String    @default("") // 问题标题
  question       String // 问题详细描述
  images         String[]  @default([])
  answer         String? // 回答内容（富文本）
  answerAudioUrl String? // 回答语音URL
  priceCoin      Int // 提问价格（币）
  peekPriceCoin  Int       @default(0) // 围观价格（币）
  peekCount      Int       @default(0) // 围观次数
  isPublic       Boolean   @default(true) // 是否公开（公开后可被围观）
  timeoutHours   Int       @default(72) // 超时时间（小时）
  status         String    @default("PENDING") // PENDING, ANSWERED, REJECTED, REFUNDED, EXPIRED, CLOSED
  stationId      String? // 分站数据隔离（null = 平台级）
  answeredAt     DateTime?
  createdAt      DateTime  @default(now())

  circle   Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  station  Station? @relation(fields: [stationId], references: [id])
  asker    User     @relation("QuestionAsker", fields: [askerId], references: [id], onDelete: Cascade)
  answerer User     @relation("QuestionAnswerer", fields: [answererId], references: [id], onDelete: Cascade)

  @@index([circleId, status])
  @@index([askerId])
  @@index([answererId])
  @@index([stationId])
}

// ─────────────────────────────────────────────────
// 音频连麦记录
// ─────────────────────────────────────────────────

model AudioCallRecord {
  id                 String    @id @default(uuid())
  stationId          String? // 分站数据隔离（null = 平台级）
  callerId           String // 发起方
  calleeId           String // 接收方
  circleId           String?
  pricePerMinuteCoin Int // 每分钟价格（币）
  durationSeconds    Int       @default(0) // 通话时长（秒）
  totalCoin          Int       @default(0) // 总消费币数
  status             String    @default("WAITING") // WAITING, IN_PROGRESS, COMPLETED, CANCELLED
  roomId             String? // TRTC房间ID
  startedAt          DateTime?
  endedAt            DateTime?
  createdAt          DateTime  @default(now())

  caller   User               @relation("Caller", fields: [callerId], references: [id], onDelete: Cascade)
  callee   User               @relation("Callee", fields: [calleeId], references: [id], onDelete: Cascade)
  station  Station?           @relation(fields: [stationId], references: [id])
  billings AudioCallBilling[]

  @@index([callerId, createdAt])
  @@index([calleeId])
  @@index([status])
  @@index([stationId])
}

// 连麦按分钟扣费明细
model AudioCallBilling {
  id            String   @id @default(uuid())
  callRecordId  String // 关联通话记录
  billingMinute Int // 扣费分钟序号（第几分钟）
  coinDeducted  Int // 本次扣费金额（币）
  balanceBefore Int // 扣费前余额
  balanceAfter  Int // 扣费后余额
  createdAt     DateTime @default(now())

  callRecord AudioCallRecord @relation(fields: [callRecordId], references: [id], onDelete: Cascade)

  @@index([callRecordId])
}

// ─────────────────────────────────────────────────
// 直播礼物打赏
// ─────────────────────────────────────────────────

model Gift {
  id        String   @id @default(uuid())
  name      String // 礼物名称
  icon      String? // 图标URL
  priceCoin Int // 价格（币）
  level     String   @default("BASIC") // BASIC, MID, HIGH, TOP
  effectUrl String? // 特效资源URL
  sortOrder Int      @default(0)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  records GiftRecord[]
}

model GiftRecord {
  id         String   @id @default(uuid())
  userId     String // 赠送者
  liveRoomId String // 直播间
  toUserId   String // 接收者（主播）
  giftId     String // 礼物ID
  quantity   Int      @default(1) // 数量
  totalCoin  Int // 总消费币数
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  liveRoom LiveRoom @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  gift     Gift     @relation(fields: [giftId], references: [id])

  @@index([liveRoomId, createdAt])
  @@index([userId])
  @@index([giftId])
  @@index([toUserId])
}

// ─────────────────────────────────────────────────
// 收益分账
// ─────────────────────────────────────────────────

enum EarningScene {
  QUESTION // 付费提问
  PEEK // 围观答案·达人分成
  PEEK_ASKER // 围观答案·提问者分成（董事长拍板 2026-07-10：平台40/提问者30/达人30）
  AUDIO_CALL // 音频连麦
  LIVE_GIFT // 直播打赏
}

model UserEarning {
  id         String       @id @default(uuid())
  userId     String // 收益人
  scene      EarningScene // 场景
  refId      String // 关联业务ID（问答ID/通话ID/礼物记录ID）
  amountCoin Int // 关联币数
  amountRmb  Decimal      @db.Decimal(10, 2) // 折算人民币收益
  rate       Decimal      @db.Decimal(5, 4) // 分佣比例（如0.8=80%）
  createdAt  DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([refId])
}

// ─────────────────────────────────────────────────
// 推荐系统
// ─────────────────────────────────────────────────

enum BehaviorType {
  VIEW
  LIKE
  COLLECT
  COMMENT
  PURCHASE
  LEARN
  SEARCH
  SHARE
  FOLLOW
}

// 【分区候选】P2阶段按月分区(createdAt)，分片键userId，90天后归档；目标迁入ClickHouse
model UserBehavior {
  id         String       @id @default(uuid())
  userId     String
  targetType String // ARTICLE, COURSE, PRODUCT, VIDEO, CIRCLE, CONTENT
  targetId   String
  behavior   BehaviorType
  weight     Float        @default(1.0)
  scene      String?
  createdAt  DateTime     @default(now())

  @@index([userId, behavior, createdAt])
  @@index([userId, targetType, targetId], name: "idx_user_target")
  @@index([targetType, targetId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model UserInterest {
  id        String   @id @default(uuid())
  userId    String
  tag       String
  score     Float    @default(1.0)
  source    String   @default("BEHAVIOR") // TAG_MATCH, PURCHASE, BEHAVIOR, ADMIN
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, tag])
  @@index([userId, score])
  @@index([tag, score])
  @@index([tag])
}

model RecommendRule {
  id            String    @id @default(uuid())
  scene         String // paipan_result, course_detail, product_detail, article_detail, payment_success, search_empty, empty_state, guess_like, ALL
  targetType    String // COURSE, PRODUCT, ARTICLE, CIRCLE, VIDEO
  targetId      String
  ruleType      String // PIN, BOOST, MUTE, BAN, INSERT
  ruleValue     Float?
  position      Int? // 分区强插位置（第N位）
  priority      Int       @default(0)
  conditionJson Json?
  startAt       DateTime?
  endAt         DateTime?
  remark        String?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([scene, targetType, targetId])
  @@index([scene, ruleType])
  @@index([ruleType, priority])
}

model RecommendLog {
  id          String   @id @default(uuid())
  userId      String?
  scene       String
  itemType    String
  itemId      String
  position    Int
  strategy    String
  recommendId String?
  isClick     Boolean  @default(false)
  staySeconds Int?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([scene, createdAt])
  @@index([recommendId])
  @@index([strategy])
}

// ─────────────────────────────────────────────────
// Webhook 系统
// ─────────────────────────────────────────────────

enum WebhookEvent {
  ORDER_PAID
  ORDER_REFUNDED
  USER_REGISTERED
  CONTENT_PUBLISHED
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_PAID
  COURSE_ENROLLED
  LIVE_STARTED
  LIVE_ENDED
}

model WebhookSubscription {
  id          String       @id @default(uuid())
  event       WebhookEvent
  url         String // 回调URL
  secret      String? // HMAC-SHA256 签名密钥
  description String? // 备注
  isActive    Boolean      @default(true)
  lastSentAt  DateTime?
  lastStatus  Int? // 最后一次发送HTTP状态码
  retryCount  Int          @default(0) // 累计重试次数
  maxRetries  Int          @default(3)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([event, isActive])
  @@index([url])
}

model FeatureFlag {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  description   String?
  enabled       Boolean  @default(false)
  percentage    Int      @default(100)
  targetUserIds String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────────────
// 电子书系统（通用电子书，区别于 ClassicBook 古籍）
// ─────────────────────────────────────────────────

enum EbookStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

model EbookCategory {
  id        String   @id @default(uuid())
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  books Ebook[]

  @@unique([name])
}

model Ebook {
  id             String      @id @default(uuid())
  title          String
  titleEn        String? // 英文标题（国际化预留）
  author         String?
  cover          String?
  description    String?
  descriptionEn  String? // 英文描述（国际化预留）
  categoryId     String?
  price          Decimal     @default(0) @db.Decimal(10, 2)
  originalPrice  Decimal?    @db.Decimal(10, 2)
  fileUrl        String? // PDF/EPUB 存储地址
  fileType       String      @default("PDF") // PDF, EPUB
  fileSize       Int? // 文件大小 (bytes)
  totalChapters  Int         @default(0)
  language       String      @default("zh-CN") // AI 翻译目标语言
  hasWatermark   Boolean     @default(true) // 版权水印
  memberFree     Boolean     @default(false) // 会员免费读
  status         EbookStatus @default(DRAFT)
  viewCount      Int         @default(0)
  purchaseCount  Int         @default(0)
  categoryLevel1 String? // 一级品类
  categoryLevel2 String? // 二级品类
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  category        EbookCategory?        @relation(fields: [categoryId], references: [id])
  chapters        EbookChapter[]
  purchases       EbookPurchase[]
  progress        EbookProgress[]
  bookmarks       EbookBookmark[]
  notes           EbookNote[]
  reviews         EbookReview[]
  readingSessions EbookReadingSession[]

  @@index([categoryId])
  @@index([status])
}

model EbookChapter {
  id        String   @id @default(uuid())
  ebookId   String
  title     String
  titleEn   String? // 英文标题（国际化预留）
  content   String? // 纯文本章节内容
  contentEn String? // 英文内容（国际化预留）
  pageStart Int      @default(0)
  pageEnd   Int      @default(0)
  sortOrder Int      @default(0)
  freeTrial Boolean  @default(false) // 免费试读章节
  createdAt DateTime @default(now())

  ebook     Ebook           @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  progress  EbookProgress[]
  bookmarks EbookBookmark[]
  notes     EbookNote[]

  @@index([ebookId, sortOrder])
}

model EbookProgress {
  id          String   @id @default(uuid())
  userId      String
  ebookId     String
  chapterId   String?
  progress    Int      @default(0) // 0-100 百分比
  currentPage Int      @default(0)
  completed   Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebook   Ebook         @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  chapter EbookChapter? @relation(fields: [chapterId], references: [id])

  @@unique([userId, ebookId])
  @@index([userId])
  @@index([chapterId])
}

model EbookBookmark {
  id        String   @id @default(uuid())
  userId    String
  ebookId   String
  chapterId String?
  page      Int      @default(0)
  note      String? // 书签备注
  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebook   Ebook         @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  chapter EbookChapter? @relation(fields: [chapterId], references: [id])

  @@index([userId, ebookId])
  @@index([chapterId])
}

model EbookNote {
  id        String   @id @default(uuid())
  userId    String
  ebookId   String
  chapterId String?
  content   String
  page      Int      @default(0)
  isPublic  Boolean  @default(false) // 是否公开笔记
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebook   Ebook         @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  chapter EbookChapter? @relation(fields: [chapterId], references: [id])

  @@index([userId, ebookId])
  @@index([ebookId])
  @@index([chapterId])
}

model EbookPurchase {
  id       String    @id @default(uuid())
  userId   String
  ebookId  String
  amount   Decimal   @db.Decimal(10, 2)
  paidAt   DateTime  @default(now())
  expireAt DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebook Ebook @relation(fields: [ebookId], references: [id], onDelete: Cascade)

  @@unique([userId, ebookId])
  @@index([userId])
}

model EbookReview {
  id        String   @id @default(uuid())
  ebookId   String
  userId    String
  rating    Int // 1-5 星
  content   String
  reply     String? // 管理员回复
  status    String   @default("PUBLISHED") // PUBLISHED, HIDDEN
  createdAt DateTime @default(now())

  ebook Ebook @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ebookId])
  @@index([ebookId, createdAt])
}

model EbookReadingSession {
  id        String   @id @default(uuid())
  userId    String
  ebookId   String
  duration  Int      @default(0) // 阅读时长(秒)
  pages     Int      @default(0) // 阅读页数
  date      DateTime @db.Date // 日期（按天聚合）
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebook Ebook @relation(fields: [ebookId], references: [id], onDelete: Cascade)

  @@unique([userId, ebookId, date])
  @@index([userId, date])
  @@index([ebookId])
}

// 电子书·我的收藏（用户收藏的电子书，无外键关系便于独立维护，对齐 ClassicFavorite）
model EbookFavorite {
  id        String   @id @default(uuid())
  userId    String
  ebookId   String
  createdAt DateTime @default(now())

  @@unique([userId, ebookId])
  @@index([userId])
}

// ─────────────────────────────────────────────────
// 平台操作日志（区别于 AuditLog 审计日志）
// ─────────────────────────────────────────────────

model OperationLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String // 操作动作（如 config.update, user.ban）
  targetType String? // 操作目标类型
  targetId   String? // 操作目标ID
  detail     Json? // 操作详情（变更前后对比等）
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────
// 营销管理
// ─────────────────────────────────────────────────

model FlashSale {
  id            String          @id @default(uuid())
  name          String          @default("") // 活动名称
  startTime     DateTime // 秒杀开始时间
  endTime       DateTime // 秒杀结束时间
  warmupMinutes Int             @default(0) // 预热提前分钟数
  status        String          @default("DRAFT") // DRAFT/UPCOMING/ACTIVE/ENDED/CANCELLED
  scope         String          @default("GLOBAL") // GLOBAL=全平台可见, PAGE_ONLY=仅微页面可见
  scopePageId   String? // 关联的微页面ID
  items         FlashSaleItem[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, startTime])
  @@index([scope, scopePageId])
}

model FlashSaleItem {
  id          String   @id @default(uuid())
  flashSaleId String
  productId   String
  skuId       String?
  flashPrice  Decimal  @db.Decimal(10, 2) // 秒杀价
  limitCount  Int      @default(1) // 每人限购
  stock       Int // 秒杀库存
  sold        Int      @default(0) // 已售
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  flashSale FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)

  @@unique([flashSaleId, productId])
  @@index([flashSaleId])
}

model GroupBuy {
  id            String   @id @default(uuid())
  productId     String
  skuId         String?
  groupPrice    Decimal  @db.Decimal(10, 2) // 拼团价
  minMembers    Int      @default(2) // 成团人数
  expireMinutes Int      @default(1440) // 拼团有效期（分钟）
  status        String   @default("DRAFT") // DRAFT/ACTIVE/ENDED
  scope         String   @default("GLOBAL") // GLOBAL=全平台可见, PAGE_ONLY=仅微页面可见
  scopePageId   String? // 关联的微页面ID
  autoComplete  Boolean  @default(false) // AI模拟成团
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participants GroupBuyParticipant[]

  @@index([status])
  @@index([scope, scopePageId])
}

model GroupBuyParticipant {
  id         String   @id @default(uuid())
  groupBuyId String
  userId     String
  groupId    String // 同一个拼团组的标识
  isLeader   Boolean  @default(false) // 是否是团长
  status     String   @default("WAITING") // WAITING(已付待成团)/SUCCESS(已成团)/REFUNDED(超时未成团已退款)
  orderId    String? // 关联的拼团订单（付费拼团：支付成功后创建参与者，故恒为已付订单）
  createdAt  DateTime @default(now())

  groupBuy GroupBuy @relation(fields: [groupBuyId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([userId])
  @@index([groupBuyId])
}

model CouponTemplate {
  id              String   @id @default(uuid())
  name            String // 优惠券名称
  type            String // FIXED(满减)/PERCENT(折扣)/SHIPPING(免邮)
  faceValue       Decimal  @db.Decimal(10, 2) // 面额（元）/折扣率
  threshold       Decimal? @db.Decimal(10, 2) // 使用门槛（元）
  totalCount      Int      @default(0) // 发行总量，0=不限
  claimedCount    Int      @default(0)
  usedCount       Int      @default(0)
  startTime       DateTime // 领取开始时间
  endTime         DateTime // 领取结束时间
  validDays       Int      @default(7) // 领取后有效期（天）
  applicableScope Json? // 适用范围：{ productIds, categoryIds, circles }
  aiPrecision     Boolean  @default(false) // AI精准发券
  scope           String   @default("GLOBAL") // GLOBAL=全平台可见, PAGE_ONLY=仅微页面可见
  scopePageId     String? // 关联的微页面ID
  status          String   @default("DRAFT") // DRAFT/ACTIVE/ENDED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  records CouponRecord[]

  @@index([status, endTime])
}

model CouponRecord {
  id        String    @id @default(uuid())
  couponId  String
  userId    String
  status    String    @default("UNUSED") // UNUSED/USED/EXPIRED
  claimedAt DateTime  @default(now())
  usedAt    DateTime?

  coupon CouponTemplate @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId, status])
  @@index([userId])
}

model DiscountActivity {
  id          String   @id @default(uuid())
  name        String
  discountPct Int // 折扣百分比（1-99）
  startTime   DateTime
  endTime     DateTime
  productIds  String[] // 适用商品ID列表
  courseIds   String[] @default([]) // 适用课程ID列表
  circleIds   String[] @default([]) // 适用圈子ID列表
  scope       String   @default("GLOBAL") // GLOBAL=全平台可见, PAGE_ONLY=仅微页面可见
  scopePageId String? // 关联的微页面ID
  status      String   @default("DRAFT") // DRAFT/ACTIVE/ENDED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, startTime])
}

model MarketingPage {
  id           String    @id @default(uuid())
  stationId    String? // 分站数据隔离（null = 平台级）
  name         String // 页面名称
  description  String?   @db.Text // 内部备注
  route        String    @unique // 路由路径
  status       String    @default("DRAFT") // DRAFT/PUBLISHED/OFFLINE
  version      Int       @default(1) // 当前版本号
  publishedAt  DateTime?
  entryConfig  Json? // 入口配置：{ type:"icon"|"banner"|"tab", icon:String?, title:String?, sortOrder:Int }
  entryVisible Boolean   @default(false) // 是否在首页显示入口
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  station    Station?                 @relation(fields: [stationId], references: [id])
  components MarketingPageComponent[]

  @@index([stationId])
}

model MarketingPageComponent {
  id        String    @id @default(uuid())
  pageId    String
  type      String // banner/countdown/flashsale/groupbuy/coupon/recommend/richtext/tabs
  title     String?
  config    Json      @default("{}") // 组件配置JSON
  sortOrder Int       @default(0)
  startTime DateTime?
  endTime   DateTime?
  audience  Json? // 定向人群 { userTags, memberLevels }
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  page MarketingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sortOrder])
}

model Activity {
  id          String           @id @default(uuid())
  name        String
  description String?
  startTime   DateTime
  endTime     DateTime
  pageId      String? // 关联的微页面
  status      String           @default("DRAFT") // DRAFT/ACTIVE/ENDED
  metrics     ActivityMetrics?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, startTime])
}

model ActivityMetrics {
  id          String   @id @default(uuid())
  activityId  String   @unique
  pv          Int      @default(0)
  uv          Int      @default(0)
  conversions Int      @default(0) // 转化数
  revenue     Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt   DateTime @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────
// 风控中心
// ─────────────────────────────────────────────────

model RiskRule {
  id         String   @id @default(uuid())
  name       String // 规则名称
  type       String // FRAUD/SPAM/ABNORMAL/SECURITY
  conditions Json     @default("{}") // 触发条件JSON
  action     String // ALERT/FREEZE/REQUIRE_REVIEW
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([type, enabled])
}

model RiskAlert {
  id         String    @id @default(uuid())
  ruleId     String?
  type       String // 风险类型
  level      String    @default("WARN") // WARN/DANGER/CRITICAL
  title      String
  detail     Json? // 详细信息
  targetType String?
  targetId   String?
  stationId  String?
  status     String    @default("OPEN") // OPEN/HANDLED/IGNORED
  handledBy  String?
  handledAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, level, createdAt])
