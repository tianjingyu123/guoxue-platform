model CircleRefundRequest {
  id                String    @id @default(uuid())
  circleId          String
  userId            String
  orderId           String? // 关联入圈订单
  paidAmount        Decimal   @db.Decimal(10, 2) // 已付费用
  dailyCost         Decimal   @db.Decimal(10, 2) // 每日费用
  usedDays          Int // 已使用天数
  refundBase        Decimal   @db.Decimal(10, 2) // 应退（手续费前）
  feeRate           Decimal   @default(0.20) @db.Decimal(5, 4) // 手续费率
  feeAmount         Decimal   @db.Decimal(10, 2) // 手续费
  actualRefund      Decimal   @db.Decimal(10, 2) // 实际到账
  reason            String?
  refundType        String    @default("normal") // normal / full（全额走客服）
  ownerStatus       String    @default("pending") // pending / approved / rejected
  ownerReviewedAt   DateTime?
  ownerRejectReason String?
  adminStatus       String    @default("pending") // pending / approved / rejected
  adminReviewedAt   DateTime?
  adminRejectReason String?
  refundStatus      String    @default("pending") // pending / refunding / refunded / failed
  refundedAt        DateTime?
  ownerRecalled     Decimal   @default(0) @db.Decimal(10, 2) // 圈主已追回
  stationRecalled   Decimal   @default(0) @db.Decimal(10, 2) // 站长已追回
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([circleId, refundStatus])
  @@index([userId])
}

model CommissionRecall {
  id                String    @id @default(uuid())
  refundId          String // 关联退款申请
  userId            String // 被追回者（站长/圈主）
  userType          String // owner / station_master
  amount            Decimal   @db.Decimal(10, 2) // 追回金额（负数）
  balanceAfter      Decimal   @db.Decimal(10, 2) // 追回后余额
  status            String    @default("pending") // pending / offsetting / completed
  offsetCompletedAt DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId, status])
  @@index([refundId])
}

