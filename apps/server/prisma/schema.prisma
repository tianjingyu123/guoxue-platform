  tokenUsage     Json?    // { promptTokens, completionTokens }
  isCached       Boolean  @default(false)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  paipanRecord PaipanRecord @relation(fields: [paipanRecordId], references: [id])

  @@index([userId, paipanRecordId, analyzeType])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────
// 分站与运营商
// ─────────────────────────────────────────────────

enum OperatorLevel {
  SILVER
  GOLD
  DIAMOND
  BLACK_GOLD
}

model Station {
  id          String   @id @default(uuid())
  userId      String   @unique
  name        String
  code        String   @unique // 推广码
  logo        String?  // 分站Logo
  themeColor  String?  @default("#8B4513") // 主题色
  intro       String?
  status      String   @default("ACTIVE")
  totalEarning Decimal @default(0) @db.Decimal(12, 2)
  // 多小程序配置
  miniAppId   String?  // 分站独立小程序 AppId
  mpAppId     String?  // 分站公众号 AppId（H5 兜底分享）
  miniPages   Json?    // 小程序页面自定义配置 { homePath, sharePath, ... }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id])
  earnings    StationEarning[]
  withdrawals Withdrawal[]
  contents    Content[]
  products    Product[]
  articles    Article[]
  courses     Course[]
  videos      Video[]
  circles     Circle[]

  @@index([code])
}

model Operator {
  id             String       @id @default(uuid())
  userId         String       @unique
  level          OperatorLevel
  containQuota   Int          @default(0) // 包含的站长名额
  usedQuota      Int          @default(0) // 已使用名额
  parentOperatorId String?
  status         String       @default("ACTIVE")
  purchasedAt    DateTime     @default(now())
  expireAt       DateTime?
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([parentOperatorId])
}

model StationEarning {
  id        String   @id @default(uuid())
  stationId String
  orderId   String
  amount    Decimal  @db.Decimal(10, 2)
  rate      Decimal  @db.Decimal(5, 4) // 佣金比例
  earned    Decimal  @db.Decimal(10, 2)
  type      String   // COURSE, PRODUCT, MEMBER, CIRCLE, BOT
  createdAt DateTime @default(now())

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, createdAt])
  @@index([orderId])
}

// ─────────────────────────────────────────────────
// 线下驿站系统
// ─────────────────────────────────────────────────

model StationOffline {
  id           String   @id @default(uuid())
  name         String
  city         String
  address      String
  phone        String
  cover        String?
  ownerUserId  String   @unique
  depositAmount Decimal @default(0) @db.Decimal(10, 2)
  status       String   @default("PENDING") // PENDING, ACTIVE, DISABLED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner          User                         @relation(fields: [ownerUserId], references: [id])
  courses        OfflineCourse[]
  products       StationProduct[]
  orders         StationOrder[]
  teacherBookings StationTeacherBooking[]
  settlements    StationSettlement[]
}

model OfflineCourse {
  id          String   @id @default(uuid())
  stationId   String
  title       String
  cover       String?
  intro       String?
  teacherId   String?
  courseId    String?  // 关联线上课程
  type        String   @default("OFFLINE") // OFFLINE, HYBRID
  price       Decimal  @default(0) @db.Decimal(10, 2)
  maxStudents Int
  startTime   DateTime
  endTime     DateTime
  location    String
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())

  station        StationOffline               @relation(fields: [stationId], references: [id])
  registrations  OfflineCourseRegistration[]

  @@index([stationId, startTime])
}

model OfflineCourseRegistration {
  id        String   @id @default(uuid())
  courseId  String
  userId    String
  status    String   @default("REGISTERED") // REGISTERED, SIGNED_IN, CANCELLED
  qrCode    String?
  signedAt  DateTime?
  createdAt DateTime @default(now())

  course OfflineCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
}

model StationProduct {
  id          String  @id @default(uuid())
  stationId   String
  productId   String?
  name        String
  price       Decimal @db.Decimal(10, 2)
  stock       Int     @default(0)
  isPlatform  Boolean @default(false) // 驿站自有 vs 平台代销
  status      String  @default("ACTIVE")
  createdAt   DateTime @default(now())

  station StationOffline @relation(fields: [stationId], references: [id])

  @@index([stationId])
}

model StationOrder {
  id            String   @id @default(uuid())
  stationId     String
  orderType     String   // OFFLINE_COURSE, PRODUCT, SERVICE
  targetId      String
  amount        Decimal  @db.Decimal(10, 2)
  stationIncome Decimal  @db.Decimal(10, 2)
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())

  station StationOffline @relation(fields: [stationId], references: [id])

  @@index([stationId])
}

model StationTeacherBooking {
  id          String   @id @default(uuid())
  stationId   String
  teacherId   String
  courseId    String?
  bookingDate DateTime
  status      String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  remark      String?
  createdAt   DateTime @default(now())

  station StationOffline @relation(fields: [stationId], references: [id])

  @@index([stationId])
  @@index([teacherId])
}

model StationSettlement {
  id            String   @id @default(uuid())
  stationId     String
  period        String   // 结算周期 如 "2026-05"
  totalIncome   Decimal  @db.Decimal(12, 2)
  stationShare  Decimal  @db.Decimal(12, 2)
  platformShare Decimal  @db.Decimal(12, 2)
  settled       Boolean  @default(false)
  settledAt     DateTime?
  createdAt     DateTime @default(now())

  station StationOffline @relation(fields: [stationId], references: [id])

  @@index([stationId, period])
}

// ─────────────────────────────────────────────────
// 研究院
// ─────────────────────────────────────────────────

enum InstituteRole {
  INITIATOR
  TYPE_A // 潜力讲师
  TYPE_B // 深造者
}

model InstituteMember {
  id             String        @id @default(uuid())
  userId         String        @unique
  role           InstituteRole
  deposit        Decimal       @default(0) @db.Decimal(10, 2) // 保证金
  depositRefunded Boolean      @default(false) // 是否已退保证金
  joinYear       Int           // 加入年份
  tasksCompleted Int           @default(0)
  tasksRequired  Int           @default(3) // 年度任务要求
  lecturerLevel  String        @default("NONE") // NONE, PREPARATORY, JUNIOR, SENIOR, SIGNED
  status         String        @default("ACTIVE") // ACTIVE, GRADUATED, SUSPENDED
  joinedAt       DateTime      @default(now())

  user   User             @relation(fields: [userId], references: [id])
  tasks  InstituteTask[]

  @@index([role, status])
  @@index([joinYear])
}

// 研究院年度任务
model InstituteTask {
  id          String    @id @default(uuid())
  memberId    String
  taskType    String    // SALON, LIVE, ARTICLE
  title       String    // 任务标题
  description String?   // 说明
  status      String    @default("PENDING") // PENDING, COMPLETED, VERIFIED
  completedAt DateTime?
  verifiedBy  String?   // 验证人ID
  createdAt   DateTime  @default(now())

  member InstituteMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, status])
}

// 研究院活动排期
model InstituteEvent {
  id          String    @id @default(uuid())
  title       String
  type        String    // SALON, LIVE, COURSE
  lecturerId  String?   // 讲师用户ID
  description String?
  location    String?   // 线下地点 / 线上链接
  scheduleAt  DateTime
  maxAttendees Int      @default(50)
  status      String    @default("SCHEDULED") // SCHEDULED, ONGOING, COMPLETED, CANCELLED
  createdAt   DateTime  @default(now())

  @@index([scheduleAt])
  @@index([lecturerId])
  @@index([type, status])
}

// ─────────────────────────────────────────────────
// 互动系统
// ─────────────────────────────────────────────────

model Like {
  id         String   @id @default(uuid())
  userId     String
  targetType String   // POST, ARTICLE, COURSE, VIDEO, COMMENT
  targetId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([targetType, createdAt])
  @@index([userId, createdAt])
}

model Comment {
  id         String   @id @default(uuid())
  userId     String
  targetType String   // POST, ARTICLE, COURSE, VIDEO, LIVESTREAM
  targetId   String
  parentId   String?
  content    String
  likeCount  Int      @default(0)
  status     String   @default("PUBLISHED") // PUBLISHED, HIDDEN
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")

  @@index([targetType, targetId, createdAt])
}

model Collect {
  id         String   @id @default(uuid())
  userId     String
  targetType String   // POST, ARTICLE, COURSE, PRODUCT, VIDEO
  targetId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId, createdAt])
  @@index([targetType, targetId])
  @@index([targetType, createdAt])
}

model Report {
  id         String   @id @default(uuid())
  reporterId String   // 举报人
  targetType String   // POST, ARTICLE, COMMENT, CIRCLE, USER, LIVE, VIDEO
  targetId   String
  reason     String
  status     String   @default("PENDING") // PENDING, PROCESSED, DISMISSED
  result     String?
  createdAt  DateTime @default(now())
  processedAt DateTime?

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([targetType, targetId])
}

// ─────────────────────────────────────────────────
// 审计日志
// ─────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  targetType String?
  targetId   String?
  detail     String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ─────────────────────────────────────────────────
// 系统配置与通知
// ─────────────────────────────────────────────────

model ConfigSystem {
  id          String   @id @default(uuid())
  configKey   String   @unique
  configValue String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // SYSTEM, COMMENT, LIKE, FOLLOW, PURCHASE, EARNING, AUDIT
  title     String
  content   String
  targetType String? // 跳转目标类型
  targetId  String?  // 跳转目标ID
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model SearchHistory {
  id        String   @id @default(uuid())
  userId    String
  keyword   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────
// 古籍阅读系统
// ─────────────────────────────────────────────────

model ClassicBook {
  id           String   @id @default(uuid())
  title        String
  author       String?  // 作者/编者
  dynasty      String?  // 朝代
  category     String   @default("子") // 经/史/子/集/释/道
  cover        String?
  intro        String?
  source       String?  // 版本来源
  chapterCount Int      @default(0)
  viewCount    Int      @default(0)
  status       String   @default("PUBLISHED") // DRAFT, PUBLISHED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chapters   ClassicChapter[]
  progresses ReadingProgress[]
  bookmarks  Bookmark[]

  @@index([category])
  @@index([status])
}

model ClassicChapter {
  id          String   @id @default(uuid())
  bookId      String
  title       String   // 章/卷标题
  content     String   // 原文
  translation String?  // 白话译文
  annotation  String?  // 注释
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  book      ClassicBook       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  progresses ReadingProgress[]
  bookmarks Bookmark[]

  @@index([bookId, sortOrder])
}

model ReadingProgress {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  chapterId String
  progress  Float    @default(0) // 阅读进度 0-100
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    ClassicBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter ClassicChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  chapterId String
  position  Int      @default(0) // 文中位置（字符偏移）
  note      String?  // 笔记
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    ClassicBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter ClassicChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([userId, bookId])
  @@index([chapterId])
}

// ─────────────────────────────────────────────────
// 分佣系统
// ─────────────────────────────────────────────────

model CommissionConfig {
  id          String   @id @default(uuid())
  configKey   String   @unique // course_basic / course_premium / course_high / product_platform / product_circle / station_course / station_member / circle_join / bot_call / temp_referral
  configName  String   // 配置名称
  rateA       Decimal  @db.Decimal(10, 4) // 讲师/圈主/站长佣金比例
  rateB       Decimal  @db.Decimal(10, 4) // 平台佣金比例
  rateC       Decimal? @db.Decimal(10, 4) // 第三角色比例（驿站等）
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model Withdrawal {
  id            String   @id @default(uuid())
  userId        String
  stationId     String?  // 关联分站
  amount        Decimal  @db.Decimal(10, 2)
  bankName      String?  // 银行名称
  bankAccount   String?  // 银行卡号
  bankHolder    String?  // 开户人
  alipayAccount String?  // 支付宝账号
  status        String   @default("PENDING") // PENDING, APPROVED, PAID, REJECTED
  remark        String?  // 审核备注
  processedAt   DateTime?
  createdAt     DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  station Station? @relation(fields: [stationId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([stationId])
}

// 推荐链接追踪
model ReferralLink {
  id         String   @id @default(uuid())
  userId     String   // 分享人
  targetType String   // COURSE, PRODUCT, CIRCLE, LIVE, ARTICLE
  targetId   String
  code       String   @unique // 短链接码
  channel    String   @default("DIRECT") // DIRECT, WECHAT, POSTER, QR
  clickCount Int      @default(0)
  orderCount Int      @default(0)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([code])
}

// ─────────────────────────────────────────────────
// 虚拟币体系
// ─────────────────────────────────────────────────

model VirtualCoinAccount {
  id             String @id @default(uuid())
  userId         String @unique
  balance        Int    @default(0) // 当前余额（币数）
  totalRecharged Int    @default(0) // 累计充值币数
  totalSpent     Int    @default(0) // 累计消费币数
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum CoinTransType {
  RECHARGE  // 充值
  SPEND     // 消费
  REFUND    // 退款
  GRANT     // 平台赠送
}

enum CoinScene {
  RECHARGE        // 充值
  CIRCLE_JOIN     // 付费入圈
  PAID_QUESTION   // 付费提问
  PEEK_ANSWER     // 围观答案
  AUDIO_CALL      // 音频连麦
  LIVE_GIFT       // 直播打赏
  BOT_CALL        // 智能体调用
  REFUND          // 退款
  PLATFORM_GRANT  // 平台赠送
}

model VirtualCoinTransaction {
  id           String        @id @default(uuid())
  userId       String
  type         CoinTransType
  amountCoin   Int           // 变动币数（正数为增加，负数为减少）
  balanceAfter Int           // 变动后余额
  scene        CoinScene     // 消费场景
  refId        String?       // 关联业务ID（订单号/问答ID/通话ID等）
  description  String?       // 描述
  createdAt    DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([refId])
}

model VirtualCoinRecharge {
  id         String   @id @default(uuid())
  userId     String
  amountRmb  Decimal  @db.Decimal(10, 2) // 人民币金额
  amountCoin Int      // 币数
  payMethod  String   @default("WECHAT") // WECHAT, ALIPAY
  orderNo    String   @unique // 外部支付订单号
  status     String   @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  paidAt     DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([orderNo])
}

// ─────────────────────────────────────────────────
// 付费问答
// ─────────────────────────────────────────────────

model PaidQuestion {
  id             String   @id @default(uuid())
  circleId       String
  askerId        String   // 提问者
  answererId     String   // 回答者
  questionTitle  String   @default("") // 问题标题
  question       String   // 问题详细描述
  images         String[] @default([])
  answer         String?  // 回答内容（富文本）
  answerAudioUrl String?  // 回答语音URL
  priceCoin      Int      // 提问价格（币）
  peekPriceCoin  Int      @default(0) // 围观价格（币）
  peekCount      Int      @default(0) // 围观次数
  isPublic       Boolean  @default(true) // 是否公开（公开后可被围观）
  timeoutHours   Int      @default(72) // 超时时间（小时）
  status         String   @default("PENDING") // PENDING, ANSWERED, REJECTED, REFUNDED, EXPIRED, CLOSED
  answeredAt     DateTime?
  createdAt      DateTime @default(now())

  circle   Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  asker    User   @relation("QuestionAsker", fields: [askerId], references: [id], onDelete: Cascade)
  answerer User   @relation("QuestionAnswerer", fields: [answererId], references: [id], onDelete: Cascade)

  @@index([circleId, status])
  @@index([askerId])
  @@index([answererId])
}

// ─────────────────────────────────────────────────
// 音频连麦记录
// ─────────────────────────────────────────────────

model AudioCallRecord {
  id                 String   @id @default(uuid())
  callerId           String   // 发起方
  calleeId           String   // 接收方
  circleId           String?
  pricePerMinuteCoin Int      // 每分钟价格（币）
  durationSeconds    Int      @default(0) // 通话时长（秒）
  totalCoin          Int      @default(0) // 总消费币数
  status             String   @default("WAITING") // WAITING, IN_PROGRESS, COMPLETED, CANCELLED
  roomId             String?  // TRTC房间ID
  startedAt          DateTime?
  endedAt            DateTime?
  createdAt          DateTime @default(now())

  caller      User                @relation("Caller", fields: [callerId], references: [id], onDelete: Cascade)
  callee      User                @relation("Callee", fields: [calleeId], references: [id], onDelete: Cascade)
  billings    AudioCallBilling[]

  @@index([callerId, createdAt])
  @@index([calleeId])
  @@index([status])
}

// 连麦按分钟扣费明细
model AudioCallBilling {
  id               String   @id @default(uuid())
  callRecordId     String   // 关联通话记录
  billingMinute    Int      // 扣费分钟序号（第几分钟）
  coinDeducted     Int      // 本次扣费金额（币）
  balanceBefore    Int      // 扣费前余额
  balanceAfter     Int      // 扣费后余额
  createdAt        DateTime @default(now())

  callRecord AudioCallRecord @relation(fields: [callRecordId], references: [id], onDelete: Cascade)

  @@index([callRecordId])
}

// ─────────────────────────────────────────────────
// 直播礼物打赏
// ─────────────────────────────────────────────────

model Gift {
  id        String  @id @default(uuid())
  name      String  // 礼物名称
  icon      String? // 图标URL
  priceCoin Int     // 价格（币）
  level     String  @default("BASIC") // BASIC, MID, HIGH, TOP
  effectUrl String? // 特效资源URL
  sortOrder Int     @default(0)
  status    String  @default("ACTIVE")
  createdAt DateTime @default(now())

  records GiftRecord[]
}

model GiftRecord {
  id         String   @id @default(uuid())
  userId     String   // 赠送者
  liveRoomId String   // 直播间
  toUserId   String   // 接收者（主播）
  giftId     String   // 礼物ID
  quantity   Int      @default(1) // 数量
  totalCoin  Int      // 总消费币数
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  liveRoom LiveRoom @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  gift     Gift     @relation(fields: [giftId], references: [id])

  @@index([liveRoomId, createdAt])
  @@index([userId])
}

// ─────────────────────────────────────────────────
// 收益分账
// ─────────────────────────────────────────────────

enum EarningScene {
  QUESTION       // 付费提问
  PEEK           // 围观答案
  AUDIO_CALL     // 音频连麦
  LIVE_GIFT      // 直播打赏
}

model UserEarning {
  id         String       @id @default(uuid())
  userId     String       // 收益人
  scene      EarningScene // 场景
  refId      String       // 关联业务ID（问答ID/通话ID/礼物记录ID）
  amountCoin Int          // 关联币数
  amountRmb  Decimal      @db.Decimal(10, 2) // 折算人民币收益
  rate       Decimal      @db.Decimal(5, 4)  // 分佣比例（如0.8=80%）
  createdAt  DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([refId])
}

// ─────────────────────────────────────────────────
// 推荐系统
// ─────────────────────────────────────────────────

enum BehaviorType {
  VIEW
  LIKE
  COLLECT
  COMMENT
  PURCHASE
  LEARN
  SEARCH
  SHARE
  FOLLOW
}

model UserBehavior {
  id         String       @id @default(uuid())
  userId     String
  targetType String       // ARTICLE, COURSE, PRODUCT, VIDEO, CIRCLE, CONTENT
  targetId   String
  behavior   BehaviorType
  weight     Float        @default(1.0)
  scene      String?
  createdAt  DateTime     @default(now())

  @@index([userId, behavior, createdAt])
  @@index([userId, targetType, targetId], name: "idx_user_target")
  @@index([targetType, targetId])
  @@index([userId, createdAt])
}

model UserInterest {
  id        String   @id @default(uuid())
  userId    String
  tag       String
  score     Float    @default(1.0)
  source    String   @default("BEHAVIOR") // TAG_MATCH, PURCHASE, BEHAVIOR, ADMIN
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, tag])
  @@index([userId, score])
  @@index([tag, score])
}

model RecommendRule {
  id             String   @id @default(uuid())
  scene          String   // paipan_result, course_detail, product_detail, article_detail, payment_success, search_empty, empty_state, guess_like, ALL
  targetType     String   // COURSE, PRODUCT, ARTICLE, CIRCLE, VIDEO
  targetId       String
  ruleType       String   // PIN, BOOST, MUTE, BAN, INSERT
  ruleValue      Float?
  position       Int?      // 分区强插位置（第N位）
  priority       Int      @default(0)
  conditionJson  Json?
  startAt        DateTime?
  endAt          DateTime?
  remark         String?
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([scene, targetType, targetId])
  @@index([scene, ruleType])
  @@index([ruleType, priority])
}

model RecommendLog {
  id          String   @id @default(uuid())
  userId      String?
  scene       String
  itemType    String
  itemId      String
  position    Int
  strategy    String
  recommendId String?
  isClick     Boolean  @default(false)
  staySeconds Int?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([scene, createdAt])
  @@index([recommendId])
  @@index([strategy])
}

// ─────────────────────────────────────────────────
// Webhook 系统
// ─────────────────────────────────────────────────

enum WebhookEvent {
  ORDER_PAID
  ORDER_REFUNDED
  USER_REGISTERED
  CONTENT_PUBLISHED
  WITHDRAWAL_REQUESTED
  COURSE_ENROLLED
  LIVE_STARTED
  LIVE_ENDED
}

model WebhookSubscription {
  id          String       @id @default(uuid())
  event       WebhookEvent
  url         String       // 回调URL
  secret      String?      // HMAC-SHA256 签名密钥
  description String?      // 备注
  isActive    Boolean      @default(true)
  lastSentAt  DateTime?
  lastStatus  Int?         // 最后一次发送HTTP状态码
  retryCount  Int          @default(0) // 累计重试次数
  maxRetries  Int          @default(3)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([event, isActive])
  @@index([url])
}

model FeatureFlag {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  description   String?
  enabled       Boolean  @default(false)
  percentage    Int      @default(100)
  targetUserIds String[] @default([])
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────────────
// 电子书系统（通用电子书，区别于 ClassicBook 古籍）
// ─────────────────────────────────────────────────

enum EbookStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

model EbookCategory {
  id        String   @id @default(uuid())
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  books Ebook[]

  @@unique([name])
}

model Ebook {
  id            String     @id @default(uuid())
  title         String
  author        String?
  cover         String?
  description   String?
  categoryId    String?
  price         Decimal    @default(0) @db.Decimal(10, 2)
  originalPrice Decimal?   @db.Decimal(10, 2)
  fileUrl       String?                        // PDF/EPUB 存储地址
  fileType      String     @default("PDF")     // PDF, EPUB
  fileSize      Int?                           // 文件大小 (bytes)
  totalChapters Int        @default(0)
  language      String     @default("zh-CN")   // AI 翻译目标语言
  hasWatermark  Boolean    @default(true)      // 版权水印
  memberFree    Boolean    @default(false)     // 会员免费读
  status        EbookStatus @default(DRAFT)
  viewCount     Int        @default(0)
  purchaseCount Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  category  EbookCategory?  @relation(fields: [categoryId], references: [id])
  chapters  EbookChapter[]
  purchases EbookPurchase[]
  progress  EbookProgress[]
  bookmarks EbookBookmark[]
  notes     EbookNote[]

  @@index([categoryId])
  @@index([status])
}

model EbookChapter {
  id        String   @id @default(uuid())
  ebookId   String
  title     String
  content   String?                          // 纯文本章节内容
  pageStart Int      @default(0)
  pageEnd   Int      @default(0)
  sortOrder Int      @default(0)
  freeTrial Boolean  @default(false)         // 免费试读章节
  createdAt DateTime @default(now())

  ebook    Ebook            @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  progress EbookProgress[]
  bookmarks EbookBookmark[]
  notes    EbookNote[]

  @@index([ebookId, sortOrder])
}

model EbookProgress {
  id           String   @id @default(uuid())
  userId       String
  ebookId      String
  chapterId    String?
  progress     Int      @default(0)          // 0-100 百分比
  currentPage  Int      @default(0)
  completed    Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebook   Ebook         @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  chapter EbookChapter? @relation(fields: [chapterId], references: [id])

  @@unique([userId, ebookId])
  @@index([userId])
}

model EbookBookmark {
  id        String   @id @default(uuid())
  userId    String
  ebookId   String
  chapterId String?
  page      Int      @default(0)
  note      String?                          // 书签备注
  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebook   Ebook         @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  chapter EbookChapter? @relation(fields: [chapterId], references: [id])

  @@index([userId, ebookId])
}

model EbookNote {
  id        String   @id @default(uuid())
  userId    String
  ebookId   String
  chapterId String?
  content   String
  page      Int      @default(0)
  isPublic  Boolean  @default(false)         // 是否公开笔记
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebook   Ebook         @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  chapter EbookChapter? @relation(fields: [chapterId], references: [id])

  @@index([userId, ebookId])
  @@index([ebookId])
}

model EbookPurchase {
  id       String   @id @default(uuid())
  userId   String
  ebookId  String
  amount   Decimal  @db.Decimal(10, 2)
  paidAt   DateTime @default(now())
  expireAt DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebook Ebook @relation(fields: [ebookId], references: [id], onDelete: Cascade)

  @@unique([userId, ebookId])
  @@index([userId])
}

// ─────────────────────────────────────────────────
// 平台操作日志（区别于 AuditLog 审计日志）
// ─────────────────────────────────────────────────

model OperationLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String                           // 操作动作（如 config.update, user.ban）
  targetType String?                          // 操作目标类型
  targetId   String?                          // 操作目标ID
  detail     Json?                            // 操作详情（变更前后对比等）
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────
// 营销管理
// ─────────────────────────────────────────────────

model FlashSale {
  id           String   @id @default(uuid())
  startTime    DateTime                        // 秒杀开始时间
  endTime      DateTime                        // 秒杀结束时间
  warmupMinutes Int     @default(0)            // 预热提前分钟数
  status       String   @default("DRAFT")      // DRAFT/UPCOMING/ACTIVE/ENDED/CANCELLED
  items        FlashSaleItem[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, startTime])
}

model FlashSaleItem {
  id          String    @id @default(uuid())
  flashSaleId String
  productId   String
  skuId       String?
  flashPrice  Decimal   @db.Decimal(10, 2)    // 秒杀价
  limitCount  Int       @default(1)           // 每人限购
  stock       Int                              // 秒杀库存
  sold        Int       @default(0)           // 已售
  sortOrder   Int       @default(0)

  flashSale FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)

  @@unique([flashSaleId, productId])
}

model GroupBuy {
  id             String   @id @default(uuid())
  productId      String
  skuId          String?
  groupPrice     Decimal  @db.Decimal(10, 2)   // 拼团价
  minMembers     Int      @default(2)         // 成团人数
  expireMinutes  Int      @default(1440)       // 拼团有效期（分钟）
  status         String   @default("DRAFT")   // DRAFT/ACTIVE/ENDED
  autoComplete   Boolean  @default(false)     // AI模拟成团
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  participants GroupBuyParticipant[]

  @@index([status])
}

model GroupBuyParticipant {
  id          String   @id @default(uuid())
  groupBuyId  String
  userId      String
  groupId     String                          // 同一个拼团组的标识
  isLeader    Boolean  @default(false)        // 是否是团长
  status      String   @default("WAITING")    // WAITING/SUCCESS/REFUNDED
  createdAt   DateTime @default(now())

  groupBuy GroupBuy @relation(fields: [groupBuyId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([userId])
}

model CouponTemplate {
  id           String   @id @default(uuid())
  name         String                          // 优惠券名称
  type         String                          // FIXED(满减)/PERCENT(折扣)/SHIPPING(免邮)
  faceValue    Decimal  @db.Decimal(10, 2)    // 面额（元）/折扣率
  threshold    Decimal? @db.Decimal(10, 2)    // 使用门槛（元）
  totalCount   Int      @default(0)           // 发行总量，0=不限
  claimedCount Int      @default(0)
  usedCount    Int      @default(0)
  startTime    DateTime                        // 领取开始时间
  endTime      DateTime                        // 领取结束时间
  validDays    Int      @default(7)            // 领取后有效期（天）
  scope        Json?                           // 适用范围：{ productIds, categoryIds, circles }
  aiPrecision  Boolean  @default(false)        // AI精准发券
  status       String   @default("DRAFT")      // DRAFT/ACTIVE/ENDED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  records CouponRecord[]

  @@index([status, endTime])
}

model CouponRecord {
  id          String   @id @default(uuid())
  couponId    String
  userId      String
  status      String   @default("UNUSED")     // UNUSED/USED/EXPIRED
  claimedAt   DateTime @default(now())
  usedAt      DateTime?

  coupon CouponTemplate @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId, status])
  @@index([userId])
}

model DiscountActivity {
  id          String   @id @default(uuid())
  name        String
  discountPct Int                              // 折扣百分比（1-99）
  startTime   DateTime
  endTime     DateTime
  productIds  String[]                         // 适用商品ID列表
  status      String   @default("DRAFT")       // DRAFT/ACTIVE/ENDED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, startTime])
}

model MarketingPage {
  id          String   @id @default(uuid())
  name        String                          // 页面名称
  route       String   @unique               // 路由路径
  status      String   @default("DRAFT")     // DRAFT/PUBLISHED/OFFLINE
  version     Int      @default(1)           // 当前版本号
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  components MarketingPageComponent[]
}

model MarketingPageComponent {
  id          String   @id @default(uuid())
  pageId      String
  type        String                          // banner/countdown/flashsale/groupbuy/coupon/recommend/richtext/tabs
  title       String?
  config      Json                            // 组件配置JSON
  sortOrder   Int      @default(0)
  startTime   DateTime?
  endTime     DateTime?
  audience    Json?                           // 定向人群 { userTags, memberLevels }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  page MarketingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sortOrder])
}

model Activity {
  id          String   @id @default(uuid())
  name        String
  description String?
  startTime   DateTime
  endTime     DateTime
  pageId      String?                         // 关联的微页面
  status      String   @default("DRAFT")     // DRAFT/ACTIVE/ENDED
  metrics     ActivityMetrics?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, startTime])
}

model ActivityMetrics {
  id          String   @id @default(uuid())
  activityId  String   @unique
  pv          Int      @default(0)
  uv          Int      @default(0)
  conversions Int      @default(0)           // 转化数
  revenue     Decimal  @db.Decimal(12, 2) @default(0)
  updatedAt   DateTime @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────
// 风控中心
// ─────────────────────────────────────────────────

model RiskRule {
  id          String   @id @default(uuid())
  name        String                          // 规则名称
  type        String                          // FRAUD/SPAM/ABNORMAL/SECURITY
  conditions  Json                            // 触发条件JSON
  action      String                          // ALERT/FREEZE/REQUIRE_REVIEW
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, enabled])
}

model RiskAlert {
  id          String   @id @default(uuid())
  ruleId      String?
  type        String                          // 风险类型
  level       String   @default("WARN")      // WARN/DANGER/CRITICAL
  title       String
  detail      Json?                           // 详细信息
  targetType  String?
  targetId    String?
  status      String   @default("OPEN")       // OPEN/HANDLED/IGNORED
  handledBy   String?
  handledAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([status, level, createdAt])
  @@index([type, createdAt])
}

model FraudDetection {
  id          String   @id @default(uuid())
  userId      String?
  type        String                          // BRUSH_ORDER/FAKE_ACCOUNT/REFUND_ABUSE
  confidence  Decimal  @db.Decimal(3, 2)     // AI置信度 0-1
  evidence    Json?                           // 证据链
  status      String   @default("PENDING")    // PENDING/CONFIRMED/DISMISSED
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
  @@index([userId])
}

model UserBehaviorLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String                          // 行为类型
  targetType  String?
  targetId    String?
  meta        Json?                           // 行为元数据
  ip          String?
  deviceId    String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([deviceId])
}

model AppealRecord {
  id          String   @id @default(uuid())
  userId      String
  type        String                          // USER_BAN/CONTENT_BLOCK/WITHDRAWAL_REJECT
  reason      String                          // 申诉理由
  evidence    Json?                           // 申诉证据（图片等）
  status      String   @default("PENDING")    // PENDING/APPROVED/REJECTED
  reviewedBy  String?
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, status])
  @@index([status, createdAt])
}

model DeviceFingerprint {
  id          String   @id @default(uuid())
  userId      String
  deviceId    String                          // 设备唯一标识
  platform    String?                         // ios/android/web
  userAgent   String?
  ip          String?
  isTrusted   Boolean  @default(true)
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([deviceId])
}

// ─────────────────────────────────────────────────
// 财务管理
// ─────────────────────────────────────────────────

model ReconciliationRecord {
  id          String   @id @default(uuid())
  source      String                          // WECHAT/ALIPAY/UNIONPAY
  billDate    DateTime                        // 账单日期
  status      String   @default("PENDING")    // PENDING/MATCHED/MISMATCH
  totalAmount Decimal  @db.Decimal(12, 2)    // 账单总金额
  matchAmount Decimal  @db.Decimal(12, 2) @default(0)  // 匹配金额
  diffCount   Int      @default(0)           // 差异笔数
  detail      Json?                           // 差异明细
  createdAt   DateTime @default(now())

  @@index([source, billDate])
  @@index([status])
}

model Invoice {
  id          String   @id @default(uuid())
  userId      String?
  orderId     String
  type        String                          // PERSONAL/COMPANY
  title       String                          // 发票抬头
  taxNo       String?                         // 税号
  amount      Decimal  @db.Decimal(10, 2)
  status      String   @default("PENDING")    // PENDING/ISSUED/MAILED/REJECTED
  invoiceUrl  String?
  expressNo   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model SettlementOrder {
  id          String   @id @default(uuid())
  userId      String
  period      String                          // 结算周期（如 2026-05）
  amount      Decimal  @db.Decimal(12, 2)
  detail      Json?                           // 收入明细breakdown
  status      String   @default("PENDING")    // PENDING/APPROVED/PAID/REJECTED
  approvedBy  String?
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, period])
  @@index([status])
}

model WithdrawalApplication {
  id          String   @id @default(uuid())
  userId      String
  amount      Decimal  @db.Decimal(10, 2)
  payMethod   String                          // WECHAT/ALIPAY/BANK
  accountInfo Json                            // 收款账户信息
  status      String   @default("PENDING")    // PENDING/APPROVED/REJECTED/PAID
  level       Int      @default(1)           // 审批级别
  reviewedBy  String?
  reviewNote  String?
  createdAt   DateTime @default(now())

  @@index([userId, status])
  @@index([status, createdAt])
}

model FinancialReport {
  id          String   @id @default(uuid())
  type        String                          // MONTHLY/QUARTERLY/YEARLY
  period      String                          // 报告周期（如 2026-05）
  data        Json                            // 报告数据JSON
  generatedBy String?                         // AI/AUTO/MANUAL
  createdAt   DateTime @default(now())

  @@unique([type, period])
}

// ─────────────────────────────────────────────────
// 系统设置增强
// ─────────────────────────────────────────────────

model PageContentConfig {
  id        String   @id @default(uuid())
  pageRoute String                          // 页面路由
  fieldKey  String                          // 文案字段标识
  content   String                          // 文案内容
  updatedAt DateTime @updatedAt

  @@unique([pageRoute, fieldKey])
}

model SiteNotice {
  id        String   @id @default(uuid())
  title     String
  content   String
  type      String   @default("INFO")       // INFO/WARNING/FORCE
  isActive  Boolean  @default(true)
  startTime DateTime?
  endTime   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model ConfigVersion {
  id         String   @id @default(uuid())
  configKey  String                         // 配置键
  value      Json                           // 配置值快照
  version    Int
  changedBy  String?
  comment    String?                        // 变更说明
  createdAt  DateTime @default(now())

  @@index([configKey, version])
}

model MemberConfig {
  id            String   @id @default(uuid())
  level         String   @unique           // MONTHLY/YEARLY/LIFETIME
  name          String                     // 显示名称
  price         Decimal  @db.Decimal(10, 2)
  coinBonus     Int      @default(0)       // 每月赠送国学币
  benefits      Json?                      // 权益列表
  maxBorrowDays Int      @default(30)      // 电子书最大借阅天数
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────────────
// 运费模板
// ─────────────────────────────────────────────────

model FreightTemplate {
  id            String   @id @default(uuid())
  name          String                     // 模板名称
  type          String   @default("FIXED") // FREE/FIXED/CONDITIONAL
  defaultFee    Decimal  @default(0) @db.Decimal(10, 2) // 默认运费
  conditionFree Json?                      // 包邮条件 [{"region":"default","threshold":99}]
  regions       Json?                      // 区域运费 [{"region":"华东","fee":10}]
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────────────
// 满减送活动
// ─────────────────────────────────────────────────

model FullReductionRule {
  id          String   @id @default(uuid())
  name        String                     // 活动名称
  threshold   Decimal  @db.Decimal(10, 2) // 满金额
  reduction   Decimal  @db.Decimal(10, 2) // 减金额
  giftProductId String?                   // 赠品商品ID
  giftCount   Int      @default(0)       // 赠品数量
  startTime   DateTime
  endTime     DateTime
  productIds  String[] @default([])      // 适用商品（空=全场）
  status      String   @default("DRAFT") // DRAFT/ACTIVE/ENDED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, startTime, endTime])
}

