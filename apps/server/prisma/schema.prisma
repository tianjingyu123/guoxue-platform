// ─────────────────────────────────────────────────
// 自动化运营 — 任务池系统
// ─────────────────────────────────────────────────

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  NEEDS_REVIEW
  CANCELLED
  EXPIRED
}

enum TaskType {
  CODE_DEVELOP
  BUG_FIX
  DATA_ANALYSIS
  USER_FEEDBACK
  CONTENT_REVIEW
  FINANCE_CHECK
  SYSTEM_HEALTH
  SCHEDULED_TASK
}

model Task {
  id            String       @id @default(uuid())
  type          TaskType
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(PENDING)
  title         String
  description   String?
  executorType  String? // "CLAUDE" | "HUMAN"
  executorId    String? // Claude实例ID 或 用户ID
  snapshot      Json? // 任务数据快照（切换执行者时恢复现场）
  result        Json? // 执行结果
  errorLog      String? // 失败原因
  rollbackData  Json? // 回滚所需数据
  rollbackUrl   String? // 回滚API路径
  needsApproval Boolean      @default(false) // 高风险操作需审批
  approvedBy    String? // 审批人ID
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  completedAt   DateTime?
  expiresAt     DateTime?

  transferLogs TaskTransferLog[]

  @@index([status])
  @@index([executorType, status])
  @@index([priority])
  @@index([createdAt])
}

model TaskTransferLog {
  id        String   @id @default(uuid())
  taskId    String
  fromType  String // "CLAUDE" | "HUMAN"
  fromId    String?
  toType    String // "CLAUDE" | "HUMAN"
  toId      String?
  reason    String // 转交原因
  snapshot  Json? // 转交时的任务状态快照
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────
// 数字员工运营 OS — 任务池（OS-P1·设计§2.1）
// 数字员工与真人从同一池取任务：完成/转交全记录，状态存 DB 不存脑内
// ─────────────────────────────────────────────────

model OpsTask {
  id            String   @id @default(uuid())
  type          String // INSPECT(巡检) | FIX(修复) | REVIEW(审核) | OPS(运营动作)
  priority      String   @default("MEDIUM") // HIGH | MEDIUM | LOW
  status        String   @default("pending") // pending | in_progress | completed | needs_review
  title         String // 任务标题（列表可读）
  executor      String? // "CLAUDE" | 用户ID/人名 —— 当前认领者
  payload       Json     @default("{}") // 任务数据快照（换执行者可恢复现场）
  result        Json? // 执行结果
  reviewReason  String? // 转 needs_review 的原因
  needsApproval Boolean  @default(false) // 高风险操作（退款/删数据/改价/资金）永远 true 走人工
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, priority])
  @@index([type, status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────
// 自动化运营 — 权限系统
// ─────────────────────────────────────────────────

model AutomationPermission {
  id        String   @id @default(uuid())
  resource  String // "task", "user", "content", "finance", "system"
  action    String // "read", "write", "delete", "approve", "manage"
  createdAt DateTime @default(now())

  rolePermissions AutomationRolePermission[]

  @@unique([resource, action])
}

model AutomationRole {
  id          String   @id @default(uuid())
  name        String   @unique // "SUPER_ADMIN", "DIGITAL_EMPLOYEE", "OPERATOR", "AUDITOR"
  description String?
  isSystem    Boolean  @default(false) // 系统内置角色不可删除
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions AutomationRolePermission[]
  assignees   AutomationRoleAssignee[]
}

model AutomationRolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       AutomationRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AutomationPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model AutomationRoleAssignee {
  id         String   @id @default(uuid())
  roleId     String
  userId     String
  isActive   Boolean  @default(true) // 可临时冻结
  assignedAt DateTime @default(now())

  role AutomationRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, userId])
  @@index([userId])
}

