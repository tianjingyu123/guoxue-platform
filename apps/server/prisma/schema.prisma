// ─────────────────────────────────────────────────
// 商家入驻系统
// ─────────────────────────────────────────────────

enum MerchantStatus {
  PENDING_REVIEW    // 待审核
  REVIEW_FAILED     // 审核驳回
  DEPOSIT_PENDING   // 待缴纳保证金
  AGREEMENT_PENDING // 待签署协议
  ACTIVE            // 已开通（正常经营）
  SUSPENDED         // 已暂停
  CLOSED            // 已关闭
}

enum ViolationSeverity {
  MINOR
  MODERATE
  SEVERE
}

model Merchant {
  id               String         @id @default(uuid())
  userId           String         @unique
  shopName         String                                          // 店铺名称
  shopLogo         String?                                         // 店铺Logo
  shopIntro        String?                                         // 店铺简介
  contactName      String                                          // 联系人姓名
  contactPhone     String                                          // 联系电话
  idCardNumber     String                                          // 身份证号（加密存储）
  idCardFront      String?                                         // 身份证正面照
  idCardBack       String?                                         // 身份证反面照
  businessLicense  String?                                         // 营业执照（可选）
  brandAuth        String?                                         // 品牌授权书（可选）
  categoryIds      String[]       @default([])                     // 经营类目
  status           MerchantStatus @default(PENDING_REVIEW)
  depositAmount    Decimal?       @db.Decimal(10, 2)               // 应缴保证金
  depositPaid      Boolean        @default(false)                  // 保证金是否已缴纳
  agreementSigned  Boolean        @default(false)                  // 协议是否已签署
  agreementUrl     String?                                         // 已签协议文件URL
  signedAt         DateTime?                                       // 协议签署时间
  signedIp         String?                                         // 签署IP
  rejectReason     String?                                         // 驳回原因
  commissionRate   Decimal?       @db.Decimal(5, 4)                // 商家自定义分佣比例
  totalSales       Decimal        @default(0) @db.Decimal(12, 2)   // 累计销售额
  totalOrders      Int            @default(0)                      // 累计订单数
  rating           Decimal        @default(5.0) @db.Decimal(3, 2)  // 店铺评分
  openedAt         DateTime?                                       // 开店时间
  closedAt         DateTime?                                       // 关店时间
  reviewedBy       String?                                         // 审核人ID
  reviewedAt       DateTime?                                       // 审核时间
  remark           String?                                         // 内部备注
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user           User                    @relation(fields: [userId], references: [id])
  violations     MerchantViolation[]
  depositRecords MerchantDepositRecord[]
  agreements     MerchantAgreement[]

  @@index([status])
  @@index([status, createdAt])
  @@index([shopName])
}

model MerchantViolation {
  id          String           @id @default(uuid())
  merchantId  String
  type        ViolationSeverity
  title       String                                             // 违规标题
  description String                                             // 违规描述
  penalty     Decimal?         @db.Decimal(10, 2)                // 罚款金额
  status      ViolationStatus  @default(PENDING)
  evidence    Json?                                              // 证据材料
  handledBy   String?                                            // 处理人
  handledAt   DateTime?                                          // 处理时间
  appeal      String?                                            // 申诉内容
  appealAt    DateTime?                                          // 申诉时间
  createdAt   DateTime         @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([status])
}

enum ViolationStatus {
  PENDING
  CONFIRMED
  DISMISSED
}

model MerchantDepositRecord {
  id               String   @id @default(uuid())
  merchantId       String
  amount           Decimal  @db.Decimal(10, 2)
  type             String                                        // PAYMENT / REFUND / DEDUCTION / TOPUP
  status           String   @default("PENDING")                  // PENDING / SUCCESS / FAILED
  payMethod        String?                                       // WECHAT / ALIPAY / BANK_TRANSFER
  payTransactionId String?
  remark           String?
  createdAt        DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model MerchantAgreement {
  id         String    @id @default(uuid())
  merchantId String
  version    String                                              // 版本号
  title      String    @default("商家入驻协议")
  content    String                                              // 协议内容（HTML/Markdown）
  signedAt   DateTime?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

// ─────────────────────────────────────────────────
// 圈主助理知识库（pgvector）
// ─────────────────────────────────────────────────

model CircleKnowledge {
  id          String                        @id @default(uuid())
  circleId    String
  sourceType  String                        // article/post/course/file/manual
  sourceId    String?
  content     String                        // 知识库文本内容
  contentHash String                        // MD5哈希值，用于去重
  vectorJson  String?                       // pgvector不可用时的JSON向量备份
  status      String                        @default("active") // active/removed/pending
  addedBy     String?                       // 添加人ID（圈主ID或"SYSTEM"）
  addedAt     DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([contentHash, circleId])
  @@index([circleId, status])
  @@index([circleId, sourceType])
}

model CircleKnowledgeManual {
  id         String   @id @default(uuid())
  circleId   String
  userId     String   // 操作人（圈主）
  targetType String   // post/article
  targetId   String
  action     String   // add/remove
  createdAt  DateTime @default(now())

  @@index([circleId, createdAt])
}

model CircleKnowledgeCandidate {
  id               String   @id @default(uuid())
  circleId         String
  sourceType       String   // article/post/course/file
  sourceId         String?
  content          String
  contentHash      String
  similarityScore  Float?   // 与已有内容的最高相似度
  similarToId      String?  // 疑似重复的目标内容ID
  status           String   @default("pending") // pending/confirmed/rejected
  createdAt        DateTime @default(now())

  @@index([circleId, status])
}

// ─────────────────────────────────────────────────
// 自动化运营 — 任务池系统
// ─────────────────────────────────────────────────

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  NEEDS_REVIEW
  CANCELLED
}

enum TaskType {
  CODE_DEVELOP
  BUG_FIX
  DATA_ANALYSIS
  USER_FEEDBACK
  CONTENT_REVIEW
  FINANCE_CHECK
  SYSTEM_HEALTH
  SCHEDULED_TASK
}

model Task {
  id            String     @id @default(uuid())
  type          TaskType
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus @default(PENDING)
  title         String
  description   String?
  executorType  String     // "CLAUDE" | "HUMAN"
  executorId    String?    // Claude实例ID 或 用户ID
  snapshot      Json?      // 任务数据快照（切换执行者时恢复现场）
  result        Json?      // 执行结果
  errorLog      String?    // 失败原因
  rollbackData  Json?      // 回滚所需数据
  rollbackUrl   String?    // 回滚API路径
  needsApproval Boolean    @default(false) // 高风险操作需审批
  approvedBy    String?    // 审批人ID
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  completedAt   DateTime?

  transferLogs  TaskTransferLog[]

  @@index([status])
  @@index([executorType, status])
  @@index([priority])
  @@index([createdAt])
}

model TaskTransferLog {
  id        String   @id @default(uuid())
  taskId    String
  fromType  String   // "CLAUDE" | "HUMAN"
  fromId    String?
  toType    String   // "CLAUDE" | "HUMAN"
  toId      String?
  reason    String   // 转交原因
  snapshot  Json?    // 转交时的任务状态快照
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────
// 自动化运营 — 权限系统
// ─────────────────────────────────────────────────

model AutomationPermission {
  id        String @id @default(uuid())
  resource  String // "task", "user", "content", "finance", "system"
  action    String // "read", "write", "delete", "approve", "manage"
  createdAt DateTime @default(now())

  rolePermissions AutomationRolePermission[]

  @@unique([resource, action])
}

model AutomationRole {
  id          String   @id @default(uuid())
  name        String   @unique  // "SUPER_ADMIN", "DIGITAL_EMPLOYEE", "OPERATOR", "AUDITOR"
  description String?
  isSystem    Boolean  @default(false) // 系统内置角色不可删除
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions AutomationRolePermission[]
  assignees  AutomationRoleAssignee[]
}

model AutomationRolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       AutomationRole      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AutomationPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model AutomationRoleAssignee {
  id        String   @id @default(uuid())
  roleId    String
  userId    String
  isActive  Boolean  @default(true) // 可临时冻结
  assignedAt DateTime @default(now())

  role AutomationRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, userId])
  @@index([userId])
}

