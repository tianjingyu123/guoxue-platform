/**
 * 圈子达人语音/视频付费通话（规格 circle-consult-rules-v1，原生SQL建表绕generate锁；资金代码上线前须人工review+真实数据e2e）
 */
model ConsultCall {
  id             String    @id @default(uuid())
  circleId       String
  callerId       String // 发起方（咨询者）
  expertId       String // 达人
  type           String // VOICE / VIDEO
  pricePerMinute Int // 下单时快照的金币单价
  prepaidCoin    Int // 预扣金币
  status         String    @default("WAITING") // WAITING/ONGOING/ENDED/REFUNDED/MISSED
  rtcRoomId      String? // 腾讯 TRTC 房间号
  startAt        DateTime?
  endAt          DateTime?
  durationSec    Int       @default(0)
  settledCoin    Int       @default(0) // 实际结算金币（不足1分钟按1分钟）
  refundedCoin   Int       @default(0)
  createdAt      DateTime  @default(now())

  // ── 评价（待办 #31·2026-07-11·manual/2026-07-11-call-rating.sql·仅原生 SQL 访问） ──
  rating        Int? // 星级 1-5（仅发起方·ENDED 后 24h 内·一次）
  ratingTags    String? // 快捷标签（逗号串）
  ratingComment String? // 文字评价（≤200 字·应用层校验）
  ratedAt       DateTime? // 非空即已评价（幂等锚点）

  // ── 24 小时账单申诉（处理只记结论·资金零触碰·退款走人工金币退款审批流） ──
  disputeReason      String?
  disputedAt         DateTime? // 非空即已申诉（幂等锚点）
  disputeStatus      String? // PENDING/RESOLVED/REJECTED
  disputeResolveNote String?
  disputeResolvedAt  DateTime?
  disputeReviewerId  String?

  @@index([callerId])
  @@index([expertId, status])
  @@index([expertId, rating])
  @@index([disputeStatus])
}

// ───────── IM 社交权限（阶段一·2026-06-28） ─────────

/// 私信权限全局配置（后台可调，单例 id="default"）
model ImPolicyConfig {
  id              String   @id @default("default")
  allowStrangerDM Boolean  @default(false) // 陌生人私信
  followerDMQuota Int      @default(1) // 未互关·关注者可发条数
  allowImage      Boolean  @default(true)
  allowVoice      Boolean  @default(true)
  allowFile       Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

/// 单向关注私信计数（fromUser 向 toUser 已发未回条数；对方回复时清零）
model ImC2CCounter {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  sentCount  Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
