  // AI 计费（2026-07-03 拍板）：会员免费；非会员每用户 freeUses 次免费试用，用完按 pricePer10Coin 购买追问包（10次/包）
  freeUses       Int      @default(3) // 每用户累计免费追问次数
  pricePer10Coin Int      @default(0) // 每 10 次追问价格（国学币·0=该智能体免费不限）
  sortOrder      Int      @default(0)
  voiceEnabled   Boolean? @default(false) // Coze 语音通话开关
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
