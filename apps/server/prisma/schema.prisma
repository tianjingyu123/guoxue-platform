// ─────────────────────────────────────────────────
// 商家入驻系统
// ─────────────────────────────────────────────────

enum MerchantStatus {
  PENDING_REVIEW // 待审核
  REVIEW_FAILED // 审核驳回
  DEPOSIT_PENDING // 待缴纳保证金
  AGREEMENT_PENDING // 待签署协议
  ACTIVE // 已开通（正常经营）
  SUSPENDED // 已暂停
  CLOSED // 已关闭
}

enum ViolationSeverity {
  MINOR
  MODERATE
  SEVERE
}

model Merchant {
  id              String         @id @default(uuid())
  userId          String         @unique
  shopName        String // 店铺名称
  shopLogo        String? // 店铺Logo
  shopIntro       String? // 店铺简介
  contactName     String // 联系人姓名
  contactPhone    String // 联系电话
  idCardNumber    String // 身份证号（加密存储）
  idCardFront     String? // 身份证正面照
  idCardBack      String? // 身份证反面照
  /// 营业执照。DB 列可空仅为兼容存量商家；【新入驻必填】（CreateMerchantApplyDto 强制）。
  /// 硬门槛在进件：无执照 → 办不下商户号 → 进不了件 → 自收不了款 → 只能平台代收 = 二清。
  /// 见 PayeeAccount / docs/design/资金与分账架构-设计文档-20260714.md
  businessLicense String?
  brandAuth       String? // 品牌授权书（可选）
  categoryIds     String[]       @default([]) // 经营类目
  status          MerchantStatus @default(PENDING_REVIEW)
  depositAmount   Decimal?       @db.Decimal(10, 2) // 应缴保证金
  depositPaid     Boolean        @default(false) // 保证金是否已缴纳
  agreementSigned Boolean        @default(false) // 协议是否已签署
  agreementUrl    String? // 已签协议文件URL
  signedAt        DateTime? // 协议签署时间
  signedIp        String? // 签署IP
  rejectReason    String? // 驳回原因
  commissionRate  Decimal?       @db.Decimal(5, 4) // 商家自定义分佣比例
  totalSales      Decimal        @default(0) @db.Decimal(12, 2) // 累计销售额
  totalOrders     Int            @default(0) // 累计订单数
  rating          Decimal        @default(5.0) @db.Decimal(3, 2) // 店铺评分
  openedAt        DateTime? // 开店时间
  closedAt        DateTime? // 关店时间
  reviewedBy      String? // 审核人ID
  reviewedAt      DateTime? // 审核时间
  remark          String? // 内部备注
  creditScore     Int            @default(60) // 信用分（0-100·履-P2 周更 cron 按 30 日 MerchantMetric 算得·新商家 60 分起评）
  creditGrade     String         @default("B") // 信用等级 A/B/C/D（A≥85/B70-84/C55-69/D<55·默认 B 为设计拍板的新商家起始待遇）
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user           User                    @relation(fields: [userId], references: [id])
  violations     MerchantViolation[]
  depositRecords MerchantDepositRecord[]
  agreements     MerchantAgreement[]
  settlements    MerchantSettlement[]
  members        MerchantMember[]

  @@index([status])
  @@index([status, createdAt])
  @@index([shopName])
}

// 商家操作员：支持一个店铺(尤其官方旗舰店)有多个用户账号以该店铺身份经营。
// 关键设计：商品/订单归属仍统一记 owner(Merchant.userId)，操作员身份只用于「鉴权 + 审计」，
// 不改动 Product.userId→Merchant 反查分佣的既有链路（见 merchant.guard/merchant-backend.controller）。
model MerchantMember {
  id         String   @id @default(uuid())
  merchantId String
  userId     String // 操作员用户ID
  role       String   @default("OPERATOR") // OWNER / OPERATOR
  status     String   @default("ACTIVE") // ACTIVE / REMOVED
  invitedBy  String? // 邀请人 userId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, userId])
  @@index([userId, status])
}

model MerchantViolation {
  id          String            @id @default(uuid())
  merchantId  String
  type        ViolationSeverity
  title       String // 违规标题
  description String // 违规描述
  penalty     Decimal?          @db.Decimal(10, 2) // 罚款金额
  status      ViolationStatus   @default(PENDING)
  evidence    Json? // 证据材料
  handledBy   String? // 处理人
  handledAt   DateTime? // 处理时间
  appeal      String? // 申诉内容
  appealAt    DateTime? // 申诉时间
  createdAt   DateTime          @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([status])
  @@index([merchantId, status])
}

enum ViolationStatus {
  PENDING
  CONFIRMED
  DISMISSED
}

model MerchantDepositRecord {
  id               String   @id @default(uuid())
  merchantId       String
  amount           Decimal  @db.Decimal(10, 2)
  type             String // PAYMENT / REFUND / DEDUCTION / TOPUP
  status           String   @default("PENDING") // PENDING / SUCCESS / FAILED
  payMethod        String? // WECHAT / ALIPAY / BANK_TRANSFER
  payTransactionId String?
  remark           String?
  createdAt        DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model MerchantSettlement {
  id               String    @id @default(cuid())
  merchantId       String
  merchant         Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  periodStart      DateTime
  periodEnd        DateTime
  orderCount       Int       @default(0)
  totalRevenue     Decimal   @default(0) @db.Decimal(12, 2)
  commission       Decimal   @default(0) @db.Decimal(12, 2)
  settlementAmount Decimal   @default(0) @db.Decimal(12, 2)
  status           String    @default("PENDING")
  paidAt           DateTime?
  paidAmount       Decimal?  @db.Decimal(12, 2)
  remark           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([merchantId])
  @@index([merchantId, status])
  @@index([createdAt])
  @@map("merchant_settlements")
}

model MerchantAgreement {
  id         String    @id @default(uuid())
  merchantId String
  version    String // 版本号
  title      String    @default("商家入驻协议")
  content    String // 协议内容（HTML/Markdown）
  signedAt   DateTime?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

/// 商家履约日指标（履-P1）：每日凌晨 cron 聚合昨日，date=YYYY-MM-DD(Asia/Shanghai)
/// 数据源：Order(paidAt/shippedAt)、AfterSale(refund/return·经 orderId 关联)、
/// ProductReview(经 Product.userId 关联商家)、Report(targetType=PRODUCT/USER 视为投诉)
/// 取不到的字段诚实 null（如 qcPassRate：抽检 QcRecord 表尚未建，二期补）
model MerchantMetric {
  id             String   @id @default(uuid())
  merchantId     String
  date           String // YYYY-MM-DD（Asia/Shanghai）
  ordersCount    Int      @default(0) // 当日支付订单数（paidAt 当日·非 PENDING/CANCELLED）
  shipOnTimeRate Decimal? @db.Decimal(5, 4) // 当日发货订单中 paidAt→shippedAt ≤48h 的占比；当日无发货则 null
  avgShipHours   Decimal? @db.Decimal(8, 2) // 当日发货订单平均发货时效（小时）；无发货则 null
  refundRate     Decimal? @db.Decimal(5, 4) // 当日退款申请数 ÷ 当日订单数；当日无订单则 null
  returnRate     Decimal? @db.Decimal(5, 4) // 当日退货申请数 ÷ 当日订单数；当日无订单则 null
  avgRating      Decimal? @db.Decimal(3, 2) // 当日新增商品评价均分；无评价则 null
  complaintCount Int      @default(0) // 当日针对该商家商品/商家本人的举报（投诉）数
  qcPassRate     Decimal? @db.Decimal(5, 4) // 抽检合格率·暂无数据源·诚实 null（QcRecord 二期）
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([merchantId, date])
  @@index([date])
}

/// 商家信用分变动日志（履-P2）：周更 cron 每周每商家一条，factors 存算分因子明细（透明可复算）
/// 与 MerchantMetric 同范式：不建 Merchant 关系字段，merchantId 索引查询
model MerchantCreditLog {
  id         String   @id @default(uuid())
  merchantId String
  oldScore   Int // 变动前信用分
  newScore   Int // 变动后信用分
  factors    Json // 因子明细：{ windowDays, weekKey, observation, factors: { ship/refundReturn/rating/complaint/qc/tenure } }
  createdAt  DateTime @default(now())

  @@index([merchantId])
}

/// 商家处罚记录（履-P3）：四类处罚 WARNING/PRODUCT_DOWN/SHOP_SUSPEND/CLEAR_OUT
/// evidence 同时存输入证据与执行快照（涉事商品原状态清单/商家原状态），撤销按快照 CAS 恢复
/// 与 MerchantMetric/MerchantCreditLog 同范式：不建 Merchant 关系字段，merchantId 索引查询
model MerchantPunishment {
  id         String    @id @default(uuid())
  merchantId String
  type       String // WARNING(警告) / PRODUCT_DOWN(商品下架) / SHOP_SUSPEND(暂停经营) / CLEAR_OUT(标记待清退)
  reason     String // 处罚原因（幂等键成分：同商家+同类型+同原因且未撤销 → 不重复罚）
  evidence   Json? // 证据+执行快照：{ productIds?, snapshot: { prevMerchantStatus?, merchantApplied?, products?: [{id, prevStatus, applied}] }, revoke?: {...} }
  status     String    @default("ACTIVE") // ACTIVE(生效中) / REVOKED(已撤销)
  expiresAt  DateTime? // 到期时间（如暂停经营 7-30 天·到期恢复当前走人工 revoke，自动到期恢复属后续批次·诚实注释）
  operatorId String // 操作人（管理员ID；自动触发为 "SYSTEM"）
  revokedBy  String? // 撤销人
  revokedAt  DateTime? // 撤销时间
  createdAt  DateTime  @default(now())

  @@index([merchantId])
  @@index([merchantId, status])
}

// ─────────────────────────────────────────────────
// 圈主助理知识库（pgvector）
// ─────────────────────────────────────────────────

model CircleKnowledge {
  id            String   @id @default(uuid())
  circleId      String
  sourceType    String // article/post/course/file/manual/free_text
  sourceId      String?
  content       String // 知识库文本内容
  contentHash   String // MD5哈希值，用于去重
  vectorJson    String? // pgvector不可用时的JSON向量备份
  status        String   @default("active") // active/removed/pending
  addedBy       String? // 添加人ID（圈主ID或"SYSTEM"）
  addedAt       DateTime @default(now())
  updatedAt     DateTime @updatedAt
  // Layer 2: 多源知识聚合
  scope         String   @default("circle") // circle | global（典籍知识全局可见）
  qualityScore  Float? // 知识质量评分 0-1
  chunkIndex    Int? // 分块索引（0=原文，>0=子块）
  parentChunkId String? // 父块ID（子块指向原文）

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([contentHash, circleId])
  @@index([circleId, status])
  @@index([circleId, sourceType])
  @@index([scope, status])
  @@index([qualityScore])
}

model CircleKnowledgeManual {
  id         String   @id @default(uuid())
  circleId   String
  userId     String // 操作人（圈主）
  targetType String // post/article
  targetId   String
  action     String // add/remove
  createdAt  DateTime @default(now())

  @@index([circleId, createdAt])
}

model CircleKnowledgeCandidate {
  id              String   @id @default(uuid())
  circleId        String
  sourceType      String // article/post/course/file
  sourceId        String?
  content         String
  contentHash     String
  similarityScore Float? // 与已有内容的最高相似度
  similarToId     String? // 疑似重复的目标内容ID
  status          String   @default("pending") // pending/confirmed/rejected
  createdAt       DateTime @default(now())

  decisions CircleKnowledgeDedupDecision[]

  @@index([circleId, status])
}

model CircleKnowledgeDedupDecision {
  id          String   @id @default(uuid())
  candidateId String
  decision    String // override / keepBoth / keepExisting
  decidedBy   String?
  decidedAt   DateTime @default(now())
  reason      String?

  candidate CircleKnowledgeCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([decidedAt])
}

// ─────────────────────────────────────────────────
// RAG 知识引擎 Layer 3 — 知识图谱
// ─────────────────────────────────────────────────

model KnowledgeEntity {
  id        String   @id @default(uuid())
  name      String
  type      String // person / book / concept / dynasty / event / place
  aliases   Json? // 别名列表，如 ["孔子", "孔丘", "仲尼"]
  summary   String?  @db.Text
  createdAt DateTime @default(now())

  edgesFrom KnowledgeEdge[] @relation("FromEntity")
  edgesTo   KnowledgeEdge[] @relation("ToEntity")

  @@unique([name, type])
  @@index([type])
}

model KnowledgeEdge {
  id          String   @id @default(uuid())
  fromId      String
  toId        String
  relation    String // mentions / explains / refutes / cites / extends
  weight      Float    @default(1.0)
  evidence    String?  @db.Text
  knowledgeId String? // 关联的 CircleKnowledge.id
  createdAt   DateTime @default(now())

  fromEntity KnowledgeEntity @relation("FromEntity", fields: [fromId], references: [id], onDelete: Cascade)
  toEntity   KnowledgeEntity @relation("ToEntity", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId])
  @@index([toId])
  @@index([knowledgeId])
}

// ─────────────────────────────────────────────────
