  @@index([sortOrder])
}

// 诗词正文
model Poetry {
  id             String   @id @default(uuid())
  title          String // 诗词标题
  author         String // 作者
  authorId       String? // 关联诗人ID（预留）
  dynasty        String // 朝代
  form           String? // 体裁：五言绝句/七律/词/赋 等
  content        String   @db.Text // 正文（多句用换行分隔）
  pinyin         Json? // 逐句拼音数组，与正文句序对应
