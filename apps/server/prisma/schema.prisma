generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────
// 用户系统
// ─────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
  BANNED
}

enum MemberLevel {
  NONE
  MONTHLY
  QUARTERLY
  YEARLY
  LIFETIME
}

model User {
  id                   String      @id @default(uuid())
  phone                String?     @unique
  phoneHash            String?     @unique // M4 手机号确定性哈希(HMAC-SHA256)，等值查询/唯一约束用
  phoneEnc             String? // M4 手机号密文(AES-256-GCM)，展示时 decrypt+maskPhone
  email                String?     @unique
  nickname             String
  avatar               String?
  bio                  String?
  gender               Int?
  birthday             DateTime?
  memberLevel          MemberLevel @default(NONE)
  memberExpire         DateTime?
  memberAutoRenew      Boolean     @default(false) // 连续包年标记（papay 代扣就绪前=到期提醒按续费价续费）
  paymentPasswordHash  String?
  interestCategories   String[]    @default([]) // 用户兴趣品类
  identityVerified     Boolean     @default(false) // 实名认证状态
  identityVerifiedAt   DateTime? // 实名认证通过时间
  attributionSource    String      @default("PLATFORM") // 首次登录来源：PLATFORM（总站）/ STATION（分站链接）
  attributionStationId String? // 首次锁定分站ID（PLATFORM用户永远为null，STATION用户永久不可改）
  status               UserStatus  @default(ACTIVE)
  timezone             String?     @default("Asia/Shanghai") // 时区（国际化预留）
  preferredCurrency    String?     @default("CNY") // 偏好货币（国际化预留）
  notifySettings       Json? // 通知开关（JSON: {message/course/live/interact/system: bool}）
  creatorSettings      Json? // 创作者中心设置（JSON: {specialty/website/notify/privacy 等创作者偏好，与认证体系解耦）
  deletedAt            DateTime? // 软删除时间（NULL=正常），删除用户时不物理删除，仅标记此字段
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  auths                 Auth[]
  roles                 UserRole[]
  memberPurchases       MemberPurchase[]
  circles               Circle[]
  circleMembers         CircleMember[]
  posts                 Post[]
  articles              Article[]
  courses               Course[]
  courseWorks           CourseWork[]
  courseReviews         CourseReview[]
  orders                Order[]
  liveRooms             LiveRoom[]
  videos                Video[]
  paipanRecords         PaipanRecord[]
  aiAnalysisRecords     AiAnalysisRecord[]
  coupleChartsInitiated CoupleChart[]            @relation("CoupleChartInitiator")
  coupleChartsPartnered CoupleChart[]            @relation("CoupleChartPartner")
  toolRecords           ToolRecord[]
  toolFavorites         ToolFavorite[]
  toolShares            ToolShare[]
  toolPayRecords        ToolPayRecord[]
  likes                 Like[]
  comments              Comment[]
  collects              Collect[]
  notifications         Notification[]
  searchHistories       SearchHistory[]
  readingProgresses     ReadingProgress[]
  bookmarks             Bookmark[]
  station               Station?
  operator              Operator?
  stationOffline        StationOffline?
  instituteMembers      InstituteMember[] // 分院制：一人可入多院（T9-P1）
  sentReports           Report[]                 @relation("Reporter")
  feedbacks             Feedback[]
  followings            Follow[]                 @relation("Follower")
  followers             Follow[]                 @relation("FollowedUser")
  referralUsers         ReferralRelation[]       @relation("ReferredUser")
  referralRefs          ReferralRelation[]       @relation("Referrer")
  teamTaskProgresses    TeamTaskProgress[]       @relation("TeamTaskStationMaster")
  blacklistInitiators   Blacklist[]              @relation("BlacklistInitiator")
  blacklistTargets      Blacklist[]              @relation("BlacklistTarget")
  loginDevices          LoginDevice[]
  renewalRecords        RenewalRecord[]
  instituteDividends    InstituteDividend[]
  withdrawals           Withdrawal[]
  payeeAccounts         PayeeAccount[]
  referralLinks         ReferralLink[]
  coinAccount           VirtualCoinAccount?
  coinTransactions      VirtualCoinTransaction[]
  coinRecharges         VirtualCoinRecharge[]
  askedQuestions        PaidQuestion[]           @relation("QuestionAsker")
  answeredQuestions     PaidQuestion[]           @relation("QuestionAnswerer")
  audioCallsMade        AudioCallRecord[]        @relation("Caller")
  audioCallsReceived    AudioCallRecord[]        @relation("Callee")
  giftRecords           GiftRecord[]
  ebookProgresses       EbookProgress[]
  ebookBookmarks        EbookBookmark[]
  ebookNotes            EbookNote[]
  ebookPurchases        EbookPurchase[]
  ebookReviews          EbookReview[]
  ebookReadingSessions  EbookReadingSession[]
  merchant              Merchant?
  teacherCertification  TeacherCertification?

  // 赛事系统关联
  competitionRegistrations CompetitionRegistration[]
  invitedRegistrations     CompetitionRegistration[] @relation("CompetitionInviter")
  competitionScores        CompetitionScore[]

  // 账号注销
  deleteRequestedAt DateTime?
  deleteScheduledAt DateTime?

  // 青少年模式
  teenModeEnabled  Boolean @default(false)
  teenModeSettings Json?

  // 浏览历史 & 签到
  browseHistories         BrowseHistory[]
  checkIns                CheckIn[]
  dailyTasks              DailyTask[]
  competitionRankings     CompetitionRanking[]
  competitionInvitations  CompetitionInvitation[] @relation("CompetitionInviterLink")
  competitionInvitedBy    CompetitionInvitation[] @relation("CompetitionInviteeLink")
  competitionArticles     CompetitionArticle[]
  competitionTalent       CompetitionTalent?
  specialTeacher          SpecialTeacher?
  inviteCode              CompetitionInviteCode?  @relation(fields: [competitionInviteCodeId], references: [id])
  competitionInviteCodeId String?

  // 圈子关联
  CircleAnnouncement CircleAnnouncement[]
  CircleInviteCode   CircleInviteCode[]
  CircleInvitation   CircleInvitation[]   @relation("CircleInviter")
  CircleInvitedBy    CircleInvitation[]   @relation("CircleInvitee")
  CourseQa           CourseQa[]
  ClassicReadingNote ClassicReadingNote[]
  institutes         Institute[]

  @@index([phone])
  @@index([memberLevel])
  @@index([status, createdAt])
  @@index([attributionSource, attributionStationId])
  @@index([attributionStationId])
}

model Auth {
  id         String   @id @default(uuid())
  userId     String
  provider   String // PASSWORD, WECHAT, PHONE
  openId     String?  @unique
  unionId    String?
  credential String? // password hash or access_token
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
}

enum RoleType {
  SUPER_ADMIN
  OPERATION_ADMIN
  CONTENT_AUDITOR
  FINANCE_ADMIN
  CUSTOMER_SERVICE
  GOODS_AUDITOR
  CIRCLE_OWNER
  LECTURER
  STATION_MASTER
  OPERATOR
  STATION_OFFLINE_OWNER
  INSTITUTE_MEMBER
  INSTITUTE_ADMIN
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleType  RoleType
  bindId    String? // 关联的业务ID（圈子ID/分站ID等）
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleType, bindId])
  @@index([roleType])
}

model Permission {
  id        String   @id @default(uuid())
  key       String   @unique
  label     String
  module    String
  createdAt DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String   @id @default(uuid())
  roleType     RoleType
  permissionId String

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleType, permissionId])
  @@index([roleType])
}

model MemberPurchase {
  id         String      @id @default(uuid())
  userId     String
  memberType MemberLevel
  amount     Decimal     @db.Decimal(10, 2)
  sourcePage String? // 来源页面追踪
  referrerId String?
  paidAt     DateTime    @default(now())
  expireAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────
// 推荐关系
// ─────────────────────────────────────────────────

enum ReferrerType {
  STATION_MASTER
  OPERATOR
  USER
}

model ReferralRelation {
  id             String       @id @default(uuid())
  userId         String // 被推荐人
  referrerId     String // 推荐人
  referrerType   ReferrerType
  sourceChannel  String? // 渠道来源
  relationStatus String       @default("ACTIVE") // ACTIVE, DISABLED
  createdAt      DateTime     @default(now())

  user     User @relation("ReferredUser", fields: [userId], references: [id], onDelete: Cascade)
  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([userId, referrerId])
  @@index([referrerId])
  @@index([userId, relationStatus])
}

model Follow {
  id             String   @id @default(uuid())
  userId         String
  followedUserId String
  createdAt      DateTime @default(now())

  user         User @relation("Follower", fields: [userId], references: [id], onDelete: Cascade)
  followedUser User @relation("FollowedUser", fields: [followedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, followedUserId])
  @@index([followedUserId])
  @@index([userId, createdAt])
  @@index([followedUserId, createdAt])
}

// 用户黑名单
model Blacklist {
  id            String   @id @default(uuid())
  userId        String // 拉黑操作人
  blockedUserId String // 被拉黑用户
  reason        String? // 拉黑原因
  createdAt     DateTime @default(now())

  user        User @relation("BlacklistInitiator", fields: [userId], references: [id], onDelete: Cascade)
  blockedUser User @relation("BlacklistTarget", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedUserId])
  @@index([userId])
  @@index([blockedUserId])
}

// 登录设备记录
model LoginDevice {
  id         String   @id @default(uuid())
  userId     String
  deviceName String? // 设备名称（浏览器UA解析）
  deviceType String? // WEB, IOS, ANDROID, MINIPROGRAM
  ipAddress  String? // 最近登录IP
  location   String? // IP归属地
  isCurrent  Boolean  @default(false)
  lastLogin  DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isCurrent])
  @@index([userId, lastLogin])
}

// ─────────────────────────────────────────────────
// 圈子系统
// ─────────────────────────────────────────────────

enum CircleType {
  FREE
  PAID
  YEARLY
}

enum CircleStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum CircleMemberRole {
  OWNER
  PARTNER
  ADMIN
  GUEST
  VOLUNTEER
  MEMBER
}

model Circle {
  id                  String       @id @default(uuid())
  name                String
  intro               String
  cover               String?
  tags                String[]
  type                CircleType   @default(FREE)
  needApproval        Boolean      @default(false) // 加入是否需圈主审批（仅免费圈生效；付费圈走支付不审批）
  price               Decimal      @default(0) @db.Decimal(10, 2)
  originalPrice       Decimal?     @db.Decimal(10, 2)
  depositAmount       Decimal      @default(0) @db.Decimal(10, 2)
  ownerId             String
  memberCount         Int          @default(0)
  postCount           Int          @default(0)
  categoryLevel1      String? // 一级品类
  categoryLevel2      String? // 二级品类
  status              CircleStatus @default(PENDING)
  stationId           String? // 分站数据隔离（null = 平台级）
  deletedAt           DateTime? // 软删除
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  recommendedEbookIds Json?

  owner               User                  @relation(fields: [ownerId], references: [id])
  station             Station?              @relation(fields: [stationId], references: [id])
  members             CircleMember[]
  posts               Post[]
  articles            Article[]
  courses             Course[]
  videos              Video[]
  products            Product[]
  liveRooms           LiveRoom[]
  paidQuestions       PaidQuestion[]
  bot                 CircleBot?
  knowledgeItems      CircleKnowledge[]
  revenueRecords      CircleRevenueRecord[]
  announcements       CircleAnnouncement[]
  inviteCodes         CircleInviteCode[]
  invitations         CircleInvitation[]
  institute           Institute?
  boardGroup          InstituteBoardGroup?
  circleRevenueSplits CircleRevenueSplit[]
  circleGuestEarnings CircleGuestEarning[]
  events              CircleEvent[]

  @@index([ownerId])
  @@index([status])
  @@index([status, memberCount])
  @@index([stationId])
}

model CircleMember {
  id                     String           @id @default(uuid())
  circleId               String
  userId                 String
  role                   CircleMemberRole @default(MEMBER)
  joinedAt               DateTime         @default(now())
  expireAt               DateTime?
  questionPriceCoin      Int              @default(0) // 提问价格（币），0=不接提问
  questionTimeoutHours   Int              @default(72) // 超时退款时间（小时）
  callPricePerMinuteCoin Int              @default(0) // 连麦价格（币/分钟），0=不接连麦
  callAvailableHours     Json? // 可接连麦时段 [{day, start, end}]

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([userId])
  @@index([userId, joinedAt])
}

model CircleAnnouncement {
  id        String   @id @default(uuid())
  circleId  String
  userId    String
  content   String
  isTop     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([circleId, isTop, createdAt])
  @@index([userId])
}

model CircleAnnouncementRead {
  id             String   @id @default(uuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@index([userId])
}

// ─────────────────────────────────────────────────
// 圈子治理（圈规/违规阶梯/申诉/自动治理配置/权限矩阵·2026-07-10）
// 无 @relation（同 CircleAnnouncementRead 风格）·建表见 prisma/manual/2026-07-10-governance.sql
// ─────────────────────────────────────────────────

model CircleRule {
  id          String    @id @default(uuid())
  circleId    String
  sortOrder   Int       @default(0)
  text        String
  templateKey String? // 官方模板条目键（一键套用幂等去重·null=手动新增）
  editedAt    DateTime? // 手动修改时间（非空=模板再次套用不覆盖）
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([circleId, sortOrder])
}

model CircleRuleAck {
  id            String   @id @default(uuid())
  circleId      String
  userId        String
  ruleIds       Json // 确认时条文 id 列表
  rulesSnapshot Json // 确认时条文文本快照（违规处理时可引用当时版本）
  ackAt         DateTime @default(now())

  @@unique([circleId, userId])
  @@index([userId])
}

model CircleViolation {
  id          String    @id @default(uuid())
  circleId    String
  userId      String // 被处理成员
  type        String // WARNING / MUTE / REMOVE
  status      String    @default("ACTIVE") // ACTIVE / EXPIRED(到期清零·解禁) / LIFTED(圈主提前解除) / REVOKED(申诉成立撤销)
  ruleId      String? // 违反的圈规条文 id
  ruleText    String? // 条文快照
  reason      String? // 处理说明（移出必填）
  evidence    String? // 涉及内容摘录（证据·仅本人与管理侧可见）
  contentType String? // POST / COMMENT …
  contentId   String?
  operatorId  String // 处理人 userId（自动升级时为 "system"）
  auto        Boolean   @default(false) // 满 N 次警告自动升级产生
  strikeCount Int       @default(0) // 处理时点累计警告数（通知进度条 x/N）
  expiresAt   DateTime? // WARNING=清零时间(+90天) / MUTE=解禁时间 / REMOVE=null 禁入直至解除
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([circleId, userId, type, status])
  @@index([circleId, createdAt])
  @@index([userId, createdAt])
  @@index([type, status, expiresAt])
}

model CircleAppeal {
  id          String    @id @default(uuid())
  violationId String    @unique // 每次处理仅可申诉一次
  circleId    String
  userId      String
  content     String // 申诉理由
  status      String    @default("PENDING") // PENDING / UPHELD(成立·撤销处理) / REJECTED(不成立)
  resolution  String? // 仲裁说明（同步给成员）
  reviewerId  String? // 平台仲裁人（48h 超时自动裁决为 "system"）
  deadlineAt  DateTime // 提交 +48h 答复承诺
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, deadlineAt])
  @@index([circleId, createdAt])
  @@index([userId])
}

model CircleGovernanceConfig {
  id                      String   @id @default(uuid())
  circleId                String   @unique
  requireRuleAck          Boolean  @default(true) // 新成员加入须逐条确认圈规
  warningThreshold        Int      @default(3) // 满 N 次警告自动禁言
  warningResetDays        Int      @default(90) // 警告 N 天自动清零
  muteDays                Int      @default(7) // 自动/默认禁言天数（1/3/7/30）
  removeBanRejoin         Boolean  @default(true) // 移出后禁止重新加入（可单独解除）
  newMemberReviewEnabled  Boolean  @default(false) // 新成员 7 天发帖先审（TODO 发帖链路接入）
  newMemberReviewDays     Int      @default(7)
  sensitiveWordsEnabled   Boolean  @default(true)
  sensitiveWords          Json? // 圈内自定义敏感词 string[]（命中转人工审核 AUDITING）
  postIntervalSeconds     Int      @default(0) // 刷屏限制·同成员发帖最小间隔秒（0=关）
  reportAutoHideEnabled   Boolean  @default(true) // 被举报满 N 自动隐藏（TODO 举报链路接入）
  reportAutoHideThreshold Int      @default(3)
  rolePermissions         Json? // 权限矩阵覆盖 {ADMIN:{key:bool},PARTNER:{...},GUEST:{...}}·锁定项忽略
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// ─────────────────────────────────────────────────
// 帖子
// ─────────────────────────────────────────────────

model CircleInviteCode {
  id        String    @id @default(uuid())
  circleId  String
  userId    String
  code      String    @unique
  maxUses   Int       @default(0) // 0=不限次数
  useCount  Int       @default(0)
  expiredAt DateTime?
  createdAt DateTime  @default(now())

  circle      Circle             @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitations CircleInvitation[]

  @@index([circleId, userId])
  @@index([code])
}

model CircleInvitation {
  id           String   @id @default(uuid())
  circleId     String
  inviterId    String
  inviteeId    String
  inviteCodeId String?
  joinedAt     DateTime @default(now())
  createdAt    DateTime @default(now())

  circle     Circle            @relation(fields: [circleId], references: [id], onDelete: Cascade)
  inviter    User              @relation("CircleInviter", fields: [inviterId], references: [id])
  invitee    User              @relation("CircleInvitee", fields: [inviteeId], references: [id])
  inviteCode CircleInviteCode? @relation(fields: [inviteCodeId], references: [id])

  @@unique([circleId, inviteeId])
  @@index([circleId, inviterId])
  @@index([inviteCodeId])
  @@index([inviteeId])
}

enum PostType {
  TEXT
  IMAGE
  VIDEO
  FILE
  LINK
  AUDIO
}

model Post {
  id             String    @id @default(uuid())
  circleId       String
  userId         String
  type           PostType  @default(TEXT)
  title          String?
  content        String
  images         String[]  @default([])
  videoUrl       String?
  fileUrl        String?
  linkUrl        String?
  audioUrl       String?
  audioDuration  Int?
  attachments    Json      @default("[]") // 帖子附件 [{name,size,url}]（列由 manual/2026-07-11-post-attachments.sql 添加·代码经原生 SQL 访问）
  isEssence      Boolean   @default(false)
  isTop          Boolean   @default(false)
  isPushHome     Boolean   @default(false) // 圈主推送到首页（需审核）
  auditStatus    String    @default("PENDING") // PENDING, APPROVED, REJECTED（推首页审核状态）
  auditReason    String? // 审核驳回原因
  isRecommended  Boolean   @default(false) // 审核通过后是否主推（人工/AI复审标注）
  categoryLevel1 String? // 一级品类
  categoryLevel2 String? // 二级品类
  status         String    @default("PUBLISHED") // PUBLISHED, DRAFT, AUDITING, HIDDEN
  scheduledAt    DateTime? // 定时发布时间
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([circleId, createdAt])
  @@index([circleId, status, createdAt])
  @@index([circleId, isPushHome, auditStatus, createdAt])
  @@index([userId])
  @@index([isRecommended, auditStatus, createdAt])
}

// ─────────────────────────────────────────────────
// 内容管理（后台管理用）
// ─────────────────────────────────────────────────

model Content {
  id             String    @id @default(uuid())
  title          String
  type           String    @default("ARTICLE") // ARTICLE, POEM, CLASSIC
  author         String?
  dynasty        String?
  excerpt        String?
  body           String // 正文/富文本HTML
  cover          String? // 封面图URL
  tags           String[]
  viewCount      Int       @default(0)
  likeCount      Int       @default(0)
  categoryLevel1 String? // 一级品类
  categoryLevel2 String? // 二级品类
  status         String    @default("PUBLISHED") // PUBLISHED, DRAFT, PENDING, APPROVED, REJECTED
  auditReason    String? // 审核驳回原因
  scheduledAt    DateTime? // 定时发布时间
  stationId      String? // 分站数据隔离（null = 平台级）
  deletedAt      DateTime? // 软删除
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  station Station? @relation(fields: [stationId], references: [id])

  @@index([type, createdAt])
  @@index([status])
  @@index([status, viewCount])
  @@index([status, likeCount, viewCount])
  @@index([stationId])
  @@index([categoryLevel1, status])
  @@index([categoryLevel2, status])
}

// ─────────────────────────────────────────────────
// 文章系统
// ─────────────────────────────────────────────────

model Article {
  id             String    @id @default(uuid())
  circleId       String
  userId         String
  title          String
  titleEn        String? // 英文标题（国际化预留）
  content        String // 富文本HTML
  contentEn      String? // 英文正文（国际化预留）
  cover          String?
  excerpt        String?
  excerptEn      String? // 英文摘要（国际化预留）
  tags           String[]
  isPushHome     Boolean   @default(false)
  auditStatus    String    @default("PENDING") // PENDING, APPROVED, REJECTED
  visibility     String    @default("CIRCLE_ONLY") // 开放范围：CIRCLE_ONLY=仅本圈 / PLATFORM=全平台（需审核通过才对外可见）
  scheduledAt    DateTime? // 定时发布时间
  viewCount      Int       @default(0)
  likeCount      Int       @default(0)
  collectCount   Int       @default(0)
  commentCount   Int       @default(0)
  categoryLevel1 String? // 一级品类
  categoryLevel2 String? // 二级品类
  stationId      String? // 分站数据隔离（null = 平台级）
  deletedAt      DateTime? // 软删除
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  circle     Circle             @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  station    Station?           @relation(fields: [stationId], references: [id])
  recommends ArticleRecommend[]

  @@index([circleId, createdAt])
  @@index([isPushHome, auditStatus])
  @@index([userId, createdAt])
  @@index([stationId])
  @@index([auditStatus, createdAt])
  @@index([circleId, auditStatus, createdAt])
}

model ArticleRecommend {
  id            String  @id @default(uuid())
  articleId     String
  recommendType String // CIRCLE, COURSE, PRODUCT, PAIPAN, BOT
  targetId      String
  title         String?
  cover         String?
  sortOrder     Int     @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

// ─────────────────────────────────────────────────
// 内容审核记录 — 完整审核链路追踪
// 机器初审 → 人工/AI复审 → 主推标注
// ─────────────────────────────────────────────────

model ContentAuditRecord {
  id          String  @id @default(uuid())
  contentType String // ARTICLE / POST / COURSE / VIDEO / LIVE
  contentId   String
  circleId    String? // 来源圈子
  submitterId String // 提交人（圈主）
  auditMode   String  @default("PRE_PUBLISH") // PRE_PUBLISH（先审后发）/ POST_PUBLISH（先发后审）

  // 机器初审
  machineStatus  String    @default("PENDING") // PENDING / PASSED / REJECTED
  machineResult  String? // 机器审核结果详情（敏感词命中、违规类型等）
  machineAuditAt DateTime?
  machineAuditBy String? // "SYSTEM" 或具体机器人标识

  // 人工复审（或AI复审）
  humanAuditorId String? // 审核员用户ID
  humanStatus    String    @default("PENDING") // PENDING / PASSED / REJECTED
  humanResult    String? // 审核评语/驳回原因
  humanAuditAt   DateTime?

  // AI复审（独立AI机器人二次审核）
  aiReauditEnabled Boolean   @default(false) // 是否启用AI复审
  aiReauditStatus  String? // PENDING / PASSED / REJECTED
  aiReauditResult  String? // AI复审结果详情
  aiReauditAt      DateTime?

  // 主推标注
  isRecommended Boolean   @default(false) // 是否平台主推
  recommendedAt DateTime?
  recommendedBy String? // 标注人

  // 最终状态
  finalStatus  String    @default("PENDING") // PENDING / APPROVED / REJECTED / WITHDRAWN
  rejectReason String? // 最终驳回原因（圈主可见）
  finishedAt   DateTime?

  deletedAt DateTime? // 软删除
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([contentType, contentId, createdAt])
  @@index([contentType, contentId])
  @@index([submitterId])
  @@index([humanAuditorId])
  @@index([finalStatus])
  @@index([isRecommended, finalStatus, createdAt])
  @@index([circleId, createdAt])
}

// ─────────────────────────────────────────────────
// 课程系统
// ─────────────────────────────────────────────────

enum CourseType {
  VIDEO
  AUDIO
  TEXT
  EBOOK
  COMBO
}

model Course {
  id             String     @id @default(uuid())
  circleId       String?
  userId         String // 创建者
  title          String
  titleEn        String? // 英文标题（国际化预留）
  cover          String?
  intro          String?
  introEn        String? // 英文简介（国际化预留）
  type           CourseType @default(VIDEO)
  price          Decimal    @default(0) @db.Decimal(10, 2)
  originalPrice  Decimal?   @db.Decimal(10, 2)
  tags           String[]   @default([])
  studentCount   Int        @default(0)
  categoryLevel1 String? // 一级品类
  categoryLevel2 String? // 二级品类
  auditStatus    String     @default("PENDING")
  visibility     String     @default("CIRCLE_ONLY") // 开放范围：CIRCLE_ONLY=仅本圈 / PLATFORM=全平台（需审核通过才对外可见）
  detailImages   String[]   @default([]) // 课程介绍详情图（最多6张·展示在课程详情页介绍区·V0 publish-course）
  memberFree     Boolean    @default(false) // 会员专属精品课：有效会员免费学习（2026-07-03 会员权益拍板）
  courseOrigin   String? // 课程来源标识：INSTITUTE_LECTURE=研究院大师讲座归档（研-P1·分享回放沉淀为付费知识库）；null=普通课程
  validityDays   Int        @default(0) // 购买后有效期（天），0=永久
  scheduledAt    DateTime? // 定时发布时间
  scheduledOnAt  DateTime? // 定时上架时间（到点 cron 翻转 auditStatus→APPROVED 并清空·2026-07-11 后台课程编辑器重做）
  scheduledOffAt DateTime? // 定时下架时间（到点 cron 翻转 auditStatus→DRAFT 并清空）
  stationId      String? // 分站数据隔离（null = 平台级）
  deletedAt      DateTime? // 软删除
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  circle     Circle?          @relation(fields: [circleId], references: [id])
  user       User             @relation(fields: [userId], references: [id])
  station    Station?         @relation(fields: [stationId], references: [id])
  chapters   CourseChapter[]
  progresses CourseProgress[]
  works      CourseWork[]
  reviews    CourseReview[]
  qas        CourseQa[]
  liveRooms  LiveRoom[]

  @@index([circleId])
  @@index([auditStatus])
  @@index([auditStatus, studentCount])
  @@index([userId, createdAt])
  @@index([stationId])
  @@index([type, auditStatus])
  @@index([circleId, auditStatus, createdAt])
  @@index([courseOrigin])
}

model CourseChapter {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  content   String? // 视频URL/音频URL/文本内容
  mediaUrl  String?
  duration  Int? // 秒
  sortOrder Int      @default(0)
  freeTrial Boolean  @default(false)
  createdAt DateTime @default(now())

  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progresses CourseProgress[]
  works      CourseWork[]
  CourseQa   CourseQa[]

  @@index([courseId, sortOrder])
}

model CourseProgress {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  chapterId String
  progress  Float    @default(0) // 0-100
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  chapter CourseChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([userId, courseId])
}

model CourseWork {
  id        String   @id @default(uuid())
  courseId  String
  chapterId String
  userId    String
  content   String
  score     Float?
  feedback  String?
  createdAt DateTime @default(now())

  chapter CourseChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chapterId, userId])
  @@index([courseId])
}

// 课程问答
model CourseQa {
  id         String    @id @default(uuid())
  courseId   String
  chapterId  String?
  userId     String
  question   String
  answer     String?
  answeredBy String? // 回答者ID（讲师/管理员）
  tags       String[]  @default([]) // AI自动分类标签
  status     String    @default("PENDING") // PENDING, ANSWERED, CLOSED
  createdAt  DateTime  @default(now())
  answeredAt DateTime?
  updatedAt  DateTime  @updatedAt

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapter CourseChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId, status])
  @@index([chapterId])
  @@index([userId])
}

// ─────────────────────────────────────────────────
// 课程组合包 / 商品组合 — 支持打包销售和打包赠送
// ─────────────────────────────────────────────────

enum BundleType {
  FREE_GIFT // 赠送包（分站/运营商专属免费福利）
  PAID_COMBO // 付费组合（打包销售）
  MEMBER_BENEFIT // 会员权益包
}

enum BundleTarget {
  STATION // 分站站长
  OPERATOR // 运营商
  MEMBER // 会员
  PUBLIC // 公开销售
}

model CourseBundle {
  id            String       @id @default(uuid())
  name          String // 组合包名称，如"站长专属入门课包"
  cover         String? // 封面图
  intro         String? // 简介
  type          BundleType   @default(FREE_GIFT)
  target        BundleTarget @default(PUBLIC)
  originalPrice Decimal?     @db.Decimal(10, 2) // 原价（展示用）
  sellPrice     Decimal?     @db.Decimal(10, 2) // 售价（PAID_COMBO时有效）
  sortOrder     Int          @default(0)
  status        String       @default("ACTIVE") // ACTIVE / DISABLED
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items         CourseBundleItem[]
  stationAccess StationBundleAccess[]

  @@index([type, target])
  @@index([status])
  @@index([target, type, status])
}

model CourseBundleItem {
  id        String   @id @default(uuid())
  bundleId  String
  itemType  String   @default("COURSE") // COURSE / PRODUCT / EBOOK
  itemId    String // 课程ID / 商品ID / 电子书ID
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  bundle CourseBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([bundleId, itemType, itemId])
  @@index([bundleId, sortOrder])
}

// 分站/运营商的组合包访问权限（记录谁领取了哪些免费包）
model StationBundleAccess {
  id         String   @id @default(uuid())
  bundleId   String
  stationId  String? // 分站ID
  operatorId String? // 运营商ID
  createdAt  DateTime @default(now())

  bundle CourseBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([bundleId, stationId])
  @@unique([bundleId, operatorId])
  @@index([stationId])
  @@index([operatorId])
}

// ─────────────────────────────────────────────────
// 商城系统
// ─────────────────────────────────────────────────

enum SupplierType {
  PLATFORM
  CIRCLE_OWNER
  STATION_OFFLINE
  CERTIFIED_MERCHANT
}

model Product {
  id             String       @id @default(uuid())
  circleId       String?
  userId         String? // 供应商
  title          String
  titleEn        String? // 英文标题（国际化预留）
  categoryId     String?
  intro          String?
  introEn        String? // 英文简介（国际化预留）
  detail         String // 详情HTML
  detailEn       String? // 英文详情（国际化预留）
  images         String[]     @default([])
  videoUrl       String?
  tags           String[]     @default([])
  sceneTags      String[]     @default([]) // 场景标签（销售视角·白名单七值：乔迁新居/合婚嫁娶/开业大吉/本命年/学业考试/长辈寿诞/节气时令）供-P1
  price          Decimal      @db.Decimal(10, 2)
  originalPrice  Decimal?     @db.Decimal(10, 2) // 原始标价，永不随活动变化
  commissionRate Decimal?     @db.Decimal(5, 4) // 逐品站长推广佣金率（0-1小数·空=用类型默认 CommissionConfig.rateA）佣-V2-P1
  stock          Int          @default(0)
  salesCount     Int          @default(0)
  isPlatform     Boolean      @default(true)
  supplierType   SupplierType @default(PLATFORM)
  categoryLevel1 String? // 一级品类
  categoryLevel2 String? // 二级品类
  status         String       @default("PENDING") // PENDING, ON_SALE, OFF_SHELF
  stationId      String? // 分站数据隔离（null = 平台级）
  deletedAt      DateTime? // 软删除
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  circle  Circle?         @relation(fields: [circleId], references: [id])
  station Station?        @relation(fields: [stationId], references: [id])
  skus    ProductSku[]
  reviews ProductReview[]

  @@index([categoryId])
  @@index([status])
  @@index([status, salesCount])
  @@index([stationId])
  @@index([status, createdAt])
  @@index([circleId])
  @@index([supplierType, status])
}

model ProductSku {
  id        String   @id @default(uuid())
  productId String
  specs     Json     @default("{}") // { 规格名: 规格值 }
  price     Decimal  @db.Decimal(10, 2)
  stock     Int      @default(0)
  skuCode   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ─────────────────────────────────────────────────
// 订单与优惠券
// ─────────────────────────────────────────────────

enum OrderType {
  MEMBER
  COURSE
  PRODUCT
  CIRCLE_JOIN
  CIRCLE_RENEW
  STATION_MASTER
  OPERATOR
  BOT_SERVICE
  PAIPAN
  LIVESTREAM
  BUNDLE
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  REFUNDED
  CANCELLED
}

// 【分区候选】P2阶段按月分区(createdAt)，分片键userId，365天后归档
model Order {
  id                 String      @id @default(uuid())
  userId             String
  type               OrderType
  targetId           String // 购买目标ID（课程ID/商品ID等）
  skuId              String?
  quantity           Int         @default(1) // 购买数量（取消订单按此恢复库存，避免多件订单只回 1 件）
  amount             Decimal     @db.Decimal(10, 2)
  payAmount          Decimal?    @db.Decimal(10, 2) // 实付金额
  originalAmount     Decimal?    @db.Decimal(10, 2) // 原始标价
  couponId           String?
  promotionType      String? // 活动来源类型：FLASH_SALE/GROUP_BUY/DISCOUNT
  promotionId        String? // 关联的活动ID
  merchantId         String? // 商家ID（商家商品订单，用于分佣和数据隔离）
  addressId          String? // 收货地址ID（实物订单，引用 ShippingAddress）
  shippingInfo       Json? // 下单时收货地址快照 {name,phone,province,city,district,detail}（地址表可改可删，订单存快照最可靠）
  groupId            String? // 拼团组ID（promotionType=GROUP_BUY 时标识具体团；支付成功后据此创建拼团参与者）
  selfDiscount       Decimal?    @db.Decimal(10, 2) // 站长自购立减金额（下单时按佣金比例直接立减·不产生佣金·用于"自购已省"统计）
  giftCardMeta       Json? // 白标贺卡任务（供-P2）：{fromName 从业者署名, blessing 祝语·可选, qrRef 名片码内容}·归因实物订单下单时自动组装·全局开关 ConfigSystem shop.gift_card.enabled 默认开
  status             OrderStatus @default(PENDING)
  referrerId         String? // 永久推荐人
  tempReferrerId     String? // 临时推荐人
  tempRefSubjectType String? // 临时归因命中的渠道主体类型（佣-V2-P2）：STATION / CIRCLE / OFFLINE_STATION·NULL=非渠道点击归因（现行 dto 传入/无临时归因）·分佣时据此路由受益人
  sourceContentType  String? // 内容来源类型（佣-V2-P3·设计§3.1）：LIVE / ARTICLE / VIDEO·纯记录下单入口的内容场景（不改金额/库存/支付）
  sourceContentId    String? // 内容来源ID（LiveRoom.id / Article.id / Video.id·与 sourceContentType 成对出现）
  payMethod          String? // WECHAT, ALIPAY
  payTransactionId   String?
  paidAt             DateTime?
  shippedAt          DateTime?
  completedAt        DateTime?
  refundedAt         DateTime?
  frozenAmount       Decimal?    @db.Decimal(10, 2) // 冻结金额
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user          User            @relation(fields: [userId], references: [id])
  ToolPayRecord ToolPayRecord[]

  @@unique([payTransactionId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([referrerId])
  @@index([tempReferrerId])
  @@index([type, status])
  @@index([userId, type, targetId, status])
  @@index([userId, status])
  @@index([type])
  @@index([userId, type, status, createdAt])
  @@index([merchantId, status])
}

enum CouponType {
  FULL_REDUCE
  DISCOUNT
  NO_THRESHOLD
}

model Coupon {
  id             String     @id @default(uuid())
  type           CouponType
  name           String? // 优惠券名称
  value          Decimal    @db.Decimal(10, 2) // 兼容旧字段: 满减金额/折扣率
  discountAmount Decimal?   @db.Decimal(10, 2) // 满减金额（新字段）
  discountRate   Decimal?   @db.Decimal(5, 4) // 折扣率（新字段，如0.85=85折）
  minAmount      Decimal?   @db.Decimal(10, 2) // 最低使用金额
  scope          String     @default("ALL") // ALL, PRODUCT, COURSE, CIRCLE, MEMBER
  scopeId        String? // 指定商品/课程ID
  totalCount     Int        @default(-1) // -1=不限量
  usedCount      Int        @default(0)
  status         String     @default("ACTIVE") // ACTIVE, EXPIRED, DISABLED
  validStart     DateTime
  validEnd       DateTime
  createdAt      DateTime   @default(now())

  userCoupons UserCoupon[]

  @@index([status])
  @@index([validStart, validEnd])
}

model UserCoupon {
  id        String    @id @default(uuid())
  userId    String
  couponId  String
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([userId, used])
  @@index([couponId])
}

// ─────────────────────────────────────────────────
// 商品评价
// ─────────────────────────────────────────────────

model ProductReview {
  id        String    @id @default(uuid())
  productId String
  userId    String
  orderId   String?
  rating    Int // 1-5 星
  content   String
  images    String[]  @default([])
  status    String    @default("PUBLISHED") // PUBLISHED, HIDDEN
  reply     String? // 管理员回复
  repliedAt DateTime?
  createdAt DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([userId])
}

// ─────────────────────────────────────────────────
// 课程评价
// ─────────────────────────────────────────────────

model CourseReview {
  id        String   @id @default(uuid())
  courseId  String
  userId    String
  orderId   String?
  rating    Int // 1-5 星
  content   String
  reply     String? // 管理员回复
  status    String   @default("PUBLISHED") // PUBLISHED, HIDDEN
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
  @@index([userId])
}

// ─────────────────────────────────────────────────
// 讲师认证 — 线上课程上传资格审核（线上老师，区别于线下驿站签约讲师）
// 一人一条，审核通过(APPROVED)后方可发布/管理课程
// ─────────────────────────────────────────────────

model TeacherCertification {
  id            String    @id @default(uuid())
  userId        String    @unique // 一人一条（防重复申请）
  realName      String // 讲师署名（资历展示用，非证件信息）
  title         String? // 申请头衔/职称
  intro         String? // 教学背景/资历简介
  credentials   String[]  @default([]) // 资质证明材料图片URL
  status        String    @default("PENDING") // PENDING / APPROVED / REJECTED
  verifiedTitle String? // 审核通过后授予的认证头衔
  rejectReason  String? // 驳回原因
  reviewedAt    DateTime? // 审核时间
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ─────────────────────────────────────────────────
// 物流追踪
// ─────────────────────────────────────────────────

model OrderLogistics {
  id           String   @id @default(uuid())
  orderId      String   @unique
  company      String? // 物流公司
  logisticsNo  String? // 物流单号
  contactName  String? // 联系人
  contactPhone String? // 联系电话
  province     String? // 省
  city         String? // 市
  district     String? // 区
  address      String? // 详细地址
  zipCode      String? // 邮编
  status       String   @default("PENDING") // PENDING, SHIPPED, IN_TRANSIT, DELIVERED, SIGNED
  trackingData Json? // 物流追踪轨迹 [{time, status, desc}]
  remark       String? // 备注
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orderId])
}

// ─────────────────────────────────────────────────
// 直播系统
// ─────────────────────────────────────────────────

enum LiveHostType {
  CIRCLE_OWNER
  STATION_MASTER
}

enum LiveStatus {
  WAITING
  LIVING
  ENDED
  REPLAY
}

model LiveRoom {
  id               String       @id @default(uuid())
  circleId         String?
  userId           String // 发起人
  title            String
  titleEn          String? // 英文标题（国际化预留）
  cover            String?
  hostType         LiveHostType @default(CIRCLE_OWNER)
  hostUserId       String // 主播
  coHostIds        String[]     @default([])
  pushUrl          String? // 腾讯云推流地址
  pullUrl          String? // CDN播放地址
  trtcRoomId       String? // TRTC房间ID
  imGroupId        String?
  status           LiveStatus   @default(WAITING)
  quality          String       @default("basic") // 画质档：basic(标清·免费·不转码) / hd(720p转码) / uhd(1080p转码)
  orientation      String       @default("portrait") // 画面方向：portrait=手机竖屏 / landscape=OBS横屏推流（董事长2026-07-10要求·观看端按此渲染）
  viewCount        Int          @default(0)
  chargeType       String       @default("FREE") // FREE, PAID, CIRCLE_ONLY, MEMBER_FREE
  chargePrice      Decimal?     @db.Decimal(10, 2)
  startTime        DateTime?
  endTime          DateTime?
  replayUrl        String?
  courseId         String? // 关联课程（课程直播联动）
  auditStatus      String       @default("APPROVED") // 平台审核态：PENDING/APPROVED/REJECTED（CIRCLE_ONLY 默认 APPROVED；PLATFORM 建审核记录置 PENDING）
  auditReason      String? // 审核驳回原因
  visibility       String       @default("CIRCLE_ONLY") // 开放范围：CIRCLE_ONLY=仅本圈 / PLATFORM=全平台（需审核通过才进公共池）
  replayVisibility String       @default("CIRCLE_ONLY") // 回放开放范围：CIRCLE_ONLY / PLATFORM
  replayCharge     Boolean      @default(false) // 回放是否对圈外收费
  replayChapters   Json? // 回放章节点（#21·主播标注）：[{t 秒, title}]。代码读写走 $queryRaw 绕过 generate（见 manual/2026-07-11-growth-batch.sql）
  stationId        String? // 分站数据隔离（null = 平台级）
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  circle      Circle?         @relation(fields: [circleId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
  course      Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  station     Station?        @relation(fields: [stationId], references: [id])
  products    LiveProduct[]
  giftRecords GiftRecord[]
  mics        LiveMic[]
  slides      LiveSlide[]
  mutedUsers  LiveMutedUser[]
  flashSales  LiveFlashSale[]
  auditLogs   LiveAuditLog[]

  @@index([userId])
  @@index([status])
  @@index([status, viewCount])
  @@index([circleId])
  @@index([circleId, status])
  @@index([courseId])
  @@index([stationId])
  @@index([status, startTime])
  @@index([hostUserId, status])
}

/// 直播画质时长包 — 主播购买高清/超清转码时长额度（分档商业化 C5·1元=10国学币）
model LiveQualityPackage {
