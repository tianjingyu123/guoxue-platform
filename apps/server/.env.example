DATABASE_URL="postgresql://guoxue:guoxue123@localhost:5432/guoxue"
JWT_SECRET="change-me-in-production"
PORT=3000

# Redis 缓存（排盘模块使用）
REDIS_URL="redis://localhost:6379"

# DeepSeek AI 解析（排盘 AI 分析）
DEEPSEEK_API_KEY="your-deepseek-api-key"

# ========== 文件存储（二选一） ==========
# 方式一：本地存储（默认，无需配置）
# 方式二：腾讯云 COS（取消注释并填入凭证后自动切换）

# COS_SECRET_ID="your-cos-secret-id"
# COS_SECRET_KEY="your-cos-secret-key"
# COS_BUCKET="your-bucket-name-1250000000"
# COS_REGION="ap-guangzhou"
# COS_CDN_BASE="https://cdn.example.com"  # 可选：CDN 加速域名

# ========== 微信开放平台 ==========
# 用于 H5 OAuth 登录和小程序登录（申请地址：https://open.weixin.qq.com）
# WECHAT_APP_ID="your-wechat-app-id"
# WECHAT_APP_SECRET="your-wechat-app-secret"

# ========== 腾讯云 IM 即时通讯 ==========
# 用于聊天、直播弹幕、客服等（申请地址：https://console.cloud.tencent.com/im）
# IM_APP_ID="1400000000"
# IM_ADMIN_KEY="your-im-admin-key"
# IM_ADMIN_ID="administrator"  # 可选：管理员账号标识
