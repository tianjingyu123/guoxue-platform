# ═══════════════════════════════════════════════
# 国学传统文化综合平台 — 环境变量配置
# ═══════════════════════════════════════════════
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ═══════════ 基础设施 ═══════════
DATABASE_URL="postgresql://guoxue:guoxue123@127.0.0.1:5433/guoxue"
JWT_SECRET="change-me-in-production-use-64-char-random-string"
PORT=3000
NODE_ENV="development"

# Redis 缓存（排盘模块、短信验证码等使用）
REDIS_URL="redis://localhost:6379"

# Redis Sentinel 高可用（可选，留空则使用 REDIS_URL 直连）
# 格式: "host1:port1,host2:port2,host3:port3"
# REDIS_SENTINEL_HOSTS="sentinel1:26379,sentinel2:26379,sentinel3:26379"
# REDIS_SENTINEL_MASTER="mymaster"

# PostgreSQL 读副本（可选，留空则所有查询走主库）
# DATABASE_REPLICA_URL="postgresql://guoxue:guoxue123@replica-host:5432/guoxue"

# BullMQ 开关（测试环境可禁用，避免加载 ESM 依赖）
# BULLMQ_DISABLED="true"

# 慢查询阈值（毫秒），超过此阈值的SQL会打WARN日志
PRISMA_SLOW_QUERY_MS="500"

# CORS 允许的来源（逗号分隔）
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:3000"

# 数据加密密钥（排盘等敏感数据使用）
ENCRYPTION_KEY="change-me-32-char-secret-key!!"

# ═══════════ 腾讯云服务（基础凭证） ═══════════
# 所有腾讯云服务共用此凭证（IM/VOD/直播/审核/SMS/人脸识别/OCR/ASR等）
# 获取地址：https://console.cloud.tencent.com/cam/capi
# TENCENT_SECRET_ID="your-secret-id"
# TENCENT_SECRET_KEY="your-secret-key"

# ═══════════ 腾讯云 COS 文件存储 ═══════════
# 设置以下三项后自动从本地存储切换到 COS
# COS_SECRET_ID="your-cos-secret-id"          # 可复用 TENCENT_SECRET_ID
# COS_SECRET_KEY="your-cos-secret-key"        # 可复用 TENCENT_SECRET_KEY
# COS_BUCKET="your-bucket-name-1250000000"
# COS_REGION="ap-guangzhou"
# COS_CDN_BASE="https://cdn.example.com"      # 可选：CDN 加速域名

# ═══════════ 腾讯云 IM 即时通讯 ═══════════
# 申请地址：https://console.cloud.tencent.com/im
# IM_APP_ID="1400000000"
# IM_ADMIN_KEY="your-im-admin-key"
# IM_ADMIN_ID="administrator"                 # 管理员账号标识

# ═══════════ 腾讯云直播（CSS） ═══════════
# 申请地址：https://console.cloud.tencent.com/live
# LIVE_PUSH_DOMAIN="push.example.com"
# LIVE_PLAY_DOMAIN="play.example.com"
# LIVE_PUSH_KEY="your-push-auth-key"
# LIVE_PLAY_KEY="your-play-auth-key"
# LIVE_APP_NAME="live"

# ═══════════ 腾讯云视频点播（VOD） ═══════════
# 申请地址：https://console.cloud.tencent.com/vod
# VOD_SUB_APP_ID="1500000000"

# ═══════════ 腾讯云短信（SMS） ═══════════
# 申请地址：https://console.cloud.tencent.com/smsv2
# SMS_APP_ID="1400000000"                     # SDKAppID
# SMS_SIGN_NAME="国学平台"                     # 短信签名
# SMS_TEMPLATE_ID="1234567"                   # 验证码模板ID

# ═══════════ 腾讯云 AI 能力 ═══════════
# 语音识别(ASR)/OCR/NLP/机器翻译（复用 TENCENT_SECRET_ID/TENCENT_SECRET_KEY）
# 无需额外凭证，直接在 .env 中配置 TENCENT_SECRET_ID 和 TENCENT_SECRET_KEY 即可

# ═══════════ 腾讯地图 ═══════════
# 申请地址：https://lbs.qq.com/
# TENCENT_MAP_KEY="your-map-api-key"
# TENCENT_MAP_SK="your-map-secret-key-用于签名校验"

# ═══════════ DeepSeek AI ═══════════
# 用于排盘AI分析、智能解读
# DEEPSEEK_API_KEY="sk-your-deepseek-api-key"

# ═══════════ 微信开放平台 ═══════════
# 用于 H5 OAuth 登录 + 小程序登录 + 公众号消息
# 申请地址：https://open.weixin.qq.com
# WECHAT_APP_ID="your-wechat-app-id"
# WECHAT_APP_SECRET="your-wechat-app-secret"
# WECHAT_MINI_APP_ID="your-mini-program-app-id"     # 小程序AppId（复用APP_ID则可不填）
# WECHAT_MP_APP_ID="your-mp-app-id"                 # 公众号AppId（复用APP_ID则可不填）

# ═══════════ 微信支付 V3 ═══════════
# 申请地址：https://pay.weixin.qq.com（需商户号）
# WECHAT_PAY_MCH_ID="your-merchant-id"
# WECHAT_PAY_SERIAL_NO="your-cert-serial-no"
# WECHAT_PAY_API_V3_KEY="your-api-v3-key-32-chars"
# WECHAT_PAY_PRIVATE_KEY_PATH="/path/to/apiclient_key.pem"   # 方式一：私钥文件路径
# WECHAT_PAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"  # 方式二：直接粘贴
# WECHAT_PAY_NOTIFY_URL="https://your-domain.com/api/shop/pay/notify"
# WECHAT_PAY_REFUND_NOTIFY_URL="https://your-domain.com/api/shop/pay/refund-notify"

# ═══════════ 支付宝支付 ═══════════
# 申请地址：https://open.alipay.com
# ALIPAY_APP_ID="your-alipay-app-id"
# ALIPAY_SANDBOX="true"                               # 沙箱模式（生产环境删除或设为false）
# ALIPAY_PRIVATE_KEY_PATH="/path/to/alipay_private_key.pem"
# ALIPAY_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# ALIPAY_PUBLIC_KEY_PATH="/path/to/alipay_public_key.pem"
# ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# ALIPAY_NOTIFY_URL="https://your-domain.com/api/shop/alipay/notify"

# ═══════════ 银联支付（含云闪付） ═══════════
# 申请地址：https://open.unionpay.com
# UNIONPAY_MER_ID="your-merchant-id"
# UNIONPAY_SANDBOX="true"                              # 沙箱模式
# UNIONPAY_PFX_PATH="/path/to/merchant.pfx"            # PKCS12证书（方式一）
# UNIONPAY_PFX_PASSWORD="pfx-password"
# UNIONPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"  # PEM私钥（方式二）
# UNIONPAY_PUBLIC_KEY_PATH="/path/to/unionpay_public.cer"
# UNIONPAY_PUBLIC_KEY="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# UNIONPAY_NOTIFY_URL="https://your-domain.com/api/shop/unionpay/notify"

# ═══════════ 快递物流（快递100） ═══════════
# 申请地址：https://api.kuaidi100.com
# KUAIDI100_API_KEY="your-api-key"
# KUAIDI100_CUSTOMER="your-customer-id"
# KUAIDI100_CALLBACK_URL="https://api.rebugx.cn/api/v1/shop/logistics/kuaidi100/callback"
# KUAIDI100_SALT="your-random-callback-salt"

# ═══════════ 企业微信机器人 Webhook ═══════════
# 用于向管理群发送新订单/违规告警/提现审核通知
# 获取方式：企业微信群→群机器人→添加→获取Webhook地址
# WEWORK_WEBHOOK_URL="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx"
# WEWORK_WEBHOOK_ALERT_URL="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=yyy"  # 可选的告警群

# ═══════════ COZE 智能体 ═══════════
# 申请地址：https://www.coze.com
# COZE_API_KEY="your-coze-api-key"
# COZE_BOT_ID="your-bot-id"

# ═══════════ 邮件服务 ═══════════
# 支持两种模式：SMTP 或 HTTP API（SendGrid/Resend 等）

# 模式一：SMTP
# EMAIL_MODE="smtp"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="465"
# SMTP_USER="noreply@example.com"
# SMTP_PASS="your-smtp-password"

# 模式二：HTTP API（SendGrid 兼容格式）
# EMAIL_MODE="api"
# EMAIL_API_URL="https://api.sendgrid.com/v3/mail/send"
# EMAIL_API_KEY="your-api-key"

# 发件人地址（两种模式共用）
# EMAIL_FROM="noreply@guoxue.com"

# ═══════════ 可观测性：OpenTelemetry 链路追踪 ═══════════
# 默认使用 OTLP HTTP 协议导出，兼容 Jaeger / Grafana Tempo / OpenTelemetry Collector
# 本地开发不设置时，追踪初始化会静默失败（不影响应用运行）
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318/v1/traces"
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://localhost:4318/v1/traces"
# OTEL_SERVICE_NAME="guoxue-platform"

# ═══════════ 日志 & WebSocket ═══════════
# LOG_LEVEL="debug"                                    # 日志级别: debug/info/warn/error（默认 info）
# WS_CORS_ORIGIN="http://localhost:5173"               # WebSocket CORS（默认同 CORS_ORIGIN）

# ═══════════ Embedding / 向量搜索（可选） ═══════════
# EMBEDDING_BASE_URL="https://api.openai.com/v1"       # Embedding API 地址
# EMBEDDING_MODEL="text-embedding-3-small"             # Embedding 模型名
# EMBEDDING_DIMENSION="1536"                           # 向量维度
# OPENAI_API_KEY="sk-your-openai-api-key"              # OpenAI API Key（兼容格式）
