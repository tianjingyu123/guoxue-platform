# ═══════════════════════════════════════════════
# 国学传统文化综合平台 — 环境变量配置
# ═══════════════════════════════════════════════
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ═══════════ 基础设施 ═══════════
DATABASE_URL="postgresql://guoxue:guoxue123@127.0.0.1:5433/guoxue"
JWT_SECRET="change-me-in-production-use-64-char-random-string"
PORT=3000
NODE_ENV="development"

# 演示种子账号密码（执行 prisma/seed.ts 时必填，至少 12 个字符）
SEED_ADMIN_PASSWORD=""
SEED_TEACHER_PASSWORD=""
SEED_OPERATOR_PASSWORD=""
# 生产环境默认禁止演示 seed；仅完成备份和审批后临时设置为 true
ALLOW_PRODUCTION_SEED="false"

# Redis 缓存（排盘模块、短信验证码等使用）
REDIS_URL="redis://localhost:6379"

# Redis Sentinel 高可用（可选，留空则使用 REDIS_URL 直连）
# 格式: "host1:port1,host2:port2,host3:port3"
# REDIS_SENTINEL_HOSTS="sentinel1:26379,sentinel2:26379,sentinel3:26379"
# REDIS_SENTINEL_MASTER="mymaster"

# PostgreSQL 读副本（可选，留空则所有查询走主库）
# DATABASE_REPLICA_URL="postgresql://guoxue:guoxue123@replica-host:5432/guoxue"

# BullMQ 开关（测试环境可禁用，避免加载 ESM 依赖）
# BULLMQ_DISABLED="true"

# 慢查询阈值（毫秒），超过此阈值的SQL会打WARN日志
PRISMA_SLOW_QUERY_MS="500"

# CORS 允许的来源（逗号分隔）
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:3000"

# 公网入口（域名迁移时由部署环境覆盖；不要把旧域名写入业务代码）
PUBLIC_DOMAIN="api.example.com"
PUBLIC_API_URL="https://api.example.com"
PUBLIC_H5_URL="https://api.example.com/h5/"
PUBLIC_ASSET_ORIGIN="https://cdn.example.com"
COOKIE_DOMAIN=".example.com"

# 数据加密密钥（排盘等敏感数据使用）
ENCRYPTION_KEY="change-me-32-char-secret-key!!"

# ═══════════ 腾讯云服务（基础凭证） ═══════════
# 所有腾讯云服务共用此凭证（IM/VOD/直播/审核/SMS/人脸识别/OCR/ASR等）
# 获取地址：https://console.cloud.tencent.com/cam/capi
# TENCENT_SECRET_ID="your-secret-id"
# TENCENT_SECRET_KEY="your-secret-key"
# TENCENT_CREDENTIAL_MODE="static"             # 生产 CVM 推荐改为 instance-role
# TENCENT_CVM_ROLE_NAME=""                     # instance-role 模式填写绑定的 CAM 角色名

# ═══════════ 腾讯云 COS 文件存储 ═══════════
# 设置以下三项后自动从本地存储切换到 COS
# STORAGE_PROVIDER="auto"                     # 腾讯云双节点生产环境必须设为 cos
# COS_SECRET_ID="your-cos-secret-id"          # 可复用 TENCENT_SECRET_ID
# COS_SECRET_KEY="your-cos-secret-key"        # 可复用 TENCENT_SECRET_KEY
# COS_BUCKET="your-bucket-name-1250000000"
# COS_REGION="ap-guangzhou"
# COS_CDN_BASE="https://cdn.example.com"      # 可选：CDN 加速域名

# ═══════════ 腾讯云 IM 即时通讯 ═══════════
# 申请地址：https://console.cloud.tencent.com/im
# IM_APP_ID="1400000000"
# IM_ADMIN_KEY="your-im-admin-key"
# IM_ADMIN_ID="administrator"                 # 管理员账号标识

# ═══════════ 腾讯云直播（CSS） ═══════════
# 申请地址：https://console.cloud.tencent.com/live
# LIVE_PUSH_DOMAIN="push.example.com"
# LIVE_PLAY_DOMAIN="play.example.com"
# LIVE_PUSH_KEY="your-push-auth-key"
# LIVE_PLAY_KEY="your-play-auth-key"
# LIVE_APP_NAME="live"

# ═══════════ 腾讯云视频点播（VOD） ═══════════
# 申请地址：https://console.cloud.tencent.com/vod
# VOD_SUB_APP_ID="1500000000"
# VOD_PLAY_KEY="your-vod-player-signing-key"

# 腾讯云实时音视频（TRTC）与 AI 实时语音
# SecretKey 只能保存在服务端配置中心，禁止写入 H5、小程序或 App 包。
# TRTC_SDK_APP_ID="1400000000"
# TRTC_SECRET_KEY="your-trtc-sdk-secret-key"
# LIVE_MULTI_GUEST_MIXING_ENABLED="false"      # true=手机主播/嘉宾统一输出到 CDN
# LIVE_OBS_TRTC_INGEST_ENABLED="false"         # true=OBS 直接进入同一 TRTC 房间
# TRTC_CALLBACK_KEY=""                         # 可选；留空复用 TENCENT_CALLBACK_KEY

# 语音识别 / 语音合成地域与模型（复用 TENCENT_SECRET_ID/TENCENT_SECRET_KEY）
# TENCENT_ASR_REGION="ap-guangzhou"
# TENCENT_ASR_ENGINE="16k_zh"
# TENCENT_TTS_REGION="ap-guangzhou"

# ═══════════ 腾讯云短信（SMS） ═══════════
# 申请地址：https://console.cloud.tencent.com/smsv2
# SMS_APP_ID="1400000000"                     # SDKAppID
# SMS_SIGN_NAME="国学平台"                     # 短信签名
# SMS_TEMPLATE_ID="1234567"                   # 验证码模板ID
# SMS_CHURN_TEMPLATE_ID="7654321"              # 召回短信模板ID（可选）

# ═══════════ 腾讯云 AI 能力 ═══════════
# 语音识别(ASR)/OCR/NLP/机器翻译（复用 TENCENT_SECRET_ID/TENCENT_SECRET_KEY）
# 无需额外凭证，直接在 .env 中配置 TENCENT_SECRET_ID 和 TENCENT_SECRET_KEY 即可

# ═══════════ 腾讯地图 ═══════════
# 申请地址：https://lbs.qq.com/
# TENCENT_MAP_KEY="your-map-api-key"
# TENCENT_MAP_SK="your-map-secret-key-用于签名校验"

# ═══════════ DeepSeek AI ═══════════
# 用于排盘AI分析、智能解读
# DEEPSEEK_API_KEY="sk-your-deepseek-api-key"

# ═══════════ 微信开放平台 ═══════════
# 用于 H5 OAuth 登录 + 小程序登录 + 公众号消息
# 申请地址：https://open.weixin.qq.com
# WECHAT_APP_ID="your-wechat-app-id"
# WECHAT_APP_SECRET="your-wechat-app-secret"
# WECHAT_OPEN_APP_ID="your-open-platform-mobile-app-id"       # APP 微信登录：开放平台移动应用 AppID
# WECHAT_OPEN_APP_SECRET="your-open-platform-mobile-secret"  # APP 微信登录：只保存在服务端，禁止写入客户端 manifest
# WECHAT_OPEN_PLATFORM_ID="your-open-platform-account-id"    # 公众号/小程序/APP 均绑定同一开放平台后，用作 UnionID 统一命名空间
# WECHAT_OFFICIAL_APPID="wx-official-app-id"
# WECHAT_OFFICIAL_APP_SECRET="official-app-secret"
# WECHAT_MINI_APP_ID="wx06397e8ab26bed9e"          # 热卜星火小程序 AppID；生产环境必须显式填写
# WECHAT_OAUTH_ALLOWED_ORIGINS="https://h5.example.com" # 可选；默认允许 PUBLIC_H5_URL/PUBLIC_API_URL 同源
# MINIPROGRAM_APP_SECRET="your-mini-program-app-secret"
# WECHAT_MP_APP_ID="your-mp-app-id"                 # 公众号AppId（复用APP_ID则可不填）

# ═══════════ 微信支付 V3 ═══════════
# 申请地址：https://pay.weixin.qq.com（需商户号）
# WECHAT_PAY_APP_ID="wx06397e8ab26bed9e"            # 必须与商户号绑定的小程序 AppID 一致
# WECHAT_PAY_MCH_ID="your-merchant-id"
# WECHAT_PAY_ALLOWED_MCH_ID="your-merchant-id"       # 生产商户号白名单，必须与后台配置一致
# WECHAT_PAY_DB_CONFIG_VERIFIED="false"               # 完成人工核验后，生产发布时显式改为 true
# WECHAT_PAY_CALLBACK_KEY_MODE="PLATFORM_CERT"        # PLATFORM_CERT 或 PUBLIC_KEY
# WECHAT_PAY_SERIAL_NO="your-cert-serial-no"
# WECHAT_PAY_API_V3_KEY="your-api-v3-key-32-chars"
# WECHAT_PAY_PRIVATE_KEY_PATH="/path/to/apiclient_key.pem"   # 方式一：私钥文件路径
# WECHAT_PAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"  # 方式二：直接粘贴
# WECHAT_PAY_PUBLIC_KEY="/path/to/pub_key.pem"               # 新商户默认公钥模式；也可直接填 PEM 内容
# WECHAT_PAY_PUBLIC_KEY_ID="PUB_KEY_ID_xxxxxxxxxxxxx"        # 与 pub_key.pem 成对，不是商户API证书序列号
# WECHAT_PAY_NOTIFY_URL="https://api.example.com/api/v1/shop/pay/notify"
# WECHAT_PAY_REFUND_NOTIFY_URL="https://api.example.com/api/v1/shop/refund/notify"
# WECHAT_PAY_TRANSFER_NOTIFY_URL="https://api.example.com/api/v1/payout/wechat/transfer-notify"

# ═══════════ 支付宝支付 ═══════════
# 申请地址：https://open.alipay.com
# ALIPAY_APP_ID="your-alipay-app-id"
# ALIPAY_SANDBOX="true"                               # 沙箱模式（生产环境删除或设为false）
# ALIPAY_PRIVATE_KEY_PATH="/path/to/alipay_private_key.pem"
# ALIPAY_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# ALIPAY_PUBLIC_KEY_PATH="/path/to/alipay_public_key.pem"
# ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# ALIPAY_NOTIFY_URL="https://api.example.com/api/v1/shop/alipay/notify"

# ═══════════ Apple App 内购买（iOS 虚拟商品） ═══════════
# Sign in with Apple identityToken 的 audience（无需 AppSecret）
APPLE_LOGIN_AUDIENCE="com.rebu.iosapprebu"
# App Store Connect → 用户与访问 → 集成 → App 内购买：创建密钥并取得 Key ID、Issuer ID。
# 私钥二选一：推荐在部署平台存为 Base64，或挂载 .p8 后填写绝对路径。
# APPLE_IAP_KEY_ID="your-10-char-key-id"
# APPLE_IAP_REQUIRED="false"                         # iOS 正式上线前改为 true；未就绪时健康检查失败
# APPLE_IAP_ISSUER_ID="your-issuer-uuid"
# APPLE_IAP_PRIVATE_KEY_BASE64="base64-of-subscription-key-p8"
# APPLE_IAP_PRIVATE_KEY="/run/secrets/SubscriptionKey_xxxxxxxxxx.p8"
# APPLE_IAP_BUNDLE_ID="com.rebu.iosapprebu"
# APPLE_IAP_APP_APPLE_ID="6756602923"
# APPLE_IAP_ENVIRONMENT="AUTO"                       # AUTO 同时支持正式交易和 TestFlight/Sandbox
# APPLE_IAP_PRODUCTS_JSON='[{"productId":"com.rebu.iosapprebu.coins1000","amountCoin":1000,"referenceRmb":100},{"productId":"com.rebu.iosapprebu.coins2000","amountCoin":2000,"referenceRmb":200,"popular":true},{"productId":"com.rebu.iosapprebu.coins5000","amountCoin":5000,"referenceRmb":500}]'

# ═══════════ 银联支付（含云闪付） ═══════════
# 申请地址：https://open.unionpay.com
# UNIONPAY_MER_ID="your-merchant-id"
# UNIONPAY_SANDBOX="true"                              # 沙箱模式
# UNIONPAY_PFX_PATH="/path/to/merchant.pfx"            # PKCS12证书（方式一）
# UNIONPAY_PFX_PASSWORD="pfx-password"
# UNIONPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"  # PEM私钥（方式二）
# UNIONPAY_PUBLIC_KEY_PATH="/path/to/unionpay_public.cer"
# UNIONPAY_PUBLIC_KEY="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# UNIONPAY_NOTIFY_URL="https://api.example.com/api/v1/shop/unionpay/notify"

# ═══════════════════ 汇付聚合支付 ═══════════════════
# HUIFU_DB_CONFIG_VERIFIED="false"                    # 后台密钥核验完成后，生产发布时显式改为 true
# HUIFU_MIGRATE_LEGACY_CONFIG="false"                 # 仅维护窗口显式开启一次，迁移完成后立即恢复 false
# HUIFU_BASE_URL="https://api.huifu.com"
# HUIFU_APP_ID="your-app-id"
# HUIFU_MERCHANT_ID="your-merchant-id"
# HUIFU_UPPER_HUIFU_ID="your-upper-huifu-id"
# HUIFU_PRODUCT_ID="your-product-id"
# HUIFU_SECRET_KEY="your-secret-key"
# HUIFU_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# HUIFU_RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# HUIFU_NOTIFY_URL="https://api.example.com/api/v1/huifu/notify"

# ═══════════ 快递物流（快递100） ═══════════
# 申请地址：https://api.kuaidi100.com
# KUAIDI100_API_KEY="your-api-key"
# KUAIDI100_CUSTOMER="your-customer-id"
# KUAIDI100_CALLBACK_URL="https://api.example.com/api/v1/shop/logistics/kuaidi100/callback"
# KUAIDI100_SALT="your-random-callback-salt"

# ═══════════ 企业微信机器人 Webhook ═══════════
# 用于向管理群发送新订单/违规告警/提现审核通知
# 获取方式：企业微信群→群机器人→添加→获取Webhook地址
# WEWORK_WEBHOOK_URL="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx"
# WEWORK_WEBHOOK_ALERT_URL="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=yyy"  # 可选的告警群

# ═══════════ COZE 智能体 ═══════════
# 申请地址：https://www.coze.com
# COZE_API_KEY="your-coze-api-key"
# COZE_BOT_ID="your-bot-id"

# ═══════════ 邮件服务 ═══════════
# 支持两种模式：SMTP 或 HTTP API（SendGrid/Resend 等）

# 模式一：SMTP
# EMAIL_MODE="smtp"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="465"
# SMTP_USER="noreply@example.com"
# SMTP_PASS="your-smtp-password"

# 模式二：HTTP API（SendGrid 兼容格式）
# EMAIL_MODE="api"
# EMAIL_API_URL="https://api.sendgrid.com/v3/mail/send"
# EMAIL_API_KEY="your-api-key"

# 发件人地址（两种模式共用）
# EMAIL_FROM="noreply@guoxue.com"

# ═══════════ 可观测性：OpenTelemetry 链路追踪 ═══════════
# 默认使用 OTLP HTTP 协议导出，兼容 Jaeger / Grafana Tempo / OpenTelemetry Collector
# 本地开发不设置时，追踪初始化会静默失败（不影响应用运行）
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318/v1/traces"
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://localhost:4318/v1/traces"
# OTEL_SERVICE_NAME="guoxue-platform"

# ═══════════ 日志 & WebSocket ═══════════
# LOG_LEVEL="debug"                                    # 日志级别: debug/info/warn/error（默认 info）
# WS_CORS_ORIGIN="http://localhost:5173"               # WebSocket CORS（默认同 CORS_ORIGIN）

# ═══════════ Embedding / 向量搜索（可选） ═══════════
# EMBEDDING_BASE_URL="https://api.openai.com/v1"       # Embedding API 地址
# EMBEDDING_MODEL="text-embedding-3-small"             # Embedding 模型名
# EMBEDDING_DIMENSION="1536"                           # 向量维度
# OPENAI_API_KEY="sk-your-openai-api-key"              # OpenAI API Key（兼容格式）
# 首发期旧排盘兼容：只使用已确认的手机号签名 H5 协议。
PAIPAN_MODE=legacy
PAIPAN_LEGACY_DISPLAY_VERSION=1
PAIPAN_NATIVE_QA_ENABLED=false
PAIPAN_NATIVE_QA_HOST=pre-api.rebugx.cn
PAIPAN_NATIVE_QA_ALLOWLIST=
PAIPAN_OPERATION_H5_BASE=https://www.yrydai.cn/guoxueApp.php
PAIPAN_USER_LOOKUP_URL=https://www.yrydai.cn/recommend/mobileUser.php
PAIPAN_PARTNER_OPEN_URL=https://www.yrydai.cn/recommend/partner.php
PAIPAN_PARTNER_OAUTH_URL=https://www.yrydai.cn/my.php?mod=member&act=addPartner
PAIPAN_REFERRAL_BASE=https://www.yrydai.com/p1.php
PAIPAN_LEGACY_MODE=true
PAIPAN_H5_BASE=https://www.yrydai.cn/guoxueApp.php
