} from '@/pkg-live/live-trtc-client'

const emptyRoom: LiveWatchRoomInfo = {
  id: '',
  type: 'knowledge',
  title: '',
  hostName: '',
  hostAvatar: '',
  hostId: '',
  followers: null,
  viewerCount: 0,
  likeCount: 0,
  isFollowing: false,
  onlineAvatars: [],
  imGroupId: '',
  circleId: '',
  orientation: 'portrait',
  visibility: 'CIRCLE_ONLY',
  status: '',
  cover: '',
  startTime: '',
  chargeType: 'FREE',
  chargePrice: 0,
  quality: '',
  replayUrl: '',
  replayChapters: [],
  circleName: '',
  allowComment: false,
  allowLike: false,
  allowGift: false,
  canComment: false,
  canLike: false,
  canGift: false,
}

const roomId = ref('')
const returnRoute = ref('')
// 所有异步房间读取均绑定当前页面可见性与代次，防止 A 房的晚响应覆盖 B 房。
const pageVisible = ref(true)
const presenceActive = ref(true)
let roomLoadVersion = 0
const room = ref<LiveWatchRoomInfo>({ ...emptyRoom })
type LivePlayUrl = { flv: string; hls: string; streamMode?: 'ORIGIN' | 'MIXED' }
const playUrl = ref<LivePlayUrl | null>(null)
const comments = ref<VerticalLiveComment[]>([])
const loading = ref(true)
const error = ref('')
const playerNotice = ref('')
const isFollowing = ref(false)
const commentDraft = ref('')
const showCommentComposer = ref(false)
const showMicSheet = ref(false)
const showGiftPanel = ref(false)
const showProductPanel = ref(false)
const showMorePanel = ref(false)
const products = ref<VerticalLiveProduct[]>([])
const gifts = ref<LiveGift[]>([])
const coinBalance = ref(0)
const giftPolicy = ref<LiveGiftSpendingPreference | null>(null)
const giftPolicyLoading = ref(false)
const savingGiftPolicy = ref(false)
const singleLimitDraft = ref('100')
const dailyLimitDraft = ref('500')
const selectedGiftId = ref('')
const sendingGift = ref(false)
type FeedItem = Pick<LiveItem, 'id' | 'title' | 'cover' | 'hostName' | 'hostAvatar'>
const feedItems = ref<FeedItem[]>([])
const feedIndex = ref(0)
const endCountdown = ref(3)
const canUseLiveMic = isLiveTrtcSupported()
type MicState = 'idle' | 'requesting' | 'invited' | 'preflight' | 'connecting' | 'connected' | 'error'
const micState = ref<MicState>('idle')
const micError = ref('')
const micDuration = ref(0)
const micMuted = ref(false)
const micHostMuted = ref(false)
const micVideoMuted = ref(false)
const micMediaMode = ref<'AUDIO' | 'VIDEO'>('AUDIO')
const rtcHostUserId = ref('')
const roomMics = ref<LiveMicItem[]>([])
const remoteVideoUsers = ref<Array<{ userId: string; viewId: string }>>([])
const rtcGuestViewId = `guest-preview-${Date.now().toString(36)}`
const guestFrontCamera = ref(true)
const { safeTop, safeRight, safeBottom, safeLeft } = useAppSafeArea()

const hostInitial = computed(() => String(room.value.hostName || '热').trim().slice(0, 1))
const qualityLabel = computed(() => room.value.quality === 'uhd' ? '超清' : room.value.quality === 'hd' ? '高清' : '')
const visibleComments = computed(() => comments.value.slice(-5))
const visibleAudienceAvatars = computed(() => room.value.onlineAvatars.filter(Boolean).slice(0, 3))
const micRealtimeAudioActive = computed(() => micState.value === 'connecting' || micState.value === 'connected')
const roomEnded = computed(() => ['ENDED', 'REPLAY'].includes(String(room.value.status || '').toUpperCase()))
const selectedGift = computed(() => gifts.value.find((gift) => gift.id === selectedGiftId.value) || null)
const giftPolicyReady = computed(() => Boolean(giftPolicy.value?.eligible && giftPolicy.value?.configured))
const giftPolicyReason = computed(() => {
  if (giftPolicy.value?.ineligibleReason === 'MINOR_NOT_ALLOWED') return '未成年人禁止直播打赏。'
  if (giftPolicy.value?.ineligibleReason === 'AGE_REQUIRED') return '请先补全年龄信息并完成核验。'
  return '请先完成实名认证与年龄核验。'
})
const hasNextRoom = computed(() => feedIndex.value + 1 < feedItems.value.length)
const orderedRemoteVideoUsers = computed(() => [...remoteVideoUsers.value].sort((left, right) => {
  if (left.userId === rtcHostUserId.value) return -1
  if (right.userId === rtcHostUserId.value) return 1
  return left.userId.localeCompare(right.userId)
}))
const publicConnectedMics = computed(() => roomMics.value.filter((item) => item.status === 'OCCUPIED' || item.status === 'MUTED'))
const topbarStyle = computed(() => ({
  paddingTop: `${safeTop.value + uni.upx2px(18)}px`,
  paddingLeft: `${safeLeft.value + uni.upx2px(22)}px`,
  paddingRight: `${safeRight.value + uni.upx2px(22)}px`,
}))
const shadeTopStyle = computed(() => ({ height: `${safeTop.value + uni.upx2px(300)}px` }))
const shadeBottomStyle = computed(() => ({ height: `${safeBottom.value + uni.upx2px(520)}px` }))
const roomMetaStyle = computed(() => ({
  left: `${safeLeft.value + uni.upx2px(24)}px`,
  right: `${safeRight.value + uni.upx2px(24)}px`,
  top: `${safeTop.value + uni.upx2px(118)}px`,
}))
const commentStackStyle = computed(() => ({
  left: `${safeLeft.value + uni.upx2px(24)}px`,
  right: `${safeRight.value + uni.upx2px(178)}px`,
  bottom: `${safeBottom.value + uni.upx2px(146)}px`,
}))
const bottomDockStyle = computed(() => ({
  paddingLeft: `${safeLeft.value + uni.upx2px(22)}px`,
  paddingRight: `${safeRight.value + uni.upx2px(22)}px`,
  paddingBottom: `${safeBottom.value + uni.upx2px(18)}px`,
}))
const likeFeedbackStyle = computed(() => ({
  right: `${safeRight.value + uni.upx2px(46)}px`,
  bottom: `${safeBottom.value + uni.upx2px(226)}px`,
}))
const composerSheetStyle = computed(() => ({
  paddingLeft: `${safeLeft.value + uni.upx2px(28)}px`,
  paddingRight: `${safeRight.value + uni.upx2px(28)}px`,
  paddingBottom: `${safeBottom.value + uni.upx2px(28)}px`,
}))
const micSheetStyle = computed(() => ({
  paddingLeft: `${safeLeft.value + uni.upx2px(40)}px`,
  paddingRight: `${safeRight.value + uni.upx2px(40)}px`,
  paddingBottom: `${safeBottom.value + uni.upx2px(38)}px`,
}))
const micConnectedStyle = computed(() => ({
  left: `${safeLeft.value + uni.upx2px(24)}px`,
  right: `${safeRight.value + uni.upx2px(24)}px`,
  bottom: `${safeBottom.value + uni.upx2px(138)}px`,
}))
const rtcGuestPreviewStyle = computed(() => ({
  top: `${safeTop.value + uni.upx2px(126)}px`,
  right: `${safeRight.value + uni.upx2px(20)}px`,
}))
const endedCardStyle = computed(() => ({
  marginLeft: `${safeLeft.value + uni.upx2px(44)}px`,
  marginRight: `${safeRight.value + uni.upx2px(44)}px`,
}))
const productFloatStyle = computed(() => ({
  left: `${safeLeft.value + uni.upx2px(24)}px`,
  right: `${safeRight.value + uni.upx2px(178)}px`,
  bottom: `${safeBottom.value + uni.upx2px(344)}px`,
}))
const socialRailStyle = computed(() => ({
  right: `${safeRight.value + uni.upx2px(18)}px`,
  bottom: `${safeBottom.value + uni.upx2px(150)}px`,
}))
const actionSheetStyle = computed(() => ({
  paddingLeft: `${safeLeft.value + uni.upx2px(28)}px`,
  paddingRight: `${safeRight.value + uni.upx2px(28)}px`,
  paddingBottom: `${safeBottom.value + uni.upx2px(28)}px`,
}))

const { leavePresence, touchPresence } = useLiveWatchPresence({
  roomId: () => roomId.value,
  isEnded: () => roomEnded.value,
  isActive: () => pageVisible.value && presenceActive.value,
  onOnlineCount: (onlineCount) => { room.value.viewerCount = onlineCount },
  onFailure: ({ roomId: failedRoomId, retryInMs, status, code }) => {
    // 只保留可行动的脱敏诊断字段；失败会退避重试，不能因统计链路影响观看。
    console.warn('[live] presence heartbeat retry', { roomId: failedRoomId, retryInMs, status, code })
  },
})

function isCurrentRoomRequest(targetRoomId: string, requestVersion: number) {
  return pageVisible.value && roomId.value === targetRoomId && roomLoadVersion === requestVersion
}

function rtcRemoteVideoStyle(index: number) {
  const count = orderedRemoteVideoUsers.value.length
  if (count <= 1) return { left: '0px', right: '0px', top: '0px', bottom: '0px' }
  if (index === 0) return { left: '0px', right: '0px', top: '0px', height: '60%' }
  const guestCount = count - 1
  const columns = guestCount <= 1 ? 1 : guestCount <= 4 ? 2 : 3
  const rows = Math.ceil(guestCount / columns)
  const guestIndex = index - 1
  const row = Math.floor(guestIndex / columns)
  const column = guestIndex % columns
  const width = 100 / columns
  const height = 40 / rows
  return {
    left: `${column * width}%`,
    width: `${width}%`,
    top: `${60 + row * height}%`,
    height: `${height}%`,
  }
}

function remoteVideoLabel(userId: string) {
  if (userId === rtcHostUserId.value) return room.value.hostName || '主播'
  const mic = roomMics.value.find((item) => item.trtcUserId === userId)
  return mic?.nickname || `连麦嘉宾 ${mic?.position || ''}`.trim()
}

const tim = useTim()
let timGroupId = ''
let offTimMessage: (() => void) | null = null
let sendingComment = false
let followBusy = false
let micUserId = ''
let micInvitePending = false
let preflightMic: LiveMicItem | null = null
let micPolling = false
let appliedMicMuteState: boolean | null = null
let micPollTimer: ReturnType<typeof setInterval> | null = null
let micDurationTimer: ReturnType<typeof setInterval> | null = null
let lastMicReadyAt = 0
let roomPollTimer: ReturnType<typeof setInterval> | null = null
let endAdvanceTimer: ReturnType<typeof setInterval> | null = null
let playerRetryTimer: ReturnType<typeof setTimeout> | null = null
let playerRetryCount = 0
let roomPolling = false
let switchingRoom = false
let appBackgroundSuspended = false
let resumeAfterHide = false
let giftsLoaded = false
let feedInitializedRoomId = ''
const playUrlCache = new Map<string, LivePlayUrl>()
const pendingLocalEchoes = new Map<string, Set<number>>()
let localEchoSequence = 0
type LikeParticle = { id: number; variant: number; frame: number }
const likeParticles = ref<LikeParticle[]>([])
let likeParticleSequence = 0
let likeParticleTimer: ReturnType<typeof setInterval> | null = null

function likeParticleStyle(particle: LikeParticle) {
  const progress = Math.min(1, particle.frame / 12)
  const offset = particle.variant === 1 ? -uni.upx2px(22) : particle.variant === 2 ? uni.upx2px(22) : 0
  const rise = uni.upx2px(176) * progress
  const scale = progress < 0.24 ? 0.62 + progress * 1.75 : 1.04 - (progress - 0.24) * 0.18
  const opacity = progress < 0.18 ? progress / 0.18 : Math.max(0, (1 - progress) / 0.82)
  return {
    opacity,
    transform: `translate(${offset}px, -${rise}px) scale(${scale}) rotate(${Math.round(-8 + progress * 18)}deg)`,
  }
}

function startLikeParticleTicker() {
  if (likeParticleTimer) return
  likeParticleTimer = setInterval(() => {
    likeParticles.value = likeParticles.value
      .map((particle) => ({ ...particle, frame: particle.frame + 1 }))
      .filter((particle) => particle.frame <= 12)
    if (likeParticles.value.length) return
    if (likeParticleTimer) clearInterval(likeParticleTimer)
    likeParticleTimer = null
  }, 55)
}

function rememberLocalEcho(content: string) {
  const token = ++localEchoSequence
  const tokens = pendingLocalEchoes.get(content) || new Set<number>()
  tokens.add(token)
  pendingLocalEchoes.set(content, tokens)
  setTimeout(() => forgetLocalEcho(content, token), 15_000)
  return token
}

function forgetLocalEcho(content: string, token?: number) {
  const tokens = pendingLocalEchoes.get(content)
  if (!tokens?.size) return
  const target = token ?? tokens.values().next().value
  if (target !== undefined) tokens.delete(target)
  if (!tokens.size) pendingLocalEchoes.delete(content)
}

function consumeLocalEcho(message: TimMessage, content: string) {
  const profile = getUserInfo<{ id?: string; userId?: string }>()
  const currentUserId = String(profile?.id || profile?.userId || '')
  const isOwnMessage = message.flow === 'out' || (!!currentUserId && message.from === currentUserId)
  if (!isOwnMessage || !content || !pendingLocalEchoes.has(content)) return false
  forgetLocalEcho(content)
  return true
}

function formatCount(value: number) {
  const n = Math.max(0, Number(value) || 0)
  if (n >= 10000) return `${(n / 10000).toFixed(1)}万`
  return String(n)
}

function formatDuration(value: number) {
  const minutes = Math.floor(value / 60).toString().padStart(2, '0')
  const seconds = (value % 60).toString().padStart(2, '0')
  return `${minutes}:${seconds}`
}

function formatPrice(value: number) {
  const amount = Math.max(0, Number(value) || 0)
  return Number.isInteger(amount) ? String(amount) : amount.toFixed(2)
}

function toFeedItem(item: FeedItem): FeedItem {
  return {
    id: item.id,
    title: item.title || '直播间',
    cover: item.cover || '',
    hostName: item.hostName || '主播',
    hostAvatar: item.hostAvatar || '',
  }
}

function syncCurrentFeedItem() {
  const current: FeedItem = {
    id: room.value.id || roomId.value,
    title: room.value.title,
    cover: room.value.cover,
    hostName: room.value.hostName,
    hostAvatar: room.value.hostAvatar,
  }
  const index = feedItems.value.findIndex((item) => item.id === current.id)
  if (index >= 0) feedItems.value.splice(index, 1, toFeedItem(current))
  else feedItems.value.push(toFeedItem(current))
}

async function initializeFeed(targetRoomId: string, requestVersion: number) {
  if (feedInitializedRoomId === targetRoomId || !isCurrentRoomRequest(targetRoomId, requestVersion)) return
  try {
    const circleId = room.value.visibility === 'CIRCLE_ONLY' ? room.value.circleId : undefined
    const candidates = await getLiveFeed(circleId)
    if (!isCurrentRoomRequest(targetRoomId, requestVersion)) return
    const current = toFeedItem({
      id: room.value.id,
      title: room.value.title,
      cover: room.value.cover,
      hostName: room.value.hostName,
      hostAvatar: room.value.hostAvatar,
    })
    const rest = candidates
      .filter((item) => item.id && item.id !== current.id)
      .map((item) => toFeedItem(item))
    feedItems.value = [current, ...rest]
    feedIndex.value = 0
    feedInitializedRoomId = targetRoomId
    void preloadAdjacentRooms()
  } catch {
    // 推荐流不可用不影响当前直播；仍保留单房间观看。
  }
}

async function preloadAdjacentRooms() {
  const indexes = [feedIndex.value - 1, feedIndex.value + 1]
  for (const index of indexes) {
    const item = feedItems.value[index]
    if (!item || playUrlCache.has(item.id)) continue
    void liveApi.getPlayUrl(item.id)
      .then((url) => playUrlCache.set(item.id, url))
      .catch(() => undefined)
  }
}

async function leavePublicScreen() {
  if (offTimMessage) { offTimMessage(); offTimMessage = null }
  const groupId = timGroupId
  timGroupId = ''
  if (groupId) await tim.quitGroup(groupId).catch(() => undefined)
}

async function joinPublicScreen(groupId: string, targetRoomId: string, requestVersion: number) {
  if (!groupId || !isCurrentRoomRequest(targetRoomId, requestVersion) || groupId === timGroupId) return
  await leavePublicScreen()
  if (!isCurrentRoomRequest(targetRoomId, requestVersion)) return
  try {
    await tim.joinGroup(groupId)
    // 切房期间旧群可能在 join 返回后才完成，必须主动退回，不能覆盖新群订阅。
    if (!isCurrentRoomRequest(targetRoomId, requestVersion)) {
      await tim.quitGroup(groupId).catch(() => undefined)
      return
    }
    timGroupId = groupId
    offTimMessage = tim.onMessage((messages: TimMessage[]) => {
      const incoming = messages.filter((message) =>
        timGroupId === groupId && message.conversationType === 'GROUP' && message.to === groupId,
      )
      for (const message of incoming) {
        const giftEvent = readLiveGiftTimEvent(message)
        const content = giftEvent ? formatLiveGiftTimEvent(giftEvent) : message.payload?.text || ''
        if (!content || consumeLocalEcho(message, content)) continue
        comments.value.push({
          id: message.ID,
          userName: message.nick || '观众',
          content,
          type: giftEvent ? 'gift' : 'text',
        })
      }
      if (comments.value.length > 60) comments.value.splice(0, comments.value.length - 60)
    })
  } catch {
    // IM 暂不可用时仍允许通过业务接口发送，主播端轮询可看到持久化消息。
  }
}

function retainWatchCapabilities(next: LiveWatchRoomInfo): LiveWatchRoomInfo {
  return {
    ...next,
    allowComment: room.value.allowComment,
    allowLike: room.value.allowLike,
    allowGift: room.value.allowGift,
    canComment: room.value.canComment,
    canLike: room.value.canLike,
    canGift: room.value.canGift,
  }
}

function applyWatchContext(context: LiveWatchContext) {
  room.value = {
    ...room.value,
    viewerCount: context.online.count,
    status: context.room.status || room.value.status,
    visibility: context.room.visibility || room.value.visibility,
    allowComment: context.interaction.allowComment,
    allowLike: context.interaction.allowLike,
    allowGift: context.interaction.allowGift && context.room.allowGift,
    canComment: context.viewer.canComment,
    canLike: context.viewer.canLike,
    canGift: context.viewer.canGift,
    // 服务端有意不暴露在线身份；保持空数组，不伪造头像。
    onlineAvatars: [],
  }
}

function mergeHistoricalComments(history: VerticalLiveComment[]) {
  if (!history.length) return
  const byId = new Map<string, VerticalLiveComment>()
  for (const item of history) byId.set(String(item.id), item)
  for (const item of comments.value) byId.set(String(item.id), item)
  comments.value = Array.from(byId.values()).slice(-60)
}

async function refreshWatchContext(targetRoomId = roomId.value, requestVersion = roomLoadVersion, includeComments = false) {
  if (!targetRoomId) return
  const context = await liveApi.getWatchContext(targetRoomId)
  if (!context || !isCurrentRoomRequest(targetRoomId, requestVersion)) return
  applyWatchContext(context)
  if (!includeComments) return
  const history = await liveApi.getWatchComments(targetRoomId, room.value.hostId)
  if (!isCurrentRoomRequest(targetRoomId, requestVersion)) return
  mergeHistoricalComments(history)
}

async function loadRoom() {
  const targetRoomId = roomId.value
  if (!targetRoomId) return
  const requestVersion = ++roomLoadVersion
  loading.value = true
  error.value = ''
  playerNotice.value = ''
  try {
    const detail = await liveApi.getWatchRoom(targetRoomId)
    if (!isCurrentRoomRequest(targetRoomId, requestVersion)) return
    room.value = detail.room
    comments.value = detail.comments
    products.value = detail.products
    // 不等待互动上下文和历史公屏，保证进房后尽快开始拉流；接口未部署时自然保持只看空态。
    void refreshWatchContext(targetRoomId, requestVersion, true)
    isFollowing.value = detail.room.isFollowing
    // 详情接口当前不携带观众私有的关注态；复用已有用户接口回读，避免已关注用户被误导为未关注。
    if (getToken() && detail.room.hostId) {
      void liveApi.isFollowingHost(detail.room.hostId).then((following) => {
        if (isCurrentRoomRequest(targetRoomId, requestVersion)) isFollowing.value = following
      }).catch(() => undefined)
    }
    syncCurrentFeedItem()
    if (!giftsLoaded) {
      giftsLoaded = true
      void liveApi.getGifts().then((data) => {
        gifts.value = data.gifts
        coinBalance.value = data.balance
        selectedGiftId.value ||= data.gifts[0]?.id || ''
      }).catch(() => undefined)
    }
    void initializeFeed(targetRoomId, requestVersion)
    if (roomEnded.value) {
      playUrl.value = null
      await finishMic()
      if (!isCurrentRoomRequest(targetRoomId, requestVersion)) return
      stopRoomPolling()
      scheduleEndAdvance()
      return
    }
    const cached = playUrlCache.get(targetRoomId)
    const nextPlayUrl = cached || await liveApi.getPlayUrl(targetRoomId)
    if (!isCurrentRoomRequest(targetRoomId, requestVersion)) return
    playUrl.value = nextPlayUrl
    playUrlCache.set(targetRoomId, nextPlayUrl)
    await nextTick()
    if (!isCurrentRoomRequest(targetRoomId, requestVersion)) return
    ensureAudiencePlayback()
    // 原生 video 的 @play 回调不是在线事实源；起播请求发出后立即登记观看会话。
    void touchPresence()
    if (detail.room.imGroupId) void joinPublicScreen(detail.room.imGroupId, targetRoomId, requestVersion)
    if (getToken() && detail.room.circleId) void liveApi.reportCircleChannelClick(detail.room.circleId)
  } catch (cause) {
    if (!isCurrentRoomRequest(targetRoomId, requestVersion)) return
    playUrl.value = null
    error.value = (cause as Error)?.message || '直播间加载失败，请重试'
  } finally {
    if (isCurrentRoomRequest(targetRoomId, requestVersion)) loading.value = false
  }
}

function clearEndAdvance() {
  if (endAdvanceTimer) { clearInterval(endAdvanceTimer); endAdvanceTimer = null }
  endCountdown.value = 3
}

function normalizeReturnRoute(value: unknown) {
  const source = String(value || '').trim()
  if (!source) return ''
  try {
    const route = decodeURIComponent(source)
    return route.startsWith('/') && !route.startsWith('//') && !route.includes('\\') ? route : ''
  } catch {
    return ''
  }
}

function returnToLiveEntrance() {
  if (returnRoute.value) {
    uni.reLaunch({ url: returnRoute.value })
    return
  }
  if (getCurrentPages().length > 1) {
    uni.navigateBack()
    return
  }
  // 深链或冷启动没有历史栈时，明确回到直播入口，不能落到与直播无关的首页。
  uni.reLaunch({ url: '/pkg-live/plaza/index' })
}

function scheduleEndAdvance() {
  if (endAdvanceTimer || !pageVisible.value) return
  // 下播后的三秒停留只用于给观众看清结束提示；在线会话要立即结束，不能把离场时机推迟到切房或卸载。
  void leavePresence()
  endCountdown.value = 3
  endAdvanceTimer = setInterval(() => {
    endCountdown.value -= 1
    if (endCountdown.value > 0) return
    clearEndAdvance()
    if (hasNextRoom.value) void switchToFeedIndex(feedIndex.value + 1)
    else returnToLiveEntrance()
  }, 1000)
}

async function switchToFeedIndex(index: number) {
  const next = feedItems.value[index]
  if (!next || next.id === roomId.value || switchingRoom) return
  switchingRoom = true
  const previousRoomId = roomId.value
  // 先使旧房间的详情、播放地址、TIM 订阅与轮询响应失效，再开始离房。
  roomLoadVersion += 1
  presenceActive.value = false
  clearEndAdvance()
  stopRoomPolling()
  clearPlayerRetry()
  playerRetryCount = 0
  closeActionPanels()
  // 在线统计、麦位释放和 TIM 退群都是尽力清理，不能让弱网阻塞上下滑切房。
  void leavePresence(previousRoomId)
  void removeMicRequest()
  void finishMic()
  void leavePublicScreen()
  playUrl.value = null
  products.value = []
  comments.value = []
  roomId.value = next.id
  room.value = { ...emptyRoom, id: next.id, title: next.title, cover: next.cover, hostName: next.hostName, hostAvatar: next.hostAvatar }
  feedIndex.value = index
  presenceActive.value = true
  try {
    await loadRoom()
    startRoomPolling()
    void preloadAdjacentRooms()
  } finally {
    switchingRoom = false
    // 任一步骤异常时仍恢复当前可见房间的会话资格，不能把观众永久留在无心跳状态。
    presenceActive.value = pageVisible.value
  }
}

function onFeedChange(event: { detail?: { current?: number } }) {
  const index = Number(event?.detail?.current)
  if (!Number.isInteger(index) || index < 0) return
  void switchToFeedIndex(index)
}

function stopRoomPolling() {
  if (roomPollTimer) {
    clearInterval(roomPollTimer)
    roomPollTimer = null
  }
}

function startRoomPolling() {
  if (roomPollTimer || roomEnded.value || !pageVisible.value) return
  roomPollTimer = setInterval(() => { void pollRoomStatus() }, 5000)
}

async function pollRoomStatus() {
  const targetRoomId = roomId.value
  const requestVersion = roomLoadVersion
  if (roomPolling || !targetRoomId || roomEnded.value || !pageVisible.value) return
  roomPolling = true
  try {
    const detail = await liveApi.getWatchRoom(targetRoomId)
    if (!isCurrentRoomRequest(targetRoomId, requestVersion)) return
    // 高频房间状态轮询只刷新基础事实；互动权限由首次进房、回前台和写入拒绝时的专属上下文刷新。
    room.value = retainWatchCapabilities(detail.room)
    products.value = detail.products
    if (micState.value === 'idle' && getToken() && canUseLiveMic) await checkMicInvitation(targetRoomId, requestVersion)
    if (!isCurrentRoomRequest(targetRoomId, requestVersion)) return
    await refreshPlaybackMode(targetRoomId, requestVersion)
    if (!isCurrentRoomRequest(targetRoomId, requestVersion)) return
    if (!roomEnded.value) return
    comments.value = detail.comments
    playUrl.value = null
    playerNotice.value = ''
    await finishMic()
    if (!isCurrentRoomRequest(targetRoomId, requestVersion)) return
    stopRoomPolling()
    scheduleEndAdvance()
  } catch {
    // 房间状态短暂查询失败不打断当前播放；下一轮继续确认。
  } finally {
    roomPolling = false
  }
}

async function checkMicInvitation(targetRoomId = roomId.value, requestVersion = roomLoadVersion) {
  if (!targetRoomId || micState.value !== 'idle' || !isCurrentRoomRequest(targetRoomId, requestVersion)) return
  try {
    const items = await liveMicApi.list(targetRoomId)
    if (!isCurrentRoomRequest(targetRoomId, requestVersion) || micState.value !== 'idle') return
    roomMics.value = items
    const invitation = items.find((item) => item.status === 'PENDING' && item.source === 'INVITE')
    if (!invitation) return
    micUserId = invitation.userId
    micInvitePending = true
    micMediaMode.value = invitation.mediaMode === 'VIDEO' ? 'VIDEO' : 'AUDIO'
    micState.value = 'invited'
    showMicSheet.value = true
  } catch {
    // 邀请发现失败不影响观看；房间轮询下一轮继续。
  }
}

/** 连麦开始/结束时在原流与独立混流间切换；只在模式变化时重载播放器。 */
async function refreshPlaybackMode(targetRoomId = roomId.value, requestVersion = roomLoadVersion) {
  if (!targetRoomId || roomEnded.value || !playUrl.value || !isCurrentRoomRequest(targetRoomId, requestVersion)) return
  try {
    const next = await liveApi.getPlayUrl(targetRoomId)
    if (!isCurrentRoomRequest(targetRoomId, requestVersion)) return
    const currentMode = playUrl.value.streamMode || 'ORIGIN'
    const nextMode = next.streamMode || 'ORIGIN'
    if (currentMode === nextMode) return
    playUrlCache.set(targetRoomId, next)
    playUrl.value = next
    playerNotice.value = nextMode === 'MIXED' ? '已切换至多人连麦画面' : '已返回主播画面'
  } catch {
    // 切流查询失败不打断当前画面，下一轮房间轮询继续恢复。
  }
}

function onPlayerReady() {
  clearPlayerRetry()
  playerRetryCount = 0
  error.value = ''
  playerNotice.value = ''
  void touchPresence()
}

/**
 * App 原生 video 在部分 Android 机型上只会完成 PREPARED，不会因为布尔 autoplay 自动 start。
 * 直播间已隐藏原生中央播放按钮，因此必须由页面在元数据就绪、切房和回到前台时显式起播。
 */
function ensureAudiencePlayback() {
  if (!playUrl.value || roomEnded.value) return
  void nextTick(() => {
    try {
      uni.createVideoContext('live-audience-player').play()
    } catch {
      // 元素仍在挂载时由 loadedmetadata 再次驱动，不把短暂竞态升级成播放错误。
    }
  })
}

function clearPlayerRetry() {
  if (playerRetryTimer) {
    clearTimeout(playerRetryTimer)
    playerRetryTimer = null
  }
}

function retryPlayback() {
  clearPlayerRetry()
  playerRetryCount = 0
  void loadRoom()
}

function onPlayerError() {
  if (roomEnded.value || playerRetryTimer) return
  playerRetryCount += 1
  if (playerRetryCount > 5) {
    playUrl.value = null
    loading.value = false
    error.value = '画面连续恢复失败，请检查网络后重试，或上下滑动切换其他直播间'
    playerNotice.value = ''
    return
  }
  const delay = Math.min(800 * (2 ** (playerRetryCount - 1)), 8_000)
  playerNotice.value = `网络波动，${Math.ceil(delay / 1000)} 秒后尝试第 ${playerRetryCount} 次恢复…`
  playerRetryTimer = setTimeout(() => {
    playerRetryTimer = null
    void loadRoom()
  }, delay)
}

function openCommentComposer() {
  if (!getToken()) {
    uni.showToast({ title: '登录后可以参与公屏互动', icon: 'none' })
    return
  }
  if (!room.value.canComment) {
    uni.showToast({ title: room.value.allowComment ? '当前账号暂不能发言' : '本场暂未开放公屏互动', icon: 'none' })
    return
  }
  showCommentComposer.value = true
}

function closeCommentComposer() {
  showCommentComposer.value = false
}

function closeActionPanels() {
  showGiftPanel.value = false
  showProductPanel.value = false
  showMorePanel.value = false
}

function openProductPanel() {
  if (!products.value.length) return
  closeActionPanels()
  showProductPanel.value = true
}

function openGiftPanel() {
  if (!getToken()) {
    uni.showToast({ title: '登录后可以表达心意', icon: 'none' })
    return
  }
  if (!room.value.canGift) {
    uni.showToast({ title: room.value.allowGift ? '当前账号暂不能表达心意' : '本场暂未开放心意互动', icon: 'none' })
    return
  }
  closeActionPanels()
  showGiftPanel.value = true
  giftPolicyLoading.value = true
  void Promise.all([liveApi.getGifts(), getLiveGiftSpendingPreference()])
    .then(([data, preference]) => {
      gifts.value = data.gifts
      coinBalance.value = data.balance
      giftPolicy.value = preference
      singleLimitDraft.value = String(preference.singleLimitCoin || 100)
      dailyLimitDraft.value = String(preference.dailyLimitCoin || 500)
      if (!gifts.value.some((gift) => gift.id === selectedGiftId.value)) {
        selectedGiftId.value = gifts.value[0]?.id || ''
      }
    })
    .catch((cause) => {
      uni.showToast({ title: (cause as Error)?.message || '消费保护设置读取失败', icon: 'none' })
    })
    .finally(() => { giftPolicyLoading.value = false })
}

async function saveGiftPolicy() {
  if (savingGiftPolicy.value) return
  const singleLimitCoin = Number(singleLimitDraft.value)
  const dailyLimitCoin = Number(dailyLimitDraft.value)
  if (!Number.isInteger(singleLimitCoin) || !Number.isInteger(dailyLimitCoin) || singleLimitCoin < 1 || dailyLimitCoin < singleLimitCoin) {
    uni.showToast({ title: '每日限额须为整数且不低于单次限额', icon: 'none' })
    return
  }
  savingGiftPolicy.value = true
  try {
    giftPolicy.value = await updateLiveGiftSpendingPreference({
      singleLimitCoin,
      dailyLimitCoin,
      reminderEnabled: true,
    })
    uni.showToast({ title: '消费限额已生效', icon: 'none' })
  } catch (cause) {
    uni.showToast({ title: (cause as Error)?.message || '限额保存失败', icon: 'none' })
  } finally {
    savingGiftPolicy.value = false
  }
}

function openMorePanel() {
  closeActionPanels()
  showMorePanel.value = true
}

function openProduct(product: VerticalLiveProduct) {
  if (product.stock <= 0) return
  closeActionPanels()
  uni.navigateTo({
    url: `/pkg-shop/checkout/index?productId=${encodeURIComponent(product.id)}&quantity=1&sourceContentType=LIVE&sourceContentId=${encodeURIComponent(room.value.id)}`,
  })
}

function confirmSendGift() {
  const gift = selectedGift.value
  if (!gift || sendingGift.value) return
  if (!room.value.canGift) {
    uni.showToast({ title: room.value.allowGift ? '当前账号暂不能表达心意' : '本场暂未开放心意互动', icon: 'none' })
    return
  }
  if (!giftPolicyReady.value) {
    uni.showToast({ title: '请先完成消费保护设置', icon: 'none' })
    return
  }
  if (coinBalance.value < gift.price) {
    uni.showToast({ title: '国学币余额不足', icon: 'none' })
    return
  }
  uni.showModal({
    title: '确认送出心意',
    content: `${gift.name} · ${gift.price} 国学币\n当前余额 ${coinBalance.value} 国学币`,
    confirmText: '确认送出',
    success: (result) => { if (result.confirm) void sendGift(gift) },
  })
}

async function sendGift(gift: LiveGift) {
  if (sendingGift.value) return
  if (!room.value.canGift) {
    uni.showToast({ title: room.value.allowGift ? '当前账号暂不能表达心意' : '本场暂未开放心意互动', icon: 'none' })
    void refreshWatchContext(room.value.id, roomLoadVersion)
    return
  }
  sendingGift.value = true
  const echoContent = `送出 ${gift.name} x1`
  const echoToken = rememberLocalEcho(echoContent)
  try {
    await sendLiveGift(room.value.id, gift.id, 1)
    coinBalance.value = Math.max(0, coinBalance.value - gift.price)
    if (giftPolicy.value) giftPolicy.value.spentTodayCoin += gift.price
    comments.value.push({
      id: `gift-${Date.now()}`,
      userName: '我',
      content: echoContent,
      type: 'gift',
    })
    showGiftPanel.value = false
    uni.showToast({ title: '心意已送达', icon: 'none' })
  } catch (cause) {
    forgetLocalEcho(echoContent, echoToken)
    void refreshWatchContext(room.value.id, roomLoadVersion)
    uni.showToast({ title: (cause as Error)?.message || '发送失败，请重试', icon: 'none' })
  } finally {
    sendingGift.value = false
  }
}

function clearMicTimers() {
  if (micPollTimer) { clearInterval(micPollTimer); micPollTimer = null }
  if (micDurationTimer) { clearInterval(micDurationTimer); micDurationTimer = null }
}

function openMicSheet() {
  if (!getToken()) {
    uni.showToast({ title: '登录后可以申请连麦', icon: 'none' })
    return
  }
  showMicSheet.value = true
}

async function requestMic() {
  if (!room.value.id || micState.value === 'requesting' || micState.value === 'connecting') return
  micError.value = ''
  micState.value = 'requesting'
  try {
    // 申请排队不应触发系统相机/麦克风弹窗；只有主播接受后才进入设备预检。
    const mic = await liveMicApi.request(room.value.id, micMediaMode.value)
    micUserId = mic.userId
    micPollTimer ||= setInterval(() => { void pollMicStatus() }, 1600)
  } catch (cause) {
    micError.value = (cause as Error)?.message || '连麦申请失败'
    micState.value = 'error'
  }
}

async function pollMicStatus() {
  if (micPolling || !room.value.id) return
  micPolling = true
  try {
    const items = await liveMicApi.list(room.value.id)
    roomMics.value = items
    const mic = items.find((item) => !micUserId || item.userId === micUserId)
    if (!mic) {
      if (micState.value === 'connected') await finishMic()
      else if (micState.value === 'preflight' || micState.value === 'connecting') {
        await finishMic()
        micError.value = '本次连麦已取消或失效'
        micState.value = 'error'
        showMicSheet.value = true
      }
      else if (micState.value === 'requesting') {
        clearMicTimers()
        micError.value = '主播未接受本次申请'
        micState.value = 'error'
      }
      return
    }
    micUserId = mic.userId
    if (mic.status === 'PENDING') return
    if (micState.value === 'requesting') await prepareMicPreflight(mic)
    if (micState.value === 'connected') {
      const hostMuted = mic.status === 'MUTED'
      micHostMuted.value = hostMuted
      applyMicMuteState(hostMuted || micMuted.value)
      if (Date.now() - lastMicReadyAt > 15_000) void renewMicReady()
    }
  } catch (cause) {
    if (micState.value === 'requesting' || micState.value === 'connecting') {
      clearMicTimers()
      micError.value = (cause as Error)?.message || '连麦状态查询失败'
      micState.value = 'error'
    }
  } finally {
    micPolling = false
  }
}

async function connectMic(mic: LiveMicItem) {
  micState.value = 'connecting'
  micMediaMode.value = mic.mediaMode === 'VIDEO' ? 'VIDEO' : 'AUDIO'
  try {
    const config = await liveMicApi.getRtcConfig(room.value.id)
    rtcHostUserId.value = config.hostTrtcUserId || config.hostUserId || ''
    appliedMicMuteState = null
    if (config.mediaMode === 'VIDEO') {
      await nextTick()
      await joinLiveVideo(config, rtcGuestViewId)
    } else {
      await joinLiveAudio(config)
    }
    micState.value = 'connected'
    preflightMic = null
    micInvitePending = false
    applyMicMuteState(micMuted.value)
    if (micMediaMode.value === 'VIDEO') setLiveVideoMuted(micVideoMuted.value)
    micDurationTimer ||= setInterval(() => { micDuration.value += 1 }, 1000)
    lastMicReadyAt = 0
    void renewMicReady()
  } catch (cause) {
    leaveLiveAudio()
    micError.value = (cause as Error)?.message || '语音链路建立失败'
    micState.value = 'error'
  }
}

async function acceptMicInvite() {
  if (!room.value.id || micState.value !== 'invited') return
  try {
    const items = await liveMicApi.list(room.value.id)
    roomMics.value = items
    const invitation = items.find((item) => item.status === 'PENDING' && item.source === 'INVITE')
    if (!invitation) throw new Error('连麦邀请已失效')
    await prepareMicPreflight(invitation)
  } catch (cause) {
    micError.value = (cause as Error)?.message || '连麦邀请接受失败'
    // 权限或响应请求失败时邀请仍可能有效，保留“接受邀请”语义，禁止重试误发新申请。
    micState.value = 'invited'
  }
}

async function prepareMicPreflight(mic: LiveMicItem) {
  micUserId = mic.userId
  micMediaMode.value = mic.mediaMode === 'VIDEO' ? 'VIDEO' : 'AUDIO'
  try {
    if (micMediaMode.value === 'VIDEO') {
      await ensureLiveCapturePermissions()
      micState.value = 'preflight'
      showMicSheet.value = true
      await nextTick()
      startLiveDevicePreview(rtcGuestViewId, guestFrontCamera.value)
    } else {
      await ensureLiveAudioPermission()
      micState.value = 'preflight'
      showMicSheet.value = true
    }
    preflightMic = mic
  } catch (cause) {
    // 主播已接受但设备预检失败时立即释放麦位，不能让一次拒绝授权占住申请。
    void removeMicRequest()
    throw cause
  }
}

async function confirmMicJoin() {
  if (!room.value.id || micState.value !== 'preflight' || !preflightMic) return
  micError.value = ''
  try {
    let active = preflightMic
    if (micInvitePending) {
      active = await liveMicApi.respondInvite(room.value.id, 'ACCEPT') as LiveMicItem
    }
    await connectMic(active)
    micPollTimer ||= setInterval(() => { void pollMicStatus() }, 1600)
  } catch (cause) {
    micError.value = (cause as Error)?.message || '连麦加入失败'
    micState.value = 'error'
  }
}

async function declineMicInvite() {
  if (!room.value.id) return
  try { await liveMicApi.respondInvite(room.value.id, 'DECLINE') } catch {}
  micUserId = ''
  micInvitePending = false
  preflightMic = null
  showMicSheet.value = false
  micState.value = 'idle'
}

async function renewMicReady() {
  if (!room.value.id || micState.value !== 'connected') return
  lastMicReadyAt = Date.now()
  try {
    await liveMicApi.ready(room.value.id)
  } catch {
    // 混流是普通观众的增强链路；续租失败不能切断已建立的 TRTC 连麦。
  }
}

function handleRemoteVideoAvailability(userId: string, available: boolean) {
  const existing = remoteVideoUsers.value.find((item) => item.userId === userId)
  if (!available) {
    stopLiveRemoteVideo(userId)
    remoteVideoUsers.value = remoteVideoUsers.value.filter((item) => item.userId !== userId)
    return
  }
  if (existing) {
    void nextTick(() => startLiveRemoteVideo(userId, existing.viewId))
    return
  }
  const viewId = `guest-remote-${remoteVideoUsers.value.length}-${Date.now().toString(36)}`
  remoteVideoUsers.value.push({ userId, viewId })
  void nextTick(() => startLiveRemoteVideo(userId, viewId))
}

function handleMicConnectionState(state: 'connected' | 'reconnecting' | 'lost') {
  if (micState.value !== 'connected' && micState.value !== 'connecting') return
  if (state === 'connected') {
    micError.value = ''
    micState.value = 'connected'
    return
  }
  micState.value = 'connecting'
  micError.value = state === 'lost' ? '连麦网络已断开，正在自动恢复…' : ''
}

function toggleMicMute() {
  if (micHostMuted.value) {
    uni.showToast({ title: '主播已将你静音', icon: 'none' })
    return
  }
  micMuted.value = !micMuted.value
  if (micState.value === 'connected') applyMicMuteState(micMuted.value)
}

function applyMicMuteState(muted: boolean) {
  if (appliedMicMuteState === muted) return
  appliedMicMuteState = muted
  setLiveAudioMuted(muted)
}

function toggleMicVideo() {
  micVideoMuted.value = !micVideoMuted.value
  setLiveVideoMuted(micVideoMuted.value)
}

function flipGuestCamera() {
  guestFrontCamera.value = !guestFrontCamera.value
  switchLiveCamera(guestFrontCamera.value)
}

async function removeMicRequest() {
  if (!room.value.id || !micUserId) return
  const userId = micUserId
  micUserId = ''
  try { await liveMicApi.leave(room.value.id, userId) } catch {}
}

async function finishMic() {
  clearMicTimers()
  for (const item of remoteVideoUsers.value) stopLiveRemoteVideo(item.userId)
  remoteVideoUsers.value = []
  roomMics.value = []
  leaveLiveAudio()
  micState.value = 'idle'
  micDuration.value = 0
  micMuted.value = false
  micHostMuted.value = false
  appliedMicMuteState = null
  micVideoMuted.value = false
  rtcHostUserId.value = ''
  micInvitePending = false
  preflightMic = null
  lastMicReadyAt = 0
  showMicSheet.value = false
}

async function hangUpMic() {
  await removeMicRequest()
  await finishMic()
}

async function closeMicSheet() {
  await removeMicRequest()
  await finishMic()
}

function resetMic() {
  micError.value = ''
  micState.value = 'idle'
}

async function retryMic() {
  if (!room.value.id) return
  micError.value = ''
  try {
    const items = await liveMicApi.list(room.value.id)
    roomMics.value = items
    const existing = items.find((item) => !micUserId || item.userId === micUserId)
    if (existing?.status === 'PENDING' && existing.source === 'INVITE') {
      micUserId = existing.userId
      micMediaMode.value = existing.mediaMode === 'VIDEO' ? 'VIDEO' : 'AUDIO'
      micInvitePending = true
      micState.value = 'invited'
      await acceptMicInvite()
      return
    }
    if (existing && (existing.status === 'OCCUPIED' || existing.status === 'MUTED')) {
      micUserId = existing.userId
      micInvitePending = false
      await prepareMicPreflight(existing)
      return
    }
    resetMic()
    await requestMic()
  } catch (cause) {
    micError.value = (cause as Error)?.message || '连麦状态恢复失败'
    micState.value = 'error'
  }
}

async function sendComment() {
  const content = commentDraft.value.trim()
  if (!content || sendingComment) return
  if (!room.value.canComment) {
    uni.showToast({ title: room.value.allowComment ? '当前账号暂不能发言' : '本场暂未开放公屏互动', icon: 'none' })
    return
  }
  sendingComment = true
  const localId = `local-${Date.now()}`
  comments.value.push({ id: localId, userName: '我', content, type: 'text' })
  const echoToken = rememberLocalEcho(content)
  commentDraft.value = ''
  showCommentComposer.value = false
  try {
    // 服务端审核、禁言和慢速模式通过后统一中继到 TIM；客户端禁止绕过业务闸门直发。
    await liveApi.sendComment(room.value.id, content)
  } catch (cause) {
    forgetLocalEcho(content, echoToken)
    comments.value = comments.value.filter((item) => String(item.id) !== localId)
    commentDraft.value = content
    showCommentComposer.value = true
    void refreshWatchContext(room.value.id, roomLoadVersion)
    uni.showToast({ title: (cause as Error)?.message || '消息发送失败，请重试', icon: 'none' })
  } finally {
    sendingComment = false
  }
}

async function sendLike() {
  if (!room.value.canLike) {
    const title = !getToken() ? '登录后可以点赞' : room.value.allowLike ? '当前账号暂不能点赞' : '本场暂未开放点赞'
    uni.showToast({ title, icon: 'none' })
    return
  }
  const particle: LikeParticle = {
    id: ++likeParticleSequence,
    variant: likeParticleSequence % 3,
    frame: 0,
  }
  likeParticles.value.push(particle)
  startLikeParticleTicker()
  try {
    const result = await likeLiveRoom(room.value.id)
    room.value.likeCount = result.likeCount
  } catch (cause) {
    void refreshWatchContext(room.value.id, roomLoadVersion)
    uni.showToast({ title: (cause as Error)?.message || '点赞失败，请重试', icon: 'none' })
  }
}

async function toggleFollow() {
  if (!room.value.hostId || followBusy) return
  followBusy = true
  const previous = isFollowing.value
  isFollowing.value = !previous
  try {
    if (previous) await liveApi.unfollowHost(room.value.hostId)
    else await liveApi.followHost(room.value.hostId)
  } catch (cause) {
    isFollowing.value = previous
    uni.showToast({ title: (cause as Error)?.message || '关注操作失败', icon: 'none' })
  } finally {
    followBusy = false
  }
}

function shareRoom() {
  closeActionPanels()
  const url = withRef(buildH5Url('pkg-live/watch/index', { id: roomId.value }))
  uni.setClipboardData({
    data: url,
    success: () => uni.showToast({ title: '直播链接已复制', icon: 'none' }),
  })
}

function reportRoom() {
  closeActionPanels()
  gotoReport('LIVE', room.value.id, room.value.title, room.value.hostName)
}

function showPlaybackInfo() {
  closeActionPanels()
  const quality = room.value.quality === 'uhd' ? '超清' : room.value.quality === 'hd' ? '高清' : '标清'
  const streamMode = micState.value === 'connected'
    ? 'TRTC 低延时连麦'
    : playUrl.value?.streamMode === 'MIXED' ? '多人云端合流' : '主播原始直播流'
  uni.showModal({
    title: '播放信息',
    content: `当前画质：${quality}\n当前链路：${streamMode}\n在线观众：${room.value.viewerCount}\n本次自动恢复：${playerRetryCount}/5\n播放方式：进入即自动播放`,
    showCancel: false,
  })
}

function requestClose() {
  uni.showModal({
    content: '确认退出直播间？',
    confirmText: '退出',
    cancelText: '继续观看',
    success: (result) => {
      if (!result.confirm) return
      void removeMicRequest().finally(() => returnToLiveEntrance())
    },
  })
}

function leaveEndedRoom() {
  clearEndAdvance()
  if (hasNextRoom.value) void switchToFeedIndex(feedIndex.value + 1)
  else returnToLiveEntrance()
}

onLoad((options) => {
  pageVisible.value = true
  presenceActive.value = true
  roomId.value = String(options?.id || '')
  returnRoute.value = normalizeReturnRoute(options?.returnRoute)
  if (!roomId.value) {
    loading.value = false
    error.value = '缺少直播间编号'
    return
  }
  feedItems.value = [{ id: roomId.value, title: '直播间', cover: '', hostName: '主播', hostAvatar: '' }]
  setLiveConnectionStateHandler(handleMicConnectionState)
  setLiveRemoteVideoAvailabilityHandler(handleRemoteVideoAvailability)
  void loadRoom()
  startRoomPolling()
})

onShow(() => {
  pageVisible.value = true
  presenceActive.value = true
  const shouldResume = resumeAfterHide
  resumeAfterHide = false
  if (roomEnded.value) {
    scheduleEndAdvance()
  } else if (roomId.value && !playUrl.value && (shouldResume || !loading.value)) {
    // 后台期间的加载请求已被代次取消，回到前台后总是由新的请求恢复。
    void loadRoom()
  }
  startRoomPolling()
  if (roomId.value && !loading.value) void refreshWatchContext(roomId.value, roomLoadVersion)
  if (roomId.value && playUrl.value) {
    ensureAudiencePlayback()
    void touchPresence()
  }
  if (appBackgroundSuspended) {
    appBackgroundSuspended = false
    if (micState.value === 'preflight' && micMediaMode.value === 'VIDEO') {
      void nextTick(() => startLiveDevicePreview(rtcGuestViewId, guestFrontCamera.value))
    } else if (micState.value === 'connected') {
      applyMicMuteState(micHostMuted.value || micMuted.value)
      if (micMediaMode.value === 'VIDEO') setLiveVideoMuted(micVideoMuted.value)
      void renewMicReady()
    }
  }
})

onHide(() => {
  // 先使所有在飞行请求失效，避免后台晚响应重新登记在线或改写当前房间。
  pageVisible.value = false
  presenceActive.value = false
  resumeAfterHide = true
  roomLoadVersion += 1
  stopRoomPolling()
  clearEndAdvance()
  clearPlayerRetry()
  try { uni.createVideoContext('live-audience-player').pause() } catch { /* 页面切换竞态可忽略 */ }
  void leavePresence()
  if (micState.value === 'preflight') {
    appBackgroundSuspended = true
    if (micMediaMode.value === 'VIDEO') stopLiveDevicePreview()
  } else if (micState.value === 'connecting' || micState.value === 'connected') {
    appBackgroundSuspended = true
    applyMicMuteState(true)
    if (micMediaMode.value === 'VIDEO') setLiveVideoMuted(true)
  }
})

onBackPress(() => {
  if (roomEnded.value) return false
  if (showGiftPanel.value || showProductPanel.value || showMorePanel.value) {
    closeActionPanels()
    return true
  }
  if (showCommentComposer.value) {
    closeCommentComposer()
    return true
  }
  if (showMicSheet.value) {
    void closeMicSheet()
    return true
  }
  requestClose()
  return true
})

onUnmounted(() => {
  pageVisible.value = false
  presenceActive.value = false
  roomLoadVersion += 1
  if (likeParticleTimer) clearInterval(likeParticleTimer)
  likeParticleTimer = null
  likeParticles.value = []
  if (offTimMessage) offTimMessage()
  if (timGroupId) void tim.quitGroup(timGroupId)
  stopRoomPolling()
  clearEndAdvance()
  clearPlayerRetry()
  clearMicTimers()
  setLiveConnectionStateHandler(null)
  setLiveRemoteVideoAvailabilityHandler(null)
  leaveLiveAudio()
  void leavePresence()
  void removeMicRequest()
})
</script>

