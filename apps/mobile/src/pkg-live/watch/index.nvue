<template>
  <view class="viewer-page">
    <swiper
      class="room-feed"
      vertical
      :current="feedIndex"
      :duration="280"
      @change="onFeedChange"
    >
      <swiper-item v-for="item in feedItems" :key="item.id">
        <view class="feed-stage">
          <video
            v-if="item.id === roomId && playUrl"
            id="live-audience-player"
            class="live-video"
            :src="playUrl.hls"
            autoplay
            :controls="false"
            :show-center-play-btn="false"
            :show-play-btn="false"
            :show-fullscreen-btn="false"
            :show-progress="false"
            :enable-progress-gesture="false"
            :muted="micRealtimeAudioActive"
            :object-fit="room.orientation === 'landscape' ? 'contain' : 'cover'"
            @loadedmetadata="ensureAudiencePlayback"
            @play="onPlayerReady"
            @error="onPlayerError"
          />
          <image v-else-if="item.cover" class="feed-cover" :src="item.cover" mode="aspectFill" />
          <view v-else class="feed-ink-placeholder">
            <view class="feed-seal"><text class="feed-seal-text">热卜</text></view>
            <text class="feed-placeholder-title">国学直播</text>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <TRTCCloudUniPlugin-TXRemoteViewComponent
      v-for="(item, index) in orderedRemoteVideoUsers"
      :key="item.viewId"
      :userId="item.userId"
      :viewId="item.viewId"
      class="rtc-remote-video"
      :style="rtcRemoteVideoStyle(index)"
    />
    <cover-view
      v-for="(item, index) in orderedRemoteVideoUsers"
      :key="`label-${item.viewId}`"
      class="rtc-remote-label-layer"
      :style="rtcRemoteVideoStyle(index)"
    >
      <text class="rtc-remote-label">{{ remoteVideoLabel(item.userId) }}</text>
    </cover-view>
    <TRTCCloudUniPlugin-TXLocalViewComponent
      v-if="micMediaMode === 'VIDEO' && (micState === 'preflight' || micState === 'connecting' || micState === 'connected')"
      :viewId="rtcGuestViewId"
      class="rtc-guest-preview"
      :style="rtcGuestPreviewStyle"
    />

    <view v-if="!playUrl" class="video-placeholder">
      <view class="loading-seal"><text class="loading-seal-text">播</text></view>
      <text class="placeholder-title">{{ loading ? '正在进入直播间' : '暂时无法播放直播' }}</text>
      <text class="placeholder-detail">{{ error || '正在获取直播画面…' }}</text>
      <view v-if="!loading" class="retry-button" @click="retryPlayback">
        <text class="retry-button-text">重新连接</text>
      </view>
    </view>

    <view class="shade-top" :style="shadeTopStyle" />
    <view class="shade-bottom" :style="shadeBottomStyle" />

    <cover-view class="topbar" :style="topbarStyle">
      <view class="host-card">
        <image v-if="room.hostAvatar" class="host-avatar" :src="room.hostAvatar" mode="aspectFill" />
        <view v-else class="host-avatar host-avatar-fallback">
          <text class="host-avatar-text">{{ hostInitial }}</text>
        </view>
        <view class="host-copy">
          <view class="host-name-row">
            <text class="host-name">{{ room.hostName || '主播' }}</text>
            <view class="host-verified"><text class="host-verified-text">卜</text></view>
          </view>
          <text class="host-sub">{{ room.followers != null ? `${formatCount(room.followers)} 关注者` : (room.circleName || '热卜直播') }}</text>
        </view>
        <view class="follow-button" :class="{ followed: isFollowing }" @click="toggleFollow">
          <text class="follow-button-text">{{ isFollowing ? '已关注' : '关注' }}</text>
        </view>
      </view>

      <view class="top-actions">
        <view class="viewer-count">
          <view v-if="visibleAudienceAvatars.length" class="audience-stack">
            <image
              v-for="(avatar, index) in visibleAudienceAvatars"
              :key="`${avatar}-${index}`"
              class="audience-avatar"
              :class="{ 'audience-avatar-overlap': index > 0 }"
              :src="avatar"
              mode="aspectFill"
            />
          </view>
          <view class="viewer-live-dot" />
          <text class="viewer-count-text">{{ formatCount(room.viewerCount) }}</text>
        </view>
        <view class="round-button close-button" @click="requestClose">
          <text class="round-button-icon">×</text>
        </view>
      </view>
    </cover-view>

    <cover-view class="room-meta" :style="roomMetaStyle">
      <view class="room-kicker-row">
        <view class="live-seal">
          <view class="live-dot" />
          <text class="live-seal-text">直播</text>
        </view>
        <text class="room-scope">{{ room.visibility === 'CIRCLE_ONLY' ? `圈内${room.circleName ? ` · ${room.circleName}` : ''}` : '全平台可见' }}</text>
        <view v-if="publicConnectedMics.length" class="cohost-chip">
          <text class="cohost-chip-text">连麦 {{ publicConnectedMics.length }}</text>
        </view>
        <view v-if="qualityLabel" class="quality-chip">
          <text class="quality-chip-text">{{ qualityLabel }}</text>
        </view>
      </view>
      <text class="room-title">{{ room.title || '直播间' }}</text>
      <view class="live-safety-strip">
        <text class="live-safety-mark">i</text>
        <text class="live-safety-text">文明互动 · 理性消费 · 内容仅供文化交流参考</text>
      </view>
      <text v-if="playerNotice" class="player-notice">{{ playerNotice }}</text>
      <text v-else-if="feedItems.length > 1" class="swipe-hint">上下滑动，切换直播间</text>
    </cover-view>

    <cover-view v-if="products.length" class="product-float" :style="productFloatStyle" @click="openProductPanel">
      <image v-if="products[0].cover" class="product-float-cover" :src="products[0].cover" mode="aspectFill" />
      <view v-else class="product-float-cover product-float-fallback"><text class="product-float-fallback-text">品</text></view>
      <view class="product-float-copy">
        <text class="product-float-kicker">{{ products[0].isExplaining ? '主播正在讲解' : `本场好物 · ${products.length} 件` }}</text>
        <text class="product-float-name">{{ products[0].name }}</text>
      </view>
      <text class="product-float-price">¥{{ formatPrice(products[0].price) }}</text>
    </cover-view>

    <cover-view class="social-rail" :style="socialRailStyle">
      <view v-if="products.length" class="rail-action" @click="openProductPanel">
        <view class="rail-icon-shell commerce-shell">
          <text class="rail-icon-word">品</text>
          <view class="rail-count-badge"><text class="rail-count-text">{{ products.length }}</text></view>
        </view>
        <text class="rail-label">好物</text>
      </view>
      <view class="rail-action" @click="openGiftPanel">
        <view class="rail-icon-shell gift-shell"><text class="rail-icon-word">礼</text></view>
        <text class="rail-label">心意</text>
      </view>
      <view class="rail-action" @click="sendLike">
        <view class="rail-icon-shell like-shell"><text class="rail-icon-like">♥</text></view>
        <text class="rail-label">{{ room.likeCount ? formatCount(room.likeCount) : '点赞' }}</text>
      </view>
      <view v-if="canUseLiveMic" class="rail-action" @click="openMicSheet">
        <view class="rail-icon-shell mic-badge"><text class="rail-icon-word">麦</text></view>
        <text class="rail-label">{{ micState === 'connected' ? '连麦中' : micState === 'requesting' ? '等待中' : '连麦' }}</text>
      </view>
      <view class="rail-action" @click="openMorePanel">
        <view class="rail-icon-shell"><text class="rail-icon-more">•••</text></view>
        <text class="rail-label">更多</text>
      </view>
    </cover-view>

    <cover-view class="comment-stack" :style="commentStackStyle">
      <view v-if="visibleComments.length === 0" class="system-tip">
        <text class="system-tip-mark">热卜</text>
        <text class="system-tip-text">和主播打个招呼吧</text>
      </view>
      <view v-for="item in visibleComments" :key="String(item.id)" class="comment-row" :class="{ 'comment-row-gift': item.type === 'gift' }">
        <text v-if="item.type === 'gift'" class="comment-gift-mark">心意</text>
        <text class="comment-user">{{ item.userName || '观众' }}</text>
        <text class="comment-content">{{ item.content }}</text>
      </view>
    </cover-view>

    <cover-view class="bottom-dock" :style="bottomDockStyle">
      <view class="comment-entry" @click="openCommentComposer">
        <text class="comment-entry-text">说点什么…</text>
        <text class="comment-entry-send">➤</text>
      </view>
      <view class="dock-share" @click="shareRoom">
        <text class="dock-share-icon">↗</text>
        <text class="dock-share-label">分享</text>
      </view>
    </cover-view>

    <cover-view v-if="likeParticles.length" class="like-feedback" :style="likeFeedbackStyle">
      <text
        v-for="particle in likeParticles"
        :key="particle.id"
        class="like-particle"
        :class="`like-particle-${particle.variant}`"
        :style="likeParticleStyle(particle)"
      >♥</text>
    </cover-view>

    <cover-view v-if="showCommentComposer" class="composer-mask" @click="closeCommentComposer">
      <view class="composer-sheet" :style="composerSheetStyle" @click.stop>
        <view class="composer-head">
          <text class="composer-title">发送公屏消息</text>
          <text class="composer-cancel" @click="closeCommentComposer">取消</text>
        </view>
        <view class="composer-row">
          <input
            v-model="commentDraft"
            class="composer-input"
            :focus="showCommentComposer"
            maxlength="120"
            confirm-type="send"
            placeholder="和主播、观众聊聊…"
            placeholder-class="composer-placeholder"
            @confirm="sendComment"
          />
          <view class="composer-send" :class="{ disabled: !commentDraft.trim() }" @click="sendComment">
            <text class="composer-send-text">发送</text>
          </view>
        </view>
      </view>
    </cover-view>

    <cover-view v-if="showMicSheet && micState !== 'connected'" class="mic-mask" @click="closeMicSheet">
      <view class="mic-sheet" :style="micSheetStyle" @click.stop>
        <view class="sheet-handle" />
        <view v-if="micState === 'idle'" class="mic-state">
          <view class="mic-symbol"><text class="mic-symbol-text">连</text></view>
          <text class="mic-title">申请与主播连麦</text>
          <text class="mic-detail">选择语音或视频；主播同意后才会开启对应设备和低延时链路。</text>
          <view class="mic-mode-row">
            <view class="mic-mode" :class="{ selected: micMediaMode === 'AUDIO' }" @click="micMediaMode = 'AUDIO'">
              <text class="mic-mode-title">语音连麦</text>
              <text class="mic-mode-detail">只使用麦克风</text>
            </view>
            <view class="mic-mode mic-mode-video" :class="{ selected: micMediaMode === 'VIDEO' }" @click="micMediaMode = 'VIDEO'">
              <text class="mic-mode-title">视频连麦</text>
              <text class="mic-mode-detail">相机与麦克风</text>
            </view>
          </view>
          <view class="mic-primary" @click="requestMic"><text class="mic-primary-text">申请{{ micMediaMode === 'VIDEO' ? '视频' : '语音' }}连麦</text></view>
          <view class="mic-ghost" @click="closeMicSheet"><text class="mic-ghost-text">暂不连麦</text></view>
        </view>
        <view v-else-if="micState === 'requesting'" class="mic-state">
          <view class="mic-symbol mic-symbol-wait"><text class="mic-symbol-text">…</text></view>
          <text class="mic-title">等待主播同意</text>
          <text class="mic-detail">申请已送达；主播可在直播间或控制台接受。</text>
          <view class="mic-secondary" @click="closeMicSheet"><text class="mic-primary-text">取消申请</text></view>
        </view>
        <view v-else-if="micState === 'invited'" class="mic-state">
          <view class="mic-symbol mic-symbol-invite"><text class="mic-symbol-text">邀</text></view>
          <text class="mic-title">主播邀请你{{ micMediaMode === 'VIDEO' ? '视频' : '语音' }}连麦</text>
          <text class="mic-detail">接受后才会申请{{ micMediaMode === 'VIDEO' ? '摄像头与麦克风' : '麦克风' }}权限；你可以随时静音或退出。</text>
          <view class="mic-primary" @click="acceptMicInvite"><text class="mic-primary-text">接受邀请</text></view>
          <view class="mic-ghost" @click="declineMicInvite"><text class="mic-ghost-text">暂不连麦</text></view>
        </view>
        <view v-else-if="micState === 'preflight'" class="mic-state">
          <view class="mic-symbol mic-symbol-ready"><text class="mic-symbol-text">检</text></view>
          <text class="mic-title">加入前设备检查</text>
          <text class="mic-detail">{{ micMediaMode === 'VIDEO' ? '右上角是仅本机可见的摄像头预览；确认后才会进入直播。' : '麦克风权限已确认；你可以选择静音加入。' }}</text>
          <view class="mic-mode-row mic-device-row">
            <view class="mic-mode selected" @click="toggleMicMute">
              <text class="mic-mode-title">{{ micMuted ? '静音加入' : '麦克风开启' }}</text>
              <text class="mic-mode-detail">点击切换</text>
            </view>
            <view v-if="micMediaMode === 'VIDEO'" class="mic-mode selected" @click="flipGuestCamera">
              <text class="mic-mode-title">翻转镜头</text>
              <text class="mic-mode-detail">检查取景</text>
            </view>
          </view>
          <view class="mic-primary" @click="confirmMicJoin"><text class="mic-primary-text">加入直播</text></view>
          <view class="mic-ghost" @click="closeMicSheet"><text class="mic-ghost-text">取消连麦</text></view>
        </view>
        <view v-else-if="micState === 'connecting'" class="mic-state">
          <view class="mic-symbol mic-symbol-wait"><text class="mic-symbol-text">✓</text></view>
          <text class="mic-title">主播已同意</text>
          <text class="mic-detail">正在建立安全语音链路…</text>
        </view>
        <view v-else class="mic-state">
          <view class="mic-symbol mic-symbol-error"><text class="mic-symbol-text">!</text></view>
          <text class="mic-title">连麦未建立</text>
          <text class="mic-detail">{{ micError }}</text>
          <view class="mic-secondary" @click="retryMic"><text class="mic-primary-text">重新申请</text></view>
          <view class="mic-ghost" @click="closeMicSheet"><text class="mic-ghost-text">关闭</text></view>
        </view>
      </view>
    </cover-view>

    <cover-view v-if="showMicSheet && micState === 'connected'" class="mic-connected" :style="micConnectedStyle">
      <view class="mic-live-dot" />
      <view class="mic-connected-copy">
        <text class="mic-connected-title">正在{{ micMediaMode === 'VIDEO' ? '视频' : '语音' }}连麦</text>
        <text class="mic-connected-time">{{ formatDuration(micDuration) }}</text>
      </view>
      <view v-if="micMediaMode === 'VIDEO'" class="mic-mini-button" :class="{ muted: micVideoMuted }" @click="toggleMicVideo">
        <text class="mic-mini-button-text">{{ micVideoMuted ? '开画面' : '关画面' }}</text>
      </view>
      <view v-if="micMediaMode === 'VIDEO'" class="mic-mini-button" @click="flipGuestCamera">
        <text class="mic-mini-button-text">翻转</text>
      </view>
      <view class="mic-mini-button" :class="{ muted: micMuted || micHostMuted }" @click="toggleMicMute">
        <text class="mic-mini-button-text">{{ micHostMuted ? '主播静音' : micMuted ? '开麦' : '静音' }}</text>
      </view>
      <view class="mic-mini-button hangup" @click="hangUpMic">
        <text class="mic-mini-button-text">断开</text>
      </view>
    </cover-view>

    <cover-view v-if="showProductPanel" class="action-mask" @click="closeActionPanels">
      <view class="action-sheet product-sheet" :style="actionSheetStyle" @click.stop>
        <view class="sheet-handle" />
        <view class="sheet-heading">
          <view>
            <text class="sheet-kicker">本场商品</text>
            <text class="sheet-title">边看边选，不离开直播画面</text>
          </view>
          <text class="sheet-close" @click="closeActionPanels">×</text>
        </view>
        <scroll-view v-if="products.length" scroll-y class="product-list">
          <view v-for="product in products" :key="product.id" class="product-row">
            <image v-if="product.cover" class="product-cover" :src="product.cover" mode="aspectFill" />
            <view v-else class="product-cover product-cover-fallback"><text class="product-cover-text">品</text></view>
            <view class="product-copy">
              <text class="product-name">{{ product.name }}</text>
              <text class="product-stock">{{ product.stock > 0 ? `库存 ${product.stock}` : '已售罄' }}</text>
              <view class="product-price-row">
                <text class="product-price">¥{{ formatPrice(product.price) }}</text>
                <text v-if="product.originalPrice > product.price" class="product-original">¥{{ formatPrice(product.originalPrice) }}</text>
              </view>
            </view>
            <view class="product-buy" :class="{ disabled: product.stock <= 0 }" @click="openProduct(product)">
              <text class="product-buy-text">{{ product.stock > 0 ? '去购买' : '已售罄' }}</text>
            </view>
          </view>
        </scroll-view>
        <view v-else class="sheet-empty">
          <text class="sheet-empty-title">本场暂未上架商品</text>
          <text class="sheet-empty-detail">主播添加商品后会自动显示，这里不展示虚拟货品。</text>
        </view>
      </view>
    </cover-view>

    <cover-view v-if="showGiftPanel" class="action-mask" @click="closeActionPanels">
      <view class="action-sheet gift-sheet" :style="actionSheetStyle" @click.stop>
        <view class="sheet-handle" />
        <view class="sheet-heading">
          <view>
            <text class="sheet-kicker">表达心意</text>
            <text class="sheet-title">余额 {{ coinBalance }} 国学币</text>
          </view>
          <text class="sheet-close" @click="closeActionPanels">×</text>
        </view>
        <view v-if="giftPolicyLoading" class="gift-policy-card">
          <text class="gift-policy-title">正在读取消费保护设置…</text>
        </view>
        <view v-else-if="giftPolicy && !giftPolicy.eligible" class="gift-policy-card warning">
          <text class="gift-policy-title">暂不能赠送礼物</text>
          <text class="gift-policy-detail">{{ giftPolicyReason }}</text>
        </view>
        <view v-else-if="giftPolicy && !giftPolicy.configured" class="gift-policy-card">
          <text class="gift-policy-title">首次赠送前，请先设置消费限额</text>
          <text class="gift-policy-detail">限额由你决定，提醒默认开启；以后可以继续调低或调整。</text>
          <view class="gift-limit-row">
            <view class="gift-limit-field">
              <text class="gift-limit-label">单次上限</text>
              <input v-model="singleLimitDraft" type="number" class="gift-limit-input" placeholder="如 100" />
            </view>
            <view class="gift-limit-field">
              <text class="gift-limit-label">每日上限</text>
              <input v-model="dailyLimitDraft" type="number" class="gift-limit-input" placeholder="如 500" />
            </view>
          </view>
          <view class="gift-policy-save" :class="{ disabled: savingGiftPolicy }" @click="saveGiftPolicy">
            <text class="gift-policy-save-text">{{ savingGiftPolicy ? '保存中…' : '确认限额并开启提醒' }}</text>
          </view>
        </view>
        <scroll-view v-if="giftPolicyReady && gifts.length" scroll-y class="gift-scroll">
          <view class="gift-grid">
            <view
              v-for="gift in gifts"
              :key="gift.id"
              class="gift-item"
              :class="{ selected: selectedGiftId === gift.id }"
              @click="selectedGiftId = gift.id"
            >
              <image v-if="gift.icon" class="gift-icon" :src="gift.icon" mode="aspectFit" />
              <view v-else class="gift-icon gift-icon-fallback"><text class="gift-icon-text">礼</text></view>
              <text class="gift-name">{{ gift.name }}</text>
              <text class="gift-price">{{ gift.price }} 币</text>
            </view>
          </view>
        </scroll-view>
        <view v-else-if="giftPolicyReady" class="sheet-empty">
          <text class="sheet-empty-title">暂未配置礼物</text>
          <text class="sheet-empty-detail">运营配置后会自动显示，这里不展示虚拟数据。</text>
        </view>
        <view v-if="giftPolicyReady && gifts.length" class="gift-submit-row">
          <view class="ranking-copy">
            <text class="ranking-title">理性表达</text>
            <text class="ranking-detail">今日已送 {{ giftPolicy?.spentTodayCoin || 0 }} / {{ giftPolicy?.dailyLimitCoin || 0 }} 币</text>
          </view>
          <view class="gift-submit" :class="{ disabled: !selectedGift }" @click="confirmSendGift">
            <text class="gift-submit-text">{{ sendingGift ? '发送中…' : '送出心意' }}</text>
          </view>
        </view>
      </view>
    </cover-view>

    <cover-view v-if="showMorePanel" class="action-mask" @click="closeActionPanels">
      <view class="action-sheet more-sheet" :style="actionSheetStyle" @click.stop>
        <view class="sheet-handle" />
        <text class="sheet-kicker">直播工具</text>
        <text class="sheet-title">真实操作，结果可追溯</text>
        <view class="more-grid">
          <view class="more-item" @click="shareRoom">
            <view class="more-symbol"><text class="more-symbol-text">↗</text></view>
            <text class="more-label">分享直播</text>
          </view>
          <view class="more-item" @click="reportRoom">
            <view class="more-symbol warning"><text class="more-symbol-text">!</text></view>
            <text class="more-label">举报直播</text>
          </view>
          <view class="more-item" @click="showPlaybackInfo">
            <view class="more-symbol"><text class="more-symbol-text">清</text></view>
            <text class="more-label">播放信息</text>
          </view>
        </view>
      </view>
    </cover-view>

    <cover-view v-if="roomEnded" class="ended-mask">
      <view class="ended-card" :style="endedCardStyle">
        <view class="ended-mark"><text class="ended-mark-text">✓</text></view>
        <text class="ended-title">直播已结束</text>
        <text class="ended-detail">{{ hasNextRoom ? `${endCountdown} 秒后进入下一场直播` : `${endCountdown} 秒后返回` }}</text>
        <view class="ended-button" @click="leaveEndedRoom">
          <text class="ended-button-text">{{ hasNextRoom ? '立即进入下一场' : '立即返回' }}</text>
        </view>
      </view>
    </cover-view>
  </view>
</template>

<script setup lang="ts">
import { computed, nextTick, onUnmounted, ref } from 'vue'
import { onBackPress, onHide, onLoad, onShow } from '@dcloudio/uni-app'
