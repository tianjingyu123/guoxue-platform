<template>
  <view class="page">
    <TRTCCloudUniPlugin-TXLocalViewComponent
      v-if="cameraMounted"
      :viewId="localViewId"
      class="camera"
      :style="localCameraStyle"
    />
    <TRTCCloudUniPlugin-TXRemoteViewComponent
      v-for="(item, index) in remoteVideoUsers"
      :key="item.userId"
      :userId="item.userId"
      :viewId="item.viewId"
      class="remote-camera"
      :style="remoteVideoStyle(index)"
    />
    <cover-view
      v-for="(item, index) in remoteVideoUsers"
      :key="`label-${item.viewId}`"
      class="remote-camera-label-layer"
      :style="remoteVideoStyle(index)"
    >
      <text class="remote-camera-label">{{ remoteVideoLabel(item.userId) }}</text>
    </cover-view>

    <view class="shade-top" :style="shadeTopStyle" />
    <view class="shade-bottom" :style="shadeBottomStyle" />
    <cover-view class="topbar" :style="topbarStyle">
      <view class="live-cluster">
        <view class="live-badge">
          <view class="live-dot" />
          <text class="live-label">直播中</text>
        </view>
        <text class="time">{{ elapsedText }}</text>
      </view>
      <view class="top-actions">
        <view class="viewer-chip">
          <view class="viewer-dot" />
          <text class="viewer-chip-text">{{ stats.onlineCount }} 人</text>
        </view>
        <view class="console-btn" @click="openConsole">
          <text class="console-btn-text">{{ pendingMics.length ? `连麦 ${pendingMics.length}` : '控制台' }}</text>
        </view>
        <view class="end-btn" @click="requestEnd">
          <text class="end-btn-text">结束</text>
        </view>
      </view>
    </cover-view>
    <cover-view v-if="outputWarning" class="output-warning" :style="outputWarningStyle">
      <text class="output-warning-text">{{ outputWarning }}</text>
    </cover-view>

    <cover-view v-if="endConfirmVisible" class="end-confirm" :style="endConfirmStyle">
      <text class="end-confirm-title">确认结束直播？</text>
      <text class="end-confirm-detail">结束后将停止摄像头、麦克风和观众播放。</text>
      <view class="end-confirm-actions">
        <view class="end-confirm-button cancel" @click="cancelEnd">
          <text class="end-confirm-button-text">继续直播</text>
        </view>
        <view class="end-confirm-button confirm" @click="endLive">
          <text class="end-confirm-button-text">结束直播</text>
        </view>
      </view>
    </cover-view>

    <view v-if="joining || error" class="status-card">
      <text class="status-title">{{ error ? '直播连接未建立' : '正在连接直播服务' }}</text>
      <text class="status-detail">{{ error || '正在开启摄像头和麦克风…' }}</text>
      <view v-if="error" class="retry-btn" @click="connect">
        <text class="retry-btn-text">重新连接</text>
      </view>
    </view>

    <cover-view v-if="!joining && !error" class="room-meta" :style="roomMetaStyle">
      <view class="room-eyebrow-row">
        <text class="room-studio">热卜 LIVE STUDIO</text>
        <view class="room-output-pill" :class="{ recovering: !!outputWarning }">
          <view class="signal-dot" />
          <text class="room-output-text">{{ outputWarning ? '分发恢复中' : '推流稳定' }}</text>
        </view>
      </view>
      <text class="room-title">{{ roomTitle || '我的直播间' }}</text>
      <text class="room-kicker">主播实时预览 · {{ stats.totalViews }} 位累计观众</text>
      <view class="room-state-row">
        <text class="room-state">观众看到的画面与声音正从这里推送</text>
      </view>
      <view class="room-metric-row">
        <view class="room-metric"><text class="room-metric-label">在线</text><text class="room-metric-value">{{ stats.onlineCount }}</text></view>
        <view class="room-metric"><text class="room-metric-label">峰值</text><text class="room-metric-value">{{ stats.peakOnline }}</text></view>
        <view class="room-metric"><text class="room-metric-label">互动</text><text class="room-metric-value">{{ stats.interactionRate }}</text></view>
        <view class="room-metric"><text class="room-metric-label">收益</text><text class="room-metric-value">¥{{ formatMoney(stats.totalSales) }}</text></view>
      </view>
    </cover-view>

    <cover-view class="danmaku-panel" :style="danmakuStyle">
      <view class="danmaku-head">
        <text class="danmaku-head-title">公屏</text>
        <text class="danmaku-head-sub">实时互动 · {{ danmaku.length }} 条</text>
        <view class="danmaku-reply" @click="openReplyComposer"><text class="danmaku-reply-text">回复</text></view>
      </view>
      <view v-if="!danmaku.length" class="danmaku-empty">
        <text class="danmaku-empty-text">观众消息会显示在这里</text>
      </view>
      <view v-for="item in danmaku" :key="item.id" class="danmaku-row" :class="{ 'danmaku-row-gift': item.isVip }">
        <text v-if="item.isVip" class="danmaku-gift-mark">心意</text>
        <text class="danmaku-user">{{ item.user }}</text>
        <text class="danmaku-content">{{ item.content }}</text>
      </view>
    </cover-view>

    <cover-view v-if="pendingMics.length" class="mic-request-card" :style="micRequestStyle">
      <view class="mic-request-avatar"><text class="mic-request-avatar-text">{{ pendingMics[0].mediaMode === 'VIDEO' ? '像' : '麦' }}</text></view>
      <view class="mic-request-copy">
        <text class="mic-request-kicker">{{ pendingMics[0].source === 'INVITE' ? '已邀请' : '观众申请' }}{{ pendingMics[0].mediaMode === 'VIDEO' ? '视频' : '语音' }}连麦</text>
        <text class="mic-request-user">{{ pendingMics[0].nickname || shortUserId(pendingMics[0].userId) }} · {{ pendingMics[0].source === 'INVITE' ? '等待对方确认' : '等待接通' }}{{ pendingMics.length > 1 ? ` · 另有 ${pendingMics.length - 1} 人` : '' }}</text>
      </view>
      <view class="mic-request-action reject" @click="managePendingMic('REJECT')">
        <text class="mic-request-action-text">{{ pendingMics[0].source === 'INVITE' ? '取消' : '拒绝' }}</text>
      </view>
      <view v-if="pendingMics[0].source !== 'INVITE'" class="mic-request-action accept" @click="managePendingMic('ACCEPT')">
        <text class="mic-request-action-text">接通</text>
      </view>
    </cover-view>

    <cover-view v-if="compactSeatMics.length" class="mic-seat-panel" :style="micSeatStyle">
      <view class="mic-seat-head">
        <view class="mic-connected-dot" />
        <text class="mic-seat-title">音频席位 {{ compactSeatMics.length }}/6</text>
      </view>
      <view v-for="item in compactSeatMics" :key="item.id" class="mic-seat-row" @click="openMicActions(item)">
        <view class="mic-seat-avatar"><text class="mic-seat-avatar-text">{{ item.position }}</text></view>
        <view class="mic-seat-copy">
          <text class="mic-seat-user">{{ item.nickname || shortUserId(item.userId) }}</text>
          <text class="mic-seat-state">{{ item.mediaMode === 'VIDEO' ? '视频 · ' : '语音 · ' }}{{ item.status === 'MUTED' ? '已静音' : '正在发言' }}</text>
        </view>
        <text class="mic-seat-more">•••</text>
      </view>
    </cover-view>

    <cover-view v-if="replyComposerVisible" class="host-composer-mask" @click="closeReplyComposer">
      <view class="host-composer-sheet" :style="replyComposerStyle" @click.stop>
        <view class="host-composer-head">
          <view>
            <text class="host-composer-kicker">主播发言</text>
            <text class="host-composer-title">回复直播公屏</text>
          </view>
          <text class="host-composer-close" @click="closeReplyComposer">取消</text>
        </view>
        <view class="host-composer-row">
          <input
            v-model="replyDraft"
            class="host-composer-input"
            :focus="replyComposerVisible"
            maxlength="120"
            confirm-type="send"
            placeholder="回复观众，或补充讲解内容…"
            placeholder-class="host-composer-placeholder"
            @confirm="sendHostReply"
          />
          <view class="host-composer-send" :class="{ disabled: !replyDraft.trim() || sendingReply }" @click="sendHostReply">
            <text class="host-composer-send-text">{{ sendingReply ? '发送中' : '发送' }}</text>
          </view>
        </view>
      </view>
    </cover-view>

    <cover-view class="bottombar" :style="bottombarStyle">
      <view class="control" @click="toggleCamera">
        <view class="control-icon-shell"><text class="control-icon">↻</text></view>
        <text class="control-label">翻转</text>
      </view>
      <view class="control" :class="{ active: micMuted }" @click="toggleMic">
        <view class="control-icon-shell" :class="{ 'control-icon-alert': micMuted }"><text class="control-icon">{{ micMuted ? '×' : '麦' }}</text></view>
        <text class="control-label">{{ micMuted ? '打开麦克风' : '静音' }}</text>
      </view>
      <view class="control" :class="{ active: videoMuted }" @click="toggleVideo">
        <view class="control-icon-shell" :class="{ 'control-icon-alert': videoMuted }"><text class="control-icon">{{ videoMuted ? '□' : '镜' }}</text></view>
        <text class="control-label">{{ videoMuted ? '打开画面' : '关闭画面' }}</text>
      </view>
      <view class="control control-primary" @click="openConsole">
        <view class="control-icon-shell control-icon-primary"><text class="control-icon">控</text></view>
        <text class="control-label">更多控制</text>
      </view>
    </cover-view>
  </view>
</template>

<script setup lang="ts">
import { computed, nextTick, ref } from 'vue'
import { onBackPress, onHide, onLoad, onShow, onUnload } from '@dcloudio/uni-app'
import { useAppSafeArea } from '@/pkg-live/use-app-safe-area'
import { liveApi, type ConsoleDanmaku, type ConsoleLiveStats } from '@/lib/live-data'
import { liveMicApi, type LiveMicItem } from '@/pkg-live/live-mic-data'
import { ensureLiveCapturePermissions } from '@/pkg-live/app-capture-permissions'
import { useTim, type TimMessage } from '@/composables/useTim'
import { formatLiveGiftTimEvent, readLiveGiftTimEvent } from '@/pkg-live/live-tim-events'
import {
  joinLiveVideo,
  leaveLiveVideo,
  setLiveAudioMuted,
  setLiveConnectionStateHandler,
  setLiveRemoteVideoAvailabilityHandler,
  setLiveRemoteUserLeaveHandler,
  setLiveVideoMuted,
  startLiveRemoteVideo,
  stopLiveRemoteVideo,
  switchLiveCamera,
} from '@/pkg-live/live-trtc-client'

const roomId = ref('')
const roomTitle = ref('')
const joining = ref(false)
const error = ref('')
const outputWarning = ref('')
const cameraMounted = ref(true)
const micMuted = ref(false)
const videoMuted = ref(false)
const frontCamera = ref(true)
const elapsed = ref(0)
const persistedDanmaku = ref<ConsoleDanmaku[]>([])
const realtimeDanmaku = ref<ConsoleDanmaku[]>([])
const micItems = ref<LiveMicItem[]>([])
const remoteVideoUsers = ref<Array<{ userId: string; viewId: string }>>([])
const micBusy = ref(false)
const endConfirmVisible = ref(false)
const replyComposerVisible = ref(false)
const replyDraft = ref('')
const sendingReply = ref(false)
const stats = ref<ConsoleLiveStats>({
  onlineCount: 0,
  totalViews: 0,
  newFollowers: 0,
  totalGift: 0,
  totalSales: 0,
  peakOnline: 0,
  avgWatchTime: '--',
  interactionRate: '0%',
})
const pendingMics = computed(() => micItems.value.filter((item) => item.status === 'PENDING'))
const connectedMics = computed(() => micItems.value.filter((item) => item.status === 'OCCUPIED' || item.status === 'MUTED'))
const compactSeatMics = computed(() => connectedMics.value.filter((item) =>
  item.mediaMode === 'AUDIO' || !remoteVideoUsers.value.some((remote) => remote.userId === item.trtcUserId),
))
const danmaku = computed(() => {
  const merged = new Map<string, ConsoleDanmaku>()
  for (const item of [...persistedDanmaku.value, ...realtimeDanmaku.value]) {
    merged.set(`${item.userId || item.user}:${item.content}`, item)
  }
  return [...merged.values()].slice(-4)
})
const localViewId = `host-preview-${Date.now().toString(36)}`
const localCameraStyle = computed(() => remoteVideoUsers.value.length
  ? { left: '0px', right: '0px', top: '0px', height: '50%' }
  : { left: '0px', right: '0px', top: '0px', bottom: '0px' })
const { safeTop, safeRight, safeBottom, safeLeft } = useAppSafeArea()
const topbarStyle = computed(() => ({
  top: `${safeTop.value}px`,
  paddingLeft: `${safeLeft.value + uni.upx2px(24)}px`,
  paddingRight: `${safeRight.value + uni.upx2px(24)}px`,
}))
const bottombarStyle = computed(() => ({
  paddingBottom: `${safeBottom.value}px`,
  paddingLeft: `${safeLeft.value + uni.upx2px(22)}px`,
  paddingRight: `${safeRight.value + uni.upx2px(22)}px`,
}))
const shadeTopStyle = computed(() => ({
  height: `${safeTop.value + uni.upx2px(260)}px`,
}))
const shadeBottomStyle = computed(() => ({
  height: `${safeBottom.value + uni.upx2px(500)}px`,
}))
const roomMetaStyle = computed(() => ({
  // 分发告警与直播信息不可占用同一视觉层；告警出现时为标题整体下移，避免遮挡。
  top: `${safeTop.value + uni.upx2px(outputWarning.value ? 196 : 116)}px`,
  left: `${safeLeft.value + uni.upx2px(28)}px`,
  right: `${safeRight.value + uni.upx2px(28)}px`,
}))
const outputWarningStyle = computed(() => ({
  top: `${safeTop.value + uni.upx2px(116)}px`,
  left: `${safeLeft.value + uni.upx2px(28)}px`,
  right: `${safeRight.value + uni.upx2px(28)}px`,
}))
const danmakuStyle = computed(() => ({
  bottom: `${safeBottom.value + uni.upx2px(168)}px`,
  left: `${safeLeft.value + uni.upx2px(28)}px`,
  right: `${safeRight.value + uni.upx2px(154)}px`,
}))
const micRequestStyle = computed(() => ({
  bottom: `${safeBottom.value + uni.upx2px(326)}px`,
  left: `${safeLeft.value + uni.upx2px(28)}px`,
  right: `${safeRight.value + uni.upx2px(28)}px`,
}))
const micSeatStyle = computed(() => ({
  top: `${safeTop.value + uni.upx2px(210)}px`,
  right: `${safeRight.value + uni.upx2px(24)}px`,
}))
const endConfirmStyle = computed(() => ({
  top: `${safeTop.value + uni.upx2px(92)}px`,
  left: `${safeLeft.value + uni.upx2px(28)}px`,
  right: `${safeRight.value + uni.upx2px(28)}px`,
}))
const replyComposerStyle = computed(() => ({
  paddingLeft: `${safeLeft.value + uni.upx2px(28)}px`,
  paddingRight: `${safeRight.value + uni.upx2px(28)}px`,
  paddingBottom: `${safeBottom.value + uni.upx2px(28)}px`,
}))

function remoteVideoStyle(index: number) {
  const count = remoteVideoUsers.value.length
  if (count <= 1) return { left: '0px', right: '0px', top: '50%', bottom: '0px' }
  const columns = 2
  const rows = Math.ceil(count / columns)
  const row = Math.floor(index / columns)
  const column = index % columns
  const height = 50 / rows
  return {
    left: `${column * 50}%`,
    width: '50%',
    top: `${50 + row * height}%`,
    height: `${height}%`,
  }
}

function remoteVideoLabel(userId: string) {
  const mic = micItems.value.find((item) => item.trtcUserId === userId)
  return mic?.nickname || `连麦嘉宾 ${mic?.position || ''}`.trim()
}

let elapsedTimer: ReturnType<typeof setInterval> | null = null
let pollTimer: ReturnType<typeof setInterval> | null = null
let outputLeaseTimer: ReturnType<typeof setInterval> | null = null
let ending = false
let appVideoSuspended = false
let navigatingToConsole = false
const tim = useTim()
let timGroupId = ''
let offTimMessage: (() => void) | null = null

const elapsedText = computed(() => {
  const hours = Math.floor(elapsed.value / 3600)
  const minutes = Math.floor((elapsed.value % 3600) / 60)
  const seconds = elapsed.value % 60
  return [hours, minutes, seconds].map((value) => String(value).padStart(2, '0')).join(':')
})

function formatMoney(value: number) {
  const amount = Math.max(0, Number(value) || 0)
  return Number.isInteger(amount) ? String(amount) : amount.toFixed(2)
}

async function connect() {
  if (!roomId.value || joining.value && !error.value) return
  joining.value = true
  error.value = ''
  leaveLiveVideo()
  cameraMounted.value = false
  setTimeout(async () => {
    cameraMounted.value = true
    try {
      await ensureLiveCapturePermissions()
      const config = await liveMicApi.getRtcConfig(roomId.value)
      await joinLiveVideo(config, localViewId)
      await renewHostOutput()
      startOutputLease()
      joining.value = false
    } catch (cause) {
      leaveLiveVideo()
      joining.value = false
      error.value = (cause as Error)?.message || '摄像头直播启动失败'
    }
  }, 80)
}

async function renewHostOutput() {
  if (!roomId.value) return
  try {
    const state = await liveMicApi.hostReady(roomId.value)
    outputWarning.value = state.active ? '' : '观众分发链路尚未建立，正在自动重试'
  } catch {
    outputWarning.value = '观众分发链路续租失败，正在自动重试'
  }
}

function startOutputLease() {
  if (outputLeaseTimer) return
  outputLeaseTimer = setInterval(() => { void renewHostOutput() }, 20_000)
}

function stopOutputLease(release = false) {
  if (outputLeaseTimer) clearInterval(outputLeaseTimer)
  outputLeaseTimer = null
  if (release && roomId.value) void liveMicApi.hostNotReady(roomId.value).catch(() => undefined)
}

async function refreshRoom() {
  try {
    const data = await liveApi.getConsoleData(roomId.value)
    roomTitle.value = data.title
    stats.value = data.stats
    elapsed.value = data.liveDurationSeconds
    persistedDanmaku.value = data.danmaku.slice(-20)
    void joinHostPublicScreen(data.imGroupId)
  } catch {
    // 推流不依赖控制台轮询；短暂网络波动不遮挡主播画面。
  }
}

async function leaveHostPublicScreen() {
  if (offTimMessage) { offTimMessage(); offTimMessage = null }
  const groupId = timGroupId
  timGroupId = ''
  if (groupId) await tim.quitGroup(groupId).catch(() => undefined)
}

async function joinHostPublicScreen(groupId: string) {
  if (!groupId || groupId === timGroupId) return
  await leaveHostPublicScreen()
  try {
    timGroupId = groupId
    await tim.joinGroup(groupId)
    offTimMessage = tim.onMessage((messages: TimMessage[]) => {
      const incoming = messages.filter((message) =>
        message.conversationType === 'GROUP' && message.to === timGroupId,
      )
      for (const message of incoming) {
        const giftEvent = readLiveGiftTimEvent(message)
        const content = giftEvent ? formatLiveGiftTimEvent(giftEvent) : message.payload?.text || ''
        if (!content) continue
        const item: ConsoleDanmaku = {
          id: `tim:${message.ID}`,
          userId: message.from,
          user: message.nick || '观众',
          content,
          time: new Date().toLocaleTimeString('zh-CN', { hour12: false }),
          level: 1,
          isVip: !!giftEvent,
        }
        realtimeDanmaku.value.push(item)
        setTimeout(() => {
          realtimeDanmaku.value = realtimeDanmaku.value.filter((entry) => entry.id !== item.id)
        }, 30_000)
      }
      if (realtimeDanmaku.value.length > 30) {
        realtimeDanmaku.value.splice(0, realtimeDanmaku.value.length - 30)
      }
    })
  } catch {
    // TIM 暂不可用时保留数据库轮询，主播仍能在最多 2 秒内看到持久化公屏。
  }
}

async function refreshPendingMics() {
  try {
    const items = await liveMicApi.list(roomId.value)
    micItems.value = items
  } catch {
    // 连麦列表短暂失败不影响直播采集；下一轮继续拉取。
  }
}

function shortUserId(userId: string) {
  return userId.length > 8 ? userId.slice(-8) : userId
}

async function managePendingMic(action: 'ACCEPT' | 'REJECT') {
  const item = pendingMics.value[0]
  if (!item || micBusy.value) return
  micBusy.value = true
  try {
    await liveMicApi.manage(roomId.value, item.userId, action, item.position)
    await refreshPendingMics()
    uni.showToast({ title: action === 'ACCEPT' ? '已接通观众连麦' : '已拒绝连麦申请', icon: 'none' })
  } catch (cause) {
    uni.showToast({ title: (cause as Error)?.message || '连麦操作失败', icon: 'none' })
  } finally {
    micBusy.value = false
  }
}

async function manageActiveMic(item: LiveMicItem, action: 'MUTE' | 'UNMUTE' | 'KICK') {
  if (!item || micBusy.value) return
  micBusy.value = true
  try {
    await liveMicApi.manage(roomId.value, item.userId, action, item.position)
    await refreshPendingMics()
    const title = action === 'MUTE' ? '已将连麦观众静音' : action === 'UNMUTE' ? '已恢复连麦声音' : '已结束本次连麦'
    uni.showToast({ title, icon: 'none' })
  } catch (cause) {
    uni.showToast({ title: (cause as Error)?.message || '连麦操作失败', icon: 'none' })
  } finally {
    micBusy.value = false
  }
}

function openMicActions(item: LiveMicItem) {
  const muteLabel = item.status === 'MUTED' ? '恢复发言' : '静音该席位'
  uni.showActionSheet({
    itemList: [muteLabel, '结束该席位连麦'],
    success: (result) => {
      const action = result.tapIndex === 0
        ? (item.status === 'MUTED' ? 'UNMUTE' : 'MUTE')
        : 'KICK'
      void manageActiveMic(item, action)
    },
  })
}

function toggleCamera() {
  frontCamera.value = !frontCamera.value
  switchLiveCamera(frontCamera.value)
}

function toggleMic() {
  micMuted.value = !micMuted.value
  setLiveAudioMuted(micMuted.value)
}

function toggleVideo() {
  videoMuted.value = !videoMuted.value
  setLiveVideoMuted(videoMuted.value)
}

function openConsole() {
  if (joining.value || error.value) {
    uni.showToast({ title: '请先连接直播服务', icon: 'none' })
    return
  }
  navigatingToConsole = true
  uni.navigateTo({
    url: `/pkg-live/console/index?id=${roomId.value}&source=host`,
    fail: () => { navigatingToConsole = false },
  })
}

function handleConsoleEnded(endedRoomId: string) {
  if (String(endedRoomId) !== roomId.value) return
  leaveLiveVideo()
  stopOutputLease(true)
  uni.redirectTo({ url: `/pkg-live/end/index?id=${roomId.value}` })
}

function requestEnd() {
  if (ending) return
  endConfirmVisible.value = true
}

function cancelEnd() {
  endConfirmVisible.value = false
}

function openReplyComposer() {
  if (joining.value || error.value) return
  replyComposerVisible.value = true
}

function closeReplyComposer() {
  if (sendingReply.value) return
  replyComposerVisible.value = false
}

async function sendHostReply() {
  const content = replyDraft.value.trim()
  if (!content || sendingReply.value) return
  sendingReply.value = true
  try {
    await liveApi.sendComment(roomId.value, content)
    replyDraft.value = ''
    replyComposerVisible.value = false
    await refreshRoom()
  } catch (cause) {
    uni.showToast({ title: (cause as Error)?.message || '公屏消息发送失败', icon: 'none' })
  } finally {
    sendingReply.value = false
  }
}

function handleRemoteUserLeave(_userId?: string) {
  // TRTC 远端离开只说明媒体连接已经释放；观众主动下麦可能已先删业务麦位。
  // 这里只刷新服务端事实，避免重复 KICK 制造 404 和错误提示。
  void refreshPendingMics()
}

function handleRemoteVideoAvailability(userId: string, available: boolean) {
  const existing = remoteVideoUsers.value.find((item) => item.userId === userId)
  if (!available) {
    stopLiveRemoteVideo(userId)
    remoteVideoUsers.value = remoteVideoUsers.value.filter((item) => item.userId !== userId)
    return
  }
  if (existing) {
    void nextTick(() => startLiveRemoteVideo(userId, existing.viewId))
    return
  }
  const viewId = `host-remote-${remoteVideoUsers.value.length}-${Date.now().toString(36)}`
  remoteVideoUsers.value.push({ userId, viewId })
  void nextTick(() => startLiveRemoteVideo(userId, viewId))
}

function handleConnectionState(state: 'connected' | 'reconnecting' | 'lost') {
  if (state === 'connected') {
    joining.value = false
    error.value = ''
    void renewHostOutput().then(startOutputLease)
    return
  }
  joining.value = true
  if (state === 'lost') {
    stopOutputLease(true)
    error.value = '直播网络已断开，正在尝试恢复…'
    return
  }
  error.value = ''
}

async function endLive() {
  if (ending) return
  ending = true
  endConfirmVisible.value = false
  uni.showLoading({ title: '正在下播…', mask: true })
  try {
    await liveApi.endLive(roomId.value)
    stopOutputLease(true)
    leaveLiveVideo()
    uni.hideLoading()
    uni.redirectTo({ url: `/pkg-live/end/index?id=${roomId.value}` })
  } catch (cause) {
    ending = false
    uni.hideLoading()
    uni.showToast({ title: (cause as Error)?.message || '下播失败，请重试', icon: 'none' })
  }
}

onLoad((options) => {
  roomId.value = String(options?.id || '')
  if (!roomId.value) {
    joining.value = false
    error.value = '缺少直播间编号'
    return
  }
  setLiveRemoteVideoAvailabilityHandler(handleRemoteVideoAvailability)
  setLiveRemoteUserLeaveHandler(handleRemoteUserLeave)
  setLiveConnectionStateHandler(handleConnectionState)
  void connect()
  void refreshRoom()
  void refreshPendingMics()
  elapsedTimer = setInterval(() => { elapsed.value += 1 }, 1000)
  pollTimer = setInterval(() => {
    void refreshRoom()
    void refreshPendingMics()
  }, 2000)
  uni.$on('live:host-ended', handleConsoleEnded)
})

onBackPress(() => {
  requestEnd()
  return true
})

onHide(() => {
  if (navigatingToConsole) return
  if (joining.value || error.value || videoMuted.value) return
  appVideoSuspended = true
  setLiveVideoMuted(true)
  stopOutputLease(true)
})

onShow(() => {
  navigatingToConsole = false
  if (!appVideoSuspended) return
  appVideoSuspended = false
  if (!videoMuted.value) setLiveVideoMuted(false)
  void renewHostOutput().then(startOutputLease)
})

onUnload(() => {
  if (elapsedTimer) clearInterval(elapsedTimer)
  if (pollTimer) clearInterval(pollTimer)
  stopOutputLease(true)
  uni.$off('live:host-ended', handleConsoleEnded)
  setLiveRemoteUserLeaveHandler(null)
  setLiveRemoteVideoAvailabilityHandler(null)
  setLiveConnectionStateHandler(null)
  void leaveHostPublicScreen()
  leaveLiveVideo()
})
</script>

