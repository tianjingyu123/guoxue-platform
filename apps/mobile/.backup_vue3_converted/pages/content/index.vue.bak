<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- 导航栏 -->
    <view class="flex items-center justify-between px-4 h-12 bg-white border-b border-[#E8E0D5] shrink-0">
      <view class="p-1" @click="goBack">
        <text class="text-xl text-[#2C2C2C]">←</text>
      </view>
      <text class="text-base font-semibold text-[#2C2C2C]">内容管理</text>
      <view class="w-7" />
    </view>

    <!-- 骨架屏 -->
    <view v-if="loading" class="flex-1 p-4">
      <view class="w-full h-10 bg-white rounded-xl mb-3 skeleton-pulse" />
      <view class="flex gap-2 mb-4">
        <view v-for="i in 4" :key="i" class="h-8 w-16 bg-[#F0EBE5] rounded-lg skeleton-pulse" />
      </view>
      <view v-for="i in 5" :key="i" class="bg-white rounded-xl p-3.5 mb-2.5 skeleton-pulse">
        <view class="flex gap-3">
          <view class="flex-1 space-y-2">
            <view class="h-4 w-3/4 bg-[#F0EBE5] rounded skeleton-pulse" />
            <view class="h-3 w-1/2 bg-[#F0EBE5] rounded skeleton-pulse" />
            <view class="h-3 w-1/3 bg-[#F0EBE5] rounded skeleton-pulse" />
          </view>
          <view class="w-12 h-8 bg-[#F0EBE5] rounded skeleton-pulse" />
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view v-else-if="filteredList.length === 0" class="flex-1 flex flex-col items-center justify-center p-8">
      <text class="text-5xl mb-4">📭</text>
      <text class="text-sm text-[#999] mb-2">暂无内容</text>
      <text class="text-xs text-[#bbb]">切换分类或试试其他筛选条件</text>
    </view>

    <!-- 主内容 -->
    <view v-else class="flex-1 flex flex-col">
      <!-- 搜索筛选栏 -->
      <view class="px-4 pt-3 pb-2 bg-[#FAF8F5]">
        <view class="flex items-center gap-2 bg-white rounded-xl px-3.5 h-10 border border-[#E8E0D5]">
          <text class="text-base text-[#999]">🔍</text>
          <input v-model="keyword" placeholder="搜索标题或作者" placeholder-class="text-xs text-[#bbb]" class="flex-1 text-sm text-[#2C2C2C]" />
        </view>
      </view>

      <!-- Tab 切换 -->
      <view class="flex bg-white border-b border-[#E8E0D5]">
        <view v-for="tab in tabs" :key="tab.key" class="flex-1 py-2.5 text-center text-sm relative" :class="activeTab === tab.key ? 'text-[#C41E3A] font-medium' : 'text-[#999]'" @click="activeTab = tab.key">
          <text>{{ tab.label }}</text>
          <text class="text-[10px] text-[#999] ml-1">({{ tab.count }})</text>
          <view v-if="activeTab === tab.key" class="absolute bottom-0 left-1/4 right-1/4 h-0.5 bg-[#C41E3A] rounded-full" />
        </view>
      </view>

      <!-- 批量操作栏 -->
      <view v-if="selectedIds.length > 0" class="flex items-center justify-between px-4 py-2 bg-[#C41E3A]/5 border-b border-[#E8E0D5]">
        <text class="text-xs text-[#C41E3A]">已选 {{ selectedIds.length }} 项</text>
        <view class="flex gap-3">
          <text class="text-xs px-3 py-1 bg-white border border-[#C9A96E] text-[#C9A96E] rounded-full" @click="batchApprove">✓ 审核通过</text>
          <text class="text-xs px-3 py-1 bg-white border border-[#999] text-[#999] rounded-full" @click="batchReject">✕ 驳回</text>
          <text class="text-xs px-3 py-1 bg-white border border-[#C41E3A] text-[#C41E3A] rounded-full" @click="batchDelete">🗑 删除</text>
        </view>
      </view>

      <!-- 内容列表 -->
      <scroll-view scroll-y class="flex-1 overflow-y-auto" refresher-enabled @refresherrefresh="onRefresh" :refresher-triggered="refreshing">
        <view class="p-4 pb-4">
          <view v-for="item in filteredList" :key="item.id" class="bg-white rounded-xl p-3.5 mb-2.5 shadow-sm">
            <view class="flex items-start gap-3">
              <!-- 多选框 -->
              <view class="w-5 h-5 rounded border-2 mt-0.5 flex items-center justify-center shrink-0"
                :class="selectedIds.includes(item.id) ? 'border-[#C41E3A] bg-[#C41E3A]' : 'border-[#D1CEC6]'"
                @click="toggleSelect(item.id)">
                <text v-if="selectedIds.includes(item.id)" class="text-white text-[10px]">✓</text>
              </view>
              <!-- 内容信息 -->
              <view class="flex-1 min-w-0" @click="goDetail(item.id)">
                <view class="flex items-center gap-1.5">
                  <text class="text-sm font-medium text-[#2C2C2C] truncate">{{ item.title }}</text>
                  <text v-if="item.isTop" class="text-[10px] bg-[#C41E3A]/10 text-[#C41E3A] px-1.5 py-0.5 rounded leading-none">置顶</text>
                </view>
                <view class="flex items-center gap-2 mt-1">
                  <text class="text-[11px] text-[#999]">{{ item.author }}</text>
                  <text class="text-[11px] text-[#bbb]">|</text>
                  <text class="text-[11px] text-[#999]">{{ item.time }}</text>
                </view>
                <view class="flex items-center gap-2 mt-1.5">
                  <!-- 状态标签 -->
                  <view class="text-[10px] px-1.5 py-0.5 rounded"
                    :class="item.status === 'published' ? 'bg-[#E8F5E9] text-[#4CAF50]' :
                      item.status === 'pending' ? 'bg-[#FFF3E0] text-[#E65100]' :
                      item.status === 'draft' ? 'bg-[#F5F1EB] text-[#999]' :
                      'bg-[#FFEBEE] text-[#C41E3A]'">
                    <text>{{ item.statusLabel }}</text>
                  </view>
                  <text class="text-[11px] text-[#999]">{{ item.category }}</text>
                  <text class="text-[11px] text-[#999]">👁 {{ item.views }}</text>
                </view>
              </view>
              <!-- 操作按钮 -->
              <view class="shrink-0" @click="onItemAction(item.id)">
                <text class="text-lg text-[#999]">⋯</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

const loading = ref(true)
const refreshing = ref(false)
const activeTab = ref('post')
const keyword = ref('')
const selectedIds = ref<string[]>([])

interface ContentItem {
  id: string
  title: string
  author: string
  time: string
  status: 'published' | 'pending' | 'draft' | 'rejected'
  statusLabel: string
  category: string
  views: number
  isTop?: boolean
  type: string
}

const tabs = ref([
  { key: 'post', label: '帖子', count: 28 },
  { key: 'article', label: '文章', count: 15 },
  { key: 'video', label: '视频', count: 22 },
  { key: 'comment', label: '评论', count: 156 },
])

const allList = ref<ContentItem[]>([
  { id: '1', title: '乾卦"潜龙勿用"的现代启示', author: '周易大师', time: '2024-06-10 10:30', status: 'published', statusLabel: '已发布', category: '易经', views: 1280, isTop: true, type: 'post' },
  { id: '2', title: '八字入门：排盘步骤详解', author: '国学讲师', time: '2024-06-09 14:20', status: 'pending', statusLabel: '审核中', category: '命理', views: 890, type: 'post' },
  { id: '3', title: '居家风水布局指南', author: '风水徐师傅', time: '2024-06-08 09:15', status: 'published', statusLabel: '已发布', category: '风水', views: 2340, type: 'article' },
  { id: '4', title: '紫微斗数14主星详解', author: '紫微传承人', time: '2024-06-07 16:45', status: 'draft', statusLabel: '草稿', category: '紫微斗数', views: 0, type: 'article' },
  { id: '5', title: '奇门遁甲排盘新手教程', author: '奇门居士', time: '2024-06-06 11:00', status: 'rejected', statusLabel: '已驳回', category: '奇门', views: 560, type: 'video' },
  { id: '6', title: '梅花易数起卦方法示范', author: '易学探索者', time: '2024-06-05 08:30', status: 'published', statusLabel: '已发布', category: '易经', views: 1890, type: 'video' },
  { id: '7', title: '八字十神详解：正官偏官', author: '命理工作室', time: '2024-06-04 13:20', status: 'pending', statusLabel: '审核中', category: '命理', views: 430, type: 'post' },
  { id: '8', title: '风水罗盘使用入门', author: '风水大师', time: '2024-06-03 10:10', status: 'published', statusLabel: '已发布', category: '风水', views: 3100, type: 'video' },
])

const filteredList = computed(() => {
  let list = allList.value.filter(item => item.type === activeTab.value)
  if (keyword.value) {
    const kw = keyword.value.toLowerCase()
    list = list.filter(item => item.title.includes(kw) || item.author.includes(kw))
  }
  return list
})

function toggleSelect(id: string) {
  const idx = selectedIds.value.indexOf(id)
  if (idx > -1) {
    selectedIds.value.splice(idx, 1)
  } else {
    selectedIds.value.push(id)
  }
}

function batchApprove() {
  if (selectedIds.value.length === 0) return
  uni.showToast({ title: `已审核通过 ${selectedIds.value.length} 项`, icon: 'success' })
  selectedIds.value = []
}

function batchReject() {
  if (selectedIds.value.length === 0) return
  uni.showToast({ title: `已驳回 ${selectedIds.value.length} 项`, icon: 'none' })
  selectedIds.value = []
}

function batchDelete() {
  if (selectedIds.value.length === 0) return
  uni.showModal({
    title: '确认删除',
    content: `确定删除选中的 ${selectedIds.value.length} 项内容？此操作不可恢复。`,
    success: (res) => {
      if (res.confirm) {
        uni.showToast({ title: '已删除', icon: 'success' })
        selectedIds.value = []
      }
    }
  })
}

function onItemAction(id: string) {
  uni.showActionSheet({
    itemList: ['编辑', '置顶', '删除', '查看详情'],
    success: (res) => {
      const actions = ['编辑', '置顶', '删除', '查看详情']
      if (res.tapIndex === 2) {
        uni.showModal({
          title: '确认删除',
          content: '确定删除此项内容？',
          success: (r) => { if (r.confirm) uni.showToast({ title: '已删除', icon: 'success' }) }
        })
      } else {
        uni.showToast({ title: actions[res.tapIndex], icon: 'none' })
      }
    }
  })
}

function goDetail(id: string) {
  uni.navigateTo({ url: `/pages/content/detail/index?id=${id}` })
}

function onRefresh() {
  refreshing.value = true
  setTimeout(() => { refreshing.value = false }, 1000)
}

function goBack() { uni.navigateBack() }

setTimeout(() => { loading.value = false }, 1000)
</script>

<style scoped>
.skeleton-pulse {
  animation: pulse 1.5s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.8; }
}
/* 样式由 Tailwind 处理 */
</style>
