<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部 -->
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center px-4 h-12">
        <view @click="goBack" class="p-1"><text class="text-xl text-[#2C2C2C]">←</text></view>
        <text class="text-base font-semibold ml-3 text-[#2C2C2C]">直播设置</text>
      </view>
    </view>

    <!-- 骨架屏加载态 -->
    <view v-if="loading" class="p-4 space-y-5">
      <!-- 直播间信息骨架 -->
      <view>
        <view class="h-3 w-20 bg-[#E8E0D5] rounded mb-3 animate-pulse" />
        <view class="bg-white rounded-xl border border-[#E8E0D5] p-4 space-y-4">
          <view class="flex items-center gap-3">
            <view class="w-16 h-16 rounded-xl bg-[#E8E0D5] animate-pulse" />
            <view class="flex-1 space-y-1">
              <view class="h-4 w-24 bg-[#E8E0D5] rounded animate-pulse" />
              <view class="h-3 w-36 bg-[#E8E0D5] rounded animate-pulse" />
            </view>
          </view>
          <view class="h-10 bg-[#E8E0D5] rounded-lg animate-pulse" />
          <view class="space-y-1">
            <view class="h-3 w-20 bg-[#E8E0D5] rounded animate-pulse" />
            <view class="h-20 bg-[#E8E0D5] rounded-lg animate-pulse" />
          </view>
        </view>
      </view>
      <!-- 通知骨架 -->
      <view>
        <view class="h-3 w-20 bg-[#E8E0D5] rounded mb-3 animate-pulse" />
        <view class="bg-white rounded-xl border border-[#E8E0D5] divide-y divide-[#E8E0D5]">
          <view v-for="i in 4" :key="'n'+i" class="flex items-center justify-between p-4">
            <view class="flex items-start gap-2.5">
              <view class="w-4 h-4 bg-[#E8E0D5] rounded animate-pulse" />
              <view class="space-y-1">
                <view class="h-3 w-16 bg-[#E8E0D5] rounded animate-pulse" />
                <view class="h-2 w-24 bg-[#E8E0D5] rounded animate-pulse" />
              </view>
            </view>
            <view class="w-11 h-6 bg-[#E8E0D5] rounded-full animate-pulse" />
          </view>
        </view>
      </view>
    </view>

    <!-- 主内容 -->
    <view v-else class="p-4 space-y-5">
      <!-- 直播间信息 -->
      <view>
        <text class="text-xs font-semibold text-[#999] uppercase tracking-wider block mb-3">直播间信息</text>
        <view class="bg-white rounded-xl border border-[#E8E0D5] p-4 space-y-4">
          <!-- 封面 -->
          <view class="flex items-center gap-3">
            <view class="relative flex-shrink-0">
              <view class="w-16 h-16 rounded-xl overflow-hidden bg-[#F0EBE5]">
                <image :src="profile.cover" mode="aspectFill" class="w-full h-full" />
              </view>
              <view @click="handleUploadCover" class="absolute -bottom-1 -right-1 w-6 h-6 bg-[#C41E3A] rounded-full flex items-center justify-center">
                <text class="text-white text-xs">📤</text>
              </view>
            </view>
            <view class="min-w-0 flex-1">
              <text class="text-sm font-medium text-[#2C2C2C] block">直播间封面</text>
              <text class="text-xs text-[#999]">建议 16:9 比例，不超过 2MB</text>
            </view>
          </view>

          <!-- 名称 -->
          <view>
            <text class="text-xs font-medium text-[#999] block mb-1.5">直播间名称</text>
            <input
              v-model="profile.name"
              class="w-full px-3 py-2 text-sm bg-white border border-[#E8E0D5] rounded-lg"
            />
          </view>

          <!-- 简介 -->
          <view>
            <view class="flex items-center justify-between mb-1.5">
              <text class="text-xs font-medium text-[#999]">直播间简介</text>
              <text class="text-xs text-[#999]">{{ profile.desc.length }}/100</text>
            </view>
            <textarea
              v-model="profile.desc"
              :maxlength="100"
              rows="3"
              class="w-full px-3 py-2 text-sm bg-white border border-[#E8E0D5] rounded-lg resize-none"
            />
          </view>
        </view>
      </view>

      <!-- 通知设置 -->
      <view>
        <text class="text-xs font-semibold text-[#999] uppercase tracking-wider block mb-3">通知设置</text>
        <view class="bg-white rounded-xl border border-[#E8E0D5] divide-y divide-[#E8E0D5]">
          <view v-for="n in notifyKeys" :key="n.key" class="flex items-center justify-between p-4">
            <view class="flex items-start gap-2.5">
              <text class="text-[#999] mt-0.5 flex-shrink-0">🔔</text>
              <view>
                <text class="text-sm font-medium text-[#2C2C2C] block">{{ n.label }}</text>
                <text class="text-xs text-[#999]">{{ n.desc }}</text>
              </view>
            </view>
            <view @click="toggleNotify(n.key)" :class="['relative w-11 h-6 rounded-full transition-colors flex-shrink-0 ml-3', (notify as any)[n.key] ? 'bg-[#C41E3A]' : 'bg-[#F0EBE5]']">
              <view :class="['absolute top-0.5 w-5 h-5 bg-white rounded-full shadow transition-all', (notify as any)[n.key] ? 'right-0.5' : 'left-0.5']" />
            </view>
          </view>
        </view>
      </view>

      <!-- 隐私与互动 -->
      <view>
        <text class="text-xs font-semibold text-[#999] uppercase tracking-wider block mb-3">隐私与互动</text>
        <view class="bg-white rounded-xl border border-[#E8E0D5] divide-y divide-[#E8E0D5]">
          <view v-for="p in privacyKeys" :key="p.key" class="flex items-center justify-between p-4">
            <view class="flex items-start gap-2.5">
              <text class="text-[#999] mt-0.5 flex-shrink-0">🛡</text>
              <view>
                <text class="text-sm font-medium text-[#2C2C2C] block">{{ p.label }}</text>
                <text class="text-xs text-[#999]">{{ p.desc }}</text>
              </view>
            </view>
            <view @click="togglePrivacy(p.key)" :class="['relative w-11 h-6 rounded-full transition-colors flex-shrink-0 ml-3', (privacy as any)[p.key] ? 'bg-[#C41E3A]' : 'bg-[#F0EBE5]']">
              <view :class="['absolute top-0.5 w-5 h-5 bg-white rounded-full shadow transition-all', (privacy as any)[p.key] ? 'right-0.5' : 'left-0.5']" />
            </view>
          </view>
        </view>
      </view>

      <!-- 快捷入口 -->
      <view>
        <text class="text-xs font-semibold text-[#999] uppercase tracking-wider block mb-3">更多设置</text>
        <view class="bg-white rounded-xl border border-[#E8E0D5] divide-y divide-[#E8E0D5]">
          <view @click="goTeam" class="flex items-center justify-between w-full p-4">
            <view class="flex items-center gap-2.5">
              <text class="text-[#999]">📹</text>
              <text class="text-sm text-[#2C2C2C]">团队管理</text>
            </view>
            <text class="text-[#999]">›</text>
          </view>
          <view @click="goEarnings" class="flex items-center justify-between w-full p-4">
            <view class="flex items-center gap-2.5">
              <text class="text-[#999]">👛</text>
              <text class="text-sm text-[#2C2C2C]">收益设置</text>
            </view>
            <text class="text-[#999]">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 固定保存按钮 -->
    <view class="fixed bottom-0 left-0 right-0 bg-white/95 border-t border-[#E8E0D5] pb-safe">
      <view class="p-4">
        <view @click="handleSave" :class="['w-full py-3 rounded-xl text-sm font-semibold flex items-center justify-center gap-2', saved ? 'bg-green-500 text-white' : 'bg-[#C41E3A] text-white']">
          <text v-if="saving">⏳</text>
          <text>{{ saved ? '已保存' : saving ? '保存中...' : '保存设置' }}</text>
        </view>
      </view>
    </view>
    <view class="h-20" />
  </view>
</template>

<script setup lang="ts">
import { ref, reactive, onMounted } from 'vue'

// 导航辅助
function goBack() { uni.navigateBack() }
function goTo(url: string) { uni.navigateTo({ url }) }

// 加载态
const loading = ref(true)

onMounted(() => {
  setTimeout(() => { loading.value = false }, 600)
})

// 通知配置项
const notifyKeys = [
  { key: 'newViewer', label: '新观众进入', desc: '有新观众进入直播间时通知' },
  { key: 'reward', label: '打赏提醒', desc: '收到打赏时通知' },
  { key: 'comment', label: '评论提醒', desc: '新评论时通知' },
  { key: 'order', label: '带货成交', desc: '带货商品成交时通知' },
]

// 隐私配置项
const privacyKeys = [
  { key: 'allowComment', label: '允许评论', desc: '观众可在直播中发表评论' },
  { key: 'allowGift', label: '允许打赏', desc: '观众可在直播中打赏' },
  { key: 'showViewCount', label: '显示观看人数', desc: '在直播间展示观看人数' },
  { key: 'autoRecord', label: '自动录制回放', desc: '直播结束后自动生成回放' },
]

// 状态
const saved = ref(false)
const saving = ref(false)

const profile = reactive({
  name: '国学命理讲堂',
  desc: '专注八字、紫微、奇门等传统命理学的讲解与传播',
  cover: 'https://images.unsplash.com/photo-1486312338219-ce68d2c6f44d?w=400&q=80',
})

const notify = reactive({
  newViewer: true,
  reward: true,
  comment: false,
  order: true,
})

const privacy = reactive({
  allowComment: true,
  allowGift: true,
  showViewCount: true,
  autoRecord: true,
})

// 操作
function toggleNotify(key: string) {
  (notify as any)[key] = !(notify as any)[key]
}

function togglePrivacy(key: string) {
  (privacy as any)[key] = !(privacy as any)[key]
}

async function handleSave() {
  saving.value = true
  await new Promise(r => setTimeout(r, 800))
  saving.value = false
  saved.value = true
  setTimeout(() => { saved.value = false }, 2000)
}

function handleUploadCover() {
  uni.showToast({ title: '上传封面（Mock）', icon: 'none' })
}

function goTeam() {
  uni.navigateTo({ url: '/pages/creator/live/team/index' })
}

function goEarnings() {
  uni.navigateTo({ url: '/pages/creator/live/earnings/index' })
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
