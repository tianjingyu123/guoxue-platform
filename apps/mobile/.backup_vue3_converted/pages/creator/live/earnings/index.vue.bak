<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 h-12">
        <view class="flex items-center gap-2">
          <view @click="goBack" class="p-1"><text class="text-xl text-[#2C2C2C]">←</text></view>
          <text class="text-base font-semibold text-[#2C2C2C]">直播收益</text>
        </view>
        <view @click="handleExport" class="flex items-center gap-1 text-xs text-[#999]">
          <text>⬇</text>
          <text>导出</text>
        </view>
      </view>
    </view>

    <!-- 骨架屏加载态 -->
    <view v-if="loading" class="p-4 space-y-4">
      <view class="flex gap-2">
        <view v-for="i in 3" :key="i" class="flex-1 h-8 bg-[#E8E0D5] rounded-full animate-pulse" />
      </view>
      <view class="bg-white rounded-xl p-4 border border-[#E8E0D5]">
        <view class="h-4 bg-[#E8E0D5] rounded w-20 animate-pulse mb-3" />
        <view class="h-10 bg-[#E8E0D5] rounded w-40 animate-pulse mb-3" />
        <view class="grid grid-cols-2 gap-3">
          <view class="h-16 bg-[#F5F1EB] rounded-lg animate-pulse" />
          <view class="h-16 bg-[#F5F1EB] rounded-lg animate-pulse" />
        </view>
      </view>
      <view class="h-16 bg-white rounded-xl animate-pulse border border-[#E8E0D5]" />
      <view v-for="i in 3" :key="'r'+i" class="h-20 bg-white rounded-xl animate-pulse border border-[#E8E0D5]" />
    </view>

    <!-- 主内容 -->
    <view v-else class="p-4 space-y-4">
      <!-- 时间范围选择 -->
      <view class="flex gap-2">
        <view v-for="r in RANGES" :key="r.key" @click="range = r.key" :class="['flex-1 py-1.5 rounded-full text-xs font-medium text-center', range === r.key ? 'bg-[#C41E3A] text-white' : 'bg-[#F0EBE5] text-[#2C2C2C]']">
          <text>{{ r.label }}</text>
        </view>
      </view>

      <!-- 收益总览卡片 -->
      <view class="bg-white rounded-xl p-4 border border-[#E8E0D5]">
        <text class="text-xs text-[#999] block mb-1">总收益（元）</text>
        <view class="flex items-end gap-2 mb-3">
          <text class="text-3xl font-black text-[#2C2C2C]">{{ stats.total.toLocaleString() }}</text>
          <view :class="['flex items-center gap-0.5 pb-1 text-xs font-medium', stats.trend >= 0 ? 'text-green-600' : 'text-red-600']">
            <text>{{ stats.trend >= 0 ? '📈' : '📉' }}</text>
            <text>{{ Math.abs(stats.trend) }}%</text>
          </view>
        </view>
        <view class="grid grid-cols-2 gap-3">
          <view class="bg-[#F5F1EB] rounded-lg p-3">
            <view class="flex items-center gap-1.5 mb-1">
              <text class="text-[#C9A96E]">🎁</text>
              <text class="text-xs text-[#999]">打赏收益</text>
            </view>
            <text class="text-lg font-bold text-[#2C2C2C]">¥{{ stats.reward.toLocaleString() }}</text>
          </view>
          <view class="bg-[#F5F1EB] rounded-lg p-3">
            <view class="flex items-center gap-1.5 mb-1">
              <text class="text-[#C41E3A]">🛍</text>
              <text class="text-xs text-[#999]">带货收益</text>
            </view>
            <text class="text-lg font-bold text-[#2C2C2C]">¥{{ stats.goods.toLocaleString() }}</text>
          </view>
        </view>
      </view>

      <!-- 提现入口 -->
      <view @click="goWithdraw" class="w-full flex items-center justify-between bg-[#C41E3A]/5 border border-[#C41E3A]/20 rounded-xl p-4">
        <view class="flex items-center gap-2.5">
          <view class="w-9 h-9 rounded-full bg-[#C41E3A]/10 flex items-center justify-center">
            <text class="text-[#C41E3A]">💳</text>
          </view>
          <view class="text-left">
            <text class="text-sm font-semibold text-[#2C2C2C]">可提现金额</text>
            <text class="text-xs text-[#999]">T+1 结算，最低100元可提</text>
          </view>
        </view>
        <view class="flex items-center gap-1.5">
          <text class="text-lg font-bold text-[#C41E3A]">¥{{ Math.round(stats.total * 0.7) }}</text>
          <text class="text-[#999]">›</text>
        </view>
      </view>

      <!-- 明细列表 -->
      <view>
        <!-- 筛选 -->
        <view class="flex gap-2 mb-3">
          <view v-for="f in typeFilters" :key="f.key" @click="typeFilter = f.key" :class="['px-3 py-1.5 rounded-full text-xs font-medium', typeFilter === f.key ? 'bg-[#C41E3A] text-white' : 'bg-[#F0EBE5] text-[#2C2C2C]']">
            <text>{{ f.label }}</text>
          </view>
        </view>

        <!-- 空状态 -->
        <view v-if="filtered.length === 0" class="flex flex-col items-center justify-center py-16 text-[#999]">
          <text class="text-3xl mb-3 opacity-30">📋</text>
          <text class="text-sm">暂无收益记录</text>
        </view>

        <!-- 记录列表 -->
        <view v-else class="space-y-2">
          <view v-for="record in filtered" :key="record.id" class="bg-white rounded-xl p-3.5 border border-[#E8E0D5]">
            <view class="flex items-start justify-between gap-2">
              <view class="flex items-start gap-2.5 min-w-0">
                <view :class="['w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5', record.type === 'reward' ? 'bg-[#C9A96E]/15' : 'bg-[#C41E3A]/10']">
                  <text>{{ record.type === 'reward' ? '🎁' : '🛍' }}</text>
                </view>
                <view class="min-w-0">
                  <text class="text-sm font-medium text-[#2C2C2C] block truncate">{{ record.desc }}</text>
                  <text class="text-xs text-[#999] block truncate">{{ record.live }}</text>
                  <text class="text-xs text-[#999]">{{ record.date }}</text>
                </view>
              </view>
              <text class="text-sm font-bold text-green-600 flex-shrink-0">+¥{{ record.amount }}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部安全区 -->
    <view class="h-8" />
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

// 导航辅助
function goBack() { uni.navigateBack() }
function goTo(url: string) { uni.navigateTo({ url }) }

// 加载态
const loading = ref(true)

onMounted(() => {
  setTimeout(() => { loading.value = false }, 600)
})

// 类型定义
type Range = '7d' | '30d' | '90d'
type TypeFilter = 'all' | 'reward' | 'goods'

const RANGES = [
  { key: '7d' as Range, label: '近7天' },
  { key: '30d' as Range, label: '近30天' },
  { key: '90d' as Range, label: '近90天' },
]

const typeFilters = [
  { key: 'all' as TypeFilter, label: '全部' },
  { key: 'reward' as TypeFilter, label: '打赏' },
  { key: 'goods' as TypeFilter, label: '带货' },
]

interface RangeStats {
  total: number
  reward: number
  goods: number
  trend: number
}

const statsByRange: Record<Range, RangeStats> = {
  '7d': { total: 3680, reward: 1280, goods: 2400, trend: 12.5 },
  '30d': { total: 18600, reward: 5400, goods: 13200, trend: 8.3 },
  '90d': { total: 52400, reward: 14800, goods: 37600, trend: -2.1 },
}

interface Record {
  id: string
  date: string
  type: 'reward' | 'goods'
  desc: string
  amount: number
  live: string
}

const records: Record[] = [
  { id: '1', date: '2024-01-15', type: 'reward', desc: '用户「星空」打赏', amount: 520, live: '八字命理精讲第12课' },
  { id: '2', date: '2024-01-15', type: 'goods', desc: '带货成交：《渊海子平》', amount: 168, live: '八字命理精讲第12课' },
  { id: '3', date: '2024-01-14', type: 'goods', desc: '带货成交：紫微斗数入门', amount: 88, live: '紫微斗数专题' },
  { id: '4', date: '2024-01-14', type: 'reward', desc: '用户「山河」打赏', amount: 200, live: '紫微斗数专题' },
  { id: '5', date: '2024-01-13', type: 'reward', desc: '用户「云上」打赏', amount: 360, live: '奇门遁甲入门' },
  { id: '6', date: '2024-01-12', type: 'goods', desc: '带货成交：铜制罗盘', amount: 480, live: '风水堂第8课' },
  { id: '7', date: '2024-01-12', type: 'reward', desc: '用户「墨言」打赏', amount: 100, live: '风水堂第8课' },
  { id: '8', date: '2024-01-11', type: 'goods', desc: '带货成交：手抄本', amount: 240, live: '八字命理精讲第11课' },
]

const range = ref<Range>('30d')
const typeFilter = ref<TypeFilter>('all')

const stats = computed(() => statsByRange[range.value])
const filtered = computed(() => records.filter(r => typeFilter.value === 'all' || r.type === typeFilter.value))

// 操作
function handleExport() {
  uni.showToast({ title: '导出功能（Mock）', icon: 'none' })
}

function goWithdraw() {
  uni.showToast({ title: '提现功能（Mock）', icon: 'none' })
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
