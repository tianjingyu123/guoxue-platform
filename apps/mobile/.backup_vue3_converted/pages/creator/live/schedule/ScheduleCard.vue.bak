<template>
  <view class="bg-white rounded-xl border border-[#E8E0D5] overflow-hidden">
    <view class="flex gap-3 p-3">
      <!-- 封面占位 -->
      <view class="w-24 h-16 rounded-lg flex items-center justify-center flex-shrink-0 relative" style="background:linear-gradient(135deg, rgba(196,30,58,0.2), rgba(201,169,110,0.2))">
        <text class="text-2xl" style="color:rgba(196,30,58,0.5)">{{ schedule.type === 'knowledge' ? '📖' : '🛍' }}</text>
        <!-- 系列标签 -->
        <view v-if="schedule.seriesName" class="absolute bottom-1 left-1 px-1 py-0.5 rounded bg-black/60 text-white text-[8px]">
          {{ schedule.seriesIndex }}/{{ schedule.seriesTotal }}
        </view>
      </view>

      <!-- 内容 -->
      <view class="flex-1 min-w-0">
        <view class="flex items-start justify-between gap-2">
          <view class="min-w-0">
            <text class="text-sm font-medium text-[#2C2C2C] line-clamp-1 block">{{ schedule.title }}</text>
            <text v-if="schedule.seriesName" class="text-[10px] text-[#999] truncate block">{{ schedule.seriesName }}</text>
          </view>
          <view :class="['flex-shrink-0 text-[10px] px-1.5 py-0.5 rounded border', statusColorClass]">
            {{ statusLabel }}
          </view>
        </view>

        <view class="flex items-center gap-3 mt-2 text-xs text-[#999]">
          <view v-if="showDate" class="flex items-center gap-1">
            <text>📅</text>
            <text>{{ schedule.date }}</text>
          </view>
          <view class="flex items-center gap-1">
            <text>🕐</text>
            <text>{{ schedule.time }}</text>
          </view>
          <text>{{ schedule.duration }}分钟</text>
          <view class="flex items-center gap-1">
            <text>👁</text>
            <text>{{ viewerText }}</text>
          </view>
        </view>
      </view>

      <!-- 操作菜单 -->
      <view class="relative flex-shrink-0">
        <view class="w-8 h-8 rounded-full flex items-center justify-center" hover-class="bg-[#F5F1EB]" @click.stop="showMenu = !showMenu">
          <text class="text-base text-[#999]">⋯</text>
        </view>

        <view v-if="showMenu" class="fixed inset-0 z-40" @click.stop="showMenu = false" />
        <view v-if="showMenu" class="absolute right-0 top-full mt-1 z-50 w-32 bg-white border border-[#E8E0D5] rounded-lg shadow-lg py-1">
          <view class="flex items-center gap-2 px-3 py-2 text-sm" hover-class="bg-[#F5F1EB]" @click.stop="emit('edit'); showMenu = false">
            <text>✏</text>
            <text>编辑</text>
          </view>
          <view class="flex items-center gap-2 px-3 py-2 text-sm" hover-class="bg-[#F5F1EB]" @click.stop="emit('copy'); showMenu = false">
            <text>📋</text>
            <text>复制</text>
          </view>
          <view class="flex items-center gap-2 px-3 py-2 text-sm text-[#C41E3A]" hover-class="bg-red-50" @click.stop="emit('delete'); showMenu = false">
            <text>🗑</text>
            <text>删除</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

interface Schedule {
  id: number; title: string; date: string; time: string; duration: number
  type: string; status: string; seriesName: string | null
  seriesIndex: number | null; seriesTotal: number | null
  viewerEstimate: number; actualViewers?: number
}

const props = defineProps<{
  schedule: Schedule
  showDate?: boolean
}>()

const emit = defineEmits<{
  edit: []
  copy: []
  delete: []
}>()

const showMenu = ref(false)

const statusConfig: Record<string, { label: string; colorClass: string }> = {
  scheduled: { label: '待开播', colorClass: 'text-blue-600 border-blue-200 bg-blue-50' },
  live: { label: '直播中', colorClass: 'text-red-600 border-red-200 bg-red-50' },
  completed: { label: '已结束', colorClass: 'text-gray-500 border-gray-200 bg-gray-50' },
  cancelled: { label: '已取消', colorClass: 'text-gray-400 border-gray-200 bg-gray-50' },
}

const statusLabel = computed(() => statusConfig[props.schedule.status]?.label || props.schedule.status)
const statusColorClass = computed(() => statusConfig[props.schedule.status]?.colorClass || 'text-gray-500 border-gray-200 bg-gray-50')

const viewerText = computed(() => {
  if (props.schedule.status === 'completed' && props.schedule.actualViewers !== undefined) {
    return String(props.schedule.actualViewers)
  }
  return '预计' + props.schedule.viewerEstimate
})
</script>

<style scoped>
.line-clamp-1 {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>
