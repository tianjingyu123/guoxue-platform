<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部控制栏 -->
    <view class="sticky top-0 z-50 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 h-14">
        <view class="flex items-center gap-3">
          <view class="p-1 -ml-1" @click="routerBack">
            <text class="text-xl text-[#2C2C2C]">←</text>
          </view>
          <view class="flex items-center gap-2">
            <view v-if="isLive" class="flex items-center gap-1 px-2 py-0.5 rounded-full bg-red-500 text-white text-xs animate-pulse">
              <text>📡</text>
              <text>直播中</text>
            </view>
            <view v-else class="px-2 py-0.5 rounded-full bg-[#F5F5F5] text-[#999] text-xs">已结束</view>
            <text class="text-sm font-medium text-[#2C2C2C]">八字命理入门精讲</text>
          </view>
        </view>

        <view class="flex items-center gap-2">
          <!-- 直播时长 -->
          <view class="flex items-center gap-1 px-3 py-1.5 bg-[#F5F5F5] rounded-full">
            <text class="text-[#999] text-xs">🕐</text>
            <text class="text-sm font-mono font-medium text-[#2C2C2C]">{{ formatTime(liveTime) }}</text>
          </view>

          <!-- 控制按钮 -->
          <view class="flex items-center gap-1">
            <view
              class="px-2 py-1.5 rounded-lg border border-[#E8E0D5] text-xs"
              :class="isMuted ? 'text-red-500 border-red-200' : 'text-[#2C2C2C]'"
              @click="isMuted = !isMuted"
            >
              <text>{{ isMuted ? '🔇' : '🔊' }}</text>
            </view>
            <view
              class="px-2 py-1.5 rounded-lg border border-[#E8E0D5] text-xs"
              :class="showTeleprompter ? 'bg-[#C41E3A]/10 border-[#C41E3A]/30' : ''"
              @click="showTeleprompter = !showTeleprompter"
            >
              <text>📜</text>
            </view>
            <view class="px-2 py-1.5 rounded-lg border border-[#E8E0D5] text-xs">
              <text>⚙️</text>
            </view>
            <view
              class="flex items-center gap-1 px-2 py-1.5 rounded-lg bg-red-500 text-white text-xs"
              @click="showEndDialog = true"
            >
              <text>⏹</text>
              <text>结束直播</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="flex" style="height: calc(100vh - 56px)">
      <!-- 左侧：核心数据 + 弹幕/连麦 -->
      <view class="flex-1 flex flex-col border-r border-[#E8E0D5]">
        <!-- 核心数据区 -->
        <view class="p-4 border-b border-[#E8E0D5]">
          <view class="grid grid-cols-4 gap-3">
            <view class="p-3 rounded-xl border border-blue-500/20" style="background: linear-gradient(135deg, rgba(59,130,246,0.1), rgba(6,182,212,0.1))">
              <view class="flex items-center gap-2 mb-1">
                <text class="text-blue-500 text-xs">👥</text>
                <text class="text-xs text-[#999]">在线人数</text>
              </view>
              <view class="flex items-baseline gap-2">
                <text class="text-2xl font-bold text-blue-600">{{ liveStats.onlineCount.toLocaleString() }}</text>
                <text class="text-xs text-green-500">+12</text>
              </view>
            </view>
            <view class="p-3 rounded-xl border border-purple-500/20" style="background: linear-gradient(135deg, rgba(168,85,247,0.1), rgba(236,72,153,0.1))">
              <view class="flex items-center gap-2 mb-1">
                <text class="text-purple-500 text-xs">👁</text>
                <text class="text-xs text-[#999]">累计观看</text>
              </view>
              <text class="text-2xl font-bold text-purple-600 block">{{ liveStats.totalViews.toLocaleString() }}</text>
            </view>
            <view class="p-3 rounded-xl border border-amber-500/20" style="background: linear-gradient(135deg, rgba(245,158,11,0.1), rgba(234,88,12,0.1))">
              <view class="flex items-center gap-2 mb-1">
                <text class="text-amber-500 text-xs">🎁</text>
                <text class="text-xs text-[#999]">打赏收入</text>
              </view>
              <text class="text-2xl font-bold text-amber-600 block">¥{{ liveStats.totalGift.toLocaleString() }}</text>
            </view>
            <view class="p-3 rounded-xl border border-red-500/20" style="background: linear-gradient(135deg, rgba(239,68,68,0.1), rgba(236,72,153,0.1))">
              <view class="flex items-center gap-2 mb-1">
                <text class="text-red-500 text-xs">🛍</text>
                <text class="text-xs text-[#999]">带货成交</text>
              </view>
              <text class="text-2xl font-bold text-red-600 block">¥{{ liveStats.totalSales.toLocaleString() }}</text>
            </view>
          </view>

          <!-- 次要数据 -->
          <view class="flex items-center gap-6 mt-3 text-xs text-[#999]">
            <text>峰值在线: <text class="text-[#2C2C2C] font-medium">{{ liveStats.peakOnline }}</text></text>
            <text>新增粉丝: <text class="text-green-500 font-medium">+{{ liveStats.newFollowers }}</text></text>
            <text>平均观看: <text class="text-[#2C2C2C] font-medium">{{ liveStats.avgWatchTime }}</text></text>
            <text>互动率: <text class="text-[#2C2C2C] font-medium">{{ liveStats.interactionRate }}</text></text>
          </view>
        </view>

        <!-- 弹幕/连麦 Tab区 -->
        <view class="flex-1 flex flex-col overflow-hidden">
          <view class="flex items-center gap-4 px-4 border-b border-[#E8E0D5]">
            <view
              :class="['pb-2 text-sm border-b-2 transition-colors', activeTab === 'danmaku' ? 'text-[#C41E3A] border-[#C41E3A]' : 'text-[#999] border-transparent']"
              @click="activeTab = 'danmaku'"
            >
              <text>💬 实时弹幕</text>
              <text class="ml-1 px-1 py-0 rounded bg-[#F5F5F5] text-xs">{{ danmakuList.length }}</text>
            </view>
            <view
              :class="['pb-2 text-sm border-b-2 transition-colors', activeTab === 'connect' ? 'text-[#C41E3A] border-[#C41E3A]' : 'text-[#999] border-transparent']"
              @click="activeTab = 'connect'"
            >
              <text>📞 连麦申请</text>
              <text v-if="connectRequests.length > 0" class="ml-1 px-1 py-0.5 rounded bg-red-500 text-white text-xs">{{ connectRequests.length }}</text>
            </view>
          </view>

          <!-- 弹幕列表 -->
          <scroll-view v-if="activeTab === 'danmaku'" scroll-y class="flex-1 overflow-y-auto p-3 space-y-1.5" :scroll-top="danmakuScrollTop">
            <view v-for="item in danmakuList" :key="item.id" class="group flex items-start gap-2 p-2 rounded-lg hover:bg-[#F9F6F2] transition-colors">
              <view class="w-6 h-6 rounded-full flex items-center justify-center text-white text-[10px] font-bold flex-shrink-0" style="background: linear-gradient(135deg, #8B5CF6, #A855F7)">
                <text>{{ item.level }}</text>
              </view>
              <view class="flex-1 min-w-0">
                <view class="flex items-center gap-1.5">
                  <text :class="['text-xs font-medium', item.isVip ? 'text-amber-500' : 'text-[#999]']">
                    <text v-if="item.isVip">👑</text>
                    {{ item.user }}
                  </text>
                  <text class="text-[10px] text-[#999]">{{ item.time }}</text>
                </view>
                <text class="text-sm text-[#2C2C2C] block mt-0.5">{{ item.content }}</text>
              </view>
              <!-- 操作按钮 -->
              <view class="flex items-center gap-0.5 flex-shrink-0">
                <text class="text-[11px] px-1 text-[#ccc]" @click.stop="handlePin(item.id)">📌</text>
                <text class="text-[11px] px-1 text-[#ccc]" @click.stop="handleReplyToDanmaku(item.id)">💬</text>
                <text class="text-[11px] px-1 text-[#C41E3A]" @click.stop="handleDeleteDanmaku(item.id)">🗑</text>
                <text class="text-[11px] px-1 text-[#C41E3A]" @click.stop="handleBanUser(item.id)">🔇</text>
              </view>
            </view>
          </scroll-view>

          <!-- 连麦申请 -->
          <view v-if="activeTab === 'connect'" class="flex-1 overflow-y-auto p-3 space-y-2">
            <view v-if="connectRequests.length === 0" class="flex flex-col items-center justify-center h-full text-[#999]">
              <text class="text-3xl mb-2 opacity-20">📞</text>
              <text class="text-sm">暂无连麦申请</text>
            </view>
            <view v-for="request in connectRequests" :key="request.id" class="p-3 bg-white rounded-xl border border-[#E8E0D5]">
              <view class="flex items-start gap-3">
                <view class="w-10 h-10 rounded-full bg-gradient-to-br from-gray-400 to-gray-500 flex items-center justify-center text-white text-sm font-bold flex-shrink-0">
                  <text>{{ request.user[0] }}</text>
                </view>
                <view class="flex-1 min-w-0">
                  <view class="flex items-center justify-between">
                    <text class="font-medium text-sm text-[#2C2C2C]">{{ request.user }}</text>
                    <text class="text-xs text-[#999]">等待 {{ request.waitTime }}</text>
                  </view>
                  <text class="text-xs text-[#999] mt-1 line-clamp-2 block">{{ request.reason }}</text>
                  <view class="flex items-center gap-2 mt-2">
                    <view class="flex items-center gap-1 px-3 py-1.5 rounded-lg bg-[#C41E3A] text-white text-xs" @click="handleAcceptConnect(request.id)">
                      <text>📞</text>
                      <text>接通</text>
                    </view>
                    <view class="flex items-center gap-1 px-3 py-1.5 rounded-lg border border-[#E8E0D5] text-xs" @click="handleRejectConnect(request.id)">
                      <text>📵</text>
                      <text>拒绝</text>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>

          <!-- 快捷回复 -->
          <view class="p-3 border-t border-[#E8E0D5]">
            <view class="flex items-center gap-2">
              <input v-model="replyText" placeholder="发送弹幕..." class="flex-1 h-9 px-3 bg-[#F5F5F5] rounded-lg text-xs outline-none" />
              <view class="w-9 h-9 rounded-lg bg-[#C41E3A] flex items-center justify-center" @click="sendDanmaku">
                <text class="text-white text-sm">➤</text>
              </view>
            </view>
            <view class="flex flex-wrap gap-1.5 mt-2">
              <view v-for="quickReply in quickReplies" :key="quickReply" class="px-2 py-1 rounded-lg border border-[#E8E0D5] text-[10px] text-[#999]" @click="replyText = quickReply">
                <text>{{ quickReply }}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 右侧：商品管理 + 营销工具 + 提词器 -->
      <view class="w-[380px] flex flex-col overflow-hidden">
        <!-- 商品管理区 -->
        <view class="border-b border-[#E8E0D5]">
          <view class="p-3 border-b border-[#E8E0D5] flex items-center justify-between">
            <view class="flex items-center gap-2">
              <text class="text-[#C41E3A]">🛍</text>
              <text class="font-medium text-sm text-[#2C2C2C]">商品管理</text>
              <text class="px-1 py-0 rounded bg-[#F5F5F5] text-[10px] text-[#999]">{{ products.length }}件</text>
            </view>
            <view class="flex items-center gap-1 text-xs text-[#999]">
              <text>🔄</text>
              <text @click="handleRefreshStock">刷新库存</text>
            </view>
          </view>

          <!-- 当前讲解商品 -->
          <view v-if="currentProduct" class="p-3 bg-[#C41E3A]/5 border-b border-[#C41E3A]/20">
            <view class="flex items-center gap-1 mb-2">
              <text class="text-xs text-[#C41E3A] font-medium animate-pulse">📡 正在讲解</text>
            </view>
            <view class="flex items-center gap-3">
              <view class="w-14 h-14 rounded-lg bg-[#F5F5F5] flex items-center justify-center">
                <text class="text-[#999] text-xl">📦</text>
              </view>
              <view class="flex-1 min-w-0">
                <text class="text-sm font-medium text-[#2C2C2C] truncate block">{{ currentProduct.name }}</text>
                <view class="flex items-center gap-2 mt-1">
                  <text class="text-[#C41E3A] font-bold">¥{{ currentProduct.price }}</text>
                  <text class="text-xs text-[#999]">已售{{ currentProduct.sold }}</text>
                </view>
              </view>
              <view class="px-2 py-1 rounded-lg border border-[#E8E0D5] text-xs" @click="handleProductLive(0)">结束讲解</view>
            </view>
          </view>

          <!-- 商品列表 -->
          <view class="h-[180px] overflow-y-auto">
            <view class="p-2 space-y-1.5">
              <view v-for="product in otherProducts" :key="product.id" class="flex items-center gap-2 p-2 rounded-lg hover:bg-[#F9F6F2] transition-colors">
                <view class="w-10 h-10 rounded bg-[#F5F5F5] flex items-center justify-center flex-shrink-0">
                  <text class="text-[#999] text-lg">📦</text>
                </view>
                <view class="flex-1 min-w-0">
                  <view class="flex items-center gap-1">
                    <text class="text-xs font-medium text-[#2C2C2C] truncate block">{{ product.name }}</text>
                    <text v-if="product.isHot" class="px-1 py-0 rounded bg-red-500 text-white text-[8px]">爆</text>
                  </view>
                  <view class="flex items-center gap-2 text-[10px] text-[#999]">
                    <text class="text-[#C41E3A] font-medium">¥{{ product.price }}</text>
                    <text>库存: <text v-if="product.stock <= 10" class="text-red-500">{{ product.stock }}</text><text v-else>{{ product.stock }}</text></text>
                  </view>
                </view>
                <view class="px-2 py-1 rounded-lg border border-[#E8E0D5] text-[10px]" @click="handleProductLive(product.id)">上架讲解</view>
              </view>
            </view>
          </view>

          <!-- 库存预警 -->
          <view v-if="products.some(p => p.stock <= 10)" class="p-2 bg-amber-50 border-t border-amber-200">
            <view class="flex items-center gap-1.5 text-amber-600">
              <text class="text-xs">⚠️</text>
              <text class="text-xs font-medium">{{ products.filter(p => p.stock <= 10).length }}件商品库存不足</text>
              <text class="text-xs text-amber-600 ml-auto">去补货</text>
            </view>
          </view>
        </view>

        <!-- 营销工具 -->
        <view class="p-3 border-b border-[#E8E0D5]">
          <view class="flex items-center gap-2 mb-3">
            <text class="text-amber-500">✨</text>
            <text class="font-medium text-sm text-[#2C2C2C]">营销工具</text>
          </view>
          <view class="grid grid-cols-3 gap-2">
            <view class="flex flex-col items-center gap-1 py-3 rounded-xl border border-[#E8E0D5]" @click="showLotteryDialog = true">
              <text class="text-purple-500 text-lg">🎁</text>
              <text class="text-[10px] text-[#999]">发起抽奖</text>
            </view>
            <view class="flex flex-col items-center gap-1 py-3 rounded-xl border border-[#E8E0D5]" @click="showCouponDialog = true">
              <text class="text-red-500 text-lg">🎫</text>
              <text class="text-[10px] text-[#999]">发放优惠券</text>
            </view>
            <view class="flex flex-col items-center gap-1 py-3 rounded-xl border border-[#E8E0D5]">
              <text class="text-amber-500 text-lg">⚡</text>
              <text class="text-[10px] text-[#999]">推送秒杀</text>
            </view>
          </view>
        </view>

        <!-- 提词器 -->
        <view v-if="showTeleprompter" class="flex-1 flex flex-col overflow-hidden">
          <view class="p-3 border-b border-[#E8E0D5] flex items-center justify-between">
            <view class="flex items-center gap-2">
              <text class="text-blue-500">📜</text>
              <text class="font-medium text-sm text-[#2C2C2C]">提词器</text>
            </view>
            <view class="w-6 h-6 flex items-center justify-center" @click="showTeleprompter = false">
              <text class="text-[#999] text-sm">▼</text>
            </view>
          </view>
          <view class="flex-1 overflow-y-auto p-3 space-y-2">
            <view
              v-for="item in script"
              :key="item.id"
              :class="['p-2.5 rounded-lg border transition-colors', item.isCurrent ? 'bg-[#C41E3A]/10 border-[#C41E3A]' : item.done ? 'bg-[#F5F5F5]/50 border-[#E8E0D5] opacity-60' : 'border-[#E8E0D5] hover:bg-[#F9F6F2]']"
            >
              <view class="flex items-center gap-2 mb-1">
                <text :class="['text-[10px] font-mono px-1.5 py-0.5 rounded', item.isCurrent ? 'bg-[#C41E3A] text-white' : 'bg-[#F5F5F5]']">{{ item.time }}</text>
                <text v-if="item.isCurrent" class="px-1 py-0 rounded bg-[#C41E3A]/20 text-[#C41E3A] text-[10px]">当前</text>
                <text v-if="item.done" class="px-1 py-0 rounded bg-[#F5F5F5] text-[#999] text-[10px]">已完成</text>
              </view>
              <text :class="['text-sm', item.isCurrent ? 'font-medium text-[#2C2C2C]' : 'text-[#666]']">{{ item.content }}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 抽奖对话框 -->
    <view v-if="showLotteryDialog" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40">
      <view class="mx-4 w-[320px] bg-white rounded-2xl overflow-hidden">
        <view class="p-4 border-b border-[#E8E0D5]">
          <text class="text-base font-semibold text-[#2C2C2C] block">发起抽奖</text>
          <text class="text-xs text-[#999] block mt-1">设置抽奖规则和奖品</text>
        </view>
        <view class="p-4 space-y-4">
          <view class="space-y-1">
            <text class="text-xs text-[#666]">奖品名称</text>
            <input placeholder="如：八字精批课程" class="w-full h-10 px-3 border border-[#E8E0D5] rounded-lg text-sm outline-none" />
          </view>
          <view class="grid grid-cols-2 gap-3">
            <view class="space-y-1">
              <text class="text-xs text-[#666]">中奖人数</text>
              <input type="number" placeholder="1" class="w-full h-10 px-3 border border-[#E8E0D5] rounded-lg text-sm outline-none" />
            </view>
            <view class="space-y-1">
              <text class="text-xs text-[#666]">参与条件</text>
              <input placeholder="如：发送弹幕" class="w-full h-10 px-3 border border-[#E8E0D5] rounded-lg text-sm outline-none" />
            </view>
          </view>
          <view class="space-y-1">
            <text class="text-xs text-[#666]">开奖时间（分钟后）</text>
            <input type="number" placeholder="5" class="w-full h-10 px-3 border border-[#E8E0D5] rounded-lg text-sm outline-none" />
          </view>
        </view>
        <view class="flex border-t border-[#E8E0D5]">
          <view class="flex-1 py-3 text-center text-sm border-r border-[#E8E0D5]" @click="showLotteryDialog = false">取消</view>
          <view class="flex-1 py-3 text-center text-sm text-[#C41E3A]" @click="showLotteryDialog = false">开始抽奖</view>
        </view>
      </view>
    </view>

    <!-- 优惠券对话框 -->
    <view v-if="showCouponDialog" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40">
      <view class="mx-4 w-[320px] bg-white rounded-2xl overflow-hidden">
        <view class="p-4 border-b border-[#E8E0D5]">
          <text class="text-base font-semibold text-[#2C2C2C] block">发放优惠券</text>
          <text class="text-xs text-[#999] block mt-1">向直播间观众发放优惠券</text>
        </view>
        <view class="p-4 space-y-4">
          <view class="space-y-1">
            <text class="text-xs text-[#666]">选择优惠券</text>
            <view class="grid grid-cols-2 gap-2">
              <view v-for="coupon in coupons" :key="coupon.name" @click="selectedCoupon = coupon.name" :class="['p-3 rounded-xl border', selectedCoupon === coupon.name ? 'border-[#C41E3A] bg-[#C41E3A]/5' : 'border-[#E8E0D5]']">
                <text class="font-medium text-sm text-[#2C2C2C] block">{{ coupon.name }}</text>
                <text class="text-xs text-[#999]">剩余{{ coupon.count }}张</text>
              </view>
            </view>
          </view>
          <view class="space-y-1">
            <text class="text-xs text-[#666]">发放数量</text>
            <input type="number" placeholder="10" class="w-full h-10 px-3 border border-[#E8E0D5] rounded-lg text-sm outline-none" />
          </view>
        </view>
        <view class="flex border-t border-[#E8E0D5]">
          <view class="flex-1 py-3 text-center text-sm border-r border-[#E8E0D5]" @click="showCouponDialog = false">取消</view>
          <view class="flex-1 py-3 text-center text-sm text-[#C41E3A]" @click="showCouponDialog = false">立即发放</view>
        </view>
      </view>
    </view>

    <!-- 结束直播确认 -->
    <view v-if="showEndDialog" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40">
      <view class="mx-4 w-[320px] bg-white rounded-2xl overflow-hidden">
        <view class="p-4">
          <text class="text-base font-semibold text-[#2C2C2C] block mb-2">确认结束直播？</text>
          <text class="text-sm text-[#999] block">本场直播已进行 {{ formatTime(liveTime) }}，累计观看 {{ liveStats.totalViews }} 人次</text>
          <view class="grid grid-cols-2 gap-3 mt-4">
            <view class="p-3 rounded-xl bg-[#FAF8F5] text-center">
              <text class="text-2xl font-bold text-[#C41E3A] block">{{ liveStats.newFollowers }}</text>
              <text class="text-xs text-[#999]">新增粉丝</text>
            </view>
            <view class="p-3 rounded-xl bg-[#FAF8F5] text-center">
              <text class="text-2xl font-bold text-amber-500 block">¥{{ liveStats.totalGift + liveStats.totalSales }}</text>
              <text class="text-xs text-[#999]">总收入</text>
            </view>
          </view>
        </view>
        <view class="flex border-t border-[#E8E0D5]">
          <view class="flex-1 py-3 text-center text-sm border-r border-[#E8E0D5] text-[#2C2C2C]" @click="showEndDialog = false">继续直播</view>
          <view class="flex-1 py-3 text-center text-sm text-white bg-red-500" @click="confirmEndLive">确认结束</view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onUnmounted, watch, nextTick } from 'vue'

// 实时数据
const liveStats = {
  onlineCount: 1258,
  totalViews: 8560,
  newFollowers: 86,
  totalGift: 2680,
  totalSales: 12800,
  peakOnline: 1580,
  avgWatchTime: '8:32',
  interactionRate: '12.5%',
}

// 弹幕数据
interface DanmakuItem {
  id: number; user: string; content: string; time: string; level: number; isVip: boolean
}

const mockDanmaku: DanmakuItem[] = [
  { id: 1, user: '易学小白', content: '老师讲得真好！', time: '10:23:15', level: 3, isVip: false },
  { id: 2, user: '命理爱好者', content: '这个八字怎么看财运？', time: '10:23:18', level: 5, isVip: true },
  { id: 3, user: '紫微迷', content: '老师能讲讲紫微斗数吗', time: '10:23:22', level: 2, isVip: false },
  { id: 4, user: '风水先生', content: '支持老师！', time: '10:23:25', level: 8, isVip: true },
  { id: 5, user: '新用户001', content: '刚来，老师在讲什么？', time: '10:23:30', level: 1, isVip: false },
  { id: 6, user: '道法自然', content: '八字日主分析很到位', time: '10:23:35', level: 6, isVip: false },
  { id: 7, user: '学易人', content: '请问今天有抽奖吗？', time: '10:23:40', level: 4, isVip: false },
  { id: 8, user: '命理大师粉丝', content: '已购买课程，非常棒！', time: '10:23:45', level: 7, isVip: true },
]

// 连麦申请
interface ConnectRequest {
  id: number; user: string; avatar: string; reason: string; waitTime: string
}

const mockConnectRequests: ConnectRequest[] = [
  { id: 1, user: '命理爱好者', avatar: '', reason: '想请教老师关于日主偏弱的问题', waitTime: '2:30' },
  { id: 2, user: '紫微迷', avatar: '', reason: '我的命盘有疑问想请老师解答', waitTime: '1:15' },
  { id: 3, user: '风水先生', avatar: '', reason: '交流风水布局心得', waitTime: '0:45' },
]

// 商品数据
interface Product {
  id: number; name: string; price: number; stock: number; sold: number; isLive: boolean; isHot: boolean
}

const mockProducts: Product[] = [
  { id: 1, name: '八字命理精讲课程', price: 199, stock: 100, sold: 58, isLive: true, isHot: true },
  { id: 2, name: '紫微斗数入门到精通', price: 299, stock: 50, sold: 32, isLive: false, isHot: false },
  { id: 3, name: '开光貔貅摆件', price: 168, stock: 15, sold: 85, isLive: false, isHot: true },
  { id: 4, name: '专业罗盘（铜制）', price: 398, stock: 8, sold: 42, isLive: false, isHot: false },
  { id: 5, name: '五帝钱套装', price: 88, stock: 3, sold: 97, isLive: false, isHot: false },
]

// 提词器内容
interface ScriptItem {
  id: number; time: string; content: string; done: boolean; isCurrent: boolean
}

const mockScript: ScriptItem[] = [
  { id: 1, time: '00:00', content: '开场白：欢迎各位来到今天的八字命理课堂', done: true, isCurrent: false },
  { id: 2, time: '05:00', content: '第一部分：八字的基本概念和四柱含义', done: true, isCurrent: false },
  { id: 3, time: '15:00', content: '第二部分：十天干的特性与作用关系', done: false, isCurrent: true },
  { id: 4, time: '30:00', content: '第三部分：十二地支的藏干与刑冲合害', done: false, isCurrent: false },
  { id: 5, time: '45:00', content: '第四部分：日主强弱的判断方法', done: false, isCurrent: false },
  { id: 6, time: '55:00', content: '互动环节：观众提问与命盘分析', done: false, isCurrent: false },
  { id: 7, time: '58:00', content: '结尾：课程推荐和下期预告', done: false, isCurrent: false },
]

// 优惠券数据
const coupons = [
  { name: '满100减10', count: 100 },
  { name: '满200减30', count: 50 },
  { name: '课程8折券', count: 30 },
]

const quickReplies = ['欢迎新朋友', '感谢关注', '稍后解答', '请耐心等待']

// 状态
const isLive = ref(true)
const isMuted = ref(false)
const showTeleprompter = ref(true)
const activeTab = ref<'danmaku' | 'connect'>('danmaku')
const liveTime = ref(3892)
const showLotteryDialog = ref(false)
const selectedCoupon = ref('')
const showCouponDialog = ref(false)
const showEndDialog = ref(false)
const replyText = ref('')

const danmakuList = ref<DanmakuItem[]>(mockDanmaku)
const danmakuScrollTop = ref(0)
const connectRequests = ref<ConnectRequest[]>(mockConnectRequests)
const products = ref<Product[]>(mockProducts)
const script = ref<ScriptItem[]>(mockScript)

// 当前讲解商品
const currentProduct = computed(() => products.value.find(p => p.isLive))
const otherProducts = computed(() => products.value.filter(p => !p.isLive))

// 直播计时
let timer: ReturnType<typeof setInterval> | null = setInterval(() => { if (isLive.value) liveTime.value++ }, 1000)
onUnmounted(() => { if (timer) clearInterval(timer) })

// 模拟实时弹幕
let danmakuTimer: ReturnType<typeof setInterval> | null = setInterval(() => {
  const mockMessages = ['老师讲得太好了！', '学到了很多', '这个知识点很重要', '请问老师...', '感谢老师分享', '涨知识了', '求老师讲讲风水']
  const mockUsers = ['易学新人', '命理迷', '国学爱好者', '道友', '学习中', '小白一枚']
  const newDanmaku: DanmakuItem = {
    id: Date.now(),
    user: mockUsers[Math.floor(Math.random() * mockUsers.length)],
    content: mockMessages[Math.floor(Math.random() * mockMessages.length)],
    time: '刚刚',
    level: Math.floor(Math.random() * 10) + 1,
    isVip: Math.random() > 0.8,
  }
  danmakuList.value = [...danmakuList.value.slice(-50), newDanmaku]
}, 3000)

onUnmounted(() => { if (danmakuTimer) clearInterval(danmakuTimer) })

// 弹幕自动滚到底部
watch(() => danmakuList.value.length, () => {
  nextTick(() => { danmakuScrollTop.value = danmakuScrollTop.value + 99999 })
})

// 格式化
function formatTime(seconds: number): string {
  const h = Math.floor(seconds / 3600)
  const m = Math.floor((seconds % 3600) / 60)
  const s = seconds % 60
  return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
}

// 商品上架讲解
function handleProductLive(productId: number) {
  products.value = products.value.map(p => ({ ...p, isLive: p.id === productId }))
}

// 连麦操作
function handleAcceptConnect(id: number) {
  connectRequests.value = connectRequests.value.filter(r => r.id !== id)
}

function handleRejectConnect(id: number) {
  connectRequests.value = connectRequests.value.filter(r => r.id !== id)
}

// 弹幕操作
function handlePin(id: number) {
  danmakuList.value = danmakuList.value.map(d => d.id === id ? { ...d, isPinned: !d.isPinned } : d)
  uni.showToast({ title: '已置顶', icon: 'success' })
}

function handleReplyToDanmaku(id: number) {
  const dm = danmakuList.value.find(d => d.id === id)
  replyText.value = '@' + (dm?.userName || '用户') + ' '
}

function handleDeleteDanmaku(id: number) {
  danmakuList.value = danmakuList.value.filter(d => d.id !== id)
  uni.showToast({ title: '已删除弹幕', icon: 'none' })
}

function handleBanUser(id: number) {
  danmakuList.value = danmakuList.value.filter(d => d.userId !== id)
  uni.showToast({ title: '已禁言', icon: 'success' })
}

// 发送弹幕
function sendDanmaku() {
  if (!replyText.value.trim()) return
  danmakuList.value.unshift({
    id: Date.now(),
    user: '主播',
    content: replyText.value,
    time: '刚刚',
    level: 99,
    isVip: true,
  })
  replyText.value = ''
}

// 结束直播
function confirmEndLive() {
  isLive.value = false
  showEndDialog.value = false
  if (timer) { clearInterval(timer); timer = null }
  uni.showToast({ title: '直播已结束', icon: 'none' })
  setTimeout(() => uni.navigateBack(), 1000)
}

function handleRefreshStock() {
  uni.showToast({ title: '库存已刷新', icon: 'none' })
}

function routerBack() { uni.navigateBack() }
</script>

