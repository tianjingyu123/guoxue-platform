<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-24">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-50 bg-[#FAF8F5]/95 backdrop-blur-lg border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 h-14">
        <view class="flex items-center gap-3">
          <view @click="goBack" class="p-1"><text class="text-xl text-[#2C2C2C]">←</text></view>
          <text class="text-lg font-semibold text-[#2C2C2C]">直播间装修</text>
        </view>
        <view @click="saveConfig" class="px-3 py-1.5 rounded-lg bg-[#C41E3A] text-white text-xs">保存配置</view>
      </view>
    </view>

    <view class="p-4 space-y-4">
      <!-- Tab -->
      <view class="flex gap-2 bg-[#F5F5F5] rounded-lg p-1">
        <view v-for="t in settingTabs" :key="t.key" @click="activeTab = t.key" :class="['flex-1 py-2 rounded-md text-xs font-medium text-center', activeTab === t.key ? 'bg-white shadow-sm text-[#2C2C2C]' : 'text-[#999]']">
          <text>{{ t.icon }} {{ t.label }}</text>
        </view>
      </view>

      <!-- 主题模版Tab -->
      <view v-if="activeTab === 'templates'" class="space-y-4">
        <view>
          <text class="text-sm font-medium text-[#2C2C2C] mb-3 block">预设氛围模版</text>
          <view class="grid grid-cols-2 gap-3">
            <view v-for="theme in themeTemplates" :key="theme.id" @click="selectedTheme = theme.id" :class="['relative overflow-hidden rounded-xl border-2 bg-white', selectedTheme === theme.id ? 'border-[#C41E3A]' : 'border-[#E8E0D5]']">
              <view :class="['h-20 bg-gradient-to-br flex items-center justify-center', theme.bgGradient]">
                <text class="text-3xl">{{ theme.preview }}</text>
                <view v-if="selectedTheme === theme.id" class="absolute top-2 right-2 w-5 h-5 rounded-full bg-[#C41E3A] flex items-center justify-center"><text class="text-white text-xs">✓</text></view>
                <text v-if="!theme.isFree" class="absolute top-2 left-2 text-[10px] px-1.5 py-0.5 rounded bg-amber-500 text-white flex items-center gap-0.5">👑 会员</text>
                <text v-if="theme.isUsing" class="absolute bottom-2 right-2 text-[10px] px-1.5 py-0.5 rounded bg-green-500 text-white">使用中</text>
              </view>
              <view class="p-2.5">
                <text class="text-sm font-medium text-[#2C2C2C] block">{{ theme.name }}</text>
                <text class="text-[10px] text-[#999] block mt-0.5">{{ theme.desc }}</text>
                <view class="flex items-center gap-1.5 mt-2">
                  <view class="w-4 h-4 rounded-full border-2 border-white shadow-sm" :style="{ backgroundColor: theme.primaryColor }" />
                  <view class="w-4 h-4 rounded-full border-2 border-white shadow-sm" :style="{ backgroundColor: theme.secondaryColor }" />
                  <text class="text-[10px] text-[#999] ml-1">主色调</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 自定义主题 -->
        <view class="p-4 rounded-xl bg-white border border-[#E8E0D5]">
          <view class="flex items-center justify-between mb-3">
            <text class="text-sm font-medium text-[#2C2C2C]">自定义主题</text>
            <text class="text-[10px] px-1.5 py-0.5 rounded border border-[#E8E0D5] flex items-center gap-0.5">👑 高级会员专享</text>
          </view>
          <view class="mb-4">
            <text class="text-xs text-[#999] mb-2 block">品牌Logo</text>
            <view class="flex items-center gap-3">
              <view class="w-16 h-16 rounded-xl border-2 border-dashed border-[#E8E0D5] flex items-center justify-center bg-[#F5F5F5]/30">
                <text class="text-lg text-[#999]">📤</text>
              </view>
              <view class="text-xs text-[#999]">
                <text class="block">支持PNG/JPG格式</text>
                <text class="block">建议尺寸200x200px</text>
              </view>
            </view>
          </view>
          <view class="mb-4">
            <text class="text-xs text-[#999] mb-2 block">主色调</text>
            <view class="flex items-center gap-2 flex-wrap">
              <view v-for="color in presetColors" :key="color" @click="customColor = color" :class="['w-8 h-8 rounded-full border-2 transition-transform', customColor === color ? 'scale-110 border-white shadow-lg' : 'border-transparent']" :style="{ backgroundColor: color }" />
              <label class="w-8 h-8 rounded-full border-2 border-dashed border-[#E8E0D5] flex items-center justify-center relative overflow-hidden">
                <text class="text-sm text-[#999]">✚</text>
                <input type="color" class="w-0 h-0 opacity-0 absolute" @input="customColor = ($event as any).detail.value" />
              </label>
            </view>
          </view>
          <view>
            <text class="text-xs text-[#999] mb-2 block">自定义背景</text>
            <view class="grid grid-cols-3 gap-2">
              <view class="aspect-video rounded-lg border-2 border-dashed border-[#E8E0D5] flex items-center justify-center bg-[#F5F5F5]/30">
                <view class="text-center"><text class="text-lg text-[#999] block">📤</text><text class="text-[10px] text-[#999] mt-1 block">上传图片</text></view>
              </view>
              <view class="aspect-video rounded-lg border-2 border-dashed border-[#E8E0D5] flex items-center justify-center bg-[#F5F5F5]/30">
                <view class="text-center"><text class="text-lg text-[#999] block">▶</text><text class="text-[10px] text-[#999] mt-1 block">上传视频</text></view>
              </view>
              <view class="aspect-video rounded-lg bg-gradient-to-br from-emerald-500 to-emerald-700 flex items-center justify-center">
                <text class="text-[10px] text-white font-medium">绿幕</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 视觉元素Tab -->
      <view v-if="activeTab === 'elements'" class="space-y-4">
        <view class="p-4 rounded-xl bg-white border border-[#E8E0D5]">
          <text class="text-sm font-medium text-[#2C2C2C] mb-3 block">背景设置</text>
          <view class="space-y-3">
            <view class="flex items-center justify-between"><text class="text-sm text-[#2C2C2C]">背景模糊</text><text class="text-xs text-[#999]">{{ blurValue }}%</text></view>
            <view class="h-2 bg-[#F5F5F5] rounded-full relative">
              <view class="h-full bg-[#C41E3A] rounded-full" :style="{ width: blurValue + '%' }" />
              <view class="absolute top-1/2 -translate-y-1/2 w-4 h-4 bg-white rounded-full shadow border border-[#E8E0D5]" :style="{ left: blurValue + '%', marginLeft: '-8px' }" />
            </view>
            <view class="flex items-center justify-between mt-4"><text class="text-sm text-[#2C2C2C]">背景暗度</text><text class="text-xs text-[#999]">{{ darkValue }}%</text></view>
            <view class="h-2 bg-[#F5F5F5] rounded-full relative">
              <view class="h-full bg-[#2C2C2C] rounded-full" :style="{ width: darkValue + '%' }" />
              <view class="absolute top-1/2 -translate-y-1/2 w-4 h-4 bg-white rounded-full shadow border border-[#E8E0D5]" :style="{ left: darkValue + '%', marginLeft: '-8px' }" />
            </view>
          </view>
        </view>

        <view class="p-4 rounded-xl bg-white border border-[#E8E0D5]">
          <view class="flex items-center justify-between mb-3">
            <text class="text-sm font-medium text-[#2C2C2C]">直播间挂件</text>
            <view class="px-2 py-1 rounded-lg border border-[#E8E0D5] text-xs flex items-center gap-1"><text>✚</text> 添加挂件</view>
          </view>
          <view class="grid grid-cols-2 gap-2">
            <view v-for="pendant in pendants" :key="pendant.id" @click="togglePendant(pendant.id)" :class="['flex items-center gap-3 p-3 rounded-lg border', activePendants.includes(pendant.id) ? 'border-[#C41E3A] bg-[#C41E3A]/5' : 'border-[#E8E0D5]']">
              <view class="w-10 h-10 rounded-lg bg-[#F5F5F5] flex items-center justify-center text-xl">{{ pendant.icon }}</view>
              <view class="flex-1 min-w-0">
                <text class="text-sm font-medium text-[#2C2C2C] block">{{ pendant.name }}</text>
                <text class="text-[10px] text-[#999] block">位置：{{ pendant.position }}</text>
              </view>
              <view :class="['w-11 h-6 rounded-full relative', activePendants.includes(pendant.id) ? 'bg-[#C41E3A]' : 'bg-[#E8E0D5]']">
                <view :class="['absolute top-0.5 w-5 h-5 bg-white rounded-full shadow transition-all', activePendants.includes(pendant.id) ? 'right-0.5' : 'left-0.5']" />
              </view>
            </view>
          </view>
        </view>

        <view class="p-4 rounded-xl bg-white border border-[#E8E0D5]">
          <text class="text-sm font-medium text-[#2C2C2C] mb-3 block">UI组件样式</text>
          <view class="space-y-3">
            <view class="flex items-center justify-between p-2 rounded-lg bg-[#F5F5F5]/30"><view class="flex items-center gap-2"><text class="text-sm text-[#999]">👥</text><text class="text-sm text-[#2C2C2C]">观众列表样式</text></view><text class="text-[10px] px-1.5 py-0.5 rounded border border-[#E8E0D5] text-[#999]">头像堆叠</text></view>
            <view class="flex items-center justify-between p-2 rounded-lg bg-[#F5F5F5]/30"><view class="flex items-center gap-2"><text class="text-sm text-[#999]">🎁</text><text class="text-sm text-[#2C2C2C]">礼物栏样式</text></view><text class="text-[10px] px-1.5 py-0.5 rounded border border-[#E8E0D5] text-[#999]">底部横条</text></view>
            <view class="flex items-center justify-between p-2 rounded-lg bg-[#F5F5F5]/30"><view class="flex items-center gap-2"><text class="text-sm text-[#999]">❤️</text><text class="text-sm text-[#2C2C2C]">弹幕气泡样式</text></view><text class="text-[10px] px-1.5 py-0.5 rounded border border-[#E8E0D5] text-[#999]">圆角气泡</text></view>
          </view>
        </view>
      </view>

      <!-- 动效配置Tab -->
      <view v-if="activeTab === 'effects'" class="space-y-4">
        <view class="p-4 rounded-xl bg-white border border-[#E8E0D5]">
          <text class="text-sm font-medium text-[#2C2C2C] mb-3 block">动效开关</text>
          <view class="space-y-3">
            <view v-for="effect in effects" :key="effect.id" class="flex items-center justify-between p-3 rounded-lg border border-[#E8E0D5]">
              <view class="flex items-center gap-3">
                <view :class="['w-10 h-10 rounded-lg flex items-center justify-center', effectSettings[effect.type as keyof typeof effectSettings] ? 'bg-[#C41E3A]/10 text-[#C41E3A]' : 'bg-[#F5F5F5] text-[#999]']">
                  <text>{{ effect.icon }}</text>
                </view>
                <view>
                  <text class="text-sm font-medium text-[#2C2C2C] block">{{ effect.name }}</text>
                  <text class="text-[10px] text-[#999] block">{{ effect.desc }}</text>
                </view>
              </view>
              <view @click="toggleEffect(effect.type)" :class="['w-11 h-6 rounded-full relative', effectSettings[effect.type as keyof typeof effectSettings] ? 'bg-[#C41E3A]' : 'bg-[#E8E0D5]']">
                <view :class="['absolute top-0.5 w-5 h-5 bg-white rounded-full shadow transition-all', effectSettings[effect.type as keyof typeof effectSettings] ? 'right-0.5' : 'left-0.5']" />
              </view>
            </view>
          </view>
        </view>

        <view class="p-4 rounded-xl bg-white border border-[#E8E0D5]">
          <text class="text-sm font-medium text-[#2C2C2C] mb-3 block">入场特效样式</text>
          <view class="grid grid-cols-3 gap-2">
            <view v-for="(style, idx) in enterStyles" :key="style" :class="['p-3 rounded-lg border text-center', idx === 0 ? 'border-[#C41E3A] bg-[#C41E3A]/5' : 'border-[#E8E0D5]']">
              <view class="w-8 h-8 rounded-full bg-[#F5F5F5] mx-auto mb-1.5 flex items-center justify-center text-sm">{{ enterIcons[idx] }}</view>
              <text class="text-[10px] text-[#2C2C2C]">{{ style }}</text>
            </view>
          </view>
        </view>

        <view class="p-4 rounded-xl bg-white border border-[#E8E0D5]">
          <text class="text-sm font-medium text-[#2C2C2C] mb-3 block">点赞动效样式</text>
          <view class="grid grid-cols-4 gap-2">
            <view v-for="(style, idx) in likeStyles" :key="style" :class="['p-2 rounded-lg border text-center', idx === 0 ? 'border-[#C41E3A] bg-[#C41E3A]/5' : 'border-[#E8E0D5]']">
              <text class="text-xs text-[#2C2C2C]">{{ style }}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 预览区 -->
      <view class="rounded-xl overflow-hidden border border-[#E8E0D5] bg-white">
        <view class="flex items-center justify-between px-3 py-2 border-b border-[#E8E0D5] bg-[#F5F5F5]/30">
          <text class="text-xs font-medium text-[#2C2C2C]">实时预览</text>
          <view class="flex items-center gap-1">
            <view @click="isPreviewPlaying = !isPreviewPlaying" class="w-6 h-6 rounded flex items-center justify-center"><text class="text-sm">{{ isPreviewPlaying ? '⏸' : '▶' }}</text></view>
            <view class="w-6 h-6 rounded flex items-center justify-center"><text class="text-sm">🔄</text></view>
          </view>
        </view>
        <view :class="['aspect-[9/16] relative overflow-hidden bg-gradient-to-br', currentTheme.bgGradient]">
          <view class="absolute top-3 left-3 right-3 flex items-center justify-between">
            <view class="flex items-center gap-2 px-2 py-1 bg-black/30 rounded-full">
              <view class="w-6 h-6 rounded-full bg-gradient-to-br from-[#C41E3A] to-[#E74C3C] flex items-center justify-center text-[10px] text-white">主</view>
              <text class="text-white text-[10px]">主播昵称</text>
            </view>
            <view class="flex items-center gap-1 px-2 py-1 bg-black/30 rounded-full"><text class="text-white/70 text-xs">👁</text><text class="text-white text-[10px]">1.2万</text></view>
          </view>
          <view v-if="activePendants.includes(1)" class="absolute top-12 left-3 text-2xl opacity-80">福</view>
          <view v-if="activePendants.includes(4)" class="absolute top-12 right-3 text-xl opacity-80">🪙</view>
          <view class="absolute left-3 bottom-32 space-y-1.5 max-w-[70%]">
            <view class="px-2 py-1 bg-black/40 rounded-full"><text class="text-[10px] text-white"><text class="text-amber-400 mr-1">用户A</text>老师讲得真好！</text></view>
            <view class="px-2 py-1 bg-black/40 rounded-full"><text class="text-[10px] text-white"><text class="text-amber-400 mr-1">用户B</text>涨知识了</text></view>
          </view>
          <view v-if="effectSettings.like && isPreviewPlaying" class="absolute right-6 bottom-40 space-y-2 animate-float">
            <text class="text-red-500 text-lg block opacity-80">❤️</text>
            <text class="text-red-500 text-base block opacity-60">❤️</text>
            <text class="text-red-500 text-sm block opacity-40">❤️</text>
          </view>
          <view class="absolute bottom-3 left-3 right-3">
            <view class="flex items-center gap-2">
              <view class="flex-1 h-8 px-3 bg-white/10 rounded-full flex items-center"><text class="text-[10px] text-white/50">说点什么...</text></view>
              <view class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center"><text class="text-white">❤️</text></view>
              <view class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center"><text class="text-white">🎁</text></view>
            </view>
          </view>
          <view class="absolute bottom-16 left-3 right-3">
            <view class="h-1 rounded-full opacity-50" :style="{ backgroundColor: currentTheme.primaryColor }" />
          </view>
        </view>
        <view class="p-3">
          <view class="text-[10px] text-[#999] space-y-1.5">
            <view class="flex items-center justify-between"><text>主题模版</text><text class="font-medium text-[#2C2C2C]">{{ currentTheme.name }}</text></view>
            <view class="flex items-center justify-between"><text>已启用挂件</text><text class="font-medium text-[#2C2C2C]">{{ activePendants.length }}个</text></view>
            <view class="flex items-center justify-between"><text>已启用动效</text><text class="font-medium text-[#2C2C2C]">{{ enabledEffectsCount }}个</text></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="fixed bottom-0 left-0 right-0 bg-white border-t border-[#E8E0D5] p-4" style="padding-bottom:calc(16px + env(safe-area-inset-bottom))">
      <view class="flex gap-3">
        <view @click="resetDefault" class="flex-1 py-3 rounded-xl border border-[#E8E0D5] text-center text-sm font-medium text-[#2C2C2C]">重置默认</view>
        <view @click="saveConfig" class="flex-1 py-3 rounded-xl bg-[#C41E3A] text-center text-sm font-medium text-white">保存并应用</view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

interface ThemeTemplate { id: string; name: string; desc: string; primaryColor: string; secondaryColor: string; bgGradient: string; preview: string; isFree: boolean; isUsing: boolean }
interface Pendant { id: number; name: string; icon: string; position: string; isActive: boolean }
interface Effect { id: number; name: string; type: string; desc: string; icon: string }

const themeTemplates: ThemeTemplate[] = [
  { id: 'default', name: '默认主题', desc: '简洁大气，适合日常直播', primaryColor: '#8B5CF6', secondaryColor: '#A78BFA', bgGradient: 'from-gray-900 to-gray-800', preview: '🎯', isFree: true, isUsing: true },
  { id: 'chinese', name: '新中式', desc: '古典韵味，国学文化氛围', primaryColor: '#DC2626', secondaryColor: '#F59E0B', bgGradient: 'from-red-950 to-amber-950', preview: '🏮', isFree: true, isUsing: false },
  { id: 'spring', name: '春节喜庆', desc: '红红火火，节日氛围拉满', primaryColor: '#EF4444', secondaryColor: '#FCD34D', bgGradient: 'from-red-600 to-red-900', preview: '🧧', isFree: false, isUsing: false },
  { id: 'mid-autumn', name: '中秋团圆', desc: '月圆人圆，温馨典雅', primaryColor: '#F59E0B', secondaryColor: '#FDE68A', bgGradient: 'from-amber-900 to-orange-950', preview: '🥮', isFree: false, isUsing: false },
  { id: 'minimalist', name: '极简白', desc: '干净清爽，专注内容', primaryColor: '#6366F1', secondaryColor: '#818CF8', bgGradient: 'from-slate-100 to-slate-200', preview: '⬜', isFree: true, isUsing: false },
  { id: 'ink', name: '水墨风', desc: '淡雅水墨，文人气质', primaryColor: '#374151', secondaryColor: '#9CA3AF', bgGradient: 'from-stone-800 to-stone-900', preview: '🖌', isFree: false, isUsing: false },
]

const settingTabs = [
  { key: 'templates', label: '主题模版', icon: '🎨' },
  { key: 'elements', label: '视觉元素', icon: '🖼' },
  { key: 'effects', label: '动效配置', icon: '✨' },
]

const pendants: Pendant[] = [
  { id: 1, name: '福字', icon: '福', position: '左上', isActive: true },
  { id: 2, name: '灯笼', icon: '🏮', position: '右上', isActive: false },
  { id: 3, name: '祥云', icon: '☁️', position: '顶部', isActive: false },
  { id: 4, name: '铜钱', icon: '🪙', position: '角落', isActive: true },
]

const effects: Effect[] = [
  { id: 1, name: '入场特效', type: 'enter', desc: '观众进入直播间动画', icon: '👥' },
  { id: 2, name: '点赞特效', type: 'like', desc: '爱心上浮动画样式', icon: '❤️' },
  { id: 3, name: '礼物特效', type: 'gift', desc: '礼物飞屏动画', icon: '🎁' },
  { id: 4, name: '弹幕样式', type: 'danmaku', desc: '弹幕气泡外观', icon: '✨' },
]

const presetColors = ['#8B5CF6', '#EF4444', '#F59E0B', '#10B981', '#3B82F6', '#EC4899']
const enterStyles = ['祥云入场', '金光闪烁', '简约淡入', '烟花绽放', '波纹扩散', '无特效']
const enterIcons = ['☁️', '✨', '💫', '🎆', '🌊', '⬜']
const likeStyles = ['❤️ 爱心', '👍 点赞', '🌸 花瓣', '⭐ 星星']

const activeTab = ref('templates')
const selectedTheme = ref('default')
const customColor = ref('#8B5CF6')
const isPreviewPlaying = ref(true)
const activePendants = ref<number[]>([1, 4])
const blurValue = ref(30)
const darkValue = ref(50)

const effectSettings = ref<Record<string, boolean>>({ enter: true, like: true, gift: true, danmaku: false })

const currentTheme = computed(() => themeTemplates.find(t => t.id === selectedTheme.value) || themeTemplates[0])
const enabledEffectsCount = computed(() => Object.values(effectSettings.value).filter(Boolean).length)

function togglePendant(id: number) {
  const idx = activePendants.value.indexOf(id)
  if (idx >= 0) activePendants.value.splice(idx, 1)
  else activePendants.value.push(id)
}

function toggleEffect(type: string) {
  effectSettings.value[type] = !effectSettings.value[type]
}

function saveConfig() {
  uni.showToast({ title: '配置已保存', icon: 'none' })
}

function resetDefault() {
  selectedTheme.value = 'default'
  activePendants.value = [1, 4]
  effectSettings.value = { enter: true, like: true, gift: true, danmaku: false }
  blurValue.value = 30
  darkValue.value = 50
  uni.showToast({ title: '已重置为默认', icon: 'none' })
}

function goBack() { uni.navigateBack() }
</script>

<style scoped>
.animate-float {
  animation: float 2s ease-in-out infinite;
}
@keyframes float {
  0%, 100% { transform: translateY(0); opacity: 0.8; }
  50% { transform: translateY(-10px); opacity: 1; }
}
</style>
