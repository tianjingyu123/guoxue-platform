<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- 导航栏 -->
    <view class="flex items-center justify-between px-4 h-12 bg-white border-b border-[#E8E0D5] shrink-0">
      <view class="p-1" @click="goBack">
        <text class="text-xl text-[#2C2C2C]">←</text>
      </view>
      <text class="text-base font-semibold text-[#2C2C2C]">售后记录</text>
      <view class="w-7" />
    </view>

    <!-- 骨架屏 -->
    <view v-if="loading" class="flex-1 p-4">
      <view class="flex gap-2 mb-4">
        <view v-for="i in 4" :key="i" class="h-8 flex-1 bg-[#F0EBE5] rounded-lg skeleton-pulse" />
      </view>
      <view v-for="i in 4" :key="i" class="bg-white rounded-xl p-3.5 mb-2.5 skeleton-pulse">
        <view class="space-y-2">
          <view class="h-4 w-3/4 bg-[#F0EBE5] rounded skeleton-pulse" />
          <view class="h-3 w-1/2 bg-[#F0EBE5] rounded skeleton-pulse" />
          <view class="h-3 w-2/3 bg-[#F0EBE5] rounded skeleton-pulse" />
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view v-else-if="filteredList.length === 0" class="flex-1 flex flex-col items-center justify-center p-8">
      <text class="text-5xl mb-4">📦</text>
      <text class="text-sm text-[#999] mb-2">暂无售后记录</text>
      <text class="text-xs text-[#bbb]">已完成的订单会自动归档</text>
    </view>

    <!-- 主内容 -->
    <view v-else class="flex-1 flex flex-col">
      <!-- 状态筛选 -->
      <view class="flex bg-white border-b border-[#E8E0D5]">
        <view v-for="tab in statusTabs" :key="tab.key" class="flex-1 py-2.5 text-center text-sm relative"
          :class="activeStatus === tab.key ? 'text-[#C41E3A] font-medium' : 'text-[#999]'"
          @click="activeStatus = tab.key">
          <text>{{ tab.label }}</text>
          <text class="text-[10px] ml-0.5">({{ tab.count }})</text>
          <view v-if="activeStatus === tab.key" class="absolute bottom-0 left-1/4 right-1/4 h-0.5 bg-[#C41E3A] rounded-full" />
        </view>
      </view>

      <!-- 售后类型快速筛选 -->
      <view class="flex items-center gap-2 px-4 py-2.5 bg-white border-b border-[#E8E0D5]">
        <text class="text-[11px] text-[#999] mr-0.5">类型：</text>
        <view v-for="tp in typeOptions" :key="tp.key"
          class="text-[11px] px-2.5 py-0.5 rounded-full"
          :class="activeType === tp.key ? 'bg-[#C41E3A]/10 text-[#C41E3A]' : 'bg-[#F5F1EB] text-[#999]'"
          @click="activeType = tp.key">
          <text>{{ tp.label }}</text>
        </view>
      </view>

      <!-- 快速筛选说明 -->
      <view class="px-4 py-2 bg-[#FAF8F5]">
        <text class="text-xs text-[#999]">点击标签可筛选不同状态的售后记录</text>
      </view>
      <scroll-view scroll-y class="flex-1 overflow-y-auto" refresher-enabled @refresherrefresh="onRefresh" :refresher-triggered="refreshing">
        <view class="p-4 pb-4">
          <view v-for="item in filteredList" :key="item.id" class="bg-white rounded-xl p-3.5 mb-2.5 shadow-sm active:opacity-80" @click="goDetail(item.id)">
            <!-- 顶部：商品名 + 状态 -->
            <view class="flex items-start justify-between mb-2">
              <view class="flex items-center gap-2 flex-1 min-w-0">
                <view class="w-10 h-10 rounded-lg bg-[#F5F1EB] flex items-center justify-center text-xl shrink-0">
                  <text>{{ item.icon }}</text>
                </view>
                <view class="min-w-0">
                  <text class="text-sm font-medium text-[#2C2C2C] block truncate">{{ item.productName }}</text>
                  <text class="text-[11px] text-[#999] block">{{ item.spec }}</text>
                </view>
              </view>
              <view class="shrink-0 ml-2">
                <view class="text-[11px] px-2 py-0.5 rounded-full"
                  :class="item.status === 'pending' ? 'bg-[#FFF3E0] text-[#E65100]' :
                    item.status === 'processing' ? 'bg-[#E3F2FD] text-[#1565C0]' :
                    item.status === 'done' ? 'bg-[#E8F5E9] text-[#4CAF50]' :
                    item.status === 'rejected' ? 'bg-[#FFEBEE] text-[#C41E3A]' : ''">
                  <text>{{ item.statusLabel }}</text>
                </view>
              </view>
            </view>

            <!-- 售后信息 -->
            <view class="bg-[#FAF8F5] rounded-lg p-2.5 mb-2">
              <view class="flex justify-between items-center mb-1">
                <text class="text-[11px] text-[#999]">售后类型</text>
                <text class="text-[11px] text-[#2C2C2C]">{{ item.type }}</text>
              </view>
              <view class="flex justify-between items-center mb-1">
                <text class="text-[11px] text-[#999]">申请时间</text>
                <text class="text-[11px] text-[#2C2C2C]">{{ item.applyTime }}</text>
              </view>
              <view class="flex justify-between items-center">
                <text class="text-[11px] text-[#999]">退款金额</text>
                <text class="text-[11px] text-[#C41E3A] font-medium">¥{{ item.refundAmount }}</text>
              </view>
            </view>

            <!-- 进度条 -->
            <view class="flex items-center gap-1 mt-1">
              <view class="flex-1 h-1 rounded-full bg-[#F0EBE5] overflow-hidden">
                <view class="h-full rounded-full"
                  :style="{ width: item.progress + '%' }"
                  :class="item.status === 'done' ? 'bg-[#4CAF50]' : item.status === 'rejected' ? 'bg-[#C41E3A]' : 'bg-[#C9A96E]'" />
              </view>
              <text class="text-[10px] text-[#999]">{{ item.progress }}%</text>
            </view>

            <!-- 底部 -->
            <view class="flex items-center justify-between mt-2 pt-2 border-t border-[#FAF8F5]">
              <text class="text-[11px] text-[#999]">订单号：{{ item.orderNo }}</text>
              <text class="text-xs text-[#C9A96E]">查看详情 ›</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

const loading = ref(true)
const refreshing = ref(false)
const activeStatus = ref('all')
const activeType = ref('all')

const typeOptions = [
  { key: 'all', label: '全部' },
  { key: '退货退款', label: '退货退款' },
  { key: '换货', label: '换货' },
  { key: '退款', label: '仅退款' },
]

/** 售后类型标签对应的显示文本 */
const typeLabels: Record<string, string> = {
  '退货退款': '退货退款',
  '换货': '换货',
  '退款': '仅退款',
}

interface AfterSale {
  id: string
  productName: string
  spec: string
  icon: string
  type: string
  status: 'pending' | 'processing' | 'done' | 'rejected'
  statusLabel: string
  applyTime: string
  refundAmount: number
  progress: number
  orderNo: string
}

const allList = ref<AfterSale[]>([
  { id: '1', productName: '《渊海子平》精装典藏版', spec: '精装·1册', icon: '📚', type: '退货退款', status: 'pending', statusLabel: '等待处理', applyTime: '2024-06-08 14:30', refundAmount: 168, progress: 10, orderNo: 'DD20240608001' },
  { id: '2', productName: '黑曜石本命佛手链', spec: '8mm·1串', icon: '📿', type: '换货', status: 'processing', statusLabel: '处理中', applyTime: '2024-06-05 10:15', refundAmount: 0, progress: 45, orderNo: 'DD20240605002' },
  { id: '3', productName: '紫檀木念珠108颗', spec: '8mm·1串', icon: '📿', type: '退货退款', status: 'done', statusLabel: '已完成', applyTime: '2024-05-28 09:00', refundAmount: 399, progress: 100, orderNo: 'DD20240528003' },
  { id: '4', productName: '《周易入门》精讲课程', spec: '视频课·20节', icon: '🎬', type: '退款', status: 'rejected', statusLabel: '已拒绝', applyTime: '2024-05-20 16:45', refundAmount: 299, progress: 100, orderNo: 'DD20240520004' },
  { id: '5', productName: '铜质风水罗盘', spec: '标准款·1个', icon: '🧭', type: '退货退款', status: 'processing', statusLabel: '处理中', applyTime: '2024-06-01 11:20', refundAmount: 528, progress: 60, orderNo: 'DD20240601005' },
  { id: '6', productName: '《道德经》书法字帖', spec: '线装·1套', icon: '📜', type: '换货', status: 'done', statusLabel: '已完成', applyTime: '2024-05-15 08:30', refundAmount: 0, progress: 100, orderNo: 'DD20240515006' },
  { id: '7', productName: '翡翠A级貔貅吊坠', spec: '天然A货·1件', icon: '💎', type: '退货退款', status: 'pending', statusLabel: '等待处理', applyTime: '2024-06-09 19:50', refundAmount: 1280, progress: 15, orderNo: 'DD20240609007' },
  { id: '8', productName: '国学年费会员', spec: '12个月·自动续费', icon: '⭐', type: '退款', status: 'rejected', statusLabel: '已拒绝', applyTime: '2024-05-10 12:00', refundAmount: 365, progress: 100, orderNo: 'DD20240510008' },
  { id: '9', productName: '和田玉平安扣', spec: '直径25mm·1枚', icon: '💎', type: '退货退款', status: 'pending', statusLabel: '等待处理', applyTime: '2024-06-10 09:15', refundAmount: 680, progress: 5, orderNo: 'DD20240610009' },
  { id: '10', productName: '《四库全书》子部精华', spec: '精装·全6册', icon: '📚', type: '换货', status: 'processing', statusLabel: '处理中', applyTime: '2024-06-07 13:40', refundAmount: 0, progress: 35, orderNo: 'DD20240607010' },
])

const statusTabs = computed(() => {
  const counts: Record<string, number> = { all: allList.value.length }
  allList.value.forEach(item => {
    counts[item.status] = (counts[item.status] || 0) + 1
  })
  return [
    { key: 'all', label: '全部', count: counts.all },
    { key: 'pending', label: '待处理', count: counts.pending || 0 },
    { key: 'processing', label: '处理中', count: counts.processing || 0 },
    { key: 'done', label: '已完成', count: counts.done || 0 },
    { key: 'rejected', label: '已拒绝', count: counts.rejected || 0 },
  ]
})

const filteredList = computed(() => {
  if (activeStatus.value === 'all') return allList.value
  return allList.value.filter(item => item.status === activeStatus.value)
})

function goDetail(id: string) {
  uni.navigateTo({ url: `/pages/aftersale/detail/index?id=${id}` })
}

function onRefresh() {
  refreshing.value = true
  setTimeout(() => { refreshing.value = false }, 1000)
}

function goBack() { uni.navigateBack() }

setTimeout(() => { loading.value = false }, 1000)
</script>

<style scoped>
.skeleton-pulse {
  animation: pulse 1.5s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.8; }
}
/* 样式由 Tailwind 处理 */
</style>
