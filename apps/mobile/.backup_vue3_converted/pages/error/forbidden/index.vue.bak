<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- 加载骨架屏 -->
    <template v-if="loading">
      <view class="flex flex-col items-center justify-center p-6 flex-1">
        <view class="w-32 h-32 rounded-full bg-[#F0EBE5] animate-pulse mb-8" />
        <view class="h-6 w-40 bg-[#F0EBE5] rounded animate-pulse mb-2" />
        <view class="h-4 w-56 bg-[#F0EBE5] rounded animate-pulse" />
      </view>
    </template>

    <template v-else>
      <!-- 顶部导航 -->
      <view class="sticky top-0 z-10 bg-[#FAF8F5]/80 backdrop-blur border-b border-[#E8E0D5] px-4 py-3">
        <view class="flex items-center gap-3">
          <view v-if="canGoBack" class="p-1 -ml-1 text-[#999]" @click="goBack">
            <text>←</text>
          </view>
          <text class="text-lg font-semibold">访问受限</text>
        </view>
      </view>

      <!-- 主内容 -->
      <view class="flex-1 flex flex-col items-center justify-center px-6 py-12">
        <!-- 锁图标 -->
        <view class="relative mb-8">
          <view class="w-32 h-32 rounded-full bg-gradient-to-br from-primary/20 to-primary/5 flex items-center justify-center">
            <view class="w-24 h-24 rounded-full bg-gradient-to-br from-primary/30 to-primary/10 flex items-center justify-center">
              <text class="text-5xl">🔒</text>
            </view>
          </view>
          <view class="absolute -bottom-1 -right-1 w-10 h-10 rounded-full bg-[#FAF8F5] border-2 border-[#E8E0D5] flex items-center justify-center">
            <text>🛡</text>
          </view>
        </view>

        <!-- 错误信息 -->
        <text class="text-2xl font-bold text-[#2C2C2C] mb-2">暂无访问权限</text>
        <text class="text-[#999] text-center mb-2">抱歉，您没有权限访问{{ resource }}</text>

        <!-- 权限说明卡片 -->
        <view class="w-full max-w-sm bg-[#F0EBE5]/50 rounded-xl p-4 mb-8">
          <text class="text-sm font-medium text-[#2C2C2C] mb-3 flex items-center gap-2 block">
            <text>🛡</text> 访问要求
          </text>
          <view class="space-y-2 text-sm text-[#999]">
            <view class="flex items-start gap-2">
              <view class="w-1.5 h-1.5 rounded-full bg-[#C41E3A] mt-1.5 flex-shrink-0" />
              <text>{{ requiredPermission ? '需要「' + requiredPermission + '」权限' : '需要「' + requiredRole + '」身份' }}</text>
            </view>
            <view class="flex items-start gap-2">
              <view class="w-1.5 h-1.5 rounded-full bg-[#F0EBE5] mt-1.5 flex-shrink-0" />
              <text>或联系管理员获取授权</text>
            </view>
          </view>
        </view>

        <!-- 操作按钮 -->
        <view class="w-full max-w-sm space-y-3">
          <view class="w-full h-12 rounded-xl bg-[#C41E3A] text-white text-base flex items-center justify-center gap-2" @click="goTo('/pages/settings/identity/index')">
            <text>👥</text>
            <text>切换身份</text>
          </view>
          <view class="w-full h-12 rounded-xl border border-[#E8E0D5] bg-white text-[#2C2C2C] text-base flex items-center justify-center gap-2" @click="goTo('/pages/index/index')">
            <text>🏠</text>
            <text>返回首页</text>
          </view>
          <view v-if="canGoBack" class="w-full h-10 text-sm text-[#999] flex items-center justify-center" @click="goBack">
            <text>← 返回上一页</text>
          </view>
        </view>

        <!-- 帮助提示 -->
        <view class="mt-8 text-center">
          <text class="text-xs text-[#999] mb-2 block">如有疑问，请联系客服</text>
          <text class="text-[#C41E3A] text-sm" @click="goTo('/pages/help/contact/index')">🔄 申请权限</text>
        </view>

        <!-- 错误代码 -->
        <text class="mt-6 text-xs text-[#999]/50">错误代码: 403 Forbidden</text>
      </view>

      <!-- 底部装饰 -->
      <view class="h-32 bg-gradient-to-t from-muted/30 to-transparent" />
    </template>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'

function goBack() { uni.navigateBack() }
function goTo(url: string) { uni.navigateTo({ url }) }

const loading = ref(true)
const requiredRole = ref('会员')
const requiredPermission = ref<string | null>(null)
const resource = ref('该内容')
const canGoBack = ref(false)

onMounted(() => {
  // 从路由参数获取信息
  const pages = getCurrentPages()
  const currentPage = pages[pages.length - 1] as any
  canGoBack.value = pages.length > 1
  if (currentPage?.options) {
    if (currentPage.options.role) requiredRole.value = currentPage.options.role
    if (currentPage.options.permission) requiredPermission.value = currentPage.options.permission
    if (currentPage.options.resource) resource.value = currentPage.options.resource
  }
  loading.value = false
})
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
