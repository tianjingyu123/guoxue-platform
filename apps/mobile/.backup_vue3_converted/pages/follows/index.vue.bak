<template>
  <view class="min-h-screen bg-[#FAF8F5] max-w-lg mx-auto">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-50 bg-[#FAF8F5]/95 border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between h-14 px-4">
        <view class="p-2 -ml-2 rounded-full" @click="goBack">
          <text class="text-lg text-[#2C2C2C]">←</text>
        </view>
        <text class="font-semibold text-base text-[#2C2C2C]">社交关系</text>
        <view class="w-9" />
      </view>

      <!-- Tab切换 -->
      <view class="flex border-b border-[#E8E0D5]">
        <view
          class="flex-1 py-3 text-sm font-medium transition-all duration-200 relative text-center cursor-pointer"
          :class="activeTab === 'following' ? 'text-[#C41E3A]' : 'text-[#999]'"
          @click="activeTab = 'following'"
        >
          <text>关注 {{ followingCount }}</text>
          <view v-if="activeTab === 'following'" class="absolute bottom-0 left-1/2 w-12 h-0.5 bg-[#C41E3A] rounded-full" style="transform: translateX(-50%)" />
        </view>
        <view
          class="flex-1 py-3 text-sm font-medium transition-all duration-200 relative text-center cursor-pointer"
          :class="activeTab === 'followers' ? 'text-[#C41E3A]' : 'text-[#999]'"
          @click="activeTab = 'followers'"
        >
          <text>粉丝 {{ followerCount }}</text>
          <view v-if="activeTab === 'followers'" class="absolute bottom-0 left-1/2 w-12 h-0.5 bg-[#C41E3A] rounded-full" style="transform: translateX(-50%)" />
        </view>
      </view>

      <!-- 搜索栏 -->
      <view class="px-4 py-3">
        <view class="relative">
          <text class="absolute left-3 top-1/2 -translate-y-1/2 text-xs text-[#999]">🔍</text>
          <input
            v-model="searchQuery"
            type="text"
            :placeholder="'搜索' + (activeTab === 'following' ? '关注' : '粉丝')"
            class="w-full h-9 pl-9 pr-4 rounded-full bg-[#F2EFEA] text-sm text-[#2C2C2C] placeholder:text-[#999]"
          />
        </view>
      </view>
    </view>

    <!-- 加载骨架屏 -->
    <view v-if="loading" class="divide-y divide-[#E8E0D5]">
      <view v-for="i in 5" :key="i" class="flex items-center gap-3 px-4 py-3">
        <view class="w-12 h-12 rounded-full bg-[#F0EBE5] animate-pulse flex-shrink-0" />
        <view class="flex-1 space-y-2">
          <view class="h-3 w-24 bg-[#F0EBE5] rounded animate-pulse" />
          <view class="h-2.5 w-36 bg-[#F0EBE5] rounded animate-pulse" />
        </view>
        <view class="h-8 w-20 rounded-full bg-[#F0EBE5] animate-pulse" />
      </view>
    </view>

    <!-- 推荐关注（仅在关注页无结果时显示） -->
    <view v-else>
      <view v-if="activeTab === 'following' && filteredList.length === 0 && !searchQuery" class="px-4 pt-4 pb-2">
        <view class="flex items-center justify-between mb-2">
          <text class="text-xs font-semibold text-[#2C2C2C]">🔥 推荐关注</text>
        </view>
        <scroll-view scroll-x class="flex gap-3 whitespace-nowrap">
          <view v-for="rec in recommendedUsers" :key="rec.id" class="inline-flex flex-col items-center p-3 bg-white rounded-xl border border-[#E8E0D5] w-28">
            <view class="w-10 h-10 rounded-full bg-[#C41E3A]/10 flex items-center justify-center mb-1">
              <text class="text-[#C41E3A] text-sm font-medium">{{ rec.name[0] }}</text>
            </view>
            <text class="text-xs font-medium text-[#2C2C2C] line-clamp-1 block">{{ rec.name }}</text>
            <text class="text-[10px] text-[#999] line-clamp-1 block mb-1">{{ rec.bio }}</text>
            <view class="px-3 py-0.5 bg-[#C41E3A] text-white text-[10px] rounded-full" @click="toggleFollow(rec.id)">+ 关注</view>
          </view>
        </scroll-view>
      </view>

      <!-- 新粉丝提示 -->
      <view v-if="activeTab === 'followers' && newFollowers.length > 0" class="px-4 pt-2 pb-1">
        <view class="bg-gradient-to-r from-[#C41E3A]/5 to-[#C9A96E]/5 rounded-xl p-3 border border-[#C41E3A]/10">
          <view class="flex items-center gap-2 mb-1">
            <text class="text-sm">🎉</text>
            <text class="text-xs font-medium text-[#2C2C2C]">{{ newFollowers.length }}位新粉丝</text>
          </view>
          <view class="flex items-center gap-1">
            <view v-for="nf in newFollowers.slice(0, 3)" :key="nf.id" class="w-6 h-6 rounded-full bg-[#C41E3A]/20 flex items-center justify-center border-2 border-white -ml-1 first:ml-0">
              <text class="text-[8px] text-[#C41E3A] font-medium">{{ nf.name[0] }}</text>
            </view>
            <text class="text-[10px] text-[#999] ml-1">等{{ newFollowers.length }}人关注了你</text>
          </view>
        </view>
      </view>

      <!-- 用户列表 -->
      <view class="divide-y divide-[#E8E0D5]">
      <template v-if="filteredList.length > 0">
        <view v-for="user in filteredList" :key="user.id" class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-[#FAF8F5]">
          <!-- 头像 + 用户信息 -->
          <view class="flex items-center gap-3 flex-1 min-w-0" @click="goTo('/pages/user/id-detail/index?id=' + user.id)">
            <view class="w-12 h-12 flex-shrink-0 rounded-full bg-[#C41E3A]/10 flex items-center justify-center overflow-hidden">
              <image v-if="user.avatar" :src="user.avatar" mode="aspectFill" class="w-full h-full" />
              <text v-else class="text-[#C41E3A] text-lg font-medium">{{ user.name[0] }}</text>
            </view>

            <!-- 用户信息 -->
            <view class="flex-1 min-w-0">
              <view class="flex items-center gap-1">
                <text class="font-medium text-sm text-[#2C2C2C] truncate">{{ user.name }}</text>
                <text v-if="user.isVerified" class="text-[#C9A96E] text-xs flex-shrink-0">✓</text>
                <text v-if="user.isMutual" class="text-[10px] px-1 py-0.5 bg-[#F5F1EB] text-[#999] rounded-full flex-shrink-0 ml-1">互关</text>
              </view>
              <text class="text-xs text-[#999] mt-0.5 line-clamp-1 block">{{ user.bio }}</text>
            </view>
          </view>

          <!-- 操作按钮 -->
          <view
            class="h-8 px-4 text-xs font-medium rounded-full flex-shrink-0 flex items-center transition-all duration-200 cursor-pointer"
            :class="followingState[user.id] ? 'border border-[#E8E0D5] text-[#999]' : 'bg-[#C41E3A] text-white'"
            @click="toggleFollow(user.id)"
          >
            <text v-if="followingState[user.id]">✓ 已关注</text>
            <text v-else>+ {{ activeTab === 'followers' ? '回关' : '关注' }}</text>
          </view>
        </view>

        <!-- 加载更多 -->
        <view class="flex items-center justify-center py-4">
          <text class="text-xs text-[#999]">—— 没有更多了 ——</text>
        </view>
      </template>

      <!-- 空状态 -->
      <view v-else class="flex flex-col items-center justify-center py-20 px-8">
        <view class="w-20 h-20 rounded-full bg-[#F2EFEA] flex items-center justify-center mb-4">
          <text class="text-3xl">👥</text>
        </view>
        <text class="text-[#999] text-sm text-center">
          {{ searchQuery ? '没有找到相关用户' : activeTab === 'following' ? '还没有关注任何人' : '还没有粉丝' }}
        </text>
        <text class="text-xs text-[#999] mt-1 text-center" v-if="!searchQuery">
          {{ activeTab === 'following' ? '去发现更多有趣的内容创作者吧' : '分享优质内容吸引更多关注者' }}
        </text>
        <view
          v-if="!searchQuery"
          class="mt-4 px-4 py-1.5 border border-[#E8E0D5] rounded-full text-xs text-[#2C2C2C]"
          @click="goTo('/pages/discover/index')"
        >
          {{ activeTab === 'following' ? '去发现更多用户' : '分享内容吸引粉丝' }}
        </view>
      </view>
    </view>

    <!-- 底部安全区 -->
    <view class="h-8" />
  </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

interface User {
  id: number
  name: string
  avatar: string
  bio: string
  isVerified: boolean
  isFollowing: boolean
  isMutual?: boolean
}

// 推荐关注
const recommendedUsers: User[] = [
  { id: 101, name: '八字高手', avatar: '', bio: '实战派命理师', isVerified: true, isFollowing: false },
  { id: 102, name: '奇门遁甲传人', avatar: '', bio: '奇门预测', isVerified: false, isFollowing: false },
  { id: 103, name: '面相大师', avatar: '', bio: '面相学研究者', isVerified: true, isFollowing: false },
  { id: 104, name: '国学经典汇', avatar: '', bio: '分享国学经典', isVerified: false, isFollowing: false },
]

// 加载状态
const loading = ref(true)
setTimeout(() => { loading.value = false }, 600)

function goBack() { uni.navigateBack() }
function goTo(url: string) { uni.navigateTo({ url }) }

type TabType = 'following' | 'followers'

const followingUsers: User[] = [
  { id: 1, name: '玄易大师', avatar: '', bio: '国学研究者，专注八字命理30年', isVerified: true, isFollowing: true, isMutual: false },
  { id: 2, name: '子平先生', avatar: '', bio: '《渊海子平》研究专家，授课千余场', isVerified: true, isFollowing: true, isMutual: true },
  { id: 3, name: '紫微学堂', avatar: '', bio: '紫微斗数教学，通俗易懂', isVerified: false, isFollowing: true, isMutual: false },
  { id: 4, name: '风水堪舆师', avatar: '', bio: '环境风水咨询，阳宅布局', isVerified: true, isFollowing: true, isMutual: true },
  { id: 5, name: '易学爱好者小王', avatar: '', bio: '学习中，欢迎交流', isVerified: false, isFollowing: true, isMutual: false },
  { id: 6, name: '梅花易数研习社', avatar: '', bio: '梅花易数爱好者聚集地', isVerified: false, isFollowing: true, isMutual: false },
]

const followerUsers: User[] = [
  { id: 7, name: '命理学徒', avatar: '', bio: '正在学习八字命理', isVerified: false, isFollowing: false, isMutual: false },
  { id: 8, name: '国学新手', avatar: '', bio: '对传统文化很感兴趣', isVerified: false, isFollowing: true, isMutual: true },
  { id: 9, name: '道法自然', avatar: '', bio: '道家文化爱好者，修身养性', isVerified: true, isFollowing: false, isMutual: false },
  { id: 10, name: '周易研习社', avatar: '', bio: '周易研究小组，共同进步', isVerified: false, isFollowing: false, isMutual: false },
  { id: 11, name: '玄门弟子', avatar: '', bio: '跟随师父学习中', isVerified: false, isFollowing: true, isMutual: true },
  { id: 12, name: '易经初学者', avatar: '', bio: '刚开始接触易经', isVerified: false, isFollowing: false, isMutual: false },
  { id: 13, name: '占星爱好者', avatar: '', bio: '中西占星文化研究', isVerified: false, isFollowing: true, isMutual: false },
]

const activeTab = ref<TabType>('following')
const searchQuery = ref('')

// 新粉丝
const newFollowers: User[] = [
  { id: 201, name: '易学新人', avatar: '', bio: '刚刚入门', isVerified: false, isFollowing: false },
  { id: 202, name: '传统文化爱好者', avatar: '', bio: '热爱国学', isVerified: false, isFollowing: false },
  { id: 203, name: '卦象解读', avatar: '', bio: '六爻占卜', isVerified: false, isFollowing: false },
]

function initFollowingState(): Record<number, boolean> {
  const state: Record<number, boolean> = {}
  followingUsers.forEach(u => { state[u.id] = true })
  followerUsers.forEach(u => { state[u.id] = u.isFollowing })
  return state
}

const followingState = ref<Record<number, boolean>>(initFollowingState())

const followingCount = followingUsers.length
const followerCount = followerUsers.length

const filteredList = computed(() => {
  const currentList = activeTab.value === 'following' ? followingUsers : followerUsers
  if (!searchQuery.value.trim()) return currentList
  const q = searchQuery.value.toLowerCase()
  return currentList.filter(user =>
    user.name.toLowerCase().includes(q) ||
    user.bio.toLowerCase().includes(q)
  )
})

function toggleFollow(userId: number) {
  followingState.value = {
    ...followingState.value,
    [userId]: !followingState.value[userId],
  }
  uni.showToast({
    title: followingState.value[userId] ? '已关注' : '已取消关注',
    icon: 'success',
  })
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
