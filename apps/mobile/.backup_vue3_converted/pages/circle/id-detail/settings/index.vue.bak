              <view>
                <text class="text-sm text-[#2C2C2C] block">启用分享有赏</text>
                <text class="text-xs text-[#999] block mt-0.5">成员邀请新人可获得佣金</text>
              </view>
            </view>
            <view class="w-11 h-6 rounded-full relative" :class="settings.shareRewardEnabled ? 'bg-[#C41E3A]' : 'bg-[#E8E0D5]'" @click="handleToggle('shareRewardEnabled')">
              <view class="absolute top-1 w-4 h-4 bg-white rounded-full shadow" :class="settings.shareRewardEnabled ? 'left-6' : 'left-1'" />
