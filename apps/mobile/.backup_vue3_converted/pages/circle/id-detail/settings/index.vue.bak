              <text class="text-sm text-[#C9A96E] font-medium">{{ settings.shareRewardRate }}%</text>
              <text class="text-lg">›</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Danger zone -->
      <view>
        <text class="text-sm font-medium text-red-500 block mb-2 px-1">危险操作</text>
        <view class="bg-white rounded-xl divide-y divide-[#E8E0D5]">
          <view class="flex items-center justify-between p-4 w-full" @click="showDangerModal = 'transfer'">
            <view class="flex items-center gap-3">
              <text class="text-lg text-[#F59E0B]">🔄</text>
              <view>
                <text class="text-sm text-[#2C2C2C] block">转让圈主</text>
                <text class="text-xs text-[#999] block mt-0.5">将圈主身份转让给其他成员</text>
              </view>
            </view>
            <text class="text-[#999] text-lg">›</text>
          </view>
          <view class="flex items-center justify-between p-4 w-full" @click="showDangerModal = 'dissolve'">
            <view class="flex items-center gap-3">
              <text class="text-lg text-red-500">🗑</text>
              <view>
                <text class="text-sm text-red-500 block">解散圈子</text>
                <text class="text-xs text-[#999] block mt-0.5">此操作不可逆，请谨慎操作</text>
              </view>
            </view>
            <text class="text-[#999] text-lg">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Danger confirm modal -->
    <view v-if="showDangerModal">
      <view class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 px-4">
        <view class="w-full max-w-sm bg-white rounded-2xl overflow-hidden">
          <view class="p-6 text-center">
            <view class="w-16 h-16 rounded-full mx-auto mb-4 flex items-center justify-center" :class="showDangerModal === 'dissolve' ? 'bg-red-500/10' : 'bg-amber-500/10'">
              <text class="text-3xl" :class="showDangerModal === 'dissolve' ? 'text-red-500' : 'text-amber-500'">⚠️</text>
            </view>
            <text class="text-lg font-semibold text-[#2C2C2C] block mb-2">{{ showDangerModal === 'transfer' ? '确认转让圈主？' : '确认解散圈子？' }}</text>
            <text class="text-sm text-[#999] block mb-4">
              {{ showDangerModal === 'transfer' ? '转让后你将失去圈主权限，成为普通成员' : '解散后所有内容将被删除，此操作不可撤销' }}
            </text>
            <view class="mb-4">
              <text class="text-xs text-[#999] block mb-2">请输入「{{ showDangerModal === 'transfer' ? '确认转让' : '确认解散' }}」以继续</text>
              <input type="text" v-model="confirmText" :placeholder="showDangerModal === 'transfer' ? '确认转让' : '确认解散'" class="w-full px-4 py-2 bg-[#FAF8F5] rounded-lg text-sm text-center" />
            </view>
          </view>
          <view class="flex border-t border-[#E8E0D5]">
            <view class="flex-1 py-4 text-sm font-medium text-[#2C2C2C] text-center" @click="showDangerModal = null; confirmText = ''">
              <text>取消</text>
            </view>
            <view class="flex-1 py-4 text-sm font-medium text-center border-l border-[#E8E0D5]" :class="confirmText === (showDangerModal === 'transfer' ? '确认转让' : '确认解散') ? (showDangerModal === 'dissolve' ? 'text-red-500' : 'text-amber-500') : 'text-[#999]'" @click="handleDangerConfirm">
              <text>确认</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, reactive } from 'vue'

const settings = reactive({
  name: '八字命理研习社',
  cover: '',
  description: '专注八字命理学习与实践的高质量社群',
  tags: ['八字', '命理', '易学', '排盘'],
  type: 'paid',
  price: 199,
  yearlyPrice: 99,
  joinMethod: 'direct',
  welcomeMessage: '欢迎加入八字命理研习社！请先阅读圈规，有问题可以@管理员。',
  postPermission: 'all',
  commentPermission: 'all',
  chatPermission: 'all',
  sharePermission: true,
  memberListVisible: true,
  contentProtection: true,
  assistantEnabled: true,
  assistantWelcome: '你好，我是圈主助理小卜，有任何问题都可以问我~',
  searchVisible: true,
  shareRewardEnabled: true,
  shareRewardRate: 10,
})

const editingField = ref<string | null>(null)
const tempValue = ref('')
const showDangerModal = ref<'transfer' | 'dissolve' | null>(null)
const confirmText = ref('')

function handleEdit(field: string, value: string) {
  editingField.value = field
  tempValue.value = value
}

function handleSave(field: string) {
  ;(settings as any)[field] = tempValue.value
  editingField.value = null
  uni.showToast({ title: '已更新', icon: 'success' })
}

function handleToggle(field: string) {
  ;(settings as any)[field] = !(settings as any)[field]
}

function handleDangerConfirm() {
  const expected = showDangerModal.value === 'transfer' ? '确认转让' : '确认解散'
  if (confirmText.value !== expected) {
    uni.showToast({ title: '请输入正确的确认文字', icon: 'none' })
    return
  }
  uni.showToast({ title: showDangerModal.value === 'transfer' ? '已转让' : '已解散', icon: 'success' })
  showDangerModal.value = null
  confirmText.value = ''
}

function goBack() { uni.navigateBack() }
function goKnowledge() { uni.navigateTo({ url: '/pages/circle/id-detail/settings/knowledge/index' }) }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
