              </view>
            </view>
            <view class="w-11 h-6 rounded-full relative" :class="settings.assistantEnabled ? 'bg-[#C41E3A]' : 'bg-[#E8E0D5]'" @click="handleToggle('assistantEnabled')">
              <view class="absolute top-1 w-4 h-4 bg-white rounded-full shadow" :class="settings.assistantEnabled ? 'left-6' : 'left-1'" />
            </view>
          </view>
          <view v-if="settings.assistantEnabled" class="flex items-center justify-between p-4">
            <text class="text-sm text-[#2C2C2C]">助理欢迎语</text>
            <view class="flex items-center gap-2 text-[#999]">
              <text class="text-sm max-w-[120px] truncate">{{ settings.assistantWelcome }}</text>
              <text class="text-lg">›</text>
            </view>
          </view>
          <view v-if="settings.assistantEnabled" class="flex items-center justify-between p-4" @click="goKnowledge">
