            <view class="flex items-center gap-2 text-[#999]">
              <text class="text-[10px] px-1.5 py-0 bg-[#F0EDE8] rounded">12篇文档</text>
              <text class="text-lg">›</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Search visibility -->
      <view>
