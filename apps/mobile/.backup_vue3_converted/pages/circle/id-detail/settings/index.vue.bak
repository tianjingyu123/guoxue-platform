              <text class="text-lg text-[#999]">{{ settings.memberListVisible ? '👁' : '👁‍🗨' }}</text>
              <text class="text-sm text-[#2C2C2C]">成员列表对外公开</text>
            </view>
            <view class="w-11 h-6 rounded-full relative" :class="settings.memberListVisible ? 'bg-[#C41E3A]' : 'bg-[#E8E0D5]'" @click="handleToggle('memberListVisible')">
