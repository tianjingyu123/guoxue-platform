            </template>
            <template v-else>
              <view class="px-6 py-2.5 bg-gradient-to-r from-[#C41E3A] to-[#E74C3C] text-white rounded-full text-sm font-medium shadow-lg" @click="handleBuy">立即购买</view>
            </template>
          </view>
