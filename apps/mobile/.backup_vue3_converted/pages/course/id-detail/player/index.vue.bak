<template>
  <view class="min-h-screen bg-black text-white" @click="resetControlsTimer">
    <!-- Loading 骨架屏 -->
    <view v-if="isLoading">
      <view class="w-full aspect-video bg-[#18181B]" />
      <view class="p-4 space-y-4">
        <view class="h-6 bg-[#27272A] rounded w-3/4" />
        <view class="h-4 bg-[#27272A] rounded w-1/2" />
      </view>
    </view>

    <!-- 主内容 -->
    <template v-else>
      <!-- 视频播放器 -->
      <view class="relative w-full aspect-video bg-black">
        <video
          id="playerVideo"
          ref="videoRef"
          class="w-full h-full"
          :src="content?.videoUrl"
          :muted="isMuted"
          :autoplay="false"
          :controls="false"
          :show-fullscreen-btn="false"
          :show-center-play-btn="false"
          :enable-progress-gesture="false"
          object-fit="contain"
          @play="handlePlay"
          @pause="handlePause"
          @timeupdate="handleTimeUpdate"
          @loadedmetadata="handleLoadedMetadata"
          @ended="handleEnded"
          @fullscreenchange="handleFullscreenChange"
          @error="handleVideoError"
        />

        <!-- 播放器控制层 -->
        <view
          class="absolute inset-0 transition-opacity"
          :class="showControls ? 'opacity-100' : 'opacity-0 pointer-events-none'"
          :style="{ background: 'linear-gradient(to bottom, rgba(0,0,0,0.6) 0%, transparent 50%, rgba(0,0,0,0.8) 100%)' }"
        >
          <!-- 顶部导航 -->
          <view class="absolute top-0 left-0 right-0 p-4 flex items-center gap-3">
            <view class="p-2" @click="handleBack">
              <text class="text-2xl">⬅️</text>
            </view>
            <view class="flex-1" style="min-width:0">
              <text class="text-sm font-medium block" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ content?.title }}</text>
              <text class="text-xs text-white/60 block" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ content?.courseTitle }}</text>
            </view>
          </view>

          <!-- 中央播放按钮 -->
          <view
            class="absolute top-1/2 left-1/2"
            style="transform:translate(-50%,-50%)"
            @click="togglePlay"
          >
            <view class="w-16 h-16 rounded-full bg-[rgba(255,255,255,0.2)] flex items-center justify-center">
              <text :class="isPlaying ? 'text-3xl' : 'text-3xl'">{{ isPlaying ? '⏸' : '▶️' }}</text>
            </view>
          </view>

          <!-- 底部控制栏 -->
          <view class="absolute bottom-0 left-0 right-0 p-4 flex flex-col gap-2">
            <!-- 进度条 -->
            <view
              id="progressBar"
              class="h-1 bg-[rgba(255,255,255,0.3)] rounded-full"
              @click="handleProgressClick"
            >
              <view
                class="h-full bg-[#C41E3A] rounded-full relative"
                :style="{ width: (duration ? (currentTime / duration) * 100 : 0) + '%' }"
              >
                <view class="absolute right-0 top-1/2" style="transform:translateY(-50%);width:12px;height:12px;background:#fff;border-radius:50%" />
              </view>
            </view>

            <!-- 控制按钮 -->
            <view class="flex items-center justify-between">
              <view class="flex items-center gap-4">
                <view @click="togglePlay">
                  <text class="text-2xl">{{ isPlaying ? '⏸' : '▶️' }}</text>
                </view>
                <view
                  @click="handlePrevLesson"
                  :class="content?.prevLesson ? '' : 'opacity-30'"
                >
                  <text class="text-xl">⏪</text>
                </view>
                <view
                  @click="handleNextLesson"
                  :class="content?.nextLesson ? '' : 'opacity-30'"
                >
                  <text class="text-xl">⏩</text>
                </view>
                <text class="text-xs" style="font-variant-numeric:tabular-nums">
                  {{ formatTime(currentTime) }} / {{ formatTime(duration) }}
                </text>
              </view>

              <view class="flex items-center gap-4">
                <!-- 倍速菜单 -->
                <view class="relative">
                  <view class="text-xs px-1 py-1" @click="showSpeedMenu = !showSpeedMenu">
                    {{ playbackRate }}x
                  </view>
                  <view v-if="showSpeedMenu" class="absolute bottom-full right-0 mb-2 bg-[#27272A] rounded-lg py-1 min-w-[60px]">
                    <view
                      v-for="rate in speedOptions"
                      :key="rate"
                      class="px-3 py-1.5 text-xs"
                      :class="playbackRate === rate ? 'text-[#C41E3A]' : ''"
                      @click="changeSpeed(rate)"
                    >
                      {{ rate }}x
                    </view>
                  </view>
                </view>
                <!-- 纯音频模式 -->
                <view
                  class="p-1 rounded"
                  :class="isAudioMode ? 'bg-[#C41E3A]' : ''"
                  @click="toggleAudioMode"
                >
                  <text class="text-xl">🎧</text>
                </view>
                <!-- 画中画 -->
                <view
                  class="p-1 rounded"
                  :class="isPipMode ? 'bg-[#C41E3A]' : ''"
                  @click="togglePiP"
                >
                  <text class="text-xl">🖼️</text>
                </view>
                <!-- 静音 -->
                <view @click="isMuted = !isMuted">
                  <text class="text-xl">{{ isMuted ? '🔇' : '🔊' }}</text>
                </view>
                <!-- 全屏 -->
                <view @click="toggleFullscreen">
                  <text class="text-xl">⛶</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 记忆播放提示 -->
        <view v-if="showResumeToast" class="absolute z-20" style="top:80px;left:50%;transform:translateX(-50%)">
          <view class="bg-[rgba(0,0,0,0.8)] rounded-lg px-4 py-2 flex items-center gap-3">
            <text class="text-[#C41E3A]">🕐</text>
            <text class="text-sm">上次看到 {{ formatTime(resumePosition) }}</text>
            <view class="px-3 py-1 bg-[#C41E3A] text-white text-xs rounded-full" @click="handleResume">
              继续
            </view>
            <view class="text-white/60 text-xs" @click="showResumeToast = false">
              从头
            </view>
          </view>
        </view>

        <!-- 纯音频模式遮罩 -->
        <view v-if="isAudioMode" class="absolute inset-0 bg-[#18181B] flex flex-col items-center justify-center z-10">
          <text class="text-5xl text-[#C41E3A] mb-4">🎧</text>
          <text class="text-white/80 text-sm">纯音频模式</text>
          <text class="text-white/50 text-xs mt-1">已关闭视频画面，节省流量</text>
          <view class="mt-4 px-4 py-2 bg-[rgba(255,255,255,0.1)] rounded-full text-sm" @click="toggleAudioMode">
            恢复视频
          </view>
        </view>
      </view>

      <!-- 底部功能区 -->
      <view class="bg-[#18181B]">
        <!-- 当前课程信息 -->
        <view class="p-4 border-b border-[#27272A]">
          <text class="font-medium block mb-1">{{ content?.title }}</text>
          <text class="text-sm text-[#A1A1AA] block">{{ content?.courseTitle }}</text>
        </view>

        <!-- 功能按钮 -->
        <view class="flex border-b border-[#27272A]">
          <view class="flex-1 flex items-center justify-center gap-2 py-3 text-sm" @click="showChapterDrawer = true">
            <text>📋</text>
            <text>目录</text>
          </view>
          <view class="flex-1 flex items-center justify-center gap-2 py-3 text-sm" @click="showNotePanel = true">
            <text>📝</text>
            <text>笔记</text>
          </view>
          <view class="flex-1 flex items-center justify-center gap-2 py-3 text-sm" @click="showQuestionPanel = true">
            <text>💬</text>
            <text>提问</text>
          </view>
        </view>

        <!-- 下一课提示 -->
        <view v-if="content?.nextLesson" class="w-full p-4 flex items-center justify-between" @click="handleNextLesson">
          <view>
            <text class="text-xs text-[#A1A1AA] block mb-1">下一课</text>
            <text class="text-sm block">{{ content.nextLesson.title }}</text>
          </view>
          <text class="text-xl text-[#A1A1AA]">›</text>
        </view>
      </view>

      <!-- 章节抽屉 -->
      <view v-if="showChapterDrawer" class="fixed inset-0 z-50">
        <view class="absolute inset-0 bg-black/60" @click="showChapterDrawer = false" />
        <view class="absolute right-0 top-0 bottom-0 bg-[#18181B] overflow-y-auto" style="width:320px">
          <view class="sticky top-0 bg-[#18181B] p-4 border-b border-[#27272A] flex items-center justify-between">
            <text class="font-medium">课程目录</text>
            <view @click="showChapterDrawer = false">
              <text class="text-xl">✕</text>
            </view>
          </view>
          <view class="p-4 flex flex-col gap-4">
            <view v-for="chapter in chapters" :key="chapter.id">
              <text class="text-sm font-medium text-[#A1A1AA] block mb-2">{{ chapter.title }}</text>
              <view class="flex flex-col gap-1">
                <view
                  v-for="lesson in chapter.lessons"
                  :key="lesson.id"
                  class="flex items-center gap-3 p-3 rounded-lg"
                  :class="{
                    'bg-[#C41E3A]/20 text-[#C41E3A]': lesson.id === currentLessonId,
                    'opacity-50': !lesson.isFree && !chapter.isFree
                  }"
                  @click="handleSwitchLesson(lesson.id, chapter)"
                >
                  <text v-if="lesson.isCompleted" class="text-green-500 flex-shrink-0">✅</text>
                  <text v-else-if="!lesson.isFree && !chapter.isFree" class="text-[#A1A1AA] flex-shrink-0">🔒</text>
                  <text v-else class="flex-shrink-0">▶️</text>
                  <text class="flex-1 text-sm" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ lesson.title }}</text>
                  <text class="text-xs text-[#A1A1AA] flex-shrink-0">{{ formatTime(lesson.duration) }}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 笔记面板 -->
      <view v-if="showNotePanel" class="fixed inset-0 z-50">
        <view class="absolute inset-0 bg-black/60" @click="showNotePanel = false" />
        <view class="absolute bottom-0 left-0 right-0 bg-[#18181B] rounded-t-2xl flex flex-col" style="max-height:70vh">
          <view class="p-4 border-b border-[#27272A] flex items-center justify-between">
            <text class="font-medium">记笔记</text>
            <view @click="showNotePanel = false">
              <text class="text-xl">✕</text>
            </view>
          </view>
          <view class="p-4 flex-1 overflow-y-auto">
            <text class="text-xs text-[#A1A1AA] block mb-2">
              当前时间点: {{ formatTime(currentTime) }}
            </text>
            <textarea
              v-model="noteContent"
              placeholder="写下你的学习笔记..."
              class="w-full bg-[#27272A] rounded-lg p-3 text-sm resize-none"
              style="height:128px;outline:none"
            />
            <view v-if="notes.length > 0" class="mt-4 flex flex-col gap-2">
              <text class="text-xs text-[#A1A1AA]">我的笔记</text>
              <view v-for="note in notes" :key="note.id" class="bg-[#27272A] rounded-lg p-3">
                <text class="text-xs text-[#C41E3A] block mb-1">{{ formatTime(note.timestamp || 0) }}</text>
                <text class="text-sm block">{{ note.content }}</text>
              </view>
            </view>
          </view>
          <view class="p-4 border-t border-[#27272A]">
            <view
              class="w-full py-3 bg-[#C41E3A] text-white rounded-lg font-medium text-center"
              :class="noteContent.trim() ? '' : 'opacity-50'"
              @click="submitNote"
            >
              保存笔记
            </view>
          </view>
        </view>
      </view>

      <!-- 提问面板 -->
      <view v-if="showQuestionPanel" class="fixed inset-0 z-50">
        <view class="absolute inset-0 bg-black/60" @click="showQuestionPanel = false" />
        <view class="absolute bottom-0 left-0 right-0 bg-[#18181B] rounded-t-2xl">
          <view class="p-4 border-b border-[#27272A] flex items-center justify-between">
            <text class="font-medium">向老师提问</text>
            <view @click="showQuestionPanel = false">
              <text class="text-xl">✕</text>
            </view>
          </view>
          <view class="p-4">
            <textarea
              v-model="questionContent"
              placeholder="描述你的问题，老师会尽快回复..."
              class="w-full bg-[#27272A] rounded-lg p-3 text-sm resize-none"
              style="height:128px;outline:none"
            />
          </view>
          <view class="p-4 border-t border-[#27272A]">
            <view
              class="w-full py-3 bg-[#C41E3A] text-white rounded-lg font-medium text-center"
              :class="questionContent.trim() ? '' : 'opacity-50'"
              @click="submitQuestion"
            >
              提交问题
            </view>
          </view>
        </view>
      </view>
    </template>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted, onUnmounted, nextTick } from 'vue'
import { onLoad } from '@dcloudio/uni-app'

// --- 类型定义 ---
interface Lesson {
  id: string
  title: string
  duration: number
  isFree: boolean
  isCompleted: boolean
}

interface Chapter {
  id: string
  title: string
  duration: number
  isFree: boolean
  lessons: Lesson[]
}

interface ChapterContent {
  id: string
  title: string
  courseId: string
  courseTitle: string
  videoUrl: string
  duration: number
  currentProgress: number
  nextLesson?: { id: string; title: string; chapterId: string }
  prevLesson?: { id: string; title: string; chapterId: string }
}

interface CourseNote {
  id: string
  content: string
  chapterId: string
  chapterTitle: string
  lessonId: string
  lessonTitle: string
  timestamp?: number
  createdAt?: string
}

// --- 工具函数 ---
function formatTime(seconds: number): string {
  const mins = Math.floor(seconds / 60)
  const secs = Math.floor(seconds % 60)
  return `${mins}:${secs.toString().padStart(2, '0')}`
}

// --- 路由参数 ---
const courseId = ref('')
const lessonId = ref('')

onLoad((options: any) => {
  courseId.value = options.courseId || ''
  lessonId.value = options.lesson || ''
  loadContent()
})

// --- 状态 ---
const content = ref<ChapterContent | null>(null)
const chapters = ref<Chapter[]>([])
const isLoading = ref(true)
const isPlaying = ref(false)
const isMuted = ref(false)
const isFullscreen = ref(false)
const currentTime = ref(0)
const duration = ref(0)
const playbackRate = ref(1)
const showControls = ref(true)
const showChapterDrawer = ref(false)
const showNotePanel = ref(false)
const showQuestionPanel = ref(false)
const showSpeedMenu = ref(false)
const noteContent = ref('')
const questionContent = ref('')
const notes = ref<CourseNote[]>([])
const showResumeToast = ref(false)
const resumePosition = ref(0)
const isAudioMode = ref(false)
const isPipMode = ref(false)

// --- 模板 ref ---
const videoRef = ref<any>(null)

// --- 定时器 ---
let controlsTimer: ReturnType<typeof setTimeout> | null = null
let saveProgressTimer: ReturnType<typeof setInterval> | null = null
let resumeToastTimer: ReturnType<typeof setTimeout> | null = null

// --- 常量 ---
const speedOptions = [0.5, 0.75, 1, 1.25, 1.5, 2]

// --- 计算当前课时ID（便于模板比较） ---
const currentLessonId = computed(() => lessonId.value || content.value?.id || '')

// --- 数据加载 ---
function loadContent() {
  isLoading.value = true
  // 模拟网络加载，展示骨架屏
  setTimeout(() => {
    content.value = {
      id: lessonId.value || '1',
      title: '第一课：八字基础概念',
      courseId: courseId.value,
      courseTitle: '八字命理入门精讲',
      videoUrl: 'https://sample-videos.com/video321/mp4/720/big_buck_bunny_720p_1mb.mp4',
      duration: 1800,
      currentProgress: 300,
      nextLesson: { id: '2', title: '第二课：天干地支', chapterId: 'ch1' },
      prevLesson: undefined
    }
    chapters.value = [
      {
        id: 'ch1',
        title: '第一章：基础入门',
        duration: 3600,
        isFree: true,
        lessons: [
          { id: '1', title: '八字基础概念', duration: 1800, isFree: true, isCompleted: true },
          { id: '2', title: '天干地支详解', duration: 1500, isFree: true, isCompleted: false },
          { id: '3', title: '五行生克关系', duration: 1200, isFree: false, isCompleted: false }
        ]
      },
      {
        id: 'ch2',
        title: '第二章：进阶应用',
        duration: 5400,
        isFree: false,
        lessons: [
          { id: '4', title: '八字排盘方法', duration: 1800, isFree: false, isCompleted: false },
          { id: '5', title: '十神详解', duration: 2000, isFree: false, isCompleted: false }
        ]
      }
    ]
    isLoading.value = false

    // 数据加载后检查保存的播放进度
    nextTick(() => {
      checkSavedProgress()
    })
  }, 500)
}

// --- 播放进度记忆 ---
function checkSavedProgress() {
  if (!content.value) return
  try {
    const saved = uni.getStorageSync(`course_progress_${courseId.value}_${lessonId.value}`)
    if (saved) {
      const progress = typeof saved === 'string' ? JSON.parse(saved) : saved
      if (progress.currentTime > 10 && progress.currentTime < progress.duration - 30) {
        resumePosition.value = progress.currentTime
        showResumeToast.value = true
        resumeToastTimer = setTimeout(() => {
          showResumeToast.value = false
        }, 5000)
      }
    }
  } catch (e) {
    // localStorage 不可用时静默
  }
}

function handleResume() {
  if (resumePosition.value > 0) {
    const videoCtx = uni.createVideoContext('playerVideo')
    if (videoCtx) {
      videoCtx.seek(resumePosition.value)
    }
    currentTime.value = resumePosition.value
    showResumeToast.value = false
  }
}

// --- 画中画 ---
function togglePiP() {
  try {
    // @ts-ignore
    if (document.pictureInPictureElement) {
      // @ts-ignore
      document.exitPictureInPicture()
      isPipMode.value = false
      // @ts-ignore
    } else if (document.pictureInPictureEnabled) {
      // @ts-ignore
      document.querySelector('video')?.requestPictureInPicture()
      isPipMode.value = true
    }
  } catch (error) {
    console.log('PiP not supported')
  }
}

// --- 纯音频模式 ---
function toggleAudioMode() {
  isAudioMode.value = !isAudioMode.value
}

// --- 自动隐藏控制栏（暴露到模板，绑在根容器上） ---
function resetControlsTimer() {
  showControls.value = true
  if (controlsTimer) clearTimeout(controlsTimer)
  if (isPlaying.value) {
    controlsTimer = setTimeout(() => {
      showControls.value = false
    }, 3000)
  }
}

// --- 保存播放进度 ---
function saveProgress() {
  if (!content.value) return
  try {
    uni.setStorageSync(`course_progress_${courseId.value}_${lessonId.value}`, {
      currentTime: currentTime.value,
      duration: duration.value,
      timestamp: Date.now()
    })
  } catch (e) {
    // 静默失败
  }
  // API 异步更新（mock 中静默）
  try {
    // courseApi.updateProgress(...) — 生产环境替换
  } catch (e) {
    // 静默失败
  }
}

// --- 周期性保存进度 ---
function startProgressTimer() {
  stopProgressTimer()
  saveProgressTimer = setInterval(saveProgress, 30000)
}

function stopProgressTimer() {
  if (saveProgressTimer) {
    clearInterval(saveProgressTimer)
    saveProgressTimer = null
  }
}

// --- 视频事件处理 ---
function handlePlay() {
  isPlaying.value = true
  startProgressTimer()
}

function handlePause() {
  isPlaying.value = false
  stopProgressTimer()
}

function handleTimeUpdate(e: any) {
  currentTime.value = e.detail.currentTime
  duration.value = e.detail.duration
}

function handleLoadedMetadata(e: any) {
  duration.value = e.detail.duration
  if (content.value?.currentProgress) {
    const videoCtx = uni.createVideoContext('playerVideo')
    if (videoCtx) {
      videoCtx.seek(content.value.currentProgress)
    }
  }
}

function handleEnded() {
  isPlaying.value = false
  stopProgressTimer()
  saveProgress()
}

function handleFullscreenChange(e: any) {
  isFullscreen.value = !!e.detail.fullScreen
}

function handleVideoError(e: any) {
  console.error('视频加载失败:', e.detail)
  uni.showToast({ title: '视频加载失败', icon: 'none' })
}

// --- 播放/暂停 ---
function togglePlay() {
  const videoCtx = uni.createVideoContext('playerVideo')
  if (!videoCtx) return
  if (isPlaying.value) {
    videoCtx.pause()
  } else {
    videoCtx.play()
  }
  resetControlsTimer()
}

// --- 进度条点击跳转 ---
function handleProgressClick(e: any) {
  if (!duration.value) return
  const pageX = e.detail?.x || 0
  uni.createSelectorQuery().select('#progressBar').boundingClientRect((rect: any) => {
    if (!rect) return
    const percent = Math.max(0, Math.min((pageX - rect.left) / rect.width, 1))
    const newTime = percent * duration.value
    const videoCtx = uni.createVideoContext('playerVideo')
    if (videoCtx) {
      videoCtx.seek(newTime)
    }
    currentTime.value = newTime
  }).exec()
}

// --- 全屏切换 ---
function toggleFullscreen() {
  if (!isFullscreen.value) {
    // 使用 UniApp 全屏 API
    const videoCtx = uni.createVideoContext('playerVideo')
    if (videoCtx) {
      videoCtx.requestFullScreen()
    }
    isFullscreen.value = true
  } else {
    const videoCtx = uni.createVideoContext('playerVideo')
    if (videoCtx) {
      videoCtx.exitFullScreen()
    }
    isFullscreen.value = false
  }
}

// --- 倍速切换 ---
function changeSpeed(rate: number) {
  const videoCtx = uni.createVideoContext('playerVideo')
  if (videoCtx) {
    videoCtx.playbackRate(rate)
  }
  playbackRate.value = rate
  showSpeedMenu.value = false
}

// --- 切换课时 ---
function handlePrevLesson() {
  if (content.value?.prevLesson) {
    saveProgress()
    uni.redirectTo({ url: `/pages/course/id-detail/player/index?courseId=${courseId.value}&lesson=${content.value.prevLesson.id}` })
  }
}

function handleNextLesson() {
  if (content.value?.nextLesson) {
    saveProgress()
    uni.redirectTo({ url: `/pages/course/id-detail/player/index?courseId=${courseId.value}&lesson=${content.value.nextLesson.id}` })
  }
}

function handleSwitchLesson(lessonId: string, chapter: Chapter) {
  if (!lessonId) return
  // 锁定课时不可切换
  const lesson = chapter.lessons.find(l => l.id === lessonId)
  if (lesson && !lesson.isFree && !chapter.isFree) return
  saveProgress()
  uni.redirectTo({ url: `/pages/course/id-detail/player/index?courseId=${courseId.value}&lesson=${lessonId}` })
}

// --- 返回 ---
function handleBack() {
  saveProgress()
  uni.navigateBack()
}

// --- 提交笔记 ---
function submitNote() {
  if (!noteContent.value.trim() || !content.value) return
  notes.value = [
    {
      id: Date.now().toString(),
      content: noteContent.value,
      chapterId: 'ch1',
      chapterTitle: content.value.title,
      lessonId: content.value.id,
      lessonTitle: content.value.title,
      timestamp: currentTime.value,
      createdAt: new Date().toISOString()
    },
    ...notes.value
  ]
  noteContent.value = ''
  showNotePanel.value = false
  uni.showToast({ title: '笔记已保存', icon: 'success' })
}

// --- 提交问题 ---
function submitQuestion() {
  if (!questionContent.value.trim() || !content.value) return
  questionContent.value = ''
  showQuestionPanel.value = false
  uni.showToast({ title: '问题已提交，等待老师回复', icon: 'none' })
}

// --- 生命周期 ---
onMounted(() => {
  // 用户交互时重置控制栏隐藏计时器
  resetControlsTimer()
})

onUnmounted(() => {
  stopProgressTimer()
  if (controlsTimer) {
    clearTimeout(controlsTimer)
    controlsTimer = null
  }
  if (resumeToastTimer) {
    clearTimeout(resumeToastTimer)
    resumeToastTimer = null
  }
})
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
</style>
