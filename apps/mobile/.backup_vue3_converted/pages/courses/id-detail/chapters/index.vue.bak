<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-24">
    <!-- 顶部导航 + 进度条 -->
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5] shadow-sm">
      <view class="h-14 px-4 flex items-center gap-3">
        <view class="w-8 h-8 rounded-full bg-[#F5F0E8] flex items-center justify-center" @click="goBack">
          <text class="text-xl text-[#2C2C2C]">←</text>
        </view>
        <text class="flex-1 font-medium text-[#2C2C2C] truncate">{{ course.title }}</text>
        <view class="w-8 h-8 rounded-full bg-[#F5F0E8] flex items-center justify-center" @click="handleRefresh">
          <text :class="'w-4 h-4 text-[#666666]' + (isRefreshing ? ' animate-spin' : '')">🔄</text>
        </view>
      </view>
      <view class="px-4 pb-4">
        <view class="flex items-center justify-between mb-2">
          <text class="text-sm text-[#666]">学习进度 <text class="text-[#C41E3A] font-medium">{{ course.completedLessons }}</text>/{{ course.totalLessons }}课时</text>
          <text class="text-sm font-bold text-[#C41E3A]">{{ course.progressPercent }}%</text>
        </view>
        <view class="h-2 bg-[#F2EFEA] rounded-full overflow-hidden">
          <view class="h-full bg-gradient-to-r from-[#C41E3A] to-[#E85A71] rounded-full transition-all duration-500" :style="'width:' + course.progressPercent + '%'" />
        </view>
      </view>
    </view>

    <!-- 骨架屏 -->
    <view v-if="isLoading && !isRefreshing" class="min-h-screen bg-[#FAF8F5]">
      <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5]">
        <view class="h-14 px-4 flex items-center gap-3">
          <view class="w-8 h-8 bg-[#F2EFEA] rounded-full animate-pulse" />
          <view class="h-5 bg-[#F2EFEA] rounded w-40 animate-pulse" />
        </view>
        <view class="px-4 pb-4">
          <view class="flex items-center justify-between mb-2">
            <view class="h-4 bg-[#F2EFEA] rounded w-24 animate-pulse" />
            <view class="h-4 bg-[#F2EFEA] rounded w-16 animate-pulse" />
          </view>
          <view class="h-2 bg-[#F2EFEA] rounded-full animate-pulse" />
        </view>
      </view>
      <view class="p-4 space-y-4">
        <view v-for="i in 3" :key="i" class="bg-white rounded-xl p-4 animate-pulse">
          <view class="h-5 bg-[#F2EFEA] rounded w-48 mb-4" />
          <view v-for="j in 4" :key="j" class="flex items-center gap-3 mb-3">
            <view class="w-8 h-8 bg-[#F2EFEA] rounded-full" />
            <view class="flex-1">
              <view class="h-4 bg-[#F2EFEA] rounded w-3/4 mb-1" />
              <view class="h-3 bg-[#F2EFEA] rounded w-16" />
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 章节列表 -->
    <view v-else class="p-4 space-y-4 pb-8">
      <view v-for="chapter in chapters" :key="chapter.id" class="bg-white rounded-xl shadow-sm overflow-hidden">
        <view class="px-4 py-3 border-b border-[#F2EFEA] flex items-center justify-between">
          <text class="font-medium text-[#2C2C2C]">{{ chapter.title }}</text>
          <text :class="['text-xs px-2 py-0.5 rounded-full', chapter.lessons.filter((l: any) => l.status === 'completed').length === chapter.lessons.length ? 'bg-green-100 text-green-600' : 'bg-[#F5F0E8] text-[#666]']">
            {{ chapter.lessons.filter((l: any) => l.status === 'completed').length }}/{{ chapter.lessons.length }}
          </text>
        </view>
        <view class="divide-y divide-[#F5F0E8]">
          <view v-for="lesson in chapter.lessons" :key="lesson.id" :class="['w-full px-4 py-3 flex items-center gap-3', lesson.status === 'locked' ? 'opacity-60' : '']" @click="handleLessonClick(lesson)">
            <!-- 状态图标 -->
            <view v-if="lesson.status === 'completed'" class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center">
              <text class="text-green-600 text-lg">✅</text>
            </view>
            <view v-else-if="lesson.status === 'in-progress'" class="w-8 h-8 rounded-full bg-[#C41E3A]/10 flex items-center justify-center relative">
              <text class="text-[#C41E3A] text-sm animate-pulse">▶</text>
              <svg class="absolute inset-0 w-8 h-8 -rotate-90">
                <circle cx="16" cy="16" r="14" fill="none" stroke="#C41E3A" stroke-width="2" stroke-dasharray="88" stroke-dashoffset="44" opacity="0.3" />
              </svg>
            </view>
            <view v-else-if="lesson.status === 'available'" class="w-8 h-8 rounded-full bg-[#C41E3A]/10 flex items-center justify-center">
              <text class="text-[#C41E3A] text-sm">▶</text>
            </view>
            <view v-else class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center">
              <text class="text-gray-400">🔒</text>
            </view>
            <!-- 课时信息 -->
            <view class="flex-1 min-w-0">
              <text :class="['text-sm truncate block', lesson.status === 'completed' ? 'text-[#999]' : 'text-[#2C2C2C]', lesson.status === 'in-progress' ? 'text-[#C41E3A] font-medium' : '']">
                {{ lesson.title }}
              </text>
              <view class="flex items-center gap-2 mt-0.5">
                <text class="text-xs text-[#999]">🕐 {{ formatDuration(lesson.duration) }}</text>
                <text v-if="lesson.status === 'in-progress'" class="text-xs text-[#C41E3A]">学习中</text>
              </view>
            </view>
            <text v-if="lesson.status !== 'locked' && lesson.status !== 'completed'" class="text-[#C41E3A]">▶</text>
          </view>
        </view>
      </view>
    </view>
    <view class="h-6" />
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'
import { onLoad } from '@dcloudio/uni-app'

type LessonStatus = 'completed' | 'in-progress' | 'available' | 'locked'

interface Lesson {
  id: string
  title: string
  duration: number
  status: LessonStatus
}

interface Chapter {
  id: string
  title: string
  lessons: Lesson[]
}

const mockCourse = {
  id: '1',
  title: '八字命理入门到精通',
  totalLessons: 32,
  completedLessons: 12,
  progressPercent: 38,
}

const mockChapters: Chapter[] = [
  { id: 'ch1', title: '第一章 八字基础概念', lessons: [
    { id: 'l1', title: '1.1 什么是八字命理', duration: 1520, status: 'completed' },
    { id: 'l2', title: '1.2 天干地支详解', duration: 1830, status: 'completed' },
    { id: 'l3', title: '1.3 阴阳五行基础', duration: 2100, status: 'completed' },
    { id: 'l4', title: '1.4 干支配合规律', duration: 1650, status: 'completed' },
  ]},
  { id: 'ch2', title: '第二章 排盘方法', lessons: [
    { id: 'l5', title: '2.1 年柱的排法', duration: 1420, status: 'completed' },
    { id: 'l6', title: '2.2 月柱的排法', duration: 1680, status: 'completed' },
    { id: 'l7', title: '2.3 日柱的排法', duration: 1550, status: 'completed' },
    { id: 'l8', title: '2.4 时柱的排法', duration: 1720, status: 'completed' },
  ]},
  { id: 'ch3', title: '第三章 十神详解', lessons: [
    { id: 'l9', title: '3.1 比劫的含义与作用', duration: 1850, status: 'completed' },
    { id: 'l10', title: '3.2 食伤的含义与作用', duration: 1920, status: 'completed' },
    { id: 'l11', title: '3.3 财星的含义与作用', duration: 1780, status: 'completed' },
    { id: 'l12', title: '3.4 官杀的含义与作用', duration: 1650, status: 'in-progress' },
    { id: 'l13', title: '3.5 印星的含义与作用', duration: 1880, status: 'available' },
  ]},
  { id: 'ch4', title: '第四章 格局分析', lessons: [
    { id: 'l14', title: '4.1 八格的判定方法', duration: 2100, status: 'available' },
    { id: 'l15', title: '4.2 正格与变格', duration: 1950, status: 'available' },
    { id: 'l16', title: '4.3 用神的取法', duration: 2250, status: 'available' },
    { id: 'l17', title: '4.4 格局高低判断', duration: 1820, status: 'available' },
  ]},
  { id: 'ch5', title: '第五章 大运流年', lessons: [
    { id: 'l18', title: '5.1 大运的排法', duration: 1680, status: 'locked' },
    { id: 'l19', title: '5.2 流年的看法', duration: 1750, status: 'locked' },
    { id: 'l20', title: '5.3 运年作用关系', duration: 1920, status: 'locked' },
    { id: 'l21', title: '5.4 吉凶判断要点', duration: 2080, status: 'locked' },
  ]},
]

const isLoading = ref(true)
const isRefreshing = ref(false)
const course = ref(mockCourse)
const chapters = ref<Chapter[]>(mockChapters)
const courseId = ref('1')

async function loadData(refresh = false) {
  if (refresh) isRefreshing.value = true
  else isLoading.value = true
  await new Promise(resolve => setTimeout(resolve, refresh ? 500 : 800))
  course.value = mockCourse
  chapters.value = mockChapters
  isLoading.value = false
  isRefreshing.value = false
}

onLoad((options: any) => {
  if (options?.id) courseId.value = options.id
  loadData()
})

function formatDuration(seconds: number): string {
  const mins = Math.floor(seconds / 60)
  const secs = seconds % 60
  return `${mins}:${String(secs).padStart(2, '0')}`
}

function goBack() { uni.navigateBack() }

function handleRefresh() { loadData(true) }

function handleLessonClick(lesson: Lesson) {
  if (lesson.status === 'locked') {
    uni.showToast({ title: '请先完成前面的课程', icon: 'none' })
    return
  }
  uni.navigateTo({ url: `/pages/courses/id-detail/player/index?lesson=${lesson.id}&courseId=${course.value.id}` })
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
