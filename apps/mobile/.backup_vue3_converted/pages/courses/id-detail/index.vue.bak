<template>
  <!-- ===== 骨架屏 ===== -->
  <view v-if="isLoading" class="min-h-screen bg-[#FAF8F5]">
    <view class="h-56 bg-[#E8E0D5] animate-pulse" />
    <view class="px-4 -mt-6 relative z-10">
      <view class="bg-white rounded-t-[20px] p-4 space-y-4">
        <view class="h-7 bg-[#E8E0D5] rounded w-3/4" />
        <view class="h-4 bg-[#E8E0D5] rounded w-1/2" />
        <view class="flex gap-3">
          <view class="h-10 bg-[#E8E0D5] rounded-full w-20" />
          <view class="h-10 bg-[#E8E0D5] rounded-full w-20" />
        </view>
      </view>
    </view>
    <view class="px-4 mt-4">
      <view class="h-24 bg-white rounded-xl animate-pulse mb-3" />
      <view class="h-48 bg-white rounded-xl animate-pulse" />
    </view>
  </view>

  <!-- ===== 课程不存在 ===== -->
  <view v-else-if="!course" class="min-h-screen bg-[#FAF8F5] flex flex-col items-center justify-center p-4">
    <text class="text-5xl text-[#E8E0D5] block mb-4">📚</text>
    <text class="text-[#999] text-sm">课程不存在或已下架</text>
    <view @click="goBack" class="mt-6 px-6 py-2 bg-[#C41E3A] text-white text-sm rounded-full active:opacity-80">返回</view>
  </view>

  <!-- ===== 主内容 ===== -->
  <view v-else class="min-h-screen bg-[#FAF8F5] pb-28">
    <!-- ===== 封面区域 ===== -->
    <view class="relative h-56">
      <image :src="course.cover" mode="aspectFill" class="w-full h-full" />
      <view class="absolute inset-0" style="background:linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0.2), transparent)" />

      <!-- 顶部导航 -->
      <view class="absolute top-0 left-0 right-0 p-4 flex items-center justify-between">
        <view @click="goBack" class="w-9 h-9 rounded-full flex items-center justify-center active:scale-95" style="background:rgba(0,0,0,0.35)">
          <text class="text-white text-lg leading-none">←</text>
        </view>
        <view class="flex items-center gap-2">
          <view @click="isLiked = !isLiked" class="w-9 h-9 rounded-full flex items-center justify-center active:scale-95" style="background:rgba(0,0,0,0.35)">
            <text :class="['text-lg leading-none', isLiked ? 'text-[#C41E3A]' : 'text-white']">{{ isLiked ? '❤️' : '🤍' }}</text>
          </view>
          <view @click="handleShare" class="w-9 h-9 rounded-full flex items-center justify-center active:scale-95" style="background:rgba(0,0,0,0.35)">
            <text class="text-white text-lg leading-none">📤</text>
          </view>
        </view>
      </view>

      <!-- 课程基本信息 -->
      <view class="absolute bottom-0 left-0 right-0 p-4 pb-5">
        <view class="flex items-center gap-2 mb-2">
          <text v-if="course.tag" class="px-2 py-0.5 text-white text-[10px] font-bold rounded leading-normal" style="background:#C41E3A">{{ course.tag }}</text>
          <text v-if="course.level" class="px-2 py-0.5 text-[10px] rounded leading-normal border border-white/40 text-white/90">{{ levelLabel(course.level) }}</text>
        </view>
        <text class="text-[20px] font-bold text-white block leading-tight line-clamp-2">{{ course.title }}</text>
        <view class="flex items-center gap-3 text-white/80 text-[12px] mt-2">
          <text>👥 {{ formatCount(course.students) }}人学习</text>
          <text>⭐ {{ course.rating }}分</text>
          <text>📚 {{ totalLessons }}节课</text>
          <text v-if="totalDuration">⏱ {{ formatDuration(totalDuration) }}</text>
        </view>
      </view>
    </view>

    <!-- ===== 课程亮点 ===== -->
    <view v-if="course.highlights && course.highlights.length > 0" class="px-4 -mt-2 relative z-10">
      <view class="bg-white rounded-xl p-4 shadow-sm border border-[#E8E0D5]">
        <view class="grid grid-cols-3 gap-3">
          <view v-for="h in course.highlights" :key="h.icon" class="flex flex-col items-center text-center gap-1">
            <text class="text-xl">{{ h.icon }}</text>
            <text class="text-[11px] font-medium text-[#2C2C2C]">{{ h.label }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 讲师信息 ===== -->
    <view class="px-4 mt-3">
      <view @click="goTo('/pages/instructor/' + course.instructor.id + '/index')" class="bg-white rounded-xl p-4 shadow-sm border border-[#E8E0D5] active:bg-[#FAF8F5]">
        <view class="flex items-center justify-between">
          <view class="flex items-center gap-3 min-w-0">
            <view class="w-12 h-12 rounded-full flex items-center justify-center shrink-0" style="background:linear-gradient(135deg,#C41E3A,#E74C3C)">
              <text class="text-white text-sm font-medium">{{ course.instructor.name[0] }}</text>
            </view>
            <view class="min-w-0">
              <view class="flex items-center gap-1">
                <text class="text-[15px] font-medium text-[#2C2C2C] truncate">{{ course.instructor.name }}</text>
                <text v-if="course.instructor.verified" class="text-[10px] px-1 py-0.5 rounded bg-[#C9A96E]/20 text-[#C9A96E] leading-none">V</text>
              </view>
              <text class="text-[12px] text-[#999] block truncate">{{ course.instructor.title }}</text>
              <text v-if="course.instructor.bio" class="text-[11px] text-[#999] block mt-0.5 truncate">{{ course.instructor.bio }}</text>
            </view>
          </view>
          <text class="text-xs text-[#C41E3A] shrink-0 ml-2">查看主页 &gt;</text>
        </view>
      </view>
    </view>

    <!-- ===== Tab切换 ===== -->
    <view class="px-4 mt-4">
      <view class="flex gap-0 border-b border-[#E8E0D5]">
        <view v-for="tab in tabList" :key="tab.key" @click="activeTab = tab.key"
          :class="['pb-3 text-[14px] font-medium relative transition-colors px-3', activeTab === tab.key ? 'text-[#C41E3A]' : 'text-[#666]']">
          <text>{{ tab.label }}</text>
          <text v-if="tab.count !== undefined" class="text-xs ml-1 opacity-70">({{ tab.count }})</text>
          <view v-if="activeTab === tab.key" class="absolute bottom-0 left-3 right-3 h-0.5 bg-[#C41E3A] rounded-full" />
        </view>
      </view>
    </view>

    <!-- ===== Tab内容 ===== -->
    <view class="px-4 mt-4 space-y-4" style="padding-bottom:120px">
      <!-- ===== 简介Tab ===== -->
      <view v-if="activeTab === 'intro'" class="space-y-6">
        <!-- 课程简介 -->
        <view>
          <text class="text-[15px] font-bold text-[#2C2C2C] mb-3 block">课程简介</text>
          <text class="text-[13px] text-[#666] leading-relaxed block">{{ course.description }}</text>
        </view>

        <!-- 学完收获 -->
        <view v-if="course.objectives && course.objectives.length > 0">
          <text class="text-[15px] font-bold text-[#2C2C2C] mb-3 block">🎯 学完你将收获</text>
          <view class="space-y-2">
            <view v-for="(obj, i) in course.objectives" :key="i" class="flex items-start gap-2">
              <text class="text-green-500 text-sm mt-0.5 flex-shrink-0">✅</text>
              <text class="text-[13px] text-[#666] leading-relaxed">{{ obj }}</text>
            </view>
          </view>
        </view>

        <!-- 适合人群 -->
        <view v-if="course.suitable && course.suitable.length > 0">
          <text class="text-[15px] font-bold text-[#2C2C2C] mb-3 block">👥 适合人群</text>
          <view class="flex flex-wrap gap-2">
            <text v-for="(item, i) in course.suitable" :key="i"
              class="px-3 py-1.5 text-[12px] rounded-full"
              style="background:rgba(196,30,58,0.06);color:#C41E3A">{{ item }}</text>
          </view>
        </view>

        <!-- 课程数据统计 -->
        <view class="grid grid-cols-4 gap-2">
          <view class="bg-white rounded-xl p-3 text-center border border-[#E8E0D5]">
            <text class="text-[18px] font-bold block text-[#C41E3A]">{{ totalLessons }}</text>
            <text class="text-[10px] text-[#999]">课时</text>
          </view>
          <view class="bg-white rounded-xl p-3 text-center border border-[#E8E0D5]">
            <text class="text-[18px] font-bold block text-[#C41E3A]">{{ totalDuration > 60 ? Math.floor(totalDuration / 60) + '+' : totalDuration }}</text>
            <text class="text-[10px] text-[#999]">{{ totalDuration > 60 ? '小时' : '分钟' }}</text>
          </view>
          <view class="bg-white rounded-xl p-3 text-center border border-[#E8E0D5]">
            <text class="text-[18px] font-bold block text-[#C41E3A]">{{ formatCompact(course.students) }}</text>
            <text class="text-[10px] text-[#999]">学员</text>
          </view>
          <view class="bg-white rounded-xl p-3 text-center border border-[#E8E0D5]">
            <text class="text-[18px] font-bold block text-[#C41E3A]">{{ formatCompact(reviews.length) }}</text>
            <text class="text-[10px] text-[#999]">评价</text>
          </view>
        </view>

        <!-- 证书信息 -->
        <view v-if="course.certificateInfo" class="p-4 rounded-xl flex items-center gap-3" style="background:rgba(245,241,235,0.5)">
          <text class="text-2xl">🎓</text>
          <view class="flex-1">
            <text class="text-[13px] font-medium text-[#2C2C2C] block">{{ course.certificateInfo }}</text>
            <text class="text-[11px] text-[#999] block mt-0.5">完成全部课程后可获得结业证书</text>
          </view>
        </view>
      </view>

      <!-- ===== 目录Tab ===== -->
      <view v-if="activeTab === 'chapters'" class="space-y-3">
        <!-- 学习进度（已购用户） -->
        <view v-if="hasAccess && course.progress !== undefined" class="bg-white rounded-xl p-4 border border-[#E8E0D5]">
          <view class="flex items-center justify-between mb-2">
            <text class="text-[13px] font-medium text-[#2C2C2C]">学习进度</text>
            <text class="text-[12px] text-[#C41E3A]">{{ course.progress }}%</text>
          </view>
          <view class="h-2 bg-[#E8E0D5] rounded-full overflow-hidden">
            <view class="h-full bg-[#C41E3A] rounded-full transition-all" :style="{ width: course.progress + '%' }" />
          </view>
        </view>

        <view v-for="(chapter, ci) in chapters" :key="chapter.id" class="bg-white rounded-xl overflow-hidden border border-[#E8E0D5]">
          <!-- 章节标题 -->
          <view @click="toggleChapter(chapter.id)" class="w-full px-4 py-3.5 flex items-center justify-between active:bg-[#FAF8F5]">
            <view class="flex items-center gap-3 min-w-0">
              <view class="w-7 h-7 rounded-full flex items-center justify-center text-[12px] font-bold shrink-0" style="background:rgba(196,30,58,0.08);color:#C41E3A">
                <text>{{ ci + 1 }}</text>
              </view>
              <view class="text-left min-w-0">
                <text class="text-[14px] font-medium text-[#2C2C2C] block truncate">{{ chapter.title }}</text>
                <view class="flex items-center gap-2 text-[11px] text-[#999]">
                  <text>{{ chapter.lessons?.length || 0 }}节</text>
                  <text>{{ formatDuration(chapter.duration) }}</text>
                  <text v-if="chapter.isFree" class="text-green-500">免费试看</text>
                </view>
              </view>
            </view>
            <text class="text-[#999] text-lg leading-none shrink-0 ml-2">{{ expandedChapters.has(chapter.id) ? '▲' : '▼' }}</text>
          </view>

          <!-- 课时列表 -->
          <view v-if="expandedChapters.has(chapter.id) && chapter.lessons" class="border-t border-[#F2EFEA]">
            <view v-for="(lesson, li) in chapter.lessons" :key="lesson.id"
              @click="handleLessonClick(chapter.id, lesson.id)"
              class="w-full px-4 py-3 flex items-center justify-between active:bg-[#FAF8F5]"
              :class="li > 0 ? 'border-t border-[#F2EFEA]' : ''">
              <view class="flex items-center gap-3 min-w-0">
                <view :class="['w-8 h-8 rounded-lg flex items-center justify-center shrink-0', lesson.isFree ? 'bg-green-50' : 'bg-[#F2EFEA]']">
                  <text v-if="hasAccess || lesson.isFree" :class="['text-sm leading-none', lesson.isFree ? 'text-green-500' : 'text-[#666]']">▶</text>
                  <text v-else class="text-sm leading-none text-[#999]">🔒</text>
                </view>
                <view class="min-w-0">
                  <view class="flex items-center gap-1">
                    <text class="text-[13px] text-[#2C2C2C] truncate">{{ lesson.title }}</text>
                    <text v-if="lesson.isCompleted" class="text-green-500 text-xs shrink-0">✅</text>
                  </view>
                  <text class="text-[11px] text-[#999] block">{{ lesson.duration }}分钟</text>
                </view>
              </view>
              <view class="flex items-center gap-2 shrink-0 ml-2">
                <text v-if="lesson.isFree && !hasAccess" class="text-[10px] text-green-500 bg-green-50 px-1.5 py-0.5 rounded leading-none">试看</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- ===== 评价Tab ===== -->
      <view v-if="activeTab === 'reviews'" class="space-y-4">
        <!-- 评分概览 -->
        <view class="bg-white rounded-xl p-4 border border-[#E8E0D5]">
          <view class="flex items-center gap-4">
            <view class="text-center">
              <text class="text-[32px] font-bold text-[#C41E3A] block leading-tight">{{ course.rating }}</text>
              <view class="flex items-center gap-0.5 justify-center mt-1">
                <text v-for="i in 5" :key="i"
                  :class="['text-sm', i <= Math.floor(course.rating) ? 'text-yellow-500' : 'text-[#E8E0D5]']">⭐</text>
              </view>
              <text class="text-[11px] text-[#999] mt-1 block">{{ reviews.length }}条评价</text>
            </view>
            <view class="flex-1 space-y-1.5">
              <view v-for="star in starLevels" :key="star.value" class="flex items-center gap-2">
                <text class="text-[11px] text-[#999] w-4">{{ star.label }}</text>
                <view class="flex-1 h-1.5 bg-[#F2EFEA] rounded-full overflow-hidden">
                  <view class="h-full bg-yellow-400 rounded-full transition-all" :style="{ width: ratingPercent(star.value) + '%' }" />
                </view>
                <text class="text-[10px] text-[#999] w-6 text-right">{{ ratingCount(star.value) }}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 评价列表 -->
        <view v-for="review in reviews" :key="review.id" class="bg-white rounded-xl p-4 border border-[#E8E0D5]">
          <view class="flex items-center gap-3 mb-2">
            <view class="w-9 h-9 rounded-full flex items-center justify-center text-white text-xs font-medium shrink-0" style="background:linear-gradient(135deg,#C41E3A,#E74C3C)">
              <text>{{ review.userName[0] }}</text>
            </view>
            <view class="flex-1 min-w-0">
              <text class="text-[13px] font-medium text-[#2C2C2C] block truncate">{{ review.userName }}</text>
              <view class="flex items-center gap-1">
                <text v-for="i in 5" :key="i"
                  :class="['text-xs', i <= review.rating ? 'text-yellow-500' : 'text-[#E8E0D5]']">⭐</text>
                <text class="text-[10px] text-[#999] ml-1">{{ formatDate(review.createdAt) }}</text>
              </view>
            </view>
          </view>
          <text class="text-[13px] text-[#666] leading-relaxed block">{{ review.content }}</text>
          <view v-if="review.reply" class="mt-3 pl-3 border-l-2 border-[#C41E3A]/30">
            <view class="flex items-center gap-1 mb-1">
              <text class="text-[11px] font-medium text-[#C41E3A]">讲师回复</text>
            </view>
            <text class="text-[12px] text-[#666]">{{ review.reply }}</text>
          </view>
        </view>

        <!-- 查看更多评价 -->
        <view v-if="reviews.length >= reviewPageSize" @click="reviewPage++"
          class="text-center py-3 text-sm text-[#C41E3A] active:opacity-70">
          查看更多评价 ({{ reviews.length }}条)
        </view>
      </view>
    </view>

    <!-- ===== 推荐课程 ===== -->
    <view v-if="relatedCourses.length > 0" class="mt-6">
      <view class="px-4 mb-3">
        <text class="text-[15px] font-bold text-[#2C2C2C]">📚 推荐课程</text>
      </view>
      <scroll-view scroll-x class="px-4" style="white-space:nowrap">
        <view v-for="rc in relatedCourses" :key="rc.id" @click="goTo('/pages/courses/id-detail/index?id=' + rc.id)"
          class="inline-block w-36 mr-3 last:mr-0 active:opacity-80" style="white-space:normal">
          <view class="w-full aspect-[3/2] rounded-lg overflow-hidden bg-[#E8E0D5]">
            <image :src="rc.cover" mode="aspectFill" class="w-full h-full" />
          </view>
          <text class="text-[12px] font-medium text-[#2C2C2C] block mt-2 line-clamp-2">{{ rc.title }}</text>
          <view class="flex items-center gap-1 mt-1">
            <text class="text-[11px] font-bold text-[#C41E3A]">¥{{ rc.price }}</text>
            <text v-if="rc.originalPrice" class="text-[10px] text-[#999] line-through">¥{{ rc.originalPrice }}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- ===== 拼课优惠Banner ===== -->
    <view v-if="showGroupBuyBanner && !hasAccess && !course.isFree"
      class="fixed bottom-[76px] left-4 right-4 z-40">
      <view class="p-3 rounded-xl shadow-lg" style="background:linear-gradient(135deg,#FF6B35,#FF8C5A)">
        <view class="flex items-center justify-between">
          <view class="flex items-center gap-2 min-w-0">
            <text class="text-white text-lg shrink-0">👥</text>
            <view class="min-w-0">
              <text class="text-white text-sm font-medium block">邀请好友拼课，立省¥{{ groupBuyDiscount }}</text>
              <text class="text-white/80 text-xs block">2人成团，每人仅需¥{{ groupBuyPrice }}</text>
            </view>
          </view>
          <view class="flex items-center gap-2 shrink-0 ml-2">
            <view class="px-3 py-1.5 bg-white text-[#FF6B35] text-xs font-medium rounded-full active:opacity-80">
              发起拼课
            </view>
            <view @click="showGroupBuyBanner = false" class="active:opacity-60">
              <text class="text-white/70 text-lg leading-none">✕</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 底部固定操作栏 ===== -->
    <view class="fixed bottom-0 left-0 right-0 bg-white/95 backdrop-blur-lg border-t border-[#E8E0D5] px-4 py-3 flex items-center gap-3 z-50" style="padding-bottom:calc(12px + env(safe-area-inset-bottom))">
      <view @click="showConsultPanel = true" class="flex flex-col items-center text-[#666] min-w-[44px] active:opacity-70">
        <text class="text-lg leading-none">💬</text>
        <text class="text-[10px] mt-0.5">咨询</text>
      </view>
      <view @click="showGroupPanel = true" class="flex flex-col items-center text-[#666] min-w-[44px] active:opacity-70">
        <text class="text-lg leading-none">👥</text>
        <text class="text-[10px] mt-0.5">学习群</text>
      </view>

      <view class="flex-1 ml-2">
        <text v-if="course.isFree" class="text-[18px] font-bold text-green-500">免费</text>
        <view v-else class="flex items-baseline gap-1.5">
          <text class="text-[12px] text-[#C41E3A]">¥</text>
          <text class="text-[24px] font-bold text-[#C41E3A] leading-tight">{{ course.price }}</text>
          <text v-if="course.originalPrice" class="text-[12px] text-[#999] line-through">¥{{ course.originalPrice }}</text>
        </view>
      </view>

      <view v-if="hasAccess" @click="handleStartLearning"
        class="px-8 h-11 text-white font-bold rounded-full flex items-center justify-center text-sm active:opacity-90"
        style="background:linear-gradient(135deg,#C41E3A,#E74C3C)">
        <text>{{ course.progress && course.progress > 0 ? '继续学习' : '开始学习' }}</text>
      </view>
      <view v-else @click="handlePurchase"
        class="px-8 h-11 text-white font-bold rounded-full flex items-center justify-center text-sm active:opacity-90"
        style="background:linear-gradient(135deg,#C41E3A,#E74C3C)">
        <text>立即购买</text>
      </view>
    </view>

    <!-- ===== 课程咨询弹窗 ===== -->
    <view v-if="showConsultPanel" class="fixed inset-0 z-[60]">
      <view class="absolute inset-0 bg-black/50" @click="showConsultPanel = false" />
      <view class="absolute bottom-0 left-0 right-0 bg-white rounded-t-3xl p-4 pb-8">
        <view class="flex items-center justify-between mb-4">
          <text class="font-bold text-lg text-[#2C2C2C]">课程咨询</text>
          <view @click="showConsultPanel = false" class="active:opacity-60">
            <text class="text-[#999] text-xl leading-none">✕</text>
          </view>
        </view>
        <view class="space-y-3">
          <view class="w-full p-4 rounded-xl flex items-center gap-3 active:opacity-80" style="background:rgba(245,241,235,0.8)">
            <view class="w-10 h-10 bg-[#C41E3A] rounded-full flex items-center justify-center shrink-0">
              <text class="text-white text-lg leading-none">💬</text>
            </view>
            <view class="text-left">
              <text class="font-medium text-[#2C2C2C] block text-sm">在线客服</text>
              <text class="text-xs text-[#999] block">9:00-22:00 在线解答</text>
            </view>
          </view>
          <view class="w-full p-4 rounded-xl flex items-center gap-3 active:opacity-80" style="background:rgba(245,241,235,0.8)">
            <view class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center shrink-0">
              <text class="text-white text-lg leading-none">📱</text>
            </view>
            <view class="text-left">
              <text class="font-medium text-[#2C2C2C] block text-sm">微信咨询</text>
              <text class="text-xs text-[#999] block">扫码添加课程顾问</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 学习群弹窗 ===== -->
    <view v-if="showGroupPanel" class="fixed inset-0 z-[60]">
      <view class="absolute inset-0 bg-black/50" @click="showGroupPanel = false" />
      <view class="absolute bottom-0 left-0 right-0 bg-white rounded-t-3xl p-4 pb-8">
        <view class="flex items-center justify-between mb-4">
          <text class="font-bold text-lg text-[#2C2C2C]">加入学习群</text>
          <view @click="showGroupPanel = false" class="active:opacity-60">
            <text class="text-[#999] text-xl leading-none">✕</text>
          </view>
        </view>
        <view class="text-center py-4">
          <view class="w-40 h-40 mx-auto rounded-xl flex items-center justify-center mb-3" style="background:rgba(245,241,235,0.8)">
            <text class="text-6xl text-[#999]">📱</text>
          </view>
          <text class="text-sm text-[#666] block mb-1">扫码加入「{{ course.title }}」学习群</text>
          <text class="text-xs text-[#999] block">与 {{ formatCount(course.students) }} 位同学一起学习交流</text>
        </view>
        <view class="p-3 rounded-xl mt-2" style="background:rgba(255,249,230,0.8)">
          <text class="text-xs text-yellow-800 block">入群福利：课程答疑、学习资料、作业批改、结业证书</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'
import { api } from '@/api'

// ===== 类型定义 =====
interface Instructor {
  id: string; name: string; title: string; avatar: string
  verified?: boolean; bio?: string
}

interface Lesson {
  id: string; title: string; duration: number
  isFree?: boolean; isCompleted?: boolean
}

interface Chapter {
  id: string; title: string; duration: number
  isFree?: boolean; lessons: Lesson[]
}

interface Review {
  id: string; userName: string; content: string
  rating: number; createdAt: string; reply?: string
}

interface CourseHighlight {
  icon: string; label: string
}

interface RelatedCourse {
  id: string; title: string; cover: string
  price: number; originalPrice?: number
}

interface CourseDetailData {
  id: string; title: string; cover: string
  instructor: Instructor; price?: number; originalPrice?: number
  students: number; rating: number; chapters: number
  category: string; tag?: string; level?: string
  isFree?: boolean; progress?: number
  description: string; objectives: string[]
  suitable: string[]; highlights: CourseHighlight[]
  certificateInfo?: string; isEnrolled?: boolean
}

// ===== Tab配置 =====
const tabList = computed(() => {
  const items = [
    { key: 'intro', label: '简介' },
    { key: 'chapters', label: '目录', count: totalLessons.value },
    { key: 'reviews', label: '评价', count: reviews.value.length },
  ]
  return items
})

const starLevels = [
  { value: 5, label: '5星' },
  { value: 4, label: '4星' },
  { value: 3, label: '3星' },
  { value: 2, label: '2星' },
  { value: 1, label: '1星' },
]

// ===== 状态 =====
const isLoading = ref(true)
const course = ref<CourseDetailData | null>(null)
const chapters = ref<Chapter[]>([])
const reviews = ref<Review[]>([])
const relatedCourses = ref<RelatedCourse[]>([])
const activeTab = ref<'intro' | 'chapters' | 'reviews'>('intro')
const hasAccess = ref(false)
const isLiked = ref(false)
const showGroupBuyBanner = ref(true)
const showConsultPanel = ref(false)
const showGroupPanel = ref(false)
const expandedChapters = ref<Set<string>>(new Set(['c1']))
const reviewPage = ref(1)
const reviewPageSize = ref(5)

// ===== Mock数据 =====
const mockCourse: CourseDetailData = {
  id: '1', title: '八字命理入门到精通',
  cover: '/images/courses/course-1.jpg',
  instructor: {
    id: 'ins1', name: '张明远', avatar: '/images/experts/expert-1.jpg',
    title: '资深命理师 | 20年易学经验', verified: true,
    bio: '中国易经研究会理事，出版多部命理专著',
  },
  price: 299, originalPrice: 599, students: 12860, rating: 4.9,
  chapters: 32, category: '命理', tag: '热门', level: 'intermediate',
  isFree: false, isEnrolled: false,
  description: '本课程由资深命理师张明远老师主讲，从零基础开始，系统讲解八字命理的核心理论与实战技巧。课程涵盖天干地支、五行生克、十神论命、大运流年等核心内容，配合大量真实案例分析，让你快速掌握八字命理的精髓。',
  objectives: [
    '掌握天干地支的基本概念和五行属性',
    '理解八字排盘的原理和正确方法',
    '学会分析日主强弱和用神取用',
    '能够独立进行八字命盘分析',
    '了解大运流年的推算方法',
  ],
  suitable: ['对命理学感兴趣的初学者', '希望系统学习八字的爱好者', '想要提升命理水平的从业者'],
  highlights: [
    { icon: '🎥', label: '32节视频课' },
    { icon: '📝', label: '配套讲义' },
    { icon: '👥', label: '社群答疑' },
  ],
  certificateInfo: '完成全部课程可获得结业证书',
}

const mockChapters: Chapter[] = [
  { id: 'c1', title: '第一章 八字命理概述', duration: 45, isFree: true, lessons: [
    { id: 'l1', title: '1.1 什么是八字命理', duration: 15, isFree: true },
    { id: 'l2', title: '1.2 八字命理的历史渊源', duration: 18, isFree: true },
    { id: 'l3', title: '1.3 学习八字的正确方法', duration: 12, isFree: false },
  ]},
  { id: 'c2', title: '第二章 天干地支基础', duration: 68, isFree: false, lessons: [
    { id: 'l4', title: '2.1 十天干详解', duration: 22, isFree: false },
    { id: 'l5', title: '2.2 十二地支详解', duration: 25, isFree: false },
    { id: 'l6', title: '2.3 干支配合规律', duration: 21, isFree: false },
  ]},
  { id: 'c3', title: '第三章 五行生克制化', duration: 72, isFree: false, lessons: [
    { id: 'l7', title: '3.1 五行的基本概念', duration: 18, isFree: false },
    { id: 'l8', title: '3.2 五行生克关系', duration: 28, isFree: false },
    { id: 'l9', title: '3.3 五行在命理中的应用', duration: 26, isFree: false },
  ]},
  { id: 'c4', title: '第四章 八字排盘实战', duration: 85, isFree: false, lessons: [
    { id: 'l10', title: '4.1 年柱的排法', duration: 20, isFree: false },
    { id: 'l11', title: '4.2 月柱的排法', duration: 22, isFree: false },
    { id: 'l12', title: '4.3 日柱的排法', duration: 18, isFree: false },
    { id: 'l13', title: '4.4 时柱的排法', duration: 25, isFree: false },
  ]},
  { id: 'c5', title: '第五章 十神论命', duration: 90, isFree: false, lessons: [
    { id: 'l14', title: '5.1 十神的基本概念', duration: 20, isFree: false },
    { id: 'l15', title: '5.2 十神的相互作用', duration: 25, isFree: false },
    { id: 'l16', title: '5.3 十神在命局中的应用', duration: 28, isFree: false },
    { id: 'l17', title: '5.4 实战案例分析', duration: 17, isFree: false },
  ]},
]

const mockReviews: Review[] = [
  { id: 'r1', userName: '易学爱好者', content: '张老师讲得非常清晰，从零基础开始学完全能听懂。案例分析特别实用，已经可以给朋友简单看看八字了！推荐给所有想学八字的朋友。', rating: 5, createdAt: '2024-01-15', reply: '感谢支持！继续努力带来更多优质内容。' },
  { id: 'r2', userName: '命理新手', content: '课程内容很系统，比看书效率高多了。特别是五行生克那部分，老师用图解的方式讲解，一下子就理解了。', rating: 5, createdAt: '2024-01-10' },
  { id: 'r3', userName: '学习中', content: '整体不错，就是希望能多一些实战案例的讲解。目前理论部分讲得很好，期待老师出进阶课程！', rating: 4, createdAt: '2024-01-05', reply: '感谢建议，后续会推出案例分析专题课程。' },
  { id: 'r4', userName: '传统文化传承', content: '已经学完一半了，收获非常大。以前自己看书很多地方不理解，经过老师讲解豁然开朗。', rating: 5, createdAt: '2024-01-01' },
  { id: 'r5', userName: '国学爱好者', content: '性价比很高的课程，内容丰富讲解细致，课后还有作业批改，学习效果很好。', rating: 5, createdAt: '2023-12-28' },
  { id: 'r6', userName: '初学者', content: '作为零基础学员，前几章跟得上，后面稍微有点难，需要反复看。希望老师语速能稍微慢一点。', rating: 4, createdAt: '2023-12-20' },
  { id: 'r7', userName: '周易研究', content: '张老师是有真才实学的，不像网上那些半吊子。课程内容专业、系统、严谨，值得认真学习。', rating: 5, createdAt: '2023-12-15', reply: '感谢认可，教学相长！' },
]

const mockRelated: RelatedCourse[] = [
  { id: '2', title: '紫微斗数入门精讲', cover: '/images/courses/course-2.jpg', price: 399, originalPrice: 699 },
  { id: '3', title: '风水布局实战指南', cover: '/images/courses/course-3.jpg', price: 259, originalPrice: 499 },
  { id: '4', title: '梅花易数快速入门', cover: '/images/courses/course-4.jpg', price: 199, originalPrice: 399 },
  { id: '5', title: '六爻占卜从入门到精通', cover: '/images/courses/course-5.jpg', price: 349, originalPrice: 599 },
]

// ===== 计算属性 =====
const totalDuration = computed(() => chapters.value.reduce((sum, c) => sum + c.duration, 0))
const totalLessons = computed(() => chapters.value.reduce((sum, c) => sum + (c.lessons?.length || 0), 0))

const groupBuyDiscount = computed(() => {
  const p = course.value?.price || 0
  return Math.floor(p * 0.3)
})

const groupBuyPrice = computed(() => {
  const p = course.value?.price || 0
  return p - groupBuyDiscount.value
})

// ===== 工具函数 =====
function formatDuration(minutes: number): string {
  if (minutes >= 60) {
    const h = Math.floor(minutes / 60)
    const m = minutes % 60
    return h + '小时' + (m > 0 ? m + '分钟' : '')
  }
  return minutes + '分钟'
}

function formatCount(n: number): string {
  if (n >= 100000000) return (n / 100000000).toFixed(1) + '亿'
  if (n >= 10000) return (n / 10000).toFixed(1) + '万'
  return String(n)
}

function formatCompact(n: number): string {
  if (n >= 10000) return (n / 10000).toFixed(1) + '万'
  if (n >= 1000) return '999+'
  return String(n)
}

function formatDate(dateStr: string): string {
  return dateStr.replace(/-/g, '/')
}

function levelLabel(level: string): string {
  const map: Record<string, string> = {
    beginner: '入门', intermediate: '中级', advanced: '高级', all: '全部',
  }
  return map[level] || level
}

function ratingPercent(star: number): number {
  const count = reviews.value.filter(r => Math.floor(r.rating) === star).length
  return reviews.value.length > 0 ? (count / reviews.value.length) * 100 : 0
}

function ratingCount(star: number): number {
  return reviews.value.filter(r => Math.floor(r.rating) === star).length
}

// ===== 生命周期 =====
onMounted(async () => {
  isLoading.value = true
  try {
    const pages = getCurrentPages()
    const currentPage = pages[pages.length - 1] as any
    const courseId = currentPage?.$page?.options?.id || '1'

    const [courseRes, chaptersRes, reviewsRes, relatedRes] = await Promise.allSettled([
      api.get(`/courses/${courseId}`),
      api.get(`/courses/${courseId}/chapters`),
      api.get(`/courses/${courseId}/reviews`),
      api.get(`/courses/${courseId}/related`),
    ])

    if (courseRes.status === 'fulfilled' && courseRes.value && typeof courseRes.value === 'object' && 'title' in (courseRes.value as any)) {
      course.value = courseRes.value as unknown as CourseDetailData
      hasAccess.value = !!(course.value as any).isEnrolled
      isLiked.value = !!(course.value as any).isLiked
    } else {
      throw new Error('course data missing')
    }

    if (chaptersRes.status === 'fulfilled' && Array.isArray(chaptersRes.value)) {
      chapters.value = chaptersRes.value
    }
    if (reviewsRes.status === 'fulfilled' && Array.isArray(reviewsRes.value)) {
      reviews.value = reviewsRes.value
    }
    if (relatedRes.status === 'fulfilled' && Array.isArray(relatedRes.value)) {
      relatedCourses.value = relatedRes.value
    }
  } catch {
    await new Promise(r => setTimeout(r, 300))
    course.value = mockCourse
    chapters.value = mockChapters
    reviews.value = mockReviews
    relatedCourses.value = mockRelated
    hasAccess.value = false
  } finally {
    isLoading.value = false
  }
})

// ===== 交互函数 =====
function toggleChapter(chapterId: string) {
  const next = new Set(expandedChapters.value)
  if (next.has(chapterId)) next.delete(chapterId)
  else next.add(chapterId)
  expandedChapters.value = next
}

function handleLessonClick(chapterId: string, lessonId: string) {
  if (!hasAccess.value) {
    const ch = chapters.value.find(c => c.id === chapterId)
    const ls = ch?.lessons.find(l => l.id === lessonId)
    if (ls && !ls.isFree) {
      uni.showToast({ title: '购买课程后可观看', icon: 'none' })
      return
    }
  }
  const courseId = course.value?.id || '1'
  uni.navigateTo({ url: '/pages/courses/learn/index?courseId=' + courseId + '&chapter=' + chapterId + '&lesson=' + lessonId })
}

function handlePurchase() {
  uni.navigateTo({ url: '/pages/courses/purchase/index?id=' + (course.value?.id || '1') })
}

function handleStartLearning() {
  uni.navigateTo({ url: '/pages/courses/learn/index?courseId=' + (course.value?.id || '1') })
}

function handleShare() {
  uni.showActionSheet({
    itemList: ['分享到微信', '分享到朋友圈', '复制链接'],
    success: (res) => {
      if (res.tapIndex === 2) {
        uni.setClipboardData({
          data: '我正在学习「' + course.value?.title + '」，一起来学习吧！',
          success: () => uni.showToast({ title: '链接已复制', icon: 'success' }),
        })
      } else {
        uni.showToast({ title: '分享成功', icon: 'success' })
      }
    },
  })
}

// ===== 导航 =====
function goBack() { uni.navigateBack() }
function goTo(url: string) { uni.navigateTo({ url }) }
</script>

<style scoped>
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.animate-pulse {
  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.active\:opacity-70:active { opacity: 0.7; }
.active\:opacity-80:active { opacity: 0.8; }
.active\:opacity-90:active { opacity: 0.9; }
.active\:scale-95:active { transform: scale(0.95); }
</style>
