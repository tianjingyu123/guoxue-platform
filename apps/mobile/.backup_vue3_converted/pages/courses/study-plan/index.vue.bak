<template>
  <view class="min-h-screen" style="background:#FAF8F5;">
    <!-- 导航栏 -->
    <view class="sticky top-0 z-10" style="background:#C41E3A;">
      <view class="flex items-center h-14 px-4 gap-3">
        <view class="w-8 h-8 flex items-center justify-center" @click="goBack">
          <text class="text-white text-xl">←</text>
        </view>
        <text class="flex-1 text-lg font-bold text-white">学习计划</text>
        <view class="flex items-center gap-1 px-2.5 py-1 rounded-full" style="background:rgba(255,255,255,0.2);">
          <text class="text-sm" style="color:#FDBA74;">🔥</text>
          <text class="text-xs font-bold text-white">{{ streak }}天连续</text>
        </view>
      </view>
    </view>

    <!-- 完成度统计条 -->
    <view class="px-4 pb-5 pt-1" style="background:linear-gradient(135deg, #C41E3A, #9B0B28);">
      <view class="flex items-center gap-4">
        <view class="flex-1">
          <view class="flex items-center justify-between mb-1.5">
            <text class="text-xs" style="color:rgba(255,255,255,0.8);">今日完成</text>
            <text class="text-xs font-bold text-white">{{ doneCount }}/{{ tasks.length }} 项</text>
          </view>
          <view class="h-2 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.2);">
            <view
              class="h-full rounded-full transition-all duration-500"
              :style="'width:' + (tasks.length ? (doneCount / tasks.length) * 100 : 0) + '%'"
              style="background:#C9A96E;"
            />
          </view>
        </view>
        <view class="text-center">
          <text class="text-2xl font-black block" style="color:#C9A96E;">{{ tasks.length ? Math.round((doneCount / tasks.length) * 100) : 0 }}%</text>
          <text class="text-[10px] block" style="color:rgba(255,255,255,0.6);">完成率</text>
        </view>
      </view>
    </view>

    <view class="px-4 pt-4">
      <!-- 打卡日历 -->
      <view class="bg-white rounded-2xl p-4 mb-4" style="box-shadow:0 2px 12px rgba(0,0,0,0.06);">
        <view class="flex items-center justify-between mb-3">
          <view class="flex items-center gap-2">
            <view class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:rgba(196,30,58,0.1);">
              <text class="text-sm" style="color:#C41E3A;">📅</text>
            </view>
            <text class="text-base font-semibold" style="color:#2C2C2C;">打卡日历</text>
          </view>
          <text class="text-xs" style="color:#999;">
            近30天打卡 <text class="font-medium" style="color:#C41E3A;">{{ totalCheckinDays }}</text> 天
          </text>
        </view>
        <!-- 星期标签 -->
        <view class="flex mb-2">
          <view class="w-6" />
          <view v-for="l in WEEK_LABELS" :key="l" class="flex-1 text-center text-[10px]" style="color:#999;">{{ l }}</view>
        </view>
        <!-- 热力图网格 -->
        <view v-for="(week, wi) in weeks" :key="wi" class="flex items-center mb-1">
          <text class="w-6 text-[10px]" style="color:#999;">{{ getMonthLabel(week) }}月</text>
          <view v-for="(date, di) in week" :key="di" class="flex-1 flex justify-center">
            <view
              :class="[getDateColor(date.toISOString().slice(0, 10)), date.toISOString().slice(0, 10) === todayStr ? 'ring-2 ring-[#C41E3A] ring-offset-1' : '']"
              class="w-6 h-6 rounded-md"
            />
          </view>
        </view>
        <!-- 图例 -->
        <view class="flex items-center justify-end gap-1 mt-3 text-[10px]" style="color:#999;">
          <text>少</text>
          <view class="w-3 h-3 rounded" style="background:#F2EFEA;" />
          <view class="w-3 h-3 rounded" style="background:#FFE5E5;" />
          <view class="w-3 h-3 rounded" style="background:#FF9999;" />
          <view class="w-3 h-3 rounded" style="background:#C41E3A;" />
          <text>多</text>
        </view>
      </view>

      <!-- 目标卡片 -->
      <view class="bg-white rounded-2xl p-4 mb-4" style="box-shadow:0 2px 12px rgba(0,0,0,0.06);">
        <view class="flex items-center justify-between mb-3">
          <view class="flex items-center gap-2">
            <view class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:rgba(196,30,58,0.1);">
              <text class="text-sm" style="color:#C41E3A;">🎯</text>
            </view>
            <text class="text-base font-semibold" style="color:#2C2C2C;">学习目标</text>
          </view>
          <view class="flex items-center gap-1 text-xs font-medium" style="color:#C41E3A;" @click="openGoalEditor">
            <text>✏</text> 编辑
          </view>
        </view>
        <view class="flex items-center gap-4 mb-3">
          <view class="flex-1 text-center rounded-xl py-3" style="background:#FAF8F5;">
            <text class="text-3xl font-black block" style="color:#C41E3A;">{{ goal.daysPerWeek }}</text>
            <text class="text-xs block mt-1" style="color:#999;">天 / 周</text>
          </view>
          <view class="flex-1 text-center rounded-xl py-3" style="background:#FAF8F5;">
            <text class="text-3xl font-black block" style="color:#C9A96E;">{{ goal.minutesPerDay }}</text>
            <text class="text-xs block mt-1" style="color:#999;">分钟 / 天</text>
          </view>
          <view class="flex-1 text-center rounded-xl py-3" style="background:#FAF8F5;">
            <text class="text-3xl font-black block" style="color:#4A90D9;">{{ goal.daysPerWeek * goal.minutesPerDay }}</text>
            <text class="text-xs block mt-1" style="color:#999;">分钟 / 周</text>
          </view>
        </view>
        <!-- 周计划指示格 -->
        <view class="flex gap-1.5">
          <view
            v-for="(label, i) in WEEK_LABELS"
            :key="i"
            class="flex-1 h-8 rounded-md flex flex-col items-center justify-center gap-0.5 transition-all"
            :class="i === todayDay ? 'bg-[#C41E3A] text-white' : i !== 0 && i <= goal.daysPerWeek ? 'bg-[#C41E3A]/10 text-[#C41E3A]' : 'bg-[#F2EFEA] text-[#BBB]'"
          >
            <text class="text-[9px] font-medium">{{ label }}</text>
            <view v-if="i !== 0 && i <= goal.daysPerWeek && i !== todayDay" class="w-1 h-1 rounded-full" style="background:rgba(196,30,58,0.5);" />
          </view>
        </view>
      </view>

      <!-- 今日任务 -->
      <view class="bg-white rounded-2xl mb-4 overflow-hidden" style="box-shadow:0 2px 12px rgba(0,0,0,0.06);">
        <view class="px-4 pt-4 pb-3" style="border-bottom:1px solid #F2EFEA;">
          <view class="flex items-center justify-between">
            <view class="flex items-center gap-2">
              <view class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:rgba(255,237,213,1);">
                <text class="text-sm" style="color:#F97316;">🔥</text>
              </view>
              <view>
                <text class="text-base font-semibold" style="color:#2C2C2C;">今日任务</text>
                <text class="text-xs ml-1" style="color:#999;">{{ todayDisplay }}</text>
              </view>
            </view>
            <text class="text-sm font-bold" style="color:#C41E3A;">{{ doneCount }}/{{ tasks.length }}</text>
          </view>
          <!-- 进度条 -->
          <view class="mt-2.5 h-1.5 rounded-full overflow-hidden" style="background:#F2EFEA;">
            <view
              class="h-full rounded-full transition-all duration-500"
              :style="'width:' + (tasks.length ? (doneCount / tasks.length) * 100 : 0) + '%'"
              style="background:linear-gradient(90deg, #C41E3A, #E74C3C);"
            />
          </view>
          <view class="flex justify-between mt-1">
            <text class="text-[10px]" style="color:#999;">计划 {{ totalPlanMinutes }} 分钟</text>
            <text class="text-[10px]" style="color:#C41E3A;">已完成 {{ doneMinutes }} 分钟</text>
          </view>
        </view>
        <!-- 任务列表 -->
        <view v-if="tasks.length === 0" class="py-8 text-center text-sm" style="color:#BBB;">
          今日没有安排学习任务
        </view>
        <view v-else>
          <view
            v-for="task in tasks"
            :key="task.id"
            class="flex items-center gap-3 px-4 py-3 active:bg-[#FAF8F5] transition-colors"
            @click="toggleTask(task.id)"
            style="border-bottom:1px solid #F5F0E8;"
          >
            <text v-if="task.isDone" class="text-lg" style="color:#52C41A;">✅</text>
            <text v-else class="text-lg" style="color:#DDD;">○</text>
            <view class="flex-1 min-w-0">
              <text
                class="text-sm font-medium block truncate"
                :class="task.isDone ? 'line-through' : ''"
                :style="task.isDone ? 'color:#BBB;' : 'color:#2C2C2C;'"
              >{{ task.title }}</text>
              <text class="text-xs block mt-0.5" style="color:#999;">{{ task.lessonTitle }}</text>
            </view>
            <view class="flex items-center gap-1 text-xs flex-shrink-0" style="color:#BBB;">
              <text>🕐</text>
              <text>{{ task.duration }}分钟</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 课程安排 -->
      <view class="bg-white rounded-2xl mb-4 overflow-hidden" style="box-shadow:0 2px 12px rgba(0,0,0,0.06);">
        <view class="flex items-center justify-between px-4 pt-4 pb-3" style="border-bottom:1px solid #F2EFEA;">
          <view class="flex items-center gap-2">
            <view class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:rgba(74,144,217,0.1);">
              <text class="text-sm" style="color:#4A90D9;">📅</text>
            </view>
            <text class="text-base font-semibold" style="color:#2C2C2C;">课程安排</text>
          </view>
          <view class="w-7 h-7 rounded-full flex items-center justify-center" style="background:rgba(196,30,58,0.1);" @click="goAddCourse">
            <text class="text-sm" style="color:#C41E3A;">+</text>
          </view>
        </view>
        <!-- 空状态 -->
        <view
          v-if="plannedCourses.length === 0"
          class="w-full py-10 flex flex-col items-center gap-2 text-sm"
          style="color:#BBB;"
          @click="goAddCourse"
        >
          <text class="text-2xl">📖</text>
          <text>还没有安排课程，点击添加</text>
        </view>
        <!-- 课程列表 -->
        <view v-else>
          <view
            v-for="(pc, idx) in plannedCourses"
            :key="pc.id"
            class="flex items-center gap-3 px-4 py-3 transition-colors"
            style="border-bottom:1px solid #F5F0E8;"
          >
            <!-- 拖拽/排序按钮 -->
            <view class="flex flex-col gap-0.5 flex-shrink-0">
              <text
                v-if="idx > 0"
                class="text-[10px] px-1"
                style="color:#CCC;"
                @click="moveCourse(idx, -1)"
              >▲</text>
              <text
                v-if="idx < plannedCourses.length - 1"
                class="text-[10px] px-1"
                style="color:#CCC;"
                @click="moveCourse(idx, 1)"
              >▼</text>
            </view>
            <!-- 封面 -->
            <view class="w-12 h-12 rounded-lg overflow-hidden flex-shrink-0" style="background:#F2EFEA;">
              <image v-if="pc.cover" :src="pc.cover" mode="aspectFill" class="w-full h-full" />
              <view v-else class="w-full h-full flex items-center justify-center">
                <text class="text-lg" style="color:#999;">📚</text>
              </view>
            </view>
            <!-- 信息 -->
            <view class="flex-1 min-w-0">
              <text class="text-sm font-medium truncate block" style="color:#2C2C2C;">{{ pc.title }}</text>
              <view class="flex items-center gap-2 mt-1">
                <view class="flex-1 h-1.5 rounded-full overflow-hidden" style="background:#F2EFEA;">
                  <view
                    class="h-full rounded-full"
                    :style="'width:' + Math.round((pc.completedLessons / pc.totalLessons) * 100) + '%'"
                    style="background:linear-gradient(90deg, #C41E3A, #E74C3C);"
                  />
                </view>
                <text class="text-[10px] flex-shrink-0" style="color:#BBB;">{{ Math.round((pc.completedLessons / pc.totalLessons) * 100) }}%</text>
              </view>
              <!-- 计划日 -->
              <view class="flex gap-1 mt-1.5">
                <view
                  v-for="(l, i) in WEEK_LABELS"
                  :key="i"
                  class="text-[9px] w-4 h-4 rounded flex items-center justify-center font-medium"
                  :class="pc.scheduledDays.includes(i) ? 'bg-[#C41E3A] text-white' : 'bg-[#F2EFEA] text-[#CCC]'"
                >{{ l }}</view>
              </view>
            </view>
            <!-- 删除 -->
            <text class="text-sm px-1" style="color:#DDD;" @click="removeCourse(pc.id)">🗑</text>
          </view>
        </view>
      </view>

      <!-- 底部提示 -->
      <view class="mt-2 mb-8 text-center">
        <text class="text-xs" style="color:#BBB;">从</text>
        <text class="text-xs font-medium mx-1" style="color:#C41E3A;" @click="goAddCourse">课程广场</text>
        <text class="text-xs" style="color:#BBB;">添加更多课程到学习计划</text>
      </view>
    </view>

    <!-- 目标编辑弹窗 -->
    <view v-if="showGoalEditor" class="fixed inset-0 z-50 flex items-end">
      <view class="absolute inset-0" style="background:rgba(0,0,0,0.4);" @click="showGoalEditor = false" />
      <view class="relative w-full bg-white rounded-t-2xl px-4 pt-4 pb-8">
        <view class="flex items-center justify-between mb-4">
          <text class="text-base font-bold" style="color:#2C2C2C;">设置学习目标</text>
          <text class="text-base" style="color:#999;" @click="showGoalEditor = false">✕</text>
        </view>
        <!-- 每周天数 -->
        <view class="mb-4">
          <text class="text-sm mb-2 block" style="color:#666;">每周学习天数</text>
          <view class="flex gap-2">
            <view
              v-for="d in [1,2,3,4,5,6,7]"
              :key="d"
              class="flex-1 py-2.5 rounded-xl text-sm font-bold text-center transition-all"
              :class="editDays === d ? 'bg-[#C41E3A] text-white' : 'bg-[#F2EFEA] text-[#666]'"
              :style="editDays === d ? 'box-shadow:0 4px 12px rgba(196,30,58,0.3);' : ''"
              @click="editDays = d"
            >{{ d }}</view>
          </view>
        </view>
        <!-- 每日时长 -->
        <view class="mb-6">
          <text class="text-sm mb-2 block" style="color:#666;">每日学习时长</text>
          <view class="flex flex-wrap gap-2">
            <view
              v-for="m in minuteOptions"
              :key="m"
              class="px-4 py-2 rounded-xl text-sm font-bold transition-all"
              :class="editMinutes === m ? 'bg-[#C41E3A] text-white' : 'bg-[#F2EFEA] text-[#666]'"
              :style="editMinutes === m ? 'box-shadow:0 4px 12px rgba(196,30,58,0.3);' : ''"
              @click="editMinutes = m"
            >{{ m >= 60 ? (m / 60) + '小时' : m + '分钟' }}</view>
          </view>
        </view>
        <view
          class="w-full py-3.5 text-white font-bold rounded-xl text-center text-base"
          style="background:linear-gradient(90deg, #C41E3A, #E74C3C);box-shadow:0 4px 16px rgba(196,30,58,0.35);"
          @click="saveGoal"
        >保存目标</view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

interface StudyGoal { daysPerWeek: number; minutesPerDay: number }
interface PlannedCourse {
  id: string; courseId: string; title: string; cover: string
  totalLessons: number; completedLessons: number
  scheduledDays: number[]; order: number
}
interface DailyTask {
  id: string; courseId: string; title: string; lessonTitle: string
  duration: number; isDone: boolean; date: string
}

const MOCK_GOAL: StudyGoal = { daysPerWeek: 5, minutesPerDay: 30 }

const MOCK_COURSES: PlannedCourse[] = [
  { id: 'pc1', courseId: 'c1', title: '八字命理入门精讲', cover: '', totalLessons: 32, completedLessons: 12, scheduledDays: [1, 3, 5], order: 0 },
  { id: 'pc2', courseId: 'c2', title: '紫微斗数基础课', cover: '', totalLessons: 24, completedLessons: 6, scheduledDays: [2, 4], order: 1 },
  { id: 'pc3', courseId: 'c3', title: '周易易经入门', cover: '', totalLessons: 18, completedLessons: 0, scheduledDays: [6], order: 2 },
]

const WEEK_LABELS = ['日', '一', '二', '三', '四', '五', '六']
const TODAY = new Date()
const todayStr = TODAY.toISOString().slice(0, 10)
const todayDay = TODAY.getDay()
const minuteOptions = [15, 20, 30, 45, 60, 90, 120]

const todayDisplay = TODAY.toLocaleDateString('zh-CN', {
  month: 'long', day: 'numeric', weekday: 'long'
})

// 生成打卡数据
function generateCheckInData(): Record<string, number> {
  const data: Record<string, number> = {}
  for (let i = 0; i < 30; i++) {
    const date = new Date(TODAY)
    date.setDate(date.getDate() - i)
    const dateStr = date.toISOString().slice(0, 10)
    const rand = Math.random()
    if (rand > 0.3) data[dateStr] = rand > 0.8 ? 3 : rand > 0.6 ? 2 : 1
  }
  return data
}

function generateWeeks(): Date[][] {
  const weeks: Date[][] = []
  const startDate = new Date(TODAY)
  startDate.setDate(startDate.getDate() - 27)
  startDate.setDate(startDate.getDate() - startDate.getDay())
  for (let w = 0; w < 4; w++) {
    const week: Date[] = []
    for (let d = 0; d < 7; d++) {
      const date = new Date(startDate)
      date.setDate(date.getDate() + w * 7 + d)
      week.push(date)
    }
    weeks.push(week)
  }
  return weeks
}

function getMonthLabel(week: Date[]): number {
  return week[0] ? week[0].getMonth() + 1 : 1
}

function generateTasksFromCourses(courses: PlannedCourse[]): DailyTask[] {
  return courses
    .filter(c => c.scheduledDays.includes(todayDay))
    .map(c => ({
      id: `task-${c.courseId}`,
      courseId: c.courseId,
      title: c.title,
      lessonTitle: `第 ${c.completedLessons + 1} 课`,
      duration: 30,
      isDone: false,
      date: todayStr,
    }))
}

const weeks = generateWeeks()
const MOCK_CHECKIN_DATA = generateCheckInData()

// 从 localStorage 读取或使用 mock
const goal = ref<StudyGoal>(loadFromStorage('study_goal', MOCK_GOAL))
const plannedCourses = ref<PlannedCourse[]>(loadFromStorage('study_courses', MOCK_COURSES))
const tasks = ref<DailyTask[]>(loadFromStorage('study_tasks_' + todayStr, generateTasksFromCourses(plannedCourses.value)))

const showGoalEditor = ref(false)
const editDays = ref(goal.value.daysPerWeek)
const editMinutes = ref(goal.value.minutesPerDay)
const streak = ref(7)

function loadFromStorage<T>(key: string, fallback: T): T {
  try {
    const saved = uni.getStorageSync(key)
    if (saved) return JSON.parse(saved) as T
  } catch {}
  return fallback
}

function saveToStorage(key: string, data: unknown) {
  try { uni.setStorageSync(key, JSON.stringify(data)) } catch {}
}

// 计算属性
const doneCount = computed(() => tasks.value.filter(t => t.isDone).length)
const totalPlanMinutes = computed(() => tasks.value.reduce((s, t) => s + t.duration, 0))
const doneMinutes = computed(() => tasks.value.filter(t => t.isDone).reduce((s, t) => s + t.duration, 0))
const totalCheckinDays = computed(() => Object.values(MOCK_CHECKIN_DATA).filter(v => v > 0).length)

function getDateColor(dateStr: string): string {
  const level = MOCK_CHECKIN_DATA[dateStr] || 0
  const date = new Date(dateStr)
  if (date > TODAY) return ''
  switch (level) {
    case 0: return 'bg-[#F2EFEA]'
    case 1: return 'bg-[#FFE5E5]'
    case 2: return 'bg-[#FF9999]'
    case 3: return 'bg-[#C41E3A]'
    default: return 'bg-[#F2EFEA]'
  }
}

function openGoalEditor() {
  editDays.value = goal.value.daysPerWeek
  editMinutes.value = goal.value.minutesPerDay
  showGoalEditor.value = true
}

function saveGoal() {
  goal.value = { daysPerWeek: editDays.value, minutesPerDay: editMinutes.value }
  saveToStorage('study_goal', goal.value)
  showGoalEditor.value = false
}

function toggleTask(id: string) {
  const task = tasks.value.find(t => t.id === id)
  if (task) {
    task.isDone = !task.isDone
    saveToStorage('study_tasks_' + todayStr, tasks.value)
  }
}

function removeCourse(id: string) {
  plannedCourses.value = plannedCourses.value.filter(c => c.id !== id)
  saveToStorage('study_courses', plannedCourses.value)
  // 重新生成任务
  tasks.value = generateTasksFromCourses(plannedCourses.value)
  saveToStorage('study_tasks_' + todayStr, tasks.value)
}

function moveCourse(idx: number, direction: number) {
  const newIdx = idx + direction
  if (newIdx < 0 || newIdx >= plannedCourses.value.length) return
  const arr = [...plannedCourses.value]
  const [item] = arr.splice(idx, 1)
  arr.splice(newIdx, 0, item)
  plannedCourses.value = arr.map((c, i) => ({ ...c, order: i }))
  saveToStorage('study_courses', plannedCourses.value)
  tasks.value = generateTasksFromCourses(plannedCourses.value)
  saveToStorage('study_tasks_' + todayStr, tasks.value)
}

function goBack() { uni.navigateBack() }

function goAddCourse() {
  uni.navigateTo({ url: '/pages/courses-list/index' })
}
</script>

<style scoped>
.line-through {
  text-decoration: line-through;
}
</style>
