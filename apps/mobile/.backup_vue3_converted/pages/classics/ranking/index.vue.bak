            </view>
            <text class="text-xs font-semibold text-[#2C2C2C] block truncate">{{ sortedBooks[1].title }}</text>
            <text class="text-[10px] text-[#999] block">{{ sortedBooks[1].author }}</text>
            <text class="text-[10px] text-[#C41E3A]">🔥 {{ sortedBooks[1].heat }}</text>
          </view>
          <!-- 第1名 -->
          <view class="flex-1 bg-white rounded-xl p-4 border-2 border-yellow-300 text-center -mt-2 shadow-lg" @click="goDetail(sortedBooks[0].id)">
            <text class="text-2xl block mb-1">🥇</text>
            <view class="w-14 h-14 rounded-full bg-gradient-to-br from-yellow-400 to-yellow-600 flex items-center justify-center text-white mx-auto mb-1 shadow-md">
              <text class="text-xl">{{ sortedBooks[0].title[0] }}</text>
            </view>
            <text class="text-sm font-bold text-[#2C2C2C] block truncate">{{ sortedBooks[0].title }}</text>
            <text class="text-xs text-[#999] block">{{ sortedBooks[0].author }}</text>
            <view class="flex items-center justify-center gap-1 mt-1">
              <text class="text-xs font-bold text-yellow-600">{{ sortedBooks[0].rating }}</text>
              <text class="text-[10px] text-[#999]">🔥 {{ sortedBooks[0].heat }}</text>
            </view>
          </view>
          <!-- 第3名 -->
          <view class="flex-1 bg-white rounded-xl p-3 border border-[#E8E0D5] text-center" @click="goDetail(sortedBooks[2].id)">
            <text class="text-lg block mb-1">🥉</text>
            <view class="w-12 h-12 rounded-full bg-gradient-to-br from-amber-600 to-amber-700 flex items-center justify-center text-white mx-auto mb-1">
              <text class="text-lg">{{ sortedBooks[2].title[0] }}</text>
            </view>
            <text class="text-xs font-semibold text-[#2C2C2C] block truncate">{{ sortedBooks[2].title }}</text>
            <text class="text-[10px] text-[#999] block">{{ sortedBooks[2].author }}</text>
            <text class="text-[10px] text-[#C41E3A]">🔥 {{ sortedBooks[2].heat }}</text>
          </view>
        </view>

        <!-- 排行表格 -->
        <view class="rounded-xl overflow-hidden border border-[#E8E0D5] bg-white divide-y divide-[#E8E0D5]">
          <view v-for="(book, index) in sortedBooks.slice(3)" :key="book.rank"
            class="flex items-center gap-3 py-3 px-3 hover:bg-[#F0EBE5]/30 transition-colors"
            @click="goDetail(book.id)">
            <text :class="getRankClass(index + 4)" class="w-7 text-center font-black text-sm flex-shrink-0">
              {{ index + 4 }}
            </text>
            <view class="w-10 h-14 rounded bg-[#F5F1EB] flex items-center justify-center text-lg flex-shrink-0">
              <text>{{ book.icon }}</text>
            </view>
            <view class="flex-1 min-w-0">
              <text class="text-sm font-semibold text-[#2C2C2C] block truncate">{{ book.title }}</text>
              <text class="text-xs text-[#999] mt-0.5 block">{{ book.author }}·{{ book.dynasty }}</text>
              <view class="flex items-center gap-2 mt-1">
                <text class="text-[10px] bg-[#C41E3A]/10 text-[#C41E3A] px-1.5 py-0.5 rounded-full">{{ book.category }}</text>
                <text class="text-[10px] text-[#999] flex items-center gap-0.5">⭐ {{ book.rating }}</text>
              </view>
            </view>
            <view class="text-right flex-shrink-0">
              <text class="text-xs font-semibold text-[#C41E3A] block">{{ book.heatLabel }}</text>
              <text class="text-[10px] text-[#999]">{{ book.viewsLabel }}</text>
            </view>
          </view>
        </view>

        <!-- 排行榜说明 -->
        <view class="mt-4 p-3 bg-[#FFF8E1] rounded-xl border border-yellow-200">
          <view class="flex items-start gap-2">
            <text class="text-sm flex-shrink-0">📊</text>
            <view>
              <text class="text-xs font-medium text-[#2C2C2C] block">排行说明</text>
              <text class="text-[10px] text-[#999] block mt-0.5">热度值综合计算阅读量、收藏量、评论量和分享量，每日更新一次。</text>
            </view>
          </view>
        </view>

        <view class="h-6" />
      </scroll-view>
    </template>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

const loading = ref(true)
const rankType = ref<'hot' | 'rating' | 'new'>('hot')
const activeTime = ref('week')

const rankTabs = [
  { key: 'hot', label: '热度榜', icon: '🔥' },
  { key: 'rating', label: '评分榜', icon: '⭐' },
  { key: 'new', label: '新书上榜', icon: '📖' },
]

const timeRange = [
  { key: 'week', label: '本周' },
  { key: 'month', label: '本月' },
  { key: 'total', label: '总榜' },
]

interface RankBook {
  id: string
  rank: number
  title: string
  author: string
  dynasty: string
  icon: string
  category: string
  views: number
  viewsLabel: string
  rating: number
  heat: number
  heatLabel: string
  type: string
}

// eslint-disable-next-line @typescript-eslint/no-explicit-any
const allBooks = ref([
  { id: '1', rank: 1, title: '周易', author: '伏羲、周文王', dynasty: '先秦', icon: '☯️', category: '易经', views: 1285000, viewsLabel: '128.5万', rating: 4.9, heat: 98600, heatLabel: '9.9万', type: 'hot' },
  { id: '2', rank: 2, title: '道德经', author: '老子', dynasty: '先秦', icon: '🌀', category: '道家', views: 986000, viewsLabel: '98.6万', rating: 4.9, heat: 85400, heatLabel: '8.5万', type: 'hot' },
  { id: '3', rank: 3, title: '史记', author: '司马迁', dynasty: '西汉', icon: '📜', category: '史部', views: 863000, viewsLabel: '86.3万', rating: 4.8, heat: 72100, heatLabel: '7.2万', type: 'hot' },
  { id: '4', rank: 4, title: '诗经', author: '佚名', dynasty: '周', icon: '🌸', category: '诗歌', views: 754000, viewsLabel: '75.4万', rating: 4.8, heat: 65800, heatLabel: '6.6万', type: 'hot' },
  { id: '5', rank: 5, title: '孙子兵法', author: '孙武', dynasty: '先秦', icon: '⚔️', category: '兵家', views: 685000, viewsLabel: '68.5万', rating: 4.9, heat: 58900, heatLabel: '5.9万', type: 'hot' },
  { id: '6', rank: 6, title: '黄帝内经', author: '佚名', dynasty: '先秦', icon: '🏥', category: '医家', views: 546000, viewsLabel: '54.6万', rating: 4.7, heat: 47800, heatLabel: '4.8万', type: 'hot' },
  { id: '7', rank: 7, title: '资治通鉴', author: '司马光', dynasty: '北宋', icon: '📚', category: '史部', views: 482000, viewsLabel: '48.2万', rating: 4.8, heat: 43500, heatLabel: '4.4万', type: 'hot' },
  { id: '8', rank: 8, title: '庄子', author: '庄子', dynasty: '先秦', icon: '🦋', category: '道家', views: 438000, viewsLabel: '43.8万', rating: 4.7, heat: 38900, heatLabel: '3.9万', type: 'hot' },
  { id: '9', rank: 9, title: '楚辞', author: '屈原', dynasty: '先秦', icon: '🌀', category: '集部', views: 396000, viewsLabel: '39.6万', rating: 4.7, heat: 34600, heatLabel: '3.5万', type: 'hot' },
  { id: '10', rank: 10, title: '论语', author: '孔子弟子', dynasty: '先秦', icon: '📖', category: '经部', views: 342000, viewsLabel: '34.2万', rating: 4.8, heat: 31200, heatLabel: '3.1万', type: 'hot' },
  // 评分榜
  { id: '11', rank: 1, title: '周易', author: '伏羲、周文王', dynasty: '先秦', icon: '☯️', category: '易经', views: 1285000, viewsLabel: '128.5万', rating: 4.9, heat: 98600, heatLabel: '9.9万', type: 'rating' },
  { id: '12', rank: 2, title: '道德经', author: '老子', dynasty: '先秦', icon: '🌀', category: '道家', views: 986000, viewsLabel: '98.6万', rating: 4.9, heat: 85400, heatLabel: '8.5万', type: 'rating' },
  { id: '13', rank: 3, title: '孙子兵法', author: '孙武', dynasty: '先秦', icon: '⚔️', category: '兵家', views: 685000, viewsLabel: '68.5万', rating: 4.9, heat: 58900, heatLabel: '5.9万', type: 'rating' },
  { id: '14', rank: 4, title: '史记', author: '司马迁', dynasty: '西汉', icon: '📜', category: '史部', views: 863000, viewsLabel: '86.3万', rating: 4.8, heat: 72100, heatLabel: '7.2万', type: 'rating' },
  { id: '15', rank: 5, title: '诗经', author: '佚名', dynasty: '周', icon: '🌸', category: '诗歌', views: 754000, viewsLabel: '75.4万', rating: 4.8, heat: 65800, heatLabel: '6.6万', type: 'rating' },
  { id: '16', rank: 6, title: '资治通鉴', author: '司马光', dynasty: '北宋', icon: '📚', category: '史部', views: 482000, viewsLabel: '48.2万', rating: 4.8, heat: 43500, heatLabel: '4.4万', type: 'rating' },
  { id: '17', rank: 7, title: '论语', author: '孔子弟子', dynasty: '先秦', icon: '📖', category: '经部', views: 342000, viewsLabel: '34.2万', rating: 4.8, heat: 31200, heatLabel: '3.1万', type: 'rating' },
  { id: '18', rank: 8, title: '黄帝内经', author: '佚名', dynasty: '先秦', icon: '🏥', category: '医家', views: 546000, viewsLabel: '54.6万', rating: 4.7, heat: 47800, heatLabel: '4.8万', type: 'rating' },
  { id: '19', rank: 9, title: '庄子', author: '庄子', dynasty: '先秦', icon: '🦋', category: '道家', views: 438000, viewsLabel: '43.8万', rating: 4.7, heat: 38900, heatLabel: '3.9万', type: 'rating' },
  { id: '20', rank: 10, title: '楚辞', author: '屈原', dynasty: '先秦', icon: '🌀', category: '集部', views: 396000, viewsLabel: '39.6万', rating: 4.7, heat: 34600, heatLabel: '3.5万', type: 'rating' },
  // 新书榜
  { id: '21', rank: 1, title: '帛书老子校注', author: '高明撰', dynasty: '现代', icon: '📖', category: '出土文献', views: 124000, viewsLabel: '12.4万', rating: 4.9, heat: 23400, heatLabel: '2.3万', type: 'new' },
  { id: '22', rank: 2, title: '清华简研究', author: '李学勤', dynasty: '现代', icon: '📜', category: '简帛学', views: 98000, viewsLabel: '9.8万', rating: 4.8, heat: 19800, heatLabel: '2.0万', type: 'new' },
  { id: '23', rank: 3, title: '郭店楚简校释', author: '刘钊', dynasty: '现代', icon: '📚', category: '出土文献', views: 86000, viewsLabel: '8.6万', rating: 4.8, heat: 17600, heatLabel: '1.8万', type: 'new' },
  { id: '24', rank: 4, title: '诗经名物新证', author: '扬之水', dynasty: '现代', icon: '🌸', category: '诗经研究', views: 75000, viewsLabel: '7.5万', rating: 4.7, heat: 15400, heatLabel: '1.5万', type: 'new' },
  { id: '25', rank: 5, title: '周易程氏传', author: '程颐', dynasty: '宋', icon: '☯️', category: '易学', views: 68000, viewsLabel: '6.8万', rating: 4.8, heat: 14300, heatLabel: '1.4万', type: 'new' },
  { id: '26', rank: 6, title: '近思录集注', author: '朱熹', dynasty: '南宋', icon: '📝', category: '理学', views: 62000, viewsLabel: '6.2万', rating: 4.7, heat: 12800, heatLabel: '1.3万', type: 'new' },
])

const sortedBooks = computed(() => {
  const filtered = allBooks.value.filter(b => {
    if (rankType.value === 'hot') return b.type === 'hot'
    if (rankType.value === 'rating') return b.type === 'rating'
    return b.type === 'new'
  })
  return filtered.sort((a, b) => {
    if (rankType.value === 'rating') return b.rating - a.rating
    if (rankType.value === 'new') return b.heat - a.heat
    return b.heat - a.heat
  })
})

onMounted(() => {
  setTimeout(() => { loading.value = false }, 400)
})

function goBack() { uni.navigateBack() }
function goDetail(id: string) { uni.navigateTo({ url: `/pages/classics/detail/index?id=${id}` }) }
function shareRanking() { uni.showToast({ title: '已复制排行榜链接', icon: 'success' }) }

function getRankClass(rank: number) {
  if (rank === 1) return 'text-yellow-500'
  if (rank === 2) return 'text-gray-400'
  if (rank === 3) return 'text-amber-600'
  return 'text-[#999]'
}
</script>

