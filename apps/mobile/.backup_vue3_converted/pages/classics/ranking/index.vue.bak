<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 骨架屏 -->
    <template v-if="loading">
      <view class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5] flex items-center px-4 h-12 gap-3">
        <view class="w-7 h-7 bg-gray-200 rounded" />
        <view class="w-20 h-4 bg-gray-200 rounded" />
      </view>
      <view class="flex gap-2 px-4 pt-4 pb-3">
        <view v-for="i in 3" :key="i" class="h-8 w-16 bg-gray-200 rounded-full" />
      </view>
      <view class="flex gap-2 px-4 pb-4">
        <view v-for="i in 3" :key="i" class="h-7 w-14 bg-gray-200 rounded-full" />
      </view>
      <view class="mx-4 rounded-xl overflow-hidden border border-[#E8E0D5] bg-white">
        <view v-for="i in 5" :key="i" class="flex items-center gap-3 p-3 border-b border-[#E8E0D5] last:border-b-0">
          <view class="w-7 h-5 bg-gray-200 rounded" />
          <view class="w-10 h-14 bg-gray-200 rounded" />
          <view class="flex-1">
            <view class="w-32 h-4 bg-gray-200 rounded mb-1" />
            <view class="w-24 h-3 bg-gray-200 rounded" />
          </view>
        </view>
      </view>
    </template>

    <template v-else>
      <!-- 顶部导航 -->
      <view class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5] flex items-center px-4 h-12 gap-3">
        <view @click="goBack">
          <text class="text-[#2C2C2C] text-lg">←</text>
        </view>
        <text class="text-base font-semibold text-[#2C2C2C] flex items-center gap-2">
          <text class="text-[#C41E3A]">📈</text>古籍排行榜
        </text>
        <view @click="shareRanking" class="ml-auto p-1">
          <text class="text-lg text-[#C41E3A]">📤</text>
        </view>
      </view>

      <!-- 排行分类Tab -->
      <view class="flex gap-2 px-4 pt-3 pb-2 overflow-x-auto bg-[#FAF8F5] border-b border-[#E8E0D5]">
        <view v-for="t in rankTabs" :key="t.key" @click="rankType = t.key"
          :class="rankType === t.key ? 'bg-[#C41E3A] text-white' : 'bg-[#F0EBE5] text-[#2C2C2C]'"
          class="px-3.5 py-1.5 rounded-full text-sm font-medium flex items-center gap-1 transition-colors whitespace-nowrap">
          <text>{{ t.icon }}</text>
          <text>{{ t.label }}</text>
        </view>
      </view>

      <!-- 时间范围筛选 -->
      <view class="flex gap-2 px-4 pt-2 pb-2 border-b border-[#E8E0D5] bg-[#FAF8F5]">
        <view v-for="t in timeRange" :key="t.key" @click="activeTime = t.key"
          class="px-3 py-1 rounded-full text-xs font-medium transition-colors"
          :class="activeTime === t.key ? 'bg-[#C41E3A]/10 text-[#C41E3A]' : 'text-[#999]'">
          {{ t.label }}
        </view>
      </view>

      <!-- 排行榜 -->
      <scroll-view scroll-y class="flex-1 px-4 pt-3 pb-6" style="height: calc(100vh - 160px);">
        <!-- Top 3 特殊展示 -->
        <view v-if="sortedBooks.length >= 3" class="flex items-end gap-3 mb-4">
          <!-- 第2名 -->
          <view class="flex-1 bg-white rounded-xl p-3 border border-[#E8E0D5] text-center" @click="goDetail(sortedBooks[1].id)">
