<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <header class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5] flex items-center px-4 h-12 gap-3">
      <view @click="goBack">
        <text class="text-[#2C2C2C] text-lg">←</text>
      </view>
      <text class="text-base font-semibold text-[#2C2C2C] flex-1">书单推荐</text>
      <view class="flex items-center gap-1 text-xs text-[#C41E3A] font-medium">
        <text class="text-sm">+</text>
        <text>创建书单</text>
      </view>
    </header>

    <!-- 书单列表 -->
    <view class="px-4 pb-20 space-y-4 pt-4">
      <view v-for="list in lists" :key="list.id" class="bg-white border border-[#E8E0D5] rounded-xl overflow-hidden">
        <view class="flex gap-3 p-4">
          <image :src="list.cover" mode="aspectFill" class="w-20 h-24 object-cover rounded-lg flex-shrink-0" />
          <view class="flex-1 min-w-0">
            <text class="text-sm font-semibold text-[#2C2C2C] block">{{ list.title }}</text>
            <text class="text-xs text-[#999] block mt-0.5">@{{ list.author }} · {{ list.bookCount }} 本书</text>
            <text class="text-xs text-[#999] block mt-1.5 line-clamp-2 leading-relaxed">{{ list.desc }}</text>
            <view class="flex flex-wrap gap-1 mt-2">
              <text v-for="tag in list.tags" :key="tag" class="text-[10px] bg-[#F0EBE5] text-[#999] px-1.5 py-0.5 rounded-full">{{ tag }}</text>
            </view>
          </view>
        </view>
        <view class="flex items-center gap-3 px-4 py-2 border-t border-[#E8E0D5]">
          <view @click="toggleLike(list.id)" class="flex items-center gap-1 text-xs text-[#999]">
            <text :class="list.liked ? 'text-red-500' : ''">{{ list.liked ? '❤️' : '🤍' }}</text>
            <text>{{ list.likes.toLocaleString() }}</text>
          </view>
          <view class="flex items-center gap-1 text-xs text-[#999]">
            <text>📤</text>
            <text>分享</text>
          </view>
          <view @click="goDetail(list.id)" class="ml-auto flex items-center gap-0.5 text-xs text-[#C41E3A] font-medium">
            <text>查看书单</text>
            <text class="text-sm">›</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref } from 'vue'

interface BookList {
  id: string
  title: string
  author: string
  cover: string
  bookCount: number
  likes: number
  desc: string
  tags: string[]
  liked: boolean
}

const bookLists: BookList[] = [
  { id: '1', title: '命理入门必读书单', author: '周易大师', cover: 'https://images.unsplash.com/photo-1457369804613-52c61a468e7d?w=120', bookCount: 12, likes: 3420, desc: '从零开始学命理，精选入门到进阶书目', tags: ['命理', '八字', '入门'], liked: true },
  { id: '2', title: '风水经典传世之作', author: '王德华', cover: 'https://images.unsplash.com/photo-1462275646964-a0e3386b89fa?w=120', bookCount: 8, likes: 2156, desc: '风水学不可不读的经典著作精选', tags: ['风水', '堪舆'], liked: false },
  { id: '3', title: '易经原典研读书单', author: '李玄机', cover: 'https://images.unsplash.com/photo-1419242902214-272b3f66ee7a?w=120', bookCount: 6, likes: 1843, desc: '系统研读易经原典的推荐书目', tags: ['易经', '原典'], liked: false },
  { id: '4', title: '国学文化综合推荐', author: '儒布官方', cover: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=120', bookCount: 20, likes: 5678, desc: '国学文化爱好者必读的综合书单', tags: ['国学', '文化'], liked: true },
  { id: '5', title: '诗词古籍鉴赏入门', author: '陈梅花', cover: 'https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=120', bookCount: 10, likes: 1320, desc: '诗词古籍赏析与学习的推荐阅读路径', tags: ['诗词', '古籍'], liked: false },
]

const lists = ref<BookList[]>([...bookLists])

function toggleLike(id: string) {
  lists.value = lists.value.map(l =>
    l.id === id ? { ...l, liked: !l.liked, likes: l.liked ? l.likes - 1 : l.likes + 1 } : l
  )
}

function goBack() { uni.navigateBack() }
function goDetail(id: string) { uni.navigateTo({ url: `/pages/classics/lists/detail/index?id=${id}` }) }
</script>

<style scoped>
.line-clamp-1 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}
.line-clamp-2 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
</style>
