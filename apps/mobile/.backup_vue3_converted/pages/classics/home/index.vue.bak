  { id: "2", title: "道德经", author: "老子", dynasty: "春秋", description: "道法自然，无为而治。", reads: 145600, rating: 4.9, hasAI: true, hasTranslation: true, isFree: true, isFinePrint: true, coverColor: "brown" },
  { id: "3", title: "滴天髓", author: "刘基", dynasty: "明", description: "八字命理经典，字字珠玑。", reads: 86200, rating: 4.8, hasAI: true, hasTranslation: true, isFree: false, isFinePrint: false, coverColor: "gray" },
