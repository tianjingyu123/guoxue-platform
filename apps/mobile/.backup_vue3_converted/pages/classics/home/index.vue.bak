  { id: "6", title: "文选编珠", author: "佚名", dynasty: "唐", desc: "总集类·文选精粹", category: "wenji" },
  { id: "7", title: "备急千金要方", author: "孙思邈", dynasty: "唐", desc: "中医·千金医方", category: "zhongyi" },
  { id: "8", title: "道德经", author: "老子", dynasty: "春秋", desc: "道教·道法自然", category: "daojia" },
]

const audioBooks: AudioBook[] = [
  { id: "1", title: "金瓶梅", narrator: "专业主播", desc: "兰陵笑笑生的《金瓶梅》是明代四大奇书之首..." },
  { id: "2", title: "养鱼经", narrator: "古籍朗读", desc: "古人养鱼智慧，实用至今仍具启发" },
