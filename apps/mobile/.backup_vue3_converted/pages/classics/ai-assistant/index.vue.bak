<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-50 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 h-14">
        <view @click="goBack" class="w-9 h-9 rounded-full bg-[#F5F1EB]/80 flex items-center justify-center">
          <text class="text-base text-[#2C2C2C]">←</text>
        </view>
        <view class="text-center">
          <text class="font-medium text-base text-[#2C2C2C] block">古籍AI助手</text>
          <text class="text-[10px] text-[#999] block">内容由AI生成</text>
        </view>
        <view @click="showHistory = true" class="w-9 h-9 rounded-full bg-[#F5F1EB]/80 flex items-center justify-center">
          <text class="text-base">🕐</text>
        </view>
      </view>
    </view>

    <!-- 对话区域 -->
    <scroll-view scroll-y class="flex-1" :scroll-into-view="scrollToId" scroll-with-animation>
      <!-- 空状态 -->
      <view v-if="messages.length === 0" class="p-4 space-y-4">
        <!-- 最近AI回复示例 -->
        <view class="bg-white rounded-2xl p-4 border border-[#E8E0D5]/60">
          <text class="text-sm leading-relaxed text-[#2C2C2C] block">
            刃"的高超创作技艺——全书虽完全以虚构笔法展开，却做到了数万字内容境界不重复、主旨不偏离，兼具可读性与思想启发性，进一步印证了本篇对《西游记》艺术价值的评价。
          </text>
          <view class="flex items-center gap-1 mt-3 pt-3 border-t border-[#E8E0D5]/50">
            <text class="p-1.5 rounded-md text-[#999] text-sm">🔄</text>
            <text class="p-1.5 rounded-md text-[#999] text-sm">👍</text>
            <text class="p-1.5 rounded-md text-[#999] text-sm">👎</text>
            <text class="p-1.5 rounded-md text-[#999] text-sm">📋</text>
          </view>
        </view>

        <!-- 相关问题 -->
        <view class="space-y-2">
          <view
            v-for="(q, i) in relatedQuestions"
            :key="i"
            @click="handleQuestionClick(q)"
            class="w-full text-left px-4 py-3 rounded-xl bg-white border border-[#E8E0D5]/60 text-sm text-[#2C2C2C] leading-relaxed"
          >
            <text>{{ q }}</text>
          </view>
        </view>

        <!-- 分隔线 -->
        <view class="flex items-center gap-3 py-2">
          <view class="flex-1 border-t border-[#E8E0D5]/50" />
          <text class="text-xs text-[#999]">聊聊新话题</text>
          <view class="flex-1 border-t border-[#E8E0D5]/50" />
        </view>

        <!-- AI介绍卡片 -->
        <view class="bg-gradient-to-br from-violet-50 to-purple-50 rounded-2xl p-4 border border-purple-200/50">
          <view class="flex items-center gap-2 mb-2">
            <view class="w-8 h-8 rounded-full bg-gradient-to-br from-violet-500 to-purple-600 flex items-center justify-center">
              <text class="text-white text-sm">✨</text>
            </view>
            <text class="font-medium text-sm text-violet-900">AI古籍助手</text>
          </view>
          <text class="text-xs text-[#999] leading-relaxed block">
            我是您的AI古籍助手，可以帮您解释古籍内容、分析文本含义、回答相关问题。无论是经典还是冷门古籍，我都能帮您深入理解。
          </text>
        </view>

        <!-- 快捷问题 -->
        <view class="space-y-2">
          <view
            v-for="(q, i) in suggestedQuestions"
            :key="i"
            @click="handleQuestionClick(q)"
            class="w-full text-left px-4 py-3 rounded-xl bg-[#F5F1EB]/50 text-sm text-[#999]"
          >
            <text>{{ q }}</text>
          </view>
        </view>
      </view>

      <!-- 对话消息 -->
      <view v-else class="p-4 space-y-4">
        <view
          v-for="message in messages"
          :key="message.id"
          :class="['flex', message.role === 'user' ? 'justify-end' : 'gap-3']"
        >
          <!-- AI头像 -->
          <view v-if="message.role === 'assistant'" class="w-8 h-8 rounded-full bg-gradient-to-br from-violet-500 to-purple-600 flex items-center justify-center flex-shrink-0">
            <text class="text-white text-sm">✨</text>
          </view>

          <view :class="['max-w-[85%]', message.role === 'user' ? 'bg-[#C41E3A] text-white rounded-2xl rounded-tr-sm px-4 py-3' : 'flex-1 min-w-0']">
            <!-- 用户消息 -->
            <view v-if="message.role === 'user'">
              <text class="text-sm leading-relaxed block">{{ message.content }}</text>
            </view>
            <!-- AI消息 -->
            <view v-else>
              <view class="bg-white rounded-2xl rounded-tl-sm p-4 border border-[#E8E0D5]/60">
                <text class="text-sm leading-relaxed whitespace-pre-wrap block">{{ message.content }}</text>
              </view>
              <!-- 操作按钮 -->
              <view class="flex items-center gap-1 mt-2 ml-1">
                <text class="p-1.5 rounded-md text-[#999] text-sm">🔄</text>
                <text
                  @click="handleLike(message.id, true)"
                  :class="['p-1.5 rounded-md text-sm transition-colors', liked[message.id] === true ? 'text-green-500' : 'text-[#999]']"
                >👍</text>
                <text
                  @click="handleLike(message.id, false)"
                  :class="['p-1.5 rounded-md text-sm transition-colors', liked[message.id] === false ? 'text-red-500' : 'text-[#999]']"
                >👎</text>
                <text @click="handleCopy(message.content)" class="p-1.5 rounded-md text-[#999] text-sm">📋</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 加载状态 -->
        <view v-if="isLoading" class="flex gap-3">
          <view class="w-8 h-8 rounded-full bg-gradient-to-br from-violet-500 to-purple-600 flex items-center justify-center flex-shrink-0">
            <text class="text-white text-sm">✨</text>
          </view>
          <view class="bg-white rounded-2xl rounded-tl-sm p-4 border border-[#E8E0D5]/60">
            <view class="flex items-center gap-2">
              <view class="flex gap-1">
                <view class="w-2 h-2 bg-purple-500 rounded-full animate-bounce-1" />
                <view class="w-2 h-2 bg-purple-500 rounded-full animate-bounce-2" />
                <view class="w-2 h-2 bg-purple-500 rounded-full animate-bounce-3" />
              </view>
              <text class="text-sm text-[#999]">正在思考...</text>
            </view>
          </view>
        </view>

        <view id="msg-end" />
      </view>
    </scroll-view>

    <!-- 底部输入框 -->
    <view class="sticky bottom-0 bg-white border-t border-[#E8E0D5] p-3" style="padding-bottom: calc(12px + env(safe-area-inset-bottom))">
      <view class="flex items-end gap-2">
        <view class="flex-1 relative">
          <textarea
            v-model="inputValue"
            placeholder="输入和古籍相关的问题"
            :disabled="isLoading"
            class="w-full resize-none rounded-2xl bg-[#F5F1EB]/50 border border-[#E8E0D5]/60 px-4 py-2.5 pr-10 text-sm placeholder:text-[#999] outline-none disabled:opacity-50"
            style="min-height: 42px; max-height: 128px;"
            @confirm="handleSend"
            @keydown="handleKeydown"
          />
          <text class="absolute right-3 bottom-2.5 text-[#999] text-base">🎤</text>
        </view>
        <view
          @click="handleSend"
          :class="['w-10 h-10 rounded-full flex items-center justify-center bg-gradient-to-r from-violet-500 to-purple-600', (isLoading || !inputValue.trim()) ? 'opacity-50' : '']"
        >
          <text class="text-white text-base">📨</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, nextTick } from 'vue'

interface Message {
  id: string
  role: 'user' | 'assistant'
  content: string
  timestamp: Date
}

const suggestedQuestions = [
  '请总结本文的主要内容？',
  '针对本文可以提出哪些研究问题？',
  '古籍中有哪些和本文相关的论述？',
]

const relatedQuestions = [
  "《李卓吾先生批评西游记》甲本卷首题辞中提到的'魔非他，即我也'这一观点，在明代其他《西游记》评点本中是否有类似表述？",
  "《李卓吾先生批评西游记》另一刊本卷首题辞补充的对后世模拟创作的批评，具体涉及哪些明代文人的作品？",
  "《李卓吾先生批评西游记》乙本题辞中的文字异文（如'引而伸之'写为'多而伸之'），在其他明代通俗文学刊本中是否常见？",
]

const messages = ref<Message[]>([])
const inputValue = ref('')
const isLoading = ref(false)
const liked = ref<Record<string, boolean | null>>({})
const showHistory = ref(false)
const scrollToId = ref('')

function generateAIResponse(question: string): string {
  if (question.includes('主要内容') || question.includes('总结')) {
    return '《周易》是中国古代哲学的重要经典，主要包含以下核心内容：\n\n1. **卦象系统**：由八卦（乾、坤、震、巽、坎、离、艮、兑）演化为六十四卦，每卦由六个爻组成。\n\n2. **阴阳哲学**：以阴阳二元对立统一的思想解释宇宙万物的变化规律。\n\n3. **占卜方法**：通过蓍草或铜钱等工具，按特定程序得出卦象，用于预测吉凶。\n\n4. **人生智慧**：蕴含修身、齐家、治国的哲理，如\'天行健，君子以自强不息\'等名言。'
  }
  if (question.includes('研究问题')) {
    return '针对《周易》可以提出以下研究问题：\n\n1. 《周易》的成书年代和作者问题，伏羲画卦、文王演易、孔子作传的传说是否有历史依据？\n\n2. 《周易》与西方占星术、塔罗牌等预测体系在方法论上的异同比较。\n\n3. 《周易》的数学结构——64卦与二进制的关系是否体现了古人对数学的深刻理解？\n\n4. 《周易》在中医、风水、命理等领域的应用发展史研究。'
  }
  return '感谢您的提问。根据古籍记载和学术研究，这是一个非常值得深入探讨的话题。《周易》作为群经之首，其思想内涵极为丰富，涵盖了宇宙观、人生观、方法论等多个层面。\n\n如需了解更具体的内容，您可以进一步询问特定的卦象解读、历史背景或哲学意义等方面。'
}

function handleSend() {
  if (!inputValue.value.trim() || isLoading.value) return
  const userMessage: Message = {
    id: Date.now().toString(),
    role: 'user',
    content: inputValue.value.trim(),
    timestamp: new Date(),
  }
  messages.value = [...messages.value, userMessage]
  inputValue.value = ''
  isLoading.value = true

  setTimeout(() => {
    const aiMessage: Message = {
      id: (Date.now() + 1).toString(),
      role: 'assistant',
      content: generateAIResponse(userMessage.content),
      timestamp: new Date(),
    }
    messages.value = [...messages.value, aiMessage]
    isLoading.value = false
    nextTick(() => { scrollToId.value = 'msg-end' })
  }, 1500)
}

function handleKeydown(e: any) {
  // 支持回车发送（不包含shift+回车）
  if (e.keyCode === 13 && !e.shiftKey) {
    e.preventDefault?.()
    handleSend()
  }
}

function handleQuestionClick(question: string) {
  inputValue.value = question
}

function handleCopy(content: string) {
  uni.setClipboardData({
    data: content,
    success: () => uni.showToast({ title: '已复制', icon: 'none' }),
  })
}

function handleLike(messageId: string, isLike: boolean) {
  liked.value = { ...liked.value, [messageId]: isLike }
}

function goBack() { uni.navigateBack() }
</script>

<style scoped>
.animate-bounce-1,
.animate-bounce-2,
.animate-bounce-3 {
  animation: bounce 1.4s infinite ease-in-out both;
}
.animate-bounce-1 { animation-delay: 0s; }
.animate-bounce-2 { animation-delay: 0.16s; }
.animate-bounce-3 { animation-delay: 0.32s; }
@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}
</style>
