<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-24">
    <!-- 顶部导航 -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-white/95 border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between h-12 px-4">
        <view @click="goBack" class="p-2 -ml-2">
          <text class="text-xl text-[#2C2C2C]">←</text>
        </view>
        <text class="font-semibold text-base text-[#2C2C2C]">实名认证</text>
        <view class="w-9" />
