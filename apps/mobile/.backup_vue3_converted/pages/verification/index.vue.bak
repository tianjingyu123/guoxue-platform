    </header>

    <!-- 已认证状态 -->
    <view v-if="status==='approved'" class="pt-16 pb-8 px-4">
      <view class="flex flex-col items-center py-12">
        <view class="w-20 h-20 rounded-full flex items-center justify-center mb-4" style="background-color:rgba(34,197,94,0.1)">
          <text class="text-2xl text-green-500">✓</text>
        </view>
        <text class="text-xl font-semibold text-[#2C2C2C] mb-2" style="display:block">已完成实名认证</text>
        <text class="text-sm text-[#999] mb-6" style="display:block">你已通过平台实名认证</text>

        <view class="w-full p-4 bg-white rounded-xl">
          <view class="space-y-3">
            <view class="flex items-center justify-between">
              <text class="text-sm text-[#999]">认证姓名</text>
              <text class="text-sm text-[#2C2C2C]">{{verificationInfo.approved.realName}}</text>
            </view>
            <view class="flex items-center justify-between">
              <text class="text-sm text-[#999]">认证时间</text>
              <text class="text-sm text-[#2C2C2C]">{{verificationInfo.approved.verifyTime}}</text>
            </view>
            <view class="flex items-center justify-between">
              <text class="text-sm text-[#999]">认证状态</text>
              <text class="text-xs px-2 py-0.5 rounded" style="background-color:rgba(34,197,94,0.1);color:rgb(34,197,94)">已认证</text>
            </view>
          </view>
        </view>

        <view class="mt-8 p-4 rounded-xl w-full" style="background-color:rgba(245,241,235,0.5)">
          <view class="flex items-start gap-3">
            <text class="text-lg text-[#C9A96E] mt-0.5">🛡</text>
            <view>
              <text class="text-sm text-[#2C2C2C] font-medium" style="display:block">信息安全保障</text>
              <text class="text-xs text-[#999] mt-1" style="display:block">你的实名信息已加密存储，仅用于身份验证，不会泄露给第三方。</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 审核中状态 -->
    <view v-else-if="status==='pending'" class="pt-16 pb-8 px-4">
      <view class="flex flex-col items-center py-12">
        <view class="w-20 h-20 rounded-full flex items-center justify-center mb-4" style="background-color:rgba(245,158,11,0.1)">
          <text class="text-2xl text-amber-500">🕐</text>
        </view>
        <text class="text-xl font-semibold text-[#2C2C2C] mb-2" style="display:block">审核中</text>
        <text class="text-sm text-[#999] mb-6" style="display:block">你的实名认证申请正在审核中</text>

        <view class="w-full p-4 bg-white rounded-xl">
          <view class="space-y-3">
            <view class="flex items-center justify-between">
              <text class="text-sm text-[#999]">提交时间</text>
              <text class="text-sm text-[#2C2C2C]">{{verificationInfo.pending.submitTime}}</text>
            </view>
            <view class="flex items-center justify-between">
              <text class="text-sm text-[#999]">预计审核</text>
              <text class="text-sm text-[#2C2C2C]">{{verificationInfo.pending.expectedTime}}</text>
            </view>
            <view class="flex items-center justify-between">
              <text class="text-sm text-[#999]">当前状态</text>
              <text class="text-xs px-2 py-0.5 rounded" style="background-color:rgba(245,158,11,0.1);color:rgb(245,158,11)">审核中</text>
            </view>
          </view>
        </view>

        <view class="mt-8 p-4 rounded-xl w-full" style="background-color:rgba(245,241,235,0.5)">
          <text class="text-sm text-[#999] text-center" style="display:block">审核结果将通过消息通知你，请耐心等待</text>
        </view>
      </view>
    </view>

    <!-- 认证失败状态 -->
    <view v-else-if="status==='rejected'" class="pt-16 pb-8 px-4">
      <view class="flex flex-col items-center py-12">
        <view class="w-20 h-20 rounded-full flex items-center justify-center mb-4" style="background-color:rgba(239,68,68,0.1)">
          <text class="text-2xl text-red-500">✕</text>
        </view>
        <text class="text-xl font-semibold text-[#2C2C2C] mb-2" style="display:block">认证失败</text>
        <text class="text-sm text-[#999] mb-6" style="display:block">很抱歉，你的实名认证未通过</text>

        <view class="w-full p-4 bg-white rounded-xl">
          <view class="space-y-3">
            <view class="flex items-center justify-between">
              <text class="text-sm text-[#999]">审核时间</text>
              <text class="text-sm text-[#2C2C2C]">{{verificationInfo.rejected.rejectTime}}</text>
            </view>
            <view class="flex items-center justify-between">
              <text class="text-sm text-[#999]">当前状态</text>
              <text class="text-xs px-2 py-0.5 rounded" style="background-color:rgba(239,68,68,0.1);color:rgb(239,68,68)">未通过</text>
            </view>
          </view>
          <view class="mt-4 pt-4 border-t border-[#E8E0D5]">
            <text class="text-sm text-[#999]" style="display:block">失败原因：</text>
            <text class="text-sm text-red-500 mt-1" style="display:block">{{verificationInfo.rejected.reason}}</text>
          </view>
        </view>

        <view @click="status='none'" class="mt-8 w-full py-3 bg-[#C41E3A] text-white rounded-xl font-medium text-center">
          <text>重新认证</text>
        </view>
      </view>
    </view>

    <!-- 未认证状态 - 填写表单 -->
    <view v-else class="pt-16 px-4">
      <!-- 认证须知 -->
      <view class="p-4 rounded-xl mb-6" style="background-color:rgba(245,158,11,0.05);border:1rpx solid rgba(245,158,11,0.2)">
        <view class="flex items-start gap-3">
          <text class="text-lg text-amber-500 mt-0.5" style="flex-shrink:0">🛡</text>
          <view>
            <text class="text-sm text-[#2C2C2C] font-medium mb-2" style="display:block">认证须知</text>
            <text class="text-xs text-[#999]" style="line-height:1.5;display:block">根据相关法律法规及平台规则，部分功能（成为圈主、站长提现等）需实名认证后才可使用。</text>
            <view class="flex items-center gap-1.5 mt-3">
              <text class="text-sm text-[#C9A96E]">🔒</text>
              <text class="text-xs text-[#C9A96E]">你的个人信息仅用于身份验证，我们将严格加密保护</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 信息填写区 -->
      <view class="space-y-4 mb-6">
        <text class="text-sm font-medium text-[#2C2C2C]" style="display:block">基本信息</text>

        <view>
          <text class="text-xs text-[#999] mb-1.5" style="display:block">真实姓名</text>
          <input
            type="text"
            :value="realName"
            @input="e => realName=e.detail.value"
            placeholder="请输入身份证上的姓名"
            class="w-full h-12 px-4 text-sm rounded-xl"
            style="background-color:#F5F1EB;color:#2C2C2C;outline:none"
          />
        </view>

        <view>
          <text class="text-xs text-[#999] mb-1.5" style="display:block">身份证号</text>
          <input
            type="text"
            :value="idNumber"
            @input="e => idNumber=e.detail.value.replace(/[^0-9Xx]/g,'').slice(0,18)"
            placeholder="请输入18位身份证号码"
            class="w-full h-12 px-4 text-sm rounded-xl"
            style="background-color:#F5F1EB;color:#2C2C2C;outline:none"
          />
          <text v-if="idNumber && idNumber.length!==18" class="text-xs text-red-500 mt-1" style="display:block">请输入正确的18位身份证号</text>
        </view>
      </view>

      <!-- 证件照片上传区 -->
      <view class="space-y-4 mb-6">
        <text class="text-sm font-medium text-[#2C2C2C]" style="display:block">证件照片</text>
        <text class="text-xs text-[#999]" style="display:block">请确保证件照片清晰、完整，四角齐全</text>

        <view class="grid grid-cols-2 gap-4" style="display:flex;gap:16rpx">
          <!-- 人像面 -->
          <view style="flex:1">
            <text class="text-xs text-[#999] mb-2 text-center" style="display:block;text-align:center">身份证人像面</text>
            <view v-if="frontImage" class="relative rounded-xl overflow-hidden" style="aspect-ratio:3/2;background-color:#F5F1EB">
              <view class="absolute inset-0 flex items-center justify-center">
                <view class="text-center">
                  <text class="text-2xl text-green-500 mx-auto mb-1" style="display:block">✓</text>
                  <text class="text-xs text-[#999]" style="display:block">已上传</text>
                </view>
              </view>
              <view @click="frontImage=null" class="absolute top-2 right-2 w-6 h-6 rounded-full flex items-center justify-center" style="background-color:rgba(0,0,0,0.5)">
                <text class="text-white text-xs">✕</text>
              </view>
            </view>
            <view v-else @click="handleImageUpload('front')" class="w-full rounded-xl border-2 border-dashed border-[#E8E0D5] flex flex-col items-center justify-center gap-2" style="aspect-ratio:3/2">
              <view class="w-10 h-10 rounded-full flex items-center justify-center" style="background-color:#F5F1EB">
                <text class="text-sm text-[#999]">📷</text>
              </view>
              <text class="text-xs text-[#999]">点击上传</text>
            </view>
          </view>

          <!-- 国徽面 -->
          <view style="flex:1">
            <text class="text-xs text-[#999] mb-2 text-center" style="display:block;text-align:center">身份证国徽面</text>
            <view v-if="backImage" class="relative rounded-xl overflow-hidden" style="aspect-ratio:3/2;background-color:#F5F1EB">
              <view class="absolute inset-0 flex items-center justify-center">
                <view class="text-center">
                  <text class="text-2xl text-green-500 mx-auto mb-1" style="display:block">✓</text>
                  <text class="text-xs text-[#999]" style="display:block">已上传</text>
                </view>
              </view>
              <view @click="backImage=null" class="absolute top-2 right-2 w-6 h-6 rounded-full flex items-center justify-center" style="background-color:rgba(0,0,0,0.5)">
                <text class="text-white text-xs">✕</text>
              </view>
            </view>
            <view v-else @click="handleImageUpload('back')" class="w-full rounded-xl border-2 border-dashed border-[#E8E0D5] flex flex-col items-center justify-center gap-2" style="aspect-ratio:3/2">
              <view class="w-10 h-10 rounded-full flex items-center justify-center" style="background-color:#F5F1EB">
                <text class="text-sm text-[#999]">📷</text>
              </view>
              <text class="text-xs text-[#999]">点击上传</text>
            </view>
          </view>
        </view>

        <!-- 拍摄提示 -->
        <view class="p-3 rounded-xl" style="background-color:rgba(245,241,235,0.5)">
          <view class="flex items-start gap-2">
            <text class="text-sm text-[#999] mt-0.5">📤</text>
            <view class="text-xs text-[#999] space-y-1">
              <text style="display:block">拍摄提示：</text>
              <view class="space-y-0.5 pl-1">
                <text style="display:block">• 请确保证件边框完整，字迹清晰可辨</text>
                <text style="display:block">• 避免反光、遮挡或模糊</text>
                <text style="display:block">• 支持JPG、PNG格式，单张不超过5MB</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 隐私声明 -->
      <text class="text-xs text-[#999] text-center mb-4" style="display:block;text-align:center">
        提交即表示你同意
        <text class="text-[#C41E3A]" @click="navigateTo('/pages/policy/type-detail/index?type=privacy-policy')">《隐私政策》</text>
        和
        <text class="text-[#C41E3A]" @click="navigateTo('/pages/policy/type-detail/index?type=user-agreement')">《用户协议》</text>
      </text>
    </view>

    <!-- 底部操作栏（仅未认证时显示） -->
    <view v-if="status==='none'" class="fixed bottom-0 left-0 right-0 p-4 bg-white/95 border-t border-[#E8E0D5]" style="backdrop-filter:blur(12px)">
      <view @click="handleSubmit" :class="'w-full py-3.5 rounded-xl font-medium text-center transition-all ' + (canSubmit && !isSubmitting ? 'bg-[#C41E3A] text-white' : 'bg-[#F5F1EB] text-[#999]')">
        <text v-if="isSubmitting" class="flex items-center justify-center gap-2">
          <text class="animate-spin">⏳</text>
          提交中...
        </text>
        <text v-else>提交审核</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

type VerificationStatus = "none" | "pending" | "approved" | "rejected"

const status = ref<VerificationStatus>("none")
const realName = ref("")
const idNumber = ref("")
const frontImage = ref<string | null>(null)
const backImage = ref<string | null>(null)
const isSubmitting = ref(false)

const verificationInfo = {
  pending: { submitTime: "2024-01-15 14:30", expectedTime: "1-3个工作日" },
  approved: { verifyTime: "2024-01-16 10:00", realName: "张**" },
  rejected: { reason: "身份证照片模糊，请重新上传清晰照片", rejectTime: "2024-01-16 09:00" },
}

const canSubmit = computed(() => realName.value.length >= 2 && idNumber.value.length === 18 && frontImage.value && backImage.value)

function handleImageUpload(type: "front" | "back") {
  if (type === "front") {
    frontImage.value = "/placeholder-id-front.jpg"
  } else {
    backImage.value = "/placeholder-id-back.jpg"
  }
  uni.showToast({ title: '上传成功(Mock)', icon: 'none' })
}

function handleSubmit() {
  if (!canSubmit.value) return
  isSubmitting.value = true
  setTimeout(() => {
    isSubmitting.value = false
    status.value = "pending"
    uni.showToast({ title: '提交成功', icon: 'success' })
  }, 1500)
}

function navigateTo(url: string) {
  uni.navigateTo({ url })
}

function goBack() {
  uni.navigateBack()
}
</script>

<style scoped>
/* 焦点样式 */
input:focus {
  border: 1px solid #C41E3A !important;
  box-shadow: 0 0 0 2px rgba(196, 30, 58, 0.1);
  outline: none;
}
</style>
