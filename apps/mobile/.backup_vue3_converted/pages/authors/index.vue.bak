<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 加载骨架屏 -->
    <view v-if="loading" class="p-4 space-y-4">
      <view class="h-12 bg-[#F0EBE5] rounded-lg" />
      <view class="h-10 bg-[#F0EBE5] rounded-lg" />
      <view v-for="i in 4" :key="i" class="h-24 bg-[#F0EBE5] rounded-xl" />
    </view>

    <template v-else>
      <!-- 顶部导航 -->
      <view class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5] flex items-center px-4 h-12 gap-3">
        <view @click="goBack">
          <text class="text-xl text-[#2C2C2C] leading-none">←</text>
        </view>
        <text class="text-base font-semibold text-[#2C2C2C]">作者列表</text>
      </view>

      <!-- 搜索栏 -->
      <view class="px-4 pt-3 pb-2">
        <view class="flex items-center gap-2 px-3 h-10 bg-white border border-[#E8E0D5] rounded-lg">
          <text class="text-[#999] text-sm">🔍</text>
          <input
            v-model="searchKeyword"
            type="text"
            placeholder="搜索作者或专长"
            class="flex-1 text-sm text-[#2C2C2C] placeholder-[#ccc] outline-none"
          />
          <text v-if="searchKeyword" @click="searchKeyword = ''" class="text-[#999] text-xs">✕</text>
        </view>
      </view>

      <!-- 排序过滤 -->
      <view class="flex items-center justify-between px-4 mb-2">
        <view class="flex gap-2">
          <view
            v-for="f in filterOptions" :key="f.key"
            @click="activeFilter = f.key"
            :class="['px-3 py-1.5 rounded-full text-xs font-medium transition-colors', activeFilter === f.key ? 'bg-[#C41E3A] text-white' : 'bg-[#F0EBE5] text-[#2C2C2C]']"
          >
            <text>{{ f.label }}</text>
          </view>
        </view>
        <view class="flex gap-1">
          <text
            v-for="s in sortOptions" :key="s.key"
            @click="activeSort = s.key"
            :class="['px-2.5 py-1 rounded text-xs transition-colors', activeSort === s.key ? 'text-[#C41E3A] font-medium bg-[#C41E3A]/10' : 'text-[#999]']"
          >
            {{ s.label }}
          </text>
        </view>
      </view>

      <!-- 作者列表 -->
      <scroll-view scroll-y class="flex-1 px-4 pb-4" style="overflow-y: auto;">
        <view
          v-for="a in filteredList"
          :key="a.id"
          class="flex items-center gap-3 p-4 bg-white border border-[#E8E0D5] rounded-xl mb-3"
        >
          <!-- 头像 -->
          <view class="w-14 h-14 rounded-full flex items-center justify-center flex-shrink-0 text-white text-lg font-bold" :style="{ backgroundColor: a.color }">
            {{ a.name[0] }}
          </view>

          <!-- 信息 -->
          <view class="flex-1 min-w-0">
            <view class="flex items-center gap-1.5 mb-1">
              <text class="text-sm font-semibold text-[#2C2C2C]">{{ a.name }}</text>
              <text v-if="a.verified" class="text-[10px] px-1 bg-blue-50 text-blue-500 rounded">已认证</text>
              <text v-if="a.badge" class="text-[10px] px-1 bg-[#C9A96E]/10 text-[#C9A96E] rounded">{{ a.badge }}</text>
            </view>
            <text class="text-xs text-[#999] block line-clamp-1 mb-1">{{ a.bio }}</text>
            <view class="flex items-center gap-3 text-[11px] text-[#999]">
              <text class="flex items-center gap-0.5">
                <text>📚</text>{{ a.works }} 作品
              </text>
              <text class="flex items-center gap-0.5">
                <text>👥</text>{{ a.fans.toLocaleString() }} 粉丝
              </text>
              <text v-if="a.avgRating" class="flex items-center gap-0.5">
                <text>⭐</text>{{ a.avgRating }}
              </text>
            </view>
          </view>

          <!-- 关注按钮 -->
          <view
            class="px-3 py-1.5 rounded-full text-xs font-medium transition-colors"
            :class="a.followed ? 'bg-[#C41E3A] text-white' : 'bg-[#F0EBE5] text-[#2C2C2C]'"
            @click.stop="toggleFollow(a)"
          >
            <text>{{ a.followed ? '已关注' : '关注' }}</text>
          </view>
        </view>

        <!-- 空状态 -->
        <view v-if="filteredList.length === 0" class="flex flex-col items-center justify-center py-20">
          <text class="text-5xl mb-4">📝</text>
          <text class="text-sm text-[#999]">暂无匹配的作者</text>
        </view>
      </scroll-view>
    </template>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

const loading = ref(true)

onMounted(() => {
  setTimeout(() => { loading.value = false }, 500)
})

interface Author {
  id: string
  name: string
  bio: string
  works: number
  fans: number
  avgRating?: string
  verified: boolean
  badge?: string
  followed: boolean
  color: string
}

const authors: Author[] = [
  { id: '1', name: '周易大师', bio: '国学传承人，专注易学二十载，出版多部易学著作，培养学员逾万人。', works: 128, fans: 12345, avgRating: '4.9', verified: true, badge: '金牌讲师', followed: true, color: '#C41E3A' },
  { id: '2', name: '张玄风', bio: '紫微斗数研究者，精通紫微斗数与八字命理，实战经验丰富。', works: 56, fans: 8765, avgRating: '4.8', verified: true, badge: '资深命理师', followed: false, color: '#C9A96E' },
  { id: '3', name: '李玄机', bio: '易经文化推广者，易学协会理事，《易经新解》作者。', works: 89, fans: 12340, avgRating: '4.7', verified: true, badge: '易学专家', followed: false, color: '#2C2C2C' },
  { id: '4', name: '王德华', bio: '风水大师，杨公风水传人，服务过数百家企业风水布局。', works: 45, fans: 6780, avgRating: '4.9', verified: true, badge: '风水名家', followed: false, color: '#8B4513' },
  { id: '5', name: '林奇门', bio: '奇门遁甲专家，太乙神数传承人，精通奇门预测与决策。', works: 67, fans: 5432, avgRating: '4.6', verified: true, followed: false, color: '#4A6741' },
  { id: '6', name: '赵六爻', bio: '六爻预测名师，梅花易数高手，擅长占卜决策。', works: 34, fans: 3456, avgRating: '4.5', verified: false, followed: false, color: '#7B68EE' },
  { id: '7', name: '陈紫微', bio: '紫微斗数青年学者，创新性地将紫微与心理学结合。', works: 23, fans: 2345, avgRating: '4.4', verified: false, followed: false, color: '#D2691E' },
  { id: '8', name: '刘太乙', bio: '太乙神数传承人，研究数术文化三十年。', works: 78, fans: 4567, avgRating: '4.8', verified: true, badge: '数术大师', followed: false, color: '#1E90FF' },
]

const searchKeyword = ref('')
const activeFilter = ref('all')
const activeSort = ref('fans')

const filterOptions = [
  { key: 'all', label: '全部' },
  { key: 'verified', label: '已认证' },
  { key: 'highRated', label: '高评分' },
]

const sortOptions = [
  { key: 'fans', label: '按粉丝' },
  { key: 'works', label: '按作品' },
]

const filteredList = computed(() => {
  let list = [...authors]

  // 搜索过滤
  if (searchKeyword.value) {
    const kw = searchKeyword.value.toLowerCase()
    list = list.filter(a =>
      a.name.toLowerCase().includes(kw) ||
      a.bio.toLowerCase().includes(kw)
    )
  }

  // 分类过滤
  if (activeFilter.value === 'verified') {
    list = list.filter(a => a.verified)
  } else if (activeFilter.value === 'highRated') {
    list = list.filter(a => parseFloat(a.avgRating || '0') >= 4.7)
  }

  // 排序
  if (activeSort.value === 'fans') {
    list.sort((a, b) => b.fans - a.fans)
  } else if (activeSort.value === 'works') {
    list.sort((a, b) => b.works - a.works)
  }

  return list
})

function goBack() { uni.navigateBack() }

function toggleFollow(a: Author) {
  a.followed = !a.followed
  uni.showToast({ title: a.followed ? '已关注 ' + a.name : '已取消关注', icon: 'success' })
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
