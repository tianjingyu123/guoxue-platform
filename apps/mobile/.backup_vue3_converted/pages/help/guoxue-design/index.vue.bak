<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-40 bg-white border-b border-[#E8E0D5] px-4 py-3 flex items-center gap-3">
      <view class="p-1" @click="goBack">
        <text class="text-lg">←</text>
      </view>
      <text class="font-semibold">国学风格设计演示</text>
    </view>

    <view class="p-4 space-y-6">
      <!-- 空状态演示 -->
      <view class="bg-white rounded-xl overflow-hidden border border-[#E8E0D5]">
        <view class="px-4 py-3 border-b border-[#E8E0D5] bg-[#F2EFEA]/30">
          <text class="font-medium block">空状态组件</text>
          <text class="text-xs text-[#999]">展示国学韵味的空状态文案和视觉</text>
        </view>

        <!-- 类型选择 -->
        <view class="p-4 border-b border-[#E8E0D5]">
          <view class="flex flex-wrap gap-2">
            <view
              v-for="type in emptyStateTypes"
              :key="type"
              class="px-3 py-1.5 text-xs rounded-full"
              :class="activeEmptyState === type ? 'bg-[#C41E3A] text-white' : 'border border-[#E8E0D5] text-[#2C2C2C]'"
              @click="activeEmptyState = type"
            >
              <text>{{ type }}</text>
            </view>
          </view>
        </view>

        <!-- 空状态展示 -->
        <view class="bg-[#FAF8F5] py-12 flex flex-col items-center justify-center">
          <text class="text-5xl mb-4">📭</text>
          <text class="text-sm text-[#2C2C2C] font-medium">暂无{{ activeEmptyState }}相关内容</text>
          <text class="text-xs text-[#999] mt-1">当前类型：{{ activeEmptyState }}</text>
        </view>
      </view>

      <!-- 反馈组件演示 -->
      <view class="bg-white rounded-xl overflow-hidden border border-[#E8E0D5]">
        <view class="px-4 py-3 border-b border-[#E8E0D5] bg-[#F2EFEA]/30">
          <text class="font-medium block">状态反馈组件</text>
          <text class="text-xs text-[#999]">印章风格的成功/错误/警告反馈</text>
        </view>

        <view class="p-4 space-y-4">
          <!-- 印章反馈 -->
          <view>
            <text class="text-sm font-medium mb-2 block">印章反馈</text>
            <view class="flex flex-wrap gap-2">
              <view class="px-4 py-2 bg-green-500 text-white text-sm rounded-lg" @click="showSealSuccess = true">
                <text>成功印章</text>
              </view>
              <view class="px-4 py-2 bg-red-500 text-white text-sm rounded-lg" @click="showSealError = true">
                <text>错误印章</text>
              </view>
              <view class="px-4 py-2 bg-amber-500 text-white text-sm rounded-lg" @click="showSealWarning = true">
                <text>警告印章</text>
              </view>
            </view>
          </view>

          <!-- Toast反馈 -->
          <view>
            <text class="text-sm font-medium mb-2 block">Toast反馈</text>
            <view class="flex flex-wrap gap-2">
              <view class="px-3 py-1.5 border border-[#E8E0D5] rounded-lg text-xs" @click="toastType = 'success'; showToast = true">
                <text>成功Toast</text>
              </view>
              <view class="px-3 py-1.5 border border-[#E8E0D5] rounded-lg text-xs" @click="toastType = 'error'; showToast = true">
                <text>错误Toast</text>
              </view>
              <view class="px-3 py-1.5 border border-[#E8E0D5] rounded-lg text-xs" @click="toastType = 'warning'; showToast = true">
                <text>警告Toast</text>
              </view>
              <view class="px-3 py-1.5 border border-[#E8E0D5] rounded-lg text-xs" @click="toastType = 'info'; showToast = true">
                <text>信息Toast</text>
              </view>
            </view>
          </view>

          <!-- 仪式感确认 -->
          <view>
            <text class="text-sm font-medium mb-2 block">仪式感确认弹窗</text>
            <view class="flex flex-wrap gap-2">
              <view class="px-3 py-1.5 border border-[#E8E0D5] rounded-lg text-xs" @click="confirmType = 'join'; showConfirm = true">
                <text>加入确认</text>
              </view>
              <view class="px-3 py-1.5 border border-[#E8E0D5] rounded-lg text-xs" @click="confirmType = 'complete'; showConfirm = true">
                <text>完成确认</text>
              </view>
              <view class="px-3 py-1.5 border border-[#E8E0D5] rounded-lg text-xs" @click="confirmType = 'unlock'; showConfirm = true">
                <text>解锁确认</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 加载动画演示 -->
      <view class="bg-white rounded-xl overflow-hidden border border-[#E8E0D5]">
        <view class="px-4 py-3 border-b border-[#E8E0D5] bg-[#F2EFEA]/30">
          <text class="font-medium block">加载动画</text>
          <text class="text-xs text-[#999]">太极旋转和多种加载形态</text>
        </view>

        <view class="p-6 space-y-6">
          <!-- 太极Loader组件 -->
          <view>
            <text class="text-sm font-medium mb-4 block">太极加载器</text>
            <view class="grid grid-cols-4 gap-4">
              <view v-for="size in ['sm', 'md', 'lg', 'xl']" :key="size" class="flex flex-col items-center gap-2">
                <view class="w-8 h-8 rounded-full border-2 border-[#C41E3A] border-t-transparent animate-spin" :class="{ 'w-6 h-6': size === 'sm', 'w-10 h-10': size === 'lg', 'w-12 h-12': size === 'xl' }" />
                <text class="text-xs text-[#999]">{{ size === 'sm' ? '小' : size === 'md' ? '中' : size === 'lg' ? '大' : '特大' }}</text>
              </view>
            </view>
          </view>

          <!-- 内联加载 -->
          <view>
            <text class="text-sm font-medium mb-2 block">内联加载</text>
            <view class="flex items-center gap-2">
              <view class="w-4 h-4 rounded-full border-2 border-[#C41E3A] border-t-transparent animate-spin" />
              <text class="text-xs text-[#999]">加载中...</text>
            </view>
          </view>

          <!-- 特色加载动画 -->
          <view>
            <text class="text-sm font-medium mb-4 block">特色加载动画</text>
            <view class="grid grid-cols-2 gap-6">
              <view class="flex flex-col items-center gap-2">
                <view class="w-16 h-16 rounded-full border-4 border-[#2C2C2C] border-t-transparent animate-spin flex items-center justify-center">
                  <text class="text-sm">☯</text>
                </view>
                <text class="text-xs text-[#999]">太极加载中...</text>
              </view>
              <view class="flex flex-col items-center gap-2">
                <view class="w-12 h-2 bg-[#2C2C2C] rounded animate-pulse" />
                <text class="text-xs text-[#999]">毛笔加载中...</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 文案库展示 -->
      <view class="bg-white rounded-xl overflow-hidden border border-[#E8E0D5]">
        <view class="px-4 py-3 border-b border-[#E8E0D5] bg-[#F2EFEA]/30">
          <text class="font-medium block">国学文案库</text>
          <text class="text-xs text-[#999]">引经据典的文案体系</text>
        </view>

        <view class="p-4 space-y-3">
          <view v-for="item in copywritingItems" :key="item.label" class="p-3 bg-[#F2EFEA]/30 rounded-lg">
            <text class="text-xs text-[#999] mb-1 block">{{ item.label }}</text>
            <text class="text-sm font-serif">{{ item.content }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 印章反馈弹窗 - 成功 -->
    <view v-if="showSealSuccess" class="fixed inset-0 z-50 flex items-center justify-center">
      <view class="absolute inset-0 bg-black/40" @click="showSealSuccess = false" />
      <view class="relative bg-white rounded-2xl p-8 flex flex-col items-center">
        <view class="w-20 h-20 rounded-full bg-green-500 flex items-center justify-center mb-4">
          <text class="text-white text-3xl">✓</text>
        </view>
        <text class="text-lg font-bold text-green-500">操作成功</text>
      </view>
    </view>

    <!-- 印章反馈弹窗 - 错误 -->
    <view v-if="showSealError" class="fixed inset-0 z-50 flex items-center justify-center">
      <view class="absolute inset-0 bg-black/40" @click="showSealError = false" />
      <view class="relative bg-white rounded-2xl p-8 flex flex-col items-center">
        <view class="w-20 h-20 rounded-full bg-red-500 flex items-center justify-center mb-4">
          <text class="text-white text-3xl">✕</text>
        </view>
        <text class="text-lg font-bold text-red-500">操作失败</text>
      </view>
    </view>

    <!-- 印章反馈弹窗 - 警告 -->
    <view v-if="showSealWarning" class="fixed inset-0 z-50 flex items-center justify-center">
      <view class="absolute inset-0 bg-black/40" @click="showSealWarning = false" />
      <view class="relative bg-white rounded-2xl p-8 flex flex-col items-center">
        <view class="w-20 h-20 rounded-full bg-amber-500 flex items-center justify-center mb-4">
          <text class="text-white text-3xl">!</text>
        </view>
        <text class="text-lg font-bold text-amber-500">请三思而行</text>
      </view>
    </view>

    <!-- Toast -->
    <view v-if="showToast" class="fixed top-20 inset-x-0 z-50 flex justify-center px-4">
      <view class="bg-[#2C2C2C] text-white px-6 py-3 rounded-full text-sm shadow-lg flex items-center gap-2">
        <text>{{ toastMessage }}</text>
      </view>
    </view>

    <!-- 仪式感确认弹窗 -->
    <view v-if="showConfirm" class="fixed inset-0 z-50 flex items-center justify-center px-6">
      <view class="absolute inset-0 bg-black/40" @click="showConfirm = false" />
      <view class="relative bg-white rounded-2xl p-6 w-full max-w-sm">
        <text class="text-lg font-bold text-[#2C2C2C] text-center block mb-2">{{ confirmTitle }}</text>
        <text class="text-sm text-[#999] text-center block mb-6">{{ confirmDescription }}</text>
        <view class="flex gap-3">
          <view class="flex-1 py-3 border border-[#E8E0D5] rounded-full text-center text-sm" @click="showConfirm = false">
            <text>取消</text>
          </view>
          <view class="flex-1 py-3 bg-[#C41E3A] text-white rounded-full text-center text-sm" @click="showConfirm = false">
            <text>{{ confirmType === 'join' ? '拜入' : '确定' }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

function goBack() { uni.navigateBack() }

const emptyStateTypes = [
  "course", "myCourse", "circle", "myCircle", "circlePost",
  "favorite", "bookmark", "message", "notification", "comment",
  "search", "order", "cart", "product", "article",
  "live", "video", "note", "question", "answer",
  "activity", "ebook", "institute", "history", "following", "follower",
  "networkError", "noPermission"
]

const copywritingItems = [
  { label: '成功反馈', content: '善哉善哉 · 已妥善收藏 · 呈文已递' },
  { label: '错误反馈', content: '事与愿违 · 山高路远，通讯受阻' },
  { label: '加载提示', content: '稍候片刻 · 正在整理卷宗 · 画卷徐徐展开' },
  { label: '成就文案', content: '初入山门 · 开卷有益 · 志同道合 · 持之以恒' },
]

const activeEmptyState = ref("course")
const showSealSuccess = ref(false)
const showSealError = ref(false)
const showSealWarning = ref(false)
const showToast = ref(false)
const toastType = ref<"success" | "error" | "info" | "warning">("success")
const showConfirm = ref(false)
const confirmType = ref<"join" | "complete" | "unlock" | "default">("join")

const toastMessage = computed(() => {
  const messages: Record<string, string> = {
    success: "善哉，操作成功",
    error: "事与愿违，请重试",
    warning: "请三思而行",
    info: "知悉",
  }
  return messages[toastType.value] || "知悉"
})

const confirmTitle = computed(() => {
  const titles: Record<string, string> = {
    join: "确认加入圈子？",
    complete: "确认完成学习？",
    unlock: "确认解锁内容？",
    default: "确认操作？",
  }
  return titles[confirmType.value] || "确认操作？"
})

const confirmDescription = computed(() => {
  const descs: Record<string, string> = {
    join: "加入后可参与圈内讨论和学习",
    complete: "完成后将获得结业证书",
    unlock: "解锁后可查看完整内容",
    default: "",
  }
  return descs[confirmType.value] || ""
})

// Auto-hide toast
let toastTimer: ReturnType<typeof setTimeout> | null = null
const stopWatch = computed(() => showToast.value)
// Simple watch using a reactive effect
import { watch } from 'vue'
watch(showToast, (val) => {
  if (val) {
    if (toastTimer) clearTimeout(toastTimer)
    toastTimer = setTimeout(() => { showToast.value = false }, 2000)
  }
})
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
