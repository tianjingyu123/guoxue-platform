<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-40 bg-white/95 backdrop-blur-lg border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 h-14">
        <view @click="goBack"><text class="text-xl text-[#2C2C2C]">←</text></view>
        <text class="font-semibold text-base text-[#2C2C2C]">公告详情</text>
        <view @click="handleShare" class="p-2 -mr-2 rounded-full">
          <text class="text-lg text-[#2C2C2C]">📤</text>
        </view>
      </view>
    </view>

    <!-- 分享提示 -->
    <view v-if="showShareTip" class="fixed top-20 left-1/2 -translate-x-1/2 z-50 px-4 py-2 bg-white border border-[#E8E0D5] rounded-lg shadow-lg">
      <text class="text-sm text-[#2C2C2C]">链接已复制，快去分享吧</text>
    </view>

    <!-- 公告内容 -->
    <main class="px-4 py-6">
      <!-- 公告标题区 -->
      <view class="mb-6">
        <view :class="['inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs mb-3', typeConfig.color]">
          <text class="text-xs">{{ typeConfig.icon }}</text>
          <text>{{ typeConfig.label }}</text>
        </view>
        <text class="text-xl font-bold text-[#2C2C2C] block leading-tight mb-3">{{ noticeData.title }}</text>
        <view class="flex items-center gap-4 text-xs text-[#999]">
          <text>{{ noticeData.publishTime }}</text>
          <text>{{ noticeData.readCount.toLocaleString() }} 人已阅读</text>
        </view>
      </view>

      <!-- 公告正文 -->
      <view class="bg-white rounded-xl p-4 mb-6">
        <view v-for="(item, index) in noticeData.content" :key="index">
          <!-- 标题 -->
          <text v-if="item.type === 'heading'" :class="['font-bold text-[#2C2C2C] mt-6 mb-3 block', item.level === 2 ? 'text-base' : 'text-sm']">
            {{ item.text }}
          </text>

          <!-- 段落 -->
          <text v-else-if="item.type === 'paragraph'" class="text-sm text-[#999] leading-relaxed mb-3 block">
            {{ item.text }}
          </text>

          <!-- 列表 -->
          <view v-else-if="item.type === 'list'" class="pl-2 mb-4 space-y-1.5">
            <text v-for="(li, liIndex) in item.items" :key="liIndex" class="text-sm text-[#999] leading-relaxed block">• {{ li }}</text>
          </view>

          <!-- 引用 -->
          <view v-else-if="item.type === 'quote'" class="border-l-3 border-[#C9A96E] pl-4 py-2 my-4 bg-[#C9A96E]/5 rounded-r-lg">
            <text class="text-sm text-[#999] italic">{{ item.text }}</text>
          </view>

          <!-- 表格 -->
          <view v-else-if="item.type === 'table'" class="overflow-x-auto my-4">
            <view class="w-full text-sm border border-[#E8E0D5] rounded-lg overflow-hidden">
              <view class="bg-[#F5F1EB] flex">
                <text v-for="(header, hIndex) in item.headers" :key="hIndex" class="flex-1 px-3 py-2 text-left font-medium text-[#2C2C2C] text-xs">{{ header }}</text>
              </view>
              <view v-for="(row, rIndex) in item.rows" :key="rIndex" class="flex border-t border-[#E8E0D5]">
                <text v-for="(cell, cIndex) in row" :key="cIndex" class="flex-1 px-3 py-2 text-[#999] text-xs">{{ cell }}</text>
              </view>
            </view>
          </view>

          <!-- 签名 -->
          <view v-else-if="item.type === 'signature'" class="text-right mt-8 mb-4">
            <text class="text-sm text-[#2C2C2C] font-medium block">{{ item.text }}</text>
            <text class="text-xs text-[#999] mt-1 block">{{ item.date }}</text>
          </view>
        </view>
      </view>

      <!-- 相关公告 -->
      <view v-if="noticeData.relatedNotices && noticeData.relatedNotices.length > 0">
        <text class="font-medium text-sm text-[#2C2C2C] mb-3 block">相关公告</text>
        <view class="bg-white rounded-xl divide-y divide-[#E8E0D5]">
          <view
            v-for="related in noticeData.relatedNotices"
            :key="related.id"
            @click="goDetail(related.id)"
            class="flex items-center gap-3 p-3"
          >
            <view :class="['w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0', getTypeConfig(related.type).color]">
              <text class="text-sm">{{ getTypeConfig(related.type).icon }}</text>
            </view>
            <text class="flex-1 text-sm text-[#2C2C2C] line-clamp-1">{{ related.title }}</text>
            <text class="text-base text-[#999] flex-shrink-0">›</text>
          </view>
        </view>
      </view>
    </main>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'
import { onLoad } from '@dcloudio/uni-app'

const noticeTypeConfig: Record<string, { label: string; icon: string; color: string }> = {
  system: { label: '系统公告', icon: '🔔', color: 'bg-blue-500/20 text-blue-400' },
  activity: { label: '活动通知', icon: '🎁', color: 'bg-[#C9A96E]/20 text-[#C9A96E]' },
  warning: { label: '重要提醒', icon: '⚠', color: 'bg-orange-500/20 text-orange-400' },
  reward: { label: '福利公告', icon: '📢', color: 'bg-[#C41E3A]/20 text-[#C41E3A]' },
}

interface ContentItem {
  type: string
  text?: string
  level?: number
  items?: string[]
  headers?: string[]
  rows?: string[][]
  date?: string
}

const noticeData = ref({
  id: 1,
  title: '关于平台会员服务升级的公告',
  type: 'system',
  publishTime: '2026-05-01 10:00',
  readCount: 12580,
  content: [
    { type: 'paragraph', text: '尊敬的热卜国学用户：' },
    { type: 'paragraph', text: '为了给您提供更优质的服务体验，平台将于2026年5月15日对会员服务进行全面升级。本次升级将带来以下变化：' },
    { type: 'heading', level: 2, text: '一、服务升级内容' },
    { type: 'list', items: [
      '排盘工具：新增紫微斗数精批功能，支持更详细的命盘分析',
      'AI智能体：升级对话模型，回复更准确、更专业',
      '课程服务：新增离线下载功能，支持无网络学习',
      '圈子功能：优化互动体验，新增语音帖功能'
    ]},
    { type: 'heading', level: 2, text: '二、会员权益调整' },
    { type: 'paragraph', text: '本次升级后，会员权益将进行优化调整：' },
    { type: 'table', headers: ['权益项目', '原权益', '升级后'], rows: [
      ['排盘次数', '每日10次', '每日20次'],
      ['AI对话', '每日50次', '每日100次'],
      ['课程折扣', '9折', '8.5折'],
      ['专属客服', '无', '7×12小时']
    ]},
    { type: 'heading', level: 2, text: '三、升级时间' },
    { type: 'paragraph', text: '升级时间：2026年5月15日 00:00 - 06:00' },
    { type: 'quote', text: '升级期间，部分服务可能暂时不可用，请您提前做好安排。给您带来的不便，敬请谅解。' },
    { type: 'heading', level: 2, text: '四、联系我们' },
    { type: 'paragraph', text: '如您有任何疑问，可通过以下方式联系我们：' },
    { type: 'list', items: [
      '在线客服：APP内「我的」-「帮助中心」-「联系客服」',
      '客服邮箱：service@rebu.com',
      '客服电话：400-888-8888（工作日 9:00-18:00）'
    ]},
    { type: 'paragraph', text: '感谢您一直以来对热卜国学的支持与信任！' },
    { type: 'signature', text: '热卜国学运营团队', date: '2026年5月1日' },
  ] as ContentItem[],
  relatedNotices: [
    { id: 2, title: '五一活动：国学币充值双倍赠送', type: 'activity' },
    { id: 3, title: '关于打击虚假宣传的声明', type: 'warning' },
  ],
})

const showShareTip = ref(false)

const typeConfig = computed(() => {
  return noticeTypeConfig[noticeData.value.type] || noticeTypeConfig.system
})

function getTypeConfig(type: string) {
  return noticeTypeConfig[type] || noticeTypeConfig.system
}

function handleShare() {
  showShareTip.value = true
  setTimeout(() => { showShareTip.value = false }, 2000)
}

function goDetail(id: number) {
  uni.navigateTo({ url: `/pages/notice/id-detail/index?id=${id}` })
}

function goBack() { uni.navigateBack() }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
