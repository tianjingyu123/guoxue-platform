<script setup lang="ts">
import { ref, onMounted } from 'vue'

const loading = ref(true)

onMounted(() => {
  setTimeout(() => { loading.value = false }, 600)
})

const showEditSheet = ref(false)

const info = ref({
  title: '八字命理入门实战',
  desc: '从零基础到精通八字命理，系统学习四柱八字理论，掌握排盘、断局、流年分析等核心技能。课程涵盖大量真实案例，手把手教你成为八字高手。',
  students: 2345,
  lessons: 36,
  rating: '4.9',
  price: '299',
  status: '已上架',
  category: '命理学',
  teacher: '周易大师',
  createdAt: '2024-01-01',
  monthlySales: 128,
  monthlyRevenue: '38,272',
  conversion: '68',
})

const chapters = [
  { id: 'c1', title: '第一章：八字基础入门', lessons: 6, duration: '4小时30分' },
  { id: 'c2', title: '第二章：天干地支详解', lessons: 8, duration: '6小时' },
  { id: 'c3', title: '第三章：排盘技法', lessons: 5, duration: '3小时45分' },
  { id: 'c4', title: '第四章：十神解析', lessons: 7, duration: '5小时15分' },
  { id: 'c5', title: '第五章：大运流年', lessons: 6, duration: '4小时' },
  { id: 'c6', title: '第六章：实战案例精讲', lessons: 4, duration: '3小时' },
]

const recentStudents = [
  { id: 's1', name: '张三丰', progress: 85, joinedAt: '2024-01-10' },
  { id: 's2', name: '李慕白', progress: 62, joinedAt: '2024-01-12' },
  { id: 's3', name: '王重阳', progress: 100, joinedAt: '2024-01-05' },
  { id: 's4', name: '赵公明', progress: 33, joinedAt: '2024-01-18' },
  { id: 's5', name: '陈抟老祖', progress: 100, joinedAt: '2024-01-03' },
]

const reviews = [
  { id: '1', name: '张同学', rating: 5, comment: '讲得非常好，深入浅出，适合零基础入门，强烈推荐！', time: '2024-01-15' },
  { id: '2', name: '李同学', rating: 4, comment: '内容充实，收获很多，案例丰富实用', time: '2024-01-14' },
  { id: '3', name: '王同学', rating: 5, comment: '老师讲解清晰，对八字有了系统的认识', time: '2024-01-12' },
]

const editForm = ref({
  title: info.value.title,
  price: info.value.price,
  desc: info.value.desc,
})

function goBack() { uni.navigateBack() }

function goReviews() {
  uni.navigateTo({ url: '/pages/manage/course/id-detail/reviews/index' })
}

function viewAllStudents() {
  uni.navigateTo({ url: `/pages/manage/course/id-detail/students/index?id=${courseId.value}` })
}

function addChapter() {
  uni.navigateTo({ url: `/pages/manage/course/id-detail/chapters/create/index?courseId=${courseId.value}` })
}

function editChapter(ch: any) {
  uni.showToast({ title: '编辑: ' + ch.title, icon: 'none' })
}

function deleteChapter(ch: any) {
  uni.showModal({
    title: '删除章节',
    content: '确定要删除「' + ch.title + '」及其所有课时吗？',
    success: (res) => {
      if (res.confirm) {
        const idx = chapters.indexOf(ch)
        if (idx > -1) chapters.splice(idx, 1)
        uni.showToast({ title: '已删除', icon: 'success' })
      }
    }
  })
}

function saveEdit() {
  info.value.title = editForm.value.title
  info.value.price = editForm.value.price
  info.value.desc = editForm.value.desc
  showEditSheet.value = false
  uni.showToast({ title: '已保存', icon: 'success' })
}
</script>

