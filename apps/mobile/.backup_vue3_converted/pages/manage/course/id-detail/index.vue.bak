              <input v-model="editForm.desc" placeholder="课程简介" class="text-sm text-[#2C2C2C] outline-none w-full" />
            </view>
          </view>
          <view @click="saveEdit" class="w-full py-3 rounded-xl bg-[#C41E3A] text-white text-sm font-medium text-center">
