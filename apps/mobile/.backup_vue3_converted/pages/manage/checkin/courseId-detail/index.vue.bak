<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-6">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-40 bg-[#FAF8F5]/95 backdrop-blur-lg border-b border-[#E8E0D5] px-4 py-3">
      <view class="flex items-center justify-between">
        <view class="flex items-center gap-3">
          <view @click="goBack" class="p-1">
            <text class="w-5 h-5 text-[#2C2C2C]" style="font-size:20px">←</text>
          </view>
          <text class="font-semibold text-base text-[#2C2C2C]">签到核销</text>
        </view>
        <view class="w-9" />
      </view>
    </view>

    <!-- 今日课程信息 -->
    <view class="px-4 py-4">
      <view class="p-4 bg-gradient-to-br from-primary/10 via-accent/5 to-background border border-primary/20 rounded-xl">
        <view class="flex items-start justify-between mb-3">
          <view>
            <text class="font-semibold text-base text-[#2C2C2C] block">{{ course.title }}</text>
            <text class="text-xs text-[#999] block mt-1">{{ course.location }}</text>
          </view>
          <text class="text-xs px-2 py-0.5 bg-[#C9A96E]/20 text-[#C9A96E] rounded">进行中</text>
        </view>
        <view class="flex items-center gap-4 text-sm">
          <view class="flex items-center gap-1.5 text-[#999]">
            <text class="text-sm">⏰</text>
            <text>{{ course.time }}</text>
          </view>
          <view class="flex items-center gap-1.5 text-[#999]">
            <text class="text-sm">👥</text>
            <text>{{ checkedInStudents.length }}/{{ course.totalEnrolled }} 已签到</text>
          </view>
        </view>
        <view class="mt-3 h-2 bg-[#F5F1EB] rounded-full overflow-hidden">
          <view class="h-full bg-[#C9A96E] rounded-full transition-all duration-500" :style="{width:checkinProgress+'%'}" />
        </view>
      </view>
    </view>

    <!-- 扫码区域 -->
    <view class="px-4 pb-4">
      <view class="bg-white border border-[#E8E0D5] rounded-xl p-6 text-center">
        <view @click="handleStartScan" :class="'relative w-48 h-48 mx-auto rounded-2xl border-2 border-dashed flex items-center justify-center mb-4 ' + (isScanning?'border-accent bg-[#C9A96E]/5':'border-[#E8E0D5] bg-[#F5F1EB]/30')">
          <view v-if="isScanning" class="flex flex-col items-center">
            <view class="w-16 h-16 border-4 border-accent border-t-transparent rounded-full animate-spin mb-3" />
            <text class="text-sm text-[#C9A96E]">扫描中...</text>
          </view>
          <view v-else class="flex flex-col items-center cursor-pointer">
            <view class="w-20 h-20 rounded-2xl bg-[#C41E3A]/10 flex items-center justify-center mb-3" style="font-size:40px">📷</view>
            <text class="text-sm text-[#999]">点击扫描学员二维码</text>
          </view>
          <view class="absolute top-0 left-0 w-6 h-6 border-t-2 border-l-2 border-accent rounded-tl-lg" />
          <view class="absolute top-0 right-0 w-6 h-6 border-t-2 border-r-2 border-accent rounded-tr-lg" />
          <view class="absolute bottom-0 left-0 w-6 h-6 border-b-2 border-l-2 border-accent rounded-bl-lg" />
          <view class="absolute bottom-0 right-0 w-6 h-6 border-b-2 border-r-2 border-accent rounded-br-lg" />
        </view>

        <!-- 手动签到入口 -->
        <text @click="showManualInput=!showManualInput" class="flex items-center gap-2 justify-center text-sm text-[#C41E3A]">
          <text>⌨</text>
          手动签到
        </text>

        <!-- 手动输入区域 -->
        <view v-if="showManualInput" class="mt-4 text-left">
          <view class="relative">
            <text class="absolute left-3 top-1/2 -translate-y-1/2 text-[#999] text-sm">🔍</text>
            <input v-model="searchQuery" @input="handleSearch" placeholder="输入学员手机号或昵称搜索"
              class="w-full h-10 pl-10 pr-4 rounded-lg border border-[#E8E0D5] bg-[#F5F1EB]/50 text-sm text-[#2C2C2C] placeholder:text-[#999] box-border" />
          </view>
          <view v-if="searchResults.length>0" class="mt-2 space-y-2">
            <view v-for="s in searchResults" :key="s.id" @click="handleManualCheckin(s)" class="flex items-center justify-between p-3 bg-white border border-[#E8E0D5] rounded-xl">
              <view class="flex items-center gap-3">
                <view class="w-10 h-10 rounded-full bg-[#F5F1EB] flex items-center justify-center text-sm text-[#2C2C2C]">{{ s.name[0] }}</view>
                <view>
                  <text class="text-sm font-medium text-[#2C2C2C] block">{{ s.name }}</text>
                  <text class="text-xs text-[#999]">{{ s.phone }}</text>
                </view>
              </view>
              <text class="px-3 py-1.5 bg-[#C41E3A] text-white text-xs rounded-full">签到</text>
            </view>
          </view>
          <text v-if="searchQuery.length>=2&&searchResults.length===0" class="mt-4 text-center text-sm text-[#999] block">未找到相关学员</text>
        </view>
      </view>
    </view>

    <!-- 签到列表 -->
    <view class="px-4 space-y-4">
      <!-- 未签到学员 -->
      <view class="bg-white border border-[#E8E0D5] rounded-xl overflow-hidden">
        <view @click="showNotCheckedIn=!showNotCheckedIn" class="flex items-center justify-between p-4">
          <view class="flex items-center gap-2">
            <text class="text-xs px-2 py-0.5 bg-orange-50 text-orange-500 border border-orange-200 rounded">未签到</text>
            <text class="text-sm text-[#999]">{{ notCheckedInStudents.length }}人</text>
          </view>
          <text class="text-[#999]">{{ showNotCheckedIn?'▲':'▼' }}</text>
        </view>
        <view v-if="showNotCheckedIn" class="border-t border-[#E8E0D5] divide-y divide-border">
          <view v-for="s in notCheckedInStudents" :key="s.id" class="flex items-center justify-between px-4 py-3">
            <view class="flex items-center gap-3">
              <view class="w-10 h-10 rounded-full bg-[#F5F1EB] flex items-center justify-center text-sm">{{ s.name[0] }}</view>
              <view>
                <text class="text-sm font-medium text-[#2C2C2C] block">{{ s.name }}</text>
                <text class="text-xs text-[#999]">{{ s.phone }}</text>
              </view>
            </view>
            <text @click="handleManualCheckin(s)" class="px-3 py-1.5 border border-primary text-[#C41E3A] text-xs rounded-full">手动签到</text>
          </view>
        </view>
      </view>

      <!-- 已签到学员 -->
      <view class="bg-white border border-[#E8E0D5] rounded-xl overflow-hidden">
        <view @click="showCheckedIn=!showCheckedIn" class="flex items-center justify-between p-4">
          <view class="flex items-center gap-2">
            <text class="text-xs px-2 py-0.5 bg-green-50 text-green-500 border border-green-200 rounded">已签到</text>
            <text class="text-sm text-[#999]">{{ checkedInStudents.length }}人</text>
          </view>
          <text class="text-[#999]">{{ showCheckedIn?'▲':'▼' }}</text>
        </view>
        <view v-if="showCheckedIn" class="border-t border-[#E8E0D5] divide-y divide-border">
          <view v-for="s in checkedInStudents" :key="s.id" class="flex items-center justify-between px-4 py-3">
            <view class="flex items-center gap-3">
              <view class="w-10 h-10 rounded-full bg-[#F5F1EB] flex items-center justify-center text-sm">{{ s.name[0] }}</view>
              <view>
                <text class="text-sm font-medium text-[#2C2C2C] block">{{ s.name }}</text>
                <text class="text-xs text-[#999]">{{ s.phone }}</text>
              </view>
            </view>
            <view class="flex items-center gap-2 text-xs text-green-500">
              <text>✅</text>
              <text>{{ s.checkTime }}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 签到确认弹窗 -->
    <view v-if="showConfirmModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60">
      <view class="w-[85%] max-w-sm bg-white rounded-2xl overflow-hidden">
        <view class="p-6 text-center">
          <view class="w-20 h-20 mx-auto mb-4 rounded-full ring-4 ring-accent/30 bg-[#F5F1EB] flex items-center justify-center text-2xl text-[#2C2C2C]">
            <text>{{ scannedStudent?.name[0] }}</text>
          </view>
          <text class="text-lg font-semibold text-[#2C2C2C] block">{{ scannedStudent?.name }}</text>
          <text class="text-sm text-[#999] block mt-1">{{ scannedStudent?.phone }}</text>
          <text class="text-xs text-[#999] block mt-2">报名时间：{{ scannedStudent?.enrollTime }}</text>
        </view>
        <view class="flex border-t border-[#E8E0D5]">
          <view @click="showConfirmModal=false" class="flex-1 py-4 text-sm text-[#999] text-center">取消</view>
          <view @click="handleConfirmCheckin" class="flex-1 py-4 text-sm font-medium text-[#C9A96E] text-center border-l border-[#E8E0D5]">确认签到</view>
        </view>
      </view>
    </view>

    <!-- 签到成功动画 -->
    <view v-if="showSuccessAnimation" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 pointer-events-none">
      <view class="w-32 h-32 rounded-full bg-green-500 flex items-center justify-center">
        <text class="text-white" style="font-size:64px">✓</text>
      </view>
    </view>
  </view>
</template>
<script setup lang="ts">
import {ref,computed} from 'vue'

interface Student{id:number;name:string;phone:string;enrollTime:string;checkedIn:boolean;checkTime:string|null}

const courseData={
  id:1,title:'八字命理入门实战班',time:'14:00 - 17:00',
  location:'热卜国学·北京朝阳驿站',totalEnrolled:28,
}
const studentsData:Student[]=[
  {id:1,name:'张三',phone:'138****1234',enrollTime:'2026-05-01 10:30',checkedIn:true,checkTime:'13:45'},
  {id:2,name:'李四',phone:'139****5678',enrollTime:'2026-05-02 14:20',checkedIn:true,checkTime:'13:50'},
  {id:3,name:'王五',phone:'137****9012',enrollTime:'2026-05-03 09:15',checkedIn:false,checkTime:null},
  {id:4,name:'赵六',phone:'136****3456',enrollTime:'2026-05-04 16:40',checkedIn:false,checkTime:null},
  {id:5,name:'钱七',phone:'135****7890',enrollTime:'2026-05-05 11:25',checkedIn:false,checkTime:null},
]

const course=ref(courseData)
const students=ref(studentsData)
const isScanning=ref(false)
const showConfirmModal=ref(false)
const showSuccessAnimation=ref(false)
const scannedStudent=ref<Student|null>(null)
const showManualInput=ref(false)
const searchQuery=ref('')
const searchResults=ref<Student[]>([])
const showCheckedIn=ref(true)
const showNotCheckedIn=ref(true)

const checkedInStudents=computed(()=>students.value.filter(s=>s.checkedIn))
const notCheckedInStudents=computed(()=>students.value.filter(s=>!s.checkedIn))
const checkinProgress=computed(()=>(checkedInStudents.value.length/course.value.totalEnrolled)*100)

const handleStartScan=()=>{
  isScanning.value=true
  setTimeout(()=>{
    const student=notCheckedInStudents.value[0]
    if(student){scannedStudent.value=student;showConfirmModal.value=true}
    isScanning.value=false
  },2000)
}

const handleConfirmCheckin=()=>{
  if(scannedStudent.value){
    const now=new Date()
    const time=`${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`
    const idx=students.value.findIndex(s=>s.id===scannedStudent.value!.id)
    if(idx>=0)students.value[idx]={...students.value[idx],checkedIn:true,checkTime:time}
    showConfirmModal.value=false
    showSuccessAnimation.value=true
    setTimeout(()=>showSuccessAnimation.value=false,1500)
  }
}

const handleSearch=(e:any)=>{
  const query=searchQuery.value
  if(query.length>=2){
    searchResults.value=notCheckedInStudents.value.filter(s=>s.name.includes(query)||s.phone.includes(query))
  }else{
    searchResults.value=[]
  }
}

const handleManualCheckin=(student:Student)=>{
  scannedStudent.value=student
  showConfirmModal.value=true
  showManualInput.value=false
  searchQuery.value=''
  searchResults.value=[]
}

function goBack(){uni.navigateBack()}
</script>
