            <view @click.stop="downloadChapter(chapter)" class="p-2 rounded-full hover:bg-[#F5F1EB] text-[#999]">
              <text>&#11015;</text>
            </view>
          </view>
        </view>

        <!-- 笔记Tab -->
        <view v-if="activeTab === 'notes'">
