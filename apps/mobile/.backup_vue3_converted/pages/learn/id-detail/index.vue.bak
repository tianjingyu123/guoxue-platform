          <!-- 笔记列表 -->
          <view v-if="courseData.notes.length > 0" class="divide-y divide-[#E8E0D5]">
            <view v-for="note in courseData.notes" :key="note.id" class="p-4">
              <view class="flex items-center gap-2 mb-2">
                <text class="text-[10px] px-1.5 py-0 rounded border border-[#E8E0D5] text-[#999]">{{ getChapterTitle(note.chapterId).slice(0, 10) }}...</text>
                <text class="text-xs text-[#C41E3A]">{{ note.time }}</text>
                <text class="text-xs text-[#999] ml-auto">{{ note.createdAt }}</text>
              </view>
              <text class="text-sm text-[#2C2C2C] block">{{ note.content }}</text>
