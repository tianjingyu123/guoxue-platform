            <view @click="goTo('/pages/course/3')" class="block mb-3">
              <view class="flex items-center gap-3 p-3 bg-white rounded-xl border border-[#E8E0D5]">
                <view class="w-14 h-14 rounded-lg bg-[#F5F1EB] flex items-center justify-center flex-shrink-0">
                  <text class="text-2xl text-[#C9A96E]">&#128214;</text>
                </view>
                <view class="flex-1 min-w-0">
                  <text class="text-sm font-medium text-[#2C2C2C] line-clamp-1">八字进阶实战课</text>
