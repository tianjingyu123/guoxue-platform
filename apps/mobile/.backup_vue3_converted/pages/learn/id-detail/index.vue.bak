            <!-- 推荐圈子 -->
            <text class="text-xs text-[#999] mb-2 block">加入圈子，与同好交流</text>
            <view v-for="circle in recommendedCircles" :key="circle.id" @click="goTo('/pages/circles/' + circle.id)" class="block mb-2">
              <view class="flex items-center gap-3 p-3 bg-white rounded-xl border border-[#E8E0D5]">
                <view class="w-10 h-10 rounded-full bg-[#C41E3A]/10 flex items-center justify-center flex-shrink-0">
                  <text class="text-[#C41E3A]">&#128101;</text>
