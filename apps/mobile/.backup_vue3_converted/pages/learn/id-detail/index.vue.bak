                </view>
              </view>
            </view>
          </view>
          <view v-else class="flex flex-col items-center justify-center py-16">
            <text class="text-4xl text-[#999]/50 mb-3">&#128172;</text>
            <text class="text-[#999] text-sm">暂无问答</text>
            <text class="text-[#999]/70 text-xs mt-1">有问题随时向老师提问</text>
          </view>
