          </view>
          <view v-else class="flex flex-col items-center justify-center py-16">
            <text class="text-4xl text-[#999]/50 mb-3">&#128203;</text>
            <text class="text-[#999] text-sm">暂无笔记</text>
            <text class="text-[#999]/70 text-xs mt-1">学习时记录重点，方便复习</text>
          </view>
        </view>

        <!-- 问答Tab -->
        <view v-if="activeTab === 'questions'">
