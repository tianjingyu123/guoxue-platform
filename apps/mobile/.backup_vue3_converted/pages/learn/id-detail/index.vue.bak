              <!-- 问题 -->
              <view class="flex gap-3 mb-3">
                <view class="w-8 h-8 rounded-full bg-[#F5F1EB] flex items-center justify-center flex-shrink-0">
                  <text class="text-xs text-[#2C2C2C]">{{ qa.user.name[0] }}</text>
                </view>
                <view class="flex-1">
                  <view class="flex items-center gap-2">
                    <text class="text-sm font-medium text-[#2C2C2C]">{{ qa.user.name }}</text>
                    <text class="text-xs text-[#999]">{{ qa.time }}</text>
                  </view>
                  <text class="text-sm text-[#2C2C2C] mt-1 block">{{ qa.question }}</text>
