              <view class="bg-white rounded-xl overflow-hidden hover:bg-[#F5F1EB]/50 transition-colors">
                <view class="aspect-[4/3] bg-[#F5F1EB] flex items-center justify-center">
                  <text class="text-3xl text-[#C9A96E]/60">&#128214;</text>
