        </view>
      </view>

      <!-- 学习完成弹窗 -->
      <view v-if="showCompletionModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60">
        <view class="w-[90%] max-w-sm bg-white rounded-2xl overflow-hidden" style="animation: fadeIn 0.2s ease;">
