          <text>{{ tab.icon }}</text>
          <text>{{ tab.label }}</text>
          <text v-if="tab.id === 'notes' && courseData.notes.length > 0" class="text-[10px] px-1.5 py-0 rounded bg-[#F0EBE5] text-[#999] ml-1">{{ courseData.notes.length }}</text>
        </view>
      </view>

      <!-- Tab内容 -->
      <view class="pb-20">
        <!-- 目录Tab -->
        <view v-if="activeTab === 'chapters'" class="divide-y divide-[#E8E0D5]">
