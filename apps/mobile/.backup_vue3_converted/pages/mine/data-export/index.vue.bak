<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 导航栏 -->
    <view class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between h-14 px-4">
        <view @click="goBack" class="p-2 -ml-2">
          <text class="text-[#2C2C2C]">←</text>
        </view>
        <text class="font-medium">数据导出</text>
        <view class="w-9" />
      </view>
    </view>

    <!-- Tab 切换 -->
    <view class="flex border-b border-[#E8E0D5]">
      <view @click="activeTab = 'create'" :class="['flex-1 py-3 text-sm font-medium border-b-2 text-center', activeTab === 'create' ? 'text-[#C41E3A] border-[#C41E3A]' : 'text-[#999] border-transparent']">申请导出</view>
      <view @click="activeTab = 'records'" :class="['flex-1 py-3 text-sm font-medium border-b-2 text-center', activeTab === 'records' ? 'text-[#C41E3A] border-[#C41E3A]' : 'text-[#999] border-transparent']">
        导出记录
        <text v-if="completedCount > 0" class="ml-1 px-1.5 py-0.5 text-xs bg-[#C41E3A] text-white rounded-full">{{ completedCount }}</text>
      </view>
    </view>

    <!-- 申请导出 Tab -->
    <view v-if="activeTab === 'create'" class="p-4 space-y-4">
      <!-- 说明卡片 -->
      <view class="flex gap-3 p-4 bg-blue-50 rounded-xl">
        <text class="text-blue-600 flex-shrink-0 mt-0.5">ℹ️</text>
        <view class="text-sm text-blue-800">
          <text class="font-medium mb-1 block">数据导出说明</text>
          <view class="space-y-1 text-blue-700">
            <text class="block">• 导出文件为 ZIP 压缩包格式</text>
            <text class="block">• 处理时间约 5-30 分钟，完成后通知您</text>
            <text class="block">• 文件有效期 7 天，请及时下载</text>
            <text class="block">• 每月最多申请 3 次导出</text>
          </view>
        </view>
      </view>

      <!-- 数据类型选择 -->
      <view class="bg-white rounded-2xl overflow-hidden">
        <view class="flex items-center justify-between p-4 border-b border-[#E8E0D5]">
          <text class="font-medium">选择导出数据</text>
          <view @click="selectAll" class="text-sm text-[#C41E3A]">
            {{ selectedTypes.length === dataTypes.length ? '取消全选' : '全选' }}
          </view>
        </view>
        <view class="divide-y divide-border">
          <view v-for="type in dataTypes" :key="type.id" @click="toggleType(type.id)" class="w-full flex items-center gap-3 p-4">
            <view :class="['w-10 h-10 rounded-xl flex items-center justify-center', selectedTypes.includes(type.id) ? 'bg-[#C41E3A] text-white' : 'bg-[#F0EBE5] text-[#999]']">
              <text>{{ type.icon }}</text>
            </view>
            <view class="flex-1 min-w-0">
              <text class="font-medium block">{{ type.name }}</text>
              <text class="text-xs text-[#999] mt-0.5 block">{{ type.description }}</text>
            </view>
            <view class="flex items-center gap-2">
              <text class="text-xs text-[#999]">{{ type.estimatedSize }}</text>
              <view :class="['w-5 h-5 rounded-full border-2 flex items-center justify-center', selectedTypes.includes(type.id) ? 'bg-[#C41E3A] border-[#C41E3A]' : 'border-muted-foreground/30']">
                <text v-if="selectedTypes.includes(type.id)" class="text-white text-xs">✓</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 预估大小 -->
      <view v-if="selectedTypes.length > 0" class="flex items-center justify-between p-4 bg-[#F0EBE5]/50 rounded-xl">
        <text class="text-sm text-[#999]">已选 {{ selectedTypes.length }} 项数据</text>
        <text class="text-sm font-medium">预估大小: 约 {{ selectedTypes.length * 2 }}MB</text>
      </view>
    </view>

    <!-- 导出记录 Tab -->
    <view v-else class="p-4">
      <view v-if="loading" class="space-y-4">
        <view v-for="i in 3" :key="i" class="bg-white rounded-2xl p-4 animate-pulse">
          <view class="h-5 w-24 bg-[#F0EBE5] rounded mb-3" />
          <view class="h-4 w-48 bg-[#F0EBE5] rounded mb-2" />
          <view class="h-4 w-32 bg-[#F0EBE5] rounded" />
        </view>
      </view>
      <view v-else-if="records.length === 0" class="flex flex-col items-center justify-center py-16">
        <view class="w-20 h-20 rounded-full bg-[#F0EBE5] flex items-center justify-center mb-4">
          <text class="text-[#999] text-3xl">📥</text>
        </view>
        <text class="text-[#999] mb-4">暂无导出记录</text>
        <view @click="activeTab = 'create'" class="text-[#C41E3A] text-sm">去申请导出</view>
      </view>
      <view v-else class="space-y-4">
        <view v-for="record in records" :key="record.id" class="bg-white rounded-2xl p-4">
          <view class="flex items-start justify-between mb-3">
            <view :class="['flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium', getStatusConfig(record.status).color]">
              <text>{{ getStatusConfig(record.status).iconText }}</text>
              <text>{{ getStatusConfig(record.status).label }}</text>
            </view>
            <text class="text-xs text-[#999]">{{ formatDate(record.createdAt) }}</text>
          </view>
          <text class="text-sm block mb-2">{{ getTypeNames(record.types) }}</text>
          <text v-if="record.status === 'completed' && record.expireAt" class="text-xs text-[#999] block mb-3">
            文件大小: {{ record.fileSize }} · 有效期至 {{ formatDate(record.expireAt) }}
          </text>
          <view v-if="record.status === 'processing'" class="flex items-center gap-2 text-xs text-blue-600">
            <view class="w-full h-1.5 bg-blue-100 rounded-full overflow-hidden">
              <view class="h-full w-1/3 bg-blue-500 rounded-full animate-pulse" />
            </view>
            <text>处理中...</text>
          </view>
          <view v-if="record.status === 'completed'" @click="doDownload(record.downloadUrl)" class="w-full mt-3 py-2.5 bg-[#C41E3A] text-white rounded-xl text-sm font-medium flex items-center justify-center gap-2">
            <text>📥 下载文件</text>
          </view>
          <view v-if="record.status === 'expired'" @click="reapply(record.types)" class="w-full mt-3 py-2.5 bg-[#F0EBE5] text-[#2C2C2C] rounded-xl text-sm font-medium text-center">
            重新申请
          </view>
        </view>
      </view>
    </view>

    <!-- 底部提交按钮 -->
    <view v-if="activeTab === 'create'" class="fixed bottom-0 left-0 right-0 p-4 bg-[#FAF8F5] border-t border-[#E8E0D5]">
      <view @click="handleSubmit" :class="['w-full py-3.5 bg-[#C41E3A] text-white rounded-xl font-medium text-center', (selectedTypes.length === 0 || submitting) ? 'opacity-50' : '']">
        <text v-if="submitting">⟳ 提交中...</text>
        <text v-else>📥 申请导出 ({{ selectedTypes.length }} 项)</text>
      </view>
    </view>
    <view v-if="activeTab === 'create'" class="h-24" />
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

interface DataType {
  id: string
  name: string
  description: string
  icon: string
  estimatedSize: string
}

interface ExportRecord {
  id: string
  types: string[]
  status: 'processing' | 'completed' | 'expired' | 'failed'
  createdAt: string
  completedAt?: string
  expireAt?: string
  downloadUrl?: string
  fileSize?: string
}

const dataTypes: DataType[] = [
  { id: 'profile', name: '个人信息', description: '账号资料、头像、昵称、简介等', icon: '👤', estimatedSize: '< 1MB' },
  { id: 'posts', name: '帖子内容', description: '发布的圈子帖子、评论、回复', icon: '📄', estimatedSize: '约 5MB' },
  { id: 'comments', name: '评论互动', description: '课程评论、视频评论、点赞记录', icon: '💬', estimatedSize: '约 2MB' },
  { id: 'favorites', name: '收藏内容', description: '收藏的课程、帖子、商品等', icon: '🔖', estimatedSize: '约 1MB' },
  { id: 'orders', name: '订单数据', description: '购买记录、支付信息、发票', icon: '🛍️', estimatedSize: '约 3MB' },
  { id: 'learning', name: '学习记录', description: '课程进度、学习时长、测验成绩', icon: '🎓', estimatedSize: '约 2MB' },
  { id: 'notes', name: '笔记内容', description: '课程笔记、批注、高亮标记', icon: '📖', estimatedSize: '约 4MB' },
  { id: 'follows', name: '关注列表', description: '关注的用户、圈子、讲师', icon: '👥', estimatedSize: '< 1MB' },
]

const selectedTypes = ref<string[]>([])
const records = ref<ExportRecord[]>([])
const loading = ref(true)
const submitting = ref(false)
const activeTab = ref<'create' | 'records'>('create')

const completedCount = computed(() => records.value.filter(r => r.status === 'completed').length)

onMounted(() => {
  setTimeout(() => {
    records.value = [
      {
        id: '1',
        types: ['profile', 'posts', 'comments'],
        status: 'completed',
        createdAt: '2026-06-01T10:30:00',
        completedAt: '2026-06-01T10:35:00',
        expireAt: '2026-06-08T10:35:00',
        downloadUrl: '/api/export/download/1',
        fileSize: '8.2MB'
      },
      {
        id: '2',
        types: ['orders', 'learning'],
        status: 'processing',
        createdAt: '2026-06-03T08:00:00',
      },
      {
        id: '3',
        types: ['profile', 'favorites', 'notes', 'follows'],
        status: 'expired',
        createdAt: '2026-05-20T14:00:00',
        completedAt: '2026-05-20T14:10:00',
        expireAt: '2026-05-27T14:10:00',
      },
    ]
    loading.value = false
  }, 500)
})

function getStatusConfig(status: ExportRecord['status']) {
  const map: Record<string, { label: string; color: string; iconText: string }> = {
    processing: { label: '处理中', color: 'text-blue-600 bg-blue-50', iconText: '⟳' },
    completed: { label: '已完成', color: 'text-green-600 bg-green-50', iconText: '✓' },
    expired: { label: '已过期', color: 'text-gray-500 bg-gray-100', iconText: '🕐' },
    failed: { label: '失败', color: 'text-red-600 bg-red-50', iconText: '⚠️' },
  }
  return map[status]
}

function formatDate(dateStr: string): string {
  const date = new Date(dateStr)
  return `${date.getMonth() + 1}月${date.getDate()}日 ${String(date.getHours()).padStart(2, '0')}:${String(date.getMinutes()).padStart(2, '0')}`
}

function getTypeNames(typeIds: string[]): string {
  return typeIds.map(id => dataTypes.find(t => t.id === id)?.name || id).join('、')
}

function toggleType(typeId: string) {
  if (selectedTypes.value.includes(typeId)) {
    selectedTypes.value = selectedTypes.value.filter(id => id !== typeId)
  } else {
    selectedTypes.value = [...selectedTypes.value, typeId]
  }
}

function selectAll() {
  if (selectedTypes.value.length === dataTypes.length) {
    selectedTypes.value = []
  } else {
    selectedTypes.value = dataTypes.map(t => t.id)
  }
}

async function handleSubmit() {
  if (selectedTypes.value.length === 0) return
  submitting.value = true
  setTimeout(() => {
    const newRecord: ExportRecord = {
      id: Date.now().toString(),
      types: [...selectedTypes.value],
      status: 'processing',
      createdAt: new Date().toISOString(),
    }
    records.value = [newRecord, ...records.value]
    selectedTypes.value = []
    submitting.value = false
    activeTab.value = 'records'
  }, 1000)
}

function doDownload(url?: string) {
  if (url) uni.showToast({ title: '开始下载...', icon: 'none' })
}

function reapply(types: string[]) {
  selectedTypes.value = types
  activeTab.value = 'create'
}

function goBack() {
  uni.navigateBack()
}
</script>
