<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- Header -->
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between h-14 px-4">
        <view @click="goBack" class="p-2 -ml-2">
          <text class="text-[#2C2C2C] text-lg">←</text>
        </view>
        <text class="font-semibold text-[#2C2C2C]">浏览历史</text>
        <view v-if="totalCount > 0" @click="showClearConfirm = true" class="text-sm text-[#FF4D4F]">
          清空
        </view>
        <view v-else class="w-10" />
      </view>
    </view>

    <!-- Stats Bar -->
    <view v-if="totalCount > 0" class="px-4 py-3 bg-[#F0EDE8]/50 flex items-center gap-4 text-sm">
      <view class="flex items-center gap-1.5 text-[#999]">
        <text class="text-xs">🕐</text>
        <text>共 {{ totalCount }} 条记录</text>
      </view>
      <view class="flex items-center gap-1.5 text-[#999]">
        <text class="text-xs">📅</text>
        <text>近30天</text>
      </view>
    </view>

    <!-- Loading -->
    <view v-if="loading" class="p-4 space-y-6">
      <view v-for="g in 2" :key="g" class="space-y-3">
        <view class="h-5 w-16 bg-[#F0EDE8] rounded animate-pulse" />
        <view v-for="i in 3" :key="i" class="flex gap-3 animate-pulse">
          <view class="w-24 h-16 bg-[#F0EDE8] rounded-lg" />
          <view class="flex-1 space-y-2">
            <view class="h-4 bg-[#F0EDE8] rounded w-3/4" />
            <view class="h-3 bg-[#F0EDE8] rounded w-1/2" />
          </view>
        </view>
      </view>
    </view>

    <!-- Empty -->
    <view v-else-if="historyGroups.length === 0" class="flex flex-col items-center justify-center py-20">
      <view class="w-20 h-20 bg-[#F0EDE8] rounded-full flex items-center justify-center mb-4">
        <text class="text-[#999] text-3xl">🕐</text>
      </view>
      <text class="text-[#999] mb-2">暂无浏览记录</text>
      <text class="text-sm text-[#999]">去发现更多精彩内容吧</text>
      <view @click="goExplore" class="mt-6 px-6 py-2 bg-[#C41E3A] text-white rounded-full text-sm">
        去逛逛
      </view>
    </view>

    <!-- Content -->
    <view v-else class="pb-safe">
      <view v-for="group in historyGroups" :key="group.date" class="mb-6">
        <!-- Date Header (sticky) -->
        <view class="px-4 py-2 sticky z-[5] bg-[#FAF8F5]/95" style="backdrop-filter:blur(8px);top:112px">
          <text class="text-sm font-medium text-[#999]">{{ group.label }}</text>
        </view>

        <!-- Items -->
        <view class="px-4 space-y-3">
          <view v-for="item in group.items" :key="item.id" class="relative overflow-hidden transition-all duration-300" :class="deletingId === item.id ? 'translate-x-[-80px]' : ''">
            <!-- Main card -->
            <view class="flex gap-3 bg-white rounded-xl p-3 border border-[#E8E0D5] active:bg-[#F0EDE8]/50 transition-colors"
              @click="deletingId !== item.id && handleItemClick(item)"
              @touchstart="onTouchStart(item.id)"
            >
              <!-- Cover / Icon -->
              <view class="relative w-24 h-16 rounded-lg overflow-hidden bg-[#F0EDE8] shrink-0">
                <image v-if="item.cover" :src="item.cover" mode="aspectFill" class="w-full h-full" />
                <view v-else class="w-full h-full flex items-center justify-center" :class="typeConfig[item.type]?.color || 'bg-[#F0EDE8]'">
                  <text class="text-white text-lg">{{ typeIcon(item.type) }}</text>
                </view>
                <!-- Progress bar -->
                <view v-if="item.progress !== undefined && item.progress < 100" class="absolute bottom-0 left-0 right-0 h-1" style="background:rgba(0,0,0,0.3)">
                  <view class="h-full bg-[#C41E3A]" :style="{ width: item.progress + '%' }" />
                </view>
                <!-- Play button overlay for video -->
                <view v-if="item.type === 'video'" class="absolute inset-0 flex items-center justify-center">
                  <view class="w-8 h-8 rounded-full flex items-center justify-center" style="background:rgba(0,0,0,0.5)">
                    <text class="text-white text-sm">▶</text>
                  </view>
                </view>
              </view>

              <!-- Info -->
              <view class="flex-1 min-w-0">
                <view class="flex items-start gap-2">
                  <text class="text-xs px-1.5 py-0.5 rounded text-white shrink-0" :class="typeConfig[item.type]?.color || 'bg-[#999]'">
                    {{ typeLabel(item.type) }}
                  </text>
                  <text class="text-sm font-medium text-[#2C2C2C] line-clamp-2 flex-1">{{ item.title }}</text>
                </view>
                <view class="flex items-center gap-2 mt-2 text-xs text-[#999]">
                  <text>{{ item.viewedAt }}</text>
                  <text v-if="item.progress !== undefined && item.duration">·</text>
                  <text v-if="item.progress !== undefined && item.duration" :class="item.progress >= 100 ? 'text-green-500' : ''">
                    {{ formatProgress(item.progress, item.duration) }}
                  </text>
                </view>
              </view>

              <!-- Continue Button -->
              <view v-if="item.progress !== undefined && item.progress < 100"
                class="self-center px-3 py-1.5 bg-[#C41E3A]/10 text-[#C41E3A] text-xs rounded-full shrink-0"
                @click.stop="handleItemClick(item)"
              >
                继续
              </view>
            </view>

            <!-- Swipe Delete Button -->
            <view class="absolute right-0 top-0 bottom-0 w-20 bg-red-500 flex items-center justify-center text-white"
              :style="{ transform: deletingId === item.id ? 'translateX(0)' : 'translateX(100%)' }"
              @click="handleDelete(item.id)"
            >
              <text class="text-lg">🗑️</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Load More Hint -->
      <view class="text-center py-6 text-sm text-[#999]">
        仅展示近30天的浏览记录
      </view>
    </view>

    <!-- Clear Confirm Modal -->
    <view v-if="showClearConfirm" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" @click="showClearConfirm = false">
      <view class="bg-white rounded-2xl w-[80%] max-w-sm overflow-hidden" @click.stop>
        <view class="p-6 text-center">
          <view class="w-14 h-14 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <text class="text-[#FF4D4F] text-xl">🗑️</text>
          </view>
          <text class="font-semibold text-base text-[#2C2C2C] mb-2 block">清空浏览历史</text>
          <text class="text-sm text-[#999] block">确定要清空所有浏览记录吗？此操作不可恢复</text>
        </view>
        <view class="flex border-t border-[#E8E0D5]">
          <view @click="showClearConfirm = false" class="flex-1 py-3.5 text-[#999] text-center text-sm">
            取消
          </view>
          <view @click="handleClearAll" class="flex-1 py-3.5 text-[#FF4D4F] font-medium text-center border-l border-[#E8E0D5] text-sm">
            清空
          </view>
        </view>
      </view>
    </view>

    <!-- Click outside overlay (cancel swipe delete) -->
    <view v-if="deletingId" class="fixed inset-0 z-[1]" @click="deletingId = null" />
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

interface HistoryItem {
  id: string
  type: string
  title: string
  cover?: string
  progress?: number
  duration?: number
  viewedAt: string
}

interface HistoryGroup {
  date: string
  label: string
  items: HistoryItem[]
}

const loading = ref(true)
const showClearConfirm = ref(false)
const deletingId = ref<string | null>(null)
const historyGroups = ref<HistoryGroup[]>([])

const totalCount = computed(() => historyGroups.value.reduce((sum, g) => sum + g.items.length, 0))

const typeConfig: Record<string, { icon: string; label: string; color: string }> = {
  course: { icon: '📚', label: '课程', color: 'bg-blue-500' },
  video: { icon: '🎬', label: '视频', color: 'bg-pink-500' },
  live: { icon: '📡', label: '直播', color: 'bg-red-500' },
  article: { icon: '📄', label: '文章', color: 'bg-green-500' },
  product: { icon: '🛍️', label: '商品', color: 'bg-orange-500' },
  circle: { icon: '📚', label: '圈子', color: 'bg-purple-500' },
}

function typeIcon(type: string): string {
  return typeConfig[type]?.icon || '📄'
}

function typeLabel(type: string): string {
  return typeConfig[type]?.label || type
}

function formatProgress(progress: number, duration: number): string {
  if (progress >= 100) return '已看完'
  const watched = Math.floor((progress / 100) * duration)
  const minutes = Math.floor(watched / 60)
  return '已观看 ' + minutes + ' 分钟'
}

function onTouchStart(itemId: string) {
  deletingId.value = itemId
}

function handleDelete(itemId: string) {
  historyGroups.value = historyGroups.value
    .map(group => ({
      ...group,
      items: group.items.filter(item => item.id !== itemId),
    }))
    .filter(group => group.items.length > 0)
  deletingId.value = null
}

function handleClearAll() {
  historyGroups.value = []
  showClearConfirm.value = false
  uni.showToast({ title: '已清空', icon: 'success' })
}

function handleItemClick(item: HistoryItem) {
  const routes: Record<string, string> = {
    course: '/pages/courses/course-detail/index?id=' + item.id,
    video: '/pages/videos/video-detail/index?id=' + item.id,
    live: '/pages/live/live-detail/index?id=' + item.id,
    article: '/pages/articles/article-detail/index?id=' + item.id,
    product: '/pages/shop/product-detail/index?id=' + item.id,
    circle: '/pages/circles/circle-detail/index?id=' + item.id,
  }
  const url = routes[item.type]
  if (url) uni.navigateTo({ url })
}

function goBack() { uni.navigateBack() }

function goExplore() { uni.reLaunch({ url: '/pages/index/index' }) }

setTimeout(() => {
  historyGroups.value = [
    {
      date: '2024-01-15',
      label: '今天',
      items: [
        { id: '1', type: 'course', title: '周易入门：从零开始学习易经', cover: '', viewedAt: '14:30', progress: 45, duration: 3600 },
        { id: '2', type: 'video', title: '梅花易数实战案例分析', cover: '', viewedAt: '12:15', progress: 100, duration: 1200 },
        { id: '3', type: 'article', title: '八字命理中的十神详解', viewedAt: '10:20' },
      ],
    },
    {
      date: '2024-01-14',
      label: '昨天',
      items: [
        { id: '4', type: 'live', title: '风水布局直播答疑', viewedAt: '20:00' },
        { id: '5', type: 'product', title: '开光铜葫芦摆件', viewedAt: '16:45' },
      ],
    },
    {
      date: '2024-01-12',
      label: '1月12日',
      items: [
        { id: '6', type: 'course', title: '六爻预测高级班', viewedAt: '19:30', progress: 30, duration: 7200 },
        { id: '7', type: 'circle', title: '易学爱好者交流圈', viewedAt: '15:00' },
        { id: '8', type: 'article', title: '紫微斗数入门指南', viewedAt: '11:20' },
      ],
    },
  ]
  loading.value = false
}, 400)
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
