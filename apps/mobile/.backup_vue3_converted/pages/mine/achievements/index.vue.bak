<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- Header -->
    <view class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 py-3">
        <view @click="goBack" class="p-1">
          <text class="text-[#2C2C2C] text-lg">←</text>
        </view>
        <text class="text-base font-semibold text-[#2C2C2C]">成就墙</text>
        <view class="w-8" />
      </view>
    </view>

    <view v-if="loading" class="px-4 pt-4 space-y-4">
      <view class="h-32 bg-[#F0EBE5] rounded-xl animate-pulse" />
      <view class="flex gap-2 overflow-x-auto">
        <view v-for="i in 5" :key="i" class="h-10 w-20 bg-[#F0EBE5] rounded-full flex-shrink-0" />
      </view>
      <view class="grid grid-cols-3 gap-3">
        <view v-for="i in 6" :key="i" class="h-32 bg-[#F0EBE5] rounded-xl" />
      </view>
    </view>

    <view v-else class="pb-8">
      <!-- Overview Card -->
      <view class="mx-4 mt-4 p-4 bg-gradient-to-br from-primary to-destructive rounded-xl text-white">
        <view class="flex items-center gap-3 mb-4">
          <view class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center">
            <text class="text-lg">🏆</text>
          </view>
          <view>
            <text class="text-sm opacity-80 block">成就进度</text>
            <text class="text-2xl font-bold">{{ unlockedCount }}/{{ totalCount }}</text>
          </view>
          <view class="ml-auto text-right">
            <text class="text-sm opacity-80 block">累计积分</text>
            <text class="text-lg font-semibold text-[#C9A96E]">+{{ totalPoints }}</text>
          </view>
        </view>
        <view class="h-2 bg-white/20 rounded-full overflow-hidden">
          <view :style="{ width: progressPercent + '%' }" class="h-full bg-white rounded-full" />
        </view>
        <text class="mt-1 text-sm opacity-80 text-right block">{{ progressPercent }}%</text>
      </view>

      <!-- Category Filter -->
      <view class="px-4 mt-4">
        <view class="flex gap-2 overflow-x-auto pb-2">
          <view
            @click="selectedCategory = 'all'"
            :class="['px-4 py-2 rounded-full text-sm font-medium whitespace-nowrap flex-shrink-0', selectedCategory === 'all' ? 'bg-[#C41E3A] text-white' : 'bg-white text-[#999] border border-[#E8E0D5]']"
          >
            <text>全部 ({{ totalCount }})</text>
          </view>
          <view
            v-for="cat in categories"
            :key="cat.key"
            @click="selectedCategory = cat.key"
            :class="['px-4 py-2 rounded-full text-sm font-medium whitespace-nowrap flex-shrink-0 flex items-center gap-1', selectedCategory === cat.key ? 'bg-[#C41E3A] text-white' : 'bg-white text-[#999] border border-[#E8E0D5]']"
          >
            <text>{{ cat.icon }}</text>
            <text>{{ cat.name }}</text>
            <text class="opacity-70">({{ cat.unlocked }}/{{ cat.total }})</text>
          </view>
        </view>
      </view>

      <!-- Achievement Grid -->
      <view class="px-4 mt-4">
        <view class="grid grid-cols-3 gap-3">
          <view
            v-for="item in filteredAchievements"
            :key="item.id"
            @click="handleAchievementClick(item)"
            :class="['p-3 rounded-xl text-center transition-all', item.isUnlocked ? rarityBgClass(item.rarity) + ' border border-[#C9A96E]/30' : 'bg-[#F0EBE5] opacity-60']"
          >
            <view :class="['text-3xl mb-2', !item.isUnlocked ? 'grayscale' : '']">
              <text>{{ item.icon }}</text>
            </view>
            <text :class="['text-xs font-medium truncate block', item.isUnlocked ? 'text-[#2C2C2C]' : 'text-[#999]']">
              {{ item.name }}
            </text>
            <view v-if="item.isUnlocked" class="mt-1 flex items-center justify-center gap-1">
              <text class="text-green-500 text-xs">✓</text>
              <text class="text-[10px] text-green-600">已获得</text>
            </view>
            <view v-else class="mt-1">
              <view class="h-1 bg-[#F0EBE5]-foreground/20 rounded-full overflow-hidden">
                <view :style="{ width: (item.currentProgress / item.targetProgress) * 100 + '%' }" class="h-full bg-[#C41E3A] rounded-full" />
              </view>
              <text class="text-[10px] text-[#999] mt-0.5 block">{{ item.currentProgress }}/{{ item.targetProgress }}</text>
            </view>
            <view v-if="item.rarity !== 'common'" :class="['mt-1 text-[10px]', rarityColorClass(item.rarity)]">
              <text>{{ rarityName(item.rarity) }}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Recent Unlocked -->
      <view v-if="recentUnlocked.length > 0" class="px-4 mt-6">
        <text class="text-sm font-semibold text-[#2C2C2C] mb-3 block">最近解锁</text>
        <view class="space-y-2">
          <view
            v-for="item in recentUnlocked"
            :key="item.id"
            @click="handleAchievementClick(item)"
            class="w-full flex items-center gap-3 p-3 bg-white rounded-xl border border-[#E8E0D5]"
          >
            <text class="text-2xl">{{ item.icon }}</text>
            <view class="flex-1">
              <text class="text-sm font-medium text-[#2C2C2C] block">{{ item.name }}</text>
              <text class="text-xs text-[#999] block">{{ item.unlockedAt }} 获得</text>
            </view>
            <text class="text-sm text-[#C9A96E] font-medium">+{{ item.rewardPoints }}</text>
            <text class="text-[#999] text-base">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Achievement Detail Sheet -->
    <view v-if="selectedAchievement" class="fixed inset-0 z-50 flex items-end bg-black/50" @click="selectedAchievement = null">
      <view class="w-full bg-white rounded-t-2xl max-h-[70vh] overflow-y-auto" @click.stop>
        <view class="sticky top-0 bg-white border-b border-[#E8E0D5] py-3 px-4">
          <text class="text-center font-semibold block text-[#2C2C2C]">成就详情</text>
        </view>
        <view class="py-6 px-4">
          <!-- Icon & Name -->
          <view class="text-center">
            <view :class="['text-6xl mb-3', !selectedAchievement.isUnlocked ? 'grayscale' : '']">
              <text>{{ selectedAchievement.icon }}</text>
            </view>
            <text class="text-xl font-semibold text-[#2C2C2C] block">{{ selectedAchievement.name }}</text>
            <text :class="['mt-1 text-sm block', rarityColorClass(selectedAchievement.rarity)]">
              {{ rarityName(selectedAchievement.rarity) }}成就
            </text>
            <text class="mt-2 text-sm text-[#999] block">{{ selectedAchievement.description }}</text>
          </view>

          <!-- Status -->
          <view :class="['mx-0 mt-6 p-4 rounded-xl', selectedAchievement.isUnlocked ? 'bg-green-50 border border-green-200' : 'bg-[#F0EBE5] border border-[#E8E0D5]']">
            <view v-if="selectedAchievement.isUnlocked" class="flex items-center gap-3">
              <text class="text-green-500 text-2xl">✓</text>
              <view>
                <text class="font-medium text-green-700 block">已获得此成就</text>
                <text class="text-sm text-green-600 block">{{ selectedAchievement.unlockedAt }} 解锁</text>
              </view>
              <view class="ml-auto text-right">
                <text class="text-sm text-[#999] block">获得积分</text>
                <text class="text-lg font-semibold text-[#C9A96E]">+{{ selectedAchievement.rewardPoints }}</text>
              </view>
            </view>
            <view v-else>
              <view class="flex items-center gap-3 mb-3">
                <text class="text-[#999] text-2xl">🔒</text>
                <view>
                  <text class="font-medium text-[#2C2C2C] block">尚未解锁</text>
                  <text class="text-sm text-[#999] block">{{ selectedAchievement.condition }}</text>
                </view>
              </view>
              <view class="flex items-center gap-2">
                <view class="flex-1 h-2 bg-[#F0EBE5]-foreground/20 rounded-full overflow-hidden">
                  <view :style="{ width: (selectedAchievement.currentProgress / selectedAchievement.targetProgress) * 100 + '%' }" class="h-full bg-[#C41E3A] rounded-full" />
                </view>
                <text class="text-sm text-[#999]">{{ selectedAchievement.currentProgress }}/{{ selectedAchievement.targetProgress }}</text>
              </view>
            </view>
          </view>

          <!-- Reward Info -->
          <view class="mx-0 mt-4 p-4 bg-[#FFF9E6] rounded-xl border border-[#C9A96E]/30">
            <text class="text-sm font-medium text-[#8B7355] mb-2 block">成就奖励</text>
            <view class="flex items-center gap-4">
              <view class="flex items-center gap-1">
                <text class="text-[#C9A96E]">⭐</text>
                <text class="text-[#2C2C2C] font-medium">{{ selectedAchievement.rewardPoints }} 积分</text>
              </view>
              <view v-if="selectedAchievement.rewardBadge" class="flex items-center gap-1">
                <text class="text-[#C9A96E]">🏆</text>
                <text class="text-[#2C2C2C] font-medium">{{ selectedAchievement.rewardBadge }}</text>
              </view>
            </view>
          </view>

          <!-- Related Achievements -->
          <view v-if="detailRelated && detailRelated.length > 0" class="mt-6">
            <text class="text-sm font-semibold text-[#2C2C2C] mb-3 block">相关成就</text>
            <view class="flex gap-3 overflow-x-auto pb-2">
              <view
                v-for="related in detailRelated"
                :key="related.id"
                @click="handleAchievementClick(related)"
                :class="['flex-shrink-0 w-20 p-2 rounded-xl text-center', related.isUnlocked ? rarityBgClass(related.rarity) : 'bg-[#F0EBE5] opacity-60']"
              >
                <view :class="['text-2xl', !related.isUnlocked ? 'grayscale' : '']">
                  <text>{{ related.icon }}</text>
                </view>
                <text class="text-xs truncate mt-1 block">{{ related.name }}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

const loading = ref(true)
const selectedCategory = ref<string>('all')
const selectedAchievement = ref<any>(null)
const detailRelated = ref<any[]>([])

const categories = ref([
  { key: 'study', name: '学习成就', icon: '📚', unlocked: 3, total: 8 },
  { key: 'social', name: '社交成就', icon: '👥', unlocked: 2, total: 5 },
  { key: 'points', name: '积分成就', icon: '💰', unlocked: 1, total: 4 },
])

const achievements = ref([
  { id: 1, icon: '🎓', name: '初学者', description: '完成第一门课程', rarity: 'common', isUnlocked: true, unlockedAt: '2024-01-05', currentProgress: 1, targetProgress: 1, rewardPoints: 100, rewardBadge: '', condition: '完成1门课程' },
  { id: 2, icon: '📝', name: '勤学好问', description: '发布10个问题', rarity: 'rare', isUnlocked: true, unlockedAt: '2024-01-10', currentProgress: 10, targetProgress: 10, rewardPoints: 300, rewardBadge: '勤学徽章', condition: '发布10个问题' },
  { id: 3, icon: '💡', name: '解惑达人', description: '回答被采纳20次', rarity: 'epic', isUnlocked: false, unlockedAt: '', currentProgress: 8, targetProgress: 20, rewardPoints: 500, rewardBadge: '解惑大师', condition: '被采纳20次回答' },
  { id: 4, icon: '📖', name: '国学书虫', description: '阅读古籍超过100小时', rarity: 'rare', isUnlocked: true, unlockedAt: '2024-01-12', currentProgress: 100, targetProgress: 100, rewardPoints: 300, rewardBadge: '', condition: '阅读100小时' },
  { id: 5, icon: '⭐', name: '五星好评', description: '获得50个五星好评', rarity: 'epic', isUnlocked: false, unlockedAt: '', currentProgress: 23, targetProgress: 50, rewardPoints: 500, rewardBadge: '好评如潮', condition: '获得50个五星好评' },
  { id: 6, icon: '🏆', name: '积分王者', description: '累计获得10000积分', rarity: 'legendary', isUnlocked: false, unlockedAt: '', currentProgress: 4680, targetProgress: 10000, rewardPoints: 1000, rewardBadge: '积分王者', condition: '累计10000积分' },
  { id: 7, icon: '🤝', name: '社交达人', description: '邀请10位好友', rarity: 'rare', isUnlocked: true, unlockedAt: '2024-01-15', currentProgress: 10, targetProgress: 10, rewardPoints: 300, rewardBadge: '', condition: '邀请10位好友' },
])

const recentUnlocked = computed(() =>
  achievements.value.filter(a => a.isUnlocked).slice(0, 3)
)

const unlockedCount = computed(() => achievements.value.filter(a => a.isUnlocked).length)
const totalCount = computed(() => achievements.value.length)
const totalPoints = computed(() => achievements.value.filter(a => a.isUnlocked).reduce((s, a) => s + a.rewardPoints, 0))
const progressPercent = computed(() => Math.round((unlockedCount.value / totalCount.value) * 100))

const filteredAchievements = computed(() => {
  if (selectedCategory.value === 'all') return achievements.value
  return achievements.value
})

function rarityName(rarity: string): string {
  const map: Record<string, string> = { common: '普通', rare: '稀有', epic: '史诗', legendary: '传说' }
  return map[rarity] || rarity
}

function rarityColorClass(rarity: string): string {
  const map: Record<string, string> = { common: 'text-[#999]', rare: 'text-blue-500', epic: 'text-purple-500', legendary: 'text-yellow-500' }
  return map[rarity] || ''
}

function rarityBgClass(rarity: string): string {
  const map: Record<string, string> = { common: 'bg-white', rare: 'bg-blue-50', epic: 'bg-purple-50', legendary: 'bg-yellow-50' }
  return map[rarity] || ''
}

function handleAchievementClick(item: any) {
  selectedAchievement.value = item
  detailRelated.value = achievements.value.filter(a => a.id !== item.id && a.rarity === item.rarity).slice(0, 3)
}

function goBack() {
  uni.navigateBack()
}

setTimeout(() => { loading.value = false }, 400)
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
