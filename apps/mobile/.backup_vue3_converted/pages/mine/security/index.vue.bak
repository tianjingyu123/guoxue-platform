        <view class="flex gap-2 mt-3 pt-3" style="border-top:1px solid rgba(255,255,255,0.1)">
          <view v-for="item in securityItems" :key="item.label" class="flex-1 flex flex-col items-center gap-0.5">
            <view :class="['w-5 h-5 rounded-full flex items-center justify-center', item.done ? 'bg-green-500/20' : 'bg-orange-500/20']">
              <text :class="[item.done ? 'text-green-400' : 'text-orange-400', 'text-xs']">{{ item.done ? '✓' : '✗' }}</text>
            </view>
            <text class="text-white/50 text-[10px]">{{ item.label }}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="pb-8">
      <!-- Login Security -->
      <view class="mb-4">
        <text class="text-xs text-[#999] px-4 py-2 font-medium block">登录安全</text>
        <view class="bg-white mx-4 rounded-2xl overflow-hidden">
          <view v-for="(item, idx) in loginItems" :key="item.id"
            @click="goPage(item.href)"
