          <view>
            <text class="text-white/60 text-xs block mb-1">账号安全评分</text>
            <view class="flex items-end gap-1.5">
              <text class="text-3xl font-bold" style="color:#C9A96E">82</text>
              <text class="text-white/60 text-sm mb-0.5">/ 100</text>
            </view>
            <text class="text-white/70 text-xs mt-1 block">安全级别：良好，建议完善实名认证</text>
