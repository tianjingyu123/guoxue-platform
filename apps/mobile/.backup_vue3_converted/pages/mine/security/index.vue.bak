              <circle cx="32" cy="32" r="28" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="6" />
              <circle cx="32" cy="32" r="28" fill="none" stroke="#C9A96E" stroke-width="6"
                :stroke-dasharray="arcLength(0.82)" stroke-linecap="round" />
            </svg>
            <text class="absolute inset-0 flex items-center justify-center text-lg" style="color:#C9A96E">🛡️</text>
