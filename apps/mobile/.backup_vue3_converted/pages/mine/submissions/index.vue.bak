<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- Header -->
    <view class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 py-3">
        <view @click="goBack" class="p-2 -ml-2">
          <text class="text-[#2C2C2C] text-lg">&#8592;</text>
        </view>
        <text class="font-semibold text-[#2C2C2C]">我的投稿</text>
        <view @click="handleRefresh" class="p-2 -mr-2">
          <text :class="['text-[#999] text-lg', refreshing ? 'animate-spin' : '']">&#128259;</text>
        </view>
      </view>
      <!-- Tabs -->
      <view class="flex px-4 gap-2 pb-3 overflow-x-auto">
        <view v-for="tab in tabs" :key="tab.key" @click="activeTab = tab.key" :class="['flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm', activeTab === tab.key ? 'bg-[#C41E3A] text-white' : 'bg-white text-[#999] border border-[#E8E0D5]']">
          <text>{{ tab.icon }}</text>
          <text>{{ tab.label }}</text>
          <text v-if="tab.key" :class="['text-xs', activeTab === tab.key ? 'text-white/80' : 'text-[#999]']">{{ getCount(tab.key) }}</text>
        </view>
      </view>
    </view>

    <!-- Content -->
    <view class="p-4 space-y-3">
      <!-- Loading -->
      <view v-if="loading" class="space-y-3">
        <view v-for="i in 3" :key="i" class="bg-white rounded-2xl p-4 animate-pulse border border-[#E8E0D5]">
          <view class="flex gap-3">
            <view class="w-20 h-14 bg-[#F0EBE5] rounded-lg" />
            <view class="flex-1">
              <view class="h-4 bg-[#F0EBE5] rounded w-3/4 mb-2" />
              <view class="h-3 bg-[#F0EBE5] rounded w-1/2" />
            </view>
          </view>
        </view>
      </view>

      <!-- Empty -->
      <view v-else-if="filteredSubmissions.length === 0" class="flex flex-col items-center py-20">
        <view class="w-16 h-16 rounded-full bg-[#F0EBE5] flex items-center justify-center mb-4">
          <text class="text-[#999] text-2xl">&#128196;</text>
        </view>
        <text class="text-[#999] mb-4">暂无投稿记录</text>
        <view @click="goSubmit" class="px-6 py-2 bg-[#C41E3A] text-white rounded-full text-sm">
          <text>去投稿</text>
        </view>
      </view>

      <!-- List -->
      <view v-else>
        <view v-for="item in filteredSubmissions" :key="item.id" class="bg-white rounded-2xl border border-[#E8E0D5] overflow-hidden">
          <view class="p-4">
            <view class="flex gap-3">
              <!-- Cover -->
              <view v-if="item.cover" class="w-20 h-14 rounded-lg overflow-hidden flex-shrink-0 bg-[#F0EBE5]">
                <image :src="item.cover" mode="aspectFill" class="w-full h-full" />
              </view>
              <!-- Info -->
              <view class="flex-1 min-w-0">
                <text class="font-medium text-[#2C2C2C] line-clamp-2 block mb-1">{{ item.title }}</text>
                <view class="flex items-center gap-2 text-xs text-[#999]">
                  <text>投稿至 {{ item.targetPosition }}</text>
                  <text>&#183;</text>
                  <text>{{ formatDate(item.submittedAt) }}</text>
                </view>
              </view>
              <!-- Status -->
              <view :class="['flex items-center gap-1 px-2 py-1 rounded-full text-xs flex-shrink-0 self-start', getStatusColor(item.status)]">
                <text>{{ getStatusIcon(item.status) }}</text>
                <text>{{ getStatusLabel(item.status) }}</text>
              </view>
            </view>

            <!-- Stats for approved -->
            <view v-if="item.status === 'approved' && (item.views !== undefined || item.likes !== undefined)" class="flex items-center gap-4 mt-3 pt-3 border-t border-[#E8E0D5]">
              <view v-if="item.views !== undefined" class="flex items-center gap-1 text-sm text-[#999]">
                <text>&#128065;&#65039;</text>
                <text>{{ item.views }}</text>
              </view>
              <view v-if="item.likes !== undefined" class="flex items-center gap-1 text-sm text-[#999]">
                <text>&#10084;&#65039;</text>
                <text>{{ item.likes }}</text>
              </view>
              <view class="flex-1" />
              <view @click="goDetail(item)" class="flex items-center gap-1 text-sm text-[#C41E3A]">
                <text>查看详情</text>
                <text>&#8250;</text>
              </view>
            </view>

            <!-- Rejected reason -->
            <view v-if="item.status === 'rejected' && item.rejectReason" class="mt-3 pt-3 border-t border-[#E8E0D5]">
              <view class="flex items-start gap-2 p-3 bg-red-50 rounded-lg">
                <text class="text-red-500 mt-0.5">&#9888;&#65039;</text>
                <view class="flex-1">
                  <text class="text-sm text-red-600 font-medium block mb-1">未通过原因</text>
                  <text class="text-sm text-red-500/80 block">{{ item.rejectReason }}</text>
                </view>
              </view>
              <view @click="handleResubmit(item.id)" class="w-full mt-3 py-2.5 bg-gradient-to-r from-[#C41E3A] to-[#E85050] text-white rounded-xl text-sm font-medium flex items-center justify-center gap-2">
                <text>&#9999;&#65039;</text>
                <text>修改并重新投稿</text>
              </view>
            </view>

            <!-- Pending status -->
            <view v-if="item.status === 'pending'" class="mt-3 pt-3 border-t border-[#E8E0D5]">
              <view class="flex items-center gap-2 text-sm text-amber-600">
                <view class="w-2 h-2 rounded-full bg-amber-500 animate-pulse" />
                <text>预计1-3个工作日内完成审核</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

const activeTab = ref<string>('')
const loading = ref(true)
const refreshing = ref(false)

const tabs = [
  { key: '', label: '全部', icon: '&#128196;' },
  { key: 'pending', label: '审核中', icon: '&#9201;&#65039;' },
  { key: 'approved', label: '已通过', icon: '&#10004;&#65039;' },
  { key: 'rejected', label: '未通过', icon: '&#10060;' },
]

interface Submission {
  id: string
  title: string
  cover?: string
  status: string
  submittedAt: string
  reviewedAt?: string
  rejectReason?: string
  targetPosition: string
  views?: number
  likes?: number
}

const submissions = ref<Submission[]>([])

const filteredSubmissions = computed(() => {
  if (!activeTab.value) return submissions.value
  return submissions.value.filter(s => s.status === activeTab.value)
})

const counts = computed(() => ({
  pending: submissions.value.filter(s => s.status === 'pending').length,
  approved: submissions.value.filter(s => s.status === 'approved').length,
  rejected: submissions.value.filter(s => s.status === 'rejected').length,
}))

function getCount(key: string): number {
  return counts.value[key as keyof typeof counts.value] || 0
}

function formatDate(dateStr: string): string {
  return dateStr
}

function getStatusLabel(status: string): string {
  const map: Record<string, string> = { pending: '审核中', approved: '已通过', rejected: '未通过' }
  return map[status] || status
}

function getStatusIcon(status: string): string {
  const map: Record<string, string> = { pending: '&#9201;&#65039;', approved: '&#10004;&#65039;', rejected: '&#10060;' }
  return map[status] || '&#128196;'
}

function getStatusColor(status: string): string {
  const map: Record<string, string> = { pending: 'bg-amber-500/10 text-amber-600', approved: 'bg-emerald-500/10 text-emerald-600', rejected: 'bg-red-500/10 text-red-600' }
  return map[status] || 'bg-[#F0EBE5] text-[#999]'
}

function handleRefresh() {
  refreshing.value = true
  setTimeout(() => { refreshing.value = false }, 800)
}

function handleResubmit(id: string) {
  uni.navigateTo({ url: `/pages/editor/index?id=${id}` })
}

function goDetail(item: Submission) {
  uni.navigateTo({ url: `/pages/articles/detail/index?id=${item.id}` })
}

function goSubmit() {
  uni.navigateTo({ url: '/pages/editor/index' })
}

function goBack() { uni.navigateBack() }

setTimeout(() => {
  submissions.value = [
    { id: '1', title: '八字命理入门：如何看懂自己的命盘', cover: 'https://images.unsplash.com/photo-1440404653325-ab127d49abc1?w=180&h=120&fit=crop', status: 'pending', submittedAt: '2024-01-15T10:30:00Z', targetPosition: '首页推荐' },
    { id: '2', title: '紫微斗数与八字的区别解析', cover: 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=180&h=120&fit=crop', status: 'approved', submittedAt: '2024-01-12T14:20:00Z', reviewedAt: '2024-01-13T09:00:00Z', targetPosition: '发现页精选', views: 2580, likes: 186 },
    { id: '3', title: '风水布局的基本原则', status: 'rejected', submittedAt: '2024-01-10T08:15:00Z', reviewedAt: '2024-01-11T16:30:00Z', rejectReason: '内容与已有文章重复度较高，建议增加原创观点或案例分析', targetPosition: '首页推荐' },
    { id: '4', title: '易经六十四卦详解系列', cover: 'https://images.unsplash.com/photo-1532012197267-da84d127e765?w=180&h=120&fit=crop', status: 'approved', submittedAt: '2024-01-08T11:00:00Z', reviewedAt: '2024-01-09T10:00:00Z', targetPosition: '专题推荐', views: 5680, likes: 423 },
  ]
  loading.value = false
}, 400)
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
