<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 py-3">
        <view class="p-1 -ml-1" @click="goBack">
          <text class="text-[#2C2C2C] text-lg">←</text>
        </view>
        <text class="text-base font-semibold text-[#2C2C2C]">预约记录</text>
        <view class="w-6" />
      </view>

      <!-- Tab 切换 -->
      <view class="px-4 pb-3">
        <view class="flex bg-[#F0EBE5] p-1 rounded-lg">
          <view
            v-for="tab in tabs"
            :key="tab.value"
            :class="['flex-1 text-sm text-center py-1.5 rounded-md transition-colors', activeTab === tab.value ? 'bg-white text-[#C41E3A] font-medium' : 'text-[#999]']"
            @click="activeTab = tab.value"
          >
            <text>{{ tab.label }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 预约列表 -->
    <view class="p-4">
      <!-- 骨架屏 -->
      <view v-if="loading" class="space-y-3">
        <view v-for="i in 4" :key="i" class="bg-white rounded-xl p-4 animate-pulse">
          <view class="flex items-start gap-3">
            <view class="w-12 h-12 bg-[#F0EBE5] rounded-full shrink-0" />
            <view class="flex-1 min-w-0 space-y-2">
              <view class="flex gap-2">
                <view class="h-4 bg-[#F0EBE5] rounded w-16" />
                <view class="h-5 bg-[#F0EBE5] rounded w-20" />
              </view>
              <view class="h-4 bg-[#F0EBE5] rounded w-32" />
              <view class="h-3 bg-[#F0EBE5] rounded w-40" />
              <view class="h-3 bg-[#F0EBE5] rounded w-24" />
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view v-else-if="bookings.length === 0" class="py-16 flex flex-col items-center">
        <text class="text-4xl text-[#999]/30 mb-4">📅</text>
        <text class="text-sm text-[#999]">暂无预约记录</text>
        <view class="mt-4 text-sm text-[#C41E3A]" @click="loadData">
          <text>重新加载</text>
        </view>
      </view>

      <!-- 错误状态 -->
      <view v-else-if="error" class="py-16 flex flex-col items-center">
        <text class="text-4xl text-[#999]/30 mb-4">⚠️</text>
        <text class="text-sm text-[#999] mb-4">{{ error }}</text>
        <view class="px-4 py-2 rounded-lg bg-[#C41E3A] text-white text-sm" @click="loadData">
          <text>重试</text>
        </view>
      </view>

      <!-- 预约列表 -->
      <view v-else class="space-y-3">
        <view
          v-for="booking in bookings"
          :key="booking.id"
          :class="['bg-white rounded-xl p-4', !isActive(booking.status) ? 'opacity-70' : '']"
        >
          <view class="flex items-start gap-3">
            <!-- 头像/图标 -->
            <image
              v-if="booking.target.avatar"
              :src="booking.target.avatar"
              mode="aspectFill"
              class="w-12 h-12 rounded-full shrink-0"
            />
            <view
              v-else
              class="w-12 h-12 rounded-full bg-[#F0EBE5] flex items-center justify-center shrink-0"
            >
              <text class="text-base">{{ bookingTypeIcon(booking.type) }}</text>
            </view>

            <!-- 信息 -->
            <view class="flex-1 min-w-0">
              <view class="flex items-center gap-2 mb-1">
                <text class="text-xs text-[#999] bg-[#F0EBE5] px-2 py-0.5 rounded">
                  {{ booking.typeName }}
                </text>
                <text :class="['text-xs px-2 py-0.5 rounded', statusStyle(booking.status)]">
                  {{ booking.statusName }}
                </text>
              </view>

              <text class="font-medium text-[#2C2C2C] truncate block">{{ booking.target.name }}</text>
              <text v-if="booking.target.title" class="text-sm text-[#999] truncate block">{{ booking.target.title }}</text>

              <view class="flex items-center gap-4 mt-2 text-xs text-[#999]">
                <text class="flex items-center gap-1">📅 {{ booking.bookingTime }}</text>
                <text v-if="booking.duration" class="flex items-center gap-1">🕐 {{ booking.duration }}分钟</text>
              </view>

              <text v-if="booking.location" class="text-xs text-[#999] mt-1 flex items-center gap-1">📍 {{ booking.location }}</text>
              <text v-if="booking.remark" class="text-xs text-[#999] mt-1">备注：{{ booking.remark }}</text>
            </view>
          </view>

          <!-- 操作按钮 -->
          <view v-if="isActive(booking.status)" class="flex items-center justify-end gap-2 mt-3 pt-3 border-t border-[#F0EBE5]">
            <view
              class="flex items-center gap-1 px-3 py-1.5 rounded-lg border border-[#E8E0D5] text-xs text-[#2C2C2C]"
              @click="handleAddToCalendar(booking)"
            >
              <text>📅</text>
              <text>添加到日历</text>
            </view>
            <view
              v-if="booking.canCancel"
              class="flex items-center gap-1 px-3 py-1.5 rounded-lg border border-red-200 text-xs text-red-500"
              @click="openCancelDialog(booking)"
            >
              <text>✕</text>
              <text>取消预约</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 取消确认弹窗 -->
    <view v-if="cancelDialogOpen" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40">
      <view class="mx-4 w-[320px] bg-white rounded-2xl overflow-hidden">
        <view class="p-4">
          <text class="text-base font-semibold text-[#2C2C2C] block mb-2">确认取消预约？</text>
          <view v-if="selectedBooking" class="text-sm text-[#999] space-y-1">
            <text class="block">预约对象：{{ selectedBooking.target.name }}</text>
            <text class="block">预约时间：{{ selectedBooking.bookingTime }}</text>
            <text v-if="selectedBooking.cancelDeadline" class="block text-amber-600">取消截止：{{ selectedBooking.cancelDeadline }}</text>
          </view>
        </view>
        <view class="flex border-t border-[#E8E0D5]">
          <view
            class="flex-1 py-3 text-center text-sm border-r border-[#E8E0D5] text-[#2C2C2C]"
            @click="cancelDialogOpen = false"
          >
            <text>再想想</text>
          </view>
          <view
            class="flex-1 py-3 text-center text-sm text-white bg-[#C41E3A]"
            @click="handleCancelBooking"
          >
            <text>{{ cancelling ? '取消中...' : '确认取消' }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, watch, onMounted } from 'vue'

// 类型定义
interface BookingTarget {
  name: string
  avatar?: string
  title?: string
}

interface BookingItem {
  id: string
  type: string
  typeName: string
  status: string
  statusName: string
  target: BookingTarget
  bookingTime: string
  duration?: number
  location?: string
  remark?: string
  canCancel: boolean
  cancelDeadline?: string
}

type BookingType = 'call' | 'offline_course' | 'instructor'

// 状态
const activeTab = ref<'all' | BookingType>('all')
const bookings = ref<BookingItem[]>([])
const loading = ref(true)
const error = ref<string | null>(null)
const cancelDialogOpen = ref(false)
const selectedBooking = ref<BookingItem | null>(null)
const cancelling = ref(false)

// Tab 配置
const tabs = [
  { value: 'all', label: '全部' },
  { value: 'call', label: '连麦咨询' },
  { value: 'offline_course', label: '线下课程' },
  { value: 'instructor', label: '讲师排期' },
]

// Mock 数据
const mockBookings: BookingItem[] = [
  {
    id: '1',
    type: 'call',
    typeName: '连麦咨询',
    status: 'pending',
    statusName: '待确认',
    target: { name: '周易大师', avatar: '', title: '资深命理师 | 20年从业经验' },
    bookingTime: '2026-06-15 20:00',
    duration: 60,
    canCancel: true,
    cancelDeadline: '2026-06-14 20:00',
  },
  {
    id: '2',
    type: 'offline_course',
    typeName: '线下课程',
    status: 'confirmed',
    statusName: '已确认',
    target: { name: '紫微斗数精讲班', title: '第3期 · 北京站' },
    bookingTime: '2026-06-20 09:00',
    location: '北京市朝阳区国学中心3层',
    duration: 180,
    canCancel: true,
    cancelDeadline: '2026-06-18 09:00',
  },
  {
    id: '3',
    type: 'instructor',
    typeName: '讲师排期',
    status: 'completed',
    statusName: '已完成',
    target: { name: '风水实战派', avatar: '', title: '资深风水师' },
    bookingTime: '2026-06-08 14:00',
    duration: 90,
    canCancel: false,
  },
  {
    id: '4',
    type: 'call',
    typeName: '连麦咨询',
    status: 'cancelled',
    statusName: '已取消',
    target: { name: '姓名学专家陈' },
    bookingTime: '2026-06-05 16:00',
    duration: 30,
    canCancel: false,
  },
]

// 过滤
const filteredBookings = computed(() => {
  if (activeTab.value === 'all') return bookings.value
  return bookings.value.filter(b => b.type === activeTab.value)
})

// 加载数据
async function loadData() {
  loading.value = true
  error.value = null
  try {
    await new Promise(resolve => setTimeout(resolve, 800))
    const type = activeTab.value === 'all' ? undefined : activeTab.value
    let filtered = mockBookings
    if (type) {
      filtered = mockBookings.filter(b => b.type === type)
    }
    bookings.value = filtered
  } catch (e) {
    error.value = '网络错误，请稍后重试'
  } finally {
    loading.value = false
  }
}

watch(activeTab, () => {
  loadData()
})

onMounted(() => {
  loadData()
})

// 预约类型图标
function bookingTypeIcon(type: string): string {
  switch (type) {
    case 'call': return '📞'
    case 'offline_course': return '📍'
    case 'instructor': return '👤'
    default: return '📅'
  }
}

// 状态样式
function statusStyle(status: string): string {
  const styleMap: Record<string, string> = {
    pending: 'bg-blue-50 text-blue-600',
    confirmed: 'bg-green-50 text-green-600',
    completed: 'bg-gray-50 text-gray-500',
    cancelled: 'bg-orange-50 text-orange-500',
  }
  return styleMap[status] || 'bg-[#F0EBE5] text-[#999]'
}

// 判断活跃状态
function isActive(status: string): boolean {
  return status === 'pending' || status === 'confirmed'
}

// 取消预约
function openCancelDialog(booking: BookingItem) {
  selectedBooking.value = booking
  cancelDialogOpen.value = true
}

async function handleCancelBooking() {
  if (!selectedBooking.value) return
  cancelling.value = true
  try {
    await new Promise(resolve => setTimeout(resolve, 500))
    const idx = bookings.value.findIndex(b => b.id === selectedBooking.value!.id)
    if (idx !== -1) {
      bookings.value[idx] = { ...bookings.value[idx], status: 'cancelled', statusName: '已取消', canCancel: false }
    }
    uni.showToast({ title: '取消成功', icon: 'success' })
  } catch (e) {
    uni.showToast({ title: '取消失败', icon: 'none' })
  } finally {
    cancelling.value = false
    cancelDialogOpen.value = false
    selectedBooking.value = null
  }
}

// 添加到日历
function handleAddToCalendar(booking: BookingItem) {
  uni.showToast({ title: '已生成日历文件，请用日历应用打开导入', icon: 'none' })
}

function goBack() {
  uni.navigateBack()
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
