<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-8 space-y-4 pt-4">
    <!-- Header -->
    <view class="sticky top-0 z-30 bg-white border-b border-[#E8E0D5] px-4">
      <view class="flex items-center h-14">
        <view @click="goBack" class="p-2 -ml-2">
          <text class="text-[#2C2C2C] text-lg">←</text>
        </view>
        <text class="flex-1 text-center font-semibold text-[#2C2C2C]">设置</text>
        <view class="w-10" />
      </view>
    </view>

    <!-- Account Security -->
    <view>
      <text class="px-4 mb-2 text-xs text-[#999] font-medium block">账号安全</text>
      <view class="bg-white divide-y divide-border overflow-hidden mx-4 rounded-xl border border-[#E8E0D5]">
        <view @click="goPage('security')" class="flex items-center gap-3 px-4 py-3.5">
          <text class="text-[#999] text-lg">🛡️</text>
          <text class="flex-1 text-sm text-[#2C2C2C]">账号安全中心</text>
          <text class="text-xs text-amber-600">安全分 82</text>
          <text class="text-[#999]">›</text>
        </view>
        <view @click="goPage('change-password')" class="flex items-center gap-3 px-4 py-3.5">
          <text class="text-[#999] text-lg">🔒</text>
          <text class="flex-1 text-sm text-[#2C2C2C]">修改密码</text>
          <text class="text-xs text-[#999]">上次修改：30天前</text>
          <text class="text-[#999]">›</text>
        </view>
        <view @click="goPage('change-phone')" class="flex items-center gap-3 px-4 py-3.5">
          <text class="text-[#999] text-lg">📱</text>
          <text class="flex-1 text-sm text-[#2C2C2C]">修改手机号</text>
          <text class="text-xs text-[#999]">138****8888</text>
          <text class="text-[#999]">›</text>
        </view>
        <view @click="goPage('pay-password')" class="flex items-center gap-3 px-4 py-3.5">
          <text class="text-[#999] text-lg">💳</text>
          <text class="flex-1 text-sm text-[#2C2C2C]">支付密码</text>
          <text class="text-xs text-[#999]">已设置</text>
          <text class="text-[#999]">›</text>
        </view>
        <view @click="goPage('deactivate')" class="flex items-center gap-3 px-4 py-3.5">
          <text class="text-[#FF4D4F] text-lg">🗑️</text>
          <text class="flex-1 text-sm text-[#FF4D4F]">账号注销</text>
        </view>
      </view>
    </view>

    <!-- Notifications -->
    <view>
      <text class="px-4 mb-2 text-xs text-[#999] font-medium block">通知设置</text>
      <view class="bg-white divide-y divide-border overflow-hidden mx-4 rounded-xl border border-[#E8E0D5]">
        <view v-for="(item, i) in notifItems" :key="item.key" class="flex items-center gap-3 px-4 py-3.5">
          <text class="text-[#999] text-lg">{{ item.icon }}</text>
          <text class="flex-1 text-sm text-[#2C2C2C]">{{ item.label }}</text>
          <view @click="toggleNotif(item.key)" :class="['relative w-11 h-6 rounded-full transition-colors', notifications[item.key] ? 'bg-[#C41E3A]' : 'bg-gray-200']">
            <view :class="['absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform', notifications[item.key] ? 'translate-x-5' : '']" />
          </view>
        </view>
      </view>
    </view>

    <!-- Privacy -->
    <view>
      <text class="px-4 mb-2 text-xs text-[#999] font-medium block">隐私设置</text>
      <view class="bg-white divide-y divide-border overflow-hidden mx-4 rounded-xl border border-[#E8E0D5]">
        <view @click="goPage('blacklist')" class="flex items-center gap-3 px-4 py-3.5">
          <text class="text-[#999] text-lg">🚫</text>
          <text class="flex-1 text-sm text-[#2C2C2C]">黑名单管理</text>
          <text class="text-[#999]">›</text>
        </view>
        <view @click="showCollectDialog = true" class="flex items-center gap-3 px-4 py-3.5">
          <text class="text-[#999] text-lg">👁️</text>
          <text class="flex-1 text-sm text-[#2C2C2C]">谁可以看我的收藏</text>
          <text class="text-xs text-[#999]">{{ collectOptions.find(o => o.value === collectVisible)?.label }}</text>
          <text class="text-[#999]">›</text>
        </view>
        <view class="flex items-center gap-3 px-4 py-3.5">
          <text class="text-[#999] text-lg">🙈</text>
          <text class="flex-1 text-sm text-[#2C2C2C]">浏览记录可见</text>
          <view @click="toggleHistoryVisible" :class="['relative w-11 h-6 rounded-full transition-colors', historyVisible ? 'bg-[#C41E3A]' : 'bg-gray-200']">
            <view :class="['absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform', historyVisible ? 'translate-x-5' : '']" />
          </view>
        </view>
      </view>
    </view>

    <!-- General -->
    <view>
      <text class="px-4 mb-2 text-xs text-[#999] font-medium block">通用</text>
      <view class="bg-white divide-y divide-border overflow-hidden mx-4 rounded-xl border border-[#E8E0D5]">
        <view @click="showClearCacheDialog = true" class="flex items-center gap-3 px-4 py-3.5">
          <text class="text-[#999] text-lg">💾</text>
          <text class="flex-1 text-sm text-[#2C2C2C]">清除缓存</text>
          <text :class="['text-xs', cacheCleared ? 'text-green-500' : 'text-[#999]']">{{ cacheCleared ? '已清除' : cacheSize }}</text>
          <text class="text-[#999]">›</text>
        </view>
        <view @click="showFontDialog = true" class="flex items-center gap-3 px-4 py-3.5">
          <text class="text-[#999] text-lg">Aa</text>
          <text class="flex-1 text-sm text-[#2C2C2C]">字体大小</text>
          <text class="text-xs text-[#999]">{{ fontOptions.find(o => o.value === fontSize)?.label }}</text>
          <text class="text-[#999]">›</text>
        </view>
      </view>
    </view>

    <!-- Logout -->
    <view class="px-4">
      <view @click="showLogoutDialog = true" class="w-full py-3.5 bg-white rounded-2xl text-[#FF4D4F] font-medium text-sm border border-[#E8E0D5] flex items-center justify-center">
        <text>退出登录</text>
      </view>
    </view>

    <!-- Logout Dialog -->
    <view v-if="showLogoutDialog" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" @click="showLogoutDialog = false">
      <view class="bg-white rounded-2xl w-[80%] max-w-sm p-6" @click.stop>
        <text class="text-[#2C2C2C] font-semibold text-base text-center block">确认退出登录？</text>
        <text class="text-[#999] text-sm text-center mt-1 block">退出后需重新登录才能使用完整功能</text>
        <view class="flex gap-3 mt-5">
          <view @click="showLogoutDialog = false" class="flex-1 py-2.5 rounded-xl border border-[#E8E0D5] text-[#999] text-sm flex items-center justify-center">
            <text>取消</text>
          </view>
          <view @click="handleLogout" class="flex-1 py-2.5 rounded-xl bg-[#FF4D4F] text-white text-sm font-medium flex items-center justify-center">
            <text>退出登录</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Clear Cache Dialog -->
    <view v-if="showClearCacheDialog" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" @click="showClearCacheDialog = false">
      <view class="bg-white rounded-2xl w-[80%] max-w-sm p-6" @click.stop>
        <text class="text-[#2C2C2C] font-semibold text-base text-center block">清除缓存</text>
        <text class="text-[#999] text-sm text-center mt-1 block">将清除 <text class="text-[#C41E3A] font-medium">{{ cacheSize }}</text> 的缓存数据</text>
        <text class="text-[#999] text-xs text-center mt-1 block">不影响账号数据和下载内容</text>
        <view class="flex gap-3 mt-5">
          <view @click="showClearCacheDialog = false" class="flex-1 py-2.5 rounded-xl border border-[#E8E0D5] text-[#999] text-sm flex items-center justify-center">
            <text>取消</text>
          </view>
          <view @click="handleClearCache" class="flex-1 py-2.5 rounded-xl bg-[#C41E3A] text-white text-sm font-medium flex items-center justify-center">
            <text>确认清除</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Font Dialog -->
    <view v-if="showFontDialog" class="fixed inset-0 z-50 flex items-end justify-center bg-black/50" @click="showFontDialog = false">
      <view class="bg-white rounded-t-2xl w-full max-w-sm overflow-hidden" @click.stop>
        <text class="text-center text-sm text-[#999] py-3 border-b border-[#E8E0D5] block">字体大小</text>
        <view v-for="opt in fontOptions" :key="opt.value" @click="fontSize = opt.value; showFontDialog = false" class="flex items-center justify-between px-6 py-4 border-b border-[#E8E0D5] last:border-0">
          <text :class="['text-sm', fontSize === opt.value ? 'text-[#C41E3A] font-medium' : 'text-[#2C2C2C]']">{{ opt.label }}</text>
          <text v-if="fontSize === opt.value" class="text-[#C41E3A]">✓</text>
        </view>
        <view @click="showFontDialog = false" class="w-full py-4 text-sm text-[#999] flex items-center justify-center border-t-4 border-muted">
          <text>取消</text>
        </view>
      </view>
    </view>

    <!-- Collect Visible Dialog -->
    <view v-if="showCollectDialog" class="fixed inset-0 z-50 flex items-end justify-center bg-black/50" @click="showCollectDialog = false">
      <view class="bg-white rounded-t-2xl w-full max-w-sm overflow-hidden" @click.stop>
        <text class="text-center text-sm text-[#999] py-3 border-b border-[#E8E0D5] block">谁可以看我的收藏</text>
        <view v-for="opt in collectOptions" :key="opt.value" @click="collectVisible = opt.value; showCollectDialog = false" class="flex items-center justify-between px-6 py-4 border-b border-[#E8E0D5] last:border-0">
          <text :class="['text-sm', collectVisible === opt.value ? 'text-[#C41E3A] font-medium' : 'text-[#2C2C2C]']">{{ opt.label }}</text>
          <text v-if="collectVisible === opt.value" class="text-[#C41E3A]">✓</text>
        </view>
        <view @click="showCollectDialog = false" class="w-full py-4 text-sm text-[#999] flex items-center justify-center border-t-4 border-muted">
          <text>取消</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref } from 'vue'

const showLogoutDialog = ref(false)
const showClearCacheDialog = ref(false)
const showFontDialog = ref(false)
const showCollectDialog = ref(false)

const cacheSize = '47.3 MB'
const cacheCleared = ref(false)
const historyVisible = ref(true)

const notifications = ref<Record<string, boolean>>({
  message: true,
  course: true,
  live: false,
  interact: true,
  system: true,
})

const fontSize = ref<'small' | 'medium' | 'large'>('medium')
const collectVisible = ref<'public' | 'friends' | 'private'>('public')

const collectOptions = [
  { label: '公开', value: 'public' },
  { label: '仅好友', value: 'friends' },
  { label: '仅自己', value: 'private' },
]

const fontOptions = [
  { label: '小', value: 'small' },
  { label: '中（推荐）', value: 'medium' },
  { label: '大', value: 'large' },
]

const notifItems = [
  { key: 'message', label: '新消息通知', icon: '🔔' },
  { key: 'course', label: '课程提醒', icon: '📚' },
  { key: 'live', label: '直播提醒', icon: '📡' },
  { key: 'interact', label: '互动提醒', icon: '💬' },
  { key: 'system', label: '系统通知', icon: '⚙️' },
]

function toggleNotif(key: string) {
  notifications.value[key] = !notifications.value[key]
}

function toggleHistoryVisible() {
  historyVisible.value = !historyVisible.value
}

function handleClearCache() {
  cacheCleared.value = true
  showClearCacheDialog.value = false
  setTimeout(() => { cacheCleared.value = false }, 3000)
  uni.showToast({ title: '已清除', icon: 'success' })
}

function handleLogout() {
  showLogoutDialog.value = false
  uni.reLaunch({ url: '/pages/login/index' })
}

function goBack() { uni.navigateBack() }
function goPage(p: string) { uni.navigateTo({ url: `/pages/mine/${p}/index` }) }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
