<script setup lang="ts">
import { ref } from 'vue'

const activeTab = ref('overview')
const searchQuery = ref('')

const tabs = [
  { id: 'overview', label: '概览' },
  { id: 'approvals', label: '申请审核' },
  { id: 'members', label: '成员管理' },
  { id: 'activities', label: '活动管理' },
  { id: 'finance', label: '财务管理' },
]

const adminData = {
  role: '主席',
  name: '张道源',
  stats: {
    totalMembers: 128,
    pendingApprovals: 5,
    monthlyActivities: 12,
    totalIncome: 1280000,
    monthIncome: 86000,
    pendingRefunds: 3,
  }
}

const quickActions = [
  { icon: '👥', label: '成员管理', tab: 'members' },
  { icon: '📅', label: '发布活动', tab: 'activities' },
  { icon: '⭐', label: '推荐老师', href: '/institute/teacher-pool' },
  { icon: '⚙️', label: '研究院设置', href: '/mine/institute/settings' },
]

const pendingApprovals = [
  { id: 1, name: '李明轩', applyTime: '2024-03-15', circleName: '紫微研习社', circleMembers: 256, reason: '深耕紫微斗数研究10年' },
  { id: 2, name: '王德华', applyTime: '2024-03-14', circleName: '风水堪舆圈', circleMembers: 189, reason: '希望与同行交流切磋' },
  { id: 3, name: '陈易卿', applyTime: '2024-03-13', circleName: '易经占卜社', circleMembers: 312, reason: '愿为平台贡献师资力量' },
]

const refundApprovals = [
  { id: 1, name: '赵启明', applyTime: '2024-03-10', taskCompletion: 100, amount: 10000 },
  { id: 2, name: '钱学礼', applyTime: '2024-03-08', taskCompletion: 95, amount: 10000 },
]

const memberList = [
  { id: 1, name: '李明轩', role: 'member', joinTime: '2024-01-15', taskProgress: 85, expiryDays: 280 },
  { id: 2, name: '王德华', role: 'vice_chairman', joinTime: '2023-06-20', taskProgress: 100, expiryDays: 120 },
  { id: 3, name: '陈易卿', role: 'member', joinTime: '2024-02-01', taskProgress: 60, expiryDays: 320 },
  { id: 4, name: '周文昌', role: 'secretary', joinTime: '2023-03-10', taskProgress: 100, expiryDays: 45 },
]

const expiringMembers = memberList.filter(m => m.expiryDays <= 60)

function roleInfo(role: string): { label: string; color: string } {
  const map: Record<string, { label: string; color: string }> = {
    chairman: { label: '主席', color: 'bg-amber-500 text-white' },
    vice_chairman: { label: '副主席', color: 'bg-purple-500 text-white' },
    secretary: { label: '秘书长', color: 'bg-blue-500 text-white' },
    member: { label: '成员', color: 'bg-[#F0EBE5] text-[#999]' },
  }
  return map[role] || { label: role, color: 'bg-[#F0EBE5] text-[#999]' }
}

function handleQuickAction(item: any) {
  if (item.tab) activeTab.value = item.tab
  if (item.href) uni.navigateTo({ url: item.href })
}

function goBack() { uni.navigateBack() }
</script>

