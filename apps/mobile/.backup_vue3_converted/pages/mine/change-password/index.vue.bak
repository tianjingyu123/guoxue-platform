<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- nav -->
    <view class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5]">
      <view class="flex items-center h-14 px-4 gap-3">
        <view @click="goBack" class="p-1 -ml-1">
          <text class="text-[#2C2C2C]">&#8592;</text>
        </view>
        <text class="font-semibold text-base text-[#2C2C2C]">修改密码</text>
      </view>
    </view>

    <view class="flex-1 px-4 py-6 space-y-6 w-full">
      <!-- tip -->
      <view class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-700 leading-relaxed">
        为保护账号安全，修改密码后所有设备将重新登录。请妥善保管新密码。
      </view>

      <!-- form -->
      <view class="bg-white rounded-2xl shadow-sm p-5 space-y-4">
        <!-- 当前密码 -->
        <view class="space-y-1.5">
          <text class="text-sm font-medium text-[#2C2C2C]">当前密码</text>
          <view :class="['flex items-center gap-2 px-4 h-12 rounded-xl border bg-[#FAF8F5]', errors.oldPwd ? 'border-red-500' : 'border-[#E8E0D5]']">
            <text class="text-[#999] shrink-0">🔒</text>
            <input :type="showOld ? 'text' : 'password'" v-model="oldPwd" placeholder="请输入当前登录密码" class="flex-1 bg-transparent text-sm text-[#2C2C2C] placeholder:text-[#999] outline-none" />
            <view @click="showOld = !showOld" class="text-[#999] p-1">
              <text>{{ showOld ? '🙈' : '👁️' }}</text>
            </view>
          </view>
          <text v-if="errors.oldPwd" class="text-xs text-red-500">{{ errors.oldPwd }}</text>
        </view>

        <!-- 新密码 -->
        <view class="space-y-1.5">
          <text class="text-sm font-medium text-[#2C2C2C]">新密码</text>
          <view :class="['flex items-center gap-2 px-4 h-12 rounded-xl border bg-[#FAF8F5]', errors.newPwd ? 'border-red-500' : 'border-[#E8E0D5]']">
            <text class="text-[#999] shrink-0">🔒</text>
            <input :type="showNew ? 'text' : 'password'" v-model="newPwd" placeholder="请设置新密码" autocomplete="new-password" class="flex-1 bg-transparent text-sm text-[#2C2C2C] placeholder:text-[#999] outline-none" />
            <view @click="showNew = !showNew" class="text-[#999] p-1">
              <text>{{ showNew ? '🙈' : '👁️' }}</text>
            </view>
          </view>
          <text v-if="errors.newPwd" class="text-xs text-red-500">{{ errors.newPwd }}</text>
        </view>

        <!-- strength bar -->
        <view v-if="newPwd.length > 0" class="space-y-1.5">
          <view class="flex items-center justify-between text-xs">
            <text class="text-[#999]">密码强度</text>
            <text :class="strength.score <= 2 ? 'text-orange-500' : strength.score === 3 ? 'text-yellow-600' : 'text-green-600'">{{ strength.label }}</text>
          </view>
          <view class="flex gap-1">
            <view v-for="i in 5" :key="i" :class="['h-1.5 flex-1 rounded-full', i <= strength.score ? strength.color : 'bg-[#F0EBE5]']" />
          </view>
        </view>

        <!-- 确认新密码 -->
        <view class="space-y-1.5">
          <text class="text-sm font-medium text-[#2C2C2C]">确认新密码</text>
          <view :class="['flex items-center gap-2 px-4 h-12 rounded-xl border bg-[#FAF8F5]', errors.confirmPwd ? 'border-red-500' : 'border-[#E8E0D5]']">
            <text class="text-[#999] shrink-0">🔒</text>
            <input :type="showConfirm ? 'text' : 'password'" v-model="confirmPwd" placeholder="请再次输入新密码" class="flex-1 bg-transparent text-sm text-[#2C2C2C] placeholder:text-[#999] outline-none" />
            <view @click="showConfirm = !showConfirm" class="text-[#999] p-1">
              <text>{{ showConfirm ? '🙈' : '👁️' }}</text>
            </view>
          </view>
          <text v-if="errors.confirmPwd" class="text-xs text-red-500">{{ errors.confirmPwd }}</text>
        </view>
      </view>

      <!-- rules checklist -->
      <view class="bg-white rounded-2xl shadow-sm p-5 space-y-2.5">
        <text class="text-sm font-medium text-[#2C2C2C]">密码要求</text>
        <view v-for="rule in rules" :key="rule.label" class="flex items-center gap-2 text-sm">
          <text v-if="newPwd.length > 0 && rule.pass(newPwd)" class="text-green-500 shrink-0">✅</text>
          <text v-else-if="newPwd.length > 0" class="text-[#999] shrink-0">❌</text>
          <view v-else class="w-4 h-4 rounded-full border border-[#E8E0D5] shrink-0" />
          <text :class="newPwd.length > 0 && rule.pass(newPwd) ? 'text-green-600' : 'text-[#999]'">{{ rule.label }}</text>
        </view>
      </view>
    </view>

    <!-- submit -->
    <view class="sticky bottom-0 bg-[#FAF8F5] border-t border-[#E8E0D5] px-4 py-4">
      <view
        @click="handleSubmit"
        :class="['w-full h-12 rounded-xl bg-[#C41E3A] text-white font-semibold text-sm flex items-center justify-center gap-2', loading ? 'opacity-60' : '']"
      >
        <text v-if="loading" class="inline-block animate-spin">⟳</text>
        <text>{{ loading ? ' 提交中...' : '确认修改' }}</text>
      </view>
    </view>

    <!-- toast -->
    <view v-if="toast" :class="['fixed top-20 left-1/2 transform -translate-x-1/2 z-50 px-5 py-2.5 rounded-xl text-white text-sm font-medium shadow-lg', toast.type === 'success' ? 'bg-green-600' : 'bg-red-600']">
      {{ toast.msg }}
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, reactive, computed } from 'vue'

const oldPwd = ref('')
const newPwd = ref('')
const confirmPwd = ref('')
const showOld = ref(false)
const showNew = ref(false)
const showConfirm = ref(false)
const loading = ref(false)
const toast = ref<{ msg: string; type: 'success' | 'error' } | null>(null)
const errors = reactive<Record<string, string>>({})

function calcStrength(pwd: string): { score: number; label: string; color: string } {
  if (!pwd) return { score: 0, label: '', color: '' }
  let score = 0
  if (pwd.length >= 8) score++
  if (pwd.length >= 12) score++
  if (/[A-Z]/.test(pwd)) score++
  if (/[0-9]/.test(pwd)) score++
  if (/[^A-Za-z0-9]/.test(pwd)) score++
  if (score <= 1) return { score: 1, label: '弱', color: 'bg-red-500' }
  if (score <= 2) return { score: 2, label: '较弱', color: 'bg-orange-400' }
  if (score <= 3) return { score: 3, label: '中', color: 'bg-yellow-400' }
  if (score <= 4) return { score: 4, label: '强', color: 'bg-green-400' }
  return { score: 5, label: '极强', color: 'bg-green-600' }
}

const strength = computed(() => calcStrength(newPwd.value))

interface Rule {
  label: string
  pass: (p: string) => boolean
}

const rules: Rule[] = [
  { label: '长度至少 8 位', pass: (p) => p.length >= 8 },
  { label: '包含大写字母', pass: (p) => /[A-Z]/.test(p) },
  { label: '包含数字', pass: (p) => /[0-9]/.test(p) },
  { label: '包含特殊符号', pass: (p) => /[^A-Za-z0-9]/.test(p) },
]

function validate() {
  Object.keys(errors).forEach(k => delete (errors as any)[k])
  if (!oldPwd.value) errors.oldPwd = '请输入当前密码'
  if (!newPwd.value) errors.newPwd = '请输入新密码'
  else if (newPwd.value.length < 8) errors.newPwd = '密码长度至少 8 位'
  else if (newPwd.value === oldPwd.value) errors.newPwd = '新密码不能与当前密码相同'
  if (!confirmPwd.value) errors.confirmPwd = '请确认新密码'
  else if (confirmPwd.value !== newPwd.value) errors.confirmPwd = '两次输入的密码不一致'
  return Object.keys(errors).length === 0
}

async function handleSubmit() {
  if (!validate()) return
  loading.value = true
  try {
    await new Promise(r => setTimeout(r, 1200))
    toast.value = { msg: '密码修改成功', type: 'success' }
    setTimeout(() => { goBack() }, 1000)
  } catch {
    toast.value = { msg: '修改失败，请稍后重试', type: 'error' }
  } finally {
    loading.value = false
  }
}

function goBack() {
  uni.navigateBack()
}
</script>

<style scoped>
.animate-spin {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
</style>
