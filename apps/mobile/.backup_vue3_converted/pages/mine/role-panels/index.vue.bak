<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between h-14 px-4">
        <view @click="goBack" class="p-2 -ml-2"><text class="text-[#2C2C2C] text-xl">←</text></view>
        <text class="font-semibold text-[#2C2C2C] text-base">角色面板</text>
        <view class="w-9" />
      </view>
    </view>

    <!-- 骨架屏 -->
    <view v-if="loading" class="flex-1 p-4">
      <view v-for="i in 3" :key="i" class="bg-white rounded-2xl p-4 mb-3 border border-[#E8E0D5] animate-pulse">
        <view class="flex items-center gap-3">
          <view class="w-10 h-10 rounded-full bg-[#F0EBE5]" />
          <view class="flex-1">
            <view class="w-28 h-4 bg-[#F0EBE5] rounded mb-2" />
            <view class="w-36 h-3 bg-[#F0EBE5] rounded" />
          </view>
        </view>
      </view>
    </view>

    <!-- 主内容 -->
    <scroll-view v-else scroll-y class="flex-1 p-4">
      <!-- 当前角色信息 -->
      <view class="bg-gradient-to-br from-[#C41E3A] to-[#E74C3C] rounded-2xl p-5 mb-4 shadow-md">
        <view class="flex items-center gap-3 mb-3">
          <view class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center">
            <text class="text-2xl">{{ currentRole.icon }}</text>
          </view>
          <view class="flex-1">
            <text class="text-white text-base font-semibold block">{{ currentRole.name }}</text>
            <text class="text-xs text-white/80">{{ currentRole.desc }}</text>
          </view>
          <view class="px-2.5 py-1 bg-white/20 rounded-full">
            <text class="text-xs text-white">当前身份</text>
          </view>
        </view>
        <view class="flex gap-4">
          <view class="flex-1 bg-white/10 rounded-lg p-2.5 text-center">
            <text class="text-white text-lg font-bold block">{{ currentRole.stats.actions }}</text>
            <text class="text-xs text-white/70">今日操作</text>
          </view>
          <view class="flex-1 bg-white/10 rounded-lg p-2.5 text-center">
            <text class="text-white text-lg font-bold block">{{ currentRole.stats.alerts }}</text>
            <text class="text-xs text-white/70">待处理</text>
          </view>
        </view>
      </view>

      <!-- 角色切换标题 -->
      <view class="flex items-center gap-2 mb-3 px-1">
        <text class="text-lg">🔄</text>
        <text class="text-sm font-semibold text-[#2C2C2C]">切换角色</text>
      </view>

      <!-- 角色列表 -->
      <view v-for="r in roles" :key="r.key"
        :class="['bg-white rounded-2xl p-4 mb-3 border', r.active ? 'border-[#C41E3A] ring-1 ring-[#C41E3A]/20' : 'border-[#E8E0D5]']"
        @click="switchRole(r.key)">
        <view class="flex items-center gap-3">
          <view :class="['w-12 h-12 rounded-xl flex items-center justify-center text-2xl', r.active ? 'bg-[#C41E3A]/10' : 'bg-[#F0EBE5]']">
            {{ r.icon }}
          </view>
          <view class="flex-1">
            <view class="flex items-center gap-2">
              <text class="text-sm font-medium text-[#2C2C2C]">{{ r.name }}</text>
              <view v-if="r.active" class="px-2 py-0.5 bg-[#C41E3A]/10 rounded-full">
                <text class="text-[10px] text-[#C41E3A]">使用中</text>
              </view>
              <view v-if="r.badge" class="px-2 py-0.5 bg-orange-50 rounded-full">
                <text class="text-[10px] text-orange-500">{{ r.badge }}</text>
              </view>
            </view>
            <text class="text-xs text-[#999] block">{{ r.desc }}</text>
          </view>
          <text v-if="!r.active" class="text-[#ccc] text-lg">›</text>
          <text v-else class="text-[#C41E3A] text-lg">✓</text>
        </view>

        <!-- 角色权限标签 -->
        <view v-if="r.active" class="flex flex-wrap gap-1.5 mt-3 pt-3 border-t border-[#FAF8F5]">
          <view v-for="perm in r.permissions" :key="perm"
            class="px-2 py-0.5 bg-[#FAF8F5] rounded text-[11px] text-[#666]">
            {{ perm }}
          </view>
        </view>
      </view>

      <!-- 角色权益对比 -->
      <view class="bg-white rounded-2xl p-4 mb-3 border border-[#E8E0D5]">
        <view class="flex items-center gap-2 mb-3">
          <text class="text-lg">📊</text>
          <text class="text-sm font-semibold text-[#2C2C2C]">角色权益对比</text>
        </view>

        <!-- 对比表头 -->
        <view class="flex border-b border-[#E8E0D5] pb-2 mb-2">
          <view class="flex-[2]"><text class="text-xs text-[#999]">权益项</text></view>
          <view v-for="r in roles" :key="r.key" class="flex-1 text-center">
            <text class="text-xs font-medium" :class="r.active ? 'text-[#C41E3A]' : 'text-[#999]'">{{ r.shortName }}</text>
          </view>
        </view>

        <!-- 对比行 -->
        <view v-for="(b, i) in benefits" :key="i" class="flex items-center py-2.5 border-b border-[#FAF8F5] last:border-b-0">
          <view class="flex-[2]">
            <text class="text-xs text-[#2C2C2C]">{{ b.label }}</text>
          </view>
          <view v-for="(v, j) in b.values" :key="j" class="flex-1 text-center">
            <text :class="['text-xs', v ? 'text-green-500' : 'text-[#ccc]']">{{ v ? '✓' : '—' }}</text>
          </view>
        </view>
      </view>

      <!-- 说明 -->
      <view class="bg-[#F0EBE5]/50 rounded-xl p-4 mb-4">
        <view class="flex items-start gap-2">
          <text class="text-base">ℹ</text>
          <text class="text-xs text-[#999] leading-relaxed">
            不同角色拥有不同的管理权限。切换角色后，您的操作将受该角色权限限制。如需开通新角色，请联系平台运营人员。
          </text>
        </view>
      </view>

      <view class="h-5" />
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
import { ref, reactive, onMounted } from 'vue'

const loading = ref(true)
const activeKey = ref('operator-panel')

interface Role {
  key: string
  icon: string
  name: string
  shortName: string
  desc: string
  badge?: string
  active: boolean
  permissions: string[]
  stats: { actions: number; alerts: number }
}

const roles = reactive<Role[]>([
  {
    key: 'operator-panel', icon: '🔧', name: '运营商面板', shortName: '运营商',
    desc: '管理站长团队和运营数据', badge: '高级', active: true,
    permissions: ['团队管理', '数据看板', '收益结算', '分站审批', '公告发布'],
    stats: { actions: 28, alerts: 3 },
  },
  {
    key: 'station-master-panel', icon: '🏠', name: '分站长面板', shortName: '分站长',
    desc: '管理分站课程和会员', active: false,
    permissions: ['会员管理', '课程发布', '分站数据', '内容审核'],
    stats: { actions: 15, alerts: 1 },
  },
  {
    key: 'admin-panel', icon: '⚙️', name: '管理员面板', shortName: '管理员',
    desc: '平台管理和审核操作', active: false,
    permissions: ['用户审核', '内容管理', '系统设置', '日志查看'],
    stats: { actions: 42, alerts: 7 },
  },
])

const currentRole = computed(() => roles.find(r => r.active)!)

const benefits = [
  { label: '数据看板', values: [true, true, false] },
  { label: '收益管理', values: [true, false, false] },
  { label: '团队管理', values: [true, false, false] },
  { label: '会员管理', values: [false, true, false] },
  { label: '课程发布', values: [false, true, false] },
  { label: '内容审核', values: [false, false, true] },
  { label: '系统设置', values: [false, false, true] },
  { label: '分站审批', values: [true, false, false] },
  { label: '公告发布', values: [true, true, false] },
]

import { computed } from 'vue'

function switchRole(key: string) {
  if (key === activeKey.value) return
  uni.showModal({
    title: '切换角色',
    content: `确定切换到${roles.find(r => r.key === key)?.name}吗？`,
    success: (res) => {
      if (res.confirm) {
        roles.forEach(r => { r.active = r.key === key })
        activeKey.value = key
        uni.showToast({ title: `已切换到${roles.find(r => r.key === key)?.name}`, icon: 'none' })
      }
    },
  })
}

onMounted(() => {
  setTimeout(() => { loading.value = false }, 1000)
})

function goBack() { uni.navigateBack() }
function goRole(key: string) { uni.navigateTo({ url: `/pages/mine/role-panels/${key}/index` }) }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
