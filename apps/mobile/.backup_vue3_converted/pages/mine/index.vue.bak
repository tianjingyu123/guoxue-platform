<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

const user = {
  name: '张三丰',
  bio: '易学爱好者 | 八字研习中',
  isVip: true,
  vipLevel: '黄金会员',
  vipExpiry: '2025-12-31',
  vipDaysLeft: 234,
  isVerified: true,
  roles: [
    { type: 'circle_owner' as const, name: '张氏命理研习社', id: 1 },
    { type: 'teacher' as const, name: '八字入门精讲', id: 1 },
    { type: 'streamer' as const, name: '直播间', id: 1 },
  ],
  messages: { system: 2, interaction: 5, transaction: 1 },
  checkIn: { todayChecked: false, continuousDays: 7, totalPoints: 350 },
  stats: { following: 128, followers: 1024, likes: 3680 },
  coins: 520,
  coupons: 3,
  points: 1280,
  orders: { pending: 2, shipped: 1, received: 3, refund: 0 },
  continueLearning: {
    id: 1,
    title: '八字入门实战课',
    progress: 45,
    lastLesson: '第三章：天干地支详解',
  },
}

const greeting = ref('')

onMounted(() => {
  const hour = new Date().getHours()
  if (hour < 6) greeting.value = '夜深了'
  else if (hour < 12) greeting.value = '早上好'
  else if (hour < 14) greeting.value = '中午好'
  else if (hour < 18) greeting.value = '下午好'
  else greeting.value = '晚上好'
})

const totalUnread = computed(() => user.messages.system + user.messages.interaction + user.messages.transaction)

const orderStatus = [
  { key: 'pending', label: '待付款', icon: '💳', count: user.orders.pending, href: '/pages/orders/index?status=pending' },
  { key: 'shipped', label: '待发货', icon: '📦', count: user.orders.shipped, href: '/pages/orders/index?status=shipped' },
  { key: 'received', label: '待收货', icon: '🚚', count: user.orders.received, href: '/pages/orders/index?status=received' },
  { key: 'refund', label: '售后', icon: '🔄', count: user.orders.refund, href: '/pages/orders/index?status=refund' },
]

const quickFunctions = [
  { icon: '🧭', label: '排盘记录', href: '/pages/paipan/history/index', color: 'text-[#C41E3A]' },
  { icon: '📚', label: '我的课程', href: '/pages/learning/index', color: 'text-[#4A90D9]' },
  { icon: '👥', label: '我的圈子', href: '/pages/circles/mine/index', color: 'text-[#722ED1]' },
  { icon: '📝', label: '我的笔记', href: '/pages/notes/index', color: 'text-[#C9A96E]' },
  { icon: '❤️', label: '我的收藏', href: '/pages/favorites/index', color: 'text-[#C41E3A]' },
  { icon: '📄', label: '我的电子书', href: '/pages/downloads/index', color: 'text-[#52C41A]' },
  { icon: '🕐', label: '浏览历史', href: '/pages/history/index', color: 'text-[#64748B]' },
  { icon: '❓', label: '帮助中心', href: '/pages/help/index', color: 'text-[#999]' },
]

const recommendations = [
  { id: 1, type: 'course', title: '紫微斗数入门精讲', price: 199, originalPrice: 399, tag: '热门' },
  { id: 2, type: 'product', title: '专业罗盘套装', price: 298, originalPrice: 598, tag: '特惠' },
  { id: 3, type: 'course', title: '六爻预测实战班', price: 299, originalPrice: 499, tag: '新课' },
  { id: 4, type: 'product', title: '渊海子平精装版', price: 68, originalPrice: 128, tag: '' },
]

function getRoleConfig(type: string) {
  const configs: Record<string, { label: string; icon: string; color: string; bgColor: string }> = {
    user: { label: '普通用户', icon: '👤', color: 'text-[#999]', bgColor: 'bg-[#F0EDE8]' },
    circle_owner: { label: '圈主后台', icon: '👑', color: 'text-[#C9A96E]', bgColor: 'bg-[#C9A96E]/10' },
    teacher: { label: '讲师后台', icon: '🎓', color: 'text-[#4A90D9]', bgColor: 'bg-[#4A90D9]/10' },
    streamer: { label: '主播中心', icon: '📻', color: 'text-[#C41E3A]', bgColor: 'bg-[#C41E3A]/10' },
    creator: { label: '创作中心', icon: '📹', color: 'text-[#722ED1]', bgColor: 'bg-[#722ED1]/10' },
    station_owner: { label: '站长后台', icon: '🏆', color: 'text-[#52C41A]', bgColor: 'bg-[#52C41A]/10' },
  }
  return configs[type] || configs.user
}

function getRoleHref(type: string, id: number): string {
  const paths: Record<string, string> = {
    circle_owner: '/pages/circle/id-detail/settings/index?id=' + id,
    teacher: '/pages/manage/index',
    streamer: '/pages/creator/live/console/index',
    creator: '/pages/videos/creator/index',
  }
  return paths[type] || '/pages/mine/index'
}

function goPage(path: string) {
  uni.navigateTo({ url: path })
}

function goBack() { uni.navigateBack() }
</script>

