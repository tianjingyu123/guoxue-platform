            <view class="w-10 h-10 rounded-xl flex items-center justify-center" :class="getRoleConfig(role.type).bgColor">
              <text :class="getRoleConfig(role.type).color">{{ getRoleConfig(role.type).icon }}</text>
            </view>
            <view class="flex-1 min-w-0">
              <text class="text-sm font-medium text-[#2C2C2C] block truncate">{{ getRoleConfig(role.type).label }}</text>
              <text class="text-[10px] text-[#999] block truncate">{{ role.name }}</text>
            </view>
            <text class="text-[#999]">›</text>
