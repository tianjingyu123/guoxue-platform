<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 加载骨架屏 -->
    <view v-if="loading" class="pb-6">
      <view class="relative">
        <view class="h-40 bg-[#F0EDE8] animate-pulse" />
        <view class="absolute -bottom-12 left-4">
          <view class="w-24 h-24 rounded-full bg-[#F0EDE8] animate-pulse border-4 border-[#FAF8F5]" />
        </view>
      </view>
      <view class="px-4 pt-14 space-y-4">
        <view class="h-6 w-32 bg-[#F0EDE8] rounded animate-pulse" />
        <view class="h-16 w-full bg-[#F0EDE8] rounded animate-pulse" />
        <view class="flex gap-8 justify-around py-4">
          <view v-for="i in 3" :key="i" class="h-12 w-16 bg-[#F0EDE8] rounded animate-pulse" />
        </view>
        <view class="flex gap-3">
          <view class="h-10 flex-1 bg-[#F0EDE8] rounded-full animate-pulse" />
          <view class="h-10 flex-1 bg-[#F0EDE8] rounded-full animate-pulse" />
        </view>
      </view>
    </view>

    <!-- 错误状态 -->
    <view v-else-if="error" class="flex flex-col items-center justify-center min-h-screen px-4">
      <text class="text-5xl mb-4">😵</text>
      <text class="text-base font-medium text-[#2C2C2C] mb-2">加载失败</text>
      <text class="text-sm text-[#999] mb-6">{{ error }}</text>
      <view @click="loadProfile" class="px-8 py-2.5 bg-[#C41E3A] text-white rounded-full text-sm font-medium">
        重试
      </view>
    </view>

    <!-- 用户不存在 -->
    <view v-else-if="!profileData" class="flex flex-col items-center justify-center min-h-screen">
      <text class="text-5xl mb-4">👤</text>
      <text class="text-base font-medium text-[#2C2C2C] mb-2">用户不存在</text>
      <text class="text-sm text-[#999]">该用户可能已注销或设置了隐私保护</text>
    </view>

    <!-- 主内容 -->
    <view v-else class="pb-6">
      <!-- 封面背景区 -->
      <view class="relative">
        <view
          class="h-40"
          :style="profileData.profile.coverImage
            ? { backgroundImage: `url(${profileData.profile.coverImage})`, backgroundSize: 'cover', backgroundPosition: 'center' }
            : { background: 'linear-gradient(135deg, rgba(196,30,58,0.3), rgba(201,169,110,0.2), rgba(240,237,232,0.5))' }"
        />

        <!-- 顶部透明导航 -->
        <view class="absolute top-0 left-0 right-0 flex items-center justify-between px-4 pt-12">
          <view @click="goBack" class="p-2 rounded-full bg-black/20">
            <text class="text-white text-lg">←</text>
          </view>
          <view class="flex items-center gap-2">
            <view @click="handleShare" class="p-2 rounded-full bg-black/20">
              <text class="text-white text-base">📤</text>
            </view>
            <view class="relative">
              <view @click="showMoreMenu = !showMoreMenu" class="p-2 rounded-full bg-black/20">
                <text class="text-white text-base">⋯</text>
              </view>
              <!-- 更多菜单 -->
              <view v-if="showMoreMenu" class="fixed inset-0 z-40" @click="showMoreMenu = false" />
              <view v-if="showMoreMenu" class="absolute right-0 top-full mt-2 w-32 bg-white rounded-xl shadow-lg z-50 overflow-hidden">
                <view @click="handleReport" class="flex items-center gap-2 px-4 py-3 text-sm text-[#2C2C2C] hover:bg-[#FAF8F5]">
                  <text>🚩</text>
                  <text>举报</text>
                </view>
                <view @click="handleBlock" class="flex items-center gap-2 px-4 py-3 text-sm text-[#C41E3A] hover:bg-[#FAF8F5]">
                  <text>🚫</text>
                  <text>拉黑</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 头像（悬垂覆盖） -->
        <view class="absolute -bottom-12 left-4">
          <view class="w-24 h-24 rounded-full border-4 border-[#FAF8F5] bg-gradient-to-br from-[#C41E3A]/20 to-[#C9A96E]/20 flex items-center justify-center overflow-hidden relative">
            <text class="text-[#C41E3A] text-2xl font-bold">{{ profileData.profile.nickname[0] }}</text>
            <!-- 认证徽章 -->
            <view v-if="profileData.profile.verified" class="absolute -bottom-1 -right-1 w-7 h-7 rounded-full bg-[#C9A96E] flex items-center justify-center border-2 border-[#FAF8F5]">
              <text class="text-white text-xs">✓</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 用户信息区 -->
      <view class="px-4 pt-14">
        <view class="flex items-start justify-between">
          <view class="flex-1">
            <view class="flex items-center gap-2">
              <text class="text-xl font-bold text-[#2C2C2C]">{{ profileData.profile.nickname }}</text>
              <view v-if="profileData.profile.verified" class="px-1.5 py-0 bg-[#C41E3A]/10 text-[#C41E3A] text-[10px] rounded">
                {{ profileData.profile.verifiedTitle }}
              </view>
            </view>
            <text v-if="profileData.profile.bio" class="text-sm text-[#999] mt-2 leading-relaxed block">{{ profileData.profile.bio }}</text>
            <view class="flex items-center gap-2 mt-2">
              <view class="px-2 py-0.5 bg-[#C9A96E]/10 text-[#C9A96E] text-xs rounded border border-[#C9A96E]/30">
                Lv.{{ profileData.profile.level }} {{ profileData.profile.levelName }}
              </view>
              <view v-if="profileData.isMutualFollow" class="px-2 py-0.5 bg-pink-50 text-pink-600 text-xs rounded border border-pink-200">
                互相关注
              </view>
            </view>
          </view>
        </view>

        <!-- 数据看板 -->
        <view class="flex items-center justify-around py-4 mt-4 bg-[#F0EDE8]/50 rounded-xl">
          <view class="text-center flex-1" @click="goFollowing">
            <text class="text-lg font-bold text-[#2C2C2C] block">{{ formatNumber(profileData.stats.followingCount) }}</text>
            <text class="text-xs text-[#999]">关注</text>
          </view>
          <view class="w-px h-8 bg-[#E8E0D5]" />
          <view class="text-center flex-1" @click="goFollowers">
            <text class="text-lg font-bold text-[#2C2C2C] block">{{ formatNumber(profileData.stats.followerCount) }}</text>
            <text class="text-xs text-[#999]">粉丝</text>
          </view>
          <view class="w-px h-8 bg-[#E8E0D5]" />
          <view class="text-center flex-1">
            <text class="text-lg font-bold text-[#2C2C2C] block">{{ formatNumber(profileData.stats.likeCount) }}</text>
            <text class="text-xs text-[#999]">获赞</text>
          </view>
        </view>

        <!-- 操作按钮行（非本人时显示） -->
        <view v-if="!profileData.isSelf" class="flex gap-3 mt-4">
          <view
            @click="handleFollow"
            :class="['flex-1 py-2.5 rounded-full text-center text-sm font-medium', followLoading ? 'opacity-50' : '', profileData.isFollowing ? 'bg-[#F0EDE8] text-[#999]' : 'bg-[#C41E3A] text-white']"
          >
            <text>{{ profileData.isFollowing ? '已关注' : '+ 关注' }}</text>
          </view>
          <view @click="sendMessage" class="flex-1 py-2.5 rounded-full text-center text-sm font-medium border border-[#E8E0D5] text-[#666] bg-white">
            <text>发私信</text>
          </view>
        </view>
      </view>

      <!-- 内容Tab栏（sticky） -->
      <view class="sticky top-0 z-30 bg-[#FAF8F5]/95 border-b border-[#E8E0D5] mt-6">
        <scroll-view scroll-x class="flex items-center px-4">
          <view
            v-for="tab in contentTabs" :key="tab.id"
            @click="activeTab = tab.id"
            :class="['px-4 py-3 text-sm font-medium whitespace-nowrap relative', activeTab === tab.id ? 'text-[#C41E3A]' : 'text-[#999]']"
          >
            {{ tab.label }}
            <view v-if="activeTab === tab.id" class="absolute bottom-0 left-1/2 -translate-x-1/2 w-6 h-0.5 bg-[#C41E3A] rounded-full" />
          </view>
        </scroll-view>
      </view>

      <!-- 内容列表 -->
      <view class="px-4 py-4">
        <!-- 帖子加载骨架屏 -->
        <view v-if="postsLoading" class="space-y-3">
          <view v-for="i in 3" :key="i" class="h-32 bg-[#F0EDE8] rounded-lg animate-pulse" />
        </view>

        <!-- 空状态 -->
        <view v-else-if="filteredPosts.length === 0" class="py-12 text-center">
          <text class="text-[#ccc] text-sm">暂无内容</text>
        </view>

        <!-- 动态Tab：混合展示 -->
        <view v-else-if="activeTab === 'all'" class="space-y-3">
          <view v-for="post in filteredPosts" :key="post.id" @click="goContent(post)">
            <!-- 视频卡片 -->
            <view v-if="post.type === 'video'" class="bg-white rounded-xl overflow-hidden shadow-sm">
              <view class="relative aspect-[9/16] bg-[#F0EDE8] overflow-hidden flex items-center justify-center">
                <text class="text-5xl opacity-20">🎬</text>
                <view class="absolute inset-0 flex items-center justify-center">
                  <view class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center">
                    <text class="text-white text-lg">▶</text>
                  </view>
                </view>
              </view>
              <view class="p-2">
                <text class="text-xs text-[#2C2C2C] line-clamp-2 block">{{ post.title || post.content }}</text>
                <view class="flex items-center gap-2 mt-1 text-[10px] text-[#999]">
                  <text>❤️ {{ post.likeCount }}</text>
                </view>
              </view>
            </view>

            <!-- 文章卡片 -->
            <view v-else-if="post.type === 'article'" class="bg-white rounded-xl p-3 shadow-sm flex gap-3">
              <view class="w-24 h-16 bg-[#F0EDE8] rounded-lg shrink-0 overflow-hidden flex items-center justify-center">
                <text class="text-2xl opacity-30">📄</text>
              </view>
              <view class="flex-1 min-w-0">
                <text class="font-medium text-sm text-[#2C2C2C] line-clamp-2 block">{{ post.title }}</text>
                <view class="flex items-center gap-3 mt-1.5 text-xs text-[#999]">
                  <text>❤️ {{ post.likeCount }}</text>
                  <text>{{ post.createdAt }}</text>
                </view>
              </view>
            </view>

            <!-- 帖子卡片 -->
            <view v-else class="bg-white rounded-xl p-3 shadow-sm">
              <text class="text-sm text-[#2C2C2C] line-clamp-3 block">{{ post.content }}</text>
              <view v-if="post.images && post.images.length > 0" :class="['mt-2 gap-1', post.images.length === 1 ? 'grid grid-cols-1' : 'grid grid-cols-2']">
                <view v-for="(img, i) in post.images.slice(0, 4)" :key="i" class="aspect-square bg-[#F0EDE8] rounded-lg overflow-hidden flex items-center justify-center">
                  <text class="text-2xl">{{ img }}</text>
                </view>
              </view>
              <view class="flex items-center justify-between mt-3 text-xs text-[#999]">
                <text>{{ post.createdAt }}</text>
                <view class="flex items-center gap-4">
                  <view :class="['flex items-center gap-1', post.isLiked ? 'text-[#C41E3A]' : '']" @click.stop="toggleLike(post)">
                    <text>{{ post.isLiked ? '❤️' : '🤍' }}</text>
                    <text>{{ post.likeCount }}</text>
                  </view>
                  <view class="flex items-center gap-1">
                    <text>💬</text>
                    <text>{{ post.commentCount }}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 帖子Tab -->
        <view v-else-if="activeTab === 'posts'" class="space-y-3">
          <view v-for="post in filteredPosts" :key="post.id" @click="goContent(post)" class="bg-white rounded-xl p-3 shadow-sm">
            <text class="text-sm text-[#2C2C2C] line-clamp-3 block">{{ post.content }}</text>
            <view v-if="post.images && post.images.length > 0" :class="['mt-2 gap-1', post.images.length === 1 ? 'grid grid-cols-1' : 'grid grid-cols-2']">
              <view v-for="(img, i) in post.images.slice(0, 4)" :key="i" class="aspect-square bg-[#F0EDE8] rounded-lg overflow-hidden flex items-center justify-center">
                <text class="text-2xl">{{ img }}</text>
              </view>
            </view>
            <view class="flex items-center justify-between mt-3 text-xs text-[#999]">
              <text>{{ post.createdAt }}</text>
              <view class="flex items-center gap-4">
                <view :class="['flex items-center gap-1', post.isLiked ? 'text-[#C41E3A]' : '']" @click.stop="toggleLike(post)">
                  <text>{{ post.isLiked ? '❤️' : '🤍' }}</text>
                  <text>{{ post.likeCount }}</text>
                </view>
                <view class="flex items-center gap-1">
                  <text>💬</text>
                  <text>{{ post.commentCount }}</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 文章Tab -->
        <view v-else-if="activeTab === 'articles'" class="space-y-3">
          <view v-for="post in filteredPosts" :key="post.id" @click="goContent(post)" class="bg-white rounded-xl p-3 shadow-sm flex gap-3">
            <view class="w-24 h-16 bg-[#F0EDE8] rounded-lg shrink-0 overflow-hidden flex items-center justify-center">
              <text class="text-2xl opacity-30">📄</text>
            </view>
            <view class="flex-1 min-w-0">
              <text class="font-medium text-sm text-[#2C2C2C] line-clamp-2 block">{{ post.title }}</text>
              <view class="flex items-center gap-3 mt-1.5 text-xs text-[#999]">
                <text>❤️ {{ post.likeCount }}</text>
                <text>{{ post.createdAt }}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 视频Tab -->
        <view v-else-if="activeTab === 'videos'" class="grid grid-cols-2 gap-3">
          <view v-for="post in filteredPosts" :key="post.id" @click="goContent(post)" class="bg-white rounded-xl overflow-hidden shadow-sm">
            <view class="relative aspect-[9/16] bg-[#F0EDE8] overflow-hidden flex items-center justify-center">
              <text class="text-5xl opacity-20">🎬</text>
              <view class="absolute inset-0 flex items-center justify-center">
                <view class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center">
                  <text class="text-white text-lg">▶</text>
                </view>
              </view>
            </view>
            <view class="p-2">
              <text class="text-xs text-[#2C2C2C] line-clamp-2 block">{{ post.title || post.content }}</text>
              <view class="flex items-center gap-2 mt-1 text-[10px] text-[#999]">
                <text>❤️ {{ post.likeCount }}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

interface UserProfile {
  id: number
  nickname: string
  avatar: string
  bio: string
  level: number
  levelName: string
  verified: boolean
  verifiedTitle: string
  coverImage: string
  gender: string
}

interface UserStats {
  followingCount: number
  followerCount: number
  likeCount: number
}

interface ProfileData {
  profile: UserProfile
  stats: UserStats
  isFollowing: boolean
  isMutualFollow: boolean
  isSelf: boolean
}

interface PostItem {
  id: number
  type: 'post' | 'article' | 'video'
  content: string
  title: string
  cover: string
  images: string[]
  createdAt: string
  likeCount: number
  commentCount: number
  isLiked: boolean
}

const loading = ref(true)
const error = ref<string | null>(null)
const postsLoading = ref(false)
const followLoading = ref(false)
const showMoreMenu = ref(false)
const activeTab = ref('all')
const profileData = ref<ProfileData | null>(null)
const posts = ref<PostItem[]>([])

const contentTabs = [
  { id: 'all', label: '动态' },
  { id: 'posts', label: '帖子' },
  { id: 'articles', label: '文章' },
  { id: 'videos', label: '短视频' },
]

const filteredPosts = computed(() => {
  if (activeTab.value === 'all') return posts.value
  if (activeTab.value === 'posts') return posts.value.filter(p => p.type === 'post')
  if (activeTab.value === 'articles') return posts.value.filter(p => p.type === 'article')
  if (activeTab.value === 'videos') return posts.value.filter(p => p.type === 'video')
  return posts.value
})

function formatNumber(num: number): string {
  if (num >= 10000) return (num / 10000).toFixed(1) + '万'
  return num.toString()
}

async function loadProfile() {
  loading.value = true
  error.value = null
  try {
    // 模拟 API 请求
    await new Promise(resolve => setTimeout(resolve, 600))
    profileData.value = {
      profile: {
        id: 1,
        nickname: '国学爱好者',
        avatar: '',
        bio: '学海无涯，勤奋为舟 | 易学爱好者 | 传统文化传播者',
        level: 5,
        levelName: '资深易友',
        verified: true,
        verifiedTitle: '实名认证',
        coverImage: '',
        gender: 'male',
      },
      stats: { followingCount: 23, followerCount: 56800, likeCount: 12800 },
      isFollowing: false,
      isMutualFollow: false,
      isSelf: false,
    }
    await loadPosts()
  } catch {
    error.value = '网络错误，请重试'
  } finally {
    loading.value = false
  }
}

async function loadPosts() {
  postsLoading.value = true
  try {
    await new Promise(resolve => setTimeout(resolve, 400))
    posts.value = [
      { id: 1, type: 'post', content: '今天学习了易经乾卦，受益匪浅！"天行健，君子以自强不息"——这句话值得每一个中国人铭记。乾卦六爻层层递进，从潜龙勿用到亢龙有悔，道尽了人生处世哲学。', title: '', cover: '', images: ['📖', '☯️', '📜'], createdAt: '1小时前', likeCount: 24, commentCount: 8, isLiked: false },
      { id: 2, type: 'article', content: '', title: '《国学概论》读书笔记——章太炎讲稿精华整理', cover: '', images: [], createdAt: '昨天', likeCount: 156, commentCount: 32, isLiked: false },
      { id: 3, type: 'video', content: '故宫风水布局实地讲解', title: '故宫风水布局实地讲解', cover: '', images: [], createdAt: '2天前', likeCount: 890, commentCount: 45, isLiked: true },
      { id: 4, type: 'post', content: '五行相生相克口诀：金生水、水生木、木生火、火生土、土生金。金克木、木克土、土克水、水克火、火克金。初学者建议配合五行相生相克图来记忆。', title: '', cover: '', images: [], createdAt: '3天前', likeCount: 32, commentCount: 12, isLiked: true },
      { id: 5, type: 'article', content: '', title: '【干货】八字排盘入门指南——从年柱到时柱详解', cover: '', images: [], createdAt: '1周前', likeCount: 289, commentCount: 76, isLiked: false },
      { id: 6, type: 'video', content: '梅花易数起卦实战', title: '梅花易数起卦实战演示', cover: '', images: [], createdAt: '1周前', likeCount: 1200, commentCount: 93, isLiked: false },
      { id: 7, type: 'post', content: '晚安，今天读完了《道德经》第八十一章。"信言不美，美言不信。善者不辩，辩者不善。"大智若愚，方为大道。', title: '', cover: '', images: ['🌙'], createdAt: '2周前', likeCount: 41, commentCount: 9, isLiked: false },
    ]
  } catch {
    // ignore
  } finally {
    postsLoading.value = false
  }
}

async function handleFollow() {
  if (!profileData.value || followLoading.value) return
  followLoading.value = true

  const wasFollowing = profileData.value.isFollowing
  // 乐观更新
  profileData.value = {
    ...profileData.value,
    isFollowing: !wasFollowing,
    stats: {
      ...profileData.value.stats,
      followerCount: profileData.value.stats.followerCount + (wasFollowing ? -1 : 1),
    },
  }

  try {
    await new Promise(resolve => setTimeout(resolve, 500))
    uni.showToast({ title: wasFollowing ? '已取消关注' : '关注成功', icon: 'none' })
    if (!wasFollowing) {
      profileData.value = { ...profileData.value, isMutualFollow: true }
    }
  } catch {
    // 回滚
    profileData.value = {
      ...profileData.value,
      isFollowing: wasFollowing,
      stats: {
        ...profileData.value.stats,
        followerCount: profileData.value.stats.followerCount + (wasFollowing ? 1 : -1),
      },
    }
    uni.showToast({ title: '操作失败', icon: 'none' })
  } finally {
    followLoading.value = false
  }
}

function handleShare() {
  // #ifdef H5
  uni.setClipboardData({ data: window.location.href, success: () => uni.showToast({ title: '链接已复制', icon: 'none' }) })
  // #endif
  // #ifdef MP-WEIXIN
  uni.showShareMenu()
  // #endif
}

function handleReport() {
  showMoreMenu.value = false
  uni.showToast({ title: '已举报', icon: 'none' })
}

function handleBlock() {
  showMoreMenu.value = false
  uni.showToast({ title: '已拉黑', icon: 'none' })
}

function toggleLike(post: PostItem) {
  post.isLiked = !post.isLiked
  post.likeCount += post.isLiked ? 1 : -1
}

function goBack() { uni.navigateBack() }
function goFollowing() { uni.navigateTo({ url: '/pages/user/social/index?tab=following' }) }
function goFollowers() { uni.navigateTo({ url: '/pages/user/social/index?tab=followers' }) }
function sendMessage() { uni.navigateTo({ url: '/pages/im/chat/index' }) }
function goContent(post: PostItem) {
  if (post.type === 'article') uni.navigateTo({ url: `/pages/article/id-detail/index?id=${post.id}` })
  else if (post.type === 'video') uni.navigateTo({ url: `/pages/videos/id-detail/index?id=${post.id}` })
  else uni.navigateTo({ url: `/pages/post/id-detail/index?id=${post.id}` })
}

onMounted(() => {
  loadProfile()
})
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
