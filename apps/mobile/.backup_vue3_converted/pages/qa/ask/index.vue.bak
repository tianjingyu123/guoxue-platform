<template>
  <view class="min-h-screen bg-[#FAF8F5]" style="padding-bottom: 120px;">
    <!-- Loading Skeleton -->
    <view v-if="!answerer" class="p-4" style="display: flex; flex-direction: column; gap: 16px;">
      <view class="rounded-2xl bg-[#F0EBE5]" style="height: 128px; animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;" />
      <view class="rounded-2xl bg-[#F0EBE5]" style="height: 192px; animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;" />
    </view>

    <template v-else>
      <!-- Header -->
      <view class="sticky top-0 z-10" style="background: rgba(250, 248, 245, 0.95); border-bottom: 1px solid #E8E0D5;">
        <view class="flex items-center justify-between" style="padding: 16px;">
          <view class="p-2" style="margin-left: -8px;" @click="goBack">
            <text class="text-[#2C2C2C]" style="font-size: 20px; line-height: 1;">←</text>
          </view>
          <text class="font-semibold text-[#2C2C2C]" style="font-size: 16px;">发起提问</text>
          <view style="width: 36px;" />
        </view>
      </view>

      <view class="p-4" style="display: flex; flex-direction: column; gap: 16px;">
        <!-- Answerer Card -->
        <view class="bg-white rounded-2xl" style="padding: 16px; border: 1px solid #E8E0D5; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);">
          <view class="flex" style="gap: 16px;">
            <image :src="answerer.avatar" mode="aspectFill" class="rounded-full flex-shrink-0" style="width: 64px; height: 64px;" />
            <view class="flex-1" style="min-width: 0;">
              <view class="flex items-center" style="gap: 8px;">
                <text class="font-bold text-[#2C2C2C]" style="font-size: 18px;">{{ answerer.name }}</text>
                <text class="rounded-full text-xs flex-shrink-0" style="padding: 1px 8px; background: #FEF3C7; color: #B45309;">{{ answerer.title }}</text>
              </view>
              <text class="block text-sm text-[#999999] mt-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{{ answerer.description }}</text>
              <view class="flex items-center mt-2 text-sm text-[#999999]" style="gap: 16px;">
                <text class="flex items-center" style="gap: 4px;">
                  <text class="text-[#F59E0B]" style="font-size: 14px;">⭐</text>
                  <text>{{ answerer.rating }}</text>
                </text>
                <text class="flex items-center" style="gap: 4px;">
                  <text style="font-size: 14px;">💬</text>
                  <text>{{ answerer.answerCount }}次回答</text>
                </text>
                <text class="flex items-center" style="gap: 4px;">
                  <text style="font-size: 14px;">🕐</text>
                  <text>{{ answerer.responseTime }}</text>
                </text>
              </view>
            </view>
          </view>
          <view class="flex flex-wrap mt-3" style="gap: 8px;">
            <view v-for="tag in answerer.expertise" :key="tag" class="rounded-full text-xs" style="padding: 4px 12px; background: rgba(196, 30, 58, 0.1); color: #C41E3A;">
              {{ tag }}
            </view>
          </view>
          <view class="flex items-center justify-between mt-4" style="padding-top: 16px; border-top: 1px solid #E8E0D5;">
            <text class="text-[#999999]">提问价格</text>
            <text class="font-bold text-[#C41E3A]" style="font-size: 20px;">¥{{ totalPrice }}</text>
          </view>
        </view>

        <!-- Question Title -->
        <view class="bg-white rounded-2xl" style="padding: 16px; border: 1px solid #E8E0D5; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);">
          <view class="flex items-center justify-between mb-3">
            <text class="font-medium text-[#2C2C2C]">问题标题</text>
            <text class="text-xs text-[#999999]">{{ title.length }}/50</text>
          </view>
          <input
            type="text"
            :value="title"
            @input="onTitleInput"
            placeholder="一句话描述你的问题"
            class="w-full rounded-lg text-sm text-[#2C2C2C]"
            :style="{
              border: errors.title ? '1px solid #FF4D4F' : '1px solid #E8E0D5',
              padding: '8px 12px',
              background: '#FAF8F5',
            }"
          />
          <view v-if="errors.title" class="flex items-center mt-1 text-xs text-[#FF4D4F]" style="gap: 4px;">
            <text style="font-size: 12px;">⚠️</text>
            <text>{{ errors.title }}</text>
          </view>
        </view>

        <!-- Question Content -->
        <view class="bg-white rounded-2xl" style="padding: 16px; border: 1px solid #E8E0D5; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);">
          <view class="flex items-center justify-between mb-3">
            <text class="font-medium text-[#2C2C2C]">问题详情</text>
            <text class="text-xs text-[#999999]">{{ content.length }}/500</text>
          </view>
          <textarea
            :value="content"
            @input="onContentInput"
            placeholder="请详细描述你的问题，包括相关背景信息，以便答主更好地为你解答..."
            class="w-full rounded-lg text-sm text-[#2C2C2C]"
            :style="{
              border: errors.content ? '1px solid #FF4D4F' : '1px solid #E8E0D5',
              padding: '8px 12px',
              background: '#FAF8F5',
              minHeight: '144px',
            }"
          />
          <view v-if="errors.content" class="flex items-center mt-1 text-xs text-[#FF4D4F]" style="gap: 4px;">
            <text style="font-size: 12px;">⚠️</text>
            <text>{{ errors.content }}</text>
          </view>
          <text class="block text-xs text-[#999999] mt-2">提示：提问越详细，答主回答越精准</text>
        </view>

        <!-- Public/Private Toggle -->
        <view class="bg-white rounded-2xl" style="padding: 16px; border: 1px solid #E8E0D5; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);">
          <view class="flex items-center justify-between">
            <view>
              <text class="font-medium text-[#2C2C2C]">允许围观</text>
              <text class="block text-xs text-[#999999]" style="margin-top: 2px;">开启后其他用户可付费查看回答</text>
            </view>
            <!-- Toggle Switch -->
            <view
              class="rounded-full relative"
              :style="{
                width: '48px',
                height: '28px',
                background: isPublic ? '#C41E3A' : '#F0EBE5',
                transition: 'background 0.2s',
              }"
              @click="togglePublic"
            >
              <view
                class="absolute bg-white rounded-full shadow-sm"
                :style="{
                  width: '20px',
                  height: '20px',
                  top: '4px',
                  left: isPublic ? '24px' : '4px',
                  transition: 'left 0.2s',
                  boxShadow: '0 1px 3px rgba(0,0,0,0.15)',
                }"
              />
            </view>
          </view>

          <!-- View Price Options (only visible when public) -->
          <view v-if="isPublic" class="mt-4" style="padding-top: 16px; border-top: 1px solid #E8E0D5;">
            <view class="flex items-center justify-between mb-2">
              <text class="text-sm text-[#2C2C2C]">围观价格</text>
              <text class="text-sm text-[#999999]">选择后可获得分成</text>
            </view>
            <view class="flex" style="gap: 8px;">
              <view
                v-for="price in viewPriceOptions"
                :key="price"
                class="flex-1 py-2 rounded-lg text-sm font-medium text-center"
                :style="viewPrice === price
                  ? { background: '#C41E3A', color: '#FFFFFF' }
                  : { background: '#F0EBE5', color: '#2C2C2C' }"
                @click="viewPrice = price"
              >
                {{ price === 0 ? '免费' : '¥' + price }}
              </view>
            </view>
          </view>
        </view>

        <!-- Expire Time -->
        <view class="bg-white rounded-2xl" style="padding: 16px; border: 1px solid #E8E0D5; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);">
          <text class="font-medium text-[#2C2C2C] block mb-3">回答期限</text>
          <view class="flex" style="gap: 8px;">
            <view
              v-for="option in expireOptions"
              :key="option.value"
              class="flex-1 py-2 rounded-lg text-sm font-medium text-center"
              :style="expireDays === option.value
                ? { background: '#C41E3A', color: '#FFFFFF' }
                : { background: '#F0EBE5', color: '#2C2C2C' }"
              @click="expireDays = option.value"
            >
              {{ option.label }}
            </view>
          </view>
          <text class="block text-xs text-[#999999] mt-2">答主将在{{ expireDays }}天内回答，超时未回答将全额退款</text>
        </view>

        <!-- Tips -->
        <view class="rounded-2xl" style="padding: 16px; background: #FFFBEB;">
          <text class="font-medium mb-2 block" style="color: #92400E; font-size: 14px;">温馨提示</text>
          <view style="display: flex; flex-direction: column; gap: 6px;">
            <view class="flex items-start" style="gap: 8px;">
              <text style="font-size: 16px; flex-shrink: 0; line-height: 1.4;">✅</text>
              <text class="text-xs" style="color: #B45309; line-height: 1.5;">提问后，答主将在约定时间内回复</text>
            </view>
            <view class="flex items-start" style="gap: 8px;">
              <text style="font-size: 16px; flex-shrink: 0; line-height: 1.4;">✅</text>
              <text class="text-xs" style="color: #B45309; line-height: 1.5;">回答后您可对回答进行评分</text>
            </view>
            <view class="flex items-start" style="gap: 8px;">
              <text style="font-size: 16px; flex-shrink: 0; line-height: 1.4;">✅</text>
              <text class="text-xs" style="color: #B45309; line-height: 1.5;">开启围观后，每次围观您可获得分成</text>
            </view>
            <view class="flex items-start" style="gap: 8px;">
              <text style="font-size: 16px; flex-shrink: 0; line-height: 1.4;">✅</text>
              <text class="text-xs" style="color: #B45309; line-height: 1.5;">超时未回答将自动全额退款</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Bottom Bar -->
      <view class="fixed bottom-0 left-0 right-0 bg-[#FAF8F5]" style="border-top: 1px solid #E8E0D5; padding: 16px; padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px));">
        <view class="flex items-center justify-between mb-3">
          <text class="text-[#999999]">需支付</text>
          <view class="flex items-baseline" style="gap: 4px;">
            <text class="font-bold text-[#C41E3A]" style="font-size: 24px;">¥{{ totalPrice }}</text>
          </view>
        </view>
        <view
          class="w-full rounded-xl font-medium flex items-center justify-center"
          :style="{
            padding: '12px 0',
            background: '#C41E3A',
            color: '#FFFFFF',
            opacity: isSubmitting ? 0.5 : 1,
            gap: '8px',
          }"
          @click="handleSubmit"
        >
          <template v-if="isSubmitting">
            <view class="rounded-full" style="width: 20px; height: 20px; border: 2px solid rgba(255, 255, 255, 0.3); border-top-color: #FFFFFF; animation: spin 1s linear infinite;" />
            <text>提交中...</text>
          </template>
          <template v-else>
            <text style="font-size: 20px;">👥</text>
            <text>提交并支付</text>
          </template>
        </view>
      </view>
    </template>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'
import { onLoad } from '@dcloudio/uni-app'

interface Answerer {
  id: string
  name: string
  avatar: string
  title: string
  expertise: string[]
  price: number
  responseTime: string
  answerCount: number
  rating: number
  description: string
}

const answerer = ref<Answerer | null>(null)
const title = ref('')
const content = ref('')
const isPublic = ref(true)
const viewPrice = ref(0)
const expireDays = ref(3)
const isSubmitting = ref(false)
const errors = ref<{ title?: string; content?: string }>({})

const viewPriceOptions = [0, 1, 3, 5, 10]
const expireOptions = [
  { value: 1, label: '1天' },
  { value: 3, label: '3天' },
  { value: 7, label: '7天' },
]

const totalPrice = computed(() => answerer.value?.price || 0)

onLoad((options) => {
  const answererId = (options as any)?.answerer || null
  // Mock answerer data — 与 V0 源文件 mock 数据一致
  answerer.value = {
    id: answererId || '1',
    name: '张道长',
    avatar: '/placeholder.svg?height=80&width=80',
    title: '易学研究会会长',
    expertise: ['八字命理', '风水堪舆', '六爻预测'],
    price: 99,
    responseTime: '24小时内',
    answerCount: 1234,
    rating: 4.9,
    description: '从事易学研究三十余年，精通八字、六爻、风水等传统术数',
  }
})

function onTitleInput(e: any) {
  title.value = (e.detail.value || '').slice(0, 50)
}

function onContentInput(e: any) {
  content.value = (e.detail.value || '').slice(0, 500)
}

function validate(): boolean {
  const newErrors: { title?: string; content?: string } = {}
  if (!title.value.trim()) {
    newErrors.title = '请输入问题标题'
  } else if (title.value.length < 5) {
    newErrors.title = '标题至少5个字'
  }
  if (!content.value.trim()) {
    newErrors.content = '请输入问题详情'
  } else if (content.value.length < 20) {
    newErrors.content = '问题详情至少20个字'
  }
  errors.value = newErrors
  return Object.keys(newErrors).length === 0
}

function goBack() {
  uni.navigateBack()
}

function togglePublic() {
  isPublic.value = !isPublic.value
}

async function handleSubmit() {
  if (!validate() || !answerer.value) return

  isSubmitting.value = true
  try {
    // Mock API call — 保留 V0 源文件交互逻辑
    // 实际上线时使用以下真实 API 调用：
    // await questionApi.ask({
    //   title: title.value,
    //   content: content.value,
    //   price: answerer.value.price,
    //   answererId: answerer.value.id,
    //   isPublic: isPublic.value,
    //   expireDays: expireDays.value,
    // })
    await new Promise((resolve) => setTimeout(resolve, 800))
    uni.navigateTo({
      url: '/pages/qa/id-detail/index?id=mock&pay=1',
    })
  } catch {
    uni.showToast({ title: '提交失败，请重试', icon: 'none' })
  } finally {
    isSubmitting.value = false
  }
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
</style>
