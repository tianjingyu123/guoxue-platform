<template>
  <view class="fixed inset-0 z-[9999] overflow-hidden">
    <!-- 品牌展示阶段 -->
    <view v-if="phase === 'brand'" class="absolute inset-0 flex flex-col items-center justify-center">
      <!-- 背景渐变 -->
      <view class="absolute inset-0" style="background: linear-gradient(180deg, #1A1F2E 0%, #252A38 50%, #1A1F2E 100%)">
        <!-- 山峦剪影层 - SVG -->
        <view class="absolute bottom-0 left-0 right-0 h-[40%]">
          <view class="absolute bottom-0 left-0 right-0 w-full h-full opacity-20"
            :style="{ backgroundImage: 'url(' + mountainSvg1 + ')', backgroundSize: '100% 100%', backgroundPosition: 'bottom', backgroundRepeat: 'no-repeat' }" />
          <view class="absolute bottom-0 left-0 right-0 w-full h-full opacity-30"
            :style="{ backgroundImage: 'url(' + mountainSvg2 + ')', backgroundSize: '100% 100%', backgroundPosition: 'bottom', backgroundRepeat: 'no-repeat' }" />
        </view>
        <!-- 天边曙光 -->
        <view class="absolute top-[20%] left-0 right-0 h-[30%]" style="background:linear-gradient(180deg,transparent,rgba(201,169,110,0.05))" />
        <!-- 微妙光晕 -->
        <view class="absolute top-[30%] left-1/2 w-[600rpx] h-[200rpx]" style="background:rgba(201,169,110,0.1);border-radius:50%;filter:blur(100px);transform:translateX(-50%)" />
      </view>

      <!-- 右上角跳过按钮 -->
      <view class="absolute top-12 right-4 z-20 px-3 py-1.5 rounded-full" style="background:rgba(255,255,255,0.1);backdrop-filter:blur(4px);border:1px solid rgba(255,255,255,0.2)" @click="goHome">
        <text class="text-white/80 text-sm font-medium">跳过 {{ countdown }}s</text>
      </view>

      <!-- 主内容区 -->
      <view class="relative z-10 flex flex-col items-center">
        <!-- Logo -->
        <view :class="['w-32 h-32 mb-6 rounded-2xl overflow-hidden transition-all duration-700 ease-out', logoAnimated ? 'opacity-100 scale-100' : 'opacity-0 scale-75']" style="box-shadow:0 20px 60px rgba(0,0,0,0.4)">
          <image src="/static/images/logo.jpg" mode="aspectFill" class="w-full h-full" />
        </view>
        <!-- 品牌名（延迟200ms动画） -->
        <text :class="['font-serif text-3xl font-bold text-white mb-3 transition-all duration-500 delay-200', logoAnimated ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-4']" style="letter-spacing:0.2em">热卜国学</text>
        <!-- Slogan -->
        <text :class="['text-base text-[#C9A96E] transition-all duration-500', sloganVisible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-2']" style="letter-spacing:0.3em">探寻东方智慧</text>
      </view>

      <!-- 底部版权 -->
      <view class="absolute bottom-8 left-0 right-0 text-center">
        <text class="text-[11px] text-white/30 tracking-wide">Copyright 2024 热卜国学 All Rights Reserved</text>
      </view>
    </view>

    <!-- 广告展示阶段 -->
    <view v-if="phase === 'ad' && ad" class="absolute inset-0 bg-black">
      <!-- 右上角跳过按钮 -->
      <view class="absolute top-12 right-4 z-20 px-4 py-2 rounded-full" style="background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);border:1px solid rgba(255,255,255,0.3)" @click="goHome">
        <text class="text-white text-sm font-medium">跳过 {{ adCountdown }}s</text>
      </view>

      <!-- 广告图片 -->
      <view class="w-full h-full" @click="handleAdClick">
        <image :src="ad.image" mode="aspectFill" class="w-full h-full" />
      </view>

      <!-- 底部品牌标识 -->
      <view class="absolute bottom-6 left-0 right-0 flex items-center justify-center gap-2">
        <view class="w-6 h-6 rounded overflow-hidden">
          <image src="/static/images/logo.jpg" mode="aspectFill" class="w-full h-full" />
        </view>
        <text class="text-white/60 text-xs">热卜国学</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted, onUnmounted } from 'vue'

interface SplashAd {
  id: string
  image: string
  link: string
  duration: number
}

const phase = ref<'brand' | 'ad'>('brand')
const countdown = ref(3)
const logoAnimated = ref(false)
const sloganVisible = ref(false)
const ad = ref<SplashAd | null>(null)
const adCountdown = ref(5)

// SVG 山峦剪影 data URI
const mountainSvg1 = ref('')
const mountainSvg2 = ref('')

let timers: ReturnType<typeof setTimeout>[] = []

function goHome() {
  uni.reLaunch({ url: '/pages/index/index' })
}

const ALLOWED_DOMAINS = ['rebuguo.com', 'rebugx.cn']

function handleAdClick() {
  if (ad.value?.link) {
    const link = ad.value.link
    // 内部页面路径
    if (link.startsWith('/') || link.startsWith('pages/')) {
      uni.navigateTo({ url: link.startsWith('/') ? link : '/pages/' + link })
      return
    }
    // 外部链接 — 仅允许白名单域名
    try {
      const host = new URL(link).hostname
      if (ALLOWED_DOMAINS.some(d => host === d || host.endsWith('.' + d))) {
        uni.navigateTo({ url: '/pages/webview/index?url=' + encodeURIComponent(link) })
      }
    } catch {
      // 无效 URL，忽略
    }
  }
}

onMounted(() => {
  // 初始化 SVG 山峦剪影
  const svg1 = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 400" preserveAspectRatio="none"><path fill="#2A3040" d="M0,400 L0,200 Q200,100 400,180 Q600,260 800,150 Q1000,40 1200,120 Q1400,200 1440,150 L1440,400 Z"/></svg>'
  mountainSvg1.value = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg1)
  const svg2 = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" preserveAspectRatio="none"><path fill="#252A38" d="M0,320 L0,160 Q180,80 360,140 Q540,200 720,100 Q900,0 1080,80 Q1260,160 1440,120 L1440,320 Z"/></svg>'
  mountainSvg2.value = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg2)

  // 尝试获取开屏广告
  try {
    const pages = getCurrentPages()
    const currentPage = pages[pages.length - 1] as any
    const options = currentPage?.$page?.options || currentPage?.options || {}
    if (options.adImage) {
      ad.value = {
        id: '1',
        image: decodeURIComponent(options.adImage),
        link: options.adLink || '',
        duration: 5
      }
    }
  } catch (e) {
    // 无广告继续品牌展示
  }

  // Logo动画（100ms后开始）
  timers.push(setTimeout(() => { logoAnimated.value = true }, 100))
  // Slogan动画（600ms后显示）
  timers.push(setTimeout(() => { sloganVisible.value = true }, 600))

  // 品牌阶段倒计时
  const brandTimer = setInterval(() => {
    countdown.value--
    if (countdown.value <= 0) {
      clearInterval(brandTimer)
      if (ad.value) {
        phase.value = 'ad'
        adCountdown.value = ad.value.duration
      } else {
        goHome()
      }
    }
  }, 1000)
  timers.push(brandTimer as any)

  // 广告阶段倒计时
  const adTimer = setInterval(() => {
    if (phase.value !== 'ad') return
    adCountdown.value--
    if (adCountdown.value <= 0) {
      clearInterval(adTimer)
      goHome()
    }
  }, 1000)
  timers.push(adTimer as any)
})

onUnmounted(() => {
  timers.forEach(t => clearTimeout(t))
})
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
