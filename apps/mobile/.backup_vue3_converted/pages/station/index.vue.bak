  id: string
  name: string
  address: string
  phone: string
  members: number
  teachers: number
  courses: number
  activities: number
}

const info = ref<StationInfo>({
  id: '1',
  name: '北京朝阳分站',
  address: '北京市朝阳区建国路88号',
  phone: '010-88886666',
  members: 356,
  teachers: 12,
  courses: 48,
  activities: 16,
})

const menus = [
  { key: 'course', label: '课程', icon: '📅' },
  { key: 'activity', label: '活动', icon: '🎉' },
  { key: 'mall', label: '商城', icon: '🛍️' },
  { key: 'book', label: '预约', icon: '✍️' },
  { key: 'teachers', label: '教师', icon: '👨‍🏫' },
  { key: 'data', label: '数据', icon: '📊' },
  { key: 'notice', label: '公告', icon: '🔔' },
  { key: 'more', label: '更多', icon: '⋯' },
  { key: 'live', label: '直播', icon: '📺' },
  { key: 'video', label: '回放', icon: '🎬' },
  { key: 'forum', label: '论坛', icon: '💬' },
]

interface NewsItem {
  id: string
  title: string
  icon: string
  time: string
  hot?: string
}

interface Teacher {
  id: string
  name: string
  title: string
  rating: number
}

const teachers = ref<Teacher[]>([
  { id: 't1', name: '周易大师', title: '易学高级讲师', rating: 4.9 },
  { id: 't2', name: '紫微传承人', title: '紫微斗数专家', rating: 4.8 },
  { id: 't3', name: '风水徐师傅', title: '风水堪舆大师', rating: 4.7 },
