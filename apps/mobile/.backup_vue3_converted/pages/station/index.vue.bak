])

const news = ref<NewsItem[]>([
  { id: '1', title: '本周六「易经入门」公开课开放报名', icon: '📢', time: '2小时前', hot: '12人报名' },
  { id: '2', title: '新进5位资深命理讲师，点击查看简介', icon: '👨‍🏫', time: '昨天', hot: '新' },
  { id: '3', title: '春季读书会第3期：《道德经》精读', icon: '📖', time: '3天前' },
  { id: '4', title: '分站会员系统升级通知', icon: '⚙️', time: '5天前' },
  { id: '5', title: '4月排盘公益活动圆满结束', icon: '🎊', time: '1周前' },
