  { id: '8', title: '暑期少儿国学夏令营开始报名', icon: '🧒', time: '1个月前', hot: '火热报名' },
])

function onRefresh() {
  refreshing.value = true
  setTimeout(() => { refreshing.value = false }, 1000)
}

function goBack() { uni.navigateBack() }

function onShare() {
  uni.showToast({ title: '分享功能即将开放', icon: 'none' })
}

/** 分站特色简介 */
const stationFeatures = [
  '专注国学传统文化传播',
  '资深讲师团队一对一指导',
  '定期举办线下交流活动',
]

function onMenu(key: string) {
  const paths: Record<string, string> = {
    course: '/pages/course/list/index',
    activity: '/pages/same-city/index',
    mall: '/pages/mall/index',
    book: '/pages/booking/index',
    teachers: '/pages/teacher/list/index',
  }
  if (paths[key]) {
    uni.navigateTo({ url: paths[key] })
  } else {
    uni.showToast({ title: '功能开发中', icon: 'none' })
  }
}

function goNews(id: string) {
  uni.navigateTo({ url: `/pages/post/index?id=${id}` })
}

function goTeacher(id: string) {
  uni.navigateTo({ url: `/pages/teacher/index?id=${id}` })
}

setTimeout(() => { loading.value = false }, 1000)
</script>

