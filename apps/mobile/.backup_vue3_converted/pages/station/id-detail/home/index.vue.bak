<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <view class="max-w-lg mx-auto relative">
      <!-- 顶部品牌栏 + 搜索 -->
      <view class="fixed top-0 left-0 right-0 z-50 max-w-lg mx-auto">
        <!-- 品牌栏 -->
        <view class="flex items-center justify-between px-4 h-11" style="background-color:#C41E3A">
          <view class="flex items-center gap-2">
            <text class="text-white font-bold text-base">{{ station.name }}</text>
          </view>
          <view class="flex items-center gap-2">
            <text class="text-white text-lg">🔔</text>
          </view>
        </view>
        <!-- 搜索栏 -->
        <view class="flex items-center justify-between px-4 py-2 bg-white border-b border-[#E8E0D5]">
          <view class="flex-1 flex items-center gap-2 h-8 px-3 rounded-full bg-[#F1EDE8]" @click="goTo('/search')">
            <text class="text-sm text-[#999]">🔍</text>
            <text class="text-sm text-[#999]">搜索课程、圈子、文章...</text>
          </view>
          <view class="relative p-2 ml-3">
            <text class="text-lg text-[#2C2C2C]">🔔</text>
            <view class="absolute top-1 right-1 w-2 h-2 rounded-full" style="background-color:#EF4444" />
          </view>
        </view>
      </view>

      <!-- 主内容区 -->
      <view class="pt-[100px] pb-20">
        <!-- Hero Banner轮播 -->
        <view class="relative mx-4 mt-3">
          <view class="relative aspect-[2/1] rounded-xl overflow-hidden">
            <view
              v-for="(img, index) in bannerImages"
              :key="index"
              class="absolute inset-0 transition-opacity duration-500"
              :class="index === currentBanner ? 'opacity-100' : 'opacity-0'"
            >
              <view class="w-full h-full" :style="{ background: 'linear-gradient(135deg, ' + themeColor + ' 0%, ' + themeColor + '80 100%)' }" />
            </view>

            <!-- 渐变遮罩 -->
            <view class="absolute inset-0" style="background:linear-gradient(to top,rgba(0,0,0,0.6),transparent)" />

            <!-- 分站信息叠加 -->
            <view class="absolute bottom-3 left-3 right-3">
              <view class="flex items-center gap-2 mb-1">
                <view class="w-8 h-8 rounded-full border-2 border-white overflow-hidden flex items-center justify-center text-white text-xs font-bold" :style="{ backgroundColor: themeColor }">
                  <text>{{ station.masterName.charAt(0) }}</text>
                </view>
                <view>
                  <text class="text-white text-sm font-medium block">{{ station.name }}</text>
                  <text class="text-white/70 text-[10px]">{{ station.memberCount }} 成员 · {{ station.contentCount }} 内容</text>
                </view>
              </view>
            </view>

            <!-- 轮播指示器 -->
            <view v-if="bannerImages.length > 1" class="absolute bottom-3 right-3 flex gap-1">
              <view
                v-for="(_, index) in bannerImages"
                :key="index"
                class="rounded-full transition-all"
                :class="index === currentBanner ? 'w-4 bg-white' : 'w-1.5 bg-white/50'"
                :style="{ height: '6rpx' }"
                @click="currentBanner = index"
              />
            </view>
          </view>

          <!-- 站长欢迎语 -->
          <view class="mt-2 p-2.5 rounded-lg flex items-center justify-between" :style="{ backgroundColor: themeColor + '10' }">
            <view class="flex items-center gap-2">
              <text class="text-sm" :style="{ color: themeColor }">✨</text>
              <text class="text-xs" :style="{ color: themeColor }">欢迎来到{{ station.masterName }}的国学小站</text>
            </view>
            <text class="text-sm text-[#999]">›</text>
          </view>
        </view>

        <!-- 快捷入口 -->
        <view class="px-4 mt-4">
          <view class="grid grid-cols-4 gap-3">
            <view v-for="entry in quickEntries" :key="entry.label" class="flex flex-col items-center gap-1" @click="goTo(entry.path)">
              <view class="w-12 h-12 rounded-2xl flex items-center justify-center" :style="{ backgroundColor: themeColor + '15' }">
                <text class="text-xl">{{ entry.icon }}</text>
              </view>
              <text class="text-xs text-[#2C2C2C]">{{ entry.label }}</text>
            </view>
          </view>
        </view>

        <!-- 站长精选 -->
        <view class="px-4 mt-6">
          <view class="flex items-center justify-between mb-3">
            <text class="font-semibold text-base text-[#2C2C2C]">站长精选</text>
            <view class="flex items-center gap-1 text-xs text-[#999]">
              <text>更多</text>
              <text class="text-sm">›</text>
            </view>
          </view>
          <scroll-view scroll-x class="flex gap-3 pb-2" style="white-space:nowrap">
            <view v-for="item in featuredItems" :key="item.id" class="inline-block w-40 flex-shrink-0 mr-3" @click="goTo(item.path)">
              <view class="bg-white rounded-xl overflow-hidden">
                <view class="aspect-[4/3] flex items-center justify-center bg-[#F1EDE8]">
                  <text class="text-3xl">{{ item.icon }}</text>
                </view>
                <view class="p-2.5">
                  <text class="text-sm font-medium text-[#2C2C2C] block truncate">{{ item.title }}</text>
                  <text class="text-xs text-[#999] block mt-1">{{ item.desc }}</text>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>

        <!-- AI推荐Feed流 -->
        <view class="mt-4">
          <view class="px-4 mb-3">
            <text class="text-sm font-medium text-[#999]">为你推荐</text>
          </view>
          <view class="px-4 space-y-3">
            <view v-for="item in feedItems" :key="item.id" class="p-4 bg-white rounded-xl" @click="goTo(item.path)">
              <view class="flex items-start gap-3">
                <view class="w-10 h-10 rounded-xl flex items-center justify-center bg-[#F1EDE8]">
                  <text class="text-xl">{{ item.icon }}</text>
                </view>
                <view class="flex-1 min-w-0">
                  <text class="font-medium text-sm text-[#2C2C2C] block">{{ item.title }}</text>
                  <text class="text-xs text-[#999] block mt-1 line-clamp-2">{{ item.desc }}</text>
                  <view class="flex items-center gap-3 mt-2">
                    <text class="text-[10px] text-[#999]">{{ item.type }}</text>
                    <text class="text-[10px] text-[#999]">{{ item.date }}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 悬浮AI助手 -->
      <view class="fixed bottom-24 right-4 z-40 w-12 h-12 rounded-full flex items-center justify-center shadow-lg" style="background-color:#C41E3A" @click="goTo('/assistant')">
        <text class="text-white text-xl">🤖</text>
      </view>

      <!-- 底部导航 -->
      <view class="fixed bottom-0 left-0 right-0 z-40 bg-white border-t border-[#E8E0D5]">
        <view class="flex items-center justify-around h-14">
          <view v-for="tab in bottomTabs" :key="tab.label" class="flex flex-col items-center gap-0.5" @click="goTo(tab.path)">
            <text :class="tab.active ? 'text-xl' : 'text-xl text-[#999]'">{{ tab.icon }}</text>
            <text :class="['text-[10px]', tab.active ? 'text-[#2C2C2C] font-medium' : 'text-[#999]']">{{ tab.label }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted, onUnmounted } from 'vue'

const currentBanner = ref(0)
const themeColor = '#C41E3A'

const station = {
  name: '国学推广联盟',
  masterName: '王老师',
  memberCount: 1280,
  contentCount: 356,
}

const bannerImages = ['banner1', 'banner2', 'banner3']

const quickEntries = [
  { icon: '📚', label: '课程', path: '/station/courses' },
  { icon: '🏪', label: '圈子', path: '/station/community' },
  { icon: '🧘', label: '文章', path: '/station/articles' },
  { icon: '🔮', label: '排盘', path: '/paipan' },
  { icon: '📅', label: '活动', path: '/station/activities' },
  { icon: '🛍', label: '商城', path: '/station/mall' },
  { icon: '📖', label: '古籍', path: '/station/books' },
  { icon: '👤', label: '我的', path: '/profile' },
]

const featuredItems = [
  { id: 1, icon: '📖', title: '八字命理入门', desc: '零基础也能学会', path: '/course/1' },
  { id: 2, icon: '🧭', title: '风水堪舆实战', desc: '掌握居家风水', path: '/course/2' },
  { id: 3, icon: '⭐', title: '紫微斗数精讲', desc: '解读命运密码', path: '/course/3' },
  { id: 4, icon: '🔮', title: '奇门遁甲基础', desc: '决策智慧', path: '/course/4' },
]

const feedItems = [
  { id: 1, icon: '📄', title: '八字如何看财运', desc: '从八字十神组合分析一个人的财富格局和财运走势，掌握这些要点让你快速判断。', type: '文章', date: '2小时前', path: '/article/1' },
  { id: 2, icon: '🎯', title: '六爻占卜入门课程', desc: '系统学习六爻起卦、断卦方法，30天从小白到入门。', type: '课程', date: '1天前', path: '/course/5' },
  { id: 3, icon: '💬', title: '阳宅风水布局讨论', desc: '现代住宅风水布局要点，客厅卧室厨房各自需要注意什么？', type: '圈子', date: '3天前', path: '/community/1' },
]

const bottomTabs = [
  { icon: '🏠', label: '首页', path: '/index', active: true },
  { icon: '🔍', label: '发现', path: '/discover', active: false },
  { icon: '📋', label: '订单', path: '/orders', active: false },
  { icon: '👤', label: '我的', path: '/profile', active: false },
]

let bannerTimer: ReturnType<typeof setInterval> | null = null

onMounted(() => {
  if (bannerImages.length > 1) {
    bannerTimer = setInterval(() => {
      currentBanner.value = (currentBanner.value + 1) % bannerImages.length
    }, 5000)
  }
})

onUnmounted(() => {
  if (bannerTimer) {
    clearInterval(bannerTimer)
  }
})

function goTo(path: string) {
  uni.navigateTo({ url: path })
}
</script>

<style scoped>
