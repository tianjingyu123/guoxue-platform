<template>
  <view class="flex flex-col h-screen bg-[#FAF8F5]">
    <!-- 加载骨架屏 -->
    <view v-if="isLoading" class="flex flex-col h-screen bg-[#FAF8F5]">
      <view class="h-14 bg-gradient-to-r from-[#C41E3A] to-[#C41E3A]/80" />
      <view class="flex-1 px-4 py-4 space-y-4">
        <view v-for="i in 5" :key="i" class="flex gap-3" :class="i % 2 === 0 ? 'flex-row-reverse' : ''">
          <view v-if="i % 2 !== 0" class="w-8 h-8 rounded-full bg-[#F1EDE8] flex-shrink-0" />
          <view class="flex-1">
            <view class="bg-[#F1EDE8] rounded-2xl px-4 py-3" :style="{ maxWidth: `${60 + Math.random() * 25}%`, opacity: 0.4 }">
              <view class="h-3 bg-gray-300 rounded mb-2" style="width:80%" />
              <view class="h-3 bg-gray-300 rounded mb-2" style="width:60%" />
              <view class="h-3 bg-gray-300 rounded" style="width:40%" />
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 主界面 -->
    <template v-else>
      <!-- 顶部导航 -->
      <view class="sticky top-0 z-50 text-white" style="background:linear-gradient(to right,#C41E3A,#C41E3A/80)">
        <view class="flex items-center justify-between px-4 py-3">
          <view class="flex items-center gap-3">
            <view class="p-1 rounded-full" hover-class="bg-white/20" @click="goBack">
              <text class="text-white text-lg">←</text>
            </view>
            <view class="w-10 h-10 rounded-full border-2 border-white/30 overflow-hidden flex items-center justify-center" style="background-color:rgba(255,255,255,0.2)">
              <image v-if="config.avatar" :src="config.avatar" mode="aspectFill" class="w-full h-full" />
              <text v-else class="text-white text-base">✨</text>
            </view>
            <view>
              <text class="font-semibold text-white">{{ config.name || '站长助理' }}</text>
              <text class="text-xs text-white/70 block">AI 运营助手</text>
            </view>
          </view>
          <view class="relative" @click="showMenu = !showMenu">
            <view class="p-1 rounded-full" hover-class="bg-white/20">
              <text class="text-white text-lg">⋯</text>
            </view>
            <!-- 下拉菜单 -->
            <view v-if="showMenu" class="absolute right-0 top-full mt-1 bg-white rounded-lg shadow-lg z-50 min-w-[140px] overflow-hidden" style="box-shadow: 0 4px 20px rgba(0,0,0,0.15)">
              <view class="flex items-center gap-2 px-4 py-3" hover-class="bg-[#F5F1EB]" @click="showMenu = false; showClearDialog = true">
                <text class="text-base">🗑️</text>
                <text class="text-sm text-[#2C2C2C]">清除对话</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 对话区域 -->
      <scroll-view scroll-y class="flex-1 px-4 py-4" :scroll-top="scrollTop" @scroll="onScroll">
        <!-- 欢迎消息 -->
        <view v-if="messages.length === 0 && !isSending" class="space-y-4">
          <!-- AI 欢迎语 -->
          <view class="flex gap-3">
            <view class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 overflow-hidden" style="background-color:rgba(196,30,58,0.1)">
              <image v-if="config.avatar" :src="config.avatar" mode="aspectFill" class="w-full h-full" />
              <text v-else class="text-sm" style="color:#C41E3A">✨</text>
            </view>
            <view class="flex-1">
              <view class="bg-[#F5F1EB] rounded-2xl rounded-tl-sm px-4 py-3" style="max-width:85%">
                <text class="text-sm leading-relaxed text-[#2C2C2C]">{{ config.welcomeMessage }}</text>
              </view>
            </view>
          </view>

          <!-- 能力标签 -->
          <view class="flex flex-wrap gap-2 ml-11">
            <view
              v-for="(cap, index) in config.capabilities"
              :key="index"
              class="px-2.5 py-1 rounded-full text-xs"
              style="background-color:#F5F1EB; color:#999"
            >
              <text>{{ cap }}</text>
            </view>
          </view>

          <!-- 推荐问题 -->
          <view class="ml-11 space-y-2">
            <text class="text-xs" style="color:#999">您可以试着问我：</text>
            <view class="flex flex-wrap gap-2">
              <view
                v-for="suggestion in config.suggestions"
                :key="suggestion.id"
                class="px-3 py-2 rounded-lg border border-[#E8E0D5] text-xs text-[#2C2C2C]"
                hover-class="bg-[#F5F1EB]"
                @click="handleSuggestionClick(suggestion.text)"
              >
                <text>{{ suggestion.text }}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 消息列表 -->
        <view v-for="message in messages" :key="message.id">
          <view :class="['flex gap-3 mb-4', message.role === 'user' ? 'flex-row-reverse' : '']">
            <view
              v-if="message.role === 'assistant'"
              class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 overflow-hidden"
              style="background-color:rgba(196,30,58,0.1)"
            >
              <image v-if="config.avatar" :src="config.avatar" mode="aspectFill" class="w-full h-full" />
              <text v-else class="text-sm" style="color:#C41E3A">✨</text>
            </view>
            <view :class="['flex-1', message.role === 'user' ? 'flex justify-end' : '']">
              <view
                :class="['rounded-2xl px-4 py-3', message.role === 'user' ? 'rounded-tr-sm' : 'bg-[#F5F1EB] rounded-tl-sm']"
                :style="message.role === 'user' ? 'background-color:#C41E3A;color:#fff' : ''"
                style="max-width:85%"
              >
                <view v-if="message.role === 'assistant'" class="text-sm leading-relaxed text-[#2C2C2C]">
                  <!-- Markdown 渲染 -->
                  <view v-for="(block, bIdx) in renderMarkdown(message.content)" :key="bIdx">
                    <!-- 标题 h2 -->
                    <text v-if="block.type === 'h2'" class="text-lg font-bold text-[#2C2C2C] block mt-4 mb-2">{{ block.text }}</text>
                    <!-- 标题 h3 -->
                    <text v-else-if="block.type === 'h3'" class="text-base font-semibold text-[#2C2C2C] block mt-3 mb-1">{{ block.text }}</text>
                    <!-- 引用 -->
                    <view v-else-if="block.type === 'quote'" class="border-l-4 px-3 my-2 italic" style="border-color:rgba(196,30,58,0.5); color:#999">
                      <text>{{ block.text }}</text>
                    </view>
                    <!-- 有序列表项 -->
                    <text v-else-if="block.type === 'ordered-li'" class="ml-4 block"> {{ block.index }}. {{ block.text }}</text>
                    <!-- 无序列表项 -->
                    <text v-else-if="block.type === 'unordered-li'" class="ml-4 block"> • {{ block.text }}</text>
                    <!-- 空行 -->
                    <view v-else-if="block.type === 'empty'" class="h-2" />
                    <!-- 普通段落 -->
                    <text v-else-if="block.type === 'paragraph'" class="my-1 block">
                      <template v-for="(part, pIdx) in renderInlineMarkdown(block.text)" :key="pIdx">
                        <text v-if="part.bold" class="font-semibold text-[#2C2C2C]">{{ part.text }}</text>
                        <text v-else>{{ part.text }}</text>
                      </template>
                    </text>
                  </view>
                  <!-- 图表 -->
                  <view v-if="message.chart">
                    <view v-if="message.chart.type === 'line'" class="bg-[#F0EBE5]/30 rounded-lg p-4 my-3">
                      <text class="text-sm font-medium mb-3 block">{{ message.chart.title }}</text>
                      <view class="flex items-end gap-2" style="height:128px">
                        <view
                          v-for="(item, cIdx) in message.chart.data"
                          :key="cIdx"
                          class="flex-1 flex flex-col items-center gap-1"
                        >
                          <view
                            class="w-full rounded-t transition-all"
                            :style="{
                              height: ((item.value / chartMaxValue(message.chart)) * 100) + '%',
                              backgroundColor: 'rgba(196,30,58,0.8)'
                            }"
                          />
                          <text class="text-xs" style="color:#999">{{ item.label }}</text>
                        </view>
                      </view>
                    </view>
                    <view v-if="message.chart.type === 'pie'" class="bg-[#F0EBE5]/30 rounded-lg p-4 my-3">
                      <text class="text-sm font-medium mb-3 block">{{ message.chart.title }}</text>
                      <view class="space-y-2">
                        <view v-for="(item, cIdx) in message.chart.data" :key="cIdx" class="flex items-center gap-2">
                          <view class="w-3 h-3 rounded-full" :style="{ backgroundColor: item.color || '#C41E3A' }" />
                          <text class="text-sm flex-1 text-[#2C2C2C]">{{ item.label }}</text>
                          <text class="text-sm font-medium text-[#2C2C2C]">{{ item.value }}人</text>
                          <text class="text-xs" style="color:#999">({{ piePercent(item.value, message.chart.data) }}%)</text>
                        </view>
                      </view>
                    </view>
                  </view>
                  <!-- 表格 -->
                  <view v-if="message.table" class="bg-[#F0EBE5]/30 rounded-lg p-4 my-3 overflow-x-auto">
                    <text class="text-sm font-medium mb-3 block">{{ message.table.title }}</text>
                    <view class="w-full text-sm">
                      <!-- 表头 -->
                      <view class="flex border-b border-[#E8E0D5]">
                        <view
                          v-for="(header, hIdx) in message.table.headers"
                          :key="hIdx"
                          class="flex-1 py-2 px-2 font-medium"
                          style="color:#999"
                        >
                          <text>{{ header }}</text>
                        </view>
                      </view>
                      <!-- 行 -->
                      <view
                        v-for="(row, rIdx) in message.table.rows"
                        :key="rIdx"
                        class="flex border-b border-[#E8E0D5]/50"
                        :class="rIdx === message.table.rows.length - 1 ? 'border-b-0' : ''"
                      >
                        <view v-for="(cell, cIdx) in row" :key="cIdx" class="flex-1 py-2 px-2">
                          <text class="text-[#2C2C2C]">{{ cell }}</text>
                        </view>
                      </view>
                    </view>
                  </view>
                  <!-- 操作建议 -->
                  <view v-if="message.actions && message.actions.length > 0" class="flex flex-wrap gap-2 mt-3">
                    <view
                      v-for="(action, aIdx) in message.actions"
                      :key="aIdx"
                      class="px-3 py-1.5 rounded-lg border text-xs"
                      :class="[
                        action.priority === 'high' ? 'border-[#C41E3A] text-[#C41E3A]' : '',
                        action.priority === 'medium' ? 'border-amber-500 text-amber-600' : '',
                        !action.priority || action.priority === 'low' ? 'border-[#E8E0D5] text-[#2C2C2C]' : ''
                      ]"
                      @click="handleActionClick(action)"
                    >
                      <text>{{ action.title }}</text>
                      <text v-if="action.link" class="ml-1 text-xs">↗</text>
                    </view>
                  </view>
                </view>
                <text v-else class="text-sm text-white">{{ message.content }}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 流式输出中 -->
        <view v-if="isSending" class="flex gap-3 mb-4">
          <view class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 overflow-hidden" style="background-color:rgba(196,30,58,0.1)">
            <image v-if="config.avatar" :src="config.avatar" mode="aspectFill" class="w-full h-full" />
            <text v-else class="text-sm" style="color:#C41E3A">✨</text>
          </view>
          <view class="flex-1">
            <view class="bg-[#F5F1EB] rounded-2xl rounded-tl-sm px-4 py-3" style="max-width:85%">
              <view class="text-sm leading-relaxed text-[#2C2C2C]">
                <template v-if="streamingContent">
                  <!-- Markdown 渲染流式内容 -->
                  <view v-for="(block, bIdx) in renderMarkdown(streamingContent)" :key="bIdx">
                    <text v-if="block.type === 'h2'" class="text-lg font-bold text-[#2C2C2C] block mt-4 mb-2">{{ block.text }}</text>
                    <text v-else-if="block.type === 'h3'" class="text-base font-semibold text-[#2C2C2C] block mt-3 mb-1">{{ block.text }}</text>
                    <view v-else-if="block.type === 'quote'" class="border-l-4 px-3 my-2 italic" style="border-color:rgba(196,30,58,0.5); color:#999">
                      <text>{{ block.text }}</text>
                    </view>
                    <text v-else-if="block.type === 'ordered-li'" class="ml-4 block"> {{ block.index }}. {{ block.text }}</text>
                    <text v-else-if="block.type === 'unordered-li'" class="ml-4 block"> • {{ block.text }}</text>
                    <view v-else-if="block.type === 'empty'" class="h-2" />
                    <text v-else-if="block.type === 'paragraph'" class="my-1 block">
                      <template v-for="(part, pIdx) in renderInlineMarkdown(block.text)" :key="pIdx">
                        <text v-if="part.bold" class="font-semibold text-[#2C2C2C]">{{ part.text }}</text>
                        <text v-else>{{ part.text }}</text>
                      </template>
                    </text>
                  </view>
                  <!-- 流式模式下的图表 -->
                  <view v-if="streamingChart">
                    <view v-if="streamingChart.type === 'line'" class="bg-[#F0EBE5]/30 rounded-lg p-4 my-3">
                      <text class="text-sm font-medium mb-3 block">{{ streamingChart.title }}</text>
                      <view class="flex items-end gap-2" style="height:128px">
                        <view v-for="(item, cIdx) in streamingChart.data" :key="cIdx" class="flex-1 flex flex-col items-center gap-1">
                          <view class="w-full rounded-t transition-all" :style="{ height: ((item.value / chartMaxValue(streamingChart)) * 100) + '%', backgroundColor: 'rgba(196,30,58,0.8)' }" />
                          <text class="text-xs" style="color:#999">{{ item.label }}</text>
                        </view>
                      </view>
                    </view>
                    <view v-if="streamingChart.type === 'pie'" class="bg-[#F0EBE5]/30 rounded-lg p-4 my-3">
                      <text class="text-sm font-medium mb-3 block">{{ streamingChart.title }}</text>
                      <view class="space-y-2">
                        <view v-for="(item, cIdx) in streamingChart.data" :key="cIdx" class="flex items-center gap-2">
                          <view class="w-3 h-3 rounded-full" :style="{ backgroundColor: item.color || '#C41E3A' }" />
                          <text class="text-sm flex-1 text-[#2C2C2C]">{{ item.label }}</text>
                          <text class="text-sm font-medium text-[#2C2C2C]">{{ item.value }}人</text>
                          <text class="text-xs" style="color:#999">({{ piePercent(item.value, streamingChart.data) }}%)</text>
                        </view>
                      </view>
                    </view>
                  </view>
                  <!-- 流式模式下的表格 -->
                  <view v-if="streamingTable" class="bg-[#F0EBE5]/30 rounded-lg p-4 my-3 overflow-x-auto">
                    <text class="text-sm font-medium mb-3 block">{{ streamingTable.title }}</text>
                    <view class="w-full text-sm">
                      <view class="flex border-b border-[#E8E0D5]">
                        <view v-for="(header, hIdx) in streamingTable.headers" :key="hIdx" class="flex-1 py-2 px-2 font-medium" style="color:#999">
                          <text>{{ header }}</text>
                        </view>
                      </view>
                      <view v-for="(row, rIdx) in streamingTable.rows" :key="rIdx" class="flex border-b border-[#E8E0D5]/50" :class="rIdx === streamingTable.rows.length - 1 ? 'border-b-0' : ''">
                        <view v-for="(cell, cIdx) in row" :key="cIdx" class="flex-1 py-2 px-2">
                          <text class="text-[#2C2C2C]">{{ cell }}</text>
                        </view>
                      </view>
                    </view>
                  </view>
                  <!-- 流式模式下的操作建议 -->
                  <view v-if="streamingActions.length > 0" class="flex flex-wrap gap-2 mt-3">
                    <view v-for="(action, aIdx) in streamingActions" :key="aIdx" class="px-3 py-1.5 rounded-lg border text-xs" :class="[action.priority === 'high' ? 'border-[#C41E3A] text-[#C41E3A]' : '', action.priority === 'medium' ? 'border-amber-500 text-amber-600' : '', !action.priority || action.priority === 'low' ? 'border-[#E8E0D5] text-[#2C2C2C]' : '']" @click="handleActionClick(action)">
                      <text>{{ action.title }}</text>
                      <text v-if="action.link" class="ml-1">↗</text>
                    </view>
                  </view>
                </template>
                <!-- 加载中动画 -->
                <template v-else>
                  <view class="flex items-center gap-1">
                    <view class="w-2 h-2 rounded-full" style="background-color:rgba(196,30,58,0.6);animation:bounce 1.4s infinite" />
                    <view class="w-2 h-2 rounded-full" style="background-color:rgba(196,30,58,0.6);animation:bounce 1.4s infinite 0.15s" />
                    <view class="w-2 h-2 rounded-full" style="background-color:rgba(196,30,58,0.6);animation:bounce 1.4s infinite 0.3s" />
                  </view>
                </template>
              </view>
            </view>
          </view>
        </view>

        <view id="messages-end" />
      </scroll-view>

      <!-- 底部输入区 -->
      <view class="sticky bottom-0 bg-white border-t border-[#E8E0D5] px-4 py-3">
        <view class="flex items-center gap-2">
          <view
            class="w-10 h-10 rounded-full flex items-center justify-center"
            :class="isRecording ? '' : ''"
            :style="isRecording ? '' : ''"
            @click="handleVoiceToggle"
          >
            <text :style="isRecording ? 'color:#EF4444;font-size:20px' : 'color:#999;font-size:20px'">{{ isRecording ? '🎙️' : '🎤' }}</text>
          </view>
          <input
            id="chat-input"
            class="flex-1 px-4 py-2.5 rounded-xl border border-[#E8E0D5] text-sm text-[#2C2C2C]"
            style="background-color:#F5F1EB"
            placeholder="输入您的问题..."
            :value="inputText"
            @input="onInput"
            @confirm="handleSend()"
            :disabled="isSending"
          />
          <view
            class="w-10 h-10 rounded-xl flex items-center justify-center"
            :class="!inputText.trim() || isSending ? '' : ''"
            :style="!inputText.trim() || isSending ? 'background-color:#F5F1EB' : 'background-color:#C41E3A'"
            @click="handleSend()"
          >
            <text :class="inputText.trim() && !isSending ? 'text-white' : 'text-[#999]'" class="text-lg">📤</text>
          </view>
        </view>
        <!-- 录音状态提示 -->
        <view v-if="isRecording" class="mt-2 flex items-center justify-center gap-2">
          <view class="w-2 h-2 rounded-full" style="background-color:#EF4444;animation:pulse 1.5s infinite" />
          <text class="text-sm" style="color:#EF4444">正在录音...</text>
        </view>
      </view>

      <!-- 清除对话确认弹窗 -->
      <view v-if="showClearDialog" class="fixed inset-0 z-50 flex items-center justify-center px-4" style="background-color:rgba(0,0,0,0.6)" @click="showClearDialog = false">
        <view class="w-full max-w-sm bg-white rounded-2xl overflow-hidden" @click.stop>
          <view class="p-6">
            <text class="text-lg font-semibold text-[#2C2C2C] block mb-2">清除对话</text>
            <text class="text-sm" style="color:#999">确定要清除所有对话记录吗？此操作不可恢复。</text>
          </view>
          <view class="flex border-t border-[#E8E0D5]">
            <view class="flex-1 py-3 text-center text-sm border-r border-[#E8E0D5]" hover-class="bg-[#F5F1EB]" style="color:#999" @click="showClearDialog = false">
              <text>取消</text>
            </view>
            <view class="flex-1 py-3 text-center text-sm font-medium" hover-class="bg-[#F5F1EB]" style="color:#C41E3A" @click="handleClearSession">
              <text>确定清除</text>
            </view>
          </view>
        </view>
      </view>
    </template>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'

// 类型定义
interface ActionSuggestion {
  title: string
  link?: string
  priority?: 'high' | 'medium' | 'low'
}

interface ChartDataItem {
  label: string
  value: number
  color?: string
}

interface ChartData {
  type: 'line' | 'pie'
  title: string
  data: ChartDataItem[]
}

interface TableData {
  title: string
  headers: string[]
  rows: string[][]
}

interface AssistantMessage {
  id: string
  role: 'user' | 'assistant'
  type: string
  content: string
  createdAt: string
  chart?: ChartData
  table?: TableData
  actions?: ActionSuggestion[]
}

interface Suggestion {
  id: number
  text: string
}

interface StationAssistantConfig {
  name: string
  avatar: string
  welcomeMessage: string
  capabilities: string[]
  suggestions: Suggestion[]
}

interface MarkdownBlock {
  type: 'h2' | 'h3' | 'quote' | 'ordered-li' | 'unordered-li' | 'empty' | 'paragraph'
  text: string
  index?: number
}

interface InlinePart {
  text: string
  bold: boolean
}

// 响应式状态
const messages = ref<AssistantMessage[]>([])
const inputText = ref('')
const isLoading = ref(true)
const isSending = ref(false)
const isRecording = ref(false)
const showClearDialog = ref(false)
const showMenu = ref(false)
const streamingContent = ref('')
const streamingChart = ref<ChartData | null>(null)
const streamingTable = ref<TableData | null>(null)
const streamingActions = ref<ActionSuggestion[]>([])
const scrollTop = ref(0)

const config = ref<StationAssistantConfig>({
  name: '站长助理',
  avatar: '',
  welcomeMessage: '您好！我是您的AI运营助手，可以帮您分析运营数据、生成推广文案、回答业务问题。请问有什么可以帮您的？',
  capabilities: ['数据分析', '文案生成', '课程推荐', '用户洞察', '运营建议'],
  suggestions: [
    { id: 1, text: '本周的运营数据怎么样？' },
    { id: 2, text: '帮我写一个课程推广文案' },
    { id: 3, text: '有哪些课程需要重点推广？' },
    { id: 4, text: '分析一下用户增长趋势' },
  ],
})

// 模拟回复
const mockResponses: Record<string, string> = {
  '本周的运营数据怎么样？': '本周运营数据概况：\n\n## 核心指标\n- 新增用户：128人（环比+15%）\n- 活跃用户：856人（环比+8%）\n- 课程报名：32人次（环比+22%）\n- 商品销售：¥12,680（环比+18%）\n\n## 亮点\n八字入门课程本周报名量突出，建议加大推广力度。\n\n## 建议\n1. 周末可安排一场直播答疑\n2. 风水类内容互动率高，可增加发布频次',
  '帮我写一个课程推广文案': '【课程推广文案】\n\n> 以下是为您生成的推广文案\n\n## 标题\n三天学会八字命理，掌握你的人生密码！\n\n## 正文\n你是不是也想知道——\n• 我的财运什么时候来？\n• 事业瓶颈期该如何突破？\n• 感情中为什么总是遇到同样的问题？\n\n**八字命理入门实战班**\n- 零基础也能学，三天掌握核心方法\n- 实战案例教学，学完就能用\n- 资深命理师亲授，20年经验倾囊相授\n\n## 优惠信息\n> 限时优惠：原价¥599，现在报名仅需¥299',
  '有哪些课程需要重点推广？': '根据数据分析，以下课程建议重点推广：\n\n## 重点推荐\n1. **八字命理入门实战班** - 报名转化率最高（28%）\n2. **风水堪舆实战** - 搜索热度上升最快\n3. **紫微斗数精讲** - 学员满意度最高（4.9分）\n\n## 推广建议\n- 八字课程：配合免费试听吸引报名\n- 风水课程：利用短视频展示案例效果\n- 紫微课程：老学员推荐优惠\n\n> 如加大推广力度，预计下周报名量可提升30-50%。',
  '分析一下用户增长趋势': '## 用户增长趋势分析\n\n**近30天增长曲线**\n- 日均新增：25人\n- 峰值日：上周六（42人）\n- 谷值日：周二（12人）\n\n**用户来源分布**\n1. 朋友圈分享：42%\n2. 搜索流量：28%\n3. 公众号导流：18%\n4. 其他：12%\n\n## 核心洞察\n1. 周末新增用户明显高于工作日\n2. 分享裂变是主要增长引擎\n3. 搜索流量占比在持续提升\n\n## 建议\n加强周末活动运营，优化SEO关键词。',
}

// MARKDOWN 渲染
function renderMarkdown(content: string): MarkdownBlock[] {
  const lines = content.split('\n')
  const blocks: MarkdownBlock[] = []
  let index = 1

  for (const line of lines) {
    if (line.startsWith('## ')) {
      blocks.push({ type: 'h2', text: line.slice(3) })
    } else if (line.startsWith('### ')) {
      blocks.push({ type: 'h3', text: line.slice(4) })
    } else if (line.startsWith('> ')) {
      blocks.push({ type: 'quote', text: line.slice(2) })
    } else if (/^\d+\.\s/.test(line)) {
      blocks.push({ type: 'ordered-li', text: line.replace(/^\d+\.\s/, ''), index })
      index++
    } else if (line.startsWith('- ') || line.startsWith('• ')) {
      blocks.push({ type: 'unordered-li', text: line.replace(/^[-•]\s/, '') })
    } else if (!line.trim()) {
      blocks.push({ type: 'empty', text: '' })
    } else {
      blocks.push({ type: 'paragraph', text: line })
    }
  }
  return blocks
}

function renderInlineMarkdown(text: string): InlinePart[] {
  const parts = text.split(/(\*\*[^*]+\*\*)/g)
  return parts.map((part) => {
    if (part.startsWith('**') && part.endsWith('**')) {
      return { text: part.slice(2, -2), bold: true }
    }
    return { text: part, bold: false }
  })
}

// 图表辅助
function chartMaxValue(chart: ChartData): number {
  return Math.max(...chart.data.map(d => d.value), 1)
}

function piePercent(value: number, data: ChartDataItem[]): string {
  const total = data.reduce((sum, d) => sum + d.value, 0)
  return total > 0 ? ((value / total) * 100).toFixed(1) : '0.0'
}

// 交互方法
function onInput(e: any) {
  inputText.value = e.detail.value
}

function handleSend(text?: string) {
  const content = text || inputText.value.trim()
  if (!content || isSending.value) return

  // 添加用户消息
  messages.value.push({
    id: 'user_' + Date.now(),
    role: 'user',
    type: 'text',
    content,
    createdAt: new Date().toISOString(),
  })
  inputText.value = ''
  isSending.value = true
  streamingContent.value = ''
  streamingChart.value = null
  streamingTable.value = null
  streamingActions.value = []

  // 模拟流式回复
  const response = mockResponses[content] || '感谢您的提问！我已经收到您的问题，正在为您分析处理。根据我的知识库，建议您查看相关课程或联系客服获取更详细的信息。如需进一步帮助，请随时告诉我。'

  // 模拟流式输出
  let index = 0
  try {
    const timer = setInterval(() => {
      if (index < response.length) {
        const chunkSize = Math.min(3, response.length - index)
        streamingContent.value += response.substring(index, index + chunkSize)
        scrollToBottom()
        index += chunkSize
      } else {
        clearInterval(timer)
        // 添加完整助手消息
        messages.value.push({
          id: 'ai_' + Date.now(),
          role: 'assistant',
          type: 'text',
          content: response,
          createdAt: new Date().toISOString(),
        })
        streamingContent.value = ''
        isSending.value = false

        // 滚动到底部
        setTimeout(() => {
          scrollToBottom()
        }, 50)
      }
    }, 30)
  } catch (err) {
    console.error('发送消息失败', err)
    uni.showToast({ title: '发送失败，请重试', icon: 'none' })
  } finally {
    isSending.value = false
  }
}

function handleSuggestionClick(text: string) {
  handleSend(text)
}

function handleActionClick(action: ActionSuggestion) {
  if (action.link) {
    uni.navigateTo({ url: action.link })
  }
}

function handleVoiceToggle() {
  isRecording.value = !isRecording.value
  if (isRecording.value) {
    uni.showToast({ title: '语音功能开发中', icon: 'none' })
  }
}

function handleClearSession() {
  messages.value = []
  showClearDialog.value = false
  showMenu.value = false
  uni.showToast({ title: '对话已清除', icon: 'success' })
}

function scrollToBottom() {
  const query = uni.createSelectorQuery()
  query.select('#messages-end').boundingClientRect((res: any) => {
    if (res) {
      scrollTop.value = res.top || 0
    }
  }).exec()
}

function onScroll() {
  // 滚动时关闭菜单
  showMenu.value = false
}

function goBack() {
  uni.navigateBack()
}

onMounted(() => {
  // 模拟加载
  setTimeout(() => {
    isLoading.value = false
    // 自动聚焦输入框
    setTimeout(() => {
      try {
        uni.createSelectorQuery().select('#chat-input').focus().exec()
      } catch (e) {
        console.warn('自动聚焦失败', e)
      }
    }, 300)
  }, 500)
})
</script>

<style scoped>
/* 弹跳动画 */
@keyframes bounce {
  0%, 80%, 100% { transform: translateY(0); }
  40% { transform: translateY(-6px); }
}

/* 脉冲动画 */
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

/* 固定定位 */
.fixed {
  position: fixed;
}
</style>
