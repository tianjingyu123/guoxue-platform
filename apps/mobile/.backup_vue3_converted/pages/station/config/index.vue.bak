              </template>
              <view
                class="absolute inset-0 flex items-center justify-center"
                style="position:absolute;top:0;left:0;right:0;bottom:0;background-color:rgba(0,0,0,0.3);display:flex;align-items:center;justify-content:center"
              >
                <text v-if="uploadingQrcode" style="font-size:22px;color:#fff;animation:spin 1s linear infinite;display:inline-block">⟳</text>
                <text v-else style="font-size:22px;color:#fff">📤</text>
              </view>
