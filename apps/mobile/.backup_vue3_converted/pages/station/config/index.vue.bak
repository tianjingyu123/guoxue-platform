</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

// ----- 类型定义 -----
interface StationMasterInfo {
  avatar?: string
  nickname: string
  phone: string
  joinDate: string
}

interface StationConfig {
  id: number
  name: string
  logo?: string
  description?: string
  themeColorId: string
  customPrimaryColor?: string
  customSecondaryColor?: string
  contactPhone?: string
  contactWechat?: string
  contactEmail?: string
  miniProgramQrcode?: string
  status: 'active' | 'pending' | 'suspended'
  code: string
  updatedAt: string
  masterInfo: StationMasterInfo
}

interface StationSummary {
  memberCount: number
  totalRevenue: number
  contentCount: number
  visitCount: number
}

// ----- 预设数据 -----
const THEME_PRESETS = [
  { id: 'guoxue', name: '国学红', primary: '#C41E3A', secondary: '#C9A96E' },
  { id: 'forest', name: '墨绿', primary: '#2E7D32', secondary: '#66BB6A' },
  { id: 'ocean', name: '深蓝', primary: '#1A365D', secondary: '#4299E1' },
  { id: 'purple', name: '紫色', primary: '#553C9A', secondary: '#B794F4' },
  { id: 'autumn', name: '秋橙', primary: '#C05621', secondary: '#ED8936' },
  { id: 'cherry', name: '樱粉', primary: '#B83280', secondary: '#F687B3' },
  { id: 'ink', name: '墨色', primary: '#2D3748', secondary: '#718096' },
  { id: 'jade', name: '青玉', primary: '#276749', secondary: '#48BB78' },
]

const MOCK_CONFIG: StationConfig = {
  id: 1,
  name: '热卜国学·杭州西湖驿站',
  logo: '',
  description: '热卜国学杭州旗舰驿站，环境优雅，设施齐全，提供八字、风水、紫微等专业课程培训及一对一咨询服务。',
  themeColorId: 'guoxue',
  contactPhone: '0571-88888888',
  contactWechat: 'rebu_hz',
  contactEmail: 'hz@rebu.com',
  miniProgramQrcode: '',
  status: 'active',
  code: 'STATION_HZ_001',
  updatedAt: '2025-01-10 14:30',
  masterInfo: {
    avatar: '',
    nickname: '王老师',
    phone: '138****8888',
    joinDate: '2024-01-15',
  },
}

const MOCK_SUMMARY: StationSummary = {
  memberCount: 1280,
  totalRevenue: 326000,
  contentCount: 356,
  visitCount: 128000,
}

// ----- 响应式状态 -----
const loading = ref(true)
const saving = ref(false)
const error = ref<string | null>(null)
const config = ref<StationConfig | null>(null)
const summary = ref<StationSummary | null>(null)

const formData = ref({
  name: '',
  logo: '',
  description: '',
  themeColorId: 'guoxue',
  contactPhone: '',
  contactWechat: '',
  contactEmail: '',
  miniProgramQrcode: '',
})

const selectedTheme = ref('guoxue')
const customColor = ref({ primary: '#C41E3A', secondary: '#C9A96E' })
const useCustomColor = ref(false)
const uploadingLogo = ref(false)
const uploadingQrcode = ref(false)

// ----- 计算属性 -----
const currentThemeColor = computed(() => {
  if (useCustomColor.value) return customColor.value
  const preset = THEME_PRESETS.find(p => p.id === selectedTheme.value)
  return preset || { primary: '#C41E3A', secondary: '#C9A96E' }
})

const statusBadgeStyle = computed(() => {
  if (!config.value) return {}
  switch (config.value.status) {
    case 'active':
      return { backgroundColor: 'rgba(34,197,94,0.1)', color: '#22C55E' }
    case 'pending':
      return { backgroundColor: 'rgba(234,179,8,0.1)', color: '#EAB308' }
    default:
      return { backgroundColor: 'rgba(239,68,68,0.1)', color: '#EF4444' }
  }
})

const statusText = computed(() => {
  if (!config.value) return ''
  switch (config.value.status) {
    case 'active': return '运营中'
    case 'pending': return '审核中'
    default: return '已暂停'
  }
})

// ----- 工具函数 -----
function hexAlpha(hex: string, alpha: number): string {
  const r = parseInt(hex.slice(1, 3), 16)
  const g = parseInt(hex.slice(3, 5), 16)
  const b = parseInt(hex.slice(5, 7), 16)
  return `rgba(${r}, ${g}, ${b}, ${alpha})`
}

// ----- 导航 -----
function goBack() {
  uni.navigateBack()
}

// ----- 数据加载 -----
async function loadData() {
  // 生产环境从路由参数获取 stationId:
  // const pages = getCurrentPages()
  // const currentPage = pages[pages.length - 1] as any
  // const stationId = currentPage?.$page?.options?.id ? Number(currentPage.$page.options.id) : undefined

  loading.value = true
  error.value = null

  try {
    // 模拟 API 请求（约 600ms 延迟以展示 loading 状态）
    await new Promise(resolve => setTimeout(resolve, 600))

    // 模拟响应
    const configData = JSON.parse(JSON.stringify(MOCK_CONFIG)) as StationConfig
    const summaryData = JSON.parse(JSON.stringify(MOCK_SUMMARY)) as StationSummary

    config.value = configData
    summary.value = summaryData

    // 初始化表单数据
    formData.value = {
      name: configData.name,
      logo: configData.logo || '',
      description: configData.description || '',
      themeColorId: configData.themeColorId,
      contactPhone: configData.contactPhone || '',
      contactWechat: configData.contactWechat || '',
      contactEmail: configData.contactEmail || '',
      miniProgramQrcode: configData.miniProgramQrcode || '',
    }

    selectedTheme.value = configData.themeColorId || 'guoxue'

    if (configData.customPrimaryColor) {
      useCustomColor.value = true
      customColor.value = {
        primary: configData.customPrimaryColor,
        secondary: configData.customSecondaryColor || '#C9A96E',
      }
    }
  } catch {
    error.value = '加载配置失败'
  } finally {
    loading.value = false
  }
}

// ----- 保存配置 -----
async function handleSave() {
  if (!config.value) return

  if (!formData.value.name?.trim()) {
    uni.showToast({ title: '请输入分站名称', icon: 'none' })
    return
  }

  saving.value = true

  try {
    // 构建更新参数
    const updateData = {
      ...formData.value,
      themeColorId: useCustomColor.value ? 'custom' : selectedTheme.value,
      customPrimaryColor: useCustomColor.value ? customColor.value.primary : undefined,
      customSecondaryColor: useCustomColor.value ? customColor.value.secondary : undefined,
    }

    // 模拟 API 请求（约 1000ms 延迟）
    await new Promise(resolve => setTimeout(resolve, 1000))

    // 更新本地 config 状态
    if (config.value) {
      config.value = {
        ...config.value,
        ...(updateData as any),
      }
    }

    uni.showToast({ title: '保存成功', icon: 'success' })
  } catch {
    uni.showToast({ title: '保存失败，请重试', icon: 'none' })
  } finally {
    saving.value = false
  }
}

// ----- Logo 上传 -----
function handleLogoUpload() {
  uni.chooseImage({
    count: 1,
    sizeType: ['compressed'],
    sourceType: ['album', 'camera'],
    success: async (res) => {
      const tempFile = res.tempFiles[0]

      // 验证文件大小（最大 2MB）
      if (tempFile.size > 2 * 1024 * 1024) {
        uni.showToast({ title: '图片大小不能超过2MB', icon: 'none' })
        return
      }

      uploadingLogo.value = true

      try {
        // 模拟上传（约 1500ms 延迟）
        await new Promise(resolve => setTimeout(resolve, 1500))

        // 使用临时路径作为预览 URL
        formData.value.logo = res.tempFilePaths[0]

        uni.showToast({ title: 'Logo上传成功', icon: 'success' })
      } catch {
        uni.showToast({ title: '上传失败，请重试', icon: 'none' })
      } finally {
        uploadingLogo.value = false
      }
    },
  })
}

// ----- 小程序码上传 -----
function handleQrcodeUpload() {
  uni.chooseImage({
    count: 1,
    sizeType: ['compressed'],
    sourceType: ['album'],
    success: async (res) => {
      const tempFile = res.tempFiles[0]

      // 验证文件大小（最大 2MB）
      if (tempFile.size > 2 * 1024 * 1024) {
        uni.showToast({ title: '图片大小不能超过2MB', icon: 'none' })
        return
      }

      uploadingQrcode.value = true

      try {
        // 模拟上传（约 1500ms 延迟）
        await new Promise(resolve => setTimeout(resolve, 1500))

        // 使用临时路径作为预览 URL
        formData.value.miniProgramQrcode = res.tempFilePaths[0]

        uni.showToast({ title: '小程序码上传成功', icon: 'success' })
      } catch {
        uni.showToast({ title: '上传失败，请重试', icon: 'none' })
      } finally {
        uploadingQrcode.value = false
      }
    },
  })
}

// ----- 生命周期 -----
onMounted(() => {
  loadData()
})
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
</style>
