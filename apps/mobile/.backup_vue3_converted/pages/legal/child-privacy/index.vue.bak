<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- ===== Loading骨架屏 ===== -->
    <template v-if="loading">
      <header class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5] px-4 py-3">
        <view class="flex items-center gap-3">
          <view class="w-8 h-8 rounded-full skeleton-bg" />
          <view class="h-5 w-32 skeleton-bg rounded" />
        </view>
      </header>
      <view class="p-4 space-y-4">
        <view class="h-8 w-48 skeleton-bg rounded" />
        <view class="h-4 w-full skeleton-bg rounded" />
        <view class="h-4 w-full skeleton-bg rounded" />
        <view class="h-4 w-3/4 skeleton-bg rounded" />
        <view class="h-32 w-full skeleton-bg rounded-lg" />
        <view class="h-4 w-full skeleton-bg rounded" />
        <view class="h-4 w-full skeleton-bg rounded" />
      </view>
    </template>

    <!-- ===== 主内容 ===== -->
    <template v-else>
      <!-- 导航栏 -->
      <header class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5] px-4 py-3">
        <view class="flex items-center justify-between">
          <view class="flex items-center gap-3">
            <view @click="goBack" class="p-1 -ml-1"><text class="text-2xl leading-none">&#8592;</text></view>
            <view class="flex items-center gap-2">
              <text class="text-lg text-[#C41E3A]">&#128737;</text>
              <text class="text-lg font-semibold">儿童隐私保护</text>
            </view>
          </view>
          <text v-if="document" class="text-xs text-[#999]">v{{ document.version }}</text>
        </view>
      </header>

      <!-- 主内容区 -->
      <scroll-view
        scroll-y
        class="flex-1"
        @scroll="handleScroll"
        :scroll-y="true"
        :ref="'contentRef'"
        id="contentScroll"
      >
        <view class="max-w-3xl mx-auto p-4 md:p-6">
          <!-- 重要提示卡片 -->
          <view class="p-4 mb-6 rounded-lg" style="background:rgba(196,30,58,0.05);border:1px solid rgba(196,30,58,0.2)">
            <view class="flex gap-3">
              <text class="text-lg text-[#C41E3A] shrink-0 mt-0.5">&#128737;</text>
              <view class="text-sm">
                <text class="font-medium text-[#C41E3A] block mb-1">儿童隐私保护声明</text>
                <text class="text-[#999] block">本平台高度重视儿童个人信息保护，严格遵守《儿童个人信息网络保护规定》及相关法律法规。如您是未满14周岁的未成年人，请在监护人陪同下阅读本声明。</text>
              </view>
            </view>
          </view>

          <!-- 版本信息 -->
          <view v-if="document" class="flex flex-wrap items-center gap-4 text-xs text-[#999] mb-6">
            <text>更新日期：{{ document.effectiveDate }}</text>
            <text v-if="document.previousVersion" class="text-[#C41E3A] flex items-center gap-1">
              查看历史版本 <text class="text-xs">&#8599;</text>
            </text>
          </view>

          <!-- 文档内容 - 逐节展示，支持锚点 -->
          <view class="text-sm text-[#666] leading-relaxed space-y-4">
            <view
              v-for="(section, idx) in sections"
              :key="idx"
              :id="'section-' + idx"
              class="mb-6 section-anchor"
              :data-section-id="'section-' + idx"
            >
              <text class="text-base font-semibold text-[#2C2C2C] block mb-3 pb-2" style="border-bottom:1px solid rgba(232,224,213,0.6)">
                {{ section.title }}
              </text>
              <text class="text-sm text-[#666] leading-relaxed block">{{ section.content }}</text>
            </view>
          </view>

          <!-- 监护人联系方式 -->
          <view class="mt-8 p-4 rounded-lg" style="background:rgba(250,248,245,0.5);border:1px solid rgba(232,224,213,0.6)">
            <text class="font-medium text-[#2C2C2C] block mb-3">监护人联系方式</text>
            <text class="text-sm text-[#999] block mb-4">如您是未成年人的监护人，对我们处理您所监护的未成年人个人信息有任何疑问、意见或建议，或需要行使相关权利，请通过以下方式联系我们：</text>
            <view class="space-y-3">
              <view @click="contactEmail" class="flex items-center gap-3 p-3 bg-white rounded-lg border border-[#E8E0D5]/60">
                <view class="w-10 h-10 rounded-full bg-[#C41E3A]/10 flex items-center justify-center">
                  <text class="text-[#C41E3A]">&#9993;</text>
                </view>
                <view>
                  <text class="text-sm font-medium text-[#2C2C2C] block">邮件联系</text>
                  <text class="text-sm text-[#999]">privacy@rebu.com</text>
                </view>
              </view>
              <view @click="contactPhone" class="flex items-center gap-3 p-3 bg-white rounded-lg border border-[#E8E0D5]/60">
                <view class="w-10 h-10 rounded-full bg-[#C41E3A]/10 flex items-center justify-center">
                  <text class="text-[#C41E3A]">&#9742;</text>
                </view>
                <view>
                  <text class="text-sm font-medium text-[#2C2C2C] block">电话联系</text>
                  <text class="text-sm text-[#999]">400-888-8888（工作日 9:00-18:00）</text>
                </view>
              </view>
            </view>
          </view>

          <!-- 底部确认按钮 -->
          <view class="mt-8 pb-8">
            <view
              v-if="!confirmed"
              @click="handleConfirm"
              class="w-full py-3 rounded-full text-center text-sm font-medium"
              :class="scrolledToBottom ? 'bg-[#C41E3A] text-white' : 'bg-[#E8E0D5] text-[#999]'"
            >
              <text>{{ confirming ? '确认中...' : scrolledToBottom ? '我已阅读并理解' : '请阅读完整内容' }}</text>
            </view>
            <view v-else class="text-center text-xs text-[#999]">
              您已于 {{ confirmedDate }} 阅读并确认本声明
            </view>
          </view>
        </view>
      </scroll-view>

      <!-- 目录浮标按钮 -->
      <view class="fixed bottom-20 right-4 z-10">
        <view
          @click="showMobileToc = !showMobileToc"
          class="w-12 h-12 rounded-full bg-[#C41E3A] text-white shadow-lg flex items-center justify-center"
        >
          <text class="text-xs font-medium">目录</text>
        </view>
      </view>

      <!-- 目录弹窗 -->
      <view v-if="showMobileToc" class="fixed inset-0 z-50">
        <view class="absolute inset-0 bg-black/50" @click="showMobileToc = false" />
        <view class="absolute bottom-20 right-4 w-48 bg-white border border-[#E8E0D5] rounded-lg shadow-xl p-2 max-h-64 overflow-y-auto">
          <view
            v-for="(item, idx) in toc"
            :key="idx"
            @click="scrollToSection(item.id, idx)"
            class="block w-full text-left text-sm py-2 px-3 rounded transition-colors"
            :class="[
              activeSection === item.id ? 'bg-[#C41E3A]/10 text-[#C41E3A] font-medium' : 'text-[#999]',
              item.level === 3 ? 'pl-5' : ''
            ]"
          >
            <text>{{ item.title }}</text>
          </view>
        </view>
      </view>
    </template>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'

interface LegalDocument {
  version: string
  effectiveDate: string
  content: string
  isConfirmed: boolean
  previousVersion?: string
}

interface TocItem {
  id: string
  title: string
  level: number
}

const loading = ref(true)
const document = ref<LegalDocument | null>(null)
const confirmed = ref(false)
const confirming = ref(false)
const confirmedDate = ref('')
const scrolledToBottom = ref(false)
const showMobileToc = ref(false)
const activeSection = ref('')

// 文档章节数据
const sections = [
  { title: '1. 适用范围', content: '本声明适用于未满14周岁的未成年人使用儒布国学文化平台的各项服务。我们理解保护儿童隐私的重要性，并致力于为儿童提供一个安全的网络环境。' },
  { title: '2. 信息收集', content: '我们仅收集提供服务的必要信息。在收集14周岁以下儿童的个人信息前，我们将征得儿童监护人的明确同意。未经监护人同意，我们不会收集儿童的个人信息。' },
  { title: '3. 信息使用', content: '我们收集的儿童个人信息仅用于提供、维护和改进服务。我们不会将儿童的个人信息用于任何商业目的，也不会出售或分享给第三方，除非法律法规要求或获得监护人明确同意。' },
  { title: '4. 监护人权利', content: '监护人有权随时查阅、更正、删除我们持有的儿童个人信息；有权撤回之前的同意；有权要求我们停止收集和使用儿童的个人信息。如需行使上述权利，请通过本页底部联系方式联系我们。' },
  { title: '5. 联系我们', content: '如果您对本儿童隐私保护声明有任何疑问、意见或建议，或者需要行使监护人权利，请通过本页提供的联系方式与我们取得联系。我们将在15个工作日内回复您的请求。' },
]

// 目录项（从 sections 自动生成）
const toc: TocItem[] = sections.map((s, i) => ({
  id: `section-${i}`,
  title: s.title,
  level: 2,
}))

// 加载文档（模拟 API 调用匹配 V0 接口结构）
async function loadDocument() {
  loading.value = true
  try {
    // 模拟 API 调用: getLegalDocument('child-privacy')
    await new Promise(resolve => setTimeout(resolve, 500))
    document.value = {
      version: '1.0',
      effectiveDate: '2024-01-01',
      content: '',
      isConfirmed: false,
    }
    // 设置初始 activeSection
    if (toc.length > 0) {
      activeSection.value = toc[0].id
    }
  } catch (error) {
    console.error('加载文档失败:', error)
  } finally {
    loading.value = false
  }
}

// 滚动处理 —— 检测当前可见章节 + 是否滚动到底部
function handleScroll(e: any) {
  const scrollView = e.target
  if (!scrollView) return

  const scrollTop = scrollView.scrollTop
  const scrollHeight = scrollView.scrollHeight
  const clientHeight = scrollView.clientHeight

  // 检查是否滚动到底部（V0 用 100px 阈值）
  if (scrollHeight - scrollTop - clientHeight < 100) {
    scrolledToBottom.value = true
  }

  // 查找当前可见章节（从后往前找，找到第一个 offsetTop <= scrollTop + 偏移的）
  // UniApp scroll-view 内只能通过 querySelector 或 selectAllComponents 查找
  // 这里使用简化方式：根据滚动位置估算当前章节
  const query = uni.createSelectorQuery()
  query.selectAll('.section-anchor').fields({ rect: true, id: true }).exec((res: any) => {
    if (!res || !res[0]) return
    const sections = res[0]
    // 从后往前遍历，找到第一个顶部位置 <= scrollTop + 100 的
    for (let i = sections.length - 1; i >= 0; i--) {
      const section = sections[i]
      if (section.top <= scrollTop + 100) {
        activeSection.value = section.id
        break
      }
    }
  })
}

// 滚动到指定章节
function scrollToSection(id: string, idx: number) {
  // 使用 uni.pageScrollTo 或 scroll-view 的 scroll-into-view
  // 此处用 scroll-into-view 方式
  showMobileToc.value = false
  activeSection.value = id
  // 通过 scroll-view 的 scroll-into-view 属性实现
  // 但 UniApp 不支持动态 scroll-into-view，改用 createSelectorQuery
  uni.createSelectorQuery().select('#' + id).boundingClientRect((rect: any) => {
    if (rect) {
      uni.pageScrollTo({
        scrollTop: rect.top,
        duration: 300,
      })
    }
  }).exec()
}

// 确认阅读
async function handleConfirm() {
  confirming.value = true
  try {
    // 模拟 API 调用: confirmLegalDocument('child-privacy')
    await new Promise(resolve => setTimeout(resolve, 500))
    confirmed.value = true
    confirmedDate.value = new Date().toLocaleDateString('zh-CN')
  } catch (error) {
    console.error('确认失败:', error)
  } finally {
    confirming.value = false
  }
}

function contactEmail() {
  uni.showToast({ title: 'privacy@rebu.com', icon: 'none' })
}

function contactPhone() {
  uni.showToast({ title: '400-888-8888', icon: 'none' })
}

function goBack() {
  uni.navigateBack()
}

onMounted(() => {
  loadDocument()
})
</script>

<style scoped>
.skeleton-bg {
  background: linear-gradient(90deg, #f0ece6 25%, #e8e0d5 50%, #f0ece6 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
</style>
