<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-50 bg-[#FAF8F5]/95 border-b border-[#E8E0D5]" style="backdrop-filter:blur(12px)">
      <view class="flex items-center justify-between h-14 px-4 max-w-lg mx-auto">
        <view class="p-1 -ml-1" @click="goBack">
          <text class="text-xl text-[#2C2C2C]">←</text>
        </view>
        <text class="font-semibold text-base text-[#2C2C2C]">{{ isSuccess ? '支付成功' : '支付失败' }}</text>
        <view class="w-9" />
      </view>
    </view>

    <view class="pb-8">
      <!-- 加载状态 -->
      <view v-if="loading" class="flex items-center justify-center py-32">
        <view class="text-center">
          <view class="w-10 h-10 mx-auto mb-3 border-4 border-[#E8E0D5] border-t-[#C41E3A] rounded-full animate-spin" />
          <text class="text-sm text-[#999]">加载中...</text>
        </view>
      </view>

      <!-- 结果状态区 -->
      <view :class="['flex flex-col items-center py-10 px-6 transition-all duration-500', showContent ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-4']">
        <!-- 状态图标 -->
        <view :class="['w-20 h-20 rounded-full flex items-center justify-center mb-4', isSuccess ? 'bg-green-50' : 'bg-red-50']">
          <text :class="['text-5xl', isSuccess ? 'text-green-500' : 'text-red-500']">{{ isSuccess ? '✓' : '✕' }}</text>
        </view>
        <!-- 状态标题 -->
        <text :class="['text-xl font-bold mb-2', isSuccess ? 'text-green-500' : 'text-red-500']">{{ isSuccess ? '支付成功' : '支付失败' }}</text>
        <!-- 订单信息/失败原因 -->
        <view v-if="isSuccess" class="text-center">
          <text class="text-2xl font-bold text-[#2C2C2C] block">¥{{ amount }}</text>
          <text class="text-sm text-[#999] block mt-1">订单号：{{ orderId }}</text>
        </view>
        <view v-else class="text-center">
          <text class="text-sm text-[#999] block">{{ reason }}</text>
          <text class="text-xs text-[#999] block mt-1">订单号：{{ orderId }}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view :class="['px-4 flex gap-3 transition-all duration-500 delay-150', showContent ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-4']">
        <template v-if="isSuccess">
          <view class="flex-1 py-3 bg-[#C41E3A] text-white text-center font-medium rounded-xl" @click="goOrderDetail">
            <text>查看订单</text>
          </view>
          <view class="flex-1 py-3 bg-[#F2EFEA] text-[#2C2C2C] text-center font-medium rounded-xl" @click="goHome">
            <text>继续逛逛</text>
          </view>
        </template>
        <template v-else>
          <view class="flex-1 py-3 bg-[#C41E3A] text-white text-center font-medium rounded-xl" @click="goRetryPay">
            <text>重新支付</text>
          </view>
          <view class="flex-1 py-3 bg-[#F2EFEA] text-[#2C2C2C] text-center font-medium rounded-xl" @click="goChangePayment">
            <text>更换支付方式</text>
          </view>
        </template>
      </view>

      <!-- 订单详情卡片（成功时显示） -->
      <view v-if="isSuccess" :class="['px-4 mt-6 transition-all duration-500 delay-200', showContent ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-4']">
        <view class="bg-white rounded-xl p-4">
          <view class="flex items-center justify-between">
            <view class="flex items-center gap-3">
              <view class="w-12 h-12 rounded-lg bg-[#F2EFEA] flex items-center justify-center">
                <text class="text-2xl">🛍️</text>
              </view>
              <view>
                <text class="font-medium text-sm text-[#2C2C2C] block">订单已提交</text>
                <text class="text-xs text-[#999] block mt-0.5">预计3-5个工作日内发货</text>
              </view>
            </view>
            <view class="text-[#C41E3A] text-sm flex items-center gap-1" @click="goOrderDetail">
              <text>详情</text>
              <text>›</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 推荐区 -->
      <view :class="['px-4 mt-8 transition-all duration-500 delay-300', showContent ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-4']">
        <view class="flex items-center justify-between mb-4">
          <text class="font-semibold text-base text-[#2C2C2C]">{{ isSuccess ? '购买了此商品的人也买了' : '热门内容推荐' }}</text>
          <view class="text-[#C41E3A] text-sm flex items-center gap-1" @click="goDiscover">
            <text>更多</text>
            <text>›</text>
          </view>
        </view>

        <!-- 推荐商品列表 -->
        <view class="grid grid-cols-2 gap-3">
          <view v-for="item in recommendations" :key="item.id" class="bg-white rounded-xl overflow-hidden" @click="goRecommend(item)">
            <view class="aspect-[4/3] bg-[#F2EFEA] flex items-center justify-center relative">
              <text class="text-3xl text-[#999]/50">{{ item.type === 'course' ? '📚' : '🛍️' }}</text>
              <view :class="['absolute top-2 left-2 text-[10px] px-1.5 py-0.5 rounded text-white', item.type === 'course' ? 'bg-[#C41E3A]' : 'bg-[#C9A96E]']">
                <text>{{ item.type === 'course' ? '课程' : '商品' }}</text>
              </view>
            </view>
            <view class="p-2.5">
              <text class="font-medium text-sm text-[#2C2C2C] block line-clamp-1">{{ item.title }}</text>
              <view class="flex items-baseline gap-1.5 mt-1">
                <text class="text-[#C41E3A] font-bold text-sm">¥{{ item.price }}</text>
                <text class="text-xs text-[#999] line-through">¥{{ item.originalPrice }}</text>
              </view>
              <text class="text-xs text-[#999] block mt-0.5">{{ item.sales }}人已购</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 底部提示 -->
      <view class="px-4 mt-8 text-center">
        <text class="text-xs text-[#999]">如有疑问请联系客服：400-888-8888</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'

const recommendations = [
  { id: 1, type: 'course', title: '六爻预测实战班', price: 299, originalPrice: 599, sales: 1280 },
  { id: 2, type: 'product', title: '开光貔貅手链', price: 168, originalPrice: 268, sales: 856 },
  { id: 3, type: 'course', title: '风水布局入门', price: 99, originalPrice: 199, sales: 2100 },
  { id: 4, type: 'product', title: '紫檀木手串', price: 388, originalPrice: 588, sales: 432 },
]

const loading = ref(true)
const showContent = ref(false)
const isSuccess = ref(true)
const orderId = ref('RB20240315001234')
const amount = ref('299.00')
const reason = ref('余额不足')

onMounted(() => {
  const pages = getCurrentPages()
  const currentPage = pages[pages.length - 1] as any
  const options = currentPage?.$page?.options || currentPage?.options || {}
  isSuccess.value = (options.status || 'success') === 'success'
  orderId.value = options.orderId || 'RB20240315001234'
  amount.value = options.amount || '299.00'
  reason.value = options.reason || '余额不足'

  loading.value = false
  setTimeout(() => { showContent.value = true }, 300)
})

function goBack() { uni.navigateBack() }
function goHome() { uni.reLaunch({ url: '/pages/index/index' }) }
function goOrderDetail() { uni.navigateTo({ url: '/pages/orders/detail/index?orderId=' + orderId.value }) }
function goRetryPay() { uni.navigateTo({ url: '/pages/checkout/index?orderId=' + orderId.value }) }
function goChangePayment() { uni.navigateTo({ url: '/pages/checkout/index?changePayment=true&orderId=' + orderId.value }) }
function goDiscover() { uni.switchTab({ url: '/pages/index/index' }) }
function goRecommend(item: any) {
  const base = item.type === 'course' ? '/pages/course/detail/index' : '/pages/mall/product/detail/index'
  uni.navigateTo({ url: base + '?id=' + item.id })
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
