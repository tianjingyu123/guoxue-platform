<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- 导航栏 -->
    <view class="flex items-center justify-between px-4 h-12 bg-white border-b border-[#E8E0D5] shrink-0">
      <view class="p-1" @click="goBack">
        <text class="text-xl text-[#2C2C2C]">←</text>
      </view>
      <text class="text-base font-semibold text-[#2C2C2C]">确认支付</text>
      <view class="w-7" />
    </view>

    <!-- 倒计时 -->
    <view class="bg-[#C41E3A]/5 px-4 py-2 flex items-center justify-center gap-1">
      <text class="text-[11px] text-[#C41E3A]">⏱ 请在</text>
      <text class="text-[11px] text-[#C41E3A] font-semibold">{{ countdownText }}</text>
      <text class="text-[11px] text-[#C41E3A]">内完成支付，超时自动取消</text>
    </view>

    <!-- 骨架屏 -->
    <view v-if="loading" class="flex-1 p-4">
      <view class="h-24 bg-white rounded-xl mb-3 skeleton-pulse" />
      <view class="h-44 bg-white rounded-xl mb-3 skeleton-pulse" />
      <view class="h-12 bg-white rounded-xl mb-3 skeleton-pulse" />
      <view class="h-11 bg-[#C41E3A]/30 rounded-xl skeleton-pulse" />
    </view>

    <!-- 主内容 -->
    <scroll-view v-else scroll-y class="flex-1 overflow-y-auto p-4">
      <!-- 订单信息 -->
      <view class="bg-white rounded-xl p-4 mb-3 shadow-sm">
        <text class="text-sm font-semibold text-[#2C2C2C] block mb-3">订单信息</text>
        <view class="flex justify-between items-start mb-2">
          <text class="text-xs text-[#999]">商品</text>
          <text class="text-sm text-[#2C2C2C] text-right max-w-[220px]">{{ order.productName }}</text>
        </view>
        <view class="flex justify-between items-center mb-2">
          <text class="text-xs text-[#999]">订单编号</text>
          <text class="text-xs text-[#999]">{{ order.orderNo }}</text>
        </view>
        <view class="flex justify-between items-center">
          <text class="text-xs text-[#999]">下单时间</text>
          <text class="text-xs text-[#999]">{{ order.time }}</text>
        </view>
        <view class="border-t border-[#F5F1EB] mt-3 pt-3 flex justify-between items-center">
          <text class="text-xs text-[#999]">需支付</text>
          <text class="text-2xl font-bold text-[#C41E3A]">¥{{ order.amount }}</text>
        </view>
      </view>

      <!-- 优惠券 -->
      <view class="bg-white rounded-xl px-4 py-3.5 mb-3 shadow-sm flex items-center justify-between" @click="onCoupon">
        <view class="flex items-center gap-2">
          <text class="text-lg">🏷️</text>
          <view>
            <text class="text-sm text-[#2C2C2C]">优惠券</text>
            <text class="text-xs text-[#999] block" v-if="selectedCoupon">已选：{{ selectedCoupon }}</text>
            <text class="text-xs text-[#999] block" v-else>暂未选择</text>
          </view>
        </view>
        <text class="text-sm text-[#C9A96E] font-medium">{{ selectedCoupon ? '更换 ›' : '选择 ›' }}</text>
      </view>

      <!-- 支付方式 -->
      <view class="bg-white rounded-xl p-4 mb-3 shadow-sm">
        <text class="text-sm font-semibold text-[#2C2C2C] block mb-2">选择支付方式</text>
        <view v-for="p in methods" :key="p.key" class="flex items-center gap-3 py-3 border-b border-[#FAF8F5] last:border-b-0" @click="selectedMethod = p.key">
          <text class="text-2xl">{{ p.icon }}</text>
          <view class="flex-1">
            <text class="text-sm text-[#2C2C2C]">{{ p.name }}</text>
            <text v-if="p.desc" class="text-[11px] text-[#999] block">{{ p.desc }}</text>
          </view>
          <view class="w-5 h-5 rounded-full border-2 flex items-center justify-center"
            :class="selectedMethod === p.key ? 'border-[#C41E3A] bg-[#C41E3A]' : 'border-[#D1CEC6]'">
            <text v-if="selectedMethod === p.key" class="text-white text-xs">✓</text>
          </view>
        </view>
      </view>

      <!-- 安全提示 -->
      <view class="flex items-center justify-center gap-1 mb-4">
        <text class="text-[11px] text-[#bbb]">🔒 支付由 SSL 加密保护</text>
      </view>

      <!-- 支付按钮 -->
      <view class="py-3.5 bg-[#C41E3A] text-white rounded-xl text-center text-sm font-semibold shadow-md active:opacity-80" @click="doPay">
        确认支付 ¥{{ order.amount }}
      </view>

      <view class="h-6" />
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
import { ref, onUnmounted } from 'vue'

const loading = ref(true)
const selectedMethod = ref('wechat')
const selectedCoupon = ref('')
const countdown = ref(900) // 15 minutes

interface Order {
  orderNo: string
  productName: string
  amount: number
  time: string
}

const order = ref<Order>({
  orderNo: 'DD2024061012345678',
  productName: '《渊海子平》精装典藏版 + 八字排盘年会员',
  amount: 168,
  time: '2024-06-10 10:30:00',
})

const methods = [
  { key: 'wechat', name: '微信支付', icon: '💚', desc: '推荐使用微信支付' },
  { key: 'alipay', name: '支付宝', icon: '💙', desc: '支持花呗分期' },
  { key: 'balance', name: '国学币余额', icon: '🪙', desc: '可用余额 ¥888.88' },
  { key: 'card', name: '银行卡支付', icon: '💳', desc: '支持储蓄卡/信用卡' },
]

const countdownText = ref('15:00')

let timer: ReturnType<typeof setInterval> | null = null

function startCountdown() {
  timer = setInterval(() => {
    countdown.value--
    if (countdown.value <= 0) {
      clearInterval(timer!)
      timer = null
      uni.showToast({ title: '支付超时已取消', icon: 'none' })
      setTimeout(() => uni.navigateBack(), 1500)
      return
    }
    const min = Math.floor(countdown.value / 60)
    const sec = countdown.value % 60
    countdownText.value = `${String(min).padStart(2, '0')}:${String(sec).padStart(2, '0')}`
  }, 1000)
}

function onCoupon() {
  uni.showActionSheet({
    itemList: ['满100减10元', '满200减30元', '新人专享减20元', '不使用优惠券'],
    success: (res) => {
      const coupons = ['满100减10元', '满200减30元', '新人专享减20元', '']
      selectedCoupon.value = coupons[res.tapIndex]
    }
  })
}

function doPay() {
  uni.showLoading({ title: '支付处理中...' })
  setTimeout(() => {
    uni.hideLoading()
    if (timer) {
      clearInterval(timer)
      timer = null
    }
    uni.showToast({ title: '支付成功', icon: 'success' })
    setTimeout(() => uni.navigateBack(), 1000)
  }, 2000)
}

function goBack() {
  if (timer) {
    clearInterval(timer)
    timer = null
  }
  uni.navigateBack()
}

setTimeout(() => {
  loading.value = false
  startCountdown()
}, 1000)

onUnmounted(() => {
  if (timer) {
    clearInterval(timer)
    timer = null
  }
})
</script>

<style scoped>
.skeleton-pulse {
  animation: pulse 1.5s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.8; }
}
/* 样式由 Tailwind 处理 */
</style>
