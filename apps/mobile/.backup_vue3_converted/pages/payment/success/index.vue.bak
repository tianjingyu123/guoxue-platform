<script setup lang="ts">
import { ref, onMounted } from 'vue'

const orderData = {
  productName: '八字命理学入门到精通',
  productType: 'course',
  amount: 199,
  payTime: '2024-01-10 15:30:28',
}

const recommendProducts = [
  { id: '2', name: '紫微斗数命盘解读', price: 299, originalPrice: 599 },
  { id: '3', name: '风水堪舆入门精讲', price: 168, originalPrice: 299 },
  { id: '4', name: '六爻预测实战教程', price: 128, originalPrice: 258 },
  { id: '5', name: '奇门遁甲入门课程', price: 199, originalPrice: 399 },
]

const orderId = ref('2024011012345678')

onMounted(() => {
  const pages = getCurrentPages()
  const currentPage = pages[pages.length - 1] as any
  const options = currentPage?.$page?.options || currentPage?.options || {}
  orderId.value = options.orderId || '2024011012345678'
})

function goOrders() { uni.navigateTo({ url: '/pages/orders/index' }) }
function goLearn() {
  if (orderData.productType === 'course') {
    uni.navigateTo({ url: '/pages/learn/detail/index?id=' + orderId.value })
  } else {
    uni.reLaunch({ url: '/pages/index/index' })
  }
}
function goCoupons() { uni.navigateTo({ url: '/pages/coupons/index' }) }
function goHome() { uni.reLaunch({ url: '/pages/index/index' }) }
function goProduct(p: any) { uni.navigateTo({ url: '/pages/course/detail/index?id=' + p.id }) }
</script>

