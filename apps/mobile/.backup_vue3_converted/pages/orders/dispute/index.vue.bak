<template>
  <view v-if="loading" class="min-h-screen bg-[#FAF8F5]">
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5] px-4 py-3 flex items-center gap-3">
      <view class="w-6 h-6 bg-gray-200 rounded animate-pulse" />
      <view class="w-24 h-5 bg-gray-200 rounded animate-pulse" />
    </view>
    <view class="p-4 space-y-4">
      <view v-for="i in 3" :key="i" class="bg-white rounded-2xl p-4 animate-pulse">
        <view class="h-24 bg-gray-200 rounded" />
      </view>
    </view>
  </view>

  <!-- 详情视图 -->
  <view v-else-if="activeTab === 'detail' && detail" class="min-h-screen bg-[#FAF8F5] pb-24">
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5] px-4 py-3 flex items-center gap-3">
      <view @click="goBack" class="p-1 -ml-1">
        <text class="text-2xl text-[#2C2C2C]">←</text>
      </view>
      <text class="text-lg font-semibold text-[#2C2C2C]">申诉详情</text>
    </view>

    <!-- 状态卡片 -->
    <view :class="['mx-4 mt-4 p-4 rounded-2xl', detail.status === 'resolved' ? 'bg-gradient-to-r from-green-500 to-green-600' : detail.status === 'rejected' ? 'bg-gradient-to-r from-red-500 to-red-600' : 'bg-gradient-to-r from-blue-500 to-blue-600']">
      <view class="flex items-center gap-3">
        <view class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center">
          <text class="text-2xl text-white">{{ getStatusIcon(detail.status) }}</text>
        </view>
        <view>
          <text class="text-white font-semibold text-lg">{{ getStatusInfo(detail.status).label }}</text>
          <text class="text-white/80 text-sm">{{ getTypeLabel(detail.type) }}</text>
        </view>
      </view>
    </view>

    <!-- 订单信息 -->
    <view class="mx-4 mt-4 bg-white rounded-2xl p-4">
      <text class="text-sm text-[#999999] mb-3 block">关联订单</text>
      <view class="flex gap-3">
        <image :src="detail.order.productCover" mode="aspectFill" class="w-16 h-16 rounded-lg bg-gray-100" />
        <view class="flex-1 min-w-0">
          <text class="text-[#2C2C2C] font-medium line-clamp-2">{{ detail.order.productName }}</text>
          <text class="text-sm text-[#999999] mt-1 block">订单号：{{ detail.orderNo }}</text>
          <text class="text-[#C41E3A] font-semibold mt-1 block">¥{{ detail.order.amount }}</text>
        </view>
      </view>
    </view>

    <!-- 申诉内容 -->
    <view class="mx-4 mt-4 bg-white rounded-2xl p-4">
      <text class="text-sm text-[#999999] mb-3 block">申诉内容</text>
      <text class="text-[#2C2C2C]">{{ detail.description }}</text>
      <scroll-view v-if="detail.images.length > 0" scroll-x class="flex gap-2 mt-3">
        <view class="flex gap-2">
          <image v-for="(img, i) in detail.images" :key="i" :src="img" mode="aspectFill" class="w-20 h-20 rounded-lg bg-gray-100 flex-shrink-0" />
        </view>
      </scroll-view>
      <view class="mt-3 pt-3 border-t border-[#E8E0D5]">
        <text class="text-sm text-[#999999] block">期望解决方案</text>
        <text class="text-[#2C2C2C] mt-1 block">{{ detail.expectation }}</text>
      </view>
    </view>

    <!-- 处理进度 -->
    <view class="mx-4 mt-4 bg-white rounded-2xl p-4">
      <text class="text-sm text-[#999999] mb-4 block">处理进度</text>
      <view class="space-y-4">
        <view v-for="(item, index) in detail.timeline" :key="index" class="flex gap-3">
          <view class="flex flex-col items-center">
            <view :class="['w-3 h-3 rounded-full', item.isCurrent ? 'bg-[#C41E3A]' : 'bg-gray-300']" />
            <view v-if="index < detail.timeline.length - 1" class="w-0.5 h-full bg-gray-200 mt-1" />
          </view>
          <view class="flex-1 pb-4">
            <text :class="['font-medium', item.isCurrent ? 'text-[#C41E3A]' : 'text-[#2C2C2C]']">{{ item.title }}</text>
            <text v-if="item.description" class="text-sm text-[#666666] mt-0.5 block">{{ item.description }}</text>
            <text class="text-xs text-[#999999] mt-1 block">{{ item.time }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部操作 -->
    <view class="fixed bottom-0 left-0 right-0 bg-white border-t border-[#E8E0D5] p-4">
      <view class="flex gap-3">
        <view @click="goTo('/pages/orders/id-detail/index?id=' + detail.orderId)" class="flex-1 py-3 rounded-full border border-[#E8E0D5] text-[#666666] text-center">查看订单</view>
        <view v-if="detail.canCancel" class="flex-1 py-3 rounded-full bg-[#C41E3A] text-white text-center">撤销申诉</view>
      </view>
    </view>
  </view>

  <!-- 列表视图 -->
  <view v-else-if="activeTab === 'list'" class="min-h-screen bg-[#FAF8F5]">
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5] px-4 py-3 flex items-center gap-3">
      <view @click="goBack" class="p-1 -ml-1">
        <text class="text-2xl text-[#2C2C2C]">←</text>
      </view>
      <text class="text-lg font-semibold text-[#2C2C2C]">我的申诉</text>
    </view>

    <view v-if="myDisputes.length === 0" class="flex flex-col items-center justify-center py-20">
      <view class="w-20 h-20 rounded-full bg-gray-100 flex items-center justify-center mb-4">
        <text class="text-3xl text-gray-300">💬</text>
      </view>
      <text class="text-[#999999]">暂无申诉记录</text>
    </view>
    <view v-else class="p-4 space-y-3">
      <view v-for="item in myDisputes" :key="item.id" @click="goTo('/pages/orders/dispute/index?id=' + item.id)" class="w-full bg-white rounded-2xl p-4">
        <view class="flex items-center justify-between mb-3">
          <text :class="['px-2 py-0.5 rounded text-xs', getStatusInfo(item.status).color]">{{ getStatusInfo(item.status).label }}</text>
          <text class="text-xs text-[#999999]">{{ item.createdAt.split(' ')[0] }}</text>
        </view>
        <view class="flex gap-3">
          <image :src="item.productCover" mode="aspectFill" class="w-14 h-14 rounded-lg bg-gray-100" />
          <view class="flex-1 min-w-0">
            <text class="text-[#2C2C2C] font-medium line-clamp-1 block">{{ item.productName }}</text>
            <text class="text-sm text-[#666666] mt-1 block">{{ getTypeLabel(item.type) }}</text>
            <text class="text-xs text-[#999999] mt-1 block">订单号：{{ item.orderNo }}</text>
          </view>
          <text class="text-lg text-[#999999] flex-shrink-0 self-center">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 申请视图 -->
  <view v-else class="min-h-screen bg-[#FAF8F5] pb-24">
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5] px-4 py-3 flex items-center gap-3">
      <view @click="goBack" class="p-1 -ml-1">
        <text class="text-2xl text-[#2C2C2C]">←</text>
      </view>
      <text class="text-lg font-semibold text-[#2C2C2C]">提交申诉</text>
    </view>

    <!-- 订单信息 -->
    <view class="mx-4 mt-4 bg-white rounded-2xl p-4">
      <text class="text-sm text-[#999999] mb-3 block">申诉订单</text>
      <view class="flex gap-3">
        <image :src="mockOrder.productCover" mode="aspectFill" class="w-16 h-16 rounded-lg bg-gray-100" />
        <view class="flex-1 min-w-0">
          <text class="text-[#2C2C2C] font-medium line-clamp-2">{{ mockOrder.productName }}</text>
          <text class="text-sm text-[#999999] mt-1 block">订单号：{{ mockOrder.orderNo }}</text>
          <text class="text-[#C41E3A] font-semibold mt-1 block">¥{{ mockOrder.amount }}</text>
        </view>
      </view>
    </view>

    <!-- 纠纷类型 -->
    <view class="mx-4 mt-4 bg-white rounded-2xl p-4">
      <text class="text-sm text-[#999999] mb-3 block">
        纠纷类型 <text class="text-[#C41E3A]">*</text>
      </text>
      <view class="grid grid-cols-2 gap-3">
        <view
          v-for="type in disputeTypes" :key="type.value"
          @click="selectType(type.value)"
          :class="['p-3 rounded-xl border-2 transition-all', selectedType === type.value ? 'border-[#C41E3A] bg-red-50' : 'border-[#E8E0D5]']"
        >
          <text :class="['text-xl mb-2 block', selectedType === type.value ? 'text-[#C41E3A]' : 'text-[#999999]']">{{ type.icon }}</text>
          <text :class="['font-medium block', selectedType === type.value ? 'text-[#C41E3A]' : 'text-[#2C2C2C]']">{{ type.label }}</text>
          <text class="text-xs text-[#999999] mt-0.5 block">{{ type.desc }}</text>
        </view>
      </view>
      <text v-if="errors.type" class="text-sm text-[#C41E3A] mt-2 block">{{ errors.type }}</text>
    </view>

    <!-- 问题描述 -->
    <view class="mx-4 mt-4 bg-white rounded-2xl p-4">
      <text class="text-sm text-[#999999] mb-3 block">
        问题描述 <text class="text-[#C41E3A]">*</text>
      </text>
      <textarea
        v-model="description"
        placeholder="请详细描述您遇到的问题，以便我们更好地帮助您解决..."
        :class="['w-full h-32 p-3 rounded-xl border bg-[#FAF8F5] resize-none text-[#2C2C2C] placeholder:text-[#999999]', errors.description ? 'border-[#C41E3A]' : 'border-[#E8E0D5]']"
      />
      <view class="flex justify-between mt-2">
        <text v-if="errors.description" class="text-sm text-[#C41E3A]">{{ errors.description }}</text>
        <text class="text-xs text-[#999999] ml-auto">{{ description.length }}/500</text>
      </view>
    </view>

    <!-- 证据上传 -->
    <view class="mx-4 mt-4 bg-white rounded-2xl p-4">
      <text class="text-sm text-[#999999] mb-3 block">
        证据图片 <text class="text-[#C41E3A]">*</text>
        <text class="text-xs ml-2">（聊天记录、商品照片等）</text>
      </text>
      <view class="flex gap-2 flex-wrap">
        <view v-for="(img, index) in images" :key="index" class="relative w-20 h-20">
          <image :src="img" mode="aspectFill" class="w-full h-full rounded-lg bg-gray-100" />
          <view @click="removeImage(index)" class="absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-[#C41E3A] text-white flex items-center justify-center">
            <text class="text-xs">✕</text>
          </view>
        </view>
        <view v-if="images.length < 5" @click="handleImageUpload" :class="['w-20 h-20 rounded-lg border-2 border-dashed flex flex-col items-center justify-center gap-1', errors.images ? 'border-[#C41E3A]' : 'border-[#E8E0D5]']">
          <text class="text-lg text-[#999999]">📷</text>
          <text class="text-xs text-[#999999]">{{ images.length }}/5</text>
        </view>
      </view>
      <text v-if="errors.images" class="text-sm text-[#C41E3A] mt-2 block">{{ errors.images }}</text>
    </view>

    <!-- 期望解决方案 -->
    <view class="mx-4 mt-4 bg-white rounded-2xl p-4">
      <text class="text-sm text-[#999999] mb-3 block">
        期望解决方案 <text class="text-[#C41E3A]">*</text>
      </text>
      <textarea
        v-model="expectation"
        placeholder="请告诉我们您希望如何解决这个问题..."
        :class="['w-full h-20 p-3 rounded-xl border bg-[#FAF8F5] resize-none text-[#2C2C2C] placeholder:text-[#999999]', errors.expectation ? 'border-[#C41E3A]' : 'border-[#E8E0D5]']"
      />
      <text v-if="errors.expectation" class="text-sm text-[#C41E3A] mt-2 block">{{ errors.expectation }}</text>
    </view>

    <!-- 温馨提示 -->
    <view class="mx-4 mt-4 bg-orange-50 rounded-2xl p-4">
      <view class="flex items-start gap-2">
        <text class="text-base text-orange-500 flex-shrink-0 mt-0.5">⚠️</text>
        <view class="text-sm text-orange-700">
          <text class="font-medium mb-1 block">温馨提示</text>
          <view class="space-y-1 text-xs">
            <text class="block">1. 请如实填写申诉信息，提供有效证据</text>
            <text class="block">2. 我们将在1-3个工作日内处理您的申诉</text>
            <text class="block">3. 处理结果将通过站内消息通知您</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部提交 -->
    <view class="fixed bottom-0 left-0 right-0 bg-white border-t border-[#E8E0D5] p-4">
      <view
        @click="handleSubmit"
        :class="['w-full py-3.5 rounded-full bg-[#C41E3A] text-white font-medium text-center', submitting ? 'opacity-50' : '']"
      >
        {{ submitting ? '提交中...' : '提交申诉' }}
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'

interface TimelineNode {
  status: string
  title: string
  description: string
  time: string
  isCurrent: boolean
}

interface DisputeDetail {
  id: string
  orderId: string
  orderNo: string
  type: string
  status: string
  description: string
  images: string[]
  expectation: string
  order: { productCover: string; productName: string; amount: number }
  timeline: TimelineNode[]
  createdAt: string
  canCancel: boolean
}

interface DisputeListItem {
  id: string
  orderId: string
  orderNo: string
  type: string
  status: string
  productName: string
  productCover: string
  createdAt: string
}

const disputeTypes = [
  { value: 'not_received', label: '未收到货', icon: '📦', desc: '已付款但未收到商品' },
  { value: 'not_as_described', label: '商品不符', icon: '📄', desc: '收到的商品与描述不符' },
  { value: 'quality_issue', label: '质量问题', icon: '⚠️', desc: '商品存在质量缺陷' },
  { value: 'other', label: '其他问题', icon: '❓', desc: '其他交易纠纷' },
]

const mockOrder = {
  orderId: 'order_001',
  orderNo: 'RB2024010100001',
  productName: '周易六十四卦详解（精装典藏版）',
  productCover: '/placeholder.svg',
  amount: 168,
  createdAt: '2024-01-01 12:00:00',
}

const mockMyDisputes: DisputeListItem[] = [
  { id: '1', orderId: 'o1', orderNo: 'RB2024010100002', type: 'quality_issue', status: 'processing', productName: '紫微斗数入门', productCover: '/placeholder.svg', createdAt: '2024-01-05 10:00:00' },
]

const loading = ref(true)
const activeTab = ref<'apply' | 'list' | 'detail'>('list')
const selectedType = ref('')
const description = ref('')
const expectation = ref('')
const images = ref<string[]>([])
const submitting = ref(false)
const errors = ref<Record<string, string>>({})
const myDisputes = ref<DisputeListItem[]>([])
const detail = ref<DisputeDetail | null>(null)

onMounted(() => {
  // 获取页面参数
  const pages = getCurrentPages()
  const currentPage = pages[pages.length - 1] as any
  const orderId = currentPage?.$page?.options?.orderId
  const disputeId = currentPage?.$page?.options?.id

  if (disputeId) {
    loadDetail(disputeId)
  } else if (orderId) {
    activeTab.value = 'apply'
    loading.value = false
  } else {
    loadMyDisputes()
  }
})

function loadDetail(disputeId: string) {
  loading.value = true
  setTimeout(() => {
    detail.value = {
      id: disputeId,
      orderId: 'o1',
      orderNo: 'RB2024010100001',
      type: 'quality_issue',
      status: 'processing',
      description: '收到的书籍有破损，封面有明显折痕',
      images: ['/placeholder.svg'],
      expectation: '希望能够换货或退款',
      order: mockOrder,
      timeline: [
        { status: 'submitted', title: '提交申诉', description: '您已成功提交申诉', time: '2024-01-05 10:00', isCurrent: false },
        { status: 'processing', title: '处理中', description: '客服正在处理您的申诉', time: '2024-01-05 14:00', isCurrent: true },
      ],
      createdAt: '2024-01-05 10:00:00',
      canCancel: true,
    }
    activeTab.value = 'detail'
    loading.value = false
  }, 300)
}

function loadMyDisputes() {
  loading.value = true
  setTimeout(() => {
    myDisputes.value = mockMyDisputes
    loading.value = false
  }, 300)
}

function selectType(value: string) {
  selectedType.value = value
  errors.value = { ...errors.value, type: '' }
}

function handleImageUpload() {
  if (images.value.length >= 5) return
  uni.chooseImage({
    count: 5 - images.value.length,
    success: (res) => {
      const tempPaths = res.tempFilePaths
      images.value = [...images.value, ...tempPaths]
    }
  })
}

function removeImage(index: number) {
  images.value = images.value.filter((_, i) => i !== index)
}

function validate(): boolean {
  const newErrors: Record<string, string> = {}
  if (!selectedType.value) newErrors.type = '请选择纠纷类型'
  if (!description.value.trim()) newErrors.description = '请描述问题详情'
  else if (description.value.length < 10) newErrors.description = '问题描述至少10个字'
  if (!expectation.value.trim()) newErrors.expectation = '请填写期望的解决方案'
  if (images.value.length === 0) newErrors.images = '请上传至少一张证据图片'
  errors.value = newErrors
  return Object.keys(newErrors).length === 0
}

function handleSubmit() {
  if (!validate()) return
  submitting.value = true
  setTimeout(() => {
    submitting.value = false
    uni.showToast({ title: '提交成功', icon: 'success' })
    setTimeout(() => {
      goTo('/pages/orders/dispute/index?id=new_dispute')
    }, 500)
  }, 1000)
}

function getStatusInfo(status: string) {
  const map: Record<string, { label: string; color: string; icon: string }> = {
    pending: { label: '待处理', color: 'text-orange-500 bg-orange-50', icon: '🕐' },
    processing: { label: '处理中', color: 'text-blue-500 bg-blue-50', icon: '🕐' },
    resolved: { label: '已解决', color: 'text-green-500 bg-green-50', icon: '✓' },
    rejected: { label: '已驳回', color: 'text-red-500 bg-red-50', icon: '✕' },
    cancelled: { label: '已取消', color: 'text-gray-500 bg-gray-100', icon: '✕' },
  }
  return map[status] || map.pending
}

function getStatusIcon(status: string): string {
  return getStatusInfo(status).icon
}

function getTypeLabel(type: string): string {
  return disputeTypes.find(t => t.value === type)?.label || type
}

function goBack() {
  uni.navigateBack()
}

function goTo(url: string) {
  uni.navigateTo({ url })
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
