<template>
  <view v-if="loading" class="min-h-screen bg-[#FAF8F5]">
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5] px-4 py-3 h-14" />
    <view class="p-4 space-y-4">
      <view v-for="i in 3" :key="i" class="bg-white rounded-2xl h-32 animate-pulse" />
    </view>
  </view>

  <view v-else-if="!refund" class="min-h-screen bg-[#FAF8F5]" />

  <view v-else class="min-h-screen bg-[#FAF8F5] pb-24">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5] px-4 py-3 flex items-center gap-3">
      <view @click="goBack" class="p-1 -ml-1">
        <text class="text-2xl text-[#2C2C2C]">←</text>
      </view>
      <text class="text-lg font-semibold text-[#2C2C2C]">退款进度</text>
    </view>

    <!-- 退款金额卡片 -->
    <view class="m-4 bg-gradient-to-br from-green-500 to-green-600 rounded-2xl p-6 text-white">
      <view class="flex items-center gap-2 mb-2">
        <text class="text-lg">👛</text>
        <text class="text-sm opacity-90">退款金额</text>
      </view>
      <text class="text-4xl font-bold mb-3 block">¥{{ refund.amount.toFixed(2) }}</text>
      <view class="flex items-center gap-2 text-sm opacity-90">
        <text>退款方式：原路退回至{{ refundMethod }}</text>
      </view>
      <view v-if="refund.status === 'refunding'" class="mt-3 bg-white/20 rounded-lg px-3 py-2 text-sm">
        <text class="inline mr-1">🕐</text>
        预计 {{ estimatedDate }} 前到账
      </view>
      <view v-if="refund.status === 'completed'" class="mt-3 bg-white/20 rounded-lg px-3 py-2 text-sm">
        <text class="inline mr-1">✓</text>
        退款已到账
      </view>
    </view>

    <!-- 进度时间轴 -->
    <view class="mx-4 bg-white rounded-2xl p-4 shadow-sm">
      <text class="font-semibold text-[#2C2C2C] mb-4 block">退款进度</text>
      <view class="relative">
        <view v-for="(node, index) in refund.timeline" :key="index" class="relative pl-8 pb-6 last:pb-0">
          <!-- 连接线 -->
          <view v-if="index < refund.timeline.length - 1" :class="['absolute left-[11px] top-6 w-0.5 h-full', getNodeStatus(index) === 'completed' ? 'bg-green-500' : 'bg-gray-200']" />

          <!-- 节点图标 -->
          <view :class="['absolute left-0 top-0 w-6 h-6 rounded-full flex items-center justify-center', getNodeStatus(index) === 'completed' ? 'bg-green-500 text-white' : getNodeStatus(index) === 'refunding' ? 'bg-orange-500 text-white' : 'bg-gray-200 text-gray-400']">
            <text v-if="getNodeStatus(index) === 'completed'" class="text-sm">✓</text>
            <text v-else-if="getNodeStatus(index) === 'refunding'" class="text-sm">🕐</text>
            <view v-else class="w-2 h-2 bg-gray-400 rounded-full" />
          </view>

          <!-- 内容 -->
          <view @click="toggleNode(index)" class="w-full">
            <view class="flex items-center justify-between">
              <text :class="['font-medium', getNodeStatus(index) === 'completed' || getNodeStatus(index) === 'refunding' ? 'text-[#2C2C2C]' : 'text-gray-400']">{{ node.title }}</text>
              <text v-if="node.time" class="text-xs text-[#999999]">{{ node.time }}</text>
            </view>
            <text :class="['text-sm mt-1 block', getNodeStatus(index) === 'completed' || getNodeStatus(index) === 'refunding' ? 'text-[#666666]' : 'text-gray-400']">{{ node.description }}</text>

            <!-- 展开详情 -->
            <view v-if="expandedNode === index && (getNodeStatus(index) === 'completed' || getNodeStatus(index) === 'refunding')" class="mt-2 p-3 bg-[#FAF8F5] rounded-lg text-sm text-[#666666]">
              <text v-if="index === 0" class="block">您的退款申请已成功提交，等待商家处理</text>
              <text v-if="index === 1" class="block">商家已审核通过，退款申请已转至平台</text>
              <text v-if="index === 2" class="block">平台已审核通过，退款正在处理中</text>
              <text v-if="index === 3" class="block">退款正在处理中，请耐心等待</text>
              <view v-if="index === 4">
                <text class="block">退款金额将在1-3个工作日内退回原支付账户</text>
                <text class="mt-1 text-orange-600 block">如超过3个工作日未到账，请联系客服</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 退款信息 -->
    <view class="mx-4 mt-4 bg-white rounded-2xl p-4 shadow-sm">
      <text class="font-semibold text-[#2C2C2C] mb-3 block">退款信息</text>
      <view class="space-y-3 text-sm">
        <view class="flex justify-between">
          <text class="text-[#999999]">退款单号</text>
          <view class="flex items-center gap-2">
            <text class="text-[#2C2C2C]">{{ refund.id }}</text>
            <view @click.stop="handleCopy(refund.id)" class="text-[#C41E3A]">
              <text v-if="copied" class="text-sm">✓</text>
              <text v-else class="text-sm">📋</text>
            </view>
          </view>
        </view>
        <view class="flex justify-between">
          <text class="text-[#999999]">关联订单</text>
          <view @click.stop="goTo('/pages/orders/id-detail/index?id=' + refund.orderId)" class="text-[#C41E3A] flex items-center gap-1">
            <text>{{ refund.orderNo }}</text>
            <text class="text-sm">›</text>
          </view>
        </view>
        <view class="flex justify-between">
          <text class="text-[#999999]">退款类型</text>
          <text class="text-[#2C2C2C]">{{ refund.type === 'refund_only' ? '仅退款' : '退货退款' }}</text>
        </view>
        <view class="flex justify-between">
          <text class="text-[#999999]">退款原因</text>
          <text class="text-[#2C2C2C]">{{ refund.reason }}</text>
        </view>
        <view class="flex justify-between">
          <text class="text-[#999999]">申请时间</text>
          <text class="text-[#2C2C2C]">{{ refund.createdAt }}</text>
        </view>
      </view>
    </view>

    <!-- 商品信息 -->
    <view class="mx-4 mt-4 bg-white rounded-2xl p-4 shadow-sm">
      <text class="font-semibold text-[#2C2C2C] mb-3 block">退款商品</text>
      <view class="flex gap-3">
        <image :src="refund.product.cover" mode="aspectFill" class="w-16 h-16 rounded-lg bg-gray-100" />
        <view class="flex-1 min-w-0">
          <text class="text-sm text-[#2C2C2C] line-clamp-2 block">{{ refund.product.name }}</text>
          <text class="text-xs text-[#999999] mt-1 block">{{ refund.product.skuName }}</text>
          <view class="flex items-center justify-between mt-2">
            <text class="text-[#C41E3A] font-medium">¥{{ refund.product.price }}</text>
            <text class="text-xs text-[#999999]">×{{ refund.product.quantity }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 温馨提示 -->
    <view class="mx-4 mt-4 bg-orange-50 border border-orange-200 rounded-xl p-4">
      <view class="flex items-start gap-2">
        <text class="text-lg text-orange-500 flex-shrink-0 mt-0.5">⚠️</text>
        <view class="text-sm text-orange-700">
          <text class="font-medium mb-1 block">温馨提示</text>
          <view class="space-y-1 text-orange-600 text-xs">
            <text class="block">退款将在1-3个工作日内原路退回</text>
            <text class="block">银行卡退款可能延迟，具体以银行到账时间为准</text>
            <text class="block">如有疑问，请联系在线客服</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部操作 -->
    <view class="fixed bottom-0 left-0 right-0 bg-white border-t border-[#E8E0D5] p-4 flex gap-3">
      <view @click="goTo('/pages/chat/support')" class="flex-1 flex items-center justify-center gap-2 py-3 border border-[#E8E0D5] rounded-xl text-[#2C2C2C]">
        <text class="text-lg">💬</text>
        <text>联系客服</text>
      </view>
      <view @click="goTo('/pages/orders/dispute/index?orderId=' + refund.orderId)" class="flex-1 flex items-center justify-center gap-2 py-3 border border-[#E8E0D5] rounded-xl text-[#2C2C2C]">
        <text class="text-lg">🛡️</text>
        <text>我要申诉</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'

interface TimelineNode {
  status: string
  title: string
  description: string
  time: string
  isCurrent: boolean
}

interface AfterSaleProduct {
  id: string
  name: string
  cover: string
  skuName: string
  price: number
  quantity: number
}

interface AfterSaleDetail {
  id: string
  orderId: string
  orderNo: string
  type: string
  status: string
  reason: string
  amount: number
  description: string
  product: AfterSaleProduct
  timeline: TimelineNode[]
  createdAt: string
  canCancel: boolean
}

const mockRefund: AfterSaleDetail = {
  id: '1',
  orderId: 'order1',
  orderNo: 'GX20240115001',
  type: 'refund_only',
  status: 'refunding',
  reason: '不想要了',
  amount: 168,
  description: '商品包装完好，未拆封',
  product: {
    id: 'p1',
    name: '周易六十四卦详解（精装典藏版）',
    cover: '/placeholder.svg',
    skuName: '精装版',
    price: 168,
    quantity: 1,
  },
  timeline: [
    { status: 'submitted', title: '申请提交', description: '您已提交退款申请', time: '2024-01-15 10:30', isCurrent: false },
    { status: 'merchant_review', title: '商家审核', description: '商家已同意退款', time: '2024-01-15 14:20', isCurrent: false },
    { status: 'platform_review', title: '平台审核', description: '平台审核通过', time: '2024-01-15 15:00', isCurrent: false },
    { status: 'refunding', title: '退款处理', description: '正在处理退款...', time: '2024-01-15 15:30', isCurrent: true },
    { status: 'completed', title: '退款到账', description: '预计1-3个工作日到账', time: '', isCurrent: false },
  ],
  createdAt: '2024-01-15 10:30',
  canCancel: false,
}

const loading = ref(true)
const refund = ref<AfterSaleDetail | null>(null)
const copied = ref(false)
const expandedNode = ref<number | null>(null)
const refundMethod = '微信支付'
const estimatedDate = '2024年1月18日'

onMounted(() => {
  const pages = getCurrentPages()
  const currentPage = pages[pages.length - 1] as any
  const id = currentPage?.$page?.options?.id
  loadData(id)
})

function loadData(id: string) {
  loading.value = true
  setTimeout(() => {
    refund.value = mockRefund
    loading.value = false
  }, 300)
}

function handleCopy(text: string) {
  uni.setClipboardData({
    data: text,
    success: () => {
      copied.value = true
      setTimeout(() => { copied.value = false }, 2000)
      uni.showToast({ title: '已复制', icon: 'none' })
    }
  })
}

function toggleNode(index: number) {
  expandedNode.value = expandedNode.value === index ? null : index
}

function getNodeStatus(index: number) {
  if (!refund.value) return 'pending'
  const currentIndex = refund.value.timeline.findIndex(t => t.isCurrent)
  if (currentIndex === -1) {
    return refund.value.status === 'completed' ? 'completed' : 'pending'
  }
  if (index < currentIndex) return 'completed'
  if (index === currentIndex) return 'refunding'
  return 'pending'
}

function goBack() {
  uni.navigateBack()
}

function goTo(url: string) {
  uni.navigateTo({ url })
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
