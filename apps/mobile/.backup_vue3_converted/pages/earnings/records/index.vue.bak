<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 py-3">
        <view @click="goBack" class="p-1">
          <text class="text-[#2C2C2C] text-xl">←</text>
        </view>
        <text class="text-lg font-semibold text-[#2C2C2C]">收益记录</text>
        <view class="w-8" />
      </view>
    </view>

    <!-- 加载骨架屏 -->
    <view v-if="loading" class="px-4 pt-4 space-y-4">
      <view class="grid grid-cols-2 gap-3">
        <view v-for="i in 4" :key="i" class="p-4 rounded-xl bg-[#F0EBE5] animate-pulse" />
      </view>
      <view class="flex gap-3">
        <view class="flex-1 h-10 rounded-xl bg-[#F0EBE5] animate-pulse" />
        <view class="flex-1 h-10 rounded-xl bg-[#F0EBE5] animate-pulse" />
      </view>
      <view class="flex gap-2">
        <view v-for="i in 4" :key="i" class="h-7 w-16 rounded-full bg-[#F0EBE5] animate-pulse" />
      </view>
      <view v-for="i in 3" :key="i" class="p-4 rounded-xl bg-[#F0EBE5] animate-pulse" />
    </view>

    <view v-else class="pb-24">
      <!-- 统计卡片 -->
      <view class="mx-4 mt-4 grid grid-cols-2 gap-3">
        <view class="p-4 text-center rounded-xl border col-span-2" style="background:rgba(196,30,58,0.05);border-color:rgba(196,30,58,0.2)">
          <text class="text-xs text-[#999] block mb-1">累计总收益</text>
          <text class="text-3xl font-bold text-[#C41E3A] block">¥{{ (totalEarnings).toFixed(2) }}</text>
        </view>
        <view class="p-4 text-center rounded-xl border border-[#E8E0D5] bg-white">
          <text class="text-xs text-[#999] block mb-1">本月收益</text>
          <text class="text-xl font-bold text-[#2C2C2C] block">¥{{ (monthEarnings).toFixed(2) }}</text>
          <text class="text-[10px] text-green-500 mt-0.5 block">↑ 较上月增长{{ ((monthEarnings - lastMonthEarnings) / lastMonthEarnings * 100).toFixed(1) }}%</text>
        </view>
        <view class="p-4 text-center rounded-xl border border-[#E8E0D5] bg-white">
          <text class="text-xs text-[#999] block mb-1">上月收益</text>
          <text class="text-xl font-bold text-[#2C2C2C] block">¥{{ (lastMonthEarnings).toFixed(2) }}</text>
        </view>
        <view class="p-4 text-center rounded-xl border border-[#E8E0D5] bg-white">
          <text class="text-xs text-[#999] block mb-1">可提现</text>
          <text class="text-xl font-bold block" style="color: #16A34A">¥{{ (availableBalance).toFixed(2) }}</text>
        </view>
        <view class="p-4 text-center rounded-xl border border-[#E8E0D5] bg-white">
          <text class="text-xs text-[#999] block mb-1">冻结中</text>
          <text class="text-xl font-bold text-[#999] block">¥{{ (frozenBalance).toFixed(2) }}</text>
        </view>
      </view>

      <!-- 快捷操作 -->
      <view class="mx-4 mt-4 flex gap-3">
        <view @click="goWithdraw" class="flex-1 py-2.5 rounded-xl bg-[#C41E3A] text-white text-sm font-medium text-center">
          申请提现
        </view>
        <view @click="goBreakdown" class="flex-1 py-2.5 rounded-xl border border-[#E8E0D5] text-[#2C2C2C] text-sm font-medium text-center">
          收益明细
        </view>
      </view>

      <!-- 月度趋势简图 -->
      <view class="mx-4 mt-4 bg-white rounded-xl p-4 border border-[#E8E0D5]">
        <view class="flex items-center justify-between mb-3">
          <text class="text-xs font-semibold text-[#2C2C2C]">📊 月度趋势</text>
          <text class="text-[10px] text-[#999]">近6个月</text>
        </view>
        <view class="flex items-end justify-between h-20 gap-1">
          <view v-for="(item, idx) in monthlyTrend" :key="idx" class="flex flex-col items-center flex-1">
            <view
              class="w-full rounded-t"
              :style="{ height: (item.amount / maxTrend * 100) + '%' }"
              :class="idx === monthlyTrend.length - 1 ? 'bg-[#C41E3A]' : 'bg-[#C41E3A]/30'"
            />
            <text class="text-[8px] text-[#999] mt-1">{{ item.month }}</text>
          </view>
        </view>
      </view>

      <!-- 分类筛选 -->
      <view class="mx-4 mt-4">
        <view class="flex gap-2 overflow-x-auto whitespace-nowrap scrollbar-hide">
          <view
            v-for="s in statusFilters"
            :key="s.value"
            @click="activeStatus = s.value"
            class="px-3 py-1.5 rounded-full text-xs font-medium transition-colors"
            :class="activeStatus === s.value ? 'bg-[#C41E3A] text-white' : 'bg-[#F0EBE5] text-[#2C2C2C]'"
          >
            <text>{{ s.label }}</text>
            <text v-if="s.count !== undefined" class="ml-1 opacity-70">({{ s.count }})</text>
          </view>
        </view>
      </view>

      <!-- 收益记录列表 -->
      <view class="mx-4 mt-4">
        <view v-if="filteredItems.length > 0" class="space-y-2">
          <view v-for="item in filteredItems" :key="item.id" class="p-4 rounded-xl border border-[#E8E0D5] bg-white">
            <view class="flex items-start justify-between gap-3">
              <view class="flex items-start gap-3 flex-1 min-w-0">
                <view class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0"
                  :class="getTypeColor(item.type)">
                  <text>{{ getTypeIcon(item.type) }}</text>
                </view>
                <view class="flex-1 min-w-0">
                  <text class="text-sm font-medium text-[#2C2C2C] line-clamp-1 block">{{ item.title }}</text>
                  <text class="text-xs text-[#999] mt-0.5 line-clamp-1 block">{{ item.description }}</text>
                  <view class="flex items-center gap-2 mt-2">
                    <text class="px-1.5 py-0.5 rounded text-[10px] bg-[#F5F1EB] text-[#2C2C2C]">{{ getEarningsTypeName(item.type) }}</text>
                    <text class="px-1.5 py-0.5 rounded text-[10px]" :class="statusColors[item.status]">{{ getEarningsStatusName(item.status) }}</text>
                  </view>
                  <text class="text-xs text-[#999] mt-1 block">{{ item.createdAt }}</text>
                </view>
              </view>
              <text class="text-sm font-bold flex-shrink-0" style="color: #16A34A">+¥{{ (item.amount).toFixed(2) }}</text>
            </view>
          </view>
        </view>

        <!-- 空状态 -->
        <view v-else class="p-10 rounded-xl border border-[#E8E0D5] bg-white text-center">
          <text class="text-4xl block mb-3">💰</text>
          <text class="text-[#999] text-sm block">暂无收益记录</text>
          <text class="text-xs text-[#999] mt-1 block">发布内容或推荐好友可获得收益</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

interface EarningsItem {
  id: string
  title: string
  description: string
  type: 'course_commission' | 'product_commission' | 'member_commission' | 'invite_reward' | 'platform_reward'
  status: 'settled' | 'pending' | 'frozen'
  amount: number
  createdAt: string
}

interface FilterOption {
  label: string
  value: string
  count?: number
}

interface TrendItem {
  month: string
  amount: number
}

// 加载状态
const loading = ref(true)
setTimeout(() => { loading.value = false }, 600)

// 汇总数据
const totalEarnings = ref(18450.50)
const monthEarnings = ref(5840)
const lastMonthEarnings = ref(4200)
const availableBalance = ref(12580.30)
const frozenBalance = ref(2500)

// 月度趋势
const monthlyTrend: TrendItem[] = [
  { month: '1月', amount: 3200 },
  { month: '2月', amount: 2800 },
  { month: '3月', amount: 4100 },
  { month: '4月', amount: 3800 },
  { month: '5月', amount: 5200 },
  { month: '6月', amount: 5840 },
]
const maxTrend = computed(() => Math.max(...monthlyTrend.map(t => t.amount)) * 1.2)

// 收益数据
const items = ref<EarningsItem[]>([
  { id: '1', title: '八字入门课分成', description: '来自学员张三的课程购买', type: 'course_commission', status: 'settled', amount: 5000, createdAt: '2024-01-15' },
  { id: '2', title: '1月会员费', description: '3位新会员入圈', type: 'member_commission', status: 'pending', amount: 3800, createdAt: '2024-01-10' },
  { id: '3', title: '邀请奖励', description: '推荐李四注册', type: 'invite_reward', status: 'settled', amount: 200, createdAt: '2024-01-08' },
  { id: '4', title: '课程销售分成', description: '紫微斗数课程销售佣金', type: 'course_commission', status: 'settled', amount: 2800, createdAt: '2024-01-05' },
  { id: '5', title: '商品佣金', description: '风水罗盘销售分成', type: 'product_commission', status: 'frozen', amount: 680, createdAt: '2024-01-03' },
  { id: '6', title: '平台奖励', description: '1月优质内容激励', type: 'platform_reward', status: 'settled', amount: 500, createdAt: '2024-01-01' },
])

// 状态筛选
const statusFilters: FilterOption[] = [
  { label: '全部', value: 'all', count: items.value.length },
  { label: '已结算', value: 'settled', count: items.value.filter(i => i.status === 'settled').length },
  { label: '待结算', value: 'pending', count: items.value.filter(i => i.status === 'pending').length },
  { label: '冻结中', value: 'frozen', count: items.value.filter(i => i.status === 'frozen').length },
]

const statusColors: Record<string, string> = {
  settled: 'bg-green-100 text-green-800',
  pending: 'bg-yellow-100 text-yellow-800',
  frozen: 'bg-gray-100 text-gray-800',
}

const activeStatus = ref('all')

const filteredItems = computed(() => {
  if (activeStatus.value === 'all') return items.value
  return items.value.filter(i => i.status === activeStatus.value)
})

function getTypeColor(type: string): string {
  const colors: Record<string, string> = {
    course_commission: 'bg-blue-50',
    product_commission: 'bg-purple-50',
    member_commission: 'bg-amber-50',
    invite_reward: 'bg-green-50',
    platform_reward: 'bg-rose-50',
  }
  return colors[type] || 'bg-[#C41E3A]/10'
}

function getTypeIcon(type: string): string {
  const icons: Record<string, string> = {
    course_commission: '📚',
    product_commission: '🛒',
    member_commission: '👥',
    invite_reward: '🎁',
    platform_reward: '🏆',
  }
  return icons[type] || '💰'
}

function getEarningsTypeName(type: string): string {
  const names: Record<string, string> = {
    course_commission: '课程佣金',
    product_commission: '商品佣金',
    member_commission: '会员佣金',
    invite_reward: '邀请奖励',
    platform_reward: '平台奖励',
  }
  return names[type] || type
}

function getEarningsStatusName(status: string): string {
  const names: Record<string, string> = {
    settled: '已结算',
    pending: '待结算',
    frozen: '冻结中',
  }
  return names[status] || status
}

function goBack() { uni.navigateBack() }
function goWithdraw() { uni.navigateTo({ url: '/pages/earnings/withdraw/index' }) }
function goBreakdown() { uni.navigateTo({ url: '/pages/earnings/breakdown/index' }) }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
.scrollbar-hide::-webkit-scrollbar { display: none; }
</style>
