<template>
  <!-- 输入界面 -->
  <view v-if="step === 'input'" class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 py-3">
        <view @click="goBack" class="p-1">
          <text class="text-[#2C2C2C] text-xl">←</text>
        </view>
        <text class="text-lg font-semibold text-[#2C2C2C]">申请提现</text>
        <view class="w-8" />
      </view>
    </view>

    <view class="pb-24">
      <!-- 收益概览 -->
      <view class="mx-4 mt-4 p-4 rounded-xl text-white" style="background: linear-gradient(135deg, var(--primary), #B91C1C)">
        <view class="flex items-start justify-between mb-4">
          <view>
            <text class="text-sm block mb-1" style="opacity: 0.8">可提现金额</text>
            <text class="text-3xl font-bold block">¥{{ mockEarningsInfo.availableBalance.toFixed(2) }}</text>
          </view>
          <view class="text-right">
            <text class="text-sm block" style="opacity: 0.8">总收益</text>
            <text class="text-xl font-bold block">¥{{ mockEarningsInfo.totalEarnings.toFixed(2) }}</text>
          </view>
        </view>
        <view class="grid grid-cols-2 gap-2 text-sm">
          <text>冻结中：¥{{ mockEarningsInfo.frozenBalance.toFixed(2) }}</text>
          <text class="text-right">待结算：¥{{ mockEarningsInfo.pendingBalance.toFixed(2) }}</text>
        </view>
      </view>

      <!-- 提现金额 -->
      <view class="mx-4 mt-6">
        <text class="text-sm font-semibold text-[#2C2C2C] block mb-2">提现金额</text>
        <view class="relative">
          <text class="absolute left-3 top-1/2 -translate-y-1/2 text-[#2C2C2C]/60">¥</text>
          <input v-model="amount" type="digit" placeholder="输入提现金额" class="w-full h-10 pl-8 pr-3 rounded-lg border border-[#E8E0D5] bg-white text-[#2C2C2C] text-sm" />
        </view>
        <view class="mt-2 flex items-center gap-2">
          <text class="text-xs text-[#999]">最低 ¥100，最高 ¥{{ mockEarningsInfo.availableBalance.toFixed(2) }}</text>
          <text @click="handleWithdrawAll" class="text-xs text-[#C41E3A] ml-auto">全部提现</text>
        </view>
      </view>

      <!-- 费用计算 -->
      <view v-if="amount" class="mx-4 mt-4 p-3 rounded-lg space-y-1" style="background: rgba(var(--muted), 0.5)">
        <view class="flex items-center justify-between text-sm">
          <text class="text-[#999]">手续费 (0.6%)</text>
          <text class="text-[#2C2C2C]">-¥{{ fee.toFixed(2) }}</text>
        </view>
        <view class="flex items-center justify-between font-semibold pt-1" style="border-top: 1px solid var(--border)">
          <text class="text-[#2C2C2C]">预计到账</text>
          <text class="text-green-600">¥{{ actualAmount.toFixed(2) }}</text>
        </view>
      </view>

      <!-- 提现账户选择 -->
      <view class="mx-4 mt-6">
        <text class="text-sm font-semibold text-[#2C2C2C] block mb-3">选择提现账户</text>
        <view class="space-y-2">
          <view v-for="account in mockAccounts" :key="account.id" @click="selectedAccount = account.id" :class="selectedAccount === account.id ? 'border-primary bg-[#C41E3A]/5' : 'border-[#E8E0D5]'" class="w-full p-3 rounded-lg border transition-all flex items-center gap-3">
            <view :class="selectedAccount === account.id ? 'border-primary bg-[#C41E3A]' : 'border-[#E8E0D5]'" class="w-5 h-5 rounded-full border-2 flex items-center justify-center flex-shrink-0">
              <text v-if="selectedAccount === account.id" class="text-white text-xs">✓</text>
            </view>
            <view class="flex-1">
              <text class="font-medium text-[#2C2C2C] block">{{ account.type }}</text>
              <text class="text-xs text-[#999] mt-0.5 block">{{ account.type === '支付宝' ? account.account : account.cardNumber }}</text>
            </view>
            <text v-if="account.isDefault" class="text-xs px-2 py-1 bg-[#F1EDE8] text-[#999] rounded">默认</text>
          </view>
        </view>
      </view>

      <!-- 提示 -->
      <view class="mx-4 mt-6 p-3 rounded-lg flex gap-2" style="background: #EFF6FF; border: 1px solid #BFDBFE">
        <text class="text-blue-600 flex-shrink-0 mt-0.5">ℹ️</text>
        <text class="text-xs" style="color: #1E40AF">提现手续费为提现金额的 0.6%，最低 1 元。微信、支付宝通常 2 小时内到账，银行卡 1-3 个工作日到账。</text>
      </view>
    </view>

    <!-- 底部按钮 -->
    <view class="fixed bottom-0 left-0 right-0 bg-[#FAF8F5] border-t border-[#E8E0D5] p-4">
      <view @click="handleSubmit" :style="{ opacity: isValidAmount ? 1 : 0.5 }" class="w-full py-3 rounded-lg bg-[#C41E3A] text-[#C41E3A]-foreground text-sm font-medium text-center">
        <text>{{ !amount ? '请输入金额' : !isValidAmount ? '金额无效' : '下一步' }}</text>
      </view>
    </view>
  </view>

  <!-- 确认界面 -->
  <view v-if="step === 'confirm'" class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 py-3">
        <view @click="step = 'input'" class="p-1">
          <text class="text-[#2C2C2C] text-xl">←</text>
        </view>
        <text class="text-lg font-semibold text-[#2C2C2C]">确认提现</text>
        <view class="w-8" />
      </view>
    </view>

    <view class="pb-24">
      <view class="mx-4 mt-6 space-y-3">
        <view class="p-4 rounded-xl border border-[#E8E0D5] bg-white">
          <view class="flex items-center justify-between mb-2">
            <text class="text-sm text-[#999]">提现金额</text>
            <text class="font-bold text-lg text-[#2C2C2C]">¥{{ numAmount.toFixed(2) }}</text>
          </view>
          <view class="flex items-center justify-between mb-2">
            <text class="text-sm text-[#999]">手续费 (0.6%)</text>
            <text class="text-sm" style="color: #DC2626">-¥{{ fee.toFixed(2) }}</text>
          </view>
          <view class="flex items-center justify-between pt-2" style="border-top: 1px solid var(--border)">
            <text class="text-sm font-medium text-[#2C2C2C]">实际到账</text>
            <text class="font-bold text-lg" style="color: #16A34A">¥{{ actualAmount.toFixed(2) }}</text>
          </view>
        </view>

        <!-- 提现账户 -->
        <view class="p-4 rounded-xl border border-[#E8E0D5] bg-white">
          <text class="text-sm font-semibold text-[#2C2C2C] block mb-3">提现账户</text>
          <view v-if="selectedAccountInfo" class="flex items-start gap-3">
            <view class="w-10 h-10 rounded-lg bg-[#C41E3A]/10 flex items-center justify-center">
              <text class="text-sm font-bold text-[#C41E3A]">{{ selectedAccountInfo.type === '支付宝' ? '支' : '卡' }}</text>
            </view>
            <view class="flex-1">
              <text class="font-medium text-[#2C2C2C] block">{{ selectedAccountInfo.type }}</text>
              <text class="text-xs text-[#999] mt-1 block">{{ selectedAccountInfo.type === '支付宝' ? selectedAccountInfo.account : selectedAccountInfo.cardNumber }}</text>
              <text class="text-xs text-[#999] block">账户名：{{ selectedAccountInfo.name }}</text>
            </view>
          </view>
        </view>

        <!-- 提示 -->
        <view class="p-3 rounded-lg flex gap-2" style="background: #FFF7ED; border: 1px solid #FED7AA">
          <text class="text-orange-600 flex-shrink-0 mt-0.5">⚠️</text>
          <text class="text-xs" style="color: #9A3412">提现到账需要 1-3 个工作日，节假日可能延迟。请确保账户信息准确无误。</text>
        </view>
      </view>

      <!-- 底部按钮 -->
      <view class="fixed bottom-0 left-0 right-0 bg-[#FAF8F5] border-t border-[#E8E0D5] p-4">
        <view class="flex gap-3">
          <view @click="step = 'input'" class="flex-1 py-3 rounded-lg border border-[#E8E0D5] text-center text-sm font-medium text-[#2C2C2C]">返回修改</view>
          <view @click="handleConfirm" :style="{ opacity: isSubmitting ? 0.5 : 1 }" class="flex-1 py-3 rounded-lg bg-[#C41E3A] text-[#C41E3A]-foreground text-center text-sm font-medium">
            <text>{{ isSubmitting ? '提交中...' : '确认提现' }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 成功界面 -->
  <view v-if="step === 'success'" class="min-h-screen bg-[#FAF8F5] flex flex-col items-center justify-center p-6">
    <view class="w-20 h-20 rounded-full flex items-center justify-center mb-6" style="background: rgba(34,197,94,0.2)">
      <text class="text-green-500 text-4xl">✓</text>
    </view>
    <text class="text-xl font-bold text-[#2C2C2C] block mb-2">提现申请已提交</text>
    <text class="text-sm text-[#999] text-center block mb-2">提现金额：¥{{ actualAmount.toFixed(2) }}</text>
    <text class="text-xs text-[#999] text-center block mb-8">预计 1-3 个工作日到账，请注意查收</text>

    <view class="flex gap-3 w-full max-w-xs">
      <view @click="goEarnings" class="flex-1 py-3 rounded-lg border border-[#E8E0D5] text-center text-sm font-medium text-[#2C2C2C]">返回收益</view>
      <view @click="goRecords" class="flex-1 py-3 rounded-lg bg-[#C41E3A] text-[#C41E3A]-foreground text-center text-sm font-medium">查看记录</view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

const mockEarningsInfo = ref({
  totalEarnings: 18450.50,
  availableBalance: 12580.30,
  frozenBalance: 2500,
  pendingBalance: 3370.20,
  lastWithdraw: { date: '2024-01-15', amount: 5000 },
})

const mockAccounts = ref([
  { id: '1', type: '支付宝', account: 'zhangs@example.com', name: '张三', isDefault: true, cardNumber: '' },
  { id: '2', type: '银行卡', account: '中国工商银行', name: '张三', cardNumber: '6222****1234', isDefault: false },
])

const amount = ref('')
const selectedAccount = ref('1')
const step = ref<'input' | 'confirm' | 'success'>('input')
const isSubmitting = ref(false)

const numAmount = computed(() => parseFloat(amount.value) || 0)
const minWithdraw = 100
const isValidAmount = computed(() => numAmount.value >= minWithdraw && numAmount.value <= mockEarningsInfo.value.availableBalance)
const fee = computed(() => numAmount.value > 0 ? Math.max(numAmount.value * 0.006, 1) : 0)
const actualAmount = computed(() => numAmount.value > 0 ? numAmount.value - fee.value : 0)
const selectedAccountInfo = computed(() => mockAccounts.value.find(a => a.id === selectedAccount.value))

function goBack() { uni.navigateBack() }
function goEarnings() { uni.navigateTo({ url: '/pages/earnings/index' }) }
function goRecords() { uni.navigateTo({ url: '/pages/earnings/withdraw/records/index' }) }
function handleWithdrawAll() { amount.value = mockEarningsInfo.value.availableBalance.toFixed(2) }
function handleSubmit() { if (isValidAmount.value) step.value = 'confirm' }
function handleConfirm() {
  isSubmitting.value = true
  setTimeout(() => {
    isSubmitting.value = false
    step.value = 'success'
  }, 1500)
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
