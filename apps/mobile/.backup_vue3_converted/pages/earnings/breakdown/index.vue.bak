<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 py-3">
        <view @click="goBack" class="p-1">
          <text class="text-[#2C2C2C] text-xl">←</text>
        </view>
        <text class="text-lg font-semibold text-[#2C2C2C]">收益明细</text>
        <view class="p-1">
          <text class="text-[#2C2C2C]/60">🔍</text>
        </view>
      </view>
    </view>

    <!-- Loading skeleton -->
    <view v-if="loading" class="p-4 space-y-4">
      <view class="h-40 bg-gray-200 rounded-2xl animate-pulse" />
      <view class="space-y-3">
        <view v-for="i in 4" :key="i" class="h-20 bg-gray-200 rounded-xl animate-pulse" />
      </view>
    </view>

    <!-- Error state -->
    <view v-else-if="error" class="p-4">
      <view class="flex flex-col items-center justify-center py-20">
        <text class="text-3xl text-[#999] mb-4">⚠️</text>
        <text class="text-sm text-[#999] mb-4">{{ error }}</text>
        <view @click="loadData" class="px-4 py-2 bg-[#C41E3A] text-white text-sm rounded-lg">
          <text>重新加载</text>
        </view>
      </view>
    </view>

    <!-- Content -->
    <view v-else class="pb-20">
      <!-- 余额总览卡片 -->
      <view class="mx-4 mt-4 p-5 rounded-2xl text-white" style="background: linear-gradient(135deg, var(--primary), #B91C1C)">
        <text class="text-sm block mb-1" style="opacity: 0.8">可提现余额</text>
        <text class="text-4xl font-bold block mb-1">¥{{ overview.availableBalance.toFixed(2) }}</text>
        <text class="text-sm block mb-4" style="opacity: 0.7">冻结中 ¥{{ overview.frozenBalance.toFixed(2) }}</text>
        <view class="grid grid-cols-3 gap-3 text-center">
          <view>
            <text class="text-lg font-bold block">¥{{ overview.todayEarnings.toFixed(0) }}</text>
            <text class="text-xs block mt-0.5" style="opacity: 0.7">今日收益</text>
          </view>
          <view>
            <text class="text-lg font-bold block">¥{{ overview.monthEarnings.toFixed(0) }}</text>
            <text class="text-xs block mt-0.5" style="opacity: 0.7">本月收益</text>
          </view>
          <view>
            <text class="text-lg font-bold block">¥{{ overview.totalEarnings.toFixed(0) }}</text>
            <text class="text-xs block mt-0.5" style="opacity: 0.7">累计收益</text>
          </view>
        </view>
      </view>

      <!-- 环比增长 -->
      <view v-if="monthGrowth !== null" class="mx-4 mt-3 p-3 rounded-xl border border-[#E8E0D5] bg-white flex items-center justify-between">
        <text class="text-sm text-[#999]">环比上月</text>
        <view :class="Number(monthGrowth) >= 0 ? 'text-green-600' : 'text-red-600'" class="flex items-center gap-1 text-sm font-semibold">
          <text>{{ Number(monthGrowth) >= 0 ? '📈' : '📉' }}</text>
          <text>{{ Math.abs(Number(monthGrowth)) }}%</text>
        </view>
      </view>

      <!-- 类型筛选 -->
      <view class="mt-5 px-4">
        <view class="flex gap-2 overflow-x-auto pb-2" style="scrollbar-width: none">
          <view v-for="f in typeFilters" :key="f.value" @click="activeFilter = f.value" :class="activeFilter === f.value ? 'bg-[#C41E3A] text-white' : 'bg-[#F0EBE5] text-[#2C2C2C]'" class="px-3 py-1.5 rounded-full text-sm whitespace-nowrap flex-shrink-0 transition-colors">
            <text>{{ f.label }}</text>
          </view>
        </view>
      </view>

      <!-- 明细列表 -->
      <view class="mx-4 mt-4">
        <view v-if="items.length > 0" class="space-y-2">
          <view v-for="item in items" :key="item.id" class="p-4 rounded-xl border border-[#E8E0D5] bg-white">
            <view class="flex items-start gap-3">
              <view class="w-10 h-10 rounded-full bg-[#C41E3A]/10 flex items-center justify-center flex-shrink-0">
                <text class="text-[#C41E3A]">📈</text>
              </view>
              <view class="flex-1 min-w-0">
                <view class="flex items-start justify-between gap-2">
                  <view class="flex-1">
                    <text class="text-sm font-medium text-[#2C2C2C] block">{{ item.title }}</text>
                    <text class="text-xs text-[#999] mt-0.5 line-clamp-1 block">{{ item.description }}</text>
                  </view>
                  <text class="text-sm font-bold flex-shrink-0" style="color: #16A34A">+¥{{ item.amount.toFixed(2) }}</text>
                </view>
                <view class="flex items-center gap-2 mt-2">
                  <text class="px-1.5 py-0 rounded text-[10px] bg-[#F5F1EB] text-[#2C2C2C]">{{ getEarningsTypeName(item.type) }}</text>
                  <text class="px-1.5 py-0 rounded text-[10px]" :class="statusColors[item.status]">{{ getEarningsStatusName(item.status) }}</text>
                  <text class="text-xs text-[#999] ml-auto">{{ item.createdAt }}</text>
                </view>
                <view v-if="item.relatedOrder" class="mt-1.5 text-xs text-[#999]">
                  订单金额 ¥{{ item.relatedOrder.orderAmount.toFixed(2) }}
                </view>
              </view>
            </view>
          </view>
        </view>
        <view v-else class="p-10 rounded-xl border border-[#E8E0D5] bg-white text-center">
          <text class="text-[#999] text-sm">暂无收益明细</text>
        </view>
      </view>

      <!-- 收益说明 -->
      <view class="mx-4 mt-6 p-4 rounded-xl" style="background: rgba(var(--muted), 0.5)">
        <text class="text-sm font-semibold text-[#2C2C2C] block mb-2">收益说明</text>
        <view class="text-xs text-[#999] space-y-1">
          <text class="block">• 已结算收益可随时申请提现</text>
          <text class="block">• 冻结收益将在交易确认后释放</text>
          <text class="block">• 待结算收益通常 T+1 结算</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

const loading = ref(true)
const error = ref<string | null>(null)
const overview = ref<any>({
  availableBalance: 12580.30,
  frozenBalance: 2500,
  todayEarnings: 325.50,
  monthEarnings: 5840.00,
  totalEarnings: 18450.50,
  lastMonthEarnings: 4200.00,
})

const items = ref<any[]>([])

const typeFilters = [
  { label: '全部', value: 'all' },
  { label: '课程佣金', value: 'course_commission' },
  { label: '商品佣金', value: 'product_commission' },
  { label: '会员佣金', value: 'member_commission' },
  { label: '邀请奖励', value: 'invite_reward' },
  { label: '平台奖励', value: 'platform_reward' },
]

const statusColors: Record<string, string> = {
  settled: 'bg-green-100 text-green-800',
  pending: 'bg-yellow-100 text-yellow-800',
  frozen: 'bg-gray-100 text-gray-800',
}

const activeFilter = ref<string>('all')

const monthGrowth = computed(() => {
  if (overview.value.lastMonthEarnings > 0) {
    return (((overview.value.monthEarnings - overview.value.lastMonthEarnings) / overview.value.lastMonthEarnings) * 100).toFixed(1)
  }
  return null
})

onMounted(() => {
  loadData()
})

function loadData() {
  loading.value = true
  error.value = null
  setTimeout(() => {
    overview.value = {
      availableBalance: 12580.30,
      frozenBalance: 2500,
      todayEarnings: 325.50,
      monthEarnings: 5840.00,
      totalEarnings: 18450.50,
      lastMonthEarnings: 4200.00,
    }
    items.value = [
      { id: '1', title: '八字入门课分成', description: '来自学员张三的课程购买', type: 'course_commission', status: 'settled', amount: 5000, createdAt: '2024-01-15', relatedOrder: { orderAmount: 9999 } },
      { id: '2', title: '1月会员费', description: '3位新会员入圈', type: 'member_commission', status: 'pending', amount: 3800, createdAt: '2024-01-10', relatedOrder: null },
      { id: '3', title: '商品销售分成', description: '罗盘销售佣金', type: 'product_commission', status: 'settled', amount: 1200, createdAt: '2024-01-08', relatedOrder: { orderAmount: 3200 } },
      { id: '4', title: '邀请好友奖励', description: '推荐新用户注册', type: 'invite_reward', status: 'settled', amount: 500, createdAt: '2024-01-05', relatedOrder: null },
    ]
    loading.value = false
  }, 500)
}

function goBack() { uni.navigateBack() }
function getEarningsTypeName(type: string) {
  const names: Record<string, string> = { course_commission: '课程佣金', product_commission: '商品佣金', member_commission: '会员佣金', invite_reward: '邀请奖励', platform_reward: '平台奖励' }
  return names[type] || type
}
function getEarningsStatusName(status: string) {
  const names: Record<string, string> = { settled: '已结算', pending: '待结算', frozen: '冻结中' }
  return names[status] || status
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
