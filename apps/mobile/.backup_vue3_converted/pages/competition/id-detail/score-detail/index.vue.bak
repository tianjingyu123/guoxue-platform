<template>
  <view class="min-h-screen pb-6" style="background-color: #FAF8F5;">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-50" style="background-color: #FFFFFF; border-bottom: 1px solid #E8E0D5;">
      <view class="flex items-center justify-between px-4" style="height: 44px;">
        <view @click="goBack" class="flex items-center" style="cursor: pointer;">
          <text style="font-size: 18px; color: #2C2C2C; line-height: 1;">←</text>
        </view>
        <text class="font-medium" style="color: #2C2C2C; font-size: 15px;">成绩详情</text>
        <view @click="handleShare" style="cursor: pointer;">
          <text style="font-size: 18px; color: #2C2C2C; line-height: 1;">🔗</text>
        </view>
      </view>
    </view>

    <!-- 成绩总览 -->
    <view
      class="px-4 py-6 text-center text-white"
      :style="{
        backgroundImage: scoreData.isPromoted
          ? 'linear-gradient(135deg, #22C55E, #16A34A)'
          : 'linear-gradient(135deg, #6B7280, #4B5563)',
      }"
    >
      <view class="inline-block px-2 py-0.5 rounded text-xs mb-2" style="background-color: rgba(255,255,255,0.2);">
        <text style="color: #FFFFFF;">{{ scoreData.roundName }}</text>
      </view>

      <text class="text-5xl font-bold block mb-2" style="color: #FFFFFF;">{{ scoreData.totalScore }}</text>
      <text class="text-sm block mb-4" style="color: rgba(255,255,255,0.8);">满分 {{ scoreData.fullScore }}</text>

      <view
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full"
        :style="{ backgroundColor: scoreData.isPromoted ? 'rgba(255,255,255,0.2)' : 'rgba(255,255,255,0.1)' }"
      >
        <text v-if="scoreData.isPromoted" class="font-medium" style="color: #FFFFFF;">🏆 恭喜晋级复赛！</text>
        <text v-else class="font-medium" style="color: #FFFFFF;">未能晋级</text>
      </view>

      <!-- 排名/用时/正确率 -->
      <view class="flex items-center justify-center gap-6 mt-4 text-sm">
        <view>
          <text class="block" style="color: rgba(255,255,255,0.7);">排名</text>
          <text class="font-bold text-lg block" style="color: #FFFFFF;">{{ scoreData.rank }}/{{ scoreData.totalParticipants }}</text>
        </view>
        <view class="w-px h-8" style="background-color: rgba(255,255,255,0.2);" />
        <view>
          <text class="block" style="color: rgba(255,255,255,0.7);">用时</text>
          <text class="font-bold text-lg block" style="color: #FFFFFF;">{{ scoreData.usedTime }}</text>
        </view>
        <view class="w-px h-8" style="background-color: rgba(255,255,255,0.2);" />
        <view>
          <text class="block" style="color: rgba(255,255,255,0.7);">正确率</text>
          <text class="font-bold text-lg block" style="color: #FFFFFF;">{{ Math.round(scoreData.correctCount / scoreData.totalQuestions * 100) }}%</text>
        </view>
      </view>
    </view>

    <!-- 晋级提示 -->
    <view
      v-if="scoreData.isPromoted"
      class="mx-4 -mt-4 relative z-10 p-4 rounded-xl"
      style="background-color: #F0FDF4; border: 1px solid #86EFAC;"
    >
      <view class="flex items-center gap-3">
        <view class="w-10 h-10 rounded-full flex items-center justify-center" style="background-color: #DCFCE7;">
          <text style="font-size: 18px; color: #16A34A;">🏆</text>
        </view>
        <view class="flex-1">
          <text class="font-medium block" style="color: #166534;">已成功晋级复赛</text>
          <text class="text-sm block" style="color: #16A34A;">复赛将于 2024-04-15 开始</text>
        </view>
        <view
          @click="goPromotion"
          class="px-3 py-1.5 rounded-lg text-sm font-medium"
          style="border: 1px solid #86EFAC; color: #15803D; cursor: pointer;"
        >
          查看详情
        </view>
      </view>
    </view>

    <!-- 各维度得分 -->
    <view class="px-4 mt-4">
      <view class="p-4 rounded-xl" style="background-color: #FFFFFF; border: 1px solid #E8E0D5;">
        <text class="font-medium mb-4 block" style="color: #2C2C2C;">分项得分</text>
        <view class="space-y-4">
          <view v-for="dim in scoreData.dimensions" :key="dim.name">
            <view class="flex items-center justify-between text-sm mb-1">
              <text style="color: #2C2C2C;">{{ dim.name }}</text>
              <text class="font-medium" style="color: #2C2C2C;">{{ dim.score }}/{{ dim.fullScore }}</text>
            </view>
            <view class="flex items-center gap-2">
              <view class="flex-1 h-2 rounded-full overflow-hidden" style="background-color: #F5F1EB;">
                <view class="h-full rounded-full" :style="{ width: dim.percentage + '%', backgroundColor: '#C41E3A' }" />
              </view>
              <text class="text-xs" style="color: #999; width: 40px;">{{ dim.percentage }}%</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 答题统计 -->
    <view class="px-4 mt-4">
      <view class="p-4 rounded-xl" style="background-color: #FFFFFF; border: 1px solid #E8E0D5;">
        <text class="font-medium mb-4 block" style="color: #2C2C2C;">答题统计</text>
        <view class="grid grid-cols-3 gap-4 text-center">
          <view class="p-3 rounded-xl" style="background-color: #F5F1EB;">
            <text class="text-2xl font-bold block" style="color: #16A34A;">{{ scoreData.correctCount }}</text>
            <text class="text-xs" style="color: #999;">正确</text>
          </view>
          <view class="p-3 rounded-xl" style="background-color: #F5F1EB;">
            <text class="text-2xl font-bold block" style="color: #EF4444;">{{ scoreData.wrongCount }}</text>
            <text class="text-xs" style="color: #999;">错误</text>
          </view>
          <view class="p-3 rounded-xl" style="background-color: #F5F1EB;">
            <text class="text-2xl font-bold block" style="color: #999;">{{ scoreData.totalQuestions - scoreData.correctCount - scoreData.wrongCount }}</text>
            <text class="text-xs" style="color: #999;">未答</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 题目详情 -->
    <view class="px-4 mt-4">
      <view class="p-4 rounded-xl" style="background-color: #FFFFFF; border: 1px solid #E8E0D5;">
        <view class="flex items-center justify-between mb-4">
          <text class="font-medium" style="color: #2C2C2C;">题目详情</text>
          <view
            @click="handleDownload"
            class="flex items-center gap-1 px-2 py-1 rounded"
            style="cursor: pointer;"
          >
            <text style="font-size: 12px;">⬇️</text>
            <text class="text-xs" style="color: #999;">下载成绩单</text>
          </view>
        </view>

        <view class="space-y-3">
          <view
            v-for="(q, index) in displayedQuestions"
            :key="q.id"
            class="rounded-xl overflow-hidden"
            style="border: 1px solid #E8E0D5;"
          >
            <!-- Question header (clickable) -->
            <view
              @click="toggleQuestion(q.id)"
              class="w-full p-3 flex items-center gap-3"
              style="cursor: pointer;"
            >
              <view
                class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0"
                :style="{ backgroundColor: q.isCorrect ? '#DCFCE7' : '#FEE2E2' }"
              >
                <text
                  :style="{ color: q.isCorrect ? '#16A34A' : '#EF4444', fontSize: '12px' }"
                >
                  {{ q.isCorrect ? '✓' : '✗' }}
                </text>
              </view>
              <view class="flex-1 min-w-0">
                <text class="text-sm truncate block" style="color: #2C2C2C;">{{ index + 1 }}. {{ q.content }}</text>
              </view>
              <view class="flex items-center gap-2">
                <text
                  class="text-sm font-medium"
                  :style="{ color: q.isCorrect ? '#16A34A' : '#EF4444' }"
                >
                  {{ q.score }}/{{ q.fullScore }}
                </text>
                <text style="color: #999; font-size: 12px;">{{ expandedQuestions.has(q.id) ? '▲' : '▼' }}</text>
              </view>
            </view>

            <!-- Expanded answer detail -->
            <view
              v-if="expandedQuestions.has(q.id)"
              class="px-3 pb-3 pt-0"
              style="border-top: 1px solid #E8E0D5;"
            >
              <view class="mt-3 space-y-2 text-sm">
                <view class="flex gap-2">
                  <text class="flex-shrink-0" style="color: #999; width: 64px;">你的答案</text>
                  <text :style="{ color: q.isCorrect ? '#16A34A' : '#EF4444' }">
                    {{ Array.isArray(q.myAnswer) ? q.myAnswer.join(', ') : q.myAnswer }}
                  </text>
                </view>
                <view v-if="!q.isCorrect" class="flex gap-2">
                  <text class="flex-shrink-0" style="color: #999; width: 64px;">正确答案</text>
                  <text style="color: #16A34A;">
                    {{ Array.isArray(q.correctAnswer) ? q.correctAnswer.join(', ') : q.correctAnswer }}
                  </text>
                </view>
                <view class="mt-2 p-2 rounded-lg" style="background-color: #F5F1EB;">
                  <text class="text-xs" style="color: #999;">解析：{{ q.analysis }}</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 查看全部 / 收起 -->
        <view
          v-if="scoreData.questionDetails.length > 5"
          @click="showAllQuestions = !showAllQuestions"
          class="w-full mt-3 py-2 text-center text-sm"
          style="color: #999; cursor: pointer;"
        >
          <text>{{ showAllQuestions ? '收起' : '查看全部 ' + scoreData.questionDetails.length + ' 题' }}</text>
          <text class="ml-1">{{ showAllQuestions ? '▲' : '▼' }}</text>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="px-4 mt-4 flex gap-3">
      <view
        @click="goRanking"
        class="flex-1 py-2.5 rounded-lg border text-center text-sm font-medium"
        style="border-color: #E8E0D5; color: #2C2C2C; cursor: pointer;"
      >
        查看排行榜
      </view>
      <view
        @click="goCompetition"
        class="flex-1 py-2.5 rounded-lg text-center text-sm font-medium"
        style="background-color: #C41E3A; color: #FFFFFF; cursor: pointer;"
      >
        返回赛事
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

// --- Types ---
interface DimensionScore {
  name: string
  score: number
  fullScore: number
  percentage: number
}

interface QuestionDetail {
  id: string
  content: string
  type: 'single' | 'multiple' | 'judge'
  myAnswer: string | string[]
  correctAnswer: string | string[]
  isCorrect: boolean
  score: number
  fullScore: number
  analysis: string
}

interface ScoreData {
  competitionId: string
  competitionTitle: string
  roundName: string
  totalScore: number
  fullScore: number
  rank: number
  totalParticipants: number
  passLine: number
  isPassed: boolean
  isPromoted: boolean
  correctCount: number
  wrongCount: number
  totalQuestions: number
  usedTime: string
  dimensions: DimensionScore[]
  rankTrend: { round: string; rank: number }[]
  questionDetails: QuestionDetail[]
}

// --- Mock Data (V0 一致) ---
const scoreData = ref<ScoreData>({
  competitionId: '1',
  competitionTitle: '2024热卜杯·八字命理大赛',
  roundName: '初赛',
  totalScore: 86,
  fullScore: 100,
  rank: 128,
  totalParticipants: 1286,
  passLine: 70,
  isPassed: true,
  isPromoted: true,
  correctCount: 43,
  wrongCount: 5,
  totalQuestions: 50,
  usedTime: '68分32秒',
  dimensions: [
    { name: '基础概念', score: 28, fullScore: 30, percentage: 93 },
    { name: '实战应用', score: 32, fullScore: 40, percentage: 80 },
    { name: '综合分析', score: 26, fullScore: 30, percentage: 87 },
  ],
  rankTrend: [{ round: '初赛', rank: 128 }],
  questionDetails: [
    { id: 'q1', content: '八字中的"日主"指的是什么？', type: 'single', myAnswer: 'C', correctAnswer: 'C', isCorrect: true, score: 2, fullScore: 2, analysis: '日主是指日柱的天干，代表命主本人。' },
    { id: 'q2', content: '以下哪个是"木"的五行属性的天干？', type: 'single', myAnswer: 'A', correctAnswer: 'A', isCorrect: true, score: 2, fullScore: 2, analysis: '甲、乙属木，丙、丁属火，戊、己属土，庚、辛属金，壬、癸属水。' },
    { id: 'q3', content: '"子"属于十二地支中的哪一个？', type: 'single', myAnswer: 'B', correctAnswer: 'A', isCorrect: false, score: 0, fullScore: 2, analysis: '子是十二地支的第一个，顺序为：子、丑、寅、卯、辰、巳、午、未、申、酉、戌、亥。' },
    { id: 'q4', content: '以下哪些属于"六冲"关系？', type: 'multiple', myAnswer: ['A', 'B', 'C', 'D'], correctAnswer: ['A', 'B', 'C', 'D'], isCorrect: true, score: 4, fullScore: 4, analysis: '六冲为：子午冲、丑未冲、寅申冲、卯酉冲、辰戌冲、巳亥冲。' },
    { id: 'q5', content: '"正官"代表的是克我且与我同性的五行。', type: 'judge', myAnswer: 'B', correctAnswer: 'B', isCorrect: true, score: 2, fullScore: 2, analysis: '正官是克我且与我异性的五行。克我同性的是七杀。' },
  ],
})

// --- State ---
const showAllQuestions = ref(false)
const expandedQuestions = ref<Set<string>>(new Set())

// --- Computed ---
const displayedQuestions = computed(() =>
  showAllQuestions.value
    ? scoreData.value.questionDetails
    : scoreData.value.questionDetails.slice(0, 5)
)

// --- Interactions ---
function toggleQuestion(qId: string) {
  const newSet = new Set(expandedQuestions.value)
  if (newSet.has(qId)) {
    newSet.delete(qId)
  } else {
    newSet.add(qId)
  }
  expandedQuestions.value = newSet
}

// --- Navigation & Actions ---
function goBack() {
  uni.navigateBack()
}

function handleShare() {
  uni.shareWithSystem({
    title: scoreData.value.competitionTitle + ' - 成绩',
    summary: '我在' + scoreData.value.competitionTitle + '中获得了' + scoreData.value.totalScore + '分！',
  })
}

function handleDownload() {
  uni.showToast({ title: '成绩单下载中...', icon: 'none' })
  // 模拟下载
  setTimeout(() => {
    uni.showToast({ title: '成绩单已保存', icon: 'success' })
  }, 1000)
}

function goRanking() {
  uni.navigateTo({ url: '/pages/competition/id-detail/result/index?id=' + scoreData.value.competitionId })
}

function goCompetition() {
  uni.navigateTo({ url: '/pages/competition/id-detail/index?id=' + scoreData.value.competitionId })
}

function goPromotion() {
  uni.navigateTo({ url: '/pages/competition/id-detail/promotion-notice/index?id=' + scoreData.value.competitionId })
}
</script>
