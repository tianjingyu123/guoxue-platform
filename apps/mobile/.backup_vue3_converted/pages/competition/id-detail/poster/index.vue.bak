<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

const loading = ref(true)

onMounted(() => {
  setTimeout(() => { loading.value = false }, 500)
})

const posterData = ref({
  competitionId: '1', competitionTitle: '2024热卜杯·八字命理大赛',
  roundName: '初赛', participantName: '张三',
  avatar: '/images/users/me.jpg', rank: 128, score: 86,
  totalParticipants: 1286, promotedTo: '复赛',
  qrCodeUrl: 'https://rebu.com/competition/1',
})

const beatPercentage = computed(() => Math.round((1 - posterData.value.rank / posterData.value.totalParticipants) * 100))

function goBack() { uni.navigateBack() }
function savePoster() { uni.showToast({ title: '海报已保存到相册', icon: 'success' }) }
function sharePoster() { uni.showToast({ title: '已分享', icon: 'success' }) }
</script>

