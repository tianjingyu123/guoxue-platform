<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-24">
    <!-- 顶部导航 -->
    <header class="sticky top-0 z-50 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 h-11">
        <view @click="goBack" class="flex items-center">
          <text class="text-lg">←</text>
        </view>
        <text class="font-medium">评审打分</text>
        <text class="bg-[#F5F1EB] text-xs px-2 py-0.5 rounded">{{ completedCount }}/{{ pendingParticipants.length }}</text>
      </view>
      <view class="px-4 pb-2">
        <view class="h-1 bg-[#F5F1EB] rounded-full overflow-hidden">
          <view class="h-full bg-[#C41E3A] rounded-full" :style="{width: (completedCount / pendingParticipants.length) * 100 + '%'}" />
        </view>
      </view>
    </header>

    <!-- 待评审队列 -->
    <view class="px-4 py-3 border-b border-[#E8E0D5] overflow-x-auto">
      <view class="flex gap-2">
        <text v-for="(p, index) in pendingParticipants" :key="p.id" @click="currentIndex = index"
          :class="['px-3 py-1.5 rounded-full text-sm whitespace-nowrap flex items-center gap-1.5',
            index === currentIndex ? 'bg-[#C41E3A] text-white' :
            index < completedCount ? 'bg-green-100 text-green-700' : 'bg-[#F5F1EB] text-[#999]']">
          <text v-if="index < completedCount">✓</text>
          {{ p.name }}
        </text>
      </view>
    </view>

    <!-- 当前选手信息 -->
    <view class="px-4 py-4">
      <view class="bg-white rounded-xl p-4 border border-[#E8E0D5]/50">
        <view class="flex items-center gap-4">
          <view class="w-16 h-16 rounded-full bg-[#C41E3A]/10 flex items-center justify-center">
            <text class="text-3xl text-[#C41E3A]">👤</text>
          </view>
          <view class="flex-1">
            <view class="flex items-center gap-2">
              <text class="font-bold text-lg">{{ currentParticipant.name }}</text>
              <text class="bg-[#F5F1EB] text-xs px-2 py-0.5 rounded">{{ currentParticipant.group }}</text>
            </view>
            <text class="text-sm text-[#999] block">编号: {{ currentParticipant.participantNo }}</text>
            <text class="text-sm text-[#999] block">{{ currentParticipant.roundName }} · 第 {{ currentIndex + 1 }} 位选手</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 评分区域 -->
    <view class="px-4 space-y-4">
      <view class="bg-white rounded-xl p-4 border border-[#E8E0D5]/50">
        <view class="flex items-center justify-between mb-4">
          <text class="font-medium">多维度评分</text>
          <view class="text-right">
            <text class="text-2xl font-bold text-[#C41E3A]">{{ totalScore }}</text>
            <text class="text-[#999]">/{{ maxTotalScore }}</text>
          </view>
        </view>
        <view class="space-y-6">
          <view v-for="dim in scoreDimensions" :key="dim.id">
            <view class="flex items-center justify-between mb-2">
              <view>
                <text class="font-medium">{{ dim.name }}</text>
                <text class="text-xs text-[#999] ml-2">{{ dim.description }}</text>
              </view>
              <text class="font-bold text-lg text-[#C41E3A]">{{ scores[dim.id] }}</text>
            </view>
            <slider :min="0" :max="dim.maxScore" :value="scores[dim.id]" @change="handleScoreChange(dim.id, $event.detail.value)" activeColor="#C41E3A" block-color="#C41E3A" block-size="16" class="w-full" />
            <view class="flex justify-between text-xs text-[#999] mt-1">
              <text>0</text>
              <text>{{ dim.maxScore }}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 评语 -->
      <view class="bg-white rounded-xl p-4 border border-[#E8E0D5]/50">
        <text class="font-medium block mb-3">💬 评语（选填）</text>
        <textarea v-model="comment" placeholder="请输入对该选手的评价和建议..." class="w-full rounded-xl border border-[#E8E0D5]/50 bg-[#FAF8F5] px-3 py-2.5 text-sm" style="min-height: 80px;" />
      </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="fixed bottom-0 left-0 right-0 bg-white border-t border-[#E8E0D5] p-4 z-50">
      <view class="flex items-center gap-3">
        <view @click="goToPrev" :class="['px-3 py-2 rounded-lg border border-[#E8E0D5] flex-shrink-0', currentIndex === 0 ? 'opacity-50' : '']">
          <text>‹</text>
        </view>
        <view @click="showConfirm = true" :class="['flex-1 text-center py-2.5 rounded-lg text-white text-sm bg-[#C41E3A]', isSubmitting ? 'opacity-70' : '']">
          <text>{{ isSubmitting ? '提交中...' : '提交评分' }} 📨</text>
        </view>
        <view @click="goToNext" :class="['px-3 py-2 rounded-lg border border-[#E8E0D5] flex-shrink-0', currentIndex === pendingParticipants.length - 1 ? 'opacity-50' : '']">
          <text>›</text>
        </view>
      </view>
    </view>

    <!-- 确认弹窗 -->
    <view v-if="showConfirm" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center px-4">
      <view class="bg-white rounded-2xl p-6 w-full max-w-sm">
        <text class="text-lg font-bold block mb-4">确认提交评分？</text>
        <view class="space-y-2 mb-4">
          <text class="text-sm block">选手：{{ currentParticipant.name }}</text>
          <text class="text-sm block">总分：{{ totalScore }}/{{ maxTotalScore }}</text>
          <text v-if="comment" class="text-sm block">评语：{{ comment.slice(0, 50) }}...</text>
          <text class="text-xs text-[#999] block mt-2">提交后将无法修改，请确认后提交。</text>
        </view>
        <view class="flex gap-3">
          <text @click="showConfirm = false" class="flex-1 text-center py-2.5 rounded-lg border border-[#E8E0D5] text-sm">返回修改</text>
          <text @click="handleSubmit" class="flex-1 text-center py-2.5 rounded-lg bg-[#C41E3A] text-white text-sm">确认提交</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

const currentParticipant = {
  id: "p1", name: "张易学", avatar: "", participantNo: "BZ20240001", group: "高手组", roundName: "决赛",
}

const scoreDimensions = [
  { id: "expression", name: "表现力", description: "表达清晰、逻辑性强", maxScore: 10 },
  { id: "content", name: "内容深度", description: "分析透彻、见解独到", maxScore: 10 },
  { id: "technique", name: "专业技巧", description: "技法准确、应用得当", maxScore: 10 },
  { id: "innovation", name: "创新性", description: "思路新颖、有独特见解", maxScore: 10 },
]

const pendingParticipants = [
  { id: "p1", name: "张易学", status: "current" },
  { id: "p2", name: "李命理", status: "pending" },
  { id: "p3", name: "王八字", status: "pending" },
  { id: "p4", name: "赵玄机", status: "pending" },
  { id: "p5", name: "钱国学", status: "pending" },
]

const scores = ref<Record<string, number>>({ expression: 7, content: 7, technique: 7, innovation: 7 })
const comment = ref("")
const showConfirm = ref(false)
const isSubmitting = ref(false)
const currentIndex = ref(0)
const completedCount = ref(0)

const totalScore = computed(() => Object.values(scores.value).reduce((sum, s) => sum + s, 0))
const maxTotalScore = computed(() => scoreDimensions.reduce((sum, d) => sum + d.maxScore, 0))

function handleScoreChange(dimensionId: string, value: number) {
  scores.value[dimensionId] = Number(value)
}

function handleSubmit() {
  showConfirm.value = false
  isSubmitting.value = true
  setTimeout(() => {
    isSubmitting.value = false
    completedCount.value += 1
    if (currentIndex.value < pendingParticipants.length - 1) {
      currentIndex.value += 1
      scores.value = { expression: 7, content: 7, technique: 7, innovation: 7 }
      comment.value = ""
    } else {
      uni.showToast({ title: '全部评审完成', icon: 'success' })
    }
  }, 1000)
}

function goToPrev() { if (currentIndex.value > 0) currentIndex.value -= 1 }
function goToNext() { if (currentIndex.value < pendingParticipants.length - 1) currentIndex.value += 1 }

function goBack() { uni.navigateBack() }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
