<script setup lang="ts">
import { ref, onMounted } from 'vue'

const loading = ref(true)
const error = ref(false)

onMounted(() => {
  setTimeout(() => { loading.value = false }, 500)
})

const certificateData = ref({
  id: 'cert-001', competitionId: '1',
  competitionTitle: '2024热卜杯·八字命理大赛',
  roundName: '初赛', participantName: '张三',
  rank: 128, award: '优秀选手', score: 86,
  certificateNo: 'RBBS2024-0128',
  issueDate: '2024-04-08', validUntil: '永久有效',
})

function goBack() { uni.navigateBack() }
function reload() {
  error.value = false
  loading.value = true
  setTimeout(() => { loading.value = false }, 500)
}
function saveCert() { uni.showToast({ title: '证书已保存', icon: 'success' }) }
function shareCert() { uni.showToast({ title: '已分享', icon: 'success' }) }
</script>

