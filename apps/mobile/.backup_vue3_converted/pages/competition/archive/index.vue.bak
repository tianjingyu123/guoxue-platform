                  <text class="w-1.5 h-1.5 rounded-full bg-[#C41E3A] mt-2 flex-shrink-0" />
                  <text>{{ highlight }}</text>
                </view>
              </view>
            </view>

            <!-- 操作按钮 -->
            <view class="flex gap-3">
              <view v-if="competition.hasReplay" class="flex-1 py-2.5 rounded-lg border border-[#E8E0D5] text-center text-sm font-medium text-[#2C2C2C]">
                <text class="mr-1">▶️</text>观看回放
              </view>
              <view @click="goResult(competition.id)" class="flex-1 py-2.5 rounded-lg border border-[#E8E0D5] text-center text-sm font-medium text-[#2C2C2C]">
