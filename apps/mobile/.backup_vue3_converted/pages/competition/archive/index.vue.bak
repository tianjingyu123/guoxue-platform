    <!-- 历届比赛列表 -->
    <view class="px-4 py-4 space-y-4">
      <view v-for="competition in filteredData" :key="competition.id" class="rounded-xl border border-[#E8E0D5] bg-white overflow-hidden">
        <!-- 基本信息 -->
        <view class="p-4">
          <view class="flex items-start justify-between mb-2">
            <view>
              <text class="inline-block px-2 py-0.5 rounded text-xs bg-[#F5F1EB] text-[#2C2C2C] mb-2">{{ competition.edition }}</text>
              <text class="font-bold text-[#2C2C2C] block">{{ competition.title }}</text>
            </view>
            <text class="text-sm text-[#999]">{{ competition.year }}</text>
          </view>

          <view class="flex items-center gap-4 text-sm text-[#999] mb-4">
            <text class="flex items-center gap-1">📅 {{ competition.startTime }}</text>
            <text class="flex items-center gap-1">👥 {{ competition.totalParticipants }}人参赛</text>
          </view>

          <!-- 前三名展示 -->
          <view class="flex items-end justify-center gap-3 py-4 rounded-xl" style="background: linear-gradient(to bottom, rgba(254,243,199,0.5), transparent)">
            <!-- 亚军 -->
            <view class="text-center">
              <view class="w-12 h-12 rounded-full bg-gray-100 mx-auto mb-1 flex items-center justify-center">
                <text class="text-gray-400 text-lg">🏈</text>
              </view>
              <text class="text-xs font-medium text-[#2C2C2C]">{{ competition.topThree[1].name }}</text>
              <text class="text-xs text-[#999] block">{{ competition.topThree[1].score }}分</text>
            </view>

            <!-- 冠军 -->
            <view class="text-center -mt-4">
              <view class="w-16 h-16 rounded-full bg-amber-100 mx-auto mb-1 flex items-center justify-center">
                <text class="text-amber-500 text-2xl">👑</text>
              </view>
              <text class="text-sm font-bold text-[#2C2C2C]">{{ competition.topThree[0].name }}</text>
              <text class="text-xs text-amber-600 block">{{ competition.topThree[0].score }}分</text>
            </view>

            <!-- 季军 -->
            <view class="text-center">
              <view class="w-12 h-12 rounded-full bg-amber-50 mx-auto mb-1 flex items-center justify-center">
                <text class="text-amber-600 text-lg">🏅</text>
              </view>
              <text class="text-xs font-medium text-[#2C2C2C]">{{ competition.topThree[2].name }}</text>
