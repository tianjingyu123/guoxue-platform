<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-20">
    <!-- 顶部导航 -->
    <header class="sticky top-0 z-50 bg-[#C41E3A] text-white">
      <view class="flex items-center justify-between px-4 h-11">
        <view @click="goBack" class="flex items-center">
          <text class="text-white text-lg">←</text>
        </view>
        <text class="font-medium">赛事中心</text>
        <view @click="goTo('/pages/competition/archive')" class="text-sm opacity-80">
          <text>往期</text>
        </view>
      </view>
    </header>

    <!-- 搜索栏 -->
    <view class="px-4 py-3 bg-white border-b border-[#E8E0D5]">
      <view class="relative">
        <text class="absolute left-3 top-1/2 -translate-y-1/2 text-[#999] text-sm">🔍</text>
        <input v-model="searchQuery" placeholder="搜索赛事名称..." class="w-full pl-9 h-9 bg-[#F5F1EB] border-0 rounded-lg text-sm" />
      </view>
    </view>

    <!-- 热门赛事横幅 -->
    <view v-if="hotCompetitions.length > 0" class="px-4 py-4">
      <view @click="goTo('/pages/competition/' + hotCompetitions[0].id + '/id-detail')">
        <view class="relative rounded-2xl overflow-hidden bg-gradient-to-br from-primary via-primary to-primary/80 text-white p-4">
          <view class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full -translate-y-1/2 translate-x-1/2" />
          <view class="absolute bottom-0 left-0 w-20 h-20 bg-white/10 rounded-full translate-y-1/2 -translate-x-1/2" />
          <view class="relative">
            <view class="flex items-center gap-2 mb-2">
              <text class="bg-white/20 text-white text-[10px] px-2 py-0.5 rounded flex items-center gap-1">
                <text class="text-sm">🔥</text>热门赛事
              </text>
              <text :class="['text-white text-[10px] px-2 py-0.5 rounded', statusConfig[hotCompetitions[0].status as keyof typeof statusConfig]?.color || 'bg-green-500']">
                {{ statusConfig[hotCompetitions[0].status as keyof typeof statusConfig]?.label || '' }}
              </text>
            </view>
            <text class="text-lg font-bold block mb-1">{{ hotCompetitions[0].title }}</text>
            <text class="text-white/80 text-sm block mb-3">{{ hotCompetitions[0].organizer }} · {{ hotCompetitions[0].participants }}人已报名</text>
            <view class="flex items-center gap-4 text-sm">
              <text class="flex items-center gap-1">
                <text class="text-sm">🏆</text>{{ hotCompetitions[0].prizes[0] }}
              </text>
            </view>
            <view class="flex items-center justify-between mt-4">
              <text class="text-xs text-white/70">报名截止: {{ hotCompetitions[0].registrationDeadline }}</text>
              <view class="px-4 py-1.5 bg-white text-[#C41E3A] text-sm rounded-lg">立即报名</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 分类标签 -->
    <view class="px-4 pb-2">
      <view class="flex gap-2 overflow-x-auto pb-2">
        <text v-for="cat in categories" :key="cat.id" @click="activeCategory = cat.id"
          :class="['px-3 py-1.5 rounded-full text-sm whitespace-nowrap', activeCategory === cat.id ? 'bg-[#C41E3A] text-white' : 'bg-[#F5F1EB] text-[#2C2C2C]']">
          {{ cat.label }}
        </text>
      </view>
    </view>

    <!-- 状态Tab -->
    <view class="px-4 py-2">
      <view class="flex bg-[#F5F1EB]/50 rounded-lg p-0.5">
        <text v-for="tab in tabs" :key="tab.id" @click="activeTab = tab.id"
          :class="['flex-1 text-center py-1.5 text-xs rounded-md transition-colors', activeTab === tab.id ? 'bg-[#FAF8F5] shadow-sm font-medium' : 'text-[#999]']">
          {{ tab.label }}
        </text>
      </view>
    </view>

    <!-- 赛事列表 -->
    <view class="px-4 py-2 space-y-4">
      <view v-for="comp in filteredCompetitions" :key="comp.id" @click="goTo('/pages/competition/' + comp.id + '/id-detail')" class="bg-white rounded-xl overflow-hidden border border-[#E8E0D5]/50 active:scale-[0.99] transition-transform">
        <!-- 封面图 -->
        <view class="relative h-36 bg-gradient-to-br from-primary/20 to-primary/5">
          <view class="absolute inset-0 flex items-center justify-center">
            <text class="text-6xl text-[#C41E3A]/20">🏆</text>
          </view>
          <view class="absolute top-3 left-3 flex items-center gap-2">
            <text :class="['text-white text-[10px] px-2 py-0.5 rounded flex items-center gap-1', statusConfig[comp.status as keyof typeof statusConfig]?.color || 'bg-green-500']">
              <view :class="['w-1.5 h-1.5 rounded-full mr-1', comp.status === 'registering' ? 'bg-green-400 animate-pulse' : comp.status === 'ongoing' ? 'bg-[#C41E3A] animate-pulse' : '']" />
              {{ statusConfig[comp.status as keyof typeof statusConfig]?.label || '' }}
            </text>
            <text :class="['text-[10px] px-2 py-0.5 rounded', typeConfig[comp.type as keyof typeof typeConfig]?.color || 'bg-[#C41E3A]/10 text-[#C41E3A]']">
              {{ typeConfig[comp.type as keyof typeof typeConfig]?.label || '' }}
            </text>
          </view>
          <view v-if="comp.status === 'ended' && comp.winner" class="absolute bottom-3 right-3 flex items-center gap-2 px-2 py-1 bg-black/60 rounded-full">
            <text class="text-amber-400 text-sm">👑</text>
            <text class="text-xs text-white">冠军: {{ comp.winner.name }}</text>
          </view>
        </view>
        <view class="p-4">
          <text class="font-bold text-[#2C2C2C] block mb-2 line-clamp-1">{{ comp.title }}</text>
          <view class="flex items-center gap-2 mb-3">
            <view class="flex items-center gap-1.5">
              <view class="w-5 h-5 rounded bg-[#C41E3A]/10 flex items-center justify-center">
                <text :class="comp.circle ? 'text-[#C41E3A] text-xs' : 'text-[#C41E3A] text-xs'">{{ comp.circle ? '👥' : '🏆' }}</text>
              </view>
              <text class="text-xs text-[#999]">{{ comp.organizer }}</text>
            </view>
          </view>
          <view class="flex flex-wrap gap-1.5 mb-3">
            <text v-for="tag in comp.tags" :key="tag" class="px-2 py-0.5 bg-[#F5F1EB] text-xs text-[#999] rounded">{{ tag }}</text>
          </view>
          <view class="flex items-center justify-between text-xs text-[#999]">
            <view class="flex items-center gap-3">
              <text class="flex items-center gap-1">
                <text>👥</text>{{ comp.participants }}/{{ comp.maxParticipants }}
              </text>
              <text class="flex items-center gap-1">
                <text>📅</text>{{ comp.startTime }}
              </text>
            </view>
            <view v-if="comp.status === 'registering'" class="px-3 py-1 bg-[#C41E3A] text-white text-xs rounded-lg">立即报名</view>
            <text v-else-if="comp.status === 'ongoing'" class="text-[#C41E3A] font-medium text-xs">查看详情</text>
            <text v-else-if="comp.status === 'ended'" class="text-[#999] text-xs">查看结果</text>
          </view>
          <view class="mt-3 pt-3 border-t border-[#E8E0D5]">
            <view class="flex items-center gap-2 text-xs">
              <text class="text-amber-500">🥇</text>
              <text class="text-[#999] truncate">{{ comp.prizes[0] }}</text>
            </view>
          </view>
        </view>
      </view>

      <view v-if="filteredCompetitions.length === 0" class="text-center py-12 text-[#999]">
        <text class="text-4xl block mb-3 opacity-30">🏆</text>
        <text>暂无相关赛事</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

const statusConfig: Record<string, { label: string; color: string }> = {
  registering: { label: "报名中", color: "bg-green-500" },
  ongoing: { label: "进行中", color: "bg-[#C41E3A]" },
  ended: { label: "已结束", color: "bg-gray-400" },
  upcoming: { label: "即将开始", color: "bg-amber-500" },
}

const typeConfig: Record<string, { label: string; color: string }> = {
  platform: { label: "平台赛事", color: "bg-[#C41E3A]/10 text-[#C41E3A]" },
  circle: { label: "圈子赛事", color: "bg-amber-50 text-amber-600" },
  joint: { label: "联合主办", color: "bg-purple-50 text-purple-600" },
}

const tabs = [{ id: "all", label: "全部" }, { id: "registering", label: "报名中" }, { id: "ongoing", label: "进行中" }, { id: "ended", label: "已结束" }]

const categories = [
  { id: "all", label: "全部" }, { id: "bazi", label: "八字命理" }, { id: "ziwei", label: "紫微斗数" },
  { id: "fengshui", label: "风水堪舆" }, { id: "yijing", label: "易经占卜" }, { id: "qiming", label: "起名择日" },
]

interface Competition {
  id: string; title: string; type: string; status: string; startTime: string; endTime: string
  registrationDeadline: string; participants: number; maxParticipants: number; prizes: string[]
  rounds: string[]; circle: any; organizer: string; isHot: boolean; tags: string[]; winner?: any
}

const competitions: Competition[] = [
  {
    id: "1", title: "2024热卜杯·八字命理大赛", type: "platform", status: "registering",
    startTime: "2024-04-01", endTime: "2024-04-30", registrationDeadline: "2024-03-25",
    participants: 1286, maxParticipants: 2000, prizes: ["冠军奖金10000元", "亚军5000元", "季军3000元"],
    rounds: ["初赛(线上答题)", "复赛(案例分析)", "决赛(直播PK)"], circle: null,
    organizer: "热卜平台", isHot: true, tags: ["八字", "命理", "实战"],
  },
  {
    id: "2", title: "紫微斗数实战挑战赛", type: "circle", status: "ongoing",
    startTime: "2024-03-15", endTime: "2024-04-15", registrationDeadline: "2024-03-10",
    participants: 568, maxParticipants: 800, prizes: ["冠军免费入圈1年", "前10名获专属认证"],
    rounds: ["初赛(基础测试)", "决赛(盲排比拼)"],
    circle: { id: "c1", name: "紫微斗数研习社" }, organizer: "紫微斗数研习社", isHot: false, tags: ["紫微", "斗数"],
  },
  {
    id: "3", title: "第三届风水布局设计大赛", type: "joint", status: "upcoming",
    startTime: "2024-05-01", endTime: "2024-06-30", registrationDeadline: "2024-04-25",
    participants: 326, maxParticipants: 1000, prizes: ["总奖金池50000元", "优秀作品平台展示"],
    rounds: ["作品提交", "专家评审", "公众投票"],
    circle: { id: "c2", name: "玄空风水学院" }, organizer: "热卜平台 × 玄空风水学院", isHot: true, tags: ["风水", "设计", "实战"],
  },
  {
    id: "4", title: "易经六十四卦知识竞赛", type: "circle", status: "ended",
    startTime: "2024-02-01", endTime: "2024-02-28", registrationDeadline: "2024-01-25",
    participants: 892, maxParticipants: 1000, prizes: ["冠军获大师1v1指导"],
    rounds: ["初赛", "复赛", "决赛"],
    circle: { id: "c3", name: "易经研习堂" }, organizer: "易经研习堂", isHot: false, tags: ["易经", "六十四卦"],
    winner: { name: "张易学" },
  },
]

const activeTab = ref("all")
const activeCategory = ref("all")
const searchQuery = ref("")

const filteredCompetitions = computed(() => {
  return competitions.filter(comp => {
    const matchesTab = activeTab.value === "all" || comp.status === activeTab.value
    const matchesSearch = comp.title.toLowerCase().includes(searchQuery.value.toLowerCase())
    return matchesTab && matchesSearch
  })
})

const hotCompetitions = computed(() => competitions.filter(c => c.isHot && c.status !== "ended"))

function goBack() { uni.navigateBack() }
function goTo(url: string) { uni.navigateTo({ url }) }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
