<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- Header -->
    <view class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5] flex items-center px-4 h-12 gap-3">
      <view @click="goBack" class="p-1">
        <text class="text-[#2C2C2C] text-lg">←</text>
      </view>
      <text class="text-base font-semibold text-[#2C2C2C] flex-1">圈子活动</text>
      <text class="text-[#999]">📅</text>
    </view>

    <!-- Filter tabs -->
    <view class="flex gap-2 px-4 pt-4 pb-2 overflow-x-auto">
      <view
        v-for="f in filterOptions"
        :key="f.value"
        @click="currentFilter = f.value"
        :class="[
          'px-3 py-1.5 rounded-full text-sm font-medium whitespace-nowrap transition-colors',
          currentFilter === f.value ? 'bg-[#C41E3A] text-white' : 'bg-[#F0EBE5] text-[#2C2C2C]'
        ]"
      >
        <text>{{ f.label }}</text>
      </view>
    </view>

    <!-- Activity list -->
    <view class="px-4 pb-20 space-y-4 pt-2">
      <view v-if="filtered.length === 0" class="text-center py-16 text-[#999] text-sm">
        <text>暂无活动</text>
      </view>
      <view v-for="act in filtered" :key="act.id" class="bg-white border border-[#E8E0D5] rounded-xl overflow-hidden">
        <view class="relative">
          <image :src="act.cover" mode="aspectFill" class="w-full h-40 object-cover" />
          <text
            :class="[
              'absolute top-3 left-3 text-xs font-medium px-2 py-1 rounded-full',
              STATUS_CFG[act.status].className
            ]"
          >{{ STATUS_CFG[act.status].label }}</text>
        </view>
        <view class="p-4">
          <text class="font-semibold text-[#2C2C2C] mb-1 block">{{ act.title }}</text>
          <text class="text-xs text-[#C41E3A] mb-3 block">{{ act.circleName }}</text>
          <view class="space-y-1.5 text-xs text-[#999] mb-4">
            <view class="flex items-center gap-1.5">
              <text class="flex-shrink-0">🕐</text>
              <text>{{ act.startTime }} – {{ act.endTime.split(' ')[1] }}</text>
            </view>
            <view class="flex items-center gap-1.5">
              <text class="flex-shrink-0">📍</text>
              <text>{{ act.location }}</text>
            </view>
            <view class="flex items-center gap-1.5">
              <text class="flex-shrink-0">👥</text>
              <text>{{ act.participants }} / {{ act.maxParticipants }} 人参与</text>
              <view class="flex-1 h-1 bg-[#F0EBE5] rounded-full overflow-hidden ml-1">
                <view
                  class="h-full bg-[#C41E3A] rounded-full"
                  :style="{ width: (act.participants / act.maxParticipants) * 100 + '%' }"
                />
              </view>
            </view>
          </view>
          <view v-if="act.status !== 'ended'">
            <view
              v-if="act.joined"
              class="text-center text-sm text-green-600 font-medium py-2"
            ><text>已报名</text></view>
            <view
              v-else
              @click="join(act.id)"
              :class="[
                'w-full text-center py-2 rounded-lg text-sm font-medium',
                act.participants >= act.maxParticipants
                  ? 'bg-[#F0EBE5] text-[#999]'
                  : 'bg-[#C41E3A] text-white'
              ]"
            >
              <text>{{ act.participants >= act.maxParticipants ? '名额已满' : '立即报名' }}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

type ActivityStatus = 'upcoming' | 'ongoing' | 'ended'

interface Activity {
  id: string
  title: string
  cover: string
  circleName: string
  startTime: string
  endTime: string
  location: string
  participants: number
  maxParticipants: number
  status: ActivityStatus
  joined: boolean
}

const STATUS_CFG: Record<ActivityStatus, { label: string; className: string }> = {
  upcoming: { label: '即将开始', className: 'bg-blue-100 text-blue-700' },
  ongoing:  { label: '进行中',   className: 'bg-green-100 text-green-700' },
  ended:    { label: '已结束',   className: 'bg-[#F0EBE5] text-[#999]' },
}

const filterOptions = [
  { value: 'all', label: '全部' },
  { value: 'upcoming', label: '即将开始' },
  { value: 'ongoing', label: '进行中' },
  { value: 'ended', label: '已结束' },
] as const

const mockActivities: Activity[] = [
  {
    id: '1',
    title: '八字命理研讨会·春季场',
    cover: 'https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=600&h=300&fit=crop',
    circleName: '八字命理研习社',
    startTime: '2024-02-15 14:00',
    endTime: '2024-02-15 17:00',
    location: '线上直播',
    participants: 128,
    maxParticipants: 200,
    status: 'upcoming',
    joined: false,
  },
  {
    id: '2',
    title: '易经与现代决策应用讲座',
    cover: 'https://images.unsplash.com/photo-1591115765373-5207764f72e7?w=600&h=300&fit=crop',
    circleName: '易经研究会',
    startTime: '2024-01-20 19:00',
    endTime: '2024-01-20 21:00',
    location: '腾讯会议',
    participants: 89,
    maxParticipants: 100,
    status: 'ongoing',
    joined: true,
  },
  {
    id: '3',
    title: '紫微斗数入门公开课',
    cover: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600&h=300&fit=crop',
    circleName: '紫微斗数学院',
    startTime: '2024-01-15 10:00',
    endTime: '2024-01-15 12:00',
    location: '线上直播',
    participants: 256,
    maxParticipants: 256,
    status: 'ended',
    joined: true,
  },
  {
    id: '4',
    title: '风水堪舆实地考察活动',
    cover: 'https://images.unsplash.com/photo-1501854140801-50d01698950b?w=600&h=300&fit=crop',
    circleName: '风水堪舆交流',
    startTime: '2024-02-20 09:00',
    endTime: '2024-02-20 18:00',
    location: '上海 · 古镇',
    participants: 24,
    maxParticipants: 30,
    status: 'upcoming',
    joined: false,
  },
]

const currentFilter = ref<'all' | ActivityStatus>('all')
const activities = ref(mockActivities)

const filtered = computed(() => {
  if (currentFilter.value === 'all') return activities.value
  return activities.value.filter(a => a.status === currentFilter.value)
})

function join(id: string) {
  const target = activities.value.find(a => a.id === id)
  if (!target || target.participants >= target.maxParticipants) return
  activities.value = activities.value.map(a =>
    a.id === id ? { ...a, joined: true, participants: a.participants + 1 } : a
  )
}

function goBack() {
  uni.navigateBack()
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
