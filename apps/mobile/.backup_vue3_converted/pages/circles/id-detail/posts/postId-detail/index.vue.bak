          :placeholder="replyTo ? '回复 ' + replyTo.author.name + '...' : '写评论...'"
          class="flex-1 h-10 px-4 bg-[#F5F0E8] rounded-full text-[14px] outline-none" />
        <view @click="handleSubmitComment"
          :class="['w-10 h-10 rounded-full flex items-center justify-center transition-colors', commentText.trim() ? 'bg-[#C41E3A] text-white' : 'bg-[#E8E0D5] text-[#999]']">
          <text class="text-lg">➤</text>
        </view>
      </view>
