<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- 顶部导航 -->
    <view class="flex items-center justify-between px-4 h-12 bg-white border-b border-[#E8E0D5] flex-shrink-0">
      <view class="p-1" @click="goBack">
        <text class="text-xl text-[#2C2C2C]">←</text>
      </view>
      <text class="text-base font-semibold text-[#2C2C2C]">知识库</text>
      <view class="px-3 py-1.5 bg-[#C41E3A] text-white text-xs font-medium rounded-lg" @click="goCreate">
        <text>+ 新建</text>
      </view>
    </view>

    <!-- 搜索栏 -->
    <view class="px-4 py-3 bg-white border-b border-[#E8E0D5]">
      <view class="relative">
        <text class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-[#999]">🔍</text>
        <input
          v-model="keyword"
          type="text"
          placeholder="搜索知识库"
          class="w-full h-9 pl-9 pr-3 bg-[#FAF8F5] rounded-lg text-sm focus:outline-none"
          @confirm="handleSearch"
        />
      </view>
    </view>

    <!-- 加载骨架屏 -->
    <view v-if="loading" class="flex-1 p-4 space-y-3">
      <view v-for="i in 4" :key="i" class="bg-white rounded-xl p-4 shadow-sm">
        <view class="flex items-start justify-between gap-3">
          <view class="flex-1 space-y-2">
            <view class="h-4 w-3/4 bg-[#F0EBE5] rounded animate-pulse" />
            <view class="h-3 w-full bg-[#F0EBE5] rounded animate-pulse" />
            <view class="h-3 w-1/2 bg-[#F0EBE5] rounded animate-pulse" />
          </view>
        </view>
      </view>
    </view>

    <!-- 分类Tab和内容 -->
    <view v-else class="flex-1 flex flex-col">
      <!-- 分类Tab -->
      <view class="flex bg-white border-b border-[#E8E0D5] overflow-x-auto">
        <view
          v-for="t in tabs"
          :key="t.id"
          class="flex-shrink-0 px-4 py-2.5 text-center text-sm font-medium transition-colors"
          :class="activeTab === t.id ? 'text-[#C41E3A] border-b-2 border-[#C41E3A]' : 'text-[#999]'"
          @click="activeTab = t.id"
        >
          <text>{{ t.label }}</text>
          <text class="ml-1 text-xs opacity-70">({{ t.count }})</text>
        </view>
      </view>

      <scroll-view scroll-y class="flex-1 p-4" refresher-enabled @refresherrefresh="onRefresh">
        <!-- 知识统计 -->
        <view v-if="activeTab === 'all'" class="bg-gradient-to-r from-[#C41E3A]/5 to-[#C9A96E]/5 rounded-xl p-3 border border-[#C41E3A]/10 mb-4">
          <view class="flex items-center justify-between">
            <view class="flex items-center gap-2">
              <text class="text-lg">📊</text>
              <text class="text-xs font-medium text-[#2C2C2C]">知识库统计</text>
            </view>
          </view>
          <view class="flex gap-4 mt-2">
            <view class="flex-1 text-center">
              <text class="text-lg font-bold text-[#C41E3A] block">{{ totalViews }}</text>
              <text class="text-[10px] text-[#999]">总阅读</text>
            </view>
            <view class="w-px bg-[#E8E0D5]" />
            <view class="flex-1 text-center">
              <text class="text-lg font-bold text-[#2C2C2C] block">{{ knowledge.length }}</text>
              <text class="text-[10px] text-[#999]">总条目</text>
            </view>
            <view class="w-px bg-[#E8E0D5]" />
            <view class="flex-1 text-center">
              <text class="text-lg font-bold text-green-500 block">{{ confirmedCount }}</text>
              <text class="text-[10px] text-[#999]">已收录</text>
            </view>
          </view>
        </view>

        <!-- 最近浏览 -->
        <view v-if="activeTab === 'all' && recentViews.length > 0" class="mb-4">
          <view class="flex items-center justify-between mb-2">
            <text class="text-xs font-semibold text-[#999]">最近浏览</text>
            <text class="text-[10px] text-[#C41E3A]">清除</text>
          </view>
          <scroll-view scroll-x class="flex gap-2 whitespace-nowrap">
            <view
              v-for="rv in recentViews"
              :key="rv.id"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white rounded-full border border-[#E8E0D5] text-xs"
            >
              <text>📖</text>
              <text class="text-[#2C2C2C]">{{ rv.title }}</text>
            </view>
          </scroll-view>
        </view>

        <!-- 知识列表 -->
        <view v-if="filteredKnowledge.length > 0" class="space-y-3">
          <view
            v-for="k in filteredKnowledge"
            :key="k.id"
            class="bg-white rounded-xl p-4 shadow-sm border border-[#E8E0D5]/50"
            @click="goDetail(k.id)"
          >
            <view class="flex items-start justify-between gap-3">
              <view class="flex-1">
                <view class="flex items-center gap-2 mb-1">
                  <text class="text-sm font-medium text-[#2C2C2C] line-clamp-1">{{ k.title }}</text>
                  <text
                    class="text-[10px] px-1.5 py-0.5 rounded-full flex-shrink-0"
                    :class="k.status === 'confirmed' ? 'bg-green-50 text-green-600 border border-green-200' : 'bg-orange-50 text-orange-500 border border-orange-200'"
                  >{{ k.statusLabel }}</text>
                </view>
                <text class="text-[12px] text-[#555] line-clamp-2 block mb-2">{{ k.summary }}</text>
                <view v-if="k.tags && k.tags.length > 0" class="flex flex-wrap gap-1.5 mt-2">
                  <text v-for="(tag, idx) in k.tags.slice(0, 3)" :key="idx" class="text-[10px] px-2 py-0.5 bg-[#FAF8F5] text-[#666] rounded-full">#{{ tag }}</text>
                  <text v-if="k.tags.length > 3" class="text-[10px] text-[#999]">+{{ k.tags.length - 3 }}</text>
                </view>
                <view class="flex items-center gap-3 text-[11px] text-[#999] flex-wrap">
                  <text>📂 {{ k.category }}</text>
                  <text>👁 {{ k.views }}次阅读</text>
                  <text>🕐 {{ k.updatedAt }}</text>
                  <text>📄 {{ k.source || '知识库' }}</text>
                </view>
              </view>
            </view>
            <view v-if="k.status === 'pending'" class="mt-3 pt-3 border-t border-[#F5F0E8] flex items-center gap-3">
              <view class="flex-1 py-2 bg-[#C41E3A] text-white text-xs text-center rounded-lg" @click.stop="confirmItem(k.id)">
                确认收录
              </view>
              <view class="flex-1 py-2 bg-[#FAF8F5] text-[#999] text-xs text-center rounded-lg border border-[#E8E0D5]" @click.stop="ignoreItem(k.id)">
                忽略
              </view>
            </view>
          </view>
        </view>

        <!-- 空状态 -->
        <view v-else class="flex flex-col items-center justify-center py-20">
          <view class="w-20 h-20 rounded-full bg-[#F5F1EB] flex items-center justify-center mb-4">
            <text class="text-4xl text-[#999]/50">📚</text>
          </view>
          <text class="text-[#999] text-sm mb-2">
            {{ keyword ? '未找到相关文档' : activeTab === 'confirmed' ? '知识库为空' : '暂无待确认的知识条目' }}
          </text>
          <text v-if="!keyword" class="text-[10px] text-[#999] mb-4">点击右上角「新建」开始创建知识条目</text>
          <view v-if="keyword" class="px-4 py-1.5 border border-[#E8E0D5] rounded-full text-xs text-[#2C2C2C]" @click="keyword = ''">
            清除搜索
          </view>
        </view>
        <view class="h-4" />
      </scroll-view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

interface KnowledgeItem {
  id: string
  title: string
  summary: string
  category: string
  views: number
  status: 'confirmed' | 'pending' | 'ignored'
  statusLabel: string
  updatedAt: string
  tags: string[]
  source: string
}

interface RecentView {
  id: string
  title: string
}

// 加载状态
const loading = ref(true)
setTimeout(() => { loading.value = false }, 600)

const keyword = ref('')
const activeTab = ref('all')

// 最近浏览
const recentViews = ref<RecentView[]>([
  { id: 'r1', title: '易经乾卦解读' },
  { id: 'r2', title: '八字排盘基础' },
  { id: 'r3', title: '紫微斗数十二宫位含义' },
])

// 知识数据
const knowledge = ref<KnowledgeItem[]>([
  { id: '1', title: '易经乾卦解读', summary: '乾卦是易经六十四卦之首，象征天、创造、刚健。卦辞为"元亨利贞"，六爻皆阳，代表纯阳至刚之势。', category: '易经', views: 1280, status: 'confirmed', statusLabel: '已收录', updatedAt: '2024-06-01', tags: ['易经', '八卦', '乾卦'], source: '周易正义' },
  { id: '2', title: '八字排盘基础', summary: '八字排盘是命理学的基础，需要准确知道出生年、月、日、时。四柱各含天干地支，组合成八个字。', category: '八字', views: 960, status: 'confirmed', statusLabel: '已收录', updatedAt: '2024-06-05', tags: ['八字', '排盘', '命理'], source: '子平真诠' },
  { id: '3', title: '紫微斗数十二宫位含义', summary: '紫微斗数命盘分为十二宫位，每个宫位代表不同的人生领域。命宫、兄弟宫、夫妻宫、子女宫、财帛宫等。', category: '紫微斗数', views: 860, status: 'confirmed', statusLabel: '已收录', updatedAt: '2024-06-08', tags: ['紫微斗数', '宫位', '命盘'], source: '紫微斗数全书' },
  { id: '4', title: '风水基础知识入门', summary: '风水学是中国传统环境学说，强调人与自然的和谐共处。阳宅风水关注居住环境的布局和气场流动。', category: '风水', views: 45, status: 'pending', statusLabel: '待确认', updatedAt: '2024-06-10', tags: ['风水', '阳宅', '布局'], source: '知识库' },
  { id: '5', title: '梅花易数起卦方法', summary: '梅花易数起卦方式多样，可用时间、数字、物象等多种方式起卦。起卦灵活，占断迅捷，为心易之宗。', category: '梅花易数', views: 12, status: 'pending', statusLabel: '待确认', updatedAt: '2024-06-10', tags: ['梅花易数', '起卦'], source: '梅花易数' },
  { id: '6', title: '奇门遁甲八门口诀', summary: '奇门遁甲八门分别为：休门、生门、伤门、杜门、景门、死门、惊门、开门。各门吉凶不同。', category: '奇门遁甲', views: 320, status: 'confirmed', statusLabel: '已收录', updatedAt: '2024-06-07', tags: ['奇门遁甲', '八门', '吉凶'], source: '奇门遁甲秘笈' },
  { id: '7', title: '六十四卦序卦传解读', summary: '序卦传是《易传》之一，阐述六十四卦的排列顺序及其内在逻辑关系，揭示了事物发展的规律。', category: '易经', views: 210, status: 'pending', statusLabel: '待确认', updatedAt: '2024-06-09', tags: ['易经', '序卦传', '卦序'], source: '周易正义' },
  { id: '8', title: '六爻预测起卦方法', summary: '六爻预测以三枚铜钱为工具，通过摇卦确定卦象，以动爻为核心分析吉凶祸福。', category: '六爻', views: 175, status: 'confirmed', statusLabel: '已收录', updatedAt: '2024-06-06', tags: ['六爻', '起卦', '铜钱'], source: '卜筮正宗' },
  { id: '9', title: '面相基础：十二宫解析', summary: '面相学将面部划分为十二个宫位，分别对应不同的人生运势和性格特点。', category: '相学', views: 95, status: 'pending', statusLabel: '待确认', updatedAt: '2024-06-04', tags: ['相学', '面相', '十二宫'], source: '知识库' },
])

const totalViews = computed(() => knowledge.value.reduce((s, k) => s + k.views, 0))
const confirmedCount = computed(() => knowledge.value.filter(k => k.status === 'confirmed').length)

const tabs = computed(() => [
  { id: 'all', label: '全部', count: knowledge.value.length },
  { id: 'confirmed', label: '已收录', count: knowledge.value.filter(k => k.status === 'confirmed').length },
  { id: 'pending', label: '待确认', count: knowledge.value.filter(k => k.status === 'pending').length },
])

const filteredKnowledge = computed(() => {
  let result = knowledge.value
  if (activeTab.value === 'confirmed') {
    result = result.filter(k => k.status === 'confirmed')
  } else if (activeTab.value === 'pending') {
    result = result.filter(k => k.status === 'pending')
  }
  if (keyword.value.trim()) {
    const kw = keyword.value.trim().toLowerCase()
    result = result.filter(k =>
      k.title.toLowerCase().includes(kw) ||
      k.summary.toLowerCase().includes(kw) ||
      k.category.toLowerCase().includes(kw)
    )
  }
  return result
})

function onRefresh() {
  setTimeout(() => {
    uni.stopPullDownRefresh()
  }, 500)
}

function goBack() { uni.navigateBack() }
function goCreate() { uni.navigateTo({ url: '/pages/circles/id-detail/knowledge/create/index' }) }
function goDetail(id: string) { uni.navigateTo({ url: `/pages/circles/id-detail/knowledge/detail?id=${id}` }) }
function handleSearch() {}

function confirmItem(id: string) {
  const k = knowledge.value.find(k => k.id === id)
  if (k) { k.status = 'confirmed'; k.statusLabel = '已收录' }
  uni.showToast({ title: '已收录到知识库', icon: 'success' })
}

function ignoreItem(id: string) {
  knowledge.value = knowledge.value.filter(k => k.id !== id)
  uni.showToast({ title: '已忽略', icon: 'none' })
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
