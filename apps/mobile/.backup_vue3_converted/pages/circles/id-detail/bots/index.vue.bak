<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- Header -->
    <view class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 h-14">
        <view @click="goBack" class="p-2 -ml-2">
          <text class="text-2xl text-[#2C2C2C]">←</text>
        </view>
        <text class="text-lg font-semibold text-[#2C2C2C]">圈子智能体</text>
        <view v-if="isAdmin" @click="manageBots" class="p-2 -mr-2">
          <text class="text-xl text-[#666666]">⚙</text>
        </view>
        <view v-else class="w-8" />
      </view>
    </view>

    <!-- Circle Info -->
    <view v-if="circle" class="px-4 py-3 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center gap-3">
        <image :src="circle.cover" mode="aspectFill" class="w-12 h-12 rounded-xl" />
        <view class="flex-1 min-w-0">
          <text class="font-semibold text-[#2C2C2C] truncate block">{{ circle.name }}</text>
          <text class="text-xs text-[#999999]">{{ formatNumber(circle.members) }} 成员 · {{ bots.length }} 个智能体</text>
        </view>
      </view>
    </view>

    <!-- Search -->
    <view class="px-4 py-3">
      <view class="relative">
        <text class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-[#999999]">🔍</text>
        <input
          type="text"
          placeholder="搜索智能体..."
          v-model="searchQuery"
          class="w-full pl-10 pr-4 py-2.5 bg-white border border-[#E8E0D5] rounded-full text-sm text-[#2C2C2C] placeholder:text-[#999999] focus:outline-none focus:border-[#C41E3A]"
        />
      </view>
    </view>

    <!-- Bots Grid -->
    <view class="px-4 pb-24">
      <!-- Loading -->
      <view v-if="loading" class="grid grid-cols-1 gap-3">
        <view v-for="i in 4" :key="i" class="bg-white rounded-2xl p-4 animate-pulse">
          <view class="flex items-start gap-3">
            <view class="w-14 h-14 rounded-xl bg-[#E8E0D5]" />
            <view class="flex-1">
              <view class="h-4 bg-[#E8E0D5] rounded w-24 mb-2" />
              <view class="h-3 bg-[#E8E0D5] rounded w-full mb-1" />
              <view class="h-3 bg-[#E8E0D5] rounded w-3/4" />
            </view>
          </view>
          <view class="flex items-center justify-between mt-3 pt-3 border-t border-[#E8E0D5]">
            <view class="h-3 bg-[#E8E0D5] rounded w-20" />
            <view class="h-8 bg-[#E8E0D5] rounded-full w-16" />
          </view>
        </view>
      </view>

      <!-- Empty -->
      <view v-else-if="filteredBots.length === 0" class="flex flex-col items-center justify-center py-20">
        <view class="w-20 h-20 rounded-full bg-[#E8E0D5] flex items-center justify-center mb-4">
          <text class="text-2xl text-[#999999]">🤖</text>
        </view>
        <text class="text-[#666666] mb-2">{{ searchQuery ? '未找到相关智能体' : '暂无智能体' }}</text>
        <view v-if="isAdmin && !searchQuery" @click="createBot" class="mt-4 px-6 py-2.5 bg-[#C41E3A] text-white rounded-full text-sm font-medium">
          创建智能体
        </view>
      </view>

      <!-- List -->
      <view v-else class="grid grid-cols-1 gap-3">
        <view v-for="bot in filteredBots" :key="bot.id" @click="goBot(bot.id)" class="bg-white rounded-2xl p-4 active:scale-[0.98] transition-transform shadow-sm">
          <view class="flex items-start gap-3">
            <view class="relative">
              <image :src="bot.avatar" mode="aspectFill" class="w-14 h-14 rounded-xl" />
              <view v-if="bot.isOfficial" class="absolute -top-1 -right-1 w-5 h-5 bg-[#C41E3A] rounded-full flex items-center justify-center">
                <text class="text-white text-xs">✨</text>
              </view>
            </view>
            <view class="flex-1 min-w-0">
              <view class="flex items-center gap-2">
                <text class="font-semibold text-[#2C2C2C] truncate">{{ bot.name }}</text>
                <text class="px-2 py-0.5 bg-[#FAF8F5] text-[#999999] text-xs rounded-full shrink-0">{{ bot.category }}</text>
              </view>
              <text class="text-sm text-[#666666] mt-1 line-clamp-2">{{ bot.description }}</text>
            </view>
          </view>
          <view class="flex items-center justify-between mt-3 pt-3 border-t border-[#E8E0D5]">
            <view class="flex items-center gap-4 text-xs text-[#999999]">
              <text class="flex items-center gap-1">💬 {{ formatNumber(bot.chats) }}</text>
              <text class="flex items-center gap-1">❤️ {{ formatNumber(bot.likes) }}</text>
            </view>
            <view @click.stop="goBot(bot.id)" class="px-4 py-1.5 bg-[#C41E3A] text-white text-xs rounded-full font-medium">
              对话
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Create Bot FAB (Admin only) -->
    <view v-if="isAdmin && !loading && bots.length > 0" @click="createBot" class="fixed bottom-24 right-4 w-14 h-14 bg-[#C41E3A] rounded-full shadow-lg flex items-center justify-center active:scale-95 transition-transform">
      <text class="text-2xl text-white">✚</text>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

interface Bot {
  id: string
  name: string
  avatar: string
  description: string
  category: string
  chats: number
  likes: number
  isOfficial: boolean
  createdAt: string
}

interface Circle {
  id: string
  name: string
  cover: string
  description: string
  category: string
  members: number
  posts: number
  isJoined: boolean
  createdAt: string
  owner: { id: string; name: string; avatar: string }
  tags: string[]
}

// Mock data
const mockCircle: Circle = {
  id: '1',
  name: '周易研习社',
  cover: '/placeholder.svg?height=200&width=400',
  description: '传承易学精髓，探索宇宙奥秘',
  category: '易经',
  members: 12800,
  posts: 3560,
  isJoined: true,
  createdAt: '2024-01-01',
  owner: { id: '1', name: '周易大师', avatar: '/placeholder.svg?height=48&width=48' },
  tags: ['周易', '八卦', '风水'],
}

const mockBots: Bot[] = [
  { id: '1', name: '周易解卦助手', avatar: '/placeholder.svg?height=80&width=80', description: '专业解读六十四卦，帮助您理解卦象含义与人生指引', category: '占卜解读', chats: 12580, likes: 3420, isOfficial: true, createdAt: '2024-01-15' },
  { id: '2', name: '风水顾问', avatar: '/placeholder.svg?height=80&width=80', description: '提供家居风水布局建议，助您打造和谐居住环境', category: '风水堪舆', chats: 8960, likes: 2180, isOfficial: true, createdAt: '2024-02-01' },
  { id: '3', name: '八字命理分析', avatar: '/placeholder.svg?height=80&width=80', description: '根据生辰八字分析命理运势，提供人生建议', category: '命理分析', chats: 15620, likes: 4890, isOfficial: false, createdAt: '2024-02-15' },
  { id: '4', name: '易经学习导师', avatar: '/placeholder.svg?height=80&width=80', description: '系统讲解易经知识，从入门到精通的学习伴侣', category: '学习辅导', chats: 6780, likes: 1560, isOfficial: false, createdAt: '2024-03-01' },
]

const circle = ref<Circle | null>(null)
const bots = ref<Bot[]>([])
const loading = ref(true)
const searchQuery = ref('')
const isAdmin = ref(true)

onMounted(async () => {
  loading.value = true
  try {
    const [circleRes, botsRes] = await Promise.all([
      Promise.resolve(mockCircle),
      Promise.resolve(mockBots),
    ])
    circle.value = circleRes as Circle
    bots.value = botsRes as Bot[]
  } catch {
    circle.value = mockCircle
    bots.value = mockBots
  } finally {
    loading.value = false
  }
})

const filteredBots = computed(() =>
  bots.value.filter((bot) =>
    bot.name.toLowerCase().includes(searchQuery.value.toLowerCase()) ||
    bot.description.toLowerCase().includes(searchQuery.value.toLowerCase()) ||
    bot.category.toLowerCase().includes(searchQuery.value.toLowerCase())
  )
)

function formatNumber(num: number): string {
  if (num >= 10000) return (num / 10000).toFixed(1) + '万'
  if (num >= 1000) return (num / 1000).toFixed(1) + 'k'
  return num.toString()
}

function goBack() { uni.navigateBack() }
function goBot(id: string) { uni.navigateTo({ url: `/pages/bot/index?id=${id}` }) }
function manageBots() { /* router.push(`/circles/${circleId}/bots/manage`) */ }
function createBot() { /* router.push(`/circles/${circleId}/bots/create`) */ }
</script>
<style scoped>/* 样式由 Tailwind 处理 */</style>