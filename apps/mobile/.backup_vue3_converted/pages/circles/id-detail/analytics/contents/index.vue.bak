<script setup lang="ts">
import { ref } from 'vue'

const loading = ref(true)
const trendType = ref('view')
const hotSort = ref('view')
const selectedRange = ref('本月')

const dateRanges = ['本周', '本月', '本季度', '本年']

const stats = ref({
  totalPosts: 128,
  newThisMonth: 23,
  dailyAvg: 3.8,
  totalViews: 15680,
  totalInteractions: 2345,
  postTrend: 12.5
})

const trendData = ref([
  { label: '1月', value: 156, pct: 80, highlight: false },
  { label: '2月', value: 182, pct: 95, highlight: false },
  { label: '3月', value: 210, pct: 110, highlight: false },
  { label: '4月', value: 195, pct: 100, highlight: false },
  { label: '5月', value: 228, pct: 118, highlight: true },
  { label: '6月', value: 145, pct: 75, highlight: false },
  { label: '7月', value: 178, pct: 92, highlight: false },
  { label: '8月', value: 165, pct: 85, highlight: false },
  { label: '9月', value: 195, pct: 100, highlight: false },
  { label: '10月', value: 220, pct: 113, highlight: false },
