<template>
  <view class="min-h-screen bg-[#1A1A1A]">
    <!-- 顶部导航 -->
    <header class="sticky top-0 z-50 bg-[#1A1A1A]/95 backdrop-blur-lg" style="border-bottom:1px solid rgba(255,255,255,0.1)">
      <view class="flex items-center h-14 px-4">
        <view @click="goBack" class="p-2 -ml-2"><text class="text-xl text-white">←</text></view>
        <text class="flex-1 text-center font-semibold text-white">发布内容</text>
        <view class="w-9" />
      </view>
    </header>

    <view class="p-4 space-y-4">
      <!-- 圈子信息 -->
      <view class="p-4 rounded-2xl" style="background:#1A1A1A">
        <view class="flex items-center gap-3">
          <image :src="circle.avatar || placeholderAvatar" mode="aspectFill" class="w-12 h-12 rounded-xl" />
          <view class="flex-1">
            <text class="font-medium text-white block">{{ circle.name }}</text>
            <text class="text-xs text-white/50">{{ circle.members.toLocaleString() }} 成员</text>
          </view>
          <text class="text-xs px-2 py-1 rounded" :class="circle.role === 'owner' ? 'bg-[#C9A96E]/20 text-[#C9A96E]' : 'bg-blue-500/20 text-blue-400'">
            {{ circle.role === 'owner' ? '圈主' : '管理员' }}
          </text>
        </view>
      </view>

      <!-- 选择内容类型 -->
      <template v-if="!selectedType">
        <view class="p-4 rounded-2xl" style="background:#1A1A1A">
          <text class="text-sm font-medium text-white block mb-4">选择内容类型</text>
          <view class="space-y-3">
            <view v-for="type in contentTypes" :key="type.id" @click="handleTypeSelect(type)"
              class="w-full p-4 rounded-xl flex items-center gap-4 transition-all active:scale-[0.98]"
              style="border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.05)">
              <view class="w-12 h-12 rounded-xl flex items-center justify-center" style="background:rgba(196,30,58,0.1)">
                <text class="text-2xl text-[#C41E3A]">{{ type.icon }}</text>
              </view>
              <view class="flex-1">
                <text class="font-medium text-white block">{{ type.name }}</text>
                <text class="text-xs text-white/50 mt-0.5 block">{{ type.description }}</text>
              </view>
              <text class="text-white/30">›</text>
            </view>
          </view>
        </view>
      </template>

      <!-- 发布文章 -->
      <template v-else-if="selectedType === 'article'">
        <view class="space-y-4">
          <view class="flex items-center justify-between">
            <view @click="selectedType = null" class="text-white/60 text-sm flex items-center gap-1">
              <text>←</text> 返回
            </view>
            <text class="font-medium text-white">发布文章</text>
            <view class="w-12" />
          </view>

          <!-- 封面 -->
          <view class="p-4 rounded-2xl" style="background:#1A1A1A">
            <text class="text-sm font-medium text-white block mb-3">文章封面</text>
            <view @click="handleCoverUpload"
              class="relative aspect-video rounded-xl overflow-hidden flex flex-col items-center justify-center gap-2"
              style="border:2px dashed rgba(255,255,255,0.2);background:rgba(255,255,255,0.05)">
              <template v-if="articleCover">
                <image :src="articleCover" mode="aspectFill" class="absolute inset-0 w-full h-full" />
                <view @click.stop="articleCover = ''" class="absolute top-2 right-2 p-1.5 rounded-full" style="background:rgba(0,0,0,0.5)">
                  <text class="text-white text-xs">✕</text>
                </view>
              </template>
              <template v-else>
                <text class="text-3xl text-white/40">📷</text>
                <text class="text-sm text-white/60">点击上传封面</text>
              </template>
            </view>
          </view>

          <!-- 标题 -->
          <view class="p-4 rounded-2xl" style="background:#1A1A1A">
            <text class="text-sm font-medium text-white block mb-2">
              文章标题 <text class="text-[#C41E3A]">*</text>
            </text>
            <input v-model="articleTitle" type="text" placeholder="请输入文章标题"
              class="w-full px-4 py-3 rounded-xl text-white text-sm"
              :style="{ border: errors.title ? '1px solid #C41E3A' : '1px solid rgba(255,255,255,0.1)', background: 'rgba(255,255,255,0.05)' }" />
            <text v-if="errors.title" class="text-xs text-[#C41E3A] mt-2 block">{{ errors.title }}</text>
          </view>

          <!-- 内容 -->
          <view class="p-4 rounded-2xl" style="background:#1A1A1A">
            <text class="text-sm font-medium text-white block mb-2">
              文章内容 <text class="text-[#C41E3A]">*</text>
            </text>
            <textarea v-model="articleContent" placeholder="请输入文章内容..." rows="8"
              class="w-full px-4 py-3 rounded-xl text-white text-sm resize-none"
              :style="{ border: errors.content ? '1px solid #C41E3A' : '1px solid rgba(255,255,255,0.1)', background: 'rgba(255,255,255,0.05)' }" />
            <text v-if="errors.content" class="text-xs text-[#C41E3A] mt-2 block">{{ errors.content }}</text>
          </view>

          <!-- 可见范围和付费设置 -->
          <view class="p-4 rounded-2xl space-y-4" style="background:#1A1A1A">
            <view>
              <text class="text-sm font-medium text-white block mb-3">可见范围</text>
              <view class="flex gap-2">
                <view v-for="v in visibilityOptions" :key="v.value" @click="articleVisibility = v.value"
                  class="flex-1 py-2 rounded-lg text-center text-xs transition-all"
                  :class="articleVisibility === v.value ? 'bg-[#C41E3A] text-white' : 'text-white/60'" style="background:articleVisibility === v.value ? '#C41E3A' : 'rgba(255,255,255,0.05)'">
                  {{ v.label }}
                </view>
              </view>
            </view>
            <view>
              <text class="text-sm font-medium text-white block mb-3">付费设置</text>
              <view class="flex gap-2">
                <view v-for="p in paymentOptions" :key="p.value" @click="articlePaymentType = p.value"
                  class="flex-1 py-2 rounded-lg text-center text-xs transition-all"
                  :class="articlePaymentType === p.value ? 'bg-[#C41E3A] text-white' : 'text-white/60'" style="background:articlePaymentType === p.value ? '#C41E3A' : 'rgba(255,255,255,0.05)'">
                  {{ p.label }}
                </view>
              </view>
              <input v-if="articlePaymentType === 'paid' || articlePaymentType === 'member_free'" v-model="articlePrice" type="digit" placeholder="设置价格"
                class="w-full mt-2 px-4 py-2 rounded-xl text-white text-sm"
                style="border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.05)" />
              <text v-if="errors.price" class="text-xs text-[#C41E3A] mt-2 block">{{ errors.price }}</text>
            </view>
          </view>

          <!-- 提交按钮 -->
          <view @click="submitArticle"
            class="w-full py-4 rounded-full text-white font-semibold text-center"
            :class="isSubmittingArticle ? 'opacity-50' : ''"
            style="background:linear-gradient(90deg,#C41E3A,#C41E3A)">
            {{ isSubmittingArticle ? '发布中...' : '发布文章' }}
          </view>
        </view>
      </template>

      <!-- 发布课程 -->
      <template v-else-if="selectedType === 'course'">
        <view class="space-y-4">
          <view class="flex items-center justify-between">
            <view @click="selectedType = null" class="text-white/60 text-sm flex items-center gap-1">
              <text>←</text> 返回
            </view>
            <text class="font-medium text-white">发布课程</text>
            <view class="w-12" />
          </view>

          <!-- 封面 -->
          <view class="p-4 rounded-2xl" style="background:#1A1A1A">
            <text class="text-sm font-medium text-white block mb-3">课程封面 <text class="text-[#C41E3A]">*</text></text>
            <view @click="handleCourseCoverUpload"
              class="relative aspect-video rounded-xl overflow-hidden flex flex-col items-center justify-center gap-2"
              style="border:2px dashed rgba(255,255,255,0.2);background:rgba(255,255,255,0.05)">
              <template v-if="courseCover">
                <image :src="courseCover" mode="aspectFill" class="absolute inset-0 w-full h-full" />
                <view @click.stop="courseCover = ''" class="absolute top-2 right-2 p-1.5 rounded-full" style="background:rgba(0,0,0,0.5)">
                  <text class="text-white text-xs">✕</text>
                </view>
              </template>
              <template v-else>
                <text class="text-3xl text-white/40">▶</text>
                <text class="text-sm text-white/60">点击上传封面</text>
              </template>
            </view>
          </view>

          <!-- 名称 -->
          <view class="p-4 rounded-2xl" style="background:#1A1A1A">
            <text class="text-sm font-medium text-white block mb-2">课程名称 <text class="text-[#C41E3A]">*</text></text>
            <input v-model="courseTitle" type="text" placeholder="请输入课程名称"
              class="w-full px-4 py-3 rounded-xl text-white text-sm"
              :style="{ border: errors.courseTitle ? '1px solid #C41E3A' : '1px solid rgba(255,255,255,0.1)', background: 'rgba(255,255,255,0.05)' }" />
            <text v-if="errors.courseTitle" class="text-xs text-[#C41E3A] mt-2 block">{{ errors.courseTitle }}</text>
          </view>

          <!-- 简介 -->
          <view class="p-4 rounded-2xl" style="background:#1A1A1A">
            <text class="text-sm font-medium text-white block mb-2">课程简介 <text class="text-[#C41E3A]">*</text></text>
            <textarea v-model="courseDescription" placeholder="请输入课程简介..." rows="4"
              class="w-full px-4 py-3 rounded-xl text-white text-sm resize-none"
              :style="{ border: errors.courseDescription ? '1px solid #C41E3A' : '1px solid rgba(255,255,255,0.1)', background: 'rgba(255,255,255,0.05)' }" />
            <text v-if="errors.courseDescription" class="text-xs text-[#C41E3A] mt-2 block">{{ errors.courseDescription }}</text>
          </view>

          <!-- 可见范围和付费设置 -->
          <view class="p-4 rounded-2xl space-y-4" style="background:#1A1A1A">
            <view>
              <text class="text-sm font-medium text-white block mb-3">可见范围</text>
              <view class="flex gap-2">
                <view v-for="v in visibilityOptions" :key="v.value" @click="courseVisibility = v.value"
                  class="flex-1 py-2 rounded-lg text-center text-xs transition-all"
                  :class="courseVisibility === v.value ? 'bg-[#C41E3A] text-white' : 'text-white/60'" style="background:courseVisibility === v.value ? '#C41E3A' : 'rgba(255,255,255,0.05)'">
                  {{ v.label }}
                </view>
              </view>
            </view>
            <view>
              <text class="text-sm font-medium text-white block mb-3">付费设置</text>
              <view class="flex gap-2">
                <view v-for="p in paymentOptions" :key="p.value" @click="coursePaymentType = p.value"
                  class="flex-1 py-2 rounded-lg text-center text-xs transition-all"
                  :class="coursePaymentType === p.value ? 'bg-[#C41E3A] text-white' : 'text-white/60'" style="background:coursePaymentType === p.value ? '#C41E3A' : 'rgba(255,255,255,0.05)'">
                  {{ p.label }}
                </view>
              </view>
              <input v-if="coursePaymentType === 'paid' || coursePaymentType === 'member_free'" v-model="coursePrice" type="digit" placeholder="设置价格"
                class="w-full mt-2 px-4 py-2 rounded-xl text-white text-sm"
                style="border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.05)" />
              <text v-if="errors.coursePrice" class="text-xs text-[#C41E3A] mt-2 block">{{ errors.coursePrice }}</text>
            </view>
          </view>

          <!-- 提示 -->
          <view class="p-3 rounded-xl" style="background:rgba(201,169,110,0.1);border:1px solid rgba(201,169,110,0.2)">
            <text class="text-xs" style="color:#C9A96E">课程创建后，可在"课程管理"中上传视频章节、设置目录结构</text>
          </view>

          <!-- 提交按钮 -->
          <view @click="submitCourse"
            class="w-full py-4 rounded-full text-white font-semibold text-center"
            :class="isSubmittingCourse ? 'opacity-50' : ''"
            style="background:linear-gradient(90deg,#C41E3A,#C41E3A)">
            {{ isSubmittingCourse ? '创建中...' : '创建课程' }}
          </view>
        </view>
      </template>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

const placeholderAvatar = 'https://api.dicebear.com/7.x/shapes/svg?seed=circle'

interface CircleInfo {
  id: string; name: string; avatar: string; members: number; role: string
}

interface ContentType {
  id: string; name: string; icon: string; description: string
}

const contentTypes: ContentType[] = [
  { id: 'article', name: '文章', icon: '📄', description: '发布图文内容' },
  { id: 'course', name: '课程', icon: '📚', description: '上传视频课程' },
  { id: 'live', name: '直播', icon: '📡', description: '发起在线直播' },
]

const visibilityOptions = [
  { value: 'platform_wide', label: '平台可见' },
  { value: 'circle_only', label: '仅圈内' },
  { value: 'member_only', label: '仅成员' },
]

const paymentOptions = [
  { value: 'free', label: '免费' },
  { value: 'paid', label: '付费' },
  { value: 'member_free', label: '会员免费' },
]

const circle = ref<CircleInfo>({
  id: '1', name: '八字命理研习社', avatar: '',
  members: 1280, role: 'owner',
})

const selectedType = ref<string | null>(null)

// Article form
const articleTitle = ref('')
const articleContent = ref('')
const articleCover = ref('')
const articleVisibility = ref('platform_wide')
const articlePaymentType = ref('free')
const articlePrice = ref('')
const isSubmittingArticle = ref(false)

// Course form
const courseTitle = ref('')
const courseDescription = ref('')
const courseCover = ref('')
const courseVisibility = ref('platform_wide')
const coursePaymentType = ref('paid')
const coursePrice = ref(99)
const isSubmittingCourse = ref(false)

const errors = ref<Record<string, string>>({})

function handleTypeSelect(type: ContentType) {
  if (type.id === 'live') {
    uni.navigateTo({ url: `/pages/live/create?circleId=${circle.value.id}` })
  } else {
    selectedType.value = type.id
  }
}

function handleCoverUpload() {
  articleCover.value = 'https://images.unsplash.com/photo-1516979187457-637abb4f9353?w=800&h=450&fit=crop'
}

function handleCourseCoverUpload() {
  courseCover.value = 'https://images.unsplash.com/photo-1516979187457-637abb4f9353?w=800&h=450&fit=crop'
}

async function submitArticle() {
  errors.value = {}
  if (!articleTitle.value.trim()) errors.value.title = '请输入文章标题'
  if (!articleContent.value.trim()) errors.value.content = '请输入文章内容'
  if ((articlePaymentType.value === 'paid' || articlePaymentType.value === 'member_free') && (!articlePrice.value || parseFloat(articlePrice.value) <= 0)) {
    errors.value.price = '请设置价格'
  }

  if (Object.keys(errors.value).length > 0) return

  isSubmittingArticle.value = true
  await new Promise(resolve => setTimeout(resolve, 1000))
  isSubmittingArticle.value = false
  uni.showToast({ title: '发布成功', icon: 'success' })
  setTimeout(() => goBack(), 500)
}

async function submitCourse() {
  errors.value = {}
  if (!courseTitle.value.trim()) errors.value.courseTitle = '请输入课程名称'
  if (!courseDescription.value.trim()) errors.value.courseDescription = '请输入课程简介'
  if ((coursePaymentType.value === 'paid' || coursePaymentType.value === 'member_free') && coursePrice.value <= 0) {
    errors.value.coursePrice = '请设置价格'
  }

  if (Object.keys(errors.value).length > 0) return

  isSubmittingCourse.value = true
  await new Promise(resolve => setTimeout(resolve, 1000))
  isSubmittingCourse.value = false
  uni.showToast({ title: '创建成功', icon: 'success' })
  setTimeout(() => goBack(), 500)
}

function goBack() { uni.navigateBack() }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
