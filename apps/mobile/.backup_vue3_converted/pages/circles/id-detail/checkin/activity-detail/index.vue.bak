<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-24">
    <!-- 顶部封面 -->
    <view class="relative h-52">
      <image :src="activity.cover" mode="aspectFill" class="w-full h-full" />
      <view class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent" />

      <!-- 导航 -->
      <view class="absolute top-0 left-0 right-0 p-4 flex items-center justify-between">
        <view @click="goBack" class="w-9 h-9 rounded-full bg-black/30 flex items-center justify-center" style="backdrop-filter: blur(4px);">
          <text class="text-white text-lg">←</text>
        </view>
        <view class="w-9 h-9 rounded-full bg-black/30 flex items-center justify-center" style="backdrop-filter: blur(4px);">
          <text class="text-white">🔗</text>
        </view>
      </view>

      <!-- 活动信息 -->
      <view class="absolute bottom-0 left-0 right-0 p-4">
        <view class="flex items-center gap-2 mb-2">
          <text class="px-2 py-0.5 bg-[#52C41A] text-white text-[10px] rounded-full">进行中</text>
          <text class="text-white/80 text-xs">Day {{ activity.currentDay }}/{{ activity.totalDays }}</text>
        </view>
        <text class="text-white text-xl font-bold block mb-1">{{ activity.title }}</text>
        <text class="text-white/70 text-xs line-clamp-2">{{ activity.description }}</text>
      </view>
    </view>

    <!-- 进度条 -->
    <view class="px-4 py-3 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between mb-2">
        <text class="text-xs text-[#666]">活动进度</text>
        <text class="text-xs text-[#C41E3A] font-medium">{{ Math.round(progressPercent) }}%</text>
      </view>
      <view class="h-2 bg-[#F5F0E8] rounded-full overflow-hidden">
        <view class="h-full bg-gradient-to-r from-[#C41E3A] to-[#FF6B6B] rounded-full transition-all duration-500" :style="{ width: progressPercent + '%' }" />
      </view>
    </view>

    <!-- 数据统计卡片 -->
    <view class="px-4 py-4">
      <view class="grid grid-cols-4 gap-3">
        <view class="bg-white rounded-xl p-3 text-center shadow-sm">
          <text class="text-xl font-bold text-[#2C2C2C] block">{{ activity.participants }}</text>
          <text class="text-[11px] text-[#999]">参与人数</text>
        </view>
        <view class="bg-white rounded-xl p-3 text-center shadow-sm">
          <text class="text-xl font-bold text-[#52C41A] block">{{ activity.todayCheckedIn }}</text>
          <text class="text-[11px] text-[#999]">今日已打卡</text>
        </view>
        <view class="bg-white rounded-xl p-3 text-center shadow-sm">
          <text class="text-xl font-bold text-[#FF6B35] block">{{ activity.myStreak }}</text>
          <text class="text-[11px] text-[#999]">我的连续</text>
        </view>
        <view class="bg-white rounded-xl p-3 text-center shadow-sm">
          <text class="text-xl font-bold text-[#C41E3A] block">{{ activity.myTotalDays }}</text>
          <text class="text-[11px] text-[#999]">累计打卡</text>
        </view>
      </view>
    </view>

    <!-- 日历视图 -->
    <view class="px-4 pb-4">
      <view class="bg-white rounded-xl p-4 shadow-sm">
        <view class="flex items-center justify-between mb-3">
          <text class="font-medium text-[#2C2C2C]">打卡日历</text>
          <text class="text-xs text-[#999]">{{ activity.startDate }} - {{ activity.endDate }}</text>
        </view>
        <view class="grid grid-cols-7 gap-2">
          <view
            v-for="day in calendarDays" :key="day.day"
            :class="['aspect-square rounded-lg flex items-center justify-center text-xs font-medium transition-all',
              day.isCompleted && !day.isToday ? 'bg-[#52C41A] text-white' : '',
              day.isToday && !activity.hasCheckedToday ? 'bg-[#C41E3A] text-white' : '',
              day.isToday && activity.hasCheckedToday ? 'bg-[#52C41A] text-white' : '',
              day.isFuture ? 'bg-[#F5F0E8] text-[#CCC]' : '',
              !day.isCompleted && !day.isToday && !day.isFuture ? 'bg-[#FFE4E4] text-[#C41E3A]' : '']"
          >
            <text v-if="day.isCompleted">✓</text>
            <text v-else>{{ day.day }}</text>
          </view>
        </view>
        <view class="flex items-center justify-center gap-4 mt-3 pt-3 border-t border-[#F5F0E8]">
          <view class="flex items-center gap-1">
            <view class="w-3 h-3 rounded bg-[#52C41A]" />
            <text class="text-[11px] text-[#999]">已完成</text>
          </view>
          <view class="flex items-center gap-1">
            <view class="w-3 h-3 rounded bg-[#FFE4E4]" />
            <text class="text-[11px] text-[#999]">已错过</text>
          </view>
          <view class="flex items-center gap-1">
            <view class="w-3 h-3 rounded bg-[#F5F0E8]" />
            <text class="text-[11px] text-[#999]">未开始</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Tab切换 -->
    <view class="px-4">
      <view class="flex items-center gap-1 bg-white rounded-xl p-1 shadow-sm">
        <view
          v-for="tab in tabs" :key="tab.id"
          @click="activeTab = tab.id"
          :class="['flex-1 py-2 text-xs font-medium rounded-lg text-center transition-all', activeTab === tab.id ? 'bg-[#C41E3A] text-white' : 'text-[#666]']"
        >
          {{ tab.label }}
        </view>
      </view>
    </view>

    <!-- 内容区 -->
    <view class="px-4 py-4">
      <!-- 今日内容 -->
      <view v-if="activeTab === 'today'" class="space-y-4">
        <view class="bg-white rounded-xl p-4 shadow-sm">
          <view class="flex items-center gap-2 mb-3">
            <text class="text-[#C9A96E]">📖</text>
            <text class="font-medium text-[#2C2C2C]">今日阅读</text>
          </view>
          <text class="text-base font-bold text-[#2C2C2C] block mb-2">{{ todayContent.chapter }}</text>
          <text class="text-xs text-[#666] leading-relaxed block mb-3">{{ todayContent.summary }}</text>
          <view class="bg-[#FAF8F5] rounded-lg p-3">
            <text class="text-xs text-[#999] block mb-2">核心要点</text>
            <view class="space-y-1.5">
              <view v-for="(point, idx) in todayContent.keyPoints" :key="idx" class="flex items-center gap-2">
                <view class="w-1.5 h-1.5 rounded-full bg-[#C41E3A]" />
                <text class="text-xs text-[#2C2C2C]">{{ point }}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 打卡规则 -->
        <view class="bg-white rounded-xl p-4 shadow-sm">
          <view class="flex items-center gap-2 mb-3">
            <text class="text-[#FF6B35]">⭐</text>
            <text class="font-medium text-[#2C2C2C]">打卡规则</text>
          </view>
          <view class="space-y-2">
            <view v-for="(rule, idx) in activity.rules" :key="idx" class="flex items-start gap-2">
              <text class="w-5 h-5 rounded-full bg-[#F5F0E8] text-[11px] text-[#666] flex items-center justify-center flex-shrink-0">{{ idx + 1 }}</text>
              <text class="text-xs text-[#666]">{{ rule }}</text>
            </view>
          </view>
        </view>

        <!-- 奖励说明 -->
        <view class="bg-gradient-to-r from-[#FFF8E7] to-[#FFFBF0] rounded-xl p-4 border border-[#F0E6D3]">
          <view class="flex items-center gap-2 mb-2">
            <text class="text-[#C9A96E]">🏆</text>
            <text class="font-medium text-[#2C2C2C]">完成奖励</text>
          </view>
          <view class="flex items-center gap-4">
            <view class="flex items-center gap-1">
              <text class="text-[#C9A96E]">✨</text>
              <text class="text-xs text-[#666]">每日 +{{ activity.reward.xp }} 经验值</text>
            </view>
            <view class="flex items-center gap-1">
              <text class="text-[#C9A96E]">⭐</text>
              <text class="text-xs text-[#666]">获得「{{ activity.reward.badge }}」勋章</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 打卡动态 -->
      <view v-if="activeTab === 'feed'" class="space-y-3">
        <view v-for="item in checkinFeed" :key="item.id" class="bg-white rounded-xl p-4 shadow-sm">
          <view class="flex items-center gap-3 mb-3">
            <image :src="item.user.avatar" mode="aspectFill" class="w-10 h-10 rounded-full" />
            <view class="flex-1">
              <text class="font-medium text-sm text-[#2C2C2C] block">{{ item.user.name }}</text>
              <text class="text-[11px] text-[#999]">{{ item.time }}</text>
            </view>
            <text class="px-2 py-0.5 bg-[#52C41A]/10 text-[#52C41A] text-[10px] rounded-full">已打卡</text>
          </view>
          <text class="text-sm text-[#2C2C2C] leading-relaxed block mb-3">{{ item.content }}</text>
          <image v-if="item.images.length > 0" v-for="(img, idx) in item.images" :key="idx" :src="img" mode="widthFix" class="w-full rounded-lg mb-3" />
          <view class="flex items-center gap-4 pt-2 border-t border-[#F5F0E8]">
            <view class="flex items-center gap-1 text-[#999]">
              <text>❤️</text>
              <text class="text-xs">{{ item.likes }}</text>
            </view>
            <view class="flex items-center gap-1 text-[#999]">
              <text>💬</text>
              <text class="text-xs">{{ item.comments }}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 排行榜 -->
      <view v-if="activeTab === 'rank'" class="bg-white rounded-xl overflow-hidden shadow-sm">
        <view class="p-4 border-b border-[#F5F0E8]">
          <view class="flex items-center gap-2">
            <text class="text-[#C9A96E]">🏆</text>
            <text class="font-medium text-[#2C2C2C]">连续打卡排行</text>
          </view>
        </view>
        <view>
          <view v-for="(item, idx) in leaderboard" :key="item.rank" :class="['flex items-center gap-3 px-4 py-3', idx < leaderboard.length - 1 ? 'border-b border-[#F5F0E8]' : '']">
            <view :class="['w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white',
              item.rank === 1 ? 'bg-gradient-to-br from-yellow-400 to-orange-500' :
              item.rank === 2 ? 'bg-gradient-to-br from-gray-300 to-gray-400' :
              item.rank === 3 ? 'bg-gradient-to-br from-orange-300 to-orange-400' :
              'bg-[#F5F0E8] text-[#999]']">
              <text>{{ item.rank }}</text>
            </view>
            <image :src="item.user.avatar" mode="aspectFill" class="w-10 h-10 rounded-full" />
            <view class="flex-1">
              <text class="font-medium text-sm text-[#2C2C2C] block">{{ item.user.name }}</text>
              <text class="text-[11px] text-[#999]">累计{{ item.totalDays }}天</text>
            </view>
            <view class="text-right">
              <view class="flex items-center gap-1">
                <text class="text-[#FF6B35]">🔥</text>
                <text class="font-bold text-[#FF6B35]">{{ item.streak }}</text>
              </view>
              <text class="text-[10px] text-[#999]">连续天数</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 我的记录 -->
      <view v-if="activeTab === 'my'" class="space-y-3">
        <view v-if="myCheckins.length > 0">
          <view v-for="(item, idx) in myCheckins" :key="idx" class="bg-white rounded-xl p-4 shadow-sm mb-3">
            <view class="flex items-center gap-2 mb-2">
              <text class="text-[#52C41A]">✓</text>
              <text class="text-xs text-[#999]">{{ item.date }}</text>
            </view>
            <text class="text-sm text-[#2C2C2C] leading-relaxed block mb-2">{{ item.content }}</text>
            <view v-if="item.images.length > 0" class="flex gap-2 mb-2">
              <image v-for="(img, imgIdx) in item.images" :key="imgIdx" :src="img" mode="aspectFill" class="w-20 h-20 rounded-lg" />
            </view>
            <view class="flex items-center gap-4 text-xs text-[#999]">
              <text class="flex items-center gap-1">❤️ {{ item.likes }}</text>
              <text class="flex items-center gap-1">💬 {{ item.comments }}</text>
            </view>
          </view>
        </view>
        <view v-else class="flex flex-col items-center justify-center py-16">
          <text class="text-5xl text-[#E8E0D5] mb-3">📖</text>
          <text class="text-sm text-[#999]">还没有打卡记录</text>
        </view>
      </view>
    </view>

    <!-- 底部打卡按钮 -->
    <view class="fixed bottom-0 left-0 right-0 bg-white border-t border-[#E8E0D5] px-4 py-3 z-50" style="padding-bottom: calc(12px + env(safe-area-inset-bottom));">
      <view v-if="activity.hasCheckedToday" class="flex items-center justify-center gap-2 py-3 bg-[#F5F0E8] rounded-full">
        <text class="text-[#52C41A]">✓</text>
        <text class="text-[#52C41A] font-medium">今日已打卡</text>
      </view>
      <view
        v-else
        @click="showCheckinModal = true"
        class="w-full py-3.5 bg-gradient-to-r from-[#C41E3A] to-[#E74C3C] text-white font-medium rounded-full shadow-lg flex items-center justify-center gap-2"
      >
        <text>✓</text>
        <text>立即打卡 (+{{ activity.reward.xp }}经验)</text>
      </view>
    </view>

    <!-- 打卡弹窗 -->
    <view v-if="showCheckinModal" class="fixed inset-0 z-50 flex items-end justify-center bg-black/50" @click.self="showCheckinModal = false">
      <view class="w-full max-w-lg bg-white rounded-t-3xl overflow-hidden">
        <view class="flex items-center justify-between px-4 py-4 border-b border-[#E8E0D5]">
          <view @click="showCheckinModal = false" class="text-[#999]">
            <text class="text-xl">✕</text>
          </view>
          <text class="font-semibold text-[#2C2C2C]">打卡</text>
          <view class="w-6" />
        </view>

        <view class="p-4" style="max-height: 70vh; overflow-y: auto;">
          <!-- 今日内容提示 -->
          <view class="bg-[#FAF8F5] rounded-xl p-3 mb-4">
            <text class="text-xs text-[#999] block mb-1">今日阅读内容</text>
            <text class="text-sm font-medium text-[#2C2C2C]">{{ todayContent.chapter }}</text>
          </view>

          <!-- 心得输入 -->
          <view class="mb-4">
            <text class="text-sm font-medium text-[#2C2C2C] block mb-2">写下你的心得 <text class="text-[#C41E3A]">*</text></text>
            <textarea
              v-model="checkinContent"
              placeholder="记录今天的阅读收获，至少50字..."
              class="w-full p-3 bg-[#FAF8F5] rounded-xl text-sm resize-none"
              style="height: 128px;"
              placeholder-style="color:#999"
            />
            <view class="text-right text-xs text-[#999] mt-1">
              {{ checkinContent.length }}/50 <text v-if="checkinContent.length < 50">(至少50字)</text>
            </view>
          </view>

          <!-- 添加图片 -->
          <view class="mb-4">
            <text class="text-sm font-medium text-[#2C2C2C] block mb-2">添加图片 <text class="text-xs text-[#999]">(选填)</text></text>
            <view class="w-20 h-20 rounded-xl border-2 border-dashed border-[#E8E0D5] flex flex-col items-center justify-center text-[#999]">
              <text class="text-xl mb-1">📷</text>
              <text class="text-[11px]">添加</text>
            </view>
          </view>
        </view>

        <view class="px-4 py-4 border-t border-[#E8E0D5]">
          <view
            @click="handleCheckin"
            :class="['w-full py-3.5 rounded-full font-medium text-center transition-all',
              checkinContent.length >= 50 && !isSubmitting ? 'bg-gradient-to-r from-[#C41E3A] to-[#E74C3C] text-white shadow-lg' : 'bg-[#E8E0D5] text-[#999]']"
          >
            {{ isSubmitting ? '提交中...' : '确认打卡' }}
          </view>
        </view>
      </view>
    </view>

    <!-- 打卡成功弹窗 -->
    <view v-if="showSuccess" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50">
      <view class="w-4/5 max-w-sm bg-white rounded-2xl p-6 text-center">
        <view class="w-20 h-20 mx-auto rounded-full bg-gradient-to-br from-[#52C41A] to-[#95DE64] flex items-center justify-center mb-4">
          <text class="text-white text-3xl">✓</text>
        </view>
        <text class="text-xl font-bold text-[#2C2C2C] block mb-2">打卡成功!</text>
        <text class="text-[#666] block mb-4">连续打卡 <text class="text-[#FF6B35] font-bold">{{ activity.myStreak }}</text> 天</text>
        <view class="flex items-center justify-center gap-3 mb-6">
          <view class="px-3 py-1.5 bg-[#FFF8E7] rounded-full flex items-center gap-1">
            <text class="text-[#C9A96E]">✨</text>
            <text class="text-xs text-[#C9A96E]">+{{ activity.reward.xp }} 经验</text>
          </view>
        </view>
        <view @click="showSuccess = false" class="w-full py-3 bg-gradient-to-r from-[#C41E3A] to-[#E74C3C] text-white font-medium rounded-full">
          太棒了
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

const activeTab = ref<'today' | 'feed' | 'rank' | 'my'>('today')
const showCheckinModal = ref(false)
const showSuccess = ref(false)
const checkinContent = ref('')
const isSubmitting = ref(false)

const activity = ref({
  id: '1',
  title: '《滴天髓》共读打卡',
  description: '每日阅读一章，记录心得体会，坚持21天养成阅读习惯',
  cover: 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=800',
  startDate: '2024-01-01',
  endDate: '2024-01-21',
  currentDay: 15,
  totalDays: 21,
  participants: 328,
  todayCheckedIn: 186,
  reward: { xp: 10, badge: '阅读达人' },
  hasCheckedToday: false,
  myStreak: 12,
  myTotalDays: 12,
  rules: [
    '每日阅读指定章节',
    '打卡需写下心得（至少50字）',
    '可配图分享精彩段落',
    '截止时间为每日23:59',
  ],
})

const todayContent = {
  chapter: '第十五章：论日主强弱',
  summary: '本章讲述如何判断日主的强弱，包括得令、得地、得生、得助等要点...',
  keyPoints: ['得令为重', '得地次之', '得生得助为辅'],
}

const leaderboard = [
  { rank: 1, user: { name: '命理大师', avatar: 'https://api.dicebear.com/7.x/avataaars/svg?seed=1' }, streak: 15, totalDays: 15 },
  { rank: 2, user: { name: '易学研究者', avatar: 'https://api.dicebear.com/7.x/avataaars/svg?seed=2' }, streak: 14, totalDays: 14 },
  { rank: 3, user: { name: '古籍爱好者', avatar: 'https://api.dicebear.com/7.x/avataaars/svg?seed=3' }, streak: 13, totalDays: 14 },
  { rank: 4, user: { name: '学习达人', avatar: 'https://api.dicebear.com/7.x/avataaars/svg?seed=4' }, streak: 12, totalDays: 13 },
  { rank: 5, user: { name: '国学新手', avatar: 'https://api.dicebear.com/7.x/avataaars/svg?seed=5' }, streak: 11, totalDays: 12 },
]

const myCheckins = [
  { date: '2024-01-14', content: '今天阅读了论十神的章节，对于正财和偏财的区别有了更深的理解...', images: [], likes: 12, comments: 3 },
  { date: '2024-01-13', content: '格局篇真是精彩，八格的分类方法让我豁然开朗...', images: ['https://picsum.photos/200/200?random=1'], likes: 8, comments: 2 },
  { date: '2024-01-12', content: '开始学习用神的概念，这是八字命理的核心所在...', images: [], likes: 15, comments: 5 },
]

const checkinFeed = [
  { id: 'f1', user: { name: '命理大师', avatar: 'https://api.dicebear.com/7.x/avataaars/svg?seed=1' }, content: '今天深入研究了日主强弱的判断方法，收获满满！书中所说「得令为重」确实是关键...', images: [], time: '10分钟前', likes: 28, comments: 6 },
  { id: 'f2', user: { name: '易学研究者', avatar: 'https://api.dicebear.com/7.x/avataaars/svg?seed=2' }, content: '分享一段经典论述', images: ['https://picsum.photos/400/300?random=10'], time: '30分钟前', likes: 15, comments: 3 },
  { id: 'f3', user: { name: '古籍爱好者', avatar: 'https://api.dicebear.com/7.x/avataaars/svg?seed=3' }, content: '坚持打卡第13天！感觉自己对八字的理解越来越深入了', images: [], time: '1小时前', likes: 22, comments: 8 },
]

const tabs = [
  { id: 'today' as const, label: '今日内容' },
  { id: 'feed' as const, label: '打卡动态' },
  { id: 'rank' as const, label: '排行榜' },
  { id: 'my' as const, label: '我的记录' },
]

const progressPercent = computed(() => (activity.value.currentDay / activity.value.totalDays) * 100)

const calendarDays = computed(() => {
  const days = []
  for (let i = 1; i <= activity.value.totalDays; i++) {
    days.push({
      day: i,
      isCompleted: i <= activity.value.myTotalDays,
      isToday: i === activity.value.currentDay,
      isFuture: i > activity.value.currentDay,
    })
  }
  return days
})

async function handleCheckin() {
  if (checkinContent.value.trim().length < 50) {
    uni.showToast({ title: '心得至少需要50字哦', icon: 'none' })
    return
  }
  isSubmitting.value = true
  await new Promise(r => setTimeout(r, 1500))
  isSubmitting.value = false
  showCheckinModal.value = false
  showSuccess.value = true
  activity.value.hasCheckedToday = true
  activity.value.myStreak += 1
  activity.value.myTotalDays += 1
}

function goBack() { uni.navigateBack() }
</script>
