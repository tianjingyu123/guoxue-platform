            <view class="grid grid-cols-2 gap-3 mb-6">
              <view v-for="(benefit, idx) in memberBenefits" :key="idx" class="bg-[#FAF8F5] rounded-xl p-3 flex items-start gap-2">
                <view class="w-8 h-8 rounded-lg bg-[#C41E3A]/10 flex items-center justify-center flex-shrink-0">
                  <text class="text-base">{{ benefit.icon }}</text>
                </view>
                <view>
                  <text class="text-[13px] font-medium text-[#2C2C2C] block">{{ benefit.title }}</text>
                  <text class="text-[11px] text-[#999] block">{{ benefit.desc }}</text>
                </view>
              </view>
            </view>

            <view class="flex gap-3">
              <view class="flex-1 py-3 rounded-full bg-[#F5F0E8] text-[#666] text-[14px] font-medium text-center" @click="showBenefits = false">
                <text>再想想</text>
              </view>
              <view class="flex-1 py-3 rounded-full bg-gradient-to-r from-[#C41E3A] to-[#E74C3C] text-white text-[14px] font-medium text-center" @click="confirmJoin">
                <text>立即加入</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </template>
  </view>
</template>

<script setup lang="ts">
