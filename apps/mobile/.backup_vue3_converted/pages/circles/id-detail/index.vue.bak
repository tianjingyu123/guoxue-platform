        >
          <text>{{ isJoined ? '已加入' : '¥199/年 加入圈子' }}</text>
        </view>
        <view
          v-if="isJoined"
          class="flex-1 py-3 rounded-full bg-gradient-to-r from-[#C41E3A] to-[#E74C3C] text-white text-[14px] font-medium text-center shadow-lg flex items-center justify-center gap-1"
