<template>
  <view class="min-h-screen bg-[#FAF8F5]" style="padding-bottom: 120px">
    <!-- 加载骨架屏 -->
    <template v-if="loading">
      <view class="animate-pulse">
        <view class="aspect-video bg-[#E8E0D5]" />
        <view class="bg-white -mt-4 rounded-t-[20px] relative z-10 p-4 space-y-4">
          <view class="h-7 bg-[#F2EFEA] rounded w-3/4" />
          <view class="flex items-center gap-3">
            <view class="w-10 h-10 rounded-full bg-[#F2EFEA]" />
            <view class="space-y-2">
              <view class="h-4 w-24 bg-[#F2EFEA] rounded" />
              <view class="h-3 w-16 bg-[#F2EFEA] rounded" />
            </view>
          </view>
          <view v-for="i in 5" :key="i" class="h-4 bg-[#F2EFEA] rounded" :style="{ width: (100 - i * 10) + '%' }" />
        </view>
      </view>
    </template>

    <template v-else-if="content">
      <!-- 顶部导航 -->
      <view class="fixed top-0 left-0 right-0 z-50 bg-gradient-to-b from-black/40 to-transparent">
        <view class="flex items-center justify-between px-4 py-3">
          <view class="w-9 h-9 rounded-full bg-black/30 backdrop-blur flex items-center justify-center" @click="goBack">
            <text class="text-white text-lg">‹</text>
          </view>
          <view class="flex items-center gap-2">
            <view class="w-9 h-9 rounded-full bg-black/30 backdrop-blur flex items-center justify-center" @click="handleShare">
              <text class="text-white">📤</text>
            </view>
            <view class="w-9 h-9 rounded-full bg-black/30 backdrop-blur flex items-center justify-center">
              <text class="text-white">⋯</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 封面图 -->
      <view v-if="content.cover" class="aspect-video relative">
        <image :src="content.cover" mode="aspectFill" class="w-full h-full" />
        <view class="absolute bottom-0 left-0 right-0 h-20 bg-gradient-to-t from-[#FAF8F5] to-transparent" />
      </view>

      <!-- 内容区 -->
      <view class="bg-white rounded-t-[20px] relative z-10" :class="content.cover ? '-mt-4' : 'mt-12'">
        <!-- 标题和元信息 -->
        <view class="p-4 border-b border-[#F0EBE3]">
          <text class="text-[20px] font-bold text-[#2C2C2C] leading-tight mb-3 block">{{ content.title }}</text>

          <!-- 标签 -->
          <view v-if="content.tags && content.tags.length > 0" class="flex flex-wrap gap-2 mb-3">
            <view v-for="tag in content.tags" :key="tag" class="px-2 py-0.5 bg-[#C41E3A]/10 text-[#C41E3A] text-[11px] rounded">
              <text>#{{ tag }}</text>
            </view>
          </view>

          <!-- 统计信息 -->
          <view class="flex items-center gap-4 text-[12px] text-[#999]">
            <view class="flex items-center gap-1">
              <text>👁</text>
              <text>{{ content.views }}</text>
            </view>
            <view class="flex items-center gap-1">
              <text>🕐</text>
              <text>{{ content.publishedAt }}</text>
            </view>
          </view>
        </view>

        <!-- 作者信息 -->
        <view class="flex items-center justify-between p-4 border-b border-[#F0EBE3]">
          <view class="flex items-center gap-3" @click="goTo('/pages/user/id-detail/index?id=' + content.author.id)">
            <image :src="content.author.avatar" mode="aspectFill" class="w-12 h-12 rounded-full" />
            <view>
              <text class="font-medium text-[#2C2C2C] block">{{ content.author.name }}</text>
              <text class="text-[12px] text-[#999]">{{ content.author.title }}</text>
            </view>
          </view>
          <view
            class="px-4 py-1.5 rounded-full text-[13px] font-medium"
            :class="content.author.isFollowed ? 'bg-[#F5F0E8] text-[#999]' : 'bg-[#C41E3A] text-white'"
            @click="handleFollow"
          >
            <text>{{ content.author.isFollowed ? '已关注' : '+ 关注' }}</text>
          </view>
        </view>

        <!-- 正文内容 -->
        <view class="p-4">
          <rich-text :nodes="contentNodes" class="text-[14px] text-[#333] leading-relaxed" />
        </view>

        <!-- 加入圈子引导 -->
        <view v-if="content.relatedCircle" class="mx-4 mb-4 p-4 bg-gradient-to-r from-[#C41E3A]/5 to-[#C9A96E]/5 rounded-xl border border-[#C41E3A]/10">
          <view class="flex items-center justify-between">
            <view class="flex items-center gap-3">
              <image :src="content.relatedCircle.cover" mode="aspectFill" class="w-12 h-12 rounded-xl" />
              <view>
                <text class="font-medium text-[#2C2C2C] block">{{ content.relatedCircle.name }}</text>
                <view class="flex items-center gap-1 text-[12px] text-[#999]">
                  <text>👥 {{ content.relatedCircle.members }}成员</text>
                </view>
              </view>
            </view>
            <view class="px-4 py-1.5 bg-[#C41E3A] text-white text-[13px] font-medium rounded-full" @click="goTo('/pages/circles/id-detail/index?id=' + content.relatedCircle.id)">
              <text>加入圈子</text>
            </view>
          </view>
        </view>

        <!-- 评论区 -->
        <view class="border-t-8 border-[#F5F0E8]">
          <view class="px-4 py-3">
            <text class="text-[15px] font-bold text-[#2C2C2C]">评论 ({{ commentsTotal }})</text>
          </view>

          <view v-if="comments.length === 0" class="px-4 pb-6 text-center text-[#999] text-sm">
            <text>暂无评论，快来抢沙发吧~</text>
          </view>

          <view v-for="comment in comments" :key="comment.id" class="px-4 py-3 border-b border-[#F0EBE3]">
            <view class="flex items-start gap-2">
              <image :src="comment.author.avatar" mode="aspectFill" class="w-8 h-8 rounded-full shrink-0" />
              <view class="flex-1">
                <view class="flex items-center justify-between">
                  <text class="text-[13px] font-medium text-[#2C2C2C]">{{ comment.author.name }}</text>
                  <text class="text-[11px] text-[#999]">{{ comment.createdAt }}</text>
                </view>
                <text class="text-[13px] text-[#333] mt-1 block">{{ comment.content }}</text>
                <view class="flex items-center gap-3 mt-2">
                  <view class="flex items-center gap-1" :class="comment.isLiked ? 'text-[#C41E3A]' : 'text-[#999]'" @click="handleLikeComment(comment.id)">
                    <text class="text-xs">{{ comment.isLiked ? '❤️' : '🤍' }}</text>
                    <text class="text-[11px]">{{ comment.likes }}</text>
                  </view>
                  <text class="text-[11px] text-[#999]">回复</text>
                </view>

                <!-- 回复列表 -->
                <view v-if="comment.replies && comment.replies.length > 0" class="mt-2 ml-2 space-y-2 bg-[#FAF8F5] rounded-lg p-3">
                  <view v-for="reply in comment.replies" :key="reply.id" class="flex items-start gap-2">
                    <image :src="reply.author.avatar" mode="aspectFill" class="w-6 h-6 rounded-full shrink-0" />
                    <view class="flex-1">
                      <view class="flex items-center justify-between">
                        <text class="text-[12px] font-medium text-[#2C2C2C]">{{ reply.author.name }}</text>
                        <text class="text-[10px] text-[#999]">{{ reply.createdAt }}</text>
                      </view>
                      <text class="text-[12px] text-[#333] mt-0.5 block">{{ reply.content }}</text>
                      <view class="flex items-center gap-3 mt-1">
                        <view class="flex items-center gap-1" :class="reply.isLiked ? 'text-[#C41E3A]' : 'text-[#999]'" @click="handleLikeComment(reply.id)">
                          <text class="text-xs">{{ reply.isLiked ? '❤️' : '🤍' }}</text>
                          <text class="text-[10px]">{{ reply.likes }}</text>
                        </view>
                      </view>
                    </view>
                  </view>
                </view>

                <text v-if="comment.replyCount > 0 && (!comment.replies || comment.replies.length < comment.replyCount)" class="text-[11px] text-[#C41E3A] mt-2 block" @click="loadMoreReplies(comment)">查看全部{{ comment.replyCount }}条回复</text>
              </view>
            </view>
          </view>

          <view v-if="hasMoreComments" class="py-4 text-center">
            <text class="text-sm text-[#C41E3A]" @click="loadMoreComments">加载更多评论</text>
          </view>
        </view>
      </view>

      <!-- 底部固定操作栏 + 评论输入 -->
      <view class="fixed bottom-0 left-0 right-0 bg-white border-t border-[#F0EBE3] z-40">
        <view class="flex items-center justify-around py-1">
          <view class="flex flex-col items-center gap-0.5 py-1 px-4" @click="handleLike">
            <text :class="content.isLiked ? 'text-[#C41E3A]' : 'text-[#666]'">{{ content.isLiked ? '❤️' : '🤍' }}</text>
            <text class="text-[10px]" :class="content.isLiked ? 'text-[#C41E3A]' : 'text-[#666]'">{{ content.likes > 0 ? content.likes : '点赞' }}</text>
          </view>
          <view class="flex flex-col items-center gap-0.5 py-1 px-4" @click="handleCollect">
            <text :class="content.isCollected ? 'text-[#C9A96E]' : 'text-[#666]'">{{ content.isCollected ? '⭐' : '☆' }}</text>
            <text class="text-[10px]" :class="content.isCollected ? 'text-[#C9A96E]' : 'text-[#666]'">{{ content.collects > 0 ? content.collects : '收藏' }}</text>
          </view>
          <view class="flex flex-col items-center gap-0.5 py-1 px-4" @click="focusComment">
            <text class="text-[#666]">💬</text>
            <text class="text-[10px] text-[#666]">{{ content.comments > 0 ? content.comments : '评论' }}</text>
          </view>
          <view class="flex flex-col items-center gap-0.5 py-1 px-4" @click="handleShare">
            <text class="text-[#666]">📤</text>
            <text class="text-[10px] text-[#666]">分享</text>
          </view>
        </view>
        <!-- 快捷评论输入 -->
        <view class="flex items-center gap-2 px-4 pb-2 pt-1 border-t border-[#F0EBE3]/50">
          <input
            ref="commentInputRef"
            v-model="commentText"
            placeholder="写下你的评论..."
            class="flex-1 h-9 px-3 bg-[#F5F1EB] rounded-full text-sm text-[#2C2C2C] placeholder:text-[#999] outline-none"
            @confirm="handleAddComment"
          />
          <view
            @click="handleAddComment"
            :class="['px-4 h-9 rounded-full flex items-center justify-center text-sm font-medium', commentText.trim() ? 'bg-[#C41E3A] text-white' : 'bg-[#F0EBE5] text-[#999]']"
          >
            <text>发送</text>
          </view>
        </view>
      </view>
    </template>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'

function goBack() { uni.navigateBack() }
function goTo(url: string) { uni.navigateTo({ url }) }

interface Author {
  id: string; name: string; avatar: string; title: string
  followers: number; isFollowed: boolean
}
interface RelatedCircle { id: string; name: string; cover: string; members: number }
interface ContentDetail {
  id: string; type: string; title: string; content: string; cover: string
  author: Author; publishedAt: string; views: number; likes: number
  collects: number; comments: number; isLiked: boolean; isCollected: boolean
  tags: string[]; relatedCircle?: RelatedCircle
}
interface CommentItem {
  id: string; content: string; author: { id: string; name: string; avatar: string }
  createdAt: string; likes: number; isLiked: boolean
  replies?: CommentItem[]; replyCount: number
}

const loading = ref(true)
const content = ref<ContentDetail | null>(null)
const comments = ref<CommentItem[]>([])
const commentsTotal = ref(0)
const commentsPage = ref(1)
const commentsLoading = ref(false)
const hasMoreComments = ref(true)
const contentNodes = ref<any[]>([])
const commentText = ref('')
const commentInputRef = ref<any>(null)

const defaultContent: ContentDetail = {
  id: '1', type: 'article', title: '八字命理入门：如何看懂你的命盘',
  content: '<p>八字命理，又称四柱命理，是中国传统命理学的重要分支。它通过分析一个人出生时的年、月、日、时四柱天干地支，来推断人的命运走势。</p><h2>什么是八字</h2><p>八字是指一个人出生时的年、月、日、时所对应的天干地支，共八个字，故称"八字"。例如：甲子年、丙寅月、戊辰日、壬午时。</p><h2>天干地支基础</h2><p><strong>十天干：</strong>甲、乙、丙、丁、戊、己、庚、辛、壬、癸</p><p><strong>十二地支：</strong>子、丑、寅、卯、辰、巳、午、未、申、酉、戌、亥</p><h2>五行相生相克</h2><p>五行学说是八字命理的基础：</p><ul><li>相生：木生火、火生土、土生金、金生水、水生木</li><li>相克：木克土、土克水、水克火、火克金、金克木</li></ul><h2>日主与十神</h2><p>日柱的天干代表命主本人，称为"日主"。根据日主与其他干支的关系，可以推导出十神：比肩、劫财、食神、伤官、正财、偏财、正官、七杀、正印、偏印。</p><blockquote>"命由天定，运由己造。"了解命理不是为了宿命，而是为了更好地把握人生。</blockquote>',
  cover: '/images/courses/course-1.jpg',
  author: { id: 'author-1', name: '周易大师', avatar: '/images/experts/expert-1.jpg', title: '资深命理师 | 20年从业经验', followers: 12800, isFollowed: false },
  publishedAt: '2024-03-15', views: 8560, likes: 1280, collects: 560, comments: 128, isLiked: false, isCollected: false,
  tags: ['八字入门', '命理学', '五行'],
  relatedCircle: { id: 'circle-1', name: '八字研习社', cover: '/images/circles/circle-1.jpg', members: 12800 },
}

const defaultComments: CommentItem[] = [
  {
    id: 'c1', content: '写得很好，对初学者很友好，期待更多入门教程！',
    author: { id: 'u1', name: '国学爱好者', avatar: '/images/avatars/avatar-1.jpg' },
    createdAt: '2小时前', likes: 56, isLiked: false, replyCount: 5,
    replies: [
      { id: 'c1-r1', content: '同意，讲解得很清楚易懂', author: { id: 'u2', name: '命理新手', avatar: '/images/avatars/avatar-2.jpg' }, createdAt: '1小时前', likes: 12, isLiked: false, replyCount: 0 },
      { id: 'c1-r2', content: '已经收藏了，慢慢学习', author: { id: 'u3', name: '学习中', avatar: '/images/avatars/avatar-3.jpg' }, createdAt: '30分钟前', likes: 5, isLiked: false, replyCount: 0 },
    ],
  },
  {
    id: 'c2', content: '请问老师，日主弱的人是不是运势就不好？有没有补救的方法？',
    author: { id: 'u4', name: '求知者', avatar: '/images/avatars/avatar-4.jpg' },
    createdAt: '5小时前', likes: 23, isLiked: true, replies: [], replyCount: 0,
  },
]

async function loadData() {
  loading.value = true
  await new Promise(r => setTimeout(r, 800))
  content.value = defaultContent
  comments.value = defaultComments
  commentsTotal.value = 128
  contentNodes.value = [{ name: 'div', children: [{ type: 'text', text: '八字命理详解...' }] }]
  loading.value = false
}

function handleFollow() {
  if (!content.value) return
  const newFollowed = !content.value.author.isFollowed
  content.value.author.isFollowed = newFollowed
  content.value.author.followers += newFollowed ? 1 : -1
  uni.showToast({ title: newFollowed ? '已关注' : '已取消关注', icon: 'none' })
}

function handleLike() {
  if (!content.value) return
  const newLiked = !content.value.isLiked
  content.value.isLiked = newLiked
  content.value.likes += newLiked ? 1 : -1
}

function handleCollect() {
  if (!content.value) return
  const newCollected = !content.value.isCollected
  content.value.isCollected = newCollected
  content.value.collects += newCollected ? 1 : -1
}

function handleLikeComment(commentId: string) {
  comments.value = comments.value.map(c => {
    if (c.id === commentId) return { ...c, isLiked: !c.isLiked, likes: c.likes + (c.isLiked ? -1 : 1) }
    if (c.replies) {
      return { ...c, replies: c.replies.map(r => r.id === commentId ? { ...r, isLiked: !r.isLiked, likes: r.likes + (r.isLiked ? -1 : 1) } : r) }
    }
    return c
  })
}

function handleShare() {
  uni.setClipboardData({
    data: `https://rebugx.com/content/${content.value?.id}`,
    success() { uni.showToast({ title: '链接已复制', icon: 'none' }) },
  })
}

function handleAddComment() {
  const text = commentText.value.trim()
  if (!text || !content.value) return
  const newComment: CommentItem = {
    id: 'new-' + Date.now(),
    content: text,
    author: { id: 'me', name: '我', avatar: '/images/avatars/default.jpg' },
    createdAt: '刚刚',
    likes: 0,
    isLiked: false,
    replies: [],
    replyCount: 0,
  }
  comments.value.unshift(newComment)
  commentsTotal.value++
  content.value.comments++
  commentText.value = ''
  uni.showToast({ title: '评论成功', icon: 'success' })
}

function focusComment() {
  commentInputRef.value?.focus()
}

function loadMoreComments() {
  commentsLoading.value = true
  setTimeout(() => {
    hasMoreComments.value = false
    commentsLoading.value = false
    uni.showToast({ title: '已加载全部评论', icon: 'none' })
  }, 1000)
}

function loadMoreReplies(comment: CommentItem) {
  uni.showToast({ title: '加载更多回复', icon: 'none' })
}

onMounted(() => { loadData() })
</script>

<style scoped>
</style>
