<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-24">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 h-14">
        <view @click="goBack" class="p-1"><text class="text-xl text-[#2C2C2C]">←</text></view>
        <text class="font-semibold text-base text-[#2C2C2C]">推广收益</text>
        <view class="w-9" />
      </view>
    </view>

    <view class="p-4 space-y-4">
      <!-- 收益总览卡片 -->
      <view class="p-5 rounded-xl bg-gradient-to-br from-[#C9A96E] via-[#C9A96E]/90 to-[#C41E3A]/80 text-white relative overflow-hidden border-0">
        <view class="absolute -right-8 -top-8 w-32 h-32 rounded-full bg-white/10" />
        <view class="absolute -right-4 -bottom-4 w-24 h-24 rounded-full bg-white/5" />

        <view class="relative z-10">
          <text class="text-sm text-white/80">累计收益</text>
          <view class="flex items-baseline gap-1 mt-2">
            <text class="text-sm">¥</text>
            <text class="text-4xl font-bold tracking-tight">{{ totalEarnings }}</text>
          </view>

          <view class="flex items-center justify-between mt-4 pt-4 border-t border-white/20">
            <view>
              <text class="text-xs text-white/70">可提现余额</text>
              <text class="text-lg font-semibold block mt-0.5">¥{{ withdrawable }}</text>
            </view>
            <view @click="goTo('/pages/videos/creator/withdraw/index')" class="px-5 py-2 bg-white text-[#C9A96E] font-medium text-sm rounded-full">
              提现
            </view>
          </view>
        </view>
      </view>

      <!-- 收入来源拆分 -->
      <view class="bg-white rounded-xl p-4 border border-[#E8E0D5]">
        <view class="flex items-center justify-between mb-4">
          <text class="font-semibold text-[#2C2C2C]">收入来源</text>
          <text class="text-xs text-[#999] flex items-center gap-0.5">详情 ›</text>
        </view>

        <view class="flex items-center gap-6">
          <!-- 简化环形图 -->
          <view class="relative w-28 h-28 flex-shrink-0">
            <svg viewBox="0 0 100 100" class="w-full h-full" style="transform: rotate(-90deg);" xmlns="http://www.w3.org/2000/svg">
              <circle
                v-for="(source, index) in incomeSources" :key="source.name"
                :cx="50" :cy="50" :r="40"
                fill="none"
                :stroke="ringColors[index]"
                stroke-width="12"
                :stroke-dasharray="getRingDasharray(source.percentage)"
                :stroke-dashoffset="getRingOffset(index)"
              />
            </svg>
            <view class="absolute inset-0 flex flex-col items-center justify-center">
              <text class="text-[#C9A96E]">💰</text>
            </view>
          </view>

          <!-- 图例 -->
          <view class="flex-1 space-y-2">
            <view v-for="source in incomeSources.slice(0, 4)" :key="source.name" class="flex items-center justify-between text-sm">
              <view class="flex items-center gap-2">
                <view :class="['w-2.5 h-2.5 rounded-full', source.color]" />
                <text class="text-[#999]">{{ source.name }}</text>
              </view>
              <text class="font-medium text-[#2C2C2C]">{{ source.percentage }}%</text>
            </view>
            <text v-if="incomeSources.length > 4" class="text-xs text-[#999]">+{{ incomeSources.length - 4 }}项其他收入</text>
          </view>
        </view>
      </view>

      <!-- 收益趋势图 -->
      <view class="bg-white rounded-xl p-4 border border-[#E8E0D5]">
        <view class="flex items-center justify-between mb-4">
          <text class="font-semibold text-[#2C2C2C]">近7天收益趋势</text>
          <view class="flex items-center gap-1 text-green-500 text-xs">
            <text>📈</text>
            <text>+12.5%</text>
          </view>
        </view>

        <view class="flex items-end justify-between gap-2 h-32">
          <view v-for="(item, index) in trendData" :key="item.day" class="flex-1 flex flex-col items-center gap-2">
            <view class="w-full flex flex-col items-center">
              <text class="text-[10px] text-[#999] mb-1">{{ item.amount >= 1000 ? (item.amount / 1000).toFixed(1) + 'k' : item.amount }}</text>
              <view
                :class="['w-full rounded-t-sm', index === trendData.length - 2 ? 'bg-[#C9A96E]' : 'bg-[#C41E3A]/60']"
                :style="{ height: (item.amount / maxTrendAmount) * 80 + 'px' }"
              />
            </view>
            <text class="text-[10px] text-[#999]">{{ item.day }}</text>
          </view>
        </view>
      </view>

      <!-- 收入明细 -->
      <view>
        <view class="flex items-center justify-between mb-3">
          <text class="font-semibold text-[#2C2C2C]">收入明细</text>
          <view class="flex items-center gap-1 text-xs text-[#999]">
            <text>🔍</text>
            <text>筛选</text>
          </view>
        </view>

        <!-- 筛选标签 -->
        <view class="flex items-center gap-2 mb-3 overflow-x-auto" style="scrollbar-width:none">
          <view
            v-for="f in filters" :key="f.id"
            @click="activeFilter = f.id"
            :class="['px-3 py-1.5 text-xs rounded-full whitespace-nowrap transition-colors', activeFilter === f.id ? 'bg-[#C41E3A] text-white' : 'bg-[#FAF8F5] text-[#999]']"
          >
            {{ f.label }}
          </view>
        </view>

        <!-- 明细列表 -->
        <view class="space-y-2">
          <view v-for="record in filteredRecords" :key="record.id" class="bg-white rounded-xl p-3 border border-[#E8E0D5]">
            <view class="flex items-center gap-3">
              <view :class="['w-10 h-10 rounded-xl flex items-center justify-center', record.color]">
                <text>{{ record.icon }}</text>
              </view>
              <view class="flex-1 min-w-0">
                <text class="text-sm text-[#2C2C2C] truncate block">{{ record.title }}</text>
                <text class="text-xs text-[#999] mt-0.5">{{ record.time }}</text>
              </view>
              <text class="text-base font-semibold text-green-500">+¥{{ record.amount.toFixed(2) }}</text>
            </view>
          </view>
        </view>

        <!-- 查看更多 -->
        <view class="w-full py-3 text-sm text-[#999] text-center mt-2">查看全部记录</view>
      </view>
    </view>

    <!-- 底部固定操作栏 -->
    <view class="fixed bottom-0 left-0 right-0 bg-white border-t border-[#E8E0D5] p-4" style="padding-bottom: calc(16px + env(safe-area-inset-bottom));">
      <view class="flex items-center gap-3">
        <view @click="goTo('/pages/videos/creator/earnings/history/index')" class="flex-1 py-3 text-center text-sm font-medium text-[#2C2C2C] bg-[#FAF8F5] rounded-xl">
          全部明细
        </view>
        <view @click="goTo('/pages/videos/creator/withdraw/index')" class="flex-1 py-3 text-center text-sm font-medium text-white bg-[#C41E3A] rounded-xl flex items-center justify-center gap-2">
          <text>💳</text>
          <text>申请提现</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

const totalEarnings = '7,800.50'
const withdrawable = '5,280.00'
const activeFilter = ref('all')

const incomeSources = [
  { name: '课程分成', amount: 3280.50, percentage: 42, color: 'bg-[#C41E3A]' },
  { name: '商品分佣', amount: 1560.00, percentage: 20, color: 'bg-[#C9A96E]' },
  { name: '入圈收入', amount: 980.00, percentage: 13, color: 'bg-emerald-500' },
  { name: '推广佣金', amount: 1200.00, percentage: 15, color: 'bg-blue-500' },
  { name: '管理奖励', amount: 780.00, percentage: 10, color: 'bg-purple-500' },
]

const ringColors = ['#C41E3A', '#C9A96E', '#10B981', '#3B82F6', '#8B5CF6']

const trendData = [
  { day: '周一', amount: 320 },
  { day: '周二', amount: 580 },
  { day: '周三', amount: 420 },
  { day: '周四', amount: 890 },
  { day: '周五', amount: 650 },
  { day: '周六', amount: 1200 },
  { day: '周日', amount: 980 },
]

const maxTrendAmount = Math.max(...trendData.map(d => d.amount))

interface RecordItem {
  id: number; type: string; title: string; amount: number; time: string; icon: string; color: string
}

const incomeRecords: RecordItem[] = [
  { id: 1, type: 'course', title: '课程《八字入门》销售分佣', amount: 29.90, time: '今天 14:30', icon: '📚', color: 'text-[#C41E3A] bg-[#C41E3A]/10' },
  { id: 2, type: 'product', title: '商品「开运手串」销售分佣', amount: 15.00, time: '今天 11:20', icon: '🛍️', color: 'text-[#C9A96E] bg-[#C9A96E]/10' },
  { id: 3, type: 'circle', title: '用户加入「命理研习社」', amount: 9.90, time: '昨天 18:45', icon: '👥', color: 'text-emerald-500 bg-emerald-500/10' },
  { id: 4, type: 'promote', title: '推广用户购买会员', amount: 50.00, time: '昨天 15:30', icon: '🔗', color: 'text-blue-500 bg-blue-500/10' },
  { id: 5, type: 'course', title: '课程《紫微斗数精讲》销售分佣', amount: 99.00, time: '昨天 10:15', icon: '📚', color: 'text-[#C41E3A] bg-[#C41E3A]/10' },
  { id: 6, type: 'award', title: '本周管理奖励结算', amount: 200.00, time: '3天前', icon: '🏆', color: 'text-purple-500 bg-purple-500/10' },
  { id: 7, type: 'product', title: '商品「风水罗盘」销售分佣', amount: 45.00, time: '3天前', icon: '🛍️', color: 'text-[#C9A96E] bg-[#C9A96E]/10' },
  { id: 8, type: 'circle', title: '用户加入「风水实战班」', amount: 199.00, time: '4天前', icon: '👥', color: 'text-emerald-500 bg-emerald-500/10' },
]

const filters = [
  { id: 'all', label: '全部' },
  { id: 'course', label: '课程' },
  { id: 'product', label: '商品' },
  { id: 'circle', label: '圈子' },
  { id: 'promote', label: '推广' },
]

const filteredRecords = computed(() =>
  activeFilter.value === 'all'
    ? incomeRecords
    : incomeRecords.filter(r => r.type === activeFilter.value)
)

function getRingDasharray(percentage: number) {
  const circumference = 2 * Math.PI * 40
  return `${(percentage / 100) * circumference} ${circumference}`
}

function getRingOffset(index: number) {
  const circumference = 2 * Math.PI * 40
  let offset = 0
  for (let i = 0; i < index; i++) {
    offset += (incomeSources[i].percentage / 100) * circumference
  }
  return -offset
}

function goBack() { uni.navigateBack() }
function goTo(url: string) { uni.navigateTo({ url }) }
</script>
