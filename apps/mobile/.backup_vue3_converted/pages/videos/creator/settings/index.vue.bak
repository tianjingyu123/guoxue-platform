<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5] flex items-center px-4 h-12 gap-3">
      <view @click="goBack" class="p-1"><text class="text-xl text-[#2C2C2C]">←</text></view>
      <text class="text-base font-semibold text-[#2C2C2C]">创作者设置</text>
    </view>

    <!-- Tab bar -->
    <view class="flex border-b border-[#E8E0D5] sticky top-12 z-10 bg-white">
      <view v-for="t in settingTabs" :key="t.key" @click="activeTab = t.key" :class="['flex-1 py-3 text-xs font-medium border-b-2 text-center', activeTab === t.key ? 'border-[#C41E3A] text-[#C41E3A]' : 'border-transparent text-[#999]']">
        <text>{{ t.label }}</text>
      </view>
    </view>

    <view class="px-4 py-5 pb-28">
      <!-- 个人资料 -->
      <view v-if="activeTab === 'profile'" class="space-y-5">
        <view class="flex flex-col items-center gap-3">
          <view class="relative">
            <image v-if="!avatarError" src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=80" mode="aspectFill" class="w-20 h-20 rounded-full" @error="avatarError = true" />
            <view v-if="avatarError" class="w-20 h-20 rounded-full bg-gradient-to-br from-[#C41E3A] to-[#E74C3C] flex items-center justify-center text-white text-2xl">创</view>
            <view class="absolute bottom-0 right-0 w-6 h-6 bg-[#C41E3A] rounded-full flex items-center justify-center">
              <text class="text-white text-xs">📤</text>
            </view>
          </view>
          <text class="text-xs text-[#999]">点击头像更换</text>
        </view>
        <view v-for="field in profileFields" :key="field.key">
          <text class="text-xs font-medium text-[#2C2C2C] block mb-1.5">{{ field.label }}</text>
          <textarea v-if="field.key === 'bio'" v-model="profile[field.key]" class="w-full min-h-[90px] px-3 py-2 text-sm bg-white border border-[#E8E0D5] rounded-lg resize-none outline-none" />
          <input v-else v-model="profile[field.key]" :placeholder="field.placeholder" class="w-full h-9 px-3 text-sm bg-white border border-[#E8E0D5] rounded-lg outline-none" />
        </view>
      </view>

      <!-- 通知 -->
      <view v-if="activeTab === 'notify'" class="bg-white border border-[#E8E0D5] rounded-xl divide-y divide-[#E8E0D5]">
        <view v-for="n in notifyItems" :key="n.key" class="flex items-center justify-between px-4 py-3">
          <text class="text-sm text-[#2C2C2C]">{{ n.label }}</text>
          <view @click="notify[n.key] = !notify[n.key]" :class="['w-11 h-6 rounded-full relative', notify[n.key] ? 'bg-[#C41E3A]' : 'bg-[#E8E0D5]']">
            <view :class="['absolute top-0.5 w-5 h-5 bg-white rounded-full shadow transition-all', notify[n.key] ? 'right-0.5' : 'left-0.5']" />
          </view>
        </view>
      </view>

      <!-- 隐私 -->
      <view v-if="activeTab === 'privacy'" class="bg-white border border-[#E8E0D5] rounded-xl divide-y divide-[#E8E0D5]">
        <view v-for="p in privacyItems" :key="p.key" class="flex items-center justify-between px-4 py-3">
          <text class="text-sm text-[#2C2C2C]">{{ p.label }}</text>
          <view @click="privacy[p.key] = !privacy[p.key]" :class="['w-11 h-6 rounded-full relative', privacy[p.key] ? 'bg-[#C41E3A]' : 'bg-[#E8E0D5]']">
            <view :class="['absolute top-0.5 w-5 h-5 bg-white rounded-full shadow transition-all', privacy[p.key] ? 'right-0.5' : 'left-0.5']" />
          </view>
        </view>
      </view>

      <!-- 收款 -->
      <view v-if="activeTab === 'payment'" class="space-y-3">
        <view v-for="item in paymentItems" :key="item.label" class="flex items-center gap-3 px-4 py-3 bg-white border border-[#E8E0D5] rounded-xl">
          <text class="text-[#C41E3A]">💰</text>
          <view class="flex-1">
            <text class="text-sm text-[#2C2C2C] block">{{ item.label }}</text>
            <text class="text-xs text-[#999]">{{ item.value }}</text>
          </view>
          <text class="text-[#999]">›</text>
        </view>
        <view class="p-3 bg-[#F5F5F5] rounded-xl">
          <text class="text-xs text-[#999] leading-relaxed">每月 <text class="text-[#2C2C2C] font-medium">1 日</text> 自动结算上月收益，满 <text class="text-[#2C2C2C] font-medium">¥50</text> 即可提现。</text>
        </view>
      </view>
    </view>

    <!-- 保存按钮 -->
    <view v-if="activeTab !== 'payment'" class="fixed bottom-0 left-0 right-0 bg-white border-t border-[#E8E0D5] px-4 py-4">
      <view @click="handleSave" :class="['w-full h-11 rounded-xl text-sm font-semibold text-white flex items-center justify-center gap-2', saved ? 'bg-green-500' : 'bg-[#C41E3A]']" :style="saving ? 'opacity:0.6' : ''">
        <template v-if="saving">
          <view class="w-4 h-4 rounded-full border-2 border-white border-t-transparent spinner"></view>
          <text>保存中...</text>
        </template>
        <text v-else>{{ saved ? '保存成功' : '保存设置' }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref } from 'vue'

type Tab = 'profile' | 'notify' | 'privacy' | 'payment'

const settingTabs = [
  { key: 'profile' as Tab, label: '个人资料' },
  { key: 'notify' as Tab, label: '通知' },
  { key: 'privacy' as Tab, label: '隐私' },
  { key: 'payment' as Tab, label: '收款' },
]

const activeTab = ref<Tab>('profile')
const saving = ref(false)
const saved = ref(false)
const avatarError = ref(false)

const profile = ref({
  nickname: '玄易老师',
  bio: '专注八字命理二十年，著有《现代八字新解》。擅长婚姻、事业、财运分析。',
  specialty: '八字命理、紫微斗数',
  website: '',
})

const profileFields = [
  { key: 'nickname', label: '昵称', placeholder: '' },
  { key: 'specialty', label: '专业领域', placeholder: '' },
  { key: 'website', label: '个人网站', placeholder: 'https://' },
  { key: 'bio', label: '个人简介', placeholder: '' },
]

const notify = ref({ newFollower: true, newComment: true, newOrder: true, newLike: false, system: true })
const notifyItems = [
  { key: 'newFollower', label: '新增关注' },
  { key: 'newComment', label: '评论提醒' },
  { key: 'newOrder', label: '新订单通知' },
  { key: 'newLike', label: '点赞提醒' },
  { key: 'system', label: '系统通知' },
]

const privacy = ref({ showFollowers: true, showFollowing: false, allowComment: true, allowDm: true })
const privacyItems = [
  { key: 'showFollowers', label: '展示粉丝数' },
  { key: 'showFollowing', label: '展示关注数' },
  { key: 'allowComment', label: '允许评论' },
  { key: 'allowDm', label: '允许私信' },
]

const paymentItems = [
  { label: '绑定支付宝收款', value: '已绑定 z***@qq.com' },
  { label: '绑定微信收款', value: '未绑定' },
  { label: '银行卡提现', value: '添加银行卡' },
]

async function handleSave() {
  if (saving.value) return
  saving.value = true
  await new Promise(r => setTimeout(r, 800))
  saving.value = false
  saved.value = true
  setTimeout(() => { saved.value = false }, 2500)
}

function goBack() { uni.navigateBack() }
</script>

<style scoped>
.spinner {
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
</style>
