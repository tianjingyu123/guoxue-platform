<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-20">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 h-14">
        <view class="flex items-center gap-2">
          <view @click="goBack" class="p-1">
            <text class="text-xl text-[#2C2C2C]">←</text>
          </view>
          <text class="text-lg font-semibold text-[#2C2C2C]">创作者收益</text>
        </view>
        <view @click="goTo('/pages/wallet/withdraw/index')" class="flex items-center gap-1 text-xs text-[#C41E3A]">
          <text>💰</text>
          <text>提现</text>
        </view>
      </view>
    </view>

    <!-- 加载骨架 -->
    <view v-if="loading" class="p-4 space-y-4">
      <view class="h-40 bg-[#F5F1EB] rounded-xl animate-pulse" />
      <view class="h-48 bg-[#F5F1EB] rounded-xl animate-pulse" />
      <view class="h-32 bg-[#F5F1EB] rounded-xl animate-pulse" />
    </view>

    <!-- 错误 -->
    <view v-else-if="error" class="p-4">
      <view class="flex flex-col items-center justify-center py-16">
        <text class="text-4xl mb-3">😞</text>
        <text class="text-sm text-[#999] mb-4">{{ error }}</text>
        <view @click="fetchData" class="px-4 py-2 bg-[#C41E3A] text-white rounded-full text-xs">重试</view>
      </view>
    </view>

    <!-- 空状态 -->
    <view v-else-if="!data" class="p-4">
      <view class="flex flex-col items-center justify-center py-16">
        <text class="text-4xl mb-3">📊</text>
        <text class="text-sm text-[#999]">暂无收益数据</text>
      </view>
    </view>

    <view v-else class="p-4 space-y-4">
      <!-- 收益总览卡片 -->
      <view class="p-5 rounded-xl bg-gradient-to-br from-[#C41E3A]/10 to-[#C41E3A]/5 border border-[#C41E3A]/20">
        <view class="text-center mb-4">
          <text class="text-sm text-[#999] block mb-1">累计收益（元）</text>
          <text class="text-3xl font-bold text-[#C41E3A]">{{ data.overview.totalRevenue.toFixed(2) }}</text>
        </view>

        <view class="grid grid-cols-3 gap-4 pt-4 border-t border-[#C41E3A]/10">
          <view class="text-center">
            <text class="text-xs text-[#999] block mb-1">本月收益</text>
            <text class="font-semibold text-[#2C2C2C]">{{ data.overview.monthRevenue.toLocaleString() }}</text>
            <view :class="['flex items-center justify-center text-xs mt-1', data.overview.monthGrowthRate >= 0 ? 'text-green-600' : 'text-red-600']">
              <text>{{ data.overview.monthGrowthRate >= 0 ? '📈' : '📉' }}</text>
              <text>{{ Math.abs(data.overview.monthGrowthRate) }}%</text>
            </view>
          </view>
          <view class="text-center">
            <text class="text-xs text-[#999] block mb-1">可提现</text>
            <text class="font-semibold text-[#C41E3A]">{{ data.overview.withdrawable.toLocaleString() }}</text>
          </view>
          <view class="text-center">
            <text class="text-xs text-[#999] block mb-1">待结算</text>
            <text class="font-semibold text-amber-600">{{ data.overview.pending.toLocaleString() }}</text>
          </view>
        </view>
      </view>

      <!-- 收益趋势 -->
      <view class="bg-white rounded-xl border border-[#E8E0D5] p-4">
        <view class="flex items-center justify-between mb-2">
          <text class="font-medium text-[#2C2C2C]">收益趋势</text>
          <text class="text-xs text-[#999]">近30天</text>
        </view>
        <view class="relative h-32 mt-4">
          <svg class="w-full h-full" viewBox="0 0 300 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="trendGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#C41E3A" stop-opacity="0.3" />
                <stop offset="100%" stop-color="#C41E3A" stop-opacity="0" />
              </linearGradient>
            </defs>
            <path :d="trendAreaPath" fill="url(#trendGradient)" />
            <path :d="trendLinePath" fill="none" stroke="#C41E3A" stroke-width="2" />
          </svg>
          <view class="flex justify-between mt-2 text-xs text-[#999]">
            <text>{{ data.trend[0]?.date.slice(5) }}</text>
            <text>{{ data.trend[Math.floor(data.trend.length / 2)]?.date.slice(5) }}</text>
            <text>{{ data.trend[data.trend.length - 1]?.date.slice(5) }}</text>
          </view>
        </view>
      </view>

      <!-- 收益来源构成 -->
      <view class="bg-white rounded-xl border border-[#E8E0D5] p-4">
        <view class="flex items-center justify-between mb-4">
          <text class="font-medium text-[#2C2C2C]">收益来源</text>
          <view class="flex items-center gap-0.5 text-xs text-[#999]">
            <text>查看详情</text>
            <text>›</text>
          </view>
        </view>

        <view class="space-y-3">
          <view
            v-for="source in data.sources" :key="source.type"
            @click="selectedType = source.type"
            class="flex items-center -mx-2 px-2 py-1 rounded-lg"
          >
            <view :class="['w-8 h-8 rounded-lg flex items-center justify-center text-white mr-3', sourceColors[source.type]]">
              <text>{{ sourceIcons[source.type] }}</text>
            </view>
            <view class="flex-1 min-w-0">
              <view class="flex items-center justify-between mb-1">
                <text class="text-sm text-[#2C2C2C]">{{ sourceNames[source.type] }}</text>
                <text class="font-medium text-[#2C2C2C]">{{ source.amount.toLocaleString() }}</text>
              </view>
              <view class="flex items-center">
                <view class="flex-1 h-1.5 bg-[#F5F1EB] rounded-full overflow-hidden mr-2">
                  <view :class="['h-full rounded-full', sourceColors[source.type]]" :style="{ width: source.percentage + '%' }" />
                </view>
                <text class="text-xs text-[#999] w-10">{{ source.percentage }}%</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 收益明细 -->
      <view class="bg-white rounded-xl border border-[#E8E0D5] p-4">
        <text class="font-medium text-[#2C2C2C] block mb-4">收益明细</text>

        <!-- 类型筛选 -->
        <view class="flex flex-wrap gap-1 mb-4">
          <view
            @click="selectedType = 'all'"
            :class="['px-3 py-1.5 rounded-full text-xs font-medium', selectedType === 'all' ? 'bg-[#C41E3A] text-white' : 'bg-[#F5F1EB] text-[#2C2C2C]']"
          >
            全部
          </view>
          <view
            v-for="(name, type) in sourceNames" :key="type"
            @click="selectedType = type"
            :class="['px-3 py-1.5 rounded-full text-xs font-medium', selectedType === type ? 'bg-[#C41E3A] text-white' : 'bg-[#F5F1EB] text-[#2C2C2C]']"
          >
            {{ name }}
          </view>
        </view>

        <!-- 明细列表 -->
        <view v-if="detailsLoading" class="space-y-3">
          <view v-for="i in 3" :key="i" class="flex items-center gap-3">
            <view class="w-10 h-10 rounded-lg bg-[#F5F1EB] animate-pulse" />
            <view class="flex-1 space-y-2">
              <view class="h-4 bg-[#F5F1EB] rounded animate-pulse w-3/4" />
              <view class="h-3 bg-[#F5F1EB] rounded animate-pulse w-1/2" />
            </view>
          </view>
        </view>

        <view v-else-if="details.length === 0" class="py-8 text-center">
          <text class="text-sm text-[#999]">暂无收益记录</text>
        </view>

        <view v-else class="space-y-3">
          <view v-for="item in details" :key="item.id" class="flex items-start p-3 bg-[#F5F1EB]/30 rounded-xl">
            <view :class="['w-10 h-10 rounded-lg flex items-center justify-center text-white mr-3 flex-shrink-0', sourceColors[item.type]]">
              <text>{{ sourceIcons[item.type] }}</text>
            </view>
            <view class="flex-1 min-w-0">
              <view class="flex items-start justify-between mb-1">
                <text class="text-sm font-medium text-[#2C2C2C] truncate pr-2">{{ item.title }}</text>
                <text class="text-[#C41E3A] font-semibold whitespace-nowrap">+{{ item.amount }}</text>
              </view>
              <view class="flex items-center justify-between">
                <view class="flex items-center text-xs text-[#999]">
                  <view v-if="item.buyer" class="flex items-center mr-2">
                    <view class="w-4 h-4 rounded-full bg-[#E8E0D5] flex items-center justify-center mr-1">
                      <text class="text-[8px]">{{ item.buyer.nickname[0] }}</text>
                    </view>
                    <text>{{ item.buyer.nickname }}</text>
                  </view>
                  <text>{{ item.createdAt }}</text>
                </view>
                <view :class="['text-xs px-1.5 rounded', statusBadgeClass(item.status)]">
                  <text>{{ statusLabel(item.status) }}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

const loading = ref(true)
const error = ref<string | null>(null)
const detailsLoading = ref(false)
const selectedType = ref<string>('all')

const sourceIcons: Record<string, string> = {
  course: '📚', question: '❓', reward: '🎁', tip: '❤️', article: '📄', live: '📡',
}
const sourceColors: Record<string, string> = {
  course: 'bg-blue-500', question: 'bg-green-500', reward: 'bg-orange-500', tip: 'bg-pink-500', article: 'bg-purple-500', live: 'bg-red-500',
}
const sourceNames: Record<string, string> = {
  course: '课程', question: '问答', reward: '打赏', tip: '赞赏', article: '文章', live: '直播',
}

interface Overview {
  totalRevenue: number
  monthRevenue: number
  monthGrowthRate: number
  withdrawable: number
  pending: number
}

interface TrendPoint { date: string; amount: number }
interface SourceItem { type: string; amount: number; percentage: number }
interface DetailItem { id: string; type: string; title: string; amount: number; buyer?: { nickname: string }; createdAt: string; status: string }

interface RevenueData {
  overview: Overview
  trend: TrendPoint[]
  sources: SourceItem[]
}

const data = ref<RevenueData | null>(null)
const details = ref<DetailItem[]>([])

const trendAreaPath = computed(() => {
  if (!data.value?.trend.length) return ''
  const t = data.value.trend
  const max = Math.max(...t.map(p => p.amount))
  const min = Math.min(...t.map(p => p.amount))
  const range = max - min || 1
  let d = `M0,${100 - ((t[0].amount - min) / range) * 80}`
  t.forEach((p, i) => {
    const x = (i / (t.length - 1)) * 300
    const y = 100 - ((p.amount - min) / range) * 80
    d += ` L${x},${y}`
  })
  d += ' L300,100 L0,100 Z'
  return d
})

const trendLinePath = computed(() => {
  if (!data.value?.trend.length) return ''
  const t = data.value.trend
  const max = Math.max(...t.map(p => p.amount))
  const min = Math.min(...t.map(p => p.amount))
  const range = max - min || 1
  let d = `M0,${100 - ((t[0].amount - min) / range) * 80}`
  t.forEach((p, i) => {
    const x = (i / (t.length - 1)) * 300
    const y = 100 - ((p.amount - min) / range) * 80
    d += ` L${x},${y}`
  })
  return d
})

function statusLabel(s: string) {
  const map: Record<string, string> = { settled: '已结算', pending: '待结算', frozen: '冻结中' }
  return map[s] || s
}

function statusBadgeClass(s: string) {
  const map: Record<string, string> = {
    settled: 'text-green-600 bg-green-50 border border-green-200',
    pending: 'text-orange-600 bg-orange-50 border border-orange-200',
    frozen: 'text-blue-600 bg-blue-50 border border-blue-200',
  }
  return map[s] || ''
}

async function fetchData() {
  loading.value = true
  error.value = null
  // 模拟数据
  await new Promise(r => setTimeout(r, 600))
  data.value = {
    overview: { totalRevenue: 186520.00, monthRevenue: 28450, monthGrowthRate: 12.5, withdrawable: 18650.00, pending: 3200.00 },
    trend: [
      { date: '2024-06-01', amount: 800 }, { date: '2024-06-05', amount: 1200 }, { date: '2024-06-10', amount: 950 },
      { date: '2024-06-15', amount: 1500 }, { date: '2024-06-20', amount: 1800 }, { date: '2024-06-25', amount: 1350 },
      { date: '2024-06-30', amount: 2100 },
    ],
    sources: [
      { type: 'course', amount: 85000, percentage: 46 },
      { type: 'question', amount: 42000, percentage: 23 },
      { type: 'live', amount: 28000, percentage: 15 },
      { type: 'reward', amount: 15000, percentage: 8 },
      { type: 'article', amount: 10000, percentage: 5 },
      { type: 'tip', amount: 6520, percentage: 3 },
    ],
  }
  loading.value = false
}

async function fetchDetails() {
  detailsLoading.value = true
  await new Promise(r => setTimeout(r, 400))
  const all: DetailItem[] = [
    { id: '1', type: 'course', title: '八字命理精讲课程', amount: 1280, buyer: { nickname: '山河客' }, createdAt: '2024-06-28', status: 'settled' },
    { id: '2', type: 'live', title: '直播间打赏', amount: 520, buyer: { nickname: '星空旅人' }, createdAt: '2024-06-28', status: 'settled' },
    { id: '3', type: 'question', title: '紫微斗数排盘咨询', amount: 88, buyer: { nickname: '云上墨' }, createdAt: '2024-06-27', status: 'pending' },
    { id: '4', type: 'reward', title: '收到打赏', amount: 200, buyer: { nickname: '问道者' }, createdAt: '2024-06-27', status: 'settled' },
    { id: '5', type: 'article', title: '奇门遁甲入门文章', amount: 360, createdAt: '2024-06-26', status: 'frozen' },
    { id: '6', type: 'tip', title: '用户赞赏', amount: 66, createdAt: '2024-06-25', status: 'settled' },
  ]
  details.value = selectedType.value === 'all' ? all : all.filter(d => d.type === selectedType.value)
  detailsLoading.value = false
}

onMounted(() => {
  fetchData()
  fetchDetails()
})

function goBack() { uni.navigateBack() }
function goTo(url: string) { uni.navigateTo({ url }) }
</script>
