<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-8">
    <!-- 顶部栏 -->
    <view class="sticky top-0 z-20 bg-[#C41E3A] text-white">
      <view class="flex items-center gap-2 px-4 h-14">
        <view class="p-2 -ml-2 rounded-full" @tap="goBack">
          <text>←</text>
        </view>
        <text class="text-lg font-semibold flex items-center gap-1.5">
          <text>⚡</text>
          限时秒杀
        </text>
        <view class="ml-auto flex items-center gap-1.5 text-xs">
          <text>🕐</text>
          <text>距本场结束</text>
          <text class="flex items-center gap-0.5 font-mono">
            <text class="bg-white/20 rounded px-1 py-0.5 text-xs">{{ h }}</text>
            <text>:</text>
            <text class="bg-white/20 rounded px-1 py-0.5 text-xs">{{ m }}</text>
            <text>:</text>
            <text class="bg-white/20 rounded px-1 py-0.5 text-xs">{{ s }}</text>
          </text>
        </view>
      </view>

      <!-- 场次选择 -->
      <view class="flex gap-2 px-4 pb-3 overflow-x-auto scrollbar-hide">
        <view
          v-for="session in sessions"
          :key="session.id"
          class="shrink-0 flex flex-col items-center px-5 py-1.5 rounded-lg transition-colors cursor-pointer"
          :class="activeSession === session.id ? 'bg-white text-[#C41E3A]' : 'bg-white/15 text-white'"
          @tap="activeSession = session.id"
        >
          <text class="text-base font-semibold">{{ session.time }}</text>
          <text class="text-[10px] opacity-90 mt-0.5">{{ session.label }}</text>
        </view>
      </view>
    </view>

    <!-- 加载骨架屏 -->
    <view v-if="loading" class="px-4 pt-4 space-y-3">
      <view v-for="i in 3" :key="i" class="flex gap-3 p-3 bg-white rounded-xl border border-[#E8E0D5]">
        <view class="w-24 h-24 rounded-lg bg-[#F0EBE5] animate-pulse flex-shrink-0" />
        <view class="flex-1 space-y-2">
          <view class="h-4 w-3/4 bg-[#F0EBE5] rounded animate-pulse" />
          <view class="h-5 w-20 bg-[#F0EBE5] rounded animate-pulse" />
          <view class="h-3 w-full bg-[#F0EBE5] rounded animate-pulse" />
        </view>
      </view>
    </view>

    <!-- 秒杀日历 -->
    <view v-else class="px-4 pt-3">
      <view class="bg-white rounded-xl p-3 border border-[#E8E0D5] mb-3">
        <view class="flex items-center justify-between mb-2">
          <view class="flex items-center gap-2">
            <text class="text-sm">📅</text>
            <text class="text-xs text-[#2C2C2C] font-medium">秒杀日历</text>
          </view>
          <text class="text-[10px] text-[#C41E3A] font-medium">查看全部场次 →</text>
        </view>
        <scroll-view scroll-x class="flex gap-3 whitespace-nowrap">
          <view v-for="(day, idx) in calendarDays" :key="idx" class="inline-flex flex-col items-center px-2">
            <text class="text-[10px] text-[#999]">{{ day.weekday }}</text>
            <text
              class="text-sm font-bold mt-0.5"
              :class="day.isActive ? 'text-[#C41E3A]' : 'text-[#2C2C2C]'"
            >{{ day.date }}</text>
            <text v-if="day.isActive" class="w-1 h-1 rounded-full bg-[#C41E3A] mt-0.5" />
          </view>
        </scroll-view>
      </view>

      <!-- 分类筛选 -->
      <view class="flex gap-2 mb-3 overflow-x-auto whitespace-nowrap scrollbar-hide">
        <view
          v-for="cat in productCategories"
          :key="cat.id"
          @tap="activeCategory = cat.id"
          class="px-3 py-1 rounded-full text-xs font-medium border transition-colors"
          :class="activeCategory === cat.id ? 'bg-[#C41E3A] text-white border-[#C41E3A]' : 'bg-white text-[#999] border-[#E8E0D5]'"
        >
          {{ cat.label }}
        </view>
      </view>

      <!-- 秒杀商品列表 -->
      <view class="space-y-3">
        <view
          v-for="product in filteredProducts"
          :key="product.id"
          class="flex gap-3 p-3 bg-white rounded-xl border border-[#E8E0D5] transition-transform active:scale-[0.99]"
          @tap="goTo('/pages/mall/product/' + product.id)"
        >
          <!-- 商品图片 -->
          <view class="w-24 h-24 rounded-lg bg-[#F5F1EB] overflow-hidden flex-shrink-0">
            <image :src="product.cover" mode="aspectFill" class="w-full h-full" />
          </view>
          <!-- 商品信息 -->
          <view class="flex-1 min-w-0">
            <text class="text-sm font-medium text-[#2C2C2C] line-clamp-2">{{ product.title }}</text>
            <view class="flex items-baseline gap-1 mt-1">
              <text class="text-lg font-bold text-[#C41E3A]">¥{{ product.price }}</text>
              <text class="text-xs text-[#999] line-through">¥{{ product.originalPrice }}</text>
              <text class="text-[10px] bg-[#C41E3A]/10 text-[#C41E3A] px-1 py-0.5 rounded-full ml-1">
                {{ Math.round((1 - product.price / product.originalPrice) * 100) }}%OFF
              </text>
            </view>
            <!-- 进度条 -->
            <view class="flex items-center gap-2 mt-2">
              <view class="flex-1 h-1.5 bg-[#F0EBE5] rounded-full overflow-hidden">
                <view
                  class="h-full bg-[#C41E3A] rounded-full transition-all"
                  :style="{ width: Math.min(100, (product.sold / product.stock) * 100) + '%' }"
                />
              </view>
              <text class="text-[10px] text-[#999] whitespace-nowrap">已抢{{ Math.round((product.sold / product.stock) * 100) }}%</text>
            </view>
            <view class="flex items-center justify-between mt-1">
              <text class="text-[10px] text-[#999]">已售 {{ product.sold }}/{{ product.stock }}</text>
              <view
                class="px-2.5 py-1 rounded-full text-[10px] font-medium transition-colors"
                :class="activeSession === 's1'
                  ? 'bg-[#C41E3A] text-white'
                  : 'bg-[#F5F1EB] text-[#999]'"
                @tap.stop
              >
                <text>{{ activeSession === 's1' ? '立即抢购' : '提醒我' }}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view v-if="flashProducts.length === 0" class="flex flex-col items-center justify-center py-20">
        <view class="w-20 h-20 rounded-full bg-[#F5F1EB] flex items-center justify-center mb-4">
          <text class="text-4xl text-[#999]/50">📦</text>
        </view>
        <text class="text-[#999] text-sm">本场暂无商品</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted, onUnmounted } from 'vue'

interface Session {
  id: string
  time: string
  label: string
  status: 'active' | 'upcoming'
}

interface FlashProduct {
  id: string
  title: string
  cover: string
  price: number
  originalPrice: number
  sales: number
  stock: number
  sold: number
}

interface CalendarDay {
  weekday: string
  date: string
  isActive: boolean
}

// 加载状态
const loading = ref(true)
setTimeout(() => { loading.value = false }, 600)

// 导航
function goBack() { uni.navigateBack() }
function goTo(url: string) { uni.navigateTo({ url }) }

// 分类筛选
const productCategories = [
  { id: 'all', label: '全部' },
  { id: 'fengshui', label: '风水用品' },
  { id: 'jewelry', label: '开运饰品' },
  { id: 'books', label: '书籍' },
  { id: 'other', label: '其他' },
]
const activeCategory = ref('all')

// 商品列表过滤
const filteredProducts = computed(() => {
  if (activeCategory.value === 'all') return flashProducts
  // mock filter
  return flashProducts
})

// 秒杀场次
const sessions: Session[] = [
  { id: 's1', time: '10:00', label: '已开抢', status: 'active' },
  { id: 's2', time: '14:00', label: '即将开始', status: 'upcoming' },
  { id: 's3', time: '18:00', label: '即将开始', status: 'upcoming' },
  { id: 's4', time: '20:00', label: '即将开始', status: 'upcoming' },
]

// 秒杀商品
const flashProducts: FlashProduct[] = [
  { id: 'f1', title: '天然黑曜石貔貅手链 招财转运', cover: 'https://images.unsplash.com/photo-1611591437281-460bfbe1220a?w=400&q=80', price: 68, originalPrice: 268, sales: 2600, stock: 100, sold: 78 },
  { id: 'f2', title: '专业风水罗盘 纯铜精工', cover: 'https://images.unsplash.com/photo-1583847268964-b28dc8f51f92?w=400&q=80', price: 158, originalPrice: 598, sales: 890, stock: 50, sold: 42 },
  { id: 'f3', title: '开光五帝钱挂件 镇宅化煞', cover: 'https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=400&q=80', price: 28, originalPrice: 128, sales: 4500, stock: 200, sold: 156 },
  { id: 'f4', title: '天然水晶七星阵摆件', cover: 'https://images.unsplash.com/photo-1600721391689-2564bb8055de?w=400&q=80', price: 99, originalPrice: 358, sales: 1200, stock: 80, sold: 61 },
  { id: 'f5', title: '桃木剑镇宅辟邪 手工雕刻', cover: 'https://images.unsplash.com/photo-1544881829-59e3b1f98d4e?w=400&q=80', price: 46, originalPrice: 188, sales: 3200, stock: 150, sold: 98 },
  { id: 'f6', title: '黄铜文昌塔 事业学业开运', cover: 'https://images.unsplash.com/photo-1591994843349-f415f71f0b8c?w=400&q=80', price: 78, originalPrice: 298, sales: 1800, stock: 120, sold: 83 },
]

// 秒杀日历
const calendarDays: CalendarDay[] = [
  { weekday: '一', date: '7', isActive: false },
  { weekday: '二', date: '8', isActive: false },
  { weekday: '三', date: '9', isActive: false },
  { weekday: '四', date: '10', isActive: true },
  { weekday: '五', date: '11', isActive: false },
  { weekday: '六', date: '12', isActive: false },
  { weekday: '日', date: '13', isActive: false },
]

// 倒计时
const activeSession = ref('s1')
const seconds = ref(125 * 60)
let timer: ReturnType<typeof setInterval> | null = null

onMounted(() => {
  timer = setInterval(() => {
    seconds.value = seconds.value > 0 ? seconds.value - 1 : 0
  }, 1000)
})

onUnmounted(() => {
  if (timer) clearInterval(timer)
})

const h = computed(() => String(Math.floor(seconds.value / 3600)).padStart(2, '0'))
const m = computed(() => String(Math.floor((seconds.value % 3600) / 60)).padStart(2, '0'))
const s = computed(() => String(seconds.value % 60).padStart(2, '0'))
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
.scrollbar-hide::-webkit-scrollbar { display: none; }
</style>
