      <view class="px-3 pb-3 pt-[10px]">
        <text class="text-[13px] text-[#2C2C2C] leading-[1.4] line-clamp-2">{{ props.item.data.title }}</text>
        <view class="flex items-center justify-between mt-[6px]">
          <text class="text-[11px] text-[#999]">{{ props.item.data.author }}</text>
          <text class="text-[11px] text-[#bbb]">{{ formatCount(props.item.data.plays) }}次播放</text>
        </view>
