        <view class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-black/50 flex items-center justify-center">
          <text class="text-xl text-white ml-[2px]">▶</text>
        </view>
        <view class="absolute bottom-2 right-2 bg-black/60 text-white text-[10px] px-[6px] py-[2px] rounded leading-[1.4]">{{ props.item.data.duration }}</view>
