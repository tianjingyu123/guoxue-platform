<template>
  <!-- 通话/咨询页 -->
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- 导航栏 -->
    <view class="flex items-center justify-between px-4 h-12 bg-white border-b border-[#E8E0D5] shrink-0">
      <view class="p-1" @click="goBack"><text class="text-xl text-[#2C2C2C]">←</text></view>
      <text class="text-base font-semibold text-[#2C2C2C]">专家咨询</text>
      <view class="w-7" />
    </view>

    <!-- 加载骨架屏 -->
    <view v-if="isLoading" class="flex-1 p-4">
      <view class="bg-white rounded-xl p-5 mb-4 animate-pulse shadow-sm">
        <view class="flex items-center gap-3 mb-4">
          <view class="w-14 h-14 bg-[#E8E0D5] rounded-full" />
          <view class="flex-1 space-y-2">
            <view class="h-5 w-28 bg-[#E8E0D5] rounded" />
            <view class="h-4 w-36 bg-[#E8E0D5] rounded" />
          </view>
        </view>
        <view class="h-4 w-48 bg-[#E8E0D5] rounded mb-2" />
        <view class="h-4 w-32 bg-[#E8E0D5] rounded mb-2" />
      </view>
      <view class="bg-white rounded-xl p-5 mb-4 animate-pulse shadow-sm">
        <view class="h-5 w-24 bg-[#E8E0D5] rounded mb-4" />
        <view class="flex gap-3 mb-3">
          <view v-for="i in 3" :key="i" class="flex-1 h-10 bg-[#E8E0D5] rounded-lg" />
        </view>
        <view class="h-5 w-24 bg-[#E8E0D5] rounded mb-4" />
        <view class="flex gap-3 mb-3">
          <view v-for="i in 3" :key="i" class="flex-1 h-10 bg-[#E8E0D5] rounded-lg" />
        </view>
      </view>
      <view class="h-12 bg-[#E8E0D5] rounded-2xl" />
    </view>

    <!-- 错误状态 -->
    <view v-else-if="isError" class="flex-1 flex flex-col items-center justify-center p-8">
      <text class="text-5xl mb-4">⚠</text>
      <text class="text-base text-[#2C2C2C] font-medium mb-2">加载失败</text>
      <text class="text-sm text-[#999] mb-4">无法加载咨询信息</text>
      <view class="px-6 py-2 bg-[#C41E3A] text-white rounded-2xl text-sm" @click="loadData">重新加载</view>
    </view>

    <!-- 主体内容 -->
    <scroll-view v-else scroll-y class="flex-1">
      <!-- 通话记录列表 -->
      <view v-if="showHistory" class="flex-1">
        <view class="flex items-center justify-between px-4 py-3">
          <text class="text-sm font-semibold text-[#2C2C2C]">通话记录</text>
          <text class="text-xs text-[#C41E3A]" @click="showHistory = false">预约咨询 ›</text>
        </view>
        <!-- 空记录 -->
        <view v-if="callHistory.length === 0" class="flex flex-col items-center py-12">
          <text class="text-5xl mb-3">📞</text>
          <text class="text-sm text-[#2C2C2C] font-medium mb-1">暂无通话记录</text>
          <text class="text-xs text-[#999]">去预约专家咨询吧</text>
        </view>
        <!-- 记录列表 -->
        <view v-else class="px-4">
          <view
            v-for="c in callHistory"
            :key="c.id"
            class="flex items-center gap-3 bg-white rounded-xl p-3.5 mb-2 shadow-sm"
            @click="viewCallDetail(c)"
          >
            <view class="w-11 h-11 rounded-full bg-gradient-to-br flex items-center justify-center text-lg text-white font-semibold shrink-0" :class="c.status === 'completed' ? 'from-green-400 to-green-500' : c.status === 'missed' ? 'from-red-400 to-red-500' : 'from-[#C41E3A] to-[#E74C3C]'">
              {{ c.expertName[0] }}
            </view>
            <view class="flex-1">
              <view class="flex items-center justify-between">
                <text class="text-sm font-medium text-[#2C2C2C]">{{ c.expertName }}</text>
                <text class="text-xs text-[#999]">{{ c.date }}</text>
              </view>
              <view class="flex items-center gap-2 mt-0.5">
                <text class="text-xs" :class="c.status === 'completed' ? 'text-green-500' : c.status === 'missed' ? 'text-red-400' : 'text-[#999]'">
                  {{ c.status === 'completed' ? '已接通' : c.status === 'missed' ? '未接听' : '进行中' }}
                </text>
                <text class="text-xs text-[#999]">·</text>
                <text class="text-xs text-[#999]">{{ c.duration }}</text>
              </view>
            </view>
            <text class="text-base text-[#ccc]">›</text>
          </view>
        </view>
        <view class="h-6" />
      </view>

      <!-- 预约咨询表单 -->
      <view v-else class="flex-1 p-4">
        <!-- 专家信息卡片 -->
        <view class="bg-white rounded-xl p-5 mb-4 shadow-sm">
          <view class="flex items-center gap-3">
            <view class="w-14 h-14 rounded-full bg-gradient-to-br from-[#C41E3A] to-[#E74C3C] text-white flex items-center justify-center text-2xl font-bold shrink-0">
              {{ expert.name[0] }}
            </view>
            <view class="flex-1">
              <text class="text-base font-semibold text-[#2C2C2C] block">{{ expert.name }}</text>
              <text class="text-xs text-[#999] block mt-0.5">{{ expert.title }}</text>
              <view class="flex items-center gap-2 mt-1">
                <text class="text-xs text-yellow-500">⭐ {{ expert.rating }}</text>
                <text class="text-[10px] text-[#999]">|</text>
                <text class="text-xs text-[#999]">{{ expert.serviceCount }}人咨询</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 通话时长选择 -->
        <view class="bg-white rounded-xl p-5 mb-4 shadow-sm">
          <text class="text-sm font-semibold text-[#2C2C2C] block mb-4">⏱ 通话时长</text>
          <view class="flex gap-3">
            <view
              v-for="dur in durations"
              :key="dur.value"
              class="flex-1 py-3 rounded-xl text-center text-sm border"
              :class="selectedDuration === dur.value ? 'border-[#C41E3A] bg-[#C41E3A]/5 text-[#C41E3A] font-medium' : 'border-[#E8E0D5] text-[#999]'"
              @click="selectedDuration = dur.value"
            >
              <text class="block">{{ dur.label }}</text>
              <text class="text-xs mt-0.5 block" :class="selectedDuration === dur.value ? 'text-[#C41E3A]/70' : 'text-[#ccc]'">¥{{ dur.price }}</text>
            </view>
          </view>
        </view>

        <!-- 预约时间选择 -->
        <view class="bg-white rounded-xl p-5 mb-4 shadow-sm">
          <text class="text-sm font-semibold text-[#2C2C2C] block mb-4">📅 预约时间</text>
          <scroll-view scroll-x class="-mx-5 px-5 mb-3" show-scrollbar="false">
            <view class="flex gap-2">
              <view
                v-for="d in dateOptions"
                :key="d.date"
                class="w-16 py-2.5 rounded-xl text-center shrink-0"
                :class="selectedDate === d.date ? 'bg-[#C41E3A] text-white' : 'bg-[#F5F1EB] text-[#999]'"
                @click="selectedDate = d.date"
              >
                <text class="text-[10px] block">{{ d.weekday }}</text>
                <text class="text-sm font-medium block mt-0.5">{{ d.day }}</text>
              </view>
            </view>
          </scroll-view>
          <view class="grid grid-cols-4 gap-2">
            <view
              v-for="slot in timeSlots"
              :key="slot"
              class="py-2 rounded-lg text-center text-xs border"
              :class="selectedTime === slot ? 'border-[#C41E3A] bg-[#C41E3A]/5 text-[#C41E3A] font-medium' : 'border-[#E8E0D5] text-[#999]'"
              @click="selectedTime = slot"
            >
              {{ slot }}
            </view>
          </view>
        </view>

        <!-- 价格汇总 -->
        <view class="bg-white rounded-xl p-5 mb-4 shadow-sm">
          <view class="flex items-center justify-between mb-2">
            <text class="text-sm text-[#2C2C2C]">通话时长</text>
            <text class="text-sm text-[#2C2C2C]">{{ durationLabel }}分钟</text>
          </view>
          <view class="flex items-center justify-between mb-2">
            <text class="text-sm text-[#2C2C2C]">单价</text>
            <text class="text-sm text-[#2C2C2C]">¥{{ unitPrice }}/分钟</text>
          </view>
          <view class="flex items-center justify-between pt-3 border-t border-[#E8E0D5]">
            <text class="text-base font-semibold text-[#2C2C2C]">合计</text>
            <text class="text-xl font-bold text-[#C41E3A]">¥{{ totalPrice }}</text>
          </view>
        </view>

        <!-- 开始通话按钮 -->
        <view
          class="h-12 bg-[#C41E3A] text-white rounded-2xl flex items-center justify-center text-sm font-medium mb-6 shadow-lg"
          @click="startCall"
        >
          📞 预约咨询
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

interface CallRecord {
  id: string
  expertName: string
  status: 'completed' | 'missed' | 'ongoing'
  duration: string
  date: string
}

interface ExpertInfo {
  name: string
  title: string
  rating: string
  serviceCount: number
}

const isLoading = ref(true)
const isError = ref(false)
const showHistory = ref(true)

// 专家信息
const expert = ref<ExpertInfo>({
  name: '曾仕明',
  title: '易学研究员 · 国学传承人',
  rating: '4.9',
  serviceCount: 3280,
})

// 通话时长
const durations = [
  { label: '15分钟', value: 15, price: 75 },
  { label: '30分钟', value: 30, price: 150 },
  { label: '60分钟', value: 60, price: 270 },
]
const selectedDuration = ref(15)
const unitPrice = 5
const durationLabel = computed(() => selectedDuration.value.toString())
const totalPrice = computed(() => selectedDuration.value * unitPrice)

// 日期选择
const dateOptions = [
  { weekday: '今天', day: '10', date: '2026-06-10' },
  { weekday: '周三', day: '11', date: '2026-06-11' },
  { weekday: '周四', day: '12', date: '2026-06-12' },
  { weekday: '周五', day: '13', date: '2026-06-13' },
  { weekday: '周六', day: '14', date: '2026-06-14' },
  { weekday: '周日', day: '15', date: '2026-06-15' },
]
const selectedDate = ref('2026-06-10')
const timeSlots = ['09:00', '09:30', '10:00', '10:30', '14:00', '14:30', '15:00', '15:30', '16:00', '16:30', '19:00', '19:30']
const selectedTime = ref('')

// 通话记录
const callHistory = ref<CallRecord[]>([
  { id: '1', expertName: '周易大师', status: 'completed', duration: '15分钟', date: '今天 14:30' },
  { id: '2', expertName: '紫微传承人', status: 'completed', duration: '30分钟', date: '昨天 10:00' },
  { id: '3', expertName: '风水实战派', status: 'missed', duration: '-', date: '前天 16:00' },
  { id: '4', expertName: '梅花易数讲师', status: 'completed', duration: '15分钟', date: '2026-06-05' },
])

function viewCallDetail(c: CallRecord) {
  uni.showToast({ title: `查看与${c.expertName}的通话详情`, icon: 'none' })
}

function startCall() {
  if (!selectedTime.value) {
    uni.showToast({ title: '请选择预约时间', icon: 'none' })
    return
  }
  uni.showToast({ title: `预约成功！${selectedDate.value} ${selectedTime.value}`, icon: 'success' })
}

function loadData() {
  isLoading.value = true
  isError.value = false
  setTimeout(() => {
    isLoading.value = false
  }, 600)
}

function goBack() {
  uni.navigateBack()
}

onMounted(() => {
  loadData()
})
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
