<template>
  <!-- 预订界面 -->
  <view v-if="callState === 'booking'" class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-40 bg-[#FAF8F5]/95 backdrop-blur-lg border-b border-[#E8E0D5]" style="padding-top: env(safe-area-inset-top);">
      <view class="flex items-center justify-between px-4 h-14">
        <view @tap="goBack" class="p-2 -ml-2">
          <text class="text-lg">&#8249;</text>
        </view>
        <text class="font-semibold text-base text-[#2C2C2C]">预约连麦</text>
        <view class="w-9" />
      </view>
    </view>

    <scroll-view scroll-y class="p-4" style="height: calc(100vh - 56px);" scroll-with-animation>
      <view class="pb-36">
        <!-- 达人信息 -->
        <view class="bg-white rounded-xl p-4 mb-4">
          <view class="flex items-center gap-4">
            <view class="relative">
              <view class="w-16 h-16 rounded-full bg-[#C41E3A]/10 flex items-center justify-center">
                <text class="text-lg text-[#C41E3A]">{{ expertData.name[0] }}</text>
              </view>
              <view :class="['absolute bottom-0 right-0 w-4 h-4 rounded-full border-2 border-white', expertData.status === 'online' ? 'bg-green-500' : expertData.status === 'busy' ? 'bg-yellow-500' : 'bg-gray-400']" />
            </view>
            <view class="flex-1">
              <view class="flex items-center gap-2">
                <text class="font-semibold text-[#2C2C2C]">{{ expertData.name }}</text>
                <text class="text-[10px] px-1.5 py-0.5 bg-[#C9A96E]/20 text-[#C9A96E] rounded">V</text>
              </view>
              <text class="text-sm text-[#999]">{{ expertData.title }}</text>
              <view class="flex items-center gap-3 mt-1 text-xs text-[#999]">
                <text class="flex items-center gap-1">
                  <text>✨</text>
                  {{ expertData.rating }}分
                </text>
                <text>{{ expertData.totalCalls }}次连麦</text>
              </view>
            </view>
            <text :class="['text-xs px-2 py-1 rounded', expertData.status === 'online' ? 'bg-green-500/20 text-green-600' : expertData.status === 'busy' ? 'bg-yellow-500/20 text-yellow-600' : 'bg-gray-500/20 text-gray-500']">
              {{ expertData.status === 'online' ? '在线' : expertData.status === 'busy' ? '忙碌' : '离线' }}
            </text>
          </view>
        </view>

        <!-- 通话类型选择 -->
        <view class="mb-4">
          <text class="text-sm font-medium text-[#2C2C2C] mb-3 block">选择通话方式</text>
          <view class="grid grid-cols-2 gap-3">
            <view @tap="callType = 'audio'" :class="['flex items-center justify-center gap-2 p-4 rounded-xl border-2 transition-all', callType === 'audio' ? 'border-[#C41E3A] bg-[#C41E3A]/5' : 'border-[#E8E0D5]']">
              <text :class="['text-lg', callType === 'audio' ? 'text-[#C41E3A]' : 'text-[#999]']">📞</text>
              <text :class="['font-medium', callType === 'audio' ? 'text-[#C41E3A]' : 'text-[#2C2C2C]']">语音连麦</text>
            </view>
            <view @tap="callType = 'video'" :class="['flex items-center justify-center gap-2 p-4 rounded-xl border-2 transition-all', callType === 'video' ? 'border-[#C41E3A] bg-[#C41E3A]/5' : 'border-[#E8E0D5]']">
              <text :class="['text-lg', callType === 'video' ? 'text-[#C41E3A]' : 'text-[#999]']">📹</text>
              <text :class="['font-medium', callType === 'video' ? 'text-[#C41E3A]' : 'text-[#2C2C2C]']">视频连麦</text>
            </view>
          </view>
        </view>

        <!-- 时长套餐 -->
        <view class="mb-4">
          <view class="flex items-center justify-between mb-3">
            <text class="text-sm font-medium text-[#2C2C2C]">选择咨询时长</text>
            <view @tap="togglePerMinute" :class="['text-xs px-3 py-1 rounded-full transition-colors', usePerMinute ? 'bg-[#C41E3A] text-white' : 'bg-[#F5F1EB] text-[#999]']">按分钟计费</view>
          </view>

          <view v-if="!usePerMinute" class="flex flex-col gap-2">
            <view v-for="pkg in expertData.packages" :key="pkg.id" @tap="selectedPackage = pkg.id" :class="['flex items-center justify-between p-4 rounded-xl border-2 transition-all', selectedPackage === pkg.id ? 'border-[#C41E3A] bg-[#C41E3A]/5' : 'border-[#E8E0D5]']">
              <view class="flex items-center gap-3">
                <view class="w-10 h-10 rounded-full bg-[#C41E3A]/10 flex items-center justify-center">
                  <text class="text-lg text-[#C41E3A]">⏰</text>
                </view>
                <view class="text-left">
                  <view class="flex items-center gap-2 flex-wrap">
                    <text class="font-medium text-[#2C2C2C]">{{ pkg.duration }}分钟</text>
                    <text class="text-[10px] px-1.5 py-0.5 bg-[#C9A96E]/20 text-[#C9A96E] rounded leading-none">{{ pkg.discount }}</text>
                    <text v-if="pkg.recommended" class="text-[10px] px-1.5 py-0.5 bg-[#C41E3A] text-white rounded leading-none">推荐</text>
                  </view>
                  <text class="text-xs text-[#999]">约{{ Math.round(pkg.price / pkg.duration) }}币/分钟</text>
                </view>
              </view>
              <view class="text-right">
                <text class="font-bold text-[#C41E3A] text-lg">{{ pkg.price }}币</text>
                <text class="text-xs text-[#999] line-through block">{{ pkg.originalPrice }}币</text>
              </view>
            </view>
          </view>
          <view v-else class="bg-white rounded-xl p-4 border-2 border-[#C41E3A] bg-[#C41E3A]/5">
            <view class="flex items-center justify-between">
              <view class="flex items-center gap-3">
                <view class="w-10 h-10 rounded-full bg-[#C41E3A]/20 flex items-center justify-center">
                  <text class="text-lg text-[#C41E3A]">💰</text>
                </view>
                <view>
                  <text class="font-medium text-[#2C2C2C]">按分钟计费</text>
                  <text class="text-xs text-[#999]">通话结束后自动结算</text>
                </view>
              </view>
              <text class="font-bold text-[#C41E3A] text-lg">{{ expertData.pricePerMinute }}币/分钟</text>
            </view>
          </view>
        </view>

        <!-- 问题描述 -->
        <view class="mb-4">
          <text class="text-sm font-medium text-[#2C2C2C] mb-3 block">问题描述（选填）</text>
          <textarea v-model="questionDescription" placeholder="简要描述你想咨询的问题，帮助达人更好地准备..." placeholder-style="color: #999;" class="w-full h-24 p-3 rounded-xl bg-[#F5F1EB]/50 border border-[#E8E0D5] text-sm text-[#2C2C2C] resize-none" />
        </view>

        <!-- 余额提示 -->
        <view class="rounded-xl p-3 bg-[#C9A96E]/5 border border-[#C9A96E]/20">
          <view class="flex items-center justify-between">
            <view class="flex items-center gap-2">
              <text class="text-lg text-[#C9A96E]">💰</text>
              <text class="text-sm text-[#2C2C2C]">账户余额</text>
            </view>
            <view class="flex items-center gap-2">
              <text class="font-bold text-[#C9A96E]">{{ userBalance }}币</text>
              <text @tap="goTo('/pages/wallet/recharge')" class="text-xs text-[#C41E3A]">充值</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 底部操作栏 -->
    <view class="fixed bottom-0 left-0 right-0 bg-white/95 backdrop-blur-lg border-t border-[#E8E0D5]" style="padding-bottom: env(safe-area-inset-bottom);">
      <view class="p-4">
        <view class="flex items-center justify-between mb-3">
          <text class="text-sm text-[#999]">预计费用</text>
          <view class="flex items-center gap-1">
            <text v-if="getPrice()?.type === 'package'" class="font-bold text-lg text-[#C41E3A]">{{ getPrice()?.price }}币</text>
            <text v-else class="font-bold text-lg text-[#C41E3A]">{{ expertData.pricePerMinute }}币/分钟</text>
          </view>
        </view>
        <view @tap="startCall" :class="['w-full py-3.5 rounded-xl font-medium text-base transition-all flex items-center justify-center gap-2', expertData.status === 'online' && (selectedPackage || usePerMinute) ? 'bg-[#C41E3A] text-white' : 'bg-[#F5F1EB] text-[#999]']">
          <text>{{ callType === 'video' ? '📹' : '📞' }}</text>
          <text>{{ expertData.status === 'online' ? '开始连麦' : '达人不在线' }}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 等待接通界面 -->
  <view v-else-if="callState === 'waiting' || callState === 'connecting'" class="min-h-screen flex flex-col items-center justify-center p-6" style="background: linear-gradient(to bottom, rgba(196,30,58,0.2), #FAF8F5, #FAF8F5);">
    <view class="relative mb-8">
      <view :class="[callState === 'connecting' ? 'animate-ping' : 'animate-pulse', 'absolute inset-0 rounded-full bg-[#C41E3A]/30']" style="transform: scale(1.3);" />
      <view class="w-32 h-32 rounded-full border-4 border-[#C41E3A]/30 bg-[#C41E3A]/10 flex items-center justify-center relative">
        <text class="text-3xl text-[#C41E3A]">{{ expertData.name[0] }}</text>
      </view>
    </view>

    <text class="text-xl font-semibold text-[#2C2C2C] mb-2">{{ expertData.name }}</text>
    <text class="text-[#999] mb-8">
      {{ callState === 'waiting' ? '正在等待对方接听...' : '正在连接中...' }}
    </text>

    <view @tap="callState = 'booking'" class="w-16 h-16 rounded-full bg-red-500 flex items-center justify-center">
      <text class="text-3xl text-white">📞</text>
    </view>
    <text class="text-sm text-[#999] mt-3">挂断</text>
  </view>

  <!-- 通话中界面 -->
  <view v-else-if="callState === 'active'" class="min-h-screen bg-black flex flex-col relative">
    <!-- 费用提示角标 -->
    <view class="absolute top-4 right-4 z-20" style="padding-top: env(safe-area-inset-top);">
      <view class="px-3 py-2 bg-black/60 rounded-xl backdrop-blur border-0">
        <view class="flex items-center gap-2 text-white">
          <text class="text-sm">⏰</text>
          <text class="font-mono text-sm">{{ formatDuration(callDuration) }}</text>
          <text class="text-white/60">|</text>
          <text class="text-sm text-[#C9A96E]">💰</text>
          <text class="font-mono text-sm text-[#C9A96E]">{{ usePerMinute ? totalCost.toFixed(0) : getPrice()?.price }}币</text>
        </view>
      </view>
    </view>

    <!-- 虚拟头像切换 -->
    <view class="absolute top-4 left-4 z-20" style="padding-top: env(safe-area-inset-top);">
      <view @tap="useVirtualAvatar = !useVirtualAvatar" :class="['flex items-center gap-2 px-3 py-2 rounded-full transition-colors', useVirtualAvatar ? 'bg-[#C9A96E] text-white' : 'bg-white/20 text-white']">
        <text class="text-sm">👤</text>
        <text class="text-xs">{{ useVirtualAvatar ? '虚拟头像' : '真实画面' }}</text>
      </view>
    </view>

    <!-- 视频/音频区域 -->
    <view class="flex-1 flex items-center justify-center relative">
      <view v-if="callType === 'video' && isVideoOn && !useVirtualAvatar" class="w-full h-full flex items-center justify-center" style="background: linear-gradient(to bottom, #374151, #111827);">
        <text class="text-sm text-white/40">视频画面区域</text>
      </view>
      <view v-else class="flex flex-col items-center">
        <view v-if="useVirtualAvatar" class="w-32 h-32 rounded-full flex items-center justify-center mb-6" style="background: linear-gradient(to bottom right, #C41E3A, #C9A96E);">
          <text class="text-6xl text-white">👤</text>
        </view>
        <view v-else class="w-32 h-32 rounded-full bg-[#C41E3A]/20 flex items-center justify-center mb-6">
          <text class="text-3xl text-[#C41E3A]">{{ expertData.name[0] }}</text>
        </view>
        <text class="text-xl font-semibold text-white mb-2">{{ expertData.name }}</text>

        <!-- 音频波形 -->
        <view class="flex items-end gap-1 h-8 mt-4">
          <view v-for="(barHeight, i) in audioBars" :key="i" class="w-1 bg-[#C41E3A] rounded-full animate-pulse" :style="{ height: barHeight + 'px', animationDelay: (i * 0.1) + 's' }" />
        </view>
      </view>

      <!-- 小窗（自己的画面） -->
      <view v-if="callType === 'video'" class="absolute" style="top: 80px; right: 16px; width: 96px; height: 128px; overflow: hidden; border-radius: 12px; border: 2px solid rgba(255,255,255,0.2);">
        <view v-if="isVideoOn" class="w-full h-full flex items-center justify-center" style="background: linear-gradient(to bottom, #4B5563, #374151);">
          <text class="text-3xl text-white/40">👤</text>
        </view>
        <view v-else class="w-full h-full flex items-center justify-center" style="background: linear-gradient(to bottom, #4B5563, #374151);">
          <text class="text-2xl text-white/40">🚫</text>
        </view>
      </view>
    </view>

    <!-- 底部控制栏 -->
    <view class="p-6" style="padding-bottom: calc(env(safe-area-inset-bottom) + 24px);">
      <view class="flex items-center justify-center gap-6">
        <!-- 静音 -->
        <view @tap="isMuted = !isMuted" :class="['w-14 h-14 rounded-full flex items-center justify-center transition-colors', isMuted ? 'bg-red-500' : 'bg-white/20']">
          <text class="text-2xl text-white">{{ isMuted ? '🔇' : '🔊' }}</text>
        </view>

        <!-- 挂断 -->
        <view @tap="endCall" class="w-16 h-16 rounded-full bg-red-500 flex items-center justify-center">
          <text class="text-3xl text-white">📞</text>
        </view>

        <!-- 视频开关（仅视频模式） -->
        <view v-if="callType === 'video'" @tap="isVideoOn = !isVideoOn" :class="['w-14 h-14 rounded-full flex items-center justify-center transition-colors', !isVideoOn ? 'bg-red-500' : 'bg-white/20']">
          <text class="text-2xl text-white">{{ isVideoOn ? '📹' : '🚫' }}</text>
        </view>

        <!-- 转文字聊天 -->
        <view class="w-14 h-14 rounded-full bg-white/20 flex items-center justify-center">
          <text class="text-2xl text-white">💬</text>
        </view>
      </view>
    </view>

    <!-- 余额不足提醒弹窗 -->
    <view v-if="showLowBalanceWarning" class="absolute inset-0 z-50 flex items-center justify-center bg-black/60 p-6">
      <view class="w-full max-w-sm bg-white rounded-2xl p-5">
        <view class="flex items-center gap-3 mb-4">
          <view class="w-10 h-10 rounded-full bg-yellow-500/20 flex items-center justify-center">
            <text class="text-lg text-yellow-500">⚠️</text>
          </view>
          <view>
            <text class="font-semibold text-[#2C2C2C] block">余额即将不足</text>
            <text class="text-sm text-[#999]">预计还可通话约1分钟</text>
          </view>
        </view>
        <view class="flex items-center justify-between mb-4 p-3 rounded-lg bg-[#F5F1EB]">
          <text class="text-sm text-[#999]">当前余额</text>
          <text class="font-bold text-[#C9A96E]">{{ (userBalance - totalCost).toFixed(0) }}币</text>
        </view>
        <view class="flex gap-3">
          <view @tap="showLowBalanceWarning = false" class="flex-1 py-2.5 rounded-xl bg-[#F5F1EB] text-[#2C2C2C] font-medium text-center">稍后再说</view>
          <view @tap="goTo('/pages/wallet/recharge')" class="flex-1 py-2.5 rounded-xl bg-[#C41E3A] text-white font-medium text-center">立即充值</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 通话结束界面 -->
  <view v-else-if="callState === 'ended'" class="min-h-screen bg-[#FAF8F5] flex flex-col items-center justify-center p-6">
    <view class="w-20 h-20 rounded-full bg-green-500/20 flex items-center justify-center mb-6">
      <text class="text-5xl text-green-500">✅</text>
    </view>
    <text class="text-xl font-semibold text-[#2C2C2C] mb-2">通话已结束</text>
    <text class="text-[#999] mb-6">感谢你的咨询</text>

    <view class="w-full max-w-sm bg-white rounded-xl p-4 mb-6">
      <view class="flex flex-col gap-3">
        <view class="flex items-center justify-between">
          <text class="text-sm text-[#999]">通话时长</text>
          <text class="font-medium text-[#2C2C2C]">{{ formatDuration(callDuration) }}</text>
        </view>
        <view class="flex items-center justify-between">
          <text class="text-sm text-[#999]">本次消费</text>
          <text class="font-bold text-[#C41E3A]">{{ usePerMinute ? totalCost.toFixed(0) : getPrice()?.price }}币</text>
        </view>
        <view class="flex items-center justify-between">
          <text class="text-sm text-[#999]">咨询达人</text>
          <text class="font-medium text-[#2C2C2C]">{{ expertData.name }}</text>
        </view>
      </view>
    </view>

    <view class="flex gap-4 w-full max-w-sm">
      <view @tap="goBack" class="flex-1 py-3 rounded-xl bg-[#F5F1EB] text-[#2C2C2C] font-medium text-center">返回</view>
      <view @tap="callState = 'booking'" class="flex-1 py-3 rounded-xl bg-[#C41E3A] text-white font-medium text-center">再次咨询</view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, watch, onUnmounted } from 'vue'

// 导航辅助
function goBack() { uni.navigateBack() }
function goTo(url: string) { uni.navigateTo({ url }) }

type CallState = 'booking' | 'waiting' | 'connecting' | 'active' | 'ended' | 'lowBalance'

// 达人数据
const expertData = {
  id: 1,
  name: '周易大师',
  avatar: '',
  title: '八字命理资深讲师',
  status: 'online' as 'online' | 'busy' | 'offline',
  pricePerMinute: 10,
  packages: [
    { id: 1, duration: 15, price: 120, originalPrice: 150, discount: '8折' },
    { id: 2, duration: 30, price: 220, originalPrice: 300, discount: '7.3折', recommended: true },
    { id: 3, duration: 60, price: 400, originalPrice: 600, discount: '6.7折' },
  ],
  rating: 4.9,
  totalCalls: 856,
}

// 用户余额
const userBalance = 280

const callState = ref<CallState>('booking')
const callType = ref<'audio' | 'video'>('audio')
const selectedPackage = ref<number | null>(2)
const usePerMinute = ref(false)
const questionDescription = ref('')

// 通话中状态
const isMuted = ref(false)
const isVideoOn = ref(true)
const useVirtualAvatar = ref(false)
const callDuration = ref(0)
const totalCost = ref(0)
const showLowBalanceWarning = ref(false)

let timerInterval: ReturnType<typeof setInterval> | null = null

// 音频波形
const audioBars = ref<number[]>([])

// 计算价格
const getPrice = (): { type: string; price: number; duration?: number } | null => {
  if (usePerMinute.value) {
    return { type: 'perMinute', price: expertData.pricePerMinute }
  }
  const pkg = expertData.packages.find(p => p.id === selectedPackage.value)
  return pkg ? { type: 'package', price: pkg.price, duration: pkg.duration } : null
}

// 切换按分钟计费
const togglePerMinute = () => {
  usePerMinute.value = !usePerMinute.value
  selectedPackage.value = null
}

// 格式化时间
const formatDuration = (seconds: number): string => {
  const h = Math.floor(seconds / 3600)
  const m = Math.floor((seconds % 3600) / 60)
  const s = seconds % 60
  if (h > 0) {
    return `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`
  }
  return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`
}

// 开始通话
const startCall = () => {
  callState.value = 'waiting'
  // 模拟接通
  setTimeout(() => {
    callState.value = 'connecting'
    setTimeout(() => {
      callState.value = 'active'
    }, 1500)
  }, 2000)
}

// 通话计时和扣费
watch(callState, (newVal) => {
  if (newVal === 'active') {
    // 生成随机音频波形
    audioBars.value = Array.from({ length: 12 }, () => Math.random() * 24 + 8)

    timerInterval = setInterval(() => {
      callDuration.value++
      const dur = callDuration.value
      // 每30秒扣费一次
      if (dur % 30 === 0 && usePerMinute.value) {
        totalCost.value += expertData.pricePerMinute / 2
      }
      // 余额不足提醒（模拟剩余1分钟）
      if (dur === 60 && !showLowBalanceWarning.value) {
        showLowBalanceWarning.value = true
      }
    }, 1000)
  } else {
    if (timerInterval) {
      clearInterval(timerInterval)
      timerInterval = null
    }
  }
})

// 挂断
const endCall = () => {
  if (timerInterval) {
    clearInterval(timerInterval)
    timerInterval = null
  }
  callState.value = 'ended'
}

// 组件卸载时清理
onUnmounted(() => {
  if (timerInterval) {
    clearInterval(timerInterval)
    timerInterval = null
  }
})
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
@keyframes，其余样式由原子类处理 */
</style>
