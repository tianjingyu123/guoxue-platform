<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5] flex items-center px-4 h-12 gap-3">
      <view class="p-1 -ml-1" @click="goBack">
        <text class="text-xl text-[#2C2C2C]">←</text>
      </view>
      <text class="text-base font-semibold text-[#2C2C2C]">黑名单</text>
      <text class="ml-auto text-xs text-[#999] bg-[#F5F1EB] px-2 py-0.5 rounded-full">{{ blocked.length }} 人</text>
    </view>

    <!-- 错误状态 -->
    <view v-if="error" class="flex flex-col items-center justify-center py-20 text-[#999]">
      <view class="w-20 h-20 rounded-full bg-[#F5F1EB] flex items-center justify-center mb-4">
        <text class="text-3xl opacity-40">⚠️</text>
      </view>
      <text class="text-sm font-medium text-[#2C2C2C] mb-1">{{ error }}</text>
      <view @click="loadBlacklist" class="mt-4 px-6 py-2 bg-[#C41E3A] text-white rounded-xl text-sm">
        重新加载
      </view>
    </view>

    <!-- 加载骨架 -->
    <view v-else-if="loading" class="px-4 pt-4 animate-pulse">
      <view class="h-10 bg-[#E8E0D5] rounded-xl mb-4" />
      <view v-for="i in 4" :key="i" class="flex items-center gap-3 bg-white rounded-xl p-3 mb-2 border border-[#E8E0D5]">
        <view class="w-10 h-10 rounded-full bg-[#E8E0D5]" />
        <view class="flex-1">
          <view class="h-4 bg-[#E8E0D5] rounded w-1/4 mb-1.5" />
          <view class="h-3 bg-[#E8E0D5] rounded w-1/3" />
        </view>
        <view class="h-7 w-14 bg-[#E8E0D5] rounded-lg" />
      </view>
    </view>

    <view v-else class="px-4 pt-4 pb-20">
      <!-- 搜索框 -->
      <view class="relative mb-4">
        <text class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-[#999]">🔍</text>
        <input v-model="search" placeholder="搜索黑名单用户" class="w-full pl-9 h-11 bg-white rounded-xl text-sm text-[#2C2C2C] placeholder:text-[#999] outline-none px-4 pr-9 border border-[#E8E0D5]" />
        <text v-if="search" class="absolute right-3 top-1/2 -translate-y-1/2 text-sm text-[#999] w-5 h-5 flex items-center justify-center bg-[#F5F1EB] rounded-full" @click="search=''">✕</text>
      </view>

      <!-- 快捷操作 -->
      <view v-if="blocked.length > 0" class="flex items-center justify-between mb-3 px-1">
        <text class="text-xs text-[#999]">共屏蔽 {{ blocked.length }} 位用户</text>
        <view class="flex items-center gap-3">
          <text class="text-xs text-[#C41E3A]" @click="showClearConfirm = true">🗑 清空全部</text>
        </view>
      </view>

      <!-- 空状态 -->
      <view v-if="filtered.length === 0" class="flex flex-col items-center justify-center py-20 text-[#999]">
        <view class="w-20 h-20 rounded-full bg-[#F5F1EB] flex items-center justify-center mb-4">
          <text class="text-4xl opacity-40">🚫</text>
        </view>
        <text class="text-sm font-medium text-[#2C2C2C] mb-1">{{ search ? '未找到匹配用户' : '黑名单为空' }}</text>
        <text class="text-xs text-[#999]">{{ search ? '尝试更换搜索关键词' : '将用户加入黑名单后，可在此管理' }}</text>
      </view>

      <!-- 列表 -->
      <view v-else class="space-y-2">
        <view v-for="user in filtered" :key="user.id" class="flex items-center gap-3 p-3.5 bg-white border border-[#E8E0D5] rounded-2xl transition-all" :class="{'opacity-40': removing === user.id}">
          <view class="w-11 h-11 rounded-full bg-gradient-to-br from-[#C41E3A] to-[#E74C3C] flex items-center justify-center text-white text-base font-medium flex-shrink-0 shadow-sm">
            <text>{{ user.name[0] }}</text>
          </view>
          <view class="flex-1 min-w-0">
            <text class="text-sm font-medium text-[#2C2C2C] block">{{ user.name }}</text>
            <view class="flex items-center gap-2 text-xs text-[#999] mt-0.5">
              <text>拉黑于 {{ user.blockedAt }}</text>
              <text v-if="user.reason" class="text-[#C9A96E] bg-[#C9A96E]/10 px-1.5 py-0.5 rounded-full text-[10px]">{{ user.reason }}</text>
            </view>
          </view>
          <view @click="unblock(user.id)" :class="'flex items-center gap-1.5 text-xs px-3.5 py-2 rounded-xl transition-all '+(removing === user.id ? 'bg-[#F5F1EB] text-[#999]' : 'bg-[#C41E3A]/10 text-[#C41E3A] active:bg-[#C41E3A]/20')">
            <text>{{ removing === user.id ? '⏳' : '✓' }}</text>
            <text>{{ removing === user.id ? '移除中' : '移除' }}</text>
          </view>
        </view>
      </view>

      <!-- 提示 -->
      <view v-if="blocked.length > 0" class="mt-6 bg-white rounded-2xl p-4 border border-[#E8E0D5]">
        <view class="flex items-start gap-2.5">
          <text class="text-base text-[#C9A96E] shrink-0 mt-0.5">💡</text>
          <view>
            <text class="text-xs font-medium text-[#2C2C2C] block mb-1">关于黑名单</text>
            <text class="text-xs text-[#999] leading-relaxed">黑名单用户无法查看您的内容、向您发送消息或在您的圈子发言。移除后对方将恢复正常互动权限。黑名单上限为 200 人。</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 清空确认弹窗 -->
    <view v-if="showClearConfirm" class="fixed inset-0 z-50 bg-black/40 flex items-center justify-center p-6" @click="showClearConfirm=false">
      <view class="bg-white rounded-3xl w-full max-w-sm overflow-hidden shadow-xl" @click.stop>
        <view class="px-6 pt-6 pb-2 text-center">
          <view class="w-16 h-16 rounded-full bg-[#C41E3A]/10 flex items-center justify-center mx-auto mb-3">
            <text class="text-3xl">⚠️</text>
          </view>
          <text class="text-base font-bold text-[#2C2C2C] block mb-1">清空黑名单</text>
          <text class="text-xs text-[#999]">将移除全部 {{ blocked.length }} 位屏蔽用户，此操作不可撤销</text>
        </view>
        <view class="flex border-t border-[#E8E0D5] mt-4">
          <view class="flex-1 h-12 flex items-center justify-center text-sm text-[#999] bg-[#FAF8F5] active:bg-[#F5F1EB]" @click="showClearConfirm=false">取消</view>
          <view class="flex-1 h-12 flex items-center justify-center text-sm text-white bg-[#C41E3A] active:bg-[#B01A31]" @click="clearAll">确认清空</view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

const loading = ref(true)
const error = ref<string | null>(null)

interface BlockedUser {
  id: string
  name: string
  avatar?: string
  blockedAt: string
  reason?: string
}

const blocked = ref<BlockedUser[]>([
  { id: '1', name: '用户123456', blockedAt: '2024年1月18日', reason: '骚扰言论' },
  { id: '2', name: '匿名用户', blockedAt: '2024年1月10日', reason: '广告推广' },
  { id: '3', name: '神秘访客', blockedAt: '2023年12月25日' },
  { id: '4', name: '刷屏机器', blockedAt: '2024年1月05日', reason: '恶意刷屏' },
  { id: '5', name: '言论不当', blockedAt: '2024年1月02日', reason: '违规内容' },
  { id: '6', name: '恶意举报', blockedAt: '2023年12月28日', reason: '恶意举报他人' },
])

const search = ref('')
const removing = ref<string | null>(null)
const showClearConfirm = ref(false)

const filtered = computed(() => {
  if (!search.value) return blocked.value
  return blocked.value.filter(u => u.name.includes(search.value))
})

onMounted(() => { loadBlacklist() })

async function loadBlacklist() {
  try {
    error.value = null
    loading.value = true
    await new Promise(r => setTimeout(r, 500))
    loading.value = false
  } catch (e) {
    error.value = '加载失败，请重试'
    loading.value = false
  }
}

async function unblock(id: string) {
  removing.value = id
  await new Promise(r => setTimeout(r, 600))
  blocked.value = blocked.value.filter(u => u.id !== id)
  removing.value = null
  uni.showToast({ title: '已移除', icon: 'success' })
}

function clearAll() {
  blocked.value = []
  showClearConfirm.value = false
  uni.showToast({ title: '黑名单已清空', icon: 'success' })
}

function goBack() {
  uni.navigateBack()
}
</script>
<style scoped>
/* 样式由 Tailwind 处理 */
</style>
