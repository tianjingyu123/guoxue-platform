<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 py-3">
        <view class="flex items-center gap-3">
          <view class="p-1 -ml-1" @click="goBack">
            <text class="text-xl text-[#2C2C2C]">←</text>
          </view>
          <text class="text-lg font-semibold text-[#2C2C2C]">通知设置</text>
        </view>
      </view>
    </view>

    <view class="p-4 space-y-4">
      <!-- 总开关 -->
      <view class="bg-white rounded-xl p-4">
        <view class="flex items-center justify-between">
          <view class="flex items-center gap-3">
            <view :class="['w-10 h-10 rounded-xl flex items-center justify-center', pushEnabled ? 'bg-[#C41E3A]/10' : 'bg-[#F2EFEA]']">
              <text :class="pushEnabled ? 'text-[#C41E3A]' : 'text-[#999]'">{{ pushEnabled ? '🔔' : '🔕' }}</text>
            </view>
            <view>
              <text class="font-medium text-[#2C2C2C] block">接收推送通知</text>
              <text class="text-xs text-[#999]">{{ pushEnabled ? '已开启，将收到各类通知提醒' : '已关闭，将不会收到任何推送' }}</text>
            </view>
          </view>
          <view :class="['w-11 h-6 rounded-full relative transition-colors', pushEnabled ? 'bg-[#C41E3A]' : 'bg-[#E8E0D5]']" @click="pushEnabled = !pushEnabled">
            <view :class="['w-5 h-5 rounded-full bg-white absolute top-0.5 shadow transition-transform', pushEnabled ? 'translate-x-[1.375rem]' : 'translate-x-0.5']" />
          </view>
        </view>
      </view>

      <!-- 以下设置在总开关关闭时禁用 -->
      <view :class="!pushEnabled ? 'opacity-50 pointer-events-none' : ''">
        <!-- 互动通知 -->
        <view class="bg-white rounded-xl overflow-hidden">
          <view class="px-4 py-2.5 border-b border-[#E8E0D5]">
            <text class="text-xs text-[#999] font-medium">互动通知</text>
          </view>
          <view class="divide-y divide-[#E8E0D5]">
            <view v-for="item in interactionItems" :key="item.id" class="px-4 py-3 flex items-center justify-between">
              <view class="flex items-center gap-3">
                <view class="w-8 h-8 rounded-lg bg-[#C41E3A]/10 flex items-center justify-center">
                  <text class="text-sm text-[#C41E3A]">{{ item.icon }}</text>
                </view>
                <view>
                  <text class="text-sm font-medium text-[#2C2C2C] block">{{ item.title }}</text>
                  <text class="text-[10px] text-[#999]">{{ item.desc }}</text>
                </view>
              </view>
              <view :class="['w-11 h-6 rounded-full relative transition-colors', item.checked ? 'bg-[#C41E3A]' : 'bg-[#E8E0D5]']" @click="toggleSwitch(item)">
                <view :class="['w-5 h-5 rounded-full bg-white absolute top-0.5 shadow transition-transform', item.checked ? 'translate-x-[1.375rem]' : 'translate-x-0.5']" />
              </view>
            </view>
          </view>
        </view>

        <!-- 内容更新 -->
        <view class="bg-white rounded-xl overflow-hidden mt-4">
          <view class="px-4 py-2.5 border-b border-[#E8E0D5]">
            <text class="text-xs text-[#999] font-medium">内容更新</text>
          </view>
          <view class="divide-y divide-[#E8E0D5]">
            <view v-for="item in contentItems" :key="item.id" class="px-4 py-3 flex items-center justify-between">
              <view class="flex items-center gap-3">
                <view class="w-8 h-8 rounded-lg bg-[#C41E3A]/10 flex items-center justify-center">
                  <text class="text-sm text-[#C41E3A]">{{ item.icon }}</text>
                </view>
                <view>
                  <text class="text-sm font-medium text-[#2C2C2C] block">{{ item.title }}</text>
                  <text class="text-[10px] text-[#999]">{{ item.desc }}</text>
                </view>
              </view>
              <view :class="['w-11 h-6 rounded-full relative transition-colors', item.checked ? 'bg-[#C41E3A]' : 'bg-[#E8E0D5]']" @click="toggleSwitch(item)">
                <view :class="['w-5 h-5 rounded-full bg-white absolute top-0.5 shadow transition-transform', item.checked ? 'translate-x-[1.375rem]' : 'translate-x-0.5']" />
              </view>
            </view>
          </view>
        </view>

        <!-- 交易通知 -->
        <view class="bg-white rounded-xl overflow-hidden mt-4">
          <view class="px-4 py-2.5 border-b border-[#E8E0D5]">
            <text class="text-xs text-[#999] font-medium">交易通知</text>
          </view>
          <view class="divide-y divide-[#E8E0D5]">
            <view v-for="item in tradeItems" :key="item.id" class="px-4 py-3 flex items-center justify-between">
              <view class="flex items-center gap-3">
                <view :class="['w-8 h-8 rounded-lg flex items-center justify-center', item.important ? 'bg-amber-500/10' : 'bg-[#C41E3A]/10']">
                  <text :class="item.important ? 'text-amber-500' : 'text-[#C41E3A]'">{{ item.icon }}</text>
                </view>
                <view>
                  <view class="flex items-center gap-1">
                    <text class="text-sm font-medium text-[#2C2C2C]">{{ item.title }}</text>
                    <text v-if="item.important" class="text-[10px] text-amber-500 font-medium">重要</text>
                  </view>
                  <text class="text-[10px] text-[#999]">{{ item.desc }}</text>
                </view>
              </view>
              <view :class="['w-11 h-6 rounded-full relative transition-colors', item.checked ? 'bg-[#C41E3A]' : 'bg-[#E8E0D5]']" @click="toggleSwitch(item)">
                <view :class="['w-5 h-5 rounded-full bg-white absolute top-0.5 shadow transition-transform', item.checked ? 'translate-x-[1.375rem]' : 'translate-x-0.5']" />
              </view>
            </view>
          </view>
        </view>

        <!-- 系统通知 -->
        <view class="bg-white rounded-xl overflow-hidden mt-4">
          <view class="px-4 py-2.5 border-b border-[#E8E0D5]">
            <text class="text-xs text-[#999] font-medium">系统通知</text>
          </view>
          <view class="divide-y divide-[#E8E0D5]">
            <view v-for="item in systemItems" :key="item.id" class="px-4 py-3 flex items-center justify-between">
              <view class="flex items-center gap-3">
                <view class="w-8 h-8 rounded-lg bg-[#C41E3A]/10 flex items-center justify-center">
                  <text class="text-sm text-[#C41E3A]">{{ item.icon }}</text>
                </view>
                <view>
                  <text class="text-sm font-medium text-[#2C2C2C] block">{{ item.title }}</text>
                  <text class="text-[10px] text-[#999]">{{ item.desc }}</text>
                </view>
              </view>
              <view :class="['w-11 h-6 rounded-full relative transition-colors', item.checked ? 'bg-[#C41E3A]' : 'bg-[#E8E0D5]']" @click="toggleSwitch(item)">
                <view :class="['w-5 h-5 rounded-full bg-white absolute top-0.5 shadow transition-transform', item.checked ? 'translate-x-[1.375rem]' : 'translate-x-0.5']" />
              </view>
            </view>
          </view>
        </view>

        <!-- 免打扰模式 -->
        <view class="bg-white rounded-xl overflow-hidden mt-4">
          <view class="px-4 py-2.5 border-b border-[#E8E0D5]">
            <text class="text-xs text-[#999] font-medium">免打扰模式</text>
          </view>
          <view class="divide-y divide-[#E8E0D5]">
            <view class="px-4 py-3 flex items-center justify-between">
              <view class="flex items-center gap-3">
                <view class="w-8 h-8 rounded-lg bg-[#C9A96E]/10 flex items-center justify-center">
                  <text class="text-sm text-[#C9A96E]">🌙</text>
                </view>
                <view>
                  <text class="text-sm font-medium text-[#2C2C2C] block">开启免打扰</text>
                  <text class="text-[10px] text-[#999]">在指定时间段内不接收推送通知</text>
                </view>
              </view>
              <view :class="['w-11 h-6 rounded-full relative transition-colors', quietModeEnabled ? 'bg-[#C41E3A]' : 'bg-[#E8E0D5]']" @click="quietModeEnabled = !quietModeEnabled">
                <view :class="['w-5 h-5 rounded-full bg-white absolute top-0.5 shadow transition-transform', quietModeEnabled ? 'translate-x-[1.375rem]' : 'translate-x-0.5']" />
              </view>
            </view>

            <view v-if="quietModeEnabled" class="px-4 py-3 flex items-center justify-between">
              <view class="flex items-center gap-3 ml-11">
                <text class="text-sm text-[#999]">免打扰时段</text>
              </view>
              <view class="flex items-center gap-2">
                <picker mode="selector" :range="timeOptions" @change="(e: any) => quietStart = timeOptions[e.detail.value]">
                  <text class="text-xs bg-[#F2EFEA] rounded-md px-2 py-1 text-[#2C2C2C]">{{ quietStart }}</text>
                </picker>
                <text class="text-[#999]">-</text>
                <picker mode="selector" :range="timeOptions" @change="(e: any) => quietEnd = timeOptions[e.detail.value]">
                  <text class="text-xs bg-[#F2EFEA] rounded-md px-2 py-1 text-[#2C2C2C]">{{ quietEnd }}</text>
                </picker>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 提示 -->
      <text class="text-[10px] text-[#999] text-center block px-4">关闭通知后，您仍可在消息中心查看相关消息</text>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref } from 'vue'

const pushEnabled = ref(true)
const quietModeEnabled = ref(true)
const quietStart = ref('22:00')
const quietEnd = ref('08:00')

const timeOptions = ['00:00', '01:00', '02:00', '03:00', '04:00', '05:00', '06:00', '07:00', '08:00', '09:00', '10:00', '11:00', '12:00', '13:00', '14:00', '15:00', '16:00', '17:00', '18:00', '19:00', '20:00', '21:00', '22:00', '23:00']

interface SwitchItem {
  id: string; icon: string; title: string; desc: string; checked: boolean; important?: boolean
}

const interactionItems = ref<SwitchItem[]>([
  { id: 'comment', icon: '💬', title: '评论通知', desc: '有人评论您的内容时通知', checked: true },
  { id: 'like', icon: '❤️', title: '点赞通知', desc: '有人点赞您的内容时通知', checked: true },
  { id: 'follow', icon: '👥', title: '关注通知', desc: '有人关注您时通知', checked: true },
  { id: 'mention', icon: '@', title: '@提及通知', desc: '有人@您时通知', checked: true },
  { id: 'message', icon: '💬', title: '私信通知', desc: '收到私信时通知', checked: true },
])

const contentItems = ref<SwitchItem[]>([
  { id: 'circle', icon: '👥', title: '圈子更新', desc: '关注的圈子有新内容时通知', checked: true },
  { id: 'live', icon: '📺', title: '直播开播', desc: '预约的直播开播时通知', checked: true },
  { id: 'course', icon: '📱', title: '课程更新', desc: '订阅的课程有新章节时通知', checked: true },
  { id: 'activity', icon: '📅', title: '活动提醒', desc: '报名的活动即将开始时通知', checked: true },
])

const tradeItems = ref<SwitchItem[]>([
  { id: 'order', icon: '🛍️', title: '订单通知', desc: '订单状态变更时通知', checked: true },
  { id: 'income', icon: '💰', title: '收益通知', desc: '有新收益到账时通知', checked: true },
  { id: 'expiry', icon: '⏰', title: '到期提醒', desc: '会员、圈子等即将到期时通知', checked: true, important: true },
])

const systemItems = ref<SwitchItem[]>([
  { id: 'system', icon: '🔔', title: '系统消息', desc: '平台公告、安全提醒等重要通知', checked: true },
  { id: 'promo', icon: '📧', title: '营销推广', desc: '优惠活动、新功能推荐等', checked: false },
])

function toggleSwitch(item: SwitchItem) {
  item.checked = !item.checked
}

function goBack() { uni.navigateBack() }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
