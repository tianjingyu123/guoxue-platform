<template>
  <!-- 骨架屏 -->
  <view v-if="loading" class="min-h-screen bg-[#FAF8F5]">
    <view class="sticky top-0 z-10 bg-white" style="border-bottom: 1px solid #E8E0D5;">
      <view class="flex items-center justify-between px-4 py-3">
        <view class="w-6 h-6 bg-gray-200 rounded animate-pulse" />
        <view class="w-16 h-5 bg-gray-200 rounded animate-pulse" />
        <view class="w-6 h-6 bg-gray-200 rounded animate-pulse" />
      </view>
    </view>
    <view class="flex" style="height: calc(100vh - 52px);">
      <view class="w-24 bg-[#F5F2EF]" style="border-right: 1px solid #E8E0D5;">
        <view v-for="i in 8" :key="i" class="h-12 bg-gray-200 rounded animate-pulse m-2" />
      </view>
      <view class="flex-1 p-4">
        <view class="grid grid-cols-2 gap-3">
          <view v-for="i in 6" :key="i" class="bg-white rounded-xl p-3 animate-pulse">
            <view class="aspect-square bg-gray-200 rounded-lg mb-2" />
            <view class="h-4 bg-gray-200 rounded w-3/4 mb-1" />
            <view class="h-4 bg-gray-200 rounded w-1/2" />
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 主内容 -->
  <view v-else class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-10 bg-white" style="border-bottom: 1px solid #E8E0D5;">
      <view class="flex items-center justify-between px-4 py-3">
        <view @click="goBack" class="p-1">
          <text class="text-lg text-[#2C2C2C]">←</text>
        </view>
        <text class="font-semibold text-[#2C2C2C]">商品分类</text>
        <view @click="goTo('/pages/shop/search')" class="p-1">
          <text class="text-lg text-[#2C2C2C]">🔍</text>
        </view>
      </view>
    </view>

    <!-- 双栏布局 -->
    <view class="flex" style="height: calc(100vh - 52px);">
      <!-- 左侧一级分类 -->
      <view class="w-24 bg-[#F5F2EF] overflow-y-auto flex-shrink-0" style="border-right: 1px solid #E8E0D5;">
        <view
          v-for="category in categories"
          :key="category.id"
          @click="handleCategoryClick(category.id)"
          :class="['w-full py-4 px-2 text-center text-sm transition-all relative', selectedCategory === category.id ? 'bg-white text-[#C41E3A] font-medium' : 'text-[#666666]']"
        >
          <view v-if="selectedCategory === category.id" class="absolute left-0 top-1/2 -translate-y-1/2 w-1 h-8 bg-[#C41E3A] rounded-r" />
          <view class="text-lg mb-1"><text>{{ category.icon }}</text></view>
          <view class="leading-tight"><text>{{ category.name }}</text></view>
        </view>
      </view>

      <!-- 右侧内容区 -->
      <view class="flex-1 overflow-y-auto">
        <!-- 二级分类标签 -->
        <view v-if="currentCategory?.children && currentCategory.children.length > 0" class="sticky top-0 z-10 bg-white px-4 py-3" style="border-bottom: 1px solid #E8E0D5;">
          <view class="flex flex-wrap gap-2">
            <view
              v-for="sub in currentCategory.children"
              :key="sub.id"
              @click="selectedSubCategory = sub.id; loadProducts(sub.id)"
              :class="['px-3 py-1.5 rounded-full text-sm transition-all', selectedSubCategory === sub.id ? 'bg-[#C41E3A] text-white' : 'bg-[#F5F2EF] text-[#666666]']"
            >
              <text>{{ sub.name }}</text>
            </view>
          </view>
        </view>

        <!-- 商品列表 -->
        <view class="p-3">
          <view v-if="productsLoading" class="grid grid-cols-2 gap-3">
            <view v-for="i in 6" :key="i" class="bg-white rounded-xl p-3 animate-pulse">
              <view class="aspect-square bg-gray-200 rounded-lg mb-2" />
              <view class="h-4 bg-gray-200 rounded w-3/4 mb-1" />
              <view class="h-4 bg-gray-200 rounded w-1/2" />
            </view>
          </view>
          <view v-else-if="products.length > 0" class="grid grid-cols-2 gap-3">
            <view
              v-for="product in products"
              :key="product.id"
              @click="goTo('/pages/shop/id-detail/index?id=' + product.id)"
              class="bg-white rounded-xl p-3 shadow-sm"
            >
              <view class="aspect-square rounded-lg overflow-hidden mb-2 bg-[#F5F2EF]">
                <image :src="product.cover" :alt="product.name" class="w-full h-full" mode="aspectFill" />
              </view>
              <text class="text-sm text-[#2C2C2C] font-medium line-clamp-2 mb-1 block">{{ product.name }}</text>
              <view class="flex items-baseline gap-1">
                <text class="text-[#C41E3A] font-bold">¥{{ product.price }}</text>
                <text v-if="product.originalPrice > product.price" class="text-xs text-[#999999] line-through">¥{{ product.originalPrice }}</text>
              </view>
              <view class="text-xs text-[#999999] mt-1">已售 {{ product.sales }}</view>
            </view>
          </view>
          <view v-else class="flex flex-col items-center justify-center py-20">
            <view class="w-20 h-20 rounded-full bg-[#F5F2EF] flex items-center justify-center mb-4">
              <text class="text-2xl text-[#999999]">🔍</text>
            </view>
            <text class="text-[#999999]">暂无商品</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

interface ProductCategory {
  id: string
  name: string
  icon: string
  children?: { id: string; name: string; icon: string }[]
}

interface Product {
  id: string
  name: string
  cover: string
  price: number
  originalPrice: number
  sales: number
  rating: number
  category: string
}

const mockCategories: ProductCategory[] = [
  { id: '1', name: '国学书籍', icon: '📚', children: [
    { id: '1-1', name: '经典原著', icon: '' }, { id: '1-2', name: '注解版本', icon: '' }, { id: '1-3', name: '入门读物', icon: '' },
  ]},
  { id: '2', name: '文房用品', icon: '✒️', children: [
    { id: '2-1', name: '毛笔', icon: '' }, { id: '2-2', name: '宣纸', icon: '' }, { id: '2-3', name: '墨砚', icon: '' },
  ]},
  { id: '3', name: '香道用品', icon: '🪔', children: [
    { id: '3-1', name: '线香', icon: '' }, { id: '3-2', name: '香炉', icon: '' }, { id: '3-3', name: '沉香', icon: '' },
  ]},
  { id: '4', name: '茶道用品', icon: '🍵', children: [
    { id: '4-1', name: '茶具套装', icon: '' }, { id: '4-2', name: '茶叶', icon: '' }, { id: '4-3', name: '茶盘', icon: '' },
  ]},
  { id: '5', name: '养生保健', icon: '🏥', children: [
    { id: '5-1', name: '艾灸用品', icon: '' }, { id: '5-2', name: '按摩器具', icon: '' }, { id: '5-3', name: '养生食材', icon: '' },
  ]},
  { id: '6', name: '风水摆件', icon: '🏺', children: [
    { id: '6-1', name: '招财摆件', icon: '' }, { id: '6-2', name: '化煞物品', icon: '' }, { id: '6-3', name: '水晶', icon: '' },
  ]},
  { id: '7', name: '佛道用品', icon: '🙏', children: [
    { id: '7-1', name: '佛像', icon: '' }, { id: '7-2', name: '念珠', icon: '' }, { id: '7-3', name: '供品', icon: '' },
  ]},
  { id: '8', name: '乐器', icon: '🎸', children: [
    { id: '8-1', name: '古琴', icon: '' }, { id: '8-2', name: '箫笛', icon: '' }, { id: '8-3', name: '古筝', icon: '' },
  ]},
]

const mockProductsData: Product[] = Array.from({ length: 12 }, (_, i) => ({
  id: `p${i + 1}`,
  name: ['易经全解', '毛笔套装', '沉香线香', '紫砂茶壶', '艾灸盒', '招财貔貅', '小叶紫檀念珠', '古琴入门'][i % 8],
  cover: `https://picsum.photos/200/200?random=${i + 100}`,
  price: [128, 89, 168, 299, 68, 388, 258, 1999][i % 8],
  originalPrice: [168, 128, 218, 399, 98, 488, 328, 2599][i % 8],
  sales: Math.floor(Math.random() * 1000) + 100,
  rating: +(4.5 + Math.random() * 0.5).toFixed(1),
  category: ['1-1', '2-1', '3-1', '4-1', '5-1', '6-1', '7-2', '8-1'][i % 8],
}))

const loading = ref(true)
const categories = ref<ProductCategory[]>([])
const products = ref<Product[]>([])
const selectedCategory = ref('')
const selectedSubCategory = ref('')
const productsLoading = ref(false)

const currentCategory = computed(() => categories.value.find(c => c.id === selectedCategory.value))

onMounted(() => {
  loadCategories()
})

function loadCategories() {
  setTimeout(() => {
    categories.value = mockCategories
    selectedCategory.value = mockCategories[0].id
    if (mockCategories[0].children?.length) {
      selectedSubCategory.value = mockCategories[0].children[0].id
      loadProducts(mockCategories[0].children[0].id)
    }
    loading.value = false
  }, 500)
}

function loadProducts(categoryId: string) {
  productsLoading.value = true
  setTimeout(() => {
    products.value = mockProductsData.filter(p => p.category === categoryId).slice(0, 6)
    if (products.value.length === 0) products.value = mockProductsData.slice(0, 6)
    productsLoading.value = false
  }, 300)
}

function handleCategoryClick(categoryId: string) {
  selectedCategory.value = categoryId
  const category = categories.value.find(c => c.id === categoryId)
  if (category?.children?.length) {
    selectedSubCategory.value = category.children[0].id
    loadProducts(category.children[0].id)
  }
}

function goTo(url: string) {
  uni.navigateTo({ url })
}

function goBack() {
  uni.navigateBack()
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
