<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-20 text-white" style="background: linear-gradient(90deg, #FF6B35, #C41E3A);">
      <view class="px-4 py-3 flex items-center gap-3">
        <view @click="goBack" class="p-1 -ml-1">
          <text class="text-lg text-white">←</text>
        </view>
        <text class="text-lg font-bold font-serif">拼团特惠</text>
      </view>
      <!-- Tab切换 -->
      <view class="flex px-4 pb-3 gap-4">
        <view
          v-for="item in tabs"
          :key="item.key"
          @click="tab = item.key"
          :class="['pb-2 px-2 text-sm font-medium border-b-2 transition-all', tab === item.key ? 'border-white text-white' : 'border-transparent text-white/70']"
        >
          <text>{{ item.label }}</text>
          <text v-if="item.key === 'my' && myGroups.length > 0" class="ml-1 px-1.5 py-0.5 bg-white/20 rounded-full text-xs">{{ myGroups.length }}</text>
        </view>
      </view>
    </view>

    <!-- 拼团说明横幅 -->
    <view class="mx-4 mt-4 p-3 rounded-xl flex items-center gap-3" style="background: linear-gradient(90deg, #FFF5E6, #FFE8D6);">
      <view class="w-10 h-10 rounded-full flex items-center justify-center" style="background: linear-gradient(135deg, #FF6B35, #C41E3A);">
        <text class="text-white text-lg">👥</text>
      </view>
      <view class="flex-1">
        <text class="text-sm font-medium text-[#2C2C2C] block">邀请好友一起拼团</text>
        <text class="text-xs text-[#666666] block">人越多越便宜，拼团成功立享优惠</text>
      </view>
      <text class="text-sm text-[#999999]">›</text>
    </view>

    <!-- 骨架屏 -->
    <view v-if="loading" class="p-4 space-y-4">
      <view v-for="i in 3" :key="i" class="bg-white rounded-2xl p-4 animate-pulse">
        <view class="flex gap-3">
          <view class="w-24 h-24 bg-gray-200 rounded-xl" />
          <view class="flex-1 space-y-2">
            <view class="h-5 bg-gray-200 rounded w-3/4" />
            <view class="h-4 bg-gray-200 rounded w-1/2" />
            <view class="h-8 bg-gray-200 rounded w-full mt-4" />
          </view>
        </view>
      </view>
    </view>

    <!-- 全部拼团 -->
    <view v-else-if="tab === 'all'" class="p-4 space-y-4">
      <view v-for="item in groupBuys" :key="item.id" class="bg-white rounded-2xl p-4 shadow-sm">
        <view class="flex gap-3">
          <view class="relative w-24 h-24 rounded-xl overflow-hidden flex-shrink-0 bg-[#FAF8F5] flex items-center justify-center">
            <text class="text-2xl text-[#999]">📦</text>
            <view v-if="item.status === 'success'" class="absolute inset-0 bg-black/50 flex items-center justify-center">
              <text class="text-white text-xs font-medium">已成团</text>
            </view>
          </view>
          <view class="flex-1 min-w-0">
            <text class="font-medium text-[#2C2C2C] truncate block">{{ item.title }}</text>
            <view class="flex items-baseline gap-2 mt-1">
              <text class="text-[#C41E3A] text-lg font-bold">¥{{ item.price }}</text>
              <text class="text-[#999999] text-xs line-through">¥{{ item.originalPrice }}</text>
              <text class="px-1.5 py-0.5 bg-[#FFF0F0] text-[#C41E3A] text-xs rounded">省{{ item.originalPrice - item.price }}元</text>
            </view>
            <view class="mt-2">
              <view class="flex items-center justify-between text-xs text-[#666666] mb-1">
                <text>已拼 {{ item.currentMembers }}/{{ item.minMembers }} 人</text>
                <view class="flex items-center gap-1 text-[#FF6B35]">
                  <text>⏰</text>
                  <text>{{ formatCountdown(item.endTime) }}</text>
                </view>
              </view>
              <view class="h-1.5 bg-[#F5F5F5] rounded-full overflow-hidden">
                <view class="h-full rounded-full transition-all" :style="{ width: Math.round(item.currentMembers / item.minMembers * 100) + '%', background: 'linear-gradient(90deg, #FF6B35, #C41E3A)' }" />
              </view>
            </view>
          </view>
        </view>
        <view class="flex gap-3 mt-4">
          <view @click="handleJoin(item.id)" class="flex-1 py-2.5 text-white text-sm font-medium rounded-full text-center" style="background: linear-gradient(90deg, #FF6B35, #C41E3A);">
            去拼团
          </view>
          <view @click="handleCreate(item.id)" class="flex-1 py-2.5 border border-[#C41E3A] text-[#C41E3A] text-sm font-medium rounded-full flex items-center justify-center gap-1">
            <text class="text-sm">📤</text>
            <text>开新团</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 我的拼团 -->
    <view v-else class="p-4 space-y-4">
      <view v-if="myGroups.length === 0" class="py-16 text-center">
        <view class="w-20 h-20 mx-auto mb-4 bg-[#F5F5F5] rounded-full flex items-center justify-center">
          <text class="text-3xl text-[#CCCCCC]">👥</text>
        </view>
        <text class="text-[#999999] mb-4 block">暂无拼团记录</text>
        <view @click="tab = 'all'" class="px-6 py-2 bg-[#C41E3A] text-white text-sm rounded-full inline-block">
          去拼团
        </view>
      </view>
      <view v-else>
        <view v-for="item in myGroups" :key="item.id" class="bg-white rounded-2xl p-4 shadow-sm">
          <view class="flex items-center justify-between mb-3">
            <text :class="['px-2 py-0.5 text-white text-xs rounded', statusMap[item.status].color]">{{ statusMap[item.status].text }}</text>
            <text v-if="item.isOwner" class="px-2 py-0.5 text-xs rounded" style="background: rgba(201,169,110,0.1); color: #C9A96E;">团长</text>
          </view>
          <view class="flex gap-3">
            <view class="w-20 h-20 rounded-xl bg-[#FAF8F5] flex items-center justify-center flex-shrink-0">
              <text class="text-2xl text-[#999]">📦</text>
            </view>
            <view class="flex-1 min-w-0">
              <text class="font-medium text-[#2C2C2C] truncate block">{{ item.productName }}</text>
              <text class="text-[#C41E3A] font-bold mt-1 block">¥{{ item.price }}</text>
              <view class="flex items-center gap-2 mt-2">
                <view class="flex -space-x-2">
                  <view v-for="(m, mi) in item.members.slice(0, 4)" :key="mi" class="w-6 h-6 rounded-full border-2 border-white bg-[#E8E0D5] flex items-center justify-center">
                    <text class="text-[10px] text-[#666]">{{ m.name[0] }}</text>
                  </view>
                  <view v-for="i in item.minMembers - item.members.length" :key="'e-' + i" class="w-6 h-6 rounded-full border-2 border-white bg-[#F5F5F5] flex items-center justify-center">
                    <text class="text-[10px] text-[#CCCCCC]">?</text>
                  </view>
                </view>
                <text class="text-xs text-[#666666]">还差{{ item.minMembers - item.currentMembers }}人成团</text>
              </view>
            </view>
          </view>
          <view v-if="item.status === 'pending'" class="flex items-center justify-between mt-4 pt-4" style="border-top: 1px solid #F5F5F5;">
            <view class="flex items-center gap-1 text-sm text-[#666666]">
              <text>⏰</text>
              <text>剩余 {{ formatCountdown(item.endTime) }}</text>
            </view>
            <view @click="handleShareClick(item)" class="px-4 py-1.5 bg-[#C41E3A] text-white text-sm rounded-full flex items-center gap-1">
              <text class="text-sm">📤</text>
              <text>邀请好友</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 分享弹窗 -->
    <view v-if="showSharePanel && shareTarget" class="fixed inset-0 z-50">
      <view class="absolute inset-0 bg-black/50" @click="showSharePanel = false" />
      <view class="absolute bottom-0 left-0 right-0 bg-white rounded-t-3xl overflow-hidden">
        <view class="relative p-4 pb-0">
          <view @click="showSharePanel = false" class="absolute right-4 top-4 w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center">
            <text class="text-lg text-gray-500">✕</text>
          </view>
          <text class="text-lg font-bold text-center block">邀请好友参团</text>
          <text class="text-sm text-gray-500 text-center mt-1 block">
            还差 <text class="text-[#C41E3A] font-bold">{{ shareTarget.minMembers - shareTarget.currentMembers }}</text> 人即可成团
          </text>
        </view>
        <view class="mx-4 mt-4 p-3 bg-gray-50 rounded-xl flex gap-3">
          <view class="w-16 h-16 rounded-lg bg-gray-200 flex items-center justify-center">
            <text class="text-lg">📦</text>
          </view>
          <view class="flex-1 min-w-0">
            <text class="font-medium text-sm truncate block">{{ shareTarget.productName }}</text>
            <text class="text-[#C41E3A] font-bold mt-1 block">¥{{ shareTarget.price }}</text>
          </view>
        </view>
        <view class="p-4">
          <text class="text-sm text-gray-500 mb-3 block">分享至</text>
          <view class="grid grid-cols-4 gap-4">
            <view class="flex flex-col items-center gap-2">
              <view class="w-12 h-12 rounded-full bg-green-500 flex items-center justify-center">
                <text class="text-white text-lg">💬</text>
              </view>
              <text class="text-xs text-gray-600">微信好友</text>
            </view>
            <view class="flex flex-col items-center gap-2">
              <view class="w-12 h-12 rounded-full bg-green-600 flex items-center justify-center">
                <text class="text-white text-lg">👥</text>
              </view>
              <text class="text-xs text-gray-600">朋友圈</text>
            </view>
            <view class="flex flex-col items-center gap-2">
              <view class="w-12 h-12 rounded-full bg-gray-700 flex items-center justify-center">
                <text class="text-white text-lg">📱</text>
              </view>
              <text class="text-xs text-gray-600">二维码</text>
            </view>
            <view @click="handleCopyLink" class="flex flex-col items-center gap-2">
              <view class="w-12 h-12 rounded-full bg-blue-500 flex items-center justify-center">
                <text class="text-white text-lg">📋</text>
              </view>
              <text class="text-xs text-gray-600">复制链接</text>
            </view>
          </view>
        </view>
        <view class="px-4 pb-8 pt-2">
          <view class="p-3 rounded-lg" style="background: #FFF5E6;">
            <text class="text-xs text-[#FF6B35] text-center block">分享给好友，TA购买后即可帮你成团，成团后自动发货</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted, onBeforeUnmount } from 'vue'

interface GroupBuy {
  id: string; title: string; cover: string; price: number; originalPrice: number
  minMembers: number; currentMembers: number; endTime: string; status: string
}
interface GroupMember { id: string; name: string; avatar: string }
interface MyGroupBuy {
  id: string; productId: string; productName: string; productCover: string
  price: number; status: 'pending' | 'success' | 'failed'
  members: GroupMember[]; minMembers: number; currentMembers: number
  endTime: string; createdAt: string; isOwner: boolean
}

const mockGroupBuys: GroupBuy[] = [
  { id: '1', title: '周易六十四卦详解', cover: '/placeholder.svg', price: 99, originalPrice: 168, minMembers: 3, currentMembers: 2, endTime: new Date(Date.now() + 8 * 3600000).toISOString(), status: 'ongoing' },
  { id: '2', title: '紫微斗数入门精讲', cover: '/placeholder.svg', price: 128, originalPrice: 238, minMembers: 5, currentMembers: 3, endTime: new Date(Date.now() + 12 * 3600000).toISOString(), status: 'ongoing' },
  { id: '3', title: '风水学基础教程', cover: '/placeholder.svg', price: 68, originalPrice: 128, minMembers: 3, currentMembers: 3, endTime: new Date(Date.now() - 3600000).toISOString(), status: 'success' },
]

const mockMyGroups: MyGroupBuy[] = [
  { id: 'g1', productId: '1', productName: '周易六十四卦详解', productCover: '/placeholder.svg', price: 99, status: 'pending', members: [{ id: 'u1', name: '张三', avatar: '/placeholder.svg' }, { id: 'u2', name: '李四', avatar: '/placeholder.svg' }], minMembers: 3, currentMembers: 2, endTime: new Date(Date.now() + 6 * 3600000).toISOString(), createdAt: new Date(Date.now() - 3600000).toISOString(), isOwner: true },
]

const statusMap: Record<string, { text: string; color: string }> = {
  pending: { text: '拼团中', color: 'bg-[#FF6B35]' },
  success: { text: '已成团', color: 'bg-[#52C41A]' },
  failed: { text: '拼团失败', color: 'bg-[#999999]' },
}

const tabs = [
  { key: 'all', label: '拼团商品' },
  { key: 'my', label: '我的拼团' },
]

const loading = ref(true)
const tab = ref<'all' | 'my'>('all')
const groupBuys = ref<GroupBuy[]>([])
const myGroups = ref<MyGroupBuy[]>([])
const showSharePanel = ref(false)
const shareTarget = ref<MyGroupBuy | null>(null)

let tickTimer: ReturnType<typeof setInterval> | null = null

onMounted(() => {
  loadData()
  tickTimer = setInterval(() => {}, 1000)
})

onBeforeUnmount(() => {
  if (tickTimer) clearInterval(tickTimer)
})

function loadData() {
  setTimeout(() => {
    groupBuys.value = mockGroupBuys
    myGroups.value = mockMyGroups
    loading.value = false
  }, 500)
}

function formatCountdown(endTime: string): string {
  const diff = new Date(endTime).getTime() - Date.now()
  if (diff <= 0) return '00:00:00'
  const h = Math.floor(diff / 3600000)
  const m = Math.floor((diff % 3600000) / 60000)
  const s = Math.floor((diff % 60000) / 1000)
  return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0')
}

function handleJoin(groupId: string) {
  goTo('/pages/shop/group-buy/id-detail/index?id=' + groupId)
}

function handleCreate(productId: string) {
  goTo('/pages/shop/group-buy/id-detail/index?id=' + productId + '&action=create')
}

function handleShareClick(group: MyGroupBuy) {
  shareTarget.value = group
  showSharePanel.value = true
}

function handleCopyLink() {
  uni.setClipboardData({ data: 'https://rebu.app/shop/group-buy/' + shareTarget.value?.id })
  showSharePanel.value = false
  uni.showToast({ title: '链接已复制', icon: 'success' })
}

function goTo(url: string) { uni.navigateTo({ url }) }
function goBack() { uni.navigateBack() }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
