<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- Header -->
    <view class="sticky top-0 z-10 bg-white" style="border-bottom: 1px solid #E8E0D5;">
      <view class="px-4 py-3 flex items-center gap-3">
        <view @click="goBack" class="p-1 -ml-1">
          <text class="text-lg text-[#2C2C2C]">←</text>
        </view>
        <text class="text-lg font-semibold text-[#2C2C2C] font-serif">我的售后</text>
      </view>
      <!-- Tabs -->
      <view class="flex px-4 gap-6" style="border-top: 1px solid #E8E0D5;">
        <view
          v-for="tab in tabs"
          :key="tab.key"
          @click="activeTab = tab.key"
          :class="['py-3 relative text-sm font-medium', activeTab === tab.key ? 'text-[#C41E3A]' : 'text-[#666666]']"
        >
          <text>{{ tab.label }}</text>
          <view v-if="activeTab === tab.key" class="absolute bottom-0 left-0 right-0 h-0.5 bg-[#C41E3A] rounded-full" />
        </view>
      </view>
    </view>

    <!-- Content -->
    <view class="p-4 space-y-3">
      <!-- Skeleton -->
      <view v-if="loading">
        <view v-for="i in 3" :key="i" class="bg-white rounded-2xl p-4 animate-pulse mb-3">
          <view class="flex gap-3">
            <view class="w-20 h-20 bg-gray-200 rounded-xl" />
            <view class="flex-1 space-y-2">
              <view class="h-4 bg-gray-200 rounded w-3/4" />
              <view class="h-3 bg-gray-200 rounded w-1/2" />
              <view class="h-3 bg-gray-200 rounded w-1/3" />
            </view>
          </view>
        </view>
      </view>

      <!-- Empty -->
      <view v-else-if="items.length === 0" class="py-20 text-center">
        <view class="w-20 h-20 mx-auto mb-4 bg-[#FAF8F5] rounded-full flex items-center justify-center">
          <text class="text-3xl text-[#999999]">📦</text>
        </view>
        <text class="text-[#666666] mb-4 block">暂无售后记录</text>
        <view @click="goTo('/pages/orders/index')" class="px-6 py-2 bg-[#C41E3A] text-white rounded-full text-sm inline-block">
          查看订单
        </view>
      </view>

      <!-- List -->
      <view v-else>
        <view v-for="item in items" :key="item.id" class="bg-white rounded-2xl overflow-hidden shadow-sm mb-3">
          <!-- Header -->
          <view class="px-4 py-3 flex items-center justify-between" style="border-bottom: 1px solid #E8E0D5;">
            <view class="flex items-center gap-2">
              <text :class="['px-2 py-0.5 rounded text-xs', item.status === 'pending' ? 'bg-orange-50 text-orange-600' : item.status === 'approved' || item.status === 'refunding' ? 'bg-blue-50 text-blue-600' : item.status === 'completed' ? 'bg-green-50 text-green-600' : item.status === 'rejected' ? 'bg-red-50 text-red-600' : 'bg-gray-100 text-gray-500']">
                {{ statusConfig[item.status]?.label || '审核中' }}
              </text>
              <text class="text-xs text-[#999999]">
                {{ item.type === 'refund_only' ? '仅退款' : '退货退款' }}
              </text>
            </view>
            <text class="text-xs text-[#999999]">{{ formatDate(item.createdAt) }}</text>
          </view>
          <!-- Content -->
          <view class="p-4 flex gap-3" @click="goTo('/pages/shop/after-sale/id-detail/index?id=' + item.id)">
            <view class="w-20 h-20 rounded-xl bg-[#FAF8F5] flex items-center justify-center flex-shrink-0">
              <text class="text-2xl text-[#999]">📦</text>
            </view>
            <view class="flex-1 min-w-0">
              <text class="text-sm font-medium text-[#2C2C2C] line-clamp-2 mb-1 block">{{ item.product.name }}</text>
              <text class="text-xs text-[#999999] mb-2 block">{{ item.product.skuName }}</text>
              <view class="flex items-center justify-between">
                <text class="text-xs text-[#666666]">退款金额：</text>
                <text class="text-[#C41E3A] font-semibold">¥{{ item.amount }}</text>
              </view>
            </view>
            <text class="text-[#999999]">›</text>
          </view>
          <!-- Actions -->
          <view v-if="item.canCancel" class="px-4 py-3 flex justify-end gap-2" style="border-top: 1px solid #E8E0D5;">
            <view @click="showCancelConfirmId = item.id" class="px-4 py-1.5 border border-[#E8E0D5] rounded-full text-sm text-[#666666]">
              <text>{{ cancellingId === item.id ? '取消中...' : '取消售后' }}</text>
            </view>
            <view @click="goTo('/pages/shop/after-sale/id-detail/index?id=' + item.id)" class="px-4 py-1.5 bg-[#C41E3A] text-white rounded-full text-sm">
              查看进度
            </view>
          </view>
          <!-- Rejected Actions -->
          <view v-if="item.status === 'rejected'" class="px-4 py-3 flex justify-end gap-2" style="border-top: 1px solid #E8E0D5;">
            <view @click="goTo('/pages/shop/after-sale-rejected/index?id=' + item.id)" class="px-4 py-1.5 border border-[#C41E3A] text-[#C41E3A] rounded-full text-sm">
              查看原因
            </view>
            <view @click="goTo('/pages/shop/after-sale/index?orderId=' + item.orderId)" class="px-4 py-1.5 bg-[#C41E3A] text-white rounded-full text-sm">
              重新申请
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Cancel Confirm -->
    <view v-if="showCancelConfirmId" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50">
      <view class="bg-white rounded-2xl w-[80%] max-w-sm p-6 text-center">
        <view class="w-12 h-12 mx-auto mb-4 bg-orange-50 rounded-full flex items-center justify-center">
          <text class="text-orange-500 text-lg">⚠️</text>
        </view>
        <text class="text-lg font-semibold text-[#2C2C2C] mb-2 block">确认取消售后？</text>
        <text class="text-sm text-[#666666] mb-6 block">取消后如需继续申请，请重新提交</text>
        <view class="flex gap-3">
          <view @click="showCancelConfirmId = null" class="flex-1 py-2.5 border border-[#E8E0D5] rounded-full text-[#666666] text-center">
            再想想
          </view>
          <view @click="handleCancel(showCancelConfirmId)" class="flex-1 py-2.5 bg-[#C41E3A] text-white rounded-full text-center">
            确认取消
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted, watch } from 'vue'

interface AfterSaleProduct { id: string; name: string; cover: string; skuName: string }
interface AfterSaleListItem {
  id: string; orderId: string; orderNo: string; type: string; status: string
  amount: number; reason: string; product: AfterSaleProduct; createdAt: string; canCancel: boolean
}

const mockData: AfterSaleListItem[] = [
  { id: '1', orderId: 'o1', orderNo: 'AS202401150001', type: 'refund_only', status: 'pending', amount: 168, reason: '商品质量问题', product: { id: 'p1', name: '周易六十四卦详解（精装典藏版）', cover: '/placeholder.svg', skuName: '精装版' }, createdAt: '2024-01-15T10:30:00Z', canCancel: true },
  { id: '2', orderId: 'o2', orderNo: 'AS202401140002', type: 'refund_with_return', status: 'approved', amount: 88, reason: '尺寸不符', product: { id: 'p2', name: '紫微斗数入门教程', cover: '/placeholder.svg', skuName: '平装版' }, createdAt: '2024-01-14T14:20:00Z', canCancel: false },
  { id: '3', orderId: 'o3', orderNo: 'AS202401130003', type: 'refund_only', status: 'completed', amount: 299, reason: '七天无理由', product: { id: 'p3', name: '奇门遁甲实战手册', cover: '/placeholder.svg', skuName: '典藏版' }, createdAt: '2024-01-13T09:15:00Z', canCancel: false },
  { id: '4', orderId: 'o4', orderNo: 'AS202401120004', type: 'refund_with_return', status: 'rejected', amount: 128, reason: '不喜欢', product: { id: 'p4', name: '梅花易数精解', cover: '/placeholder.svg', skuName: '标准版' }, createdAt: '2024-01-12T16:45:00Z', canCancel: false },
]

const tabs = [
  { key: '', label: '全部' },
  { key: 'pending', label: '处理中' },
  { key: 'completed', label: '已完成' },
  { key: 'rejected', label: '已驳回' },
]

const statusConfig: Record<string, { label: string }> = {
  pending: { label: '审核中' },
  approved: { label: '已通过' },
  refunding: { label: '退款中' },
  completed: { label: '已完成' },
  rejected: { label: '已驳回' },
  cancelled: { label: '已取消' },
}

const loading = ref(true)
const activeTab = ref('')
const items = ref<AfterSaleListItem[]>([])
const cancellingId = ref<string | null>(null)
const showCancelConfirmId = ref<string | null>(null)

const pendingStatuses = ['pending', 'approved', 'refunding']

function loadData() {
  if (activeTab.value === '') {
    items.value = mockData
  } else if (activeTab.value === 'pending') {
    items.value = mockData.filter(i => pendingStatuses.includes(i.status))
  } else {
    items.value = mockData.filter(i => i.status === activeTab.value)
  }
}

onMounted(() => {
  setTimeout(() => {
    loadData()
    loading.value = false
  }, 500)
})

watch(activeTab, () => {
  loading.value = true
  setTimeout(() => {
    loadData()
    loading.value = false
  }, 300)
})

function handleCancel(id: string) {
  cancellingId.value = id
  setTimeout(() => {
    items.value = items.value.map(i =>
      i.id === id ? { ...i, status: 'cancelled' as const, canCancel: false } : i
    )
    cancellingId.value = null
    showCancelConfirmId.value = null
  }, 500)
}

function formatDate(dateStr: string) {
  const date = new Date(dateStr)
  return (date.getMonth() + 1) + '月' + date.getDate() + '日 ' +
    String(date.getHours()).padStart(2, '0') + ':' + String(date.getMinutes()).padStart(2, '0')
}

function goTo(url: string) { uni.navigateTo({ url }) }
function goBack() { uni.navigateBack() }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
