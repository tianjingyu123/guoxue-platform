<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- Header -->
    <view class="sticky top-0 z-10 bg-white flex items-center justify-between px-4 py-3" style="border-bottom: 1px solid #E8E0D5;">
      <view class="flex items-center gap-3">
        <view @click="goBack" class="p-1 -ml-1">
          <text class="text-lg text-[#2C2C2C]">←</text>
        </view>
        <text class="text-lg font-semibold text-[#2C2C2C]">支付方式</text>
      </view>
      <view @click="showAddPanel = true" class="flex items-center gap-1 text-sm text-[#C41E3A]">
        <text>+</text>
        <text>添加</text>
      </view>
    </view>

    <!-- Methods List -->
    <view class="p-4 space-y-3">
      <!-- Skeleton -->
      <view v-if="loading">
        <view v-for="i in 3" :key="i" class="bg-white rounded-2xl p-4 animate-pulse mb-3">
          <view class="flex items-center gap-3">
            <view class="w-10 h-10 rounded-full bg-gray-200" />
            <view class="flex-1 space-y-2">
              <view class="h-4 bg-gray-200 rounded w-24" />
              <view class="h-3 bg-gray-200 rounded w-32" />
            </view>
          </view>
        </view>
      </view>

      <!-- Empty -->
      <view v-else-if="methods.length === 0" class="py-16 text-center">
        <view class="w-16 h-16 mx-auto mb-4 rounded-full bg-[#FAF8F5] flex items-center justify-center">
          <text class="text-3xl text-[#999999]">💳</text>
        </view>
        <text class="text-[#999999] mb-4 block">暂未绑定支付方式</text>
        <view @click="showAddPanel = true" class="px-6 py-2 bg-[#C41E3A] text-white rounded-full text-sm inline-block">
          添加支付方式
        </view>
      </view>

      <!-- List -->
      <view v-else>
        <view v-for="method in methods" :key="method.id" class="bg-white rounded-2xl p-4 relative mb-3">
          <view class="flex items-center gap-3">
            <!-- Icon -->
            <view :class="['w-10 h-10 rounded-full flex items-center justify-center', getIconBg(method.type)]">
              <text class="text-white">{{ getIconText(method.type) }}</text>
            </view>
            <view class="flex-1 min-w-0">
              <view class="flex items-center gap-2">
                <text class="font-medium text-[#2C2C2C]">{{ method.name }}</text>
                <text v-if="method.cardType" class="text-xs px-1.5 py-0.5 bg-[#FAF8F5] text-[#666666] rounded">
                  {{ method.cardType === 'debit' ? '储蓄卡' : '信用卡' }}
                </text>
                <text v-if="method.isDefault" class="text-xs px-1.5 py-0.5 text-[#C41E3A] rounded" style="background: rgba(196,30,58,0.1);">默认</text>
              </view>
              <text class="text-sm text-[#999999] mt-0.5 block">{{ method.account }}</text>
            </view>
            <view @click="showMenu = showMenu === method.id ? null : method.id" class="p-2 -mr-2">
              <text class="text-[#999999]">⋮</text>
            </view>
          </view>

          <!-- Dropdown Menu -->
          <view v-if="showMenu === method.id" class="absolute right-4 top-14 bg-white rounded-xl shadow-lg z-10 min-w-[120px]" style="border: 1px solid #E8E0D5;">
            <view v-if="!method.isDefault"
              @click="showConfirm = { id: method.id, action: 'default' }"
              class="w-full px-4 py-2 text-sm text-[#2C2C2C] flex items-center gap-2">
              <text class="text-[#C9A96E]">⭐</text>
              <text>设为默认</text>
            </view>
            <view @click="showConfirm = { id: method.id, action: 'delete' }"
              class="w-full px-4 py-2 text-sm text-[#C41E3A] flex items-center gap-2"
              style="border-top: 1px solid #E8E0D5;">
              <text class="text-[#C41E3A]">🗑️</text>
              <text>解除绑定</text>
            </view>
          </view>

          <view class="mt-3 pt-3 flex items-center justify-between text-xs text-[#999999]" style="border-top: 1px solid #E8E0D5;">
            <text>绑定时间：{{ method.bindTime }}</text>
            <text v-if="method.isDefault" class="flex items-center gap-1 text-[#07C160]">
              <text>✓</text>
              <text>支付时优先使用</text>
            </text>
          </view>
        </view>
      </view>
    </view>

    <!-- Security Note -->
    <view class="px-4 pb-4">
      <view class="flex items-start gap-2 text-xs text-[#999999]">
        <text class="flex-shrink-0 mt-0.5">⚠️</text>
        <text>您的支付信息已加密存储，我们不会保存您的支付密码。如有疑问请联系客服。</text>
      </view>
    </view>

    <!-- Add Method Panel -->
    <view v-if="showAddPanel" class="fixed inset-0 z-50 bg-black/50" @click="showAddPanel = false">
      <view class="absolute bottom-0 left-0 right-0 bg-white rounded-t-3xl" @click.stop>
        <view class="p-4 text-center" style="border-bottom: 1px solid #E8E0D5;">
          <text class="text-lg font-semibold text-[#2C2C2C]">添加支付方式</text>
        </view>
        <view class="p-4 space-y-3">
          <view v-for="option in addOptions" :key="option.type"
            @click="showAddPanel = false; uni.showToast({ title: '将跳转' + option.name + '授权页面', icon: 'none' })"
            class="w-full flex items-center gap-4 p-4 bg-[#FAF8F5] rounded-2xl">
            <view class="w-12 h-12 rounded-full bg-white flex items-center justify-center shadow-sm">
              <text class="text-xl">{{ option.icon }}</text>
            </view>
            <view class="flex-1 text-left">
              <text class="font-medium text-[#2C2C2C] block">{{ option.name }}</text>
              <text class="text-sm text-[#999999] block">{{ option.desc }}</text>
            </view>
            <text class="text-[#CCCCCC]">›</text>
          </view>
        </view>
        <view class="p-4 pb-8">
          <view @click="showAddPanel = false" class="w-full py-3 text-[#666666] text-center">取消</view>
        </view>
      </view>
    </view>

    <!-- Confirm Dialog -->
    <view v-if="showConfirm" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4" @click="showConfirm = null">
      <view class="bg-white rounded-2xl p-6 w-full max-w-sm" @click.stop>
        <text class="text-lg font-semibold text-center text-[#2C2C2C] mb-2 block">
          {{ showConfirm.action === 'delete' ? '解除绑定' : '设为默认' }}
        </text>
        <text class="text-center text-[#666666] mb-6 block">
          {{ showConfirm.action === 'delete' ? '解除绑定后，将无法使用该支付方式进行支付，确定解除吗？' : '设为默认后，支付时将优先使用该支付方式' }}
        </text>
        <view class="flex gap-3">
          <view @click="showConfirm = null" class="flex-1 py-3 bg-[#FAF8F5] text-[#666666] rounded-full text-center">取消</view>
          <view @click="handleConfirm" :class="['flex-1 py-3 rounded-full text-white text-center', processing ? 'opacity-50' : 'bg-[#C41E3A]']">
            {{ processing ? '处理中...' : '确定' }}
          </view>
        </view>
      </view>
    </view>

    <!-- Backdrop for menu -->
    <view v-if="showMenu" class="fixed inset-0 z-5" @click="showMenu = null" />
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'

interface PaymentMethod {
  id: string; type: string; name: string; icon: string; account: string
  isDefault: boolean; bindTime: string; bankName?: string; cardType?: string
}

const mockMethods: PaymentMethod[] = [
  { id: '1', type: 'wechat', name: '微信支付', icon: 'wechat', account: 'wei***@example.com', isDefault: true, bindTime: '2024-01-15' },
  { id: '2', type: 'alipay', name: '支付宝', icon: 'alipay', account: '138****8888', isDefault: false, bindTime: '2024-02-20' },
  { id: '3', type: 'bank_card', name: '招商银行', icon: 'bank', account: '**** **** **** 6789', isDefault: false, bindTime: '2024-03-10', bankName: '招商银行', cardType: 'debit' },
]

const addOptions = [
  { type: 'wechat', name: '微信支付', desc: '绑定微信账号快捷支付', icon: '💚' },
  { type: 'alipay', name: '支付宝', desc: '绑定支付宝账号快捷支付', icon: '💙' },
  { type: 'bank_card', name: '银行卡', desc: '添加储蓄卡或信用卡', icon: '❤️' },
]

const loading = ref(true)
const methods = ref<PaymentMethod[]>([])
const showMenu = ref<string | null>(null)
const showAddPanel = ref(false)
const showConfirm = ref<{ id: string; action: 'delete' | 'default' } | null>(null)
const processing = ref(false)

onMounted(() => {
  setTimeout(() => {
    methods.value = mockMethods
    loading.value = false
  }, 500)
})

function getIconBg(type: string): string {
  switch (type) {
    case 'wechat': return 'bg-[#07C160]'
    case 'alipay': return 'bg-[#1677FF]'
    case 'bank_card': return 'bg-gradient-to-br from-[#C41E3A] to-[#8B0000]'
    default: return 'bg-gray-200'
  }
}

function getIconText(type: string): string {
  switch (type) {
    case 'wechat': return '💬'
    case 'alipay': return '👤'
    case 'bank_card': return '💳'
    default: return '💳'
  }
}

function handleConfirm() {
  if (!showConfirm.value) return
  processing.value = true
  setTimeout(() => {
    const { id, action } = showConfirm.value!
    if (action === 'delete') {
      methods.value = methods.value.filter(m => m.id !== id)
    } else {
      methods.value = methods.value.map(m => ({ ...m, isDefault: m.id === id }))
    }
    processing.value = false
    showConfirm.value = null
    showMenu.value = null
  }, 500)
}

function goBack() { uni.navigateBack() }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
