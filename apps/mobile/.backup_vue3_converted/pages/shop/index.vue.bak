<template>
  <!-- 骨架屏 -->
  <view v-if="loading" class="min-h-screen bg-[#FAF8F5] animate-pulse">
    <view class="h-12 bg-white" />
    <view class="mx-4 mt-4 h-36 rounded-xl bg-gray-200" />
    <view class="mx-4 mt-4 grid grid-cols-4 gap-3">
      <view v-for="i in 8" :key="i" class="flex flex-col items-center gap-2">
        <view class="w-12 h-12 rounded-full bg-gray-200" />
        <view class="w-10 h-3 rounded bg-gray-200" />
      </view>
    </view>
    <view class="mx-4 mt-6 h-32 rounded-xl bg-gray-200" />
    <view class="mx-4 mt-6 grid grid-cols-2 gap-3">
      <view v-for="i in 4" :key="i" class="h-64 rounded-xl bg-gray-200" />
    </view>
  </view>

  <!-- 主内容 -->
  <view v-else class="min-h-screen bg-[#FAF8F5] pb-20">
    <!-- 顶部搜索栏 -->
    <view class="sticky top-0 z-20 bg-white px-4 py-3 shadow-sm">
      <view class="flex items-center gap-3">
        <view
          class="flex-1 flex items-center gap-2 px-4 py-2 bg-[#FAF8F5] rounded-full cursor-pointer"
          @click="goTo('/pages/shop/search')"
        >
          <text class="text-sm text-[#999999]">🔍</text>
          <text class="text-sm text-[#999999]">搜索商品</text>
        </view>
        <view
          @click="goTo('/pages/shop/cart/index')"
          class="relative p-2"
        >
          <text class="text-lg text-[#666666]">🛒</text>
          <text class="absolute -top-0.5 -right-0.5 w-4 h-4 bg-[#C41E3A] text-white text-[10px] rounded-full flex items-center justify-center">3</text>
        </view>
        <view class="relative p-2">
          <text class="text-lg text-[#666666]">🔔</text>
          <text class="absolute top-1 right-1 w-2 h-2 bg-[#C41E3A] rounded-full" />
        </view>
      </view>
    </view>

    <!-- Banner轮播 -->
    <view class="relative mx-4 mt-4 h-28 sm:h-36 rounded-xl overflow-hidden">
      <view
        class="flex transition-transform duration-500 h-full"
        :style="{ transform: 'translateX(-' + currentBanner * 100 + '%)' }"
      >
        <view
          v-for="(banner, idx) in banners"
          :key="banner.id"
          class="w-full h-full flex-shrink-0 cursor-pointer"
          @click="handleBannerClick(banner)"
        >
          <view class="w-full h-full bg-gradient-to-r from-[#C41E3A] to-[#E85A70] flex items-center justify-center">
            <text class="text-white text-xl font-bold">{{ banner.title }}</text>
          </view>
        </view>
      </view>
      <!-- 指示器 -->
      <view class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1.5">
        <view
          v-for="(_, idx) in banners"
          :key="idx"
          :class="['w-1.5 h-1.5 rounded-full transition-all', idx === currentBanner ? 'w-4 bg-white' : 'bg-white/50']"
        />
      </view>
    </view>

    <!-- 快捷活动入口 -->
    <view class="mx-4 mt-4 grid grid-cols-4 gap-2">
      <view
        v-for="action in quickActions"
        :key="action.id"
        @click="goTo(action.link)"
        :class="['p-3 rounded-xl bg-gradient-to-br text-white flex flex-col items-center gap-1.5 shadow-sm active:scale-95 transition-transform', action.color]"
      >
        <text class="text-lg">{{ action.icon }}</text>
        <text class="text-xs font-medium">{{ action.name }}</text>
      </view>
    </view>

    <!-- 分类图标网格 -->
    <view class="mx-4 mt-5 grid grid-cols-4 gap-3">
      <view
        v-for="cat in categories"
        :key="cat.id"
        class="flex flex-col items-center gap-1.5 cursor-pointer"
        @click="goTo('/pages/shop/categories/index?id=' + cat.id)"
      >
        <view class="w-12 h-12 rounded-full bg-white shadow-sm flex items-center justify-center text-2xl">
          <text>{{ cat.icon }}</text>
        </view>
        <text class="text-xs text-[#2C2C2C]">{{ cat.name }}</text>
      </view>
    </view>

    <!-- 秒杀专区 -->
    <view class="mx-4 mt-6">
      <view
        class="bg-gradient-to-r from-[#C41E3A] to-[#E85A70] rounded-xl p-4 cursor-pointer"
        @click="goTo('/pages/shop/flash-sale/index?id=' + flashSale.id)"
      >
        <view class="flex items-center justify-between mb-3">
          <view class="flex items-center gap-2">
            <text class="text-lg text-[#FFD700]">🔥</text>
            <text class="text-white font-bold">{{ flashSale.title }}</text>
          </view>
          <view class="flex items-center gap-1 text-white text-sm">
            <text class="text-base">⏰</text>
            <text class="bg-white/20 px-1.5 py-0.5 rounded text-xs font-mono">{{ String(countdown.hours).padStart(2, '0') }}</text>
            <text>:</text>
            <text class="bg-white/20 px-1.5 py-0.5 rounded text-xs font-mono">{{ String(countdown.minutes).padStart(2, '0') }}</text>
            <text>:</text>
            <text class="bg-white/20 px-1.5 py-0.5 rounded text-xs font-mono">{{ String(countdown.seconds).padStart(2, '0') }}</text>
          </view>
        </view>
        <view class="flex gap-3 overflow-x-auto pb-1 scrollbar-hide">
          <view
            v-for="product in flashSale.products"
            :key="product.id"
            class="flex-shrink-0 w-20 bg-white rounded-lg p-2"
            @click.stop="goTo('/pages/shop/id-detail/index?id=' + product.id)"
          >
            <view class="w-16 h-16 mx-auto bg-[#FAF8F5] rounded-lg mb-1.5" />
            <view class="text-[#C41E3A] font-bold text-sm text-center">¥{{ product.price }}</view>
            <view class="text-[#999999] text-xs line-through text-center">¥{{ product.originalPrice }}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 拼团专区 -->
    <view class="mx-4 mt-4">
      <view
        class="bg-white rounded-xl p-4 shadow-sm cursor-pointer"
        @click="goTo('/pages/shop/group-buy/index?id=' + groupBuy.id)"
      >
        <view class="flex items-center justify-between mb-3">
          <view class="flex items-center gap-2">
            <text class="text-lg text-[#C41E3A]">👥</text>
            <text class="font-bold text-[#2C2C2C]">拼团特惠</text>
            <text class="text-xs text-white bg-[#C41E3A] px-2 py-0.5 rounded-full">{{ groupBuy.title }}</text>
          </view>
          <text class="text-sm text-[#999999]">›</text>
        </view>
        <view class="flex gap-4">
          <view class="w-20 h-20 bg-[#FAF8F5] rounded-lg flex-shrink-0" />
          <view class="flex-1 min-w-0">
            <text class="text-sm font-medium text-[#2C2C2C] truncate block">{{ groupBuy.productName }}</text>
            <view class="flex items-baseline gap-2 mt-1">
              <text class="text-[#C41E3A] font-bold text-lg">¥{{ groupBuy.price }}</text>
              <text class="text-[#999999] text-xs line-through">¥{{ groupBuy.originalPrice }}</text>
            </view>
            <view class="flex items-center gap-2 mt-2">
              <view class="flex-1 h-1.5 bg-[#FAF8F5] rounded-full overflow-hidden">
                <view
                  class="h-full bg-gradient-to-r from-[#C41E3A] to-[#E85A70] rounded-full"
                  :style="{ width: (groupBuy.currentMembers / groupBuy.minMembers) * 100 + '%' }"
                />
              </view>
              <text class="text-xs text-[#C41E3A]">还差{{ groupBuy.minMembers - groupBuy.currentMembers }}人</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 为你推荐 -->
    <view class="mx-4 mt-6">
      <view class="flex items-center justify-between mb-3">
        <text class="font-bold text-[#2C2C2C]">为你推荐</text>
        <text
          class="text-xs text-[#999999] flex items-center gap-1 cursor-pointer"
          @click="goTo('/pages/shop/products')"
        >
          更多 ›
        </text>
      </view>
      <view class="grid grid-cols-2 gap-3">
        <view
          v-for="product in products"
          :key="product.id"
          class="bg-white rounded-xl overflow-hidden shadow-sm cursor-pointer"
          @click="goTo('/pages/shop/id-detail/index?id=' + product.id)"
        >
          <view class="relative aspect-square bg-[#FAF8F5]">
            <text
              v-if="product.isNew"
              class="absolute top-2 left-2 text-xs text-white bg-[#1890FF] px-2 py-0.5 rounded"
            >新品</text>
            <text
              v-if="product.isHot"
              class="absolute top-2 left-2 text-xs text-white bg-[#C41E3A] px-2 py-0.5 rounded"
            >热销</text>
          </view>
          <view class="p-3">
            <text class="text-sm text-[#2C2C2C] line-clamp-2 block min-h-[40px]">{{ product.name }}</text>
            <view class="flex items-center gap-1 mt-1">
              <text class="text-xs text-[#C9A96E]">⭐</text>
              <text class="text-xs text-[#C9A96E]">{{ product.rating }}</text>
              <text class="text-xs text-[#999999] ml-1">{{ product.sales }}人付款</text>
            </view>
            <view class="flex items-baseline gap-2 mt-2">
              <text class="text-[#C41E3A] font-bold">¥{{ product.price }}</text>
              <text class="text-xs text-[#999999] line-through">¥{{ product.originalPrice }}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部安全距离 -->
    <view class="h-4" />
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted, onBeforeUnmount } from 'vue'

// 快捷活动入口
const quickActions = [
  { id: 'flash', name: '限时秒杀', icon: '⚡', color: 'from-red-500 to-orange-500', link: '/pages/shop/flash-sale/index' },
  { id: 'group', name: '拼团特惠', icon: '👥', color: 'from-orange-500 to-amber-500', link: '/pages/shop/group-buy/index' },
  { id: 'coupon', name: '领券中心', icon: '🎟️', color: 'from-pink-500 to-rose-500', link: '/pages/shop/coupons/index' },
  { id: 'points', name: '积分兑换', icon: '🎁', color: 'from-purple-500 to-indigo-500', link: '/pages/shop/exchange/index' },
]

// Mock数据
const mockBanners = [
  { id: '1', image: '/placeholder.svg?height=200&width=400', title: '国学典籍大促', link: '/pages/shop/activity/1' },
  { id: '2', image: '/placeholder.svg?height=200&width=400', title: '新品上市', link: '/pages/shop/products?tag=new' },
  { id: '3', image: '/placeholder.svg?height=200&width=400', title: '会员专享', link: '/pages/shop/vip' },
]

const mockCategories = [
  { id: '1', name: '古籍善本', icon: '📚' },
  { id: '2', name: '文房四宝', icon: '🖌️' },
  { id: '3', name: '香道用品', icon: '🪷' },
  { id: '4', name: '茶道器具', icon: '🍵' },
  { id: '5', name: '命理工具', icon: '🧭' },
  { id: '6', name: '风水摆件', icon: '🏺' },
  { id: '7', name: '养生食品', icon: '🌿' },
  { id: '8', name: '更多分类', icon: '📋' },
]

const mockFlashSale = {
  id: '1',
  title: '限时秒杀',
  startTime: new Date().toISOString(),
  endTime: new Date(Date.now() + 3600000 * 2).toISOString(),
  status: 'ongoing',
  products: [
    { id: '1', name: '渊海子平精装版', cover: '/placeholder.svg?height=100&width=100', price: 68, originalPrice: 128, stock: 50, sold: 42 },
    { id: '2', name: '罗盘专业款', cover: '/placeholder.svg?height=100&width=100', price: 199, originalPrice: 399, stock: 30, sold: 18 },
    { id: '3', name: '紫檀木签筒', cover: '/placeholder.svg?height=100&width=100', price: 88, originalPrice: 168, stock: 100, sold: 67 },
  ],
}

const mockGroupBuy = {
  id: '1',
  title: '3人成团',
  cover: '/placeholder.svg?height=120&width=120',
  price: 299,
  originalPrice: 599,
  minMembers: 3,
  currentMembers: 2,
  endTime: new Date(Date.now() + 86400000).toISOString(),
  status: 'ongoing',
  productName: '周易全集精装套装',
}

const mockProducts = [
  { id: '1', name: '渊海子平（精装典藏版）', cover: '/placeholder.svg?height=200&width=200', price: 128, originalPrice: 168, sales: 2860, rating: 4.9, category: '古籍', isHot: true },
  { id: '2', name: '专业风水罗盘', cover: '/placeholder.svg?height=200&width=200', price: 399, originalPrice: 599, sales: 1250, rating: 4.8, category: '工具', isNew: true },
  { id: '3', name: '紫檀木文房套装', cover: '/placeholder.svg?height=200&width=200', price: 688, originalPrice: 888, sales: 560, rating: 4.9, category: '文房' },
  { id: '4', name: '沉香线香礼盒', cover: '/placeholder.svg?height=200&width=200', price: 168, originalPrice: 238, sales: 3200, rating: 4.7, category: '香道', isHot: true },
  { id: '5', name: '紫砂茶具套装', cover: '/placeholder.svg?height=200&width=200', price: 458, originalPrice: 658, sales: 890, rating: 4.8, category: '茶道' },
  { id: '6', name: '黄铜貔貅摆件', cover: '/placeholder.svg?height=200&width=200', price: 299, originalPrice: 399, sales: 1560, rating: 4.6, category: '摆件', isNew: true },
]

const loading = ref(true)
const banners = ref(mockBanners)
const categories = ref(mockCategories)
const flashSale = ref(mockFlashSale)
const groupBuy = ref(mockGroupBuy)
const products = ref(mockProducts)
const currentBanner = ref(0)
const countdown = ref({ hours: 0, minutes: 0, seconds: 0 })

let bannerTimer: ReturnType<typeof setInterval> | null = null
let countdownTimer: ReturnType<typeof setInterval> | null = null
let loadTimer: ReturnType<typeof setTimeout> | null = null

onMounted(() => {
  // 轮播自动切换
  bannerTimer = setInterval(() => {
    currentBanner.value = (currentBanner.value + 1) % banners.value.length
  }, 4000)

  // 秒杀倒计时
  const updateCountdown = () => {
    const end = new Date(flashSale.value.endTime).getTime()
    const now = Date.now()
    const diff = Math.max(0, end - now)
    countdown.value = {
      hours: Math.floor(diff / 3600000),
      minutes: Math.floor((diff % 3600000) / 60000),
      seconds: Math.floor((diff % 60000) / 1000),
    }
  }
  updateCountdown()
  countdownTimer = setInterval(updateCountdown, 1000)

  // 模拟加载
  loadTimer = setTimeout(() => {
    loading.value = false
  }, 800)
})

onBeforeUnmount(() => {
  if (bannerTimer) clearInterval(bannerTimer)
  if (countdownTimer) clearInterval(countdownTimer)
  if (loadTimer) clearTimeout(loadTimer)
})

function handleBannerClick(banner: typeof mockBanners[0]) {
  goTo(banner.link)
}

function goTo(url: string) {
  uni.navigateTo({ url })
}

function goBack() {
  uni.navigateBack()
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
