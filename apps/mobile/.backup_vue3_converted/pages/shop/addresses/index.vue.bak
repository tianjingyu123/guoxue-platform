<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-24">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-40 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 h-14">
        <view @click="goBack" class="p-2 -ml-2">
          <text class="text-lg text-[#2C2C2C]">←</text>
        </view>
        <text class="font-semibold text-base text-[#2C2C2C]">收货地址</text>
        <view class="w-9" />
      </view>
    </view>

    <!-- 地址列表 -->
    <view class="p-4 space-y-3">
      <!-- 空状态 -->
      <view v-if="addresses.length === 0" class="flex flex-col items-center justify-center py-20">
        <view class="w-20 h-20 rounded-full bg-[#FAF8F5] flex items-center justify-center mb-4">
          <text class="text-3xl text-[#999]">📍</text>
        </view>
        <text class="text-sm text-[#999]">暂无收货地址</text>
        <text class="text-xs text-[#999]/70 mt-1">添加地址后可快速下单</text>
      </view>

      <!-- 地址卡片 -->
      <view v-for="addr in addresses" :key="addr.id" class="relative overflow-hidden">
        <!-- 滑动删除按钮 -->
        <view
          :class="['absolute right-0 top-0 bottom-0 w-20 bg-red-500 flex items-center justify-center transition-opacity rounded-r-xl', swipedId === addr.id ? 'opacity-100' : 'opacity-0 pointer-events-none']"
          @click="deleteConfirm = addr.id"
        >
          <text class="text-white">🗑️</text>
        </view>

        <view
          :class="['bg-white rounded-xl p-4 transition-transform', swipedId === addr.id ? '-translate-x-20' : '']"
          @click="swipedId === addr.id ? swipedId = null : swipedId = addr.id"
        >
          <view class="flex items-start justify-between">
            <view class="flex-1 min-w-0">
              <view class="flex items-center gap-3 mb-2">
                <text class="font-semibold text-[#2C2C2C]">{{ addr.name }}</text>
                <text class="text-sm text-[#999]">{{ addr.phone }}</text>
                <text v-if="addr.isDefault" class="text-[10px] px-1.5 py-0 bg-[#C9A96E]/20 text-[#C9A96E] rounded">默认</text>
              </view>
              <text class="text-sm text-[#999] leading-relaxed">{{ addr.province }}{{ addr.city !== addr.province ? addr.city : '' }}{{ addr.district }}{{ addr.street }}{{ addr.detail }}</text>
            </view>

            <view @click.stop="openEditModal(addr)" class="p-2 -mr-2 text-[#999]">
              <text>✏️</text>
            </view>
          </view>

          <!-- 设为默认 -->
          <view v-if="!addr.isDefault" @click.stop="handleSetDefault(addr.id)" class="mt-3 pt-3 border-t border-[#E8E0D5] w-full text-left text-xs text-[#C41E3A]">
            设为默认地址
          </view>
        </view>
      </view>
    </view>

    <!-- 底部新增按钮 -->
    <view class="fixed bottom-0 left-0 right-0 p-4 bg-white border-t border-[#E8E0D5]" style="padding-bottom: calc(16px + env(safe-area-inset-bottom));">
      <view @click="openEditModal()" class="w-full py-3 bg-[#C41E3A] text-white font-medium rounded-xl flex items-center justify-center gap-2">
        <text class="text-lg">+</text>
        <text>新增收货地址</text>
      </view>
    </view>

    <!-- 删除确认 -->
    <view v-if="deleteConfirm !== null" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50">
      <view class="bg-white rounded-2xl p-6 mx-8 w-full max-w-sm text-center">
        <text class="font-semibold text-lg text-[#2C2C2C] block mb-2">确认删除</text>
        <text class="text-sm text-[#999] block mb-6">删除后将无法恢复，确定要删除这个地址吗？</text>
        <view class="flex gap-3">
          <view @click="deleteConfirm = null; swipedId = null" class="flex-1 py-2.5 bg-[#FAF8F5] text-[#2C2C2C] font-medium rounded-xl text-center">取消</view>
          <view @click="handleDelete(deleteConfirm)" class="flex-1 py-2.5 bg-red-500 text-white font-medium rounded-xl text-center">删除</view>
        </view>
      </view>
    </view>

    <!-- 新增/编辑地址全屏弹窗 -->
    <view v-if="showEditModal" class="fixed inset-0 z-50 bg-white flex flex-col">
      <!-- 顶部导航 -->
      <view class="border-b border-[#E8E0D5] flex-shrink-0">
        <view class="flex items-center justify-between px-4 h-14">
          <view @click="showEditModal = false" class="p-2 -ml-2">
            <text class="text-lg text-[#2C2C2C]">✕</text>
          </view>
          <text class="font-semibold text-base text-[#2C2C2C]">{{ editingAddress ? '编辑地址' : '新增地址' }}</text>
          <view
            @click="handleSave"
            :class="['text-sm font-medium', canSave ? 'text-[#C41E3A]' : 'text-[#CCC]']"
          >
            保存
          </view>
        </view>
      </view>

      <scroll-view scroll-y class="flex-1 p-4 space-y-4">
        <!-- 收件人 -->
        <view>
          <text class="text-sm text-[#999] block mb-1.5">收件人</text>
          <input
            v-model="form.name"
            placeholder="请输入收件人姓名"
            class="w-full px-4 py-3 bg-[#FAF8F5] rounded-xl text-sm text-[#2C2C2C]"
            placeholder-style="color:#999"
          />
        </view>

        <!-- 手机号 -->
        <view>
          <text class="text-sm text-[#999] block mb-1.5">手机号</text>
          <input
            v-model="form.phone"
            type="number"
            placeholder="请输入手机号码"
            class="w-full px-4 py-3 bg-[#FAF8F5] rounded-xl text-sm text-[#2C2C2C]"
            placeholder-style="color:#999"
          />
        </view>

        <!-- 省市区 -->
        <view>
          <text class="text-sm text-[#999] block mb-1.5">所在地区</text>
          <view
            @click="openRegionPicker"
            class="w-full px-4 py-3 bg-[#FAF8F5] rounded-xl flex items-center justify-between"
          >
            <text :class="form.province ? 'text-[#2C2C2C] text-sm' : 'text-[#999] text-sm'">
              {{ form.province ? form.province + ' ' + form.city + ' ' + form.district : '请选择省/市/区' }}
            </text>
            <text class="text-[#999]">›</text>
          </view>
        </view>

        <!-- 详细地址 -->
        <view>
          <text class="text-sm text-[#999] block mb-1.5">详细地址</text>
          <textarea
            v-model="form.detail"
            placeholder="街道、楼牌号等"
            class="w-full px-4 py-3 bg-[#FAF8F5] rounded-xl text-sm text-[#2C2C2C] resize-none"
            style="height: 80px;"
            placeholder-style="color:#999"
          />
        </view>

        <!-- 设为默认 -->
        <view class="flex items-center justify-between py-3">
          <text class="text-sm text-[#2C2C2C]">设为默认地址</text>
          <view
            @click="form.isDefault = !form.isDefault"
            :class="['relative w-12 h-7 rounded-full transition-colors', form.isDefault ? 'bg-[#C41E3A]' : 'bg-[#E8E0D5]']"
          >
            <view :class="['absolute top-1 w-5 h-5 rounded-full bg-white shadow transition-transform', form.isDefault ? 'right-1' : 'left-1']" />
          </view>
        </view>
      </scroll-view>

      <!-- 地区选择器 -->
      <view v-if="showRegionPicker" class="absolute inset-0 z-10 flex items-end bg-black/50" @click.self="showRegionPicker = false">
        <view class="w-full bg-white rounded-t-2xl flex flex-col" style="max-height: 60vh;">
          <view class="flex items-center justify-between px-4 py-3 border-b border-[#E8E0D5]">
            <view @click="handleRegionBack" class="text-sm text-[#999]">
              {{ regionStep === 'province' ? '取消' : '返回' }}
            </view>
            <text class="font-medium text-[#2C2C2C]">
              {{ regionStep === 'province' ? '选择省份' : regionStep === 'city' ? '选择城市' : '选择区县' }}
            </text>
            <view class="w-10" />
          </view>
          <scroll-view scroll-y class="flex-1">
            <view
              v-for="option in currentRegionOptions" :key="option"
              @click="handleSelectRegion(option)"
              class="w-full px-4 py-3 flex items-center justify-between border-b border-[#F5F0E8]"
            >
              <text class="text-sm text-[#2C2C2C]">{{ option }}</text>
              <text v-if="isSelectedRegion(option)" class="text-[#C41E3A]">✓</text>
            </view>
          </scroll-view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

interface Address {
  id: number
  name: string
  phone: string
  province: string
  city: string
  district: string
  street: string
  detail: string
  isDefault: boolean
}

const addresses = ref<Address[]>([
  { id: 1, name: '张三', phone: '138****8888', province: '北京市', city: '北京市', district: '朝阳区', street: '建国路88号', detail: '国贸中心A座1808室', isDefault: true },
  { id: 2, name: '李四', phone: '139****9999', province: '上海市', city: '上海市', district: '浦东新区', street: '陆家嘴环路1000号', detail: '恒生银行大厦12层', isDefault: false },
  { id: 3, name: '王五', phone: '137****7777', province: '广东省', city: '深圳市', district: '南山区', street: '科技园南路', detail: '腾讯大厦8楼', isDefault: false },
])

const swipedId = ref<number | null>(null)
const deleteConfirm = ref<number | null>(null)
const showEditModal = ref(false)
const editingAddress = ref<Address | null>(null)
const showRegionPicker = ref(false)
const regionStep = ref<'province' | 'city' | 'district'>('province')

const form = ref({
  name: '',
  phone: '',
  province: '',
  city: '',
  district: '',
  street: '',
  detail: '',
  isDefault: false,
})

const regions = {
  provinces: ['北京市', '上海市', '广东省', '浙江省', '江苏省', '四川省'],
  cities: {
    '北京市': ['北京市'],
    '上海市': ['上海市'],
    '广东省': ['广州市', '深圳市', '东莞市', '佛山市'],
    '浙江省': ['杭州市', '宁波市', '温州市'],
    '江苏省': ['南京市', '苏州市', '无锡市'],
    '四川省': ['成都市', '绵阳市', '德阳市'],
  } as Record<string, string[]>,
  districts: {
    '北京市': ['朝阳区', '海淀区', '东城区', '西城区', '丰台区'],
    '上海市': ['浦东新区', '黄浦区', '静安区', '徐汇区', '长宁区'],
    '广州市': ['天河区', '越秀区', '荔湾区', '白云区'],
    '深圳市': ['南山区', '福田区', '罗湖区', '宝安区'],
    '杭州市': ['西湖区', '上城区', '下城区', '江干区'],
    '成都市': ['锦江区', '青羊区', '金牛区', '武侯区'],
  } as Record<string, string[]>,
}

const canSave = computed(() => form.value.name && form.value.phone && form.value.province && form.value.detail)

const currentRegionOptions = computed(() => {
  if (regionStep.value === 'province') return regions.provinces
  if (regionStep.value === 'city') return regions.cities[form.value.province] || []
  return regions.districts[form.value.city] || []
})

function isSelectedRegion(value: string) {
  if (regionStep.value === 'province') return form.value.province === value
  if (regionStep.value === 'city') return form.value.city === value
  return form.value.district === value
}

function handleSetDefault(id: number) {
  addresses.value = addresses.value.map(a => ({ ...a, isDefault: a.id === id }))
}

function handleDelete(id: number) {
  addresses.value = addresses.value.filter(a => a.id !== id)
  deleteConfirm.value = null
  swipedId.value = null
}

function openEditModal(addr?: Address) {
  if (addr) {
    editingAddress.value = addr
    form.value = { name: addr.name, phone: addr.phone, province: addr.province, city: addr.city, district: addr.district, street: addr.street, detail: addr.detail, isDefault: addr.isDefault }
  } else {
    editingAddress.value = null
    form.value = { name: '', phone: '', province: '', city: '', district: '', street: '', detail: '', isDefault: addresses.value.length === 0 }
  }
  showEditModal.value = true
}

function handleSave() {
  if (!canSave.value) return

  if (editingAddress.value) {
    addresses.value = addresses.value.map(a => {
      if (a.id === editingAddress.value!.id) return { ...a, ...form.value }
      if (form.value.isDefault) return { ...a, isDefault: false }
      return a
    })
  } else {
    const newId = Math.max(...addresses.value.map(a => a.id), 0) + 1
    if (form.value.isDefault) {
      addresses.value = [{ id: newId, ...form.value }, ...addresses.value.map(a => ({ ...a, isDefault: false }))]
    } else {
      addresses.value = [...addresses.value, { id: newId, ...form.value }]
    }
  }
  showEditModal.value = false
}

function openRegionPicker() {
  regionStep.value = 'province'
  showRegionPicker.value = true
}

function handleSelectRegion(value: string) {
  if (regionStep.value === 'province') {
    form.value.province = value
    form.value.city = ''
    form.value.district = ''
    regionStep.value = 'city'
  } else if (regionStep.value === 'city') {
    form.value.city = value
    form.value.district = ''
    regionStep.value = 'district'
  } else {
    form.value.district = value
    showRegionPicker.value = false
    regionStep.value = 'province'
  }
}

function handleRegionBack() {
  if (regionStep.value === 'city') regionStep.value = 'province'
  else if (regionStep.value === 'district') regionStep.value = 'city'
  else showRegionPicker.value = false
}

function goBack() { uni.navigateBack() }
</script>
