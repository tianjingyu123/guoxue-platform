<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- Header -->
    <view class="sticky top-0 z-10 bg-white flex items-center gap-3 px-4 py-3" style="border-bottom: 1px solid #E8E0D5;">
      <view @click="goBack" class="p-1 -ml-1 text-[#2C2C2C]">
        <text class="text-lg">←</text>
      </view>
      <text class="flex-1 text-base font-semibold text-[#2C2C2C] font-serif">
        {{ isEdit ? '编辑地址' : '新增地址' }}
      </text>
    </view>

    <!-- Form -->
    <view class="p-4 space-y-3">
      <view class="bg-white rounded-2xl overflow-hidden shadow-sm">
        <!-- Name -->
        <view class="px-4 py-3.5" style="border-bottom: 1px solid #F5F0EA;">
          <view class="flex items-center gap-3">
            <view class="flex items-center gap-2 w-20 shrink-0">
              <text class="text-[#C41E3A] text-sm">👤</text>
              <text class="text-sm text-[#2C2C2C]">收货人</text>
            </view>
            <input type="text" v-model="form.name" placeholder="填写收货人姓名" class="flex-1 text-sm text-[#2C2C2C] placeholder:text-[#C0B8B0] outline-none bg-transparent" />
          </view>
          <text v-if="errors.name" class="mt-1.5 ml-[88px] text-xs text-[#C41E3A] block">{{ errors.name }}</text>
        </view>
        <!-- Phone -->
        <view class="px-4 py-3.5" style="border-bottom: 1px solid #F5F0EA;">
          <view class="flex items-center gap-3">
            <view class="flex items-center gap-2 w-20 shrink-0">
              <text class="text-[#C41E3A] text-sm">📞</text>
              <text class="text-sm text-[#2C2C2C]">手机号</text>
            </view>
            <input type="tel" v-model="form.phone" placeholder="填写收货人手机号" maxlength="11" class="flex-1 text-sm text-[#2C2C2C] placeholder:text-[#C0B8B0] outline-none bg-transparent" />
          </view>
          <text v-if="errors.phone" class="mt-1.5 ml-[88px] text-xs text-[#C41E3A] block">{{ errors.phone }}</text>
        </view>
        <!-- Region -->
        <view class="px-4 py-3.5" style="border-bottom: 1px solid #F5F0EA;">
          <view @click="openRegionPicker" class="w-full flex items-center gap-3">
            <view class="flex items-center gap-2 w-20 shrink-0">
              <text class="text-[#C41E3A] text-sm">📍</text>
              <text class="text-sm text-[#2C2C2C]">所在地区</text>
            </view>
            <text :class="['flex-1 text-left text-sm', regionText ? 'text-[#2C2C2C]' : 'text-[#C0B8B0]']">
              {{ regionText || '选择省 / 市 / 区' }}
            </text>
            <text class="text-[#C0B8B0] text-sm">›</text>
          </view>
          <text v-if="errors.region" class="mt-1.5 ml-[88px] text-xs text-[#C41E3A] block">{{ errors.region }}</text>
        </view>
        <!-- Address -->
        <view class="px-4 py-3.5">
          <view class="flex items-start gap-3">
            <view class="flex items-center gap-2 w-20 shrink-0 pt-0.5">
              <text class="text-[#C41E3A] text-sm">📍</text>
              <text class="text-sm text-[#2C2C2C]">详细地址</text>
            </view>
            <textarea v-model="form.address" placeholder="街道、楼牌号等" rows="3"
              class="flex-1 text-sm text-[#2C2C2C] placeholder:text-[#C0B8B0] outline-none bg-transparent resize-none leading-relaxed" />
          </view>
          <text v-if="errors.address" class="mt-1.5 ml-[88px] text-xs text-[#C41E3A] block">{{ errors.address }}</text>
        </view>
      </view>

      <!-- Default Toggle -->
      <view @click="form.isDefault = !form.isDefault" class="bg-white rounded-2xl px-4 py-3.5 flex items-center justify-between shadow-sm cursor-pointer">
        <text class="text-sm text-[#2C2C2C]">设为默认地址</text>
        <view :class="['w-5 h-5 rounded-full border-2 flex items-center justify-center transition-colors', form.isDefault ? 'bg-[#C41E3A] border-[#C41E3A]' : 'border-[#D0C8C0]']">
          <text v-if="form.isDefault" class="text-white text-xs">✓</text>
        </view>
      </view>
    </view>

    <!-- Save Button -->
    <view class="fixed bottom-0 left-0 right-0 p-4 bg-white" style="border-top: 1px solid #E8E0D5; padding-bottom: calc(16px + env(safe-area-inset-bottom));">
      <view @click="handleSave"
        :class="['w-full py-3.5 rounded-2xl text-white text-base font-semibold text-center', saving ? 'opacity-60' : 'bg-[#C41E3A]']">
        {{ saving ? '保存中...' : '保存地址' }}
      </view>
    </view>

    <!-- Region Picker -->
    <view v-if="showRegionPicker" class="fixed inset-0 z-50 flex flex-col justify-end">
      <view class="absolute inset-0 bg-black/40" @click="showRegionPicker = false" />
      <view class="relative bg-white rounded-t-3xl overflow-hidden" style="max-height: 70vh;">
        <!-- Header -->
        <view class="px-4 pt-4 pb-3 flex items-center justify-between" style="border-bottom: 1px solid #E8E0D5;">
          <view @click="handlePickerBack" class="text-sm text-[#666666]">
            {{ pickerStep === 'province' ? '取消' : '返回' }}
          </view>
          <view class="flex items-center gap-2">
            <text :class="['text-sm font-medium', pickerStep === 'province' ? 'text-[#C41E3A]' : 'text-[#999999]']">省份</text>
            <text class="text-[#C0B8B0]">/</text>
            <text :class="['text-sm font-medium', pickerStep === 'city' ? 'text-[#C41E3A]' : 'text-[#999999]']">城市</text>
            <text class="text-[#C0B8B0]">/</text>
            <text :class="['text-sm font-medium', pickerStep === 'district' ? 'text-[#C41E3A]' : 'text-[#999999]']">区县</text>
          </view>
          <view class="w-8" />
        </view>
        <!-- Options -->
        <view class="overflow-y-auto" style="max-height: calc(70vh - 60px);">
          <view v-for="p in PROVINCES" :key="p" v-if="pickerStep === 'province'"
            @click="handleProvinceSelect(p)"
            :class="['w-full flex items-center justify-between px-5 py-3.5 text-sm', tempProvince === p ? 'text-[#C41E3A] font-medium bg-[#FEF5F6]' : 'text-[#2C2C2C]']" style="border-bottom: 1px solid #F5F0EA;">
            <text>{{ p }}</text>
            <text v-if="tempProvince === p" class="text-[#C41E3A] text-sm">✓</text>
          </view>
          <view v-for="c in pickerCities" :key="c" v-if="pickerStep === 'city'"
            @click="handleCitySelect(c)"
            :class="['w-full flex items-center justify-between px-5 py-3.5 text-sm', tempCity === c ? 'text-[#C41E3A] font-medium bg-[#FEF5F6]' : 'text-[#2C2C2C]']" style="border-bottom: 1px solid #F5F0EA;">
            <text>{{ c }}</text>
            <text v-if="tempCity === c" class="text-[#C41E3A] text-sm">✓</text>
          </view>
          <view v-for="d in pickerDistricts" :key="d" v-if="pickerStep === 'district'"
            @click="handleDistrictSelect(d)"
            :class="['w-full flex items-center justify-between px-5 py-3.5 text-sm', district === d && province === tempProvince && city === tempCity ? 'text-[#C41E3A] font-medium bg-[#FEF5F6]' : 'text-[#2C2C2C]']" style="border-bottom: 1px solid #F5F0EA;">
            <text>{{ d }}</text>
            <text v-if="district === d && province === tempProvince && city === tempCity" class="text-[#C41E3A] text-sm">✓</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

const REGIONS: Record<string, Record<string, string[]>> = {
  '北京市': { '北京市': ['东城区', '西城区', '朝阳区', '丰台区', '石景山区', '海淀区', '顺义区', '通州区', '大兴区', '昌平区'] },
  '上海市': { '上海市': ['黄浦区', '徐汇区', '长宁区', '静安区', '普陀区', '虹口区', '杨浦区', '浦东新区', '宝山区', '闵行区'] },
  '广东省': {
    '广州市': ['天河区', '越秀区', '海珠区', '荔湾区', '白云区', '黄埔区', '番禺区', '花都区', '南沙区'],
    '深圳市': ['福田区', '罗湖区', '南山区', '宝安区', '龙华区', '龙岗区', '盐田区', '坪山区'],
    '佛山市': ['禅城区', '南海区', '顺德区', '三水区', '高明区'],
  },
  '江苏省': {
    '南京市': ['玄武区', '秦淮区', '建邺区', '鼓楼区', '浦口区', '栖霞区', '雨花台区', '江宁区', '六合区'],
    '苏州市': ['姑苏区', '吴中区', '相城区', '吴江区', '工业园区', '虎丘区'],
  },
  '浙江省': {
    '杭州市': ['上城区', '拱墅区', '西湖区', '滨江区', '萧山区', '余杭区', '富阳区', '临安区'],
    '宁波市': ['海曙区', '江北区', '镇海区', '北仑区', '鄞州区', '奉化区'],
  },
  '四川省': {
    '成都市': ['锦江区', '青羊区', '金牛区', '武侯区', '成华区', '龙泉驿区', '青白江区', '新都区', '温江区'],
  },
  '湖北省': {
    '武汉市': ['江岸区', '江汉区', '硚口区', '汉阳区', '武昌区', '青山区', '洪山区', '东西湖区'],
  },
  '陕西省': {
    '西安市': ['新城区', '碑林区', '莲湖区', '灞桥区', '未央区', '雁塔区', '阎良区', '临潼区', '长安区'],
  },
}

const PROVINCES = Object.keys(REGIONS)

const isEdit = ref(false)
const form = ref({ name: '', phone: '', address: '', isDefault: false })
const province = ref('')
const city = ref('')
const district = ref('')
const errors = ref<Record<string, string>>({})
const saving = ref(false)
const showRegionPicker = ref(false)
const pickerStep = ref<'province' | 'city' | 'district'>('province')
const tempProvince = ref('')
const tempCity = ref('')

const cities = computed(() => province.value ? Object.keys(REGIONS[province.value] || {}) : [])
const districts = computed(() => province.value && city.value ? (REGIONS[province.value]?.[city.value] || []) : [])
const regionText = computed(() => province.value ? [province.value !== city.value ? province.value : '', city.value, district.value].filter(Boolean).join(' ') : '')
const pickerCities = computed(() => tempProvince.value ? Object.keys(REGIONS[tempProvince.value] || {}) : [])
const pickerDistricts = computed(() => tempProvince.value && tempCity.value ? (REGIONS[tempProvince.value]?.[tempCity.value] || []) : [])

// Parse query params
const pages = getCurrentPages()
const currentPage = pages[pages.length - 1] as any
if (currentPage && currentPage.$page && currentPage.$page.options && currentPage.$page.options.id) {
  isEdit.value = true
  form.value = { name: '张三', phone: '13812345678', address: '建国路88号SOHO现代城A座1201室', isDefault: true }
  province.value = '北京市'
  city.value = '北京市'
  district.value = '朝阳区'
}

function validate(): boolean {
  const e: Record<string, string> = {}
  if (!form.value.name.trim()) e.name = '请填写收货人姓名'
  else if (form.value.name.trim().length < 2) e.name = '姓名至少2个字'
  if (!form.value.phone.trim()) e.phone = '请填写手机号'
  else if (!/^1[3-9]\d{9}$/.test(form.value.phone.trim())) e.phone = '请输入有效的手机号'
  if (!province.value) e.region = '请选择省市区'
  if (!form.value.address.trim()) e.address = '请填写详细地址'
  else if (form.value.address.trim().length < 5) e.address = '详细地址至少5个字'
  errors.value = e
  return Object.keys(e).length === 0
}

function handleSave() {
  if (!validate()) return
  saving.value = true
  setTimeout(() => {
    saving.value = false
    uni.showToast({ title: isEdit.value ? '地址已更新' : '地址已添加', icon: 'success' })
    setTimeout(() => goBack(), 800)
  }, 500)
}

function openRegionPicker() {
  tempProvince.value = province.value || ''
  tempCity.value = city.value || ''
  pickerStep.value = 'province'
  showRegionPicker.value = true
}

function handlePickerBack() {
  if (pickerStep.value === 'district') pickerStep.value = 'city'
  else if (pickerStep.value === 'city') pickerStep.value = 'province'
  else showRegionPicker.value = false
}

function handleProvinceSelect(p: string) {
  tempProvince.value = p
  pickerStep.value = 'city'
}

function handleCitySelect(c: string) {
  tempCity.value = c
  pickerStep.value = 'district'
}

function handleDistrictSelect(d: string) {
  province.value = tempProvince.value
  city.value = tempCity.value
  district.value = d
  showRegionPicker.value = false
  pickerStep.value = 'province'
  errors.value.region = ''
}

function goBack() { uni.navigateBack() }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
