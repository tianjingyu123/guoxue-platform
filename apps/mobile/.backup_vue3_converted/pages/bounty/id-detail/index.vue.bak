<template>
  <!-- Loading -->
  <view v-if="loading" class="min-h-screen bg-[#FAF8F5]">
    <view class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 h-14">
        <view @click="goBack" class="p-2 -ml-2"><text class="text-lg text-[#2C2C2C]">&#8249;</text></view>
        <text class="font-medium text-[#2C2C2C]">悬赏详情</text>
        <view class="w-9" />
      </view>
    </view>
    <view class="p-4 space-y-4">
      <view class="animate-pulse space-y-3">
        <view class="h-6 bg-[#F0EDE8] rounded w-3/4" />
        <view class="h-4 bg-[#F0EDE8] rounded w-1/2" />
        <view class="h-32 bg-[#F0EDE8] rounded-xl" />
      </view>
    </view>
  </view>

  <!-- Not Found -->
  <view v-else-if="!bounty" class="min-h-screen bg-[#FAF8F5] flex items-center justify-center">
    <view class="text-center">
      <text class="text-4xl text-[#999] mb-3 block">⚠️</text>
      <text class="text-[#999]">悬赏不存在或已删除</text>
    </view>
  </view>

  <!-- Main Content -->
  <view v-else class="min-h-screen bg-[#FAF8F5] pb-24">
    <!-- Header -->
    <view class="sticky top-0 z-10 bg-[#FAF8F5]/95 border-b border-[#E8E0D5]" style="backdrop-filter:blur(12px)">
      <view class="flex items-center justify-between px-4 h-14">
        <view @click="goBack" class="p-2 -ml-2"><text class="text-lg text-[#2C2C2C]">&#8249;</text></view>
        <text class="font-medium text-[#2C2C2C]">悬赏详情</text>
        <view class="p-2 -mr-2"><text class="text-lg text-[#999]">📤</text></view>
      </view>
    </view>

    <!-- Bounty Info -->
    <view class="p-4 space-y-4">
      <!-- Amount & Status Card -->
      <view class="rounded-2xl p-4" style="background:linear-gradient(135deg,#FFFBEB,#FFF7ED)">
        <view class="flex items-center justify-between mb-3">
          <view class="flex items-center gap-2">
            <text class="text-lg">🎁</text>
            <text class="text-2xl font-bold" style="color:#D97706">¥{{ bounty.amount }}</text>
          </view>
          <text class="px-3 py-1 rounded-full text-sm font-medium" :class="[statusConfig.bg, statusConfig.color]">
            {{ statusConfig.label }}
          </text>
        </view>
        <view v-if="bounty.status === 'open'" class="flex items-center gap-1 text-sm" style="color:#92400E">
          <text class="text-xs">🕐</text>
          <text>{{ getRemainingTime(bounty.expireAt) }}</text>
        </view>
      </view>

      <!-- Poster Info -->
      <view class="flex items-center gap-3">
        <view class="w-10 h-10 rounded-full bg-gradient-to-br from-[#C41E3A]/20 to-[#C41E3A]/5 flex items-center justify-center">
          <text class="text-sm text-[#C41E3A]">👤</text>
        </view>
        <view class="flex-1">
          <text class="font-medium text-sm text-[#2C2C2C] block">{{ bounty.poster.name }}</text>
          <text class="text-xs text-[#999]">{{ formatDate(bounty.createdAt) }} 发布</text>
        </view>
      </view>

      <!-- Title & Content -->
      <view>
        <text class="text-lg font-semibold text-[#2C2C2C] block mb-3">{{ bounty.title }}</text>
        <text class="text-[#2C2C2C]/80 leading-relaxed" style="white-space:pre-wrap">{{ bounty.content }}</text>
      </view>

      <!-- Tags -->
      <view v-if="bounty.tags && bounty.tags.length > 0" class="flex flex-wrap gap-2">
        <text v-for="(tag, i) in bounty.tags" :key="i" class="px-2 py-1 bg-[#F0EDE8] rounded text-xs text-[#999]">
          #{{ tag }}
        </text>
      </view>

      <!-- Stats -->
      <view class="flex items-center gap-4 text-sm text-[#999] pt-2 border-t border-[#E8E0D5]">
        <view class="flex items-center gap-1">
          <text class="text-xs">👁️</text>
          <text>{{ bounty.viewCount }} 浏览</text>
        </view>
        <view class="flex items-center gap-1">
          <text class="text-xs">💬</text>
          <text>{{ bounty.answerCount }} 回答</text>
        </view>
      </view>
    </view>

    <!-- Answers Section -->
    <view class="bg-[#FAF8F5]">
      <view class="px-4 py-3 border-b border-[#E8E0D5]">
        <text class="font-medium text-[#2C2C2C]">全部回答 ({{ bounty.answers.length }})</text>
      </view>

      <!-- Empty Answers -->
      <view v-if="bounty.answers.length === 0" class="py-12 text-center text-[#999]">
        <text class="text-3xl mb-2 block opa">💬</text>
        <text>暂无回答，快来抢答吧</text>
      </view>

      <!-- Answer List -->
      <view v-else>
        <view v-for="answer in bounty.answers" :key="answer.id" class="p-4" style="border-bottom:1rpx solid #E8E0D5">
          <!-- Answer Header -->
          <view class="flex items-start gap-3 mb-3">
            <view class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-100 to-blue-50 flex items-center justify-center shrink-0">
              <text class="text-sm text-blue-600">👤</text>
            </view>
            <view class="flex-1 min-w-0">
              <view class="flex items-center gap-2 flex-wrap">
                <text class="font-medium text-sm text-[#2C2C2C]">{{ answer.author.name }}</text>
                <text v-if="answer.author.title" class="px-1.5 py-0.5 bg-[#C41E3A]/10 text-[#C41E3A] text-xs rounded">
                  {{ answer.author.title }}
                </text>
                <text v-if="answer.isAccepted" class="flex items-center gap-0.5 px-1.5 py-0.5 bg-green-50 text-green-600 text-xs rounded">
                  <text class="text-xs">✓</text>
                  已采纳
                </text>
              </view>
              <text class="text-xs text-[#999] block">{{ formatDateTime(answer.createdAt) }}</text>
            </view>
          </view>

          <!-- Answer Content -->
          <text class="text-[#2C2C2C]/80 leading-relaxed block mb-3" style="white-space:pre-wrap">{{ answer.content }}</text>

          <!-- Answer Actions -->
          <view class="flex items-center justify-between">
            <view @click="handleLikeAnswer(answer.id)"
              class="flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm transition-colors"
              :class="answer.isLiked ? 'bg-[#C41E3A]/10 text-[#C41E3A]' : 'bg-[#F0EDE8] text-[#999]'"
            >
              <text class="text-sm">{{ answer.isLiked ? '👍' : '👍' }}</text>
              <text class="text-xs">{{ answer.likes }}</text>
            </view>

            <view v-if="isPoster && bounty.status === 'open' && !answer.isAccepted"
              @click="handleAcceptAnswer(answer.id)"
              class="flex items-center gap-1.5 px-3 py-1.5 bg-[#C41E3A] text-white rounded-full text-sm"
            >
              <text class="text-xs">🏆</text>
              <text>采纳答案</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Answer Form Modal -->
    <view v-if="showAnswerForm" class="fixed inset-0 z-50 bg-black/50 flex items-end">
      <view class="w-full bg-[#FAF8F5] rounded-t-2xl flex flex-col" style="max-height:80vh">
        <view class="flex items-center justify-between px-4 py-3 border-b border-[#E8E0D5]">
          <text @click="showAnswerForm = false" class="text-[#999]">取消</text>
          <text class="font-medium text-[#2C2C2C]">写回答</text>
          <text @click="handleSubmitAnswer"
            class="text-[#C41E3A] font-medium"
            :class="submitting || answerContent.length < 20 ? 'opacity-50' : ''"
          >{{ submitting ? '提交中...' : '提交' }}</text>
        </view>
        <view class="flex-1 p-4 overflow-auto">
          <textarea v-model="answerContent" placeholder="请输入您的回答，至少20字..."
            class="w-full h-48 p-3 bg-[#F0EDE8] rounded-xl text-sm" style="outline:none;resize:none"
          />
          <text class="text-xs text-[#999] mt-2 block text-right">{{ answerContent.length }}/2000</text>
        </view>
      </view>
    </view>

    <!-- Bottom Actions -->
    <view class="fixed bottom-0 left-0 right-0 bg-white border-t border-[#E8E0D5]" style="padding-bottom:34px">
      <view class="p-4">
        <view v-if="isPoster" class="flex gap-3">
          <!-- Poster: settle -->
          <view v-if="bounty.status === 'open'" @click="handleSettle"
            class="flex-1 py-3 bg-[#C41E3A] text-white rounded-xl font-medium text-center text-sm">
            结算悬赏
          </view>
          <!-- Poster: refund -->
          <view v-if="bounty.status === 'expired' && bounty.answers.length === 0" @click="handleRefund"
            class="flex-1 py-3 rounded-xl font-medium text-center text-sm" style="background:#F59E0B;color:white">
            申请退款
          </view>
          <!-- Poster: view more -->
          <view v-if="bounty.status === 'open' && !bounty.acceptedAnswerId"
            class="flex-1 py-3 bg-[#F0EDE8] text-[#2C2C2C] rounded-xl font-medium text-center text-sm">
            查看更多回答
          </view>
        </view>
        <view v-else class="flex gap-3">
          <!-- Non-poster: answer -->
          <view v-if="bounty.status === 'open' && !hasAnswered"
            @click="showAnswerForm = true"
            class="flex-1 py-3 bg-[#C41E3A] text-white rounded-xl font-medium flex items-center justify-center gap-2 text-sm">
            <text class="text-sm">✉️</text>
            <text>我要回答</text>
          </view>
          <!-- Non-poster: already answered -->
          <view v-if="hasAnswered"
            class="flex-1 py-3 bg-[#F0EDE8] text-[#999] rounded-xl font-medium text-center text-sm">
            已提交回答
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, reactive, computed, onMounted } from 'vue'

interface BountyAnswer {
  id: string
  content: string
  author: { id: string; name: string; avatar: string; title?: string }
  likes: number
  isLiked: boolean
  isAccepted: boolean
  createdAt: string
}

interface BountyDetail {
  id: string
  title: string
  description: string
  content: string
  amount: number
  status: string
  poster: { id: string; name: string; avatar: string }
  answerCount: number
  viewCount: number
  category: string
  tags: string[]
  createdAt: string
  expireAt: string
  answers: BountyAnswer[]
  acceptedAnswerId?: string
}

const bountyId = ref('')
const bounty = ref<BountyDetail | null>(null)
const loading = ref(true)
const showAnswerForm = ref(false)
const answerContent = ref('')
const submitting = ref(false)
const currentUserId = 'user-123'

// @ts-ignore
onMounted(() => {
  // @ts-ignore
  const pages = getCurrentPages()
  // @ts-ignore
  const page = pages[pages.length - 1]
  // @ts-ignore
  if (page?.options?.id) bountyId.value = page.options.id
  loadBounty()
})

async function loadBounty() {
  loading.value = true
  try {
    const mockBounty: BountyDetail = {
      id: bountyId.value || '1',
      title: '如何理解《易经》中的"元亨利贞"？',
      description: '想深入了解《易经》乾卦中"元亨利贞"四德的含义',
      content: '我最近在学习《易经》，对于乾卦的"元亨利贞"这四个字理解不深。\n\n1. 这四个字分别代表什么意思？\n2. 它们之间有什么内在联系？\n3. 在实际生活中如何运用这四德？\n\n希望能得到详细的解答，最好能结合具体案例说明。',
      amount: 50,
      status: 'open',
      poster: { id: 'user-456', name: '国学爱好者', avatar: '' },
      answerCount: 3,
      viewCount: 128,
      category: '易经研究',
      tags: ['易经', '乾卦', '四德'],
      createdAt: '2024-01-15T10:00:00Z',
      expireAt: '2024-01-22T10:00:00Z',
      answers: [
        {
          id: 'answer-1',
          content: '"元亨利贞"是《易经》乾卦的卦辞，被称为"四德"。\n\n**元**：开始、首创、生长之德。代表万物之始，是创造的源动力。\n\n**亨**：通达、顺利、亨通之德。代表事物发展顺畅，如日中天。\n\n**利**：有利、适宜、收获之德。代表成熟收获，获得利益。\n\n**贞**：正固、坚守、纯正之德。代表守正不阿，坚持正道。\n\n这四德代表了事物发展的四个阶段，也是为人处世的四种品德。',
          author: { id: 'user-789', name: '周易大师', avatar: '', title: '易学讲师' },
          likes: 24,
          isLiked: false,
          isAccepted: false,
          createdAt: '2024-01-15T14:30:00Z',
        },
        {
          id: 'answer-2',
          content: '简单来说，元是创始，亨是通达，利是和谐，贞是正固。这四个字概括了天道运行和人生处世的基本原则。',
          author: { id: 'user-101', name: '传统文化研究者', avatar: '' },
          likes: 8,
          isLiked: true,
          isAccepted: false,
          createdAt: '2024-01-16T09:00:00Z',
        },
      ],
    }
    bounty.value = mockBounty
  } catch (error) {
    console.error('Failed to load bounty:', error)
  } finally {
    loading.value = false
  }
}

async function handleSubmitAnswer() {
  if (!answerContent.value.trim() || answerContent.value.length < 20) return
  submitting.value = true
  try {
    // TODO: call API
    answerContent.value = ''
    showAnswerForm.value = false
    loadBounty()
  } catch (error) {
    console.error('Failed to submit answer:', error)
  } finally {
    submitting.value = false
  }
}

async function handleAcceptAnswer(answerId: string) {
  try {
    if (bounty.value) {
      bounty.value.status = 'resolved'
      bounty.value.bestAnswerId = answerId
      bounty.value.answers = bounty.value.answers.map(a =>
        a.id === answerId ? { ...a, isAccepted: true } : a
      )
    }
    uni.showToast({ title: '已采纳答案', icon: 'success' })
  } catch (error) {
    console.error('Failed to accept answer:', error)
  }
}

function handleLikeAnswer(answerId: string) {
  if (bounty.value) {
    bounty.value.answers = bounty.value.answers.map(a =>
      a.id === answerId
        ? { ...a, isLiked: !a.isLiked, likes: a.isLiked ? a.likes - 1 : a.likes + 1 }
        : a
    )
  }
}

async function handleSettle() {
  try {
    if (bounty.value) bounty.value.status = 'settled'
    uni.showToast({ title: '悬赏已结清', icon: 'success' })
  } catch (error) {
    console.error('Failed to settle:', error)
  }
}

async function handleRefund() {
  try {
    // TODO: call API
    loadBounty()
  } catch (error) {
    console.error('Failed to refund:', error)
  }
}

function getStatusConfig(status: string) {
  const configs: Record<string, { label: string; color: string; bg: string }> = {
    open: { label: '进行中', color: 'text-green-600', bg: 'bg-green-50' },
    answered: { label: '已回答', color: 'text-blue-600', bg: 'bg-blue-50' },
    resolved: { label: '已解决', color: 'text-[#C41E3A]', bg: 'bg-[#C41E3A]/10' },
    expired: { label: '已过期', color: 'text-[#999]', bg: 'bg-[#F0EDE8]' },
    cancelled: { label: '已取消', color: 'text-[#999]', bg: 'bg-[#F0EDE8]' },
  }
  return configs[status] || configs.open
}

function getRemainingTime(expireAt: string): string {
  const diff = new Date(expireAt).getTime() - Date.now()
  if (diff <= 0) return '已过期'
  const days = Math.floor(diff / (1000 * 60 * 60 * 24))
  const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))
  if (days > 0) return `剩余 ${days} 天 ${hours} 小时`
  return `剩余 ${hours} 小时`
}

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('zh-CN')
}

function formatDateTime(dateStr: string): string {
  return new Date(dateStr).toLocaleString('zh-CN')
}

const statusConfig = computed(() => bounty.value ? getStatusConfig(bounty.value.status) : { label: '', color: '', bg: '' })
const isPoster = computed(() => bounty.value?.poster.id === currentUserId)
const hasAnswered = computed(() => bounty.value?.answers.some(a => a.author.id === currentUserId))

function goBack() { uni.navigateBack() }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
