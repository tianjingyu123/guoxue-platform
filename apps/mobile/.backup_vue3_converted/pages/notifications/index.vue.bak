<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 导航栏 -->
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between h-14 px-4">
        <view class="flex items-center gap-3">
          <view @click="goBack"><text class="text-xl text-[#2C2C2C]">←</text></view>
          <text class="text-lg font-semibold text-[#2C2C2C]">通知</text>
          <view v-if="unreadCounts && unreadCounts.total > 0" class="px-2 py-0.5 text-xs bg-[#C41E3A] text-white rounded-full">
            {{ unreadCounts.total > 99 ? '99+' : unreadCounts.total }}
          </view>
        </view>
        <view class="flex items-center gap-2">
          <view @click="handleRefresh" class="p-1" :class="refreshing ? 'opacity-50' : ''"><text class="text-lg text-[#999]" :class="refreshing ? 'animate-spin' : ''">🔄</text></view>
          <view
            @click="handleMarkAllRead"
            class="text-xs text-[#C41E3A] px-2 py-1"
            :class="(!unreadCounts || unreadCounts.total === 0 || markingAllRead) ? 'opacity-50' : ''"
          >
            <text>✓✓ 全部已读</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载骨架屏 -->
    <view v-if="loading" class="p-4 space-y-4">
      <view v-for="i in 5" :key="i" class="flex gap-3">
        <view class="w-10 h-10 rounded-full bg-[#F0EBE5] animate-pulse shrink-0" />
        <view class="flex-1 space-y-2">
          <view class="h-4 w-1/3 bg-[#F0EBE5] rounded animate-pulse" />
          <view class="h-4 w-full bg-[#F0EBE5] rounded animate-pulse" />
          <view class="h-4 w-16 bg-[#F0EBE5] rounded animate-pulse" />
        </view>
      </view>
    </view>

    <!-- 错误状态 -->
    <view v-else-if="error" class="text-center py-20">
      <text class="text-4xl text-[#E8E0D5] block mb-3">⚠</text>
      <text class="text-[#999] text-sm block mb-4">{{ error }}</text>
      <view @click="fetchNotifications()" class="inline-block px-6 py-2 bg-[#C41E3A] text-white rounded-full text-sm">重试</view>
    </view>

    <!-- 通知列表 -->
    <view v-else>
      <view v-if="notifications.length === 0" class="text-center py-20">
        <text class="text-4xl text-[#E8E0D5] block mb-3">🔔</text>
        <text class="text-[#999] text-sm">暂无通知</text>
      </view>

      <view class="divide-y divide-[#FAF8F5]">
        <view
          v-for="notification in notifications"
          :key="notification.id"
          :class="['flex gap-3 p-4', !notification.isRead ? 'bg-[#C41E3A]/5' : 'bg-white']"
          @click="handleMarkRead(notification)"
        >
          <!-- 图标 -->
          <view :class="['w-10 h-10 rounded-full flex items-center justify-center shrink-0', typeColors[notification.type]]">
            <image v-if="notification.avatar" :src="notification.avatar" mode="aspectFill" class="w-10 h-10 rounded-full" />
            <text v-else class="text-lg">{{ getIcon(notification.category) }}</text>
          </view>

          <!-- 内容 -->
          <view class="flex-1 min-w-0">
            <view class="flex items-start justify-between gap-2">
              <view class="flex items-center gap-2">
                <text :class="['text-sm font-medium', !notification.isRead ? 'text-[#2C2C2C]' : 'text-[#999]']">
                  {{ notification.title }}
                </text>
                <text v-if="!notification.isRead" class="w-2 h-2 bg-[#C41E3A] rounded-full shrink-0" />
              </view>
              <text class="text-xs text-[#999] shrink-0">{{ notification.time }}</text>
            </view>
            <text :class="['text-sm mt-1 line-clamp-2 block', !notification.isRead ? 'text-[#2C2C2C]' : 'text-[#999]']">
              {{ notification.content }}
            </text>
            <view class="inline-block mt-2 px-2 py-0.5 text-xs bg-[#F5F1EB] rounded text-[#999]">
              {{ notification.category }}
            </view>
          </view>
        </view>
      </view>

      <!-- 底部提示 -->
      <view v-if="notifications.length > 0" class="py-8 text-center text-sm text-[#999]">
        已显示全部通知
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'

interface Message {
  id: number
  title: string
  content: string
  type: 'interaction' | 'system' | 'income' | 'transaction' | 'service'
  category: string
  time: string
  isRead: boolean
  avatar?: string
  link?: string
}

interface MessageUnreadCounts {
  total: number
  interaction: number
  system: number
  income: number
  transaction: number
  service: number
}

const notifications = ref<Message[]>([])
const unreadCounts = ref<MessageUnreadCounts | null>(null)
const loading = ref(true)
const error = ref<string | null>(null)
const refreshing = ref(false)
const markingAllRead = ref(false)

// 通知图标映射
const notificationIcons: Record<string, string> = {
  '评论': '💬',
  '点赞': '❤️',
  '关注': '👤',
  '加入圈子': '👥',
  '课程上新': '🎁',
  '直播预告': '📢',
  '会员到期': '⚠',
  '活动通知': '🎁',
  '课程收益': '💳',
  '打赏收入': '🎁',
  '分销收益': '💳',
  '提现通知': '💳',
  '订单': '🛍',
  '退款': '💳',
  '客服': '🎧',
  '工单': '🎧',
}

// 类型颜色映射
const typeColors: Record<string, string> = {
  interaction: 'bg-blue-100 text-blue-600',
  system: 'bg-amber-100 text-amber-600',
  income: 'bg-green-100 text-green-600',
  transaction: 'bg-purple-100 text-purple-600',
  service: 'bg-rose-100 text-rose-600',
}

async function fetchNotifications(showRefreshing = false) {
  try {
    if (showRefreshing) refreshing.value = true
    else loading.value = true

    const [listRes, countRes] = await Promise.all([
      getMessages(),
      getUnreadCounts(),
    ])

    if (listRes.code === 200) {
      notifications.value = listRes.data?.list || []
    }
    if (countRes.code === 200) {
      unreadCounts.value = countRes.data
    }
    error.value = null
  } catch {
    error.value = '加载失败'
  } finally {
    loading.value = false
    refreshing.value = false
  }
}

async function handleMarkRead(notification: Message) {
  if (!notification.isRead) {
    await markAsRead(notification.id)
    const idx = notifications.value.findIndex(n => n.id === notification.id)
    if (idx >= 0) {
      notifications.value[idx].isRead = true
    }
    if (unreadCounts.value) {
      unreadCounts.value.total = Math.max(0, unreadCounts.value.total - 1)
    }
  }
  if (notification.link) {
    uni.navigateTo({ url: notification.link })
  }
}

async function handleMarkAllRead() {
  if (!unreadCounts.value || unreadCounts.value.total === 0) return
  markingAllRead.value = true
  try {
    const res = await markAllAsRead()
    if (res.code === 200) {
      notifications.value = notifications.value.map(n => ({ ...n, isRead: true }))
      unreadCounts.value = { interaction: 0, system: 0, income: 0, transaction: 0, service: 0, total: 0 }
      uni.showToast({ title: '已全部标记为已读', icon: 'success' })
    }
  } catch {
    uni.showToast({ title: '操作失败', icon: 'none' })
  } finally {
    markingAllRead.value = false
  }
}

function handleRefresh() {
  fetchNotifications(true)
}

function getIcon(category: string): string {
  return notificationIcons[category] || '🔔'
}

function goBack() { uni.navigateBack() }

// API 桩函数 (Mock 数据)
const mockNotifications: Message[] = [
  { id: 1, title: '张大师 赞了你的文章', content: '你的文章《八字命理学习心得》获得了新的点赞', type: 'interaction', category: '点赞', time: '2分钟前', isRead: false, avatar: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=80&q=80' },
  { id: 2, title: '李明华 评论了你的帖子', content: '说得很好，五行生克关系讲解得很透彻！', type: 'interaction', category: '评论', time: '15分钟前', isRead: false, avatar: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=80&q=80' },
  { id: 3, title: '订单支付成功', content: '你购买的《八字命理系统精讲》课程已开通，¥268.00', type: 'transaction', category: '订单', time: '1小时前', isRead: false },
  { id: 4, title: '系统通知', content: '你的账号已通过实名认证，现在可以正常使用所有功能', type: 'system', category: '系统通知', time: '2小时前', isRead: false },
  { id: 5, title: '王老师 关注了你', content: '风水堪舆学院王老师开始关注你的动态', type: 'interaction', category: '关注', time: '3小时前', isRead: false, avatar: 'https://images.unsplash.com/photo-1560250097-0b93528c311a?w=80&q=80' },
  { id: 6, title: '收益到账提醒', content: '课程分销收益已到账 ¥128.00，可前往钱包查看', type: 'income', category: '收益', time: '昨天', isRead: false },
  { id: 7, title: '林道长 邀请你加入圈子', content: '邀请你加入「紫微斗数研习社」', type: 'interaction', category: '加入圈子', time: '昨天', isRead: true, avatar: 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=80&q=80' },
  { id: 8, title: '直播预告', content: '今晚20:00 奇门遁甲飞盘排盘实战案例讲解', type: 'system', category: '直播预告', time: '昨天', isRead: true },
  { id: 9, title: '客服消息', content: '您的问题已转交给专业老师，请耐心等待回复', type: 'service', category: '客服', time: '2天前', isRead: true },
  { id: 10, title: '打赏收入提醒', content: '用户「易学爱好者」打赏了你的文章 ¥10.00', type: 'income', category: '打赏', time: '2天前', isRead: true },
  { id: 11, title: '提现成功', content: '你申请的提现 ¥500.00 已处理，预计1-3个工作日到账', type: 'income', category: '提现', time: '3天前', isRead: true },
  { id: 12, title: '内容审核通知', content: '你发布的内容已通过审核并成功发布', type: 'system', category: '审核', time: '5天前', isRead: true },
]

async function getMessages(): Promise<any> {
  return { code: 200, data: { list: mockNotifications } }
}
async function getUnreadCounts(): Promise<any> {
  const counts = { total: 0, interaction: 0, system: 0, income: 0, transaction: 0, service: 0 }
  mockNotifications.forEach(m => { if (!m.isRead) { counts.total++; (counts as any)[m.type]++ } })
  return { code: 200, data: counts }
}
async function markAsRead(id: number): Promise<any> {
  return { code: 200 }
}
async function markAllAsRead(): Promise<any> {
  return { code: 200 }
}

onMounted(() => {
  fetchNotifications()
})
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
