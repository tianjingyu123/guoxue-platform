<template>
  <!-- 初始加载状态 - 匹配 V0 Suspense fallback LoadingState -->
  <view v-if="initialLoading" class="min-h-screen bg-[#FAF8F5] flex items-center justify-center">
    <text class="text-2xl text-[#C41E3A] animate-spin">⏳</text>
  </view>
  <view v-else class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-50 bg-[#FAF8F5] border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 h-14">
        <view class="p-2 -ml-2" @tap="goBack">
          <text class="w-5 h-5">←</text>
        </view>
        <view class="flex items-center gap-2">
          <view class="flex items-center gap-1 px-3 py-1.5 text-sm text-[#999]" :class="saving ? 'opacity-50' : ''" @tap="handleSaveDraft">
            <text class="w-4 h-4">💾</text>
            <text>{{ saving ? '保存中...' : '草稿' }}</text>
          </view>
          <view class="flex items-center gap-1 px-4 py-1.5 text-sm text-white bg-[#C41E3A] rounded-full"
            :class="(publishing || !content.trim()) ? 'opacity-50' : ''"
            @tap="handlePublish">
            <text class="w-4 h-4">📤</text>
            <text>{{ publishing ? '发布中...' : '发布' }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 类型选择 -->
    <view class="px-4 py-3 border-b border-[#E8E0D5]">
      <view class="flex gap-4">
        <view v-for="t in ['post', 'article']" :key="t"
          class="text-sm font-medium pb-1 border-b-2 transition-colors"
          :class="type === t ? 'text-[#C41E3A] border-[#C41E3A]' : 'text-[#999] border-transparent'"
          @tap="type = t">
          <text>{{ t === 'post' ? '发帖' : '写文章' }}</text>
        </view>
      </view>
    </view>

    <!-- 编辑区 -->
    <view class="flex-1 px-4 py-4">
      <!-- 标题 -->
      <input v-if="type === 'article'"
        v-model="title"
        placeholder="请输入标题"
        class="w-full text-xl font-semibold bg-transparent border-none outline-none placeholder:text-[#999] mb-4"
      />

      <!-- 内容 -->
      <textarea
        v-model="content"
        :placeholder="type === 'post' ? '分享你的想法...' : '开始写作...'"
        class="w-full min-h-[200px] bg-transparent border-none outline-none resize-none text-base leading-relaxed placeholder:text-[#999]"
      />

      <!-- 已上传图片 -->
      <view v-if="images.length > 0" class="grid grid-cols-3 gap-2 mt-4">
        <view v-for="(img, i) in images" :key="i" class="relative aspect-square rounded-lg overflow-hidden bg-[#F5F1EB]">
          <image :src="img" mode="aspectFill" class="w-full h-full" />
          <view class="absolute top-1 right-1 w-5 h-5 bg-black/50 rounded-full flex items-center justify-center" @tap="images = images.filter((_, idx) => idx !== i)">
            <text class="w-3 h-3 text-white">✕</text>
          </view>
        </view>
      </view>

      <!-- 封面预览 -->
      <view v-if="cover && type === 'article'" class="mt-4">
        <text class="text-sm text-[#999] mb-2 block">封面图</text>
        <view class="relative aspect-video rounded-lg overflow-hidden bg-[#F5F1EB]">
          <image :src="cover" mode="aspectFill" class="w-full h-full" />
          <view class="absolute top-2 right-2 w-6 h-6 bg-black/50 rounded-full flex items-center justify-center" @tap="cover = ''">
            <text class="w-4 h-4 text-white">✕</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 选择圈子 -->
    <view class="px-4 py-3 border-t border-[#E8E0D5]">
      <view class="flex items-center gap-2 text-sm" @tap="showCircleSelect = true">
        <template v-if="selectedCircleData">
          <view class="w-6 h-6 rounded-full bg-[#F5F1EB] overflow-hidden">
            <image :src="selectedCircleData.cover" mode="aspectFill" class="w-full h-full" />
          </view>
          <text>{{ selectedCircleData.name }}</text>
        </template>
        <template v-else>
          <text class="w-4 h-4 text-[#999]">#</text>
          <text class="text-[#999]">选择圈子（可选）</text>
        </template>
        <text class="w-4 h-4 text-[#999] ml-auto">›</text>
      </view>
    </view>

    <!-- 选择话题 -->
    <view class="px-4 py-3 border-t border-[#E8E0D5]">
      <view class="flex items-center gap-2 text-sm w-full" @tap="showTopicSelect = true">
        <text class="w-4 h-4 text-[#999]">🏷</text>
        <template v-if="selectedTopics.length > 0">
          <view class="flex flex-wrap gap-1 flex-1">
            <text v-for="t in selectedTopicNames" :key="t" class="px-2 py-0.5 bg-[#C41E3A]/10 text-[#C41E3A] text-xs rounded-full">
              #{{ t }}
            </text>
          </view>
        </template>
        <template v-else>
          <text class="text-[#999]">添加话题标签</text>
        </template>
        <text class="w-4 h-4 text-[#999] ml-auto">›</text>
      </view>
    </view>

    <!-- 工具栏 -->
    <view class="sticky bottom-0 bg-[#FAF8F5] border-t border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 py-3">
        <!-- 格式工具 -->
        <view class="flex items-center gap-4">
          <view @tap="insertFormat('bold')"><text class="w-5 h-5 text-[#999] font-bold">B</text></view>
          <view @tap="insertFormat('italic')"><text class="w-5 h-5 text-[#999] italic">I</text></view>
          <view @tap="insertFormat('quote')"><text class="w-5 h-5 text-[#999]">❝</text></view>
          <view @tap="handleImageUploadClick"><text class="w-5 h-5 text-[#999]">🖼</text></view>
        </view>

        <!-- AI工具 -->
        <view class="flex items-center gap-2">
          <view class="flex items-center gap-1 px-2 py-1 text-xs bg-gradient-to-r from-purple-500/10 to-pink-500/10 text-purple-600 rounded-full"
            @tap="handleAIPolish">
            <text class="w-3 h-3">✨</text>
            润色
          </view>
          <template v-if="type === 'article'">
            <view class="flex items-center gap-1 px-2 py-1 text-xs bg-gradient-to-r from-blue-500/10 to-cyan-500/10 text-blue-600 rounded-full"
              @tap="handleAITitle">
              <text class="w-3 h-3">🪄</text>
              标题
            </view>
            <view class="flex items-center gap-1 px-2 py-1 text-xs bg-gradient-to-r from-green-500/10 to-emerald-500/10 text-green-600 rounded-full"
              @tap="handleAICover">
              <text class="w-3 h-3">🖼</text>
              封面
            </view>
          </template>
          <view class="flex items-center gap-1 px-2 py-1 text-xs bg-gradient-to-r from-orange-500/10 to-amber-500/10 text-orange-600 rounded-full"
            @tap="handleAITags">
            <text class="w-3 h-3">🏷</text>
            标签
          </view>
        </view>
      </view>
    </view>

    <!-- 圈子选择弹窗 -->
    <view v-if="showCircleSelect" class="fixed inset-0 z-50 bg-black/50" @tap="showCircleSelect = false">
      <view class="absolute bottom-0 left-0 right-0 bg-[#FAF8F5] rounded-t-2xl max-h-[60vh] overflow-auto" @tap.stop>
        <view class="sticky top-0 bg-[#FAF8F5] px-4 py-3 border-b border-[#E8E0D5]">
          <text class="font-semibold text-center block">选择圈子</text>
        </view>
        <view class="p-4 space-y-2">
          <view class="w-full flex items-center gap-3 p-3 rounded-xl"
            :class="!selectedCircle ? 'bg-[#C41E3A]/10' : 'bg-[#F5F1EB]'"
            @tap="selectedCircle = null; showCircleSelect = false">
            <view class="w-10 h-10 rounded-full bg-[#F0EBE5] flex items-center justify-center">
              <text class="w-5 h-5 text-[#999]">#</text>
            </view>
            <text>不选择圈子</text>
            <text v-if="!selectedCircle" class="text-[#C41E3A] ml-auto">✓</text>
          </view>
          <view v-for="circle in circles" :key="circle.id"
            class="w-full flex items-center gap-3 p-3 rounded-xl"
            :class="selectedCircle === circle.id ? 'bg-[#C41E3A]/10' : 'bg-[#F5F1EB]'"
            @tap="selectedCircle = circle.id; showCircleSelect = false">
            <view class="w-10 h-10 rounded-full overflow-hidden">
              <image :src="circle.cover" mode="aspectFill" class="w-full h-full" />
            </view>
            <text>{{ circle.name }}</text>
            <text v-if="selectedCircle === circle.id" class="text-[#C41E3A] ml-auto">✓</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 话题选择弹窗 -->
    <view v-if="showTopicSelect" class="fixed inset-0 z-50 bg-black/50" @tap="showTopicSelect = false">
      <view class="absolute bottom-0 left-0 right-0 bg-[#FAF8F5] rounded-t-2xl max-h-[60vh] overflow-auto" @tap.stop>
        <view class="sticky top-0 bg-[#FAF8F5] px-4 py-3 border-b border-[#E8E0D5] flex items-center justify-between">
          <text class="text-sm text-[#999]">已选 {{ selectedTopics.length }}/3</text>
          <text class="font-semibold">选择话题</text>
          <text class="text-[#C41E3A] text-sm" @tap="showTopicSelect = false">完成</text>
        </view>
        <view class="p-4">
          <view class="flex flex-wrap gap-2">
            <view v-for="topic in topics" :key="topic.id"
              class="px-3 py-1.5 rounded-full text-sm"
              :class="selectedTopics.includes(topic.id) ? 'bg-[#C41E3A] text-white' : 'bg-[#F5F1EB] text-[#2C2C2C]'"
              @tap="toggleTopic(topic.id)">
              <text>#{{ topic.name }}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- AI面板 -->
    <view v-if="showAIPanel" class="fixed inset-0 z-50 bg-black/50" @tap="showAIPanel = null">
      <view class="absolute bottom-0 left-0 right-0 bg-[#FAF8F5] rounded-t-2xl max-h-[70vh] overflow-auto" @tap.stop>
        <view class="sticky top-0 bg-[#FAF8F5] px-4 py-3 border-b border-[#E8E0D5] flex items-center justify-between">
          <view @tap="showAIPanel = null">
            <text class="w-5 h-5">✕</text>
          </view>
          <text class="font-semibold flex items-center gap-2">
            <text class="w-4 h-4 text-purple-500">✨</text>
            {{ showAIPanel === 'polish' ? 'AI润色' : showAIPanel === 'title' ? '标题优化' : showAIPanel === 'tags' ? '标签推荐' : '生成封面' }}
          </text>
          <view class="w-5" />
        </view>

        <view class="p-4">
          <!-- 加载中 -->
          <view v-if="aiLoading" class="flex flex-col items-center justify-center py-12">
            <text class="w-8 h-8 text-purple-500">⏳</text>
            <text class="text-sm text-[#999] mt-3">AI正在思考中...</text>
          </view>
          <template v-else>
            <!-- 润色结果 -->
            <view v-if="showAIPanel === 'polish' && aiResult" class="space-y-4">
              <view class="p-3 bg-purple-50 rounded-xl">
                <text class="text-sm whitespace-pre-wrap block">{{ aiResult.polished }}</text>
              </view>
              <view v-if="aiResult.changes" class="space-y-1">
                <text class="text-xs text-[#999] block">优化说明：</text>
                <text v-for="(change, i) in aiResult.changes" :key="i" class="text-xs text-purple-600 block">• {{ change }}</text>
              </view>
              <view class="flex gap-2">
                <view class="flex-1 py-2 bg-purple-500 text-white rounded-xl text-sm text-center" @tap="content = aiResult.polished; showAIPanel = null">应用润色</view>
                <view class="px-4 py-2 border border-[#E8E0D5] rounded-xl text-sm" @tap="handleAIPolish">
                  <text class="w-4 h-4">🔄</text>
                </view>
              </view>
            </view>

            <!-- 标题建议 -->
            <view v-if="showAIPanel === 'title' && aiResult" class="space-y-2">
              <view v-for="(suggestion, i) in aiResult.suggestions" :key="i"
                class="w-full p-3 bg-blue-50 rounded-xl text-left text-sm"
                @tap="title = suggestion; showAIPanel = null">
                <text>{{ suggestion }}</text>
              </view>
              <view class="w-full py-2 border border-[#E8E0D5] rounded-xl text-sm flex items-center justify-center gap-2" @tap="handleAITitle">
                <text class="w-4 h-4">🔄</text>
                换一批
              </view>
            </view>

            <!-- 标签推荐 -->
            <view v-if="showAIPanel === 'tags' && aiResult" class="space-y-4">
              <view class="flex flex-wrap gap-2">
                <view v-for="(tag, i) in aiResult.tags" :key="i"
                  class="px-3 py-1.5 rounded-full text-sm"
                  :class="selectedTags.includes(tag) ? 'bg-orange-500 text-white' : 'bg-orange-50 text-orange-600'"
                  @tap="toggleTag(tag)">
                  <text>{{ tag }}</text>
                </view>
              </view>
              <view class="flex gap-2">
                <view class="flex-1 py-2 bg-orange-500 text-white rounded-xl text-sm text-center" @tap="showAIPanel = null">完成选择</view>
                <view class="px-4 py-2 border border-[#E8E0D5] rounded-xl text-sm" @tap="handleAITags">
                  <text class="w-4 h-4">🔄</text>
                </view>
              </view>
            </view>

            <!-- 封面生成 -->
            <view v-if="showAIPanel === 'cover'" class="space-y-4">
              <view>
                <text class="text-sm text-[#999] mb-2 block">描述你想要的封面</text>
                <textarea v-model="coverPrompt" placeholder="例如：古典中国风，山水画背景，配八卦图案..." class="w-full h-24 p-3 bg-[#F5F1EB] rounded-xl text-sm resize-none" />
              </view>
              <view v-if="aiResult?.imageUrl" class="aspect-video rounded-xl overflow-hidden bg-[#F5F1EB]">
                <image :src="aiResult.imageUrl" mode="aspectFill" class="w-full h-full" />
              </view>
              <view class="flex gap-2">
                <template v-if="aiResult?.imageUrl">
                  <view class="flex-1 py-2 bg-green-500 text-white rounded-xl text-sm text-center" @tap="cover = aiResult.imageUrl; showAIPanel = null">使用此封面</view>
                  <view class="px-4 py-2 border border-[#E8E0D5] rounded-xl text-sm" @tap="handleAICover">
                    <text class="w-4 h-4">🔄</text>
                  </view>
                </template>
                <view v-else class="flex-1 py-2 bg-green-500 text-white rounded-xl text-sm text-center"
                  :class="!coverPrompt.trim() ? 'opacity-50' : ''"
                  @tap="handleAICover">
                  生成封面
                </view>
              </view>
            </view>
          </template>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

// 导航辅助
function goBack() { uni.navigateBack() }
function goTo(url: string) { uni.navigateTo({ url }) }

// 初始加载状态 - 匹配 V0 Suspense fallback
const initialLoading = ref(true)

// Mock 数据
const mockCircles = [
  { id: "1", name: "八字研习社", cover: "/placeholder.svg" },
  { id: "2", name: "紫微斗数交流", cover: "/placeholder.svg" },
  { id: "3", name: "风水堪舆", cover: "/placeholder.svg" },
]

const mockTopics = [
  { id: "1", name: "八字命理" },
  { id: "2", name: "紫微斗数" },
  { id: "3", name: "风水布局" },
  { id: "4", name: "每日打卡" },
  { id: "5", name: "学习心得" },
]

// 编辑器状态
const type = ref<"post" | "article">("post")
const title = ref("")
const content = ref("")
const cover = ref("")
const images = ref<string[]>([])
const selectedCircle = ref<string | null>(null)
const selectedTags = ref<string[]>([])
const selectedTopics = ref<string[]>([])
const circles = ref(mockCircles)
const topics = ref(mockTopics)
const showCircleSelect = ref(false)
const showTopicSelect = ref(false)
const showAIPanel = ref<"polish" | "title" | "tags" | "cover" | null>(null)
const aiLoading = ref(false)
const aiResult = ref<any>(null)
const coverPrompt = ref("")
const saving = ref(false)
const publishing = ref(false)

const selectedCircleData = computed(() => circles.value.find(c => c.id === selectedCircle.value))
const selectedTopicNames = computed(() => selectedTopics.value.map(id => topics.value.find(t => t.id === id)?.name || id))

// 切换话题
const toggleTopic = (id: string) => {
  if (selectedTopics.value.includes(id)) {
    selectedTopics.value = selectedTopics.value.filter(t => t !== id)
  } else if (selectedTopics.value.length < 3) {
    selectedTopics.value = [...selectedTopics.value, id]
  }
}

// 切换标签
const toggleTag = (tag: string) => {
  if (!selectedTags.value.includes(tag)) {
    selectedTags.value = [...selectedTags.value, tag]
  }
}

// 插入格式
const insertFormat = (format: "bold" | "italic" | "quote") => {
  const selected = ""
  switch (format) {
    case "bold": content.value += `**${selected || "粗体文字"}**`; break
    case "italic": content.value += `*${selected || "斜体文字"}*`; break
    case "quote": content.value += `\n> ${selected || "引用文字"}\n`; break
  }
}

// 上传图片
const handleImageUploadClick = () => {
  uni.chooseImage({
    count: 9,
    success: (res) => {
      images.value = [...images.value, ...res.tempFilePaths]
    }
  })
}

// AI润色
const handleAIPolish = async () => {
  if (!content.value.trim()) return
  aiLoading.value = true
  showAIPanel.value = 'polish'
  await new Promise(resolve => setTimeout(resolve, 1000))
  aiResult.value = {
    polished: content.value + "\n\n（AI润色后的内容会更加流畅、专业）",
    changes: ["优化了段落结构", "增强了表达的专业性", "修正了语法问题"]
  }
  aiLoading.value = false
}

// AI标题优化
const handleAITitle = async () => {
  aiLoading.value = true
  showAIPanel.value = 'title'
  await new Promise(resolve => setTimeout(resolve, 1000))
  aiResult.value = {
    suggestions: ["深入解析八字命理的核心奥秘", "八字命理入门：从基础到实践", "探索八字命理的智慧之道"]
  }
  aiLoading.value = false
}

// AI标签推荐
const handleAITags = async () => {
  if (!content.value.trim()) return
  aiLoading.value = true
  showAIPanel.value = 'tags'
  await new Promise(resolve => setTimeout(resolve, 1000))
  aiResult.value = { tags: ["八字命理", "国学智慧", "传统文化", "命理学习", "易学入门"] }
  aiLoading.value = false
}

// AI生成封面
const handleAICover = async () => {
  if (showAIPanel.value !== 'cover') {
    coverPrompt.value = ''
    aiResult.value = null
    showAIPanel.value = 'cover'
    return
  }
  if (!coverPrompt.value.trim()) return
  aiLoading.value = true
  await new Promise(resolve => setTimeout(resolve, 1000))
  aiResult.value = { imageUrl: "/placeholder.svg?cover" }
  aiLoading.value = false
}

// 保存草稿
const handleSaveDraft = async () => {
  saving.value = true
  await new Promise(resolve => setTimeout(resolve, 500))
  uni.showToast({ title: '草稿已保存', icon: 'success' })
  saving.value = false
}

// 发布
const handlePublish = async () => {
  if (!content.value.trim()) return
  publishing.value = true
  await new Promise(resolve => setTimeout(resolve, 1000))
  uni.showToast({ title: '发布成功', icon: 'success' })
  publishing.value = false
  uni.navigateBack()
}

// 初始化 - 匹配 V0 useEffect 读取 searchParams
const pages = getCurrentPages()
const currentPage = pages[pages.length - 1] as any
const options = currentPage?.$page?.options || {}
const editId = options.id || ''
const defaultCircleId = options.circleId || ''
if (defaultCircleId) {
  selectedCircle.value = defaultCircleId
}
// 模拟加载（匹配 V0 Suspense 行为）
setTimeout(() => { initialLoading.value = false }, 300)
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>