<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-20">
    <!-- 头部 -->
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5]">
      <view class="px-4 py-3 flex items-center gap-3">
        <view class="p-1" @click="goBack">
          <text class="text-[#2C2C2C] text-lg">←</text>
        </view>
        <text class="text-lg font-semibold text-[#2C2C2C] flex-1">驿站商品</text>
        <view class="relative p-1" @click="goToCart">
          <text class="text-lg text-[#2C2C2C]">🛒</text>
          <text v-if="cartCount > 0" class="absolute -top-1 -right-0 w-5 h-5 rounded-full flex items-center justify-center text-white text-[10px] leading-none" style="background-color:#C41E3A">
            {{ cartCount }}
          </text>
        </view>
      </view>

      <!-- 搜索框 -->
      <view class="px-4 pb-3">
        <view class="relative">
          <text class="absolute left-3 top-1/2 text-sm text-[#999] z-10" style="transform:translateY(-50%)">🔍</text>
          <input
            v-model="keyword"
            placeholder="搜索商品..."
            class="w-full h-10 pl-10 pr-4 rounded-lg bg-[#F1EDE8] text-sm text-[#2C2C2C] placeholder:text-[#999] outline-none"
            @confirm="handleSearch"
          />
        </view>
      </view>

      <!-- 筛选栏 -->
      <view class="px-4 pb-3 flex items-center gap-2">
        <view
          class="flex items-center gap-1 px-3 py-1.5 rounded-full text-sm transition-colors"
          style="background-color:#F1EDE8"
          @click="showStationPicker = true"
        >
          <text class="truncate" style="max-width:100px">{{ selectedStationName }}</text>
          <text class="text-xs">▼</text>
        </view>
        <view
          class="flex items-center gap-1 px-3 py-1.5 rounded-full text-sm transition-colors"
          style="background-color:#F1EDE8"
          @click="showSortPicker = true"
        >
          <text class="text-xs">🔍</text>
          <text>{{ sortOptions.find(s => s.value === sortBy)?.label }}</text>
        </view>
      </view>

      <!-- 分类Tab -->
      <view class="px-4 pb-3 overflow-x-auto" style="scrollbar-width:none">
        <view class="flex gap-2" style="white-space:nowrap">
          <view
            v-for="cat in categories"
            :key="cat.value"
            :class="['inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm whitespace-nowrap transition-colors']"
            :style="{ backgroundColor: selectedCategory === cat.value ? '#C41E3A' : '#F1EDE8', color: selectedCategory === cat.value ? '#fff' : '#2C2C2C' }"
            @click="selectedCategory = cat.value"
          >
            <text v-if="cat.value !== 'all'" class="text-xs">{{ categoryIcons[cat.value as keyof typeof categoryIcons] || '' }}</text>
            <text>{{ cat.label }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载骨架 -->
    <view v-if="loading" class="p-4">
      <!-- 头部骨架 -->
      <view class="flex items-center gap-3 mb-4">
        <view class="w-8 h-8 rounded-full bg-[#F1EDE8] animate-pulse" />
        <view class="h-5 w-24 bg-[#F1EDE8] rounded animate-pulse" />
      </view>
      <view class="h-10 w-full bg-[#F1EDE8] rounded-lg mb-4 animate-pulse" />
      <!-- 商品网格骨架 -->
      <view class="grid grid-cols-2 gap-3">
        <view v-for="i in 6" :key="i" class="bg-white rounded-xl overflow-hidden">
          <view class="aspect-square bg-[#F1EDE8] animate-pulse" />
          <view class="p-3 space-y-2">
            <view class="h-4 w-3/4 bg-[#F1EDE8] rounded animate-pulse" />
            <view class="h-4 w-1/2 bg-[#F1EDE8] rounded animate-pulse" />
          </view>
        </view>
      </view>
    </view>

    <!-- 商品网格 -->
    <view v-else class="p-4">
      <!-- 空状态 -->
      <view v-if="filteredProducts.length === 0" class="text-center py-20">
        <text class="text-5xl text-[#999]/30 block mb-4">📦</text>
        <text class="text-[#999] block">暂无商品</text>
      </view>

      <!-- 商品列表 -->
      <view v-else class="grid grid-cols-2 gap-3">
        <view
          v-for="product in filteredProducts"
          :key="product.id"
          class="bg-white rounded-xl overflow-hidden border border-[#E8E0D5] transition-transform active:scale-[0.98]"
          @click="goToProductDetail(product.id)"
        >
          <!-- 商品图片 -->
          <view class="relative aspect-square bg-[#F1EDE8] flex items-center justify-center overflow-hidden">
            <image v-if="product.cover" :src="product.cover" mode="aspectFill" class="w-full h-full" />
            <text v-else class="text-4xl text-[#999]/30">{{ categoryIcon(product.category) }}</text>
            <!-- 折扣标签 -->
            <view
              v-if="product.originalPrice > product.price"
              class="absolute top-2 left-2 px-2 py-0.5 rounded text-xs text-white"
              style="background-color:#C41E3A"
            >
              <text>{{ Math.round((1 - product.price / product.originalPrice) * 100) }}%OFF</text>
            </view>
          </view>

          <!-- 商品信息 -->
          <view class="p-3">
            <text class="text-sm font-medium text-[#2C2C2C] line-clamp-2 block mb-2">{{ product.name }}</text>

            <!-- 标签 -->
            <view v-if="product.tags?.length" class="flex flex-wrap gap-1 mb-2">
              <view
                v-for="tag in product.tags.slice(0, 2)"
                :key="tag"
                class="px-1.5 py-0.5 rounded text-xs"
                style="background-color:rgba(196,30,58,0.1);color:#C41E3A"
              >
                <text>{{ tag }}</text>
              </view>
            </view>

            <!-- 价格和购买 -->
            <view class="flex items-end justify-between">
              <view>
                <text class="font-bold" style="color:#C41E3A">¥{{ product.price }}</text>
                <text v-if="product.originalPrice > product.price" class="text-xs text-[#999] line-through ml-1">¥{{ product.originalPrice }}</text>
                <text class="text-xs text-[#999] block mt-0.5">已售 {{ product.sales }}</text>
              </view>
              <view
                class="w-8 h-8 rounded-full flex items-center justify-center transition-colors"
                :style="{ backgroundColor: addingToCart === product.id ? '#22C55E' : '#C41E3A' }"
                @click.stop="handleAddToCart(product.id)"
              >
                <text class="text-white text-sm">{{ addingToCart === product.id ? '✓' : '🛒' }}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 驿站选择弹窗 -->
    <view v-if="showStationPicker" class="fixed inset-0 z-50" style="background-color:rgba(0,0,0,0.5)" @click="showStationPicker = false">
      <view class="absolute bottom-0 left-0 right-0 bg-white rounded-t-2xl max-h-[60vh] overflow-hidden" @click.stop>
        <view class="p-4 border-b border-[#E8E0D5] flex items-center justify-between">
          <text class="font-semibold text-[#2C2C2C]">选择驿站</text>
          <view class="p-1" @click="showStationPicker = false">
            <text class="text-[#999]">▼</text>
          </view>
        </view>
        <view class="overflow-y-auto" style="max-height:50vh">
          <!-- 全部驿站 -->
          <view
            class="w-full px-4 py-3 flex items-center justify-between"
            :style="{ backgroundColor: !selectedStation ? 'rgba(196,30,58,0.1)' : 'transparent' }"
            @click="selectedStation = undefined; showStationPicker = false"
          >
            <text :style="{ color: !selectedStation ? '#C41E3A' : '#2C2C2C' }">全部驿站</text>
            <text v-if="!selectedStation" style="color:#C41E3A; font-weight:bold">✓</text>
          </view>
          <!-- 各驿站 -->
          <view
            v-for="s in stations"
            :key="s.id"
            class="w-full px-4 py-3 flex items-center justify-between"
            :style="{ backgroundColor: selectedStation === s.id ? 'rgba(196,30,58,0.1)' : 'transparent' }"
            @click="selectStation(s.id)"
          >
            <view>
              <text class="font-medium text-[#2C2C2C] block">{{ s.name }}</text>
              <text class="text-sm text-[#999] block">{{ s.city }}</text>
            </view>
            <text v-if="selectedStation === s.id" style="color:#C41E3A; font-weight:bold">✓</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 排序选择弹窗 -->
    <view v-if="showSortPicker" class="fixed inset-0 z-50" style="background-color:rgba(0,0,0,0.5)" @click="showSortPicker = false">
      <view class="absolute bottom-0 left-0 right-0 bg-white rounded-t-2xl" @click.stop>
        <view class="p-4 border-b border-[#E8E0D5] flex items-center justify-between">
          <text class="font-semibold text-[#2C2C2C]">排序方式</text>
          <view class="p-1" @click="showSortPicker = false">
            <text class="text-[#999]">▼</text>
          </view>
        </view>
        <view>
          <view
            v-for="opt in sortOptions"
            :key="opt.value"
            class="w-full px-4 py-3 flex items-center justify-between"
            :style="{ backgroundColor: sortBy === opt.value ? 'rgba(196,30,58,0.1)' : 'transparent' }"
            @click="sortBy = opt.value as 'default' | 'sales' | 'price' | 'newest'; showSortPicker = false"
          >
            <text :style="{ color: sortBy === opt.value ? '#C41E3A' : '#2C2C2C' }">{{ opt.label }}</text>
            <text v-if="sortBy === opt.value" style="color:#C41E3A; font-weight:bold">✓</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

const keyword = ref('')
const selectedStation = ref<number | undefined>(undefined)
const selectedCategory = ref<string>('all')
const sortBy = ref<'default' | 'sales' | 'price' | 'newest'>('default')
const showStationPicker = ref(false)
const showSortPicker = ref(false)
const cartCount = ref(0)
const addingToCart = ref<number | null>(null)
const loading = ref(false)

const categoryIcons = {
  book: '📚',
  tool: '🧭',
  tea: '🍵',
  incense: '🪔',
  ornament: '💎',
  other: '📦',
}

const categories = [
  { value: 'all', label: '全部' },
  { value: 'book', label: '图书' },
  { value: 'tool', label: '工具' },
  { value: 'tea', label: '茶品' },
  { value: 'incense', label: '香品' },
  { value: 'ornament', label: '饰品' },
  { value: 'other', label: '其他' },
]

const sortOptions = [
  { value: 'default', label: '默认排序' },
  { value: 'sales', label: '销量优先' },
  { value: 'price', label: '价格优先' },
  { value: 'newest', label: '最新上架' },
]

interface Station {
  id: number
  name: string
  city: string
}

interface StationProduct {
  id: number
  name: string
  cover: string
  price: number
  originalPrice: number
  sales: number
  category: string
  stationId: number
  tags?: string[]
}

const stations: Station[] = [
  { id: 1, name: '北京朝阳驿站', city: '北京' },
  { id: 2, name: '上海静安驿站', city: '上海' },
  { id: 3, name: '广州天河驿站', city: '广州' },
]

const allProducts: StationProduct[] = [
  { id: 1, name: '滴天髓精解', cover: 'https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=400', price: 68, originalPrice: 98, sales: 328, category: 'book', stationId: 1, tags: ['古籍', '命理'] },
  { id: 2, name: '子平真诠评注', cover: '', price: 88, originalPrice: 0, sales: 215, category: 'book', stationId: 1, tags: ['古籍'] },
  { id: 3, name: '紫微斗数精装版', cover: 'https://images.unsplash.com/photo-1512820790803-83ca734da794?w=400', price: 128, originalPrice: 168, sales: 186, category: 'book', stationId: 2, tags: ['精装'] },
  { id: 4, name: '开运转运手链', cover: 'https://images.unsplash.com/photo-1603975217914-4a6befd2c2cb?w=400', price: 299, originalPrice: 399, sales: 520, category: 'ornament', stationId: 1, tags: ['开运'] },
  { id: 5, name: '檀香香炉套装', cover: '', price: 168, originalPrice: 0, sales: 128, category: 'incense', stationId: 3, tags: ['檀香'] },
  { id: 6, name: '风水罗盘专业版', cover: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400', price: 458, originalPrice: 598, sales: 96, category: 'tool', stationId: 2, tags: ['罗盘', '专业'] },
]

const selectedStationName = computed(() => {
  if (!selectedStation.value) return '全部驿站'
  return stations.find(s => s.id === selectedStation.value)?.name || '选择驿站'
})

const filteredProducts = computed(() => {
  return allProducts.filter(p => {
    const matchStation = !selectedStation.value || p.stationId === selectedStation.value
    const matchCategory = selectedCategory.value === 'all' || p.category === selectedCategory.value
    const matchKeyword = !keyword.value || p.name.includes(keyword.value)
    return matchStation && matchCategory && matchKeyword
  })
})

function categoryIcon(cat: string): string {
  return (categoryIcons as Record<string, string>)[cat] || '📦'
}

function selectStation(id: number) {
  selectedStation.value = id
  showStationPicker.value = false
}

function handleSearch() {
  // 搜索已通过 computed 实时过滤
}

function handleAddToCart(productId: number) {
  addingToCart.value = productId
  cartCount.value++
  uni.showToast({ title: '已加入购物车', icon: 'success' })
  setTimeout(() => { addingToCart.value = null }, 500)
}

function goToProductDetail(id: number) {
  uni.navigateTo({ url: `/pages/mall/product/id-detail/index` })
}

function goToCart() {
  uni.navigateTo({ url: '/pages/cart/index' })
}

function goBack() { uni.navigateBack() }
</script>

<style scoped>
.animate-pulse {
  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
.line-clamp-2 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
</style>
