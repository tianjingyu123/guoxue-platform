<template>
  <!-- Loading State -->
  <view v-if="loading" class="min-h-screen bg-[#FAF8F5]">
    <view class="sticky top-0 z-50 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center px-4 h-14">
        <view class="p-1" @click="goBack">
          <text class="text-[#2C2C2C] text-lg">←</text>
        </view>
      </view>
    </view>
    <view class="p-4 space-y-4">
      <view class="w-full h-48 rounded-lg bg-[#F0EBE5] animate-pulse" />
      <view class="h-6 w-3/4 bg-[#F0EBE5] animate-pulse rounded" />
      <view class="h-4 w-full bg-[#F0EBE5] animate-pulse rounded" />
      <view class="h-4 w-2/3 bg-[#F0EBE5] animate-pulse rounded" />
    </view>
  </view>

  <!-- Error State -->
  <view v-else-if="!station" class="min-h-screen bg-[#FAF8F5] flex items-center justify-center">
    <text class="text-[#999]">驿站不存在</text>
  </view>

  <!-- Main Content -->
  <view v-else class="min-h-screen bg-[#FAF8F5] pb-20">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-50 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 h-14">
        <view class="flex items-center gap-3">
          <view class="p-1" @click="goBack">
            <text class="text-[#2C2C2C] text-lg">←</text>
          </view>
          <text class="text-lg font-semibold text-[#2C2C2C] line-clamp-1 flex-1 text-center mx-4">{{ station.name }}</text>
        </view>
        <view class="flex items-center gap-2">
          <view class="p-2" @click="handleShare">
            <text class="text-[#999]">📤</text>
          </view>
          <view class="p-2" @click="handleToggleFavorite">
            <text :style="{ color: station.isFavorited ? '#EF4444' : '#999' }">{{ station.isFavorited ? '❤️' : '🤍' }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 封面图轮播 -->
    <view class="relative" style="aspect-ratio:2/1">
      <image :src="station.images[currentImageIndex] || station.cover" class="w-full h-full object-cover" mode="aspectFill" />
      <view v-if="station.images.length > 1" class="absolute bottom-3 left-1/2 flex gap-1.5" style="transform:translateX(-50%)">
        <view v-for="(_, idx) in station.images" :key="idx" class="w-2 h-2 rounded-full transition-colors" :style="{ backgroundColor: idx === currentImageIndex ? '#fff' : 'rgba(255,255,255,0.5)' }" @click="currentImageIndex = idx" />
      </view>
      <view class="absolute top-3 left-3 px-2 py-0.5 rounded text-[10px] text-white" style="background-color:#C41E3A">
        <text>{{ station.typeLabel }}</text>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="p-4 bg-white">
      <text class="text-xl font-bold text-[#2C2C2C] block">{{ station.name }}</text>

      <view class="flex items-center gap-2 mt-2">
        <view class="flex items-center gap-1" style="color:#C9A96E">
          <text>⭐</text>
          <text class="font-medium">{{ station.rating }}</text>
        </view>
        <text class="text-sm text-[#999]">({{ station.reviewCount }}条评价)</text>
        <text v-if="station.distance" class="text-[#999]">·</text>
        <text v-if="station.distance" class="text-sm" style="color:#C41E3A">{{ station.distance }}</text>
      </view>

      <view class="flex items-start gap-2 mt-3 text-sm">
        <text class="text-[#999] shrink-0 mt-0.5">📍</text>
        <text class="text-[#999]">{{ station.address }}</text>
      </view>

      <view class="flex items-center gap-2 mt-2 text-sm" style="color:#C41E3A" @click="handleCall">
        <text>📞</text>
        <text>{{ station.phone }}</text>
      </view>

      <view class="flex items-start gap-2 mt-2 text-sm">
        <text class="text-[#999] shrink-0 mt-0.5">🕐</text>
        <view>
          <view v-for="(bh, idx) in station.businessHours" :key="idx" :style="{ color: !bh.isOpen ? '#999' : '#2C2C2C' }">
            <text class="text-sm">{{ bh.day }}: {{ bh.isOpen ? bh.open + '-' + bh.close : '休息' }}</text>
          </view>
        </view>
      </view>

      <!-- 标签 -->
      <view class="flex flex-wrap gap-2 mt-3">
        <view v-for="tag in station.tags" :key="tag" class="px-2 py-0.5 rounded text-xs" style="background-color:#F1EDE8;color:#999">
          <text>{{ tag }}</text>
        </view>
      </view>
    </view>

    <!-- Tab 切换 -->
    <view class="sticky top-14 z-40 bg-white border-b border-[#E8E0D5]">
      <view class="flex">
        <view v-for="tab in tabs" :key="tab.value" class="flex-1 py-3 text-sm font-medium flex items-center justify-center gap-1 transition-colors" :style="{ color: activeTab === tab.value ? '#C41E3A' : '#999', borderBottom: activeTab === tab.value ? '2px solid #C41E3A' : '2px solid transparent' }" @click="activeTab = tab.value">
          <text>{{ tab.icon }}</text>
          <text>{{ tab.label }}</text>
        </view>
      </view>
    </view>

    <!-- Tab 内容 -->
    <view class="p-4">
      <!-- 介绍 -->
      <view v-if="activeTab === 'intro'" class="space-y-6">
        <view v-if="station.manager" class="bg-white rounded-xl p-4 border border-[#E8E0D5]">
          <text class="font-medium text-[#2C2C2C] block mb-3">驿站主理人</text>
          <view class="flex items-center gap-3">
            <view class="w-12 h-12 rounded-full bg-[#F1EDE8] flex items-center justify-center text-sm text-[#2C2C2C]">
              <text>{{ station.manager.name?.charAt(0) || '主' }}</text>
            </view>
            <view>
              <text class="font-medium text-[#2C2C2C] block">{{ station.manager.name }}</text>
              <text class="text-sm text-[#999] block">{{ station.manager.title }}</text>
            </view>
          </view>
        </view>

        <view class="bg-white rounded-xl p-4 border border-[#E8E0D5]">
          <text class="font-medium text-[#2C2C2C] block mb-3">设施服务</text>
          <view class="grid grid-cols-4 gap-4">
            <view v-for="f in station.facilities" :key="f" class="flex flex-col items-center gap-1">
              <view class="w-10 h-10 rounded-full flex items-center justify-center text-lg" style="background-color:rgba(196,30,58,0.1)">
                <text>{{ getFacilityIcon(f) }}</text>
              </view>
              <text class="text-xs text-[#999]">{{ getFacilityLabel(f) }}</text>
            </view>
          </view>
        </view>

        <view class="bg-white rounded-xl p-4 border border-[#E8E0D5]">
          <text class="font-medium text-[#2C2C2C] block mb-3">驿站介绍</text>
          <text class="text-sm text-[#999] leading-relaxed block">{{ station.description }}</text>
        </view>

        <view v-if="station.upcomingEvents.length" class="bg-white rounded-xl p-4 border border-[#E8E0D5]">
          <view class="flex items-center justify-between mb-3">
            <text class="font-medium text-[#2C2C2C]">近期活动</text>
            <view class="text-sm flex items-center" style="color:#C41E3A" @click="goToEvents">
              <text>更多 ›</text>
            </view>
          </view>
          <view class="space-y-3">
            <view v-for="event in station.upcomingEvents" :key="event.id" class="flex items-center gap-3">
              <view class="w-10 h-10 rounded-lg flex items-center justify-center" style="background-color:rgba(196,30,58,0.1)">
                <text class="text-lg" style="color:#C41E3A">📅</text>
              </view>
              <view class="flex-1">
                <text class="text-sm font-medium text-[#2C2C2C] block">{{ event.title }}</text>
                <text class="text-xs text-[#999] block">{{ event.date }}</text>
              </view>
              <view class="px-2 py-0.5 rounded text-[10px] border border-[#E8E0D5] text-[#999]">
                <text>{{ event.type === 'course' ? '课程' : '活动' }}</text>
              </view>
            </view>
          </view>
        </view>

        <view v-if="station.reviews.length" class="bg-white rounded-xl p-4 border border-[#E8E0D5]">
          <view class="flex items-center justify-between mb-3">
            <text class="font-medium text-[#2C2C2C]">用户评价</text>
            <view class="text-sm flex items-center" style="color:#C41E3A">
              <text>全部 ›</text>
            </view>
          </view>
          <view class="space-y-4">
            <view v-for="review in station.reviews" :key="review.id" class="pb-4 border-b border-[#E8E0D5] last:border-0 last:pb-0">
              <view class="flex items-center gap-2">
                <view class="w-8 h-8 rounded-full bg-[#F1EDE8] flex items-center justify-center text-xs text-[#2C2C2C]">
                  <text>{{ review.user.name?.charAt(0) || '用' }}</text>
                </view>
                <view class="flex-1">
                  <text class="text-sm font-medium text-[#2C2C2C] block">{{ review.user.name }}</text>
                  <view class="flex items-center gap-0.5">
                    <text v-for="s in 5" :key="s" class="text-xs" :style="{ color: s <= review.rating ? '#C9A96E' : 'rgba(153,153,153,0.3)' }">⭐</text>
                  </view>
                </view>
                <text class="text-xs text-[#999]">{{ review.time }}</text>
              </view>
              <text class="text-sm text-[#999] mt-2 block">{{ review.content }}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 课程 -->
      <view v-if="activeTab === 'courses'" class="space-y-4">
        <view v-for="i in 3" :key="i" class="bg-white rounded-xl p-4 border border-[#E8E0D5]">
          <view class="flex gap-3">
            <view class="w-20 h-20 rounded-lg bg-[#F1EDE8] flex-shrink-0 flex items-center justify-center">
              <text class="text-2xl text-[#999]/30">📖</text>
            </view>
            <view class="flex-1">
              <text class="font-medium text-sm text-[#2C2C2C] block">八字命理实战研修班（第{{ i }}期）</text>
              <text class="text-xs text-[#999] mt-1 block">周易大师 · 2026年6月{{ 10 + i }}日</text>
              <view class="flex items-center justify-between mt-2">
                <text class="font-medium" style="color:#C41E3A">¥1980</text>
                <view class="px-2 py-0.5 rounded text-[10px] border border-[#E8E0D5]" style="color:#22C55E">
                  <text>报名中</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 商品 -->
      <view v-if="activeTab === 'products'" class="grid grid-cols-2 gap-3">
        <view v-for="i in 4" :key="i" class="bg-white rounded-xl overflow-hidden border border-[#E8E0D5]">
          <view class="aspect-square bg-[#F1EDE8] flex items-center justify-center">
            <text class="text-3xl text-[#999]/30">🖼️</text>
          </view>
          <view class="p-3">
            <text class="text-sm font-medium text-[#2C2C2C] line-clamp-2 block">驿站特色商品{{ i }}</text>
            <text class="font-medium mt-1 block" style="color:#C41E3A">¥{{ 99 * i }}</text>
          </view>
        </view>
      </view>

      <!-- 讲师 -->
      <view v-if="activeTab === 'instructors'" class="space-y-4">
        <view v-for="instructor in station.instructors" :key="instructor.id" class="bg-white rounded-xl p-4 border border-[#E8E0D5]">
          <view class="flex items-center gap-3">
            <view class="w-14 h-14 rounded-full bg-[#F1EDE8] flex items-center justify-center text-lg text-[#2C2C2C]">
              <text>{{ instructor.name?.charAt(0) || '师' }}</text>
            </view>
            <view class="flex-1">
              <text class="font-medium text-[#2C2C2C] block">{{ instructor.name }}</text>
              <text class="text-sm text-[#999] block">{{ instructor.specialty }}</text>
            </view>
            <view class="px-4 py-1.5 rounded-full text-sm text-white" style="background-color:#C41E3A" @click="goToBooking(instructor.id)">
              <text>预约</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部固定操作栏 -->
    <view class="fixed bottom-0 left-0 right-0 bg-white border-t border-[#E8E0D5] p-4 flex gap-3" style="padding-bottom:calc(16rpx + env(safe-area-inset-bottom))">
      <view class="flex-1 py-3 rounded-lg flex items-center justify-center gap-2 text-sm font-medium" style="background-color:#F1EDE8" @click="handleCall">
        <text>📞</text>
        <text>联系客服</text>
      </view>
      <view class="flex-1 py-3 rounded-lg flex items-center justify-center gap-2 text-sm font-medium text-white" style="background-color:#C41E3A" @click="handleNavigate">
        <text>🗺️</text>
        <text>导航到驿站</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'

const loading = ref(true)
const activeTab = ref('intro')
const currentImageIndex = ref(0)
const station = ref<any>(null)

onMounted(() => {
  setTimeout(() => {
    station.value = {
      id: 1, name: '热卜国学·北京朝阳驿站',
      cover: '', images: ['', '', ''],
      type: 'center', typeLabel: '国学中心',
      rating: 4.8, reviewCount: 126,
      distance: '1.2km',
      address: '北京市朝阳区建国路88号SOHO现代城A座1208室',
      phone: '010-88888888',
      status: 'open', isFavorited: false,
      tags: ['国学', '命理', '课程'],
      description: '热卜国学北京朝阳驿站，致力于传播中华优秀传统文化，提供国学课程、命理咨询、文化交流等服务。环境优雅，交通便利。',
      businessHours: [
        { day: '周一至周五', open: '09:00', close: '21:00', isOpen: true },
        { day: '周六至周日', open: '10:00', close: '22:00', isOpen: true },
      ],
      facilities: ['wifi', 'parking', 'tea', 'library', 'classroom', 'consultation'],
      manager: { name: '张道长', title: '驿站主理人', avatar: '' },
      upcomingEvents: [
        { id: 1, title: '八字命理公开课', date: '2026-06-20', type: 'course' },
        { id: 2, title: '国学文化沙龙', date: '2026-06-25', type: 'event' },
      ],
      reviews: [
        { id: 1, user: { name: '易学爱好者', avatar: '' }, rating: 5, content: '环境非常好，老师讲解专业，收获很大！', time: '3天前' },
        { id: 2, user: { name: '命理小白', avatar: '' }, rating: 5, content: '第一次来就被吸引住了，以后会经常来学习。', time: '1周前' },
      ],
      instructors: [
        { id: 1, name: '周易大师', specialty: '八字命理', avatar: '' },
        { id: 2, name: '紫微先生', specialty: '紫微斗数', avatar: '' },
      ],
    }
    loading.value = false
  }, 500)
})

const tabs = [
  { value: 'intro', label: '介绍', icon: '📄' },
  { value: 'courses', label: '课程', icon: '🎓' },
  { value: 'products', label: '商品', icon: '🛍️' },
  { value: 'instructors', label: '讲师', icon: '👤' },
]

function getFacilityIcon(facility: string): string {
  const map: Record<string, string> = { wifi: '📶', parking: '🚗', tea: '🍵', library: '📚', classroom: '👥', consultation: '💬', meditation: '🧘' }
  return map[facility] || '📌'
}

function getFacilityLabel(facility: string): string {
  const map: Record<string, string> = { wifi: 'WiFi', parking: '停车', tea: '茶室', library: '图书', classroom: '教室', consultation: '咨询', meditation: '冥想' }
  return map[facility] || facility
}

function handleToggleFavorite() {
  station.value.isFavorited = !station.value.isFavorited
  uni.showToast({ title: station.value.isFavorited ? '已收藏' : '已取消收藏', icon: 'success' })
}

function handleCall() {
  uni.makePhoneCall({ phoneNumber: station.value.phone })
}

function handleNavigate() {
  uni.showToast({ title: '导航功能开发中', icon: 'none' })
}

function handleShare() {
  uni.setClipboardData({ data: 'https://rebu.com/station/' + station.value.id })
  uni.showToast({ title: '链接已复制', icon: 'success' })
}

function goToBooking(instructorId: number) {
  uni.navigateTo({ url: `/pages/offline/teacher-booking/index?stationId=${station.value.id}&teacherId=${instructorId}` })
}

function goToEvents() {
  uni.navigateTo({ url: '/pages/offline/events/index' })
}

function goBack() { uni.navigateBack() }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
