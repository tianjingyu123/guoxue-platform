<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-40 bg-[#FAF8F5]/95 border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 h-14">
        <view @click="goBack" class="p-2 -ml-2">
          <text class="text-[#2C2C2C]">←</text>
        </view>
        <text class="font-semibold text-base text-[#2C2C2C]">草稿箱</text>
        <view v-if="filteredDrafts.length > 0" class="text-xs text-[#999]">共 {{ filteredDrafts.length }} 篇</view>
      </view>

      <!-- 类型筛选Tab -->
      <scroll-view scroll-x class="flex px-4 pb-3 gap-2" style="white-space: nowrap;">
        <view
          v-for="tab in tabs"
          :key="tab.id"
          @tap="activeTab = tab.id"
          class="px-4 py-1.5 text-sm font-medium rounded-full inline-block transition-all"
          :class="activeTab === tab.id ? 'bg-[#C41E3A] text-white' : 'bg-[#F5F1EB] text-[#999]'"
        >
          <text>{{ tab.label }}</text>
          <text v-if="tab.id !== 'all'" class="ml-1 text-xs opacity-70">({{ filteredByType(tab.id).length }})</text>
        </view>
      </scroll-view>
    </view>

    <!-- 加载骨架屏 -->
    <view v-if="loading" class="p-4 space-y-3">
      <view v-for="i in 4" :key="i" class="bg-white rounded-xl p-4">
        <view class="flex items-start gap-3">
          <view class="w-10 h-10 rounded-xl bg-[#F0EBE5] animate-pulse flex-shrink-0" />
          <view class="flex-1 space-y-2">
            <view class="h-4 w-3/4 bg-[#F0EBE5] rounded animate-pulse" />
            <view class="h-3 w-full bg-[#F0EBE5] rounded animate-pulse" />
            <view class="h-2.5 w-1/3 bg-[#F0EBE5] rounded animate-pulse" />
          </view>
        </view>
      </view>
    </view>

    <!-- 搜索栏 -->
    <view v-if="!loading" class="px-4 pt-2 pb-1">
      <view class="relative">
        <text class="absolute left-3 top-1/2 -translate-y-1/2 text-xs text-[#999]">🔍</text>
        <input
          v-model="draftSearch"
          type="text"
          placeholder="搜索草稿标题"
          class="w-full h-9 pl-9 pr-3 bg-[#F2EFEA] rounded-lg text-sm text-[#2C2C2C] placeholder:text-[#999]"
        />
      </view>
    </view>

    <!-- 批量操作提示 -->
    <view v-if="!loading && selectedDrafts.length > 0" class="px-4 py-2 flex items-center justify-between bg-[#C41E3A]/5 border-b border-[#C41E3A]/10">
      <text class="text-xs text-[#C41E3A]">已选 {{ selectedDrafts.length }} 篇</text>
      <view class="flex items-center gap-3">
        <text class="text-xs text-[#999]" @click="selectedDrafts = []">取消</text>
        <text class="text-xs text-[#FF4D4F]" @click="batchDelete">批量删除</text>
      </view>
    </view>

    <!-- 草稿列表 -->
    <scroll-view v-else scroll-y class="p-4" style="height: calc(100vh - 110px);">
      <view v-if="filteredDrafts.length > 0" class="space-y-3">
        <view v-for="draft in filteredDrafts" :key="draft.id" class="bg-white rounded-xl p-4 border border-[#E8E0D5]/50">
          <view class="flex items-start gap-3">
            <view
              class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0"
              :class="typeConfig[draft.type]?.color || 'bg-[#F0EBE5]'"
            >
              <text class="text-white text-base">{{ getTypeIcon(draft.type) }}</text>
            </view>
            <view class="flex-1 min-w-0" @click="editDraft(draft.id)">
              <text class="font-medium text-sm text-[#2C2C2C] line-clamp-1 block">{{ draft.title || '无标题' }}</text>
              <text class="text-xs text-[#999] line-clamp-2 mt-0.5 block">{{ draft.content }}</text>
              <view class="flex items-center gap-3 mt-2 text-[10px] text-[#999]">
                <text>🕐 {{ formatTime(draft.savedAt) }}</text>
                <text v-if="draft.circle" class="flex items-center gap-0.5">🏯 {{ draft.circle }}</text>
                <text :class="typeConfig[draft.type]?.textColor || 'text-[#999]'">{{ typeConfig[draft.type]?.label }}</text>
              </view>
            </view>
            <view
              class="w-8 h-8 rounded-full bg-[#F5F1EB] flex items-center justify-center flex-shrink-0"
              @click="handleDelete(draft.id)"
            >
              <text class="text-[#999] text-sm">🗑</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view v-else class="flex flex-col items-center justify-center py-20">
        <view class="w-20 h-20 rounded-full bg-[#F5F1EB] flex items-center justify-center mb-4">
          <text class="text-4xl text-[#999]/50">📝</text>
        </view>
        <text class="text-[#999] text-sm mb-1">
          {{ searchByTab(activeTab) }}
        </text>
        <text class="text-[10px] text-[#999] mb-4">开始创作第一篇内容吧</text>
        <view
          class="px-4 py-1.5 bg-[#C41E3A] text-white text-xs font-medium rounded-full"
          @click="goCreate"
        >
          开始创作
        </view>
      </view>
    </scroll-view>

    <!-- 删除确认弹窗 -->
    <view v-if="showDeleteConfirm" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-6">
      <view class="bg-white rounded-2xl p-5 w-full max-w-xs">
        <view class="flex items-center gap-3 mb-3">
          <view class="w-10 h-10 rounded-full bg-red-50 flex items-center justify-center">
            <text class="text-red-500 text-lg">⚠️</text>
          </view>
          <view>
            <text class="font-semibold text-[#2C2C2C] text-base block">确认删除</text>
            <text class="text-xs text-[#999]">删除后无法恢复</text>
          </view>
        </view>
        <view class="flex gap-3 mt-4">
          <view @click="showDeleteConfirm = null" class="flex-1 py-2.5 rounded-xl bg-[#F5F1EB] text-[#2C2C2C] font-medium text-center text-sm">
            取消
          </view>
          <view @click="confirmDelete" class="flex-1 py-2.5 rounded-xl bg-[#FF4D4F] text-white font-medium text-center text-sm">
            删除
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

interface Draft {
  id: number
  type: 'post' | 'article' | 'video'
  title: string
  content: string
  savedAt: string
  circle: string
}

interface TabInfo {
  id: string
  label: string
}

interface TypeConfig {
  label: string
  color: string
  textColor: string
  editPath: string
}

// 加载状态
const loading = ref(true)
setTimeout(() => { loading.value = false }, 500)

// 导航
function goBack() { uni.navigateBack() }
function goTo(url: string) { uni.navigateTo({ url }) }
function goCreate() { uni.showToast({ title: '开始创作(Mock)', icon: 'none' }) }

// Mock数据
const draftsData: Draft[] = [
  { id: 1, type: 'article', title: '八字命理学习心得分享', content: '学习八字已有三年，从最初的懵懂到现在能够独立排盘分析，期间经历了许多感悟和体会⋯⋯', savedAt: '2026-05-09 14:30', circle: '八字命理研习社' },
  { id: 2, type: 'post', title: '', content: '今天研究了一个很有意思的命盘，日主甲木生于子月，年柱有癸水透干⋯⋯', savedAt: '2026-05-08 20:15', circle: '八字命理研习社' },
  { id: 3, type: 'video', title: '紫微斗数入门讲解', content: '视频时长: 05:32 | 已选封面 | 讲解紫微斗数的十二宫位基础概念', savedAt: '2026-05-07 16:45', circle: '紫微斗数交流圈' },
  { id: 4, type: 'article', title: '', content: '风水学中，阳宅的选择至关重要。首先看周边环境，其次看内部格局，最后看流年飞星⋯⋯', savedAt: '2026-05-06 09:20', circle: '风水堪舆学院' },
  { id: 5, type: 'post', title: '求教一个问题', content: '各位老师好，请教一下关于大运流年对原局的影响。大运地支与原局地支形成三合局时，应该如何分析？', savedAt: '2026-05-05 11:00', circle: '八字命理研习社' },
  { id: 6, type: 'article', title: '六爻预测实战案例', content: '今日占得一个很有意思的卦象，客户问事业发展的方向，得水火既济卦⋯⋯', savedAt: '2026-05-04 08:30', circle: '六爻占卜交流' },
  { id: 7, type: 'video', title: '奇门遁甲基础教学', content: '视频时长: 08:15 | 未选封面 | 奇门遁甲的基础概念和排盘方法', savedAt: '2026-05-03 22:00', circle: '奇门遁甲研习社' },
]

const typeConfig: Record<string, TypeConfig> = {
  post: { label: '帖子', color: 'bg-blue-500', textColor: 'text-blue-500', editPath: '/pages/publish?type=post' },
  article: { label: '文章', color: 'bg-[#C9A96E]', textColor: 'text-[#C9A96E]', editPath: '/pages/publish?type=article' },
  video: { label: '短视频', color: 'bg-[#C41E3A]', textColor: 'text-[#C41E3A]', editPath: '/pages/publish/video' },
}

const tabs: TabInfo[] = [
  { id: 'all', label: '全部' },
  { id: 'post', label: '帖子' },
  { id: 'article', label: '文章' },
  { id: 'video', label: '短视频' },
]

const activeTab = ref('all')
const drafts = ref(draftsData)
const showDeleteConfirm = ref<number | null>(null)
const draftSearch = ref('')
const selectedDrafts = ref<number[]>([])

// 带筛选和搜索的草稿列表
const filteredDrafts = computed(() => {
  let result = drafts.value
  if (activeTab.value !== 'all') {
    result = result.filter(d => d.type === activeTab.value)
  }
  if (draftSearch.value.trim()) {
    const q = draftSearch.value.toLowerCase()
    result = result.filter(d =>
      (d.title && d.title.toLowerCase().includes(q)) ||
      d.content.toLowerCase().includes(q)
    )
  }
  return result
})

function batchDelete() {
  if (selectedDrafts.value.length === 0) return
  showDeleteConfirm.value = -1 // special flag for batch delete
}

const filteredByType = (type: string) => {
  return drafts.value.filter(d => d.type === type)
}

const searchByTab = (tab: string) => {
  switch (tab) {
    case 'all': return '暂无草稿'
    case 'post': return '暂无帖子草稿'
    case 'article': return '暂无文章草稿'
    case 'video': return '暂无视频草稿'
    default: return '暂无草稿'
  }
}

const getTypeIcon = (type: string) => {
  switch (type) {
    case 'post': return '💬'
    case 'article': return '📄'
    case 'video': return '🎬'
    default: return '📄'
  }
}

const handleDelete = (id: number) => {
  showDeleteConfirm.value = id
}

const confirmDelete = () => {
  if (showDeleteConfirm.value === -1) {
    if (selectedDrafts.value.length === 0) {
      showDeleteConfirm.value = null
      return
    }
    drafts.value = drafts.value.filter(d => !selectedDrafts.value.includes(d.id))
    uni.showToast({ title: `已删除 ${selectedDrafts.value.length} 篇`, icon: 'success' })
    selectedDrafts.value = []
  } else if (showDeleteConfirm.value) {
    drafts.value = drafts.value.filter(d => d.id !== showDeleteConfirm.value)
    uni.showToast({ title: '已删除', icon: 'success' })
  }
  showDeleteConfirm.value = null
}

const editDraft = (id: number) => {
  const draft = drafts.value.find(d => d.id === id)
  if (draft && typeConfig[draft.type]) {
    uni.navigateTo({ url: typeConfig[draft.type].editPath + '?id=' + id })
  } else {
    uni.showToast({ title: '草稿不存在', icon: 'none' })
  }
}

const formatTime = (time: string) => {
  const date = new Date(time)
  const now = new Date()
  const diff = now.getTime() - date.getTime()
  const days = Math.floor(diff / (1000 * 60 * 60 * 24))
  if (days === 0) return '今天 ' + time.split(' ')[1]
  if (days === 1) return '昨天 ' + time.split(' ')[1]
  if (days < 7) return `${days}天前`
  return time.split(' ')[0]
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
