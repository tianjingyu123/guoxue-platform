<template>
  <view class="min-h-screen flex flex-col" style="background-color:#1a1a2e">
    <!-- 顶部栏 -->
    <view class="flex items-center justify-between px-4 py-3">
      <view @click="goBack" class="w-10 h-10 rounded-full flex items-center justify-center" style="background-color:rgba(255,255,255,0.1)">
        <text class="text-white text-lg">✕</text>
      </view>
      <text class="text-white/60 text-sm">语音搜索</text>
      <view class="w-10" />
    </view>

    <!-- 主内容区 -->
    <view class="flex-1 flex flex-col items-center justify-center px-6">
      <!-- 状态文字 -->
      <view class="h-20 flex items-center justify-center">
        <text v-if="state==='idle'" class="text-white/80 text-lg">点击麦克风开始说话</text>
        <text v-if="state==='recording'" class="text-white text-lg animate-pulse">正在聆听...</text>
        <view v-if="state==='processing'" class="flex items-center gap-2 text-white">
          <text class="animate-spin">⏳</text>
          <text>识别中...</text>
        </view>
        <text v-if="state==='result'" class="text-white/80 text-lg">识别完成</text>
      </view>

      <!-- 波形动画 -->
      <view class="h-24 flex items-center justify-center gap-1 mb-8">
        <view v-for="(height, index) in waveformBars" :key="index" class="w-1.5 rounded-full transition-all duration-100" :style="{height:height*80+'px',backgroundColor:state==='recording' ? `rgba(196,30,58,${0.5+height*0.5})` : 'rgba(255,255,255,0.2)'}" />
      </view>

      <!-- 麦克风按钮 -->
      <view v-if="state==='idle'||state==='recording'">
        <view
          @touchstart="startRecording"
          @touchend="stopRecording"
          @mousedown="startRecording"
          @mouseup="stopRecording"
          :class="'w-24 h-24 rounded-full flex items-center justify-center transition-all ' + (state==='recording' ? 'scale-110 shadow-lg' : '')"
          :style="state==='recording' ? 'background-color:#C41E3A;box-shadow:0 0 24rpx rgba(196,30,58,0.5)' : 'background-color:rgba(255,255,255,0.1)'"
        >
          <text :class="'text-2xl ' + (state==='recording' ? 'text-white' : 'text-white/80')">🎤</text>
        </view>
      </view>

      <!-- 处理中动画 -->
      <view v-if="state==='processing'" class="w-24 h-24 rounded-full flex items-center justify-center" style="background-color:rgba(196,30,58,0.2)">
        <view class="w-16 h-16 rounded-full flex items-center justify-center animate-pulse" style="background-color:rgba(196,30,58,0.4)">
          <text class="text-white text-2xl">🔊</text>
        </view>
      </view>

      <!-- 识别结果 -->
      <view v-if="state==='result'" class="w-full max-w-sm space-y-6">
        <!-- 原始识别文字 -->
        <view class="rounded-2xl p-4" style="background-color:rgba(255,255,255,0.05)">
          <text class="text-white/50 text-xs mb-2" style="display:block">识别结果</text>
          <text class="text-white text-lg" style="display:block">{{transcribedText}}</text>
        </view>

        <!-- 可编辑输入框 -->
        <view class="relative">
          <input
            type="text"
            :value="editedText"
            @input="e => editedText=e.detail.value"
            class="w-full border rounded-xl px-4 py-3 text-white text-sm"
            style="background-color:rgba(255,255,255,0.1);border-color:rgba(255,255,255,0.2);outline:none"
            placeholder="编辑搜索内容..."
          />
          <view v-if="editedText" @click="editedText=''" class="absolute right-3 top-1/2" style="transform:translateY(-50%)">
            <text class="text-white/40 text-sm">✕</text>
          </view>
        </view>

        <!-- 操作按钮 -->
        <view class="flex gap-3">
          <view @click="handleReset" class="flex-1 py-3 rounded-xl text-center text-white/80 text-sm" style="border:1rpx solid rgba(255,255,255,0.2)">
            <text>重新录音</text>
          </view>
          <view @click="handleSearch" :class="'flex-1 py-3 rounded-xl text-center text-white flex items-center justify-center gap-2 text-sm ' + (editedText.trim() ? '' : 'opacity-50')" style="background-color:#C41E3A">
            <text>🔍</text>
            <text>搜索</text>
          </view>
        </view>
      </view>

      <!-- 错误提示 -->
      <view v-if="error" class="mt-6 rounded-xl px-4 py-3 text-red-300 text-sm" style="border:1rpx solid rgba(239,68,68,0.3);background-color:rgba(239,68,68,0.2)">
        <text>{{error}}</text>
      </view>

      <!-- 提示文字 -->
      <view v-if="state==='idle'" class="mt-8">
        <text class="text-white/40 text-sm text-center" style="display:block">长按或点击麦克风开始录音</text>
        <text class="text-white/40 text-sm text-center" style="display:block">松开后自动识别</text>
      </view>
    </view>

    <!-- 底部热门搜索 -->
    <view v-if="state==='idle'" class="px-6 pb-8">
      <text class="text-white/50 text-sm mb-3" style="display:block">试试说：</text>
      <view class="flex flex-wrap gap-2">
        <view v-for="(word,index) in hotWords" :key="index" @click="selectHotWord(word)" class="px-3 py-1.5 rounded-full text-white/70 text-sm" style="background-color:rgba(255,255,255,0.1)">
          <text>{{word}}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onBeforeUnmount } from 'vue'

type RecordingState = 'idle' | 'recording' | 'processing' | 'result'

const state = ref<RecordingState>('idle')
const transcribedText = ref('')
const editedText = ref('')
const error = ref('')
const waveformBars = ref<number[]>(Array(20).fill(0.2))
const hotWords = ['易经入门', '八字排盘', '风水布局', '梅花易数']

let interval: any = null
let animFrame: number | undefined

function startWaveformAnimation() {
  const animate = () => {
    waveformBars.value = waveformBars.value.map(() => 0.2 + Math.random() * 0.8)
    animFrame = requestAnimationFrame(animate)
  }
  interval = setInterval(() => {
    if (animFrame) cancelAnimationFrame(animFrame)
    animate()
  }, 100)
}

function stopWaveformAnimation() {
  if (interval) clearInterval(interval)
  if (animFrame) cancelAnimationFrame(animFrame)
  waveformBars.value = Array(20).fill(0.2)
}

onBeforeUnmount(() => {
  stopWaveformAnimation()
})

function startRecording() {
  error.value = ''
  state.value = 'recording'
  startWaveformAnimation()
}

function stopRecording() {
  if (state.value !== 'recording') return
  stopWaveformAnimation()
  state.value = 'processing'

  // 模拟ASR识别
  setTimeout(() => {
    const mockResults = ['易经入门课程', '八字排盘教程', '风水布局知识', '梅花易数学习', '六爻预测方法']
    const result = mockResults[Math.floor(Math.random() * mockResults.length)]
    transcribedText.value = result
    editedText.value = result
    state.value = 'result'
  }, 1500)
}

function handleSearch() {
  if (!editedText.value.trim()) return
  uni.navigateTo({ url: '/pages/search/result/index?keyword=' + encodeURIComponent(editedText.value.trim()) })
}

function handleReset() {
  state.value = 'idle'
  transcribedText.value = ''
  editedText.value = ''
  error.value = ''
}

function selectHotWord(word: string) {
  editedText.value = word
  transcribedText.value = word
  state.value = 'result'
}

function goBack() {
  uni.navigateBack()
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
