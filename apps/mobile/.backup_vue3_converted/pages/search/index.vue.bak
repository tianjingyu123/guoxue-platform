// ====== 生命周期 ======
onMounted(() => {
  setTimeout(() => {
    inputRef.value?.focus()
  }, 100)
})

// ====== 方法 ======
/** 输入处理 - 更新搜索联想 */
function handleInput() {
  if (keyword.value && !hasResults.value) {
    const firstChar = keyword.value[0]
    const matchedSuggestions = searchSuggestions[firstChar] || []
    const filtered = matchedSuggestions.filter(s =>
      s.keyword.toLowerCase().includes(keyword.value.toLowerCase())
    )
    suggestions.value = filtered
  } else {
    suggestions.value = []
  }
}

/** 执行搜索 */
function handleSearch(searchKeyword?: string) {
  const searchTerm = searchKeyword || keyword.value
  if (!searchTerm.trim()) return

  // 添加到搜索历史（去重，最多 10 条）
  if (!searchHistory.value.includes(searchTerm)) {
    searchHistory.value = [searchTerm, ...searchHistory.value.slice(0, 9)]
  }

  isSearching.value = true
  // 模拟搜索延迟
  setTimeout(() => {
    isSearching.value = false
    hasResults.value = true
    suggestions.value = []
  }, 500)
}

/** 点击联想关键词 */
function handleSuggestionClick(kw: string) {
  keyword.value = kw
  handleSearch(kw)
}

/** 清空搜索历史 */
function handleClearHistory() {
  searchHistory.value = []
}

/** 点击历史/热门关键词 */
function handleHistoryClick(item: string) {
  keyword.value = item
  handleSearch(item)
}

/** 清空输入框 */
function handleClear() {
  keyword.value = ''
  hasResults.value = false
  suggestions.value = []
  setTimeout(() => {
    inputRef.value?.focus()
  }, 100)
}

/** 返回上一页 */
function goBack() {
  uni.navigateBack()
}

/** 跳转到圈子详情 */
function goCircle(id: number) {
  uni.navigateTo({ url: `/pages/circle/id-detail/home/index?id=${id}` })
}

/** 跳转到课程详情 */
function goCourse(id: number) {
  uni.navigateTo({ url: `/pages/course/${id}/index` })
}

/** 跳转到商品详情 */
function goProduct(id: number) {
  uni.navigateTo({ url: `/pages/mall/product/id-detail/index?id=${id}` })
}

/** 跳转到文章详情 */
function goArticle(id: number) {
  uni.navigateTo({ url: `/pages/articles/id-detail/index?id=${id}` })
}

/** 跳转到用户主页 */
function goUser(id: number) {
  uni.navigateTo({ url: `/pages/user/${id}/index` })
}
</script>

<style>
/* 旋转动画 - 搜索加载 */
@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
.animate-spin {
  animation: spin 1s linear infinite;
}

/* 滚动条隐藏 - Tab 栏 */
.scrollbar-hide {
  -ms-overflow-style: none;
  scrollbar-width: none;
}
.scrollbar-hide::-webkit-scrollbar {
  display: none;
}

/* 毛玻璃效果 */
.backdrop-blur-lg {
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

/* 行数限制 */
.line-clamp-1 {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.line-clamp-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 过渡动画 */
.transition-all {
  transition: all 0.2s ease;
}
.transition-colors {
  transition: background-color 0.2s ease;
}
</style>
