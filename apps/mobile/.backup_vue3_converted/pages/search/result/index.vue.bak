<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-20">
    <!-- Header -->
    <view class="sticky top-0 z-20 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center gap-3 px-4 py-3">
        <view class="p-1 -ml-1" @click="goBack">
          <text class="text-xl text-[#2C2C2C]">←</text>
        </view>
        <view class="flex-1 relative">
          <text class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-[#999]">🔍</text>
          <input type="text" v-model="searchValue" @confirm="handleSearch" placeholder="搜索课程、圈子、商品..." class="w-full h-10 pl-10 pr-10 rounded-full bg-[#FAF8F5] text-sm text-[#2C2C2C] placeholder:text-[#999]" />
          <text v-if="searchValue" class="absolute right-3 top-1/2 -translate-y-1/2 text-sm text-[#999]" @click="searchValue = ''">✕</text>
        </view>
        <text class="text-[#C41E3A] text-sm font-medium" @click="handleSearch">搜索</text>
      </view>

      <!-- Tabs -->
      <view class="flex px-2 overflow-x-auto">
        <view v-for="tab in tabs" :key="tab.key" :class="['flex-shrink-0 px-4 py-3 text-sm font-medium border-b-2', activeTab === tab.key ? 'text-[#C41E3A] border-[#C41E3A]' : 'text-[#666] border-transparent']" @click="activeTab = tab.key">
          {{ tab.label }}
        </view>
      </view>
    </view>

    <!-- Content -->
    <view>
      <!-- Loading -->
      <view v-if="loading" class="p-4 space-y-4">
        <view v-for="i in 5" :key="i" class="bg-white rounded-2xl p-4 animate-pulse">
          <view class="h-4 bg-[#E8E0D5] rounded w-3/4 mb-3" />
          <view class="h-3 bg-[#E8E0D5] rounded w-full mb-2" />
          <view class="h-3 bg-[#E8E0D5] rounded w-2/3" />
        </view>
      </view>

      <view v-else>
        <!-- AI Summary (only in 'all' tab) -->
        <view v-if="activeTab === 'all'" class="p-4">
          <view class="bg-gradient-to-br from-[#C41E3A]/5 to-[#C9A96E]/10 rounded-2xl overflow-hidden">
            <view class="flex items-center justify-between p-4" @click="aiExpanded = !aiExpanded">
              <view class="flex items-center gap-2">
                <view class="w-8 h-8 rounded-full bg-gradient-to-br from-[#C41E3A] to-[#C9A96E] flex items-center justify-center">
                  <text class="text-white text-sm">✨</text>
                </view>
                <text class="font-medium text-[#2C2C2C]">AI智能总结</text>
              </view>
              <text :class="['text-sm text-[#666] transition-transform', aiExpanded ? 'rotate-180' : '']">▾</text>
            </view>

            <view v-if="aiExpanded" class="px-4 pb-4 space-y-3">
              <text class="text-sm text-[#666] leading-relaxed">{{ aiSummary.summary }}</text>
              <view class="space-y-2">
                <text class="text-xs text-[#999]">核心要点</text>
                <view class="flex flex-wrap gap-2">
                  <text v-for="(point, i) in aiSummary.keyPoints" :key="i" class="px-3 py-1 bg-white rounded-full text-xs text-[#666]">{{ point }}</text>
                </view>
              </view>
              <view class="space-y-2">
                <text class="text-xs text-[#999]">相关问题</text>
                <view class="space-y-1">
                  <text v-for="(q, i) in aiSummary.relatedQuestions" :key="i" class="block text-sm text-[#C41E3A]" @click="searchRelated(q)">{{ q }}</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- Results -->
        <view class="px-4 space-y-4">
          <!-- Content Results -->
          <view v-if="(activeTab === 'all' || activeTab === 'content') && results.contents.length > 0" class="space-y-3">
            <view v-if="activeTab === 'all'" class="flex items-center justify-between">
              <text class="font-medium text-[#2C2C2C]">相关内容</text>
              <text class="text-xs text-[#C41E3A]" @click="activeTab = 'content'">查看全部</text>
            </view>
            <view v-for="item in results.contents" :key="item.id" class="bg-white rounded-2xl p-4" @click="goContent(item)">
              <view class="flex gap-3">
                <view v-if="item.cover" class="w-24 h-16 rounded-lg bg-gradient-to-br from-[#C41E3A]/20 to-[#C9A96E]/20 flex-shrink-0 flex items-center justify-center">
                  <text class="text-lg text-[#C41E3A]">{{ item.type === 'video' ? '▶' : '📄' }}</text>
                </view>
                <view class="flex-1 min-w-0">
                  <view class="flex items-center gap-2 mb-1">
                    <text :class="['px-1.5 py-0.5 text-[10px] rounded', item.type === 'video' ? 'bg-[#C41E3A]/10 text-[#C41E3A]' : item.type === 'article' ? 'bg-blue-100 text-blue-600' : 'bg-green-100 text-green-600']">{{ item.type === 'video' ? '视频' : item.type === 'article' ? '文章' : '帖子' }}</text>
                  </view>
                  <text class="font-medium text-[#2C2C2C] text-sm line-clamp-1 block" v-html="highlightKeyword(item.title)"></text>
                  <text class="text-xs text-[#999] line-clamp-2 mt-1 block" v-html="highlightKeyword(item.summary)"></text>
                  <view class="flex items-center justify-between mt-2">
                    <text class="text-xs text-[#999]">{{ item.author.name }}</text>
                    <view class="flex items-center gap-3 text-xs text-[#999]">
                      <text>❤️ {{ item.likes }}</text>
                      <text>💬 {{ item.comments }}</text>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>

          <!-- Circle Results -->
          <view v-if="(activeTab === 'all' || activeTab === 'circle') && results.circles.length > 0" class="space-y-3">
            <view v-if="activeTab === 'all'" class="flex items-center justify-between">
              <text class="font-medium text-[#2C2C2C]">相关圈子</text>
              <text class="text-xs text-[#C41E3A]" @click="activeTab = 'circle'">查看全部</text>
            </view>
            <view v-for="circle in results.circles" :key="circle.id" class="bg-white rounded-2xl p-4 flex items-center gap-3" @click="goCircle(circle.id)">
              <view class="w-14 h-14 rounded-xl bg-gradient-to-br from-[#C41E3A]/20 to-[#C9A96E]/20 flex items-center justify-center">
                <text class="text-lg text-[#C41E3A]">👥</text>
              </view>
              <view class="flex-1 min-w-0">
                <text class="font-medium text-[#2C2C2C] block">{{ circle.name }}</text>
                <text class="text-xs text-[#999] line-clamp-1 mt-0.5 block">{{ circle.description }}</text>
                <view class="flex items-center gap-3 mt-1 text-xs text-[#999]">
                  <text>{{ formatNumber(circle.memberCount) }}成员</text>
                  <text>{{ formatNumber(circle.postCount) }}帖子</text>
                </view>
              </view>
              <view class="px-4 py-1.5 bg-[#C41E3A] text-white text-xs rounded-full">加入</view>
            </view>
          </view>

          <!-- Course Results -->
          <view v-if="(activeTab === 'all' || activeTab === 'course') && results.courses.length > 0" class="space-y-3">
            <view v-if="activeTab === 'all'" class="flex items-center justify-between">
              <text class="font-medium text-[#2C2C2C]">相关课程</text>
              <text class="text-xs text-[#C41E3A]" @click="activeTab = 'course'">查看全部</text>
            </view>
            <view :class="activeTab === 'course' ? 'grid grid-cols-2 gap-3' : 'space-y-3'">
              <view v-for="course in results.courses" :key="course.id" :class="['bg-white rounded-2xl overflow-hidden', activeTab === 'course' ? '' : 'flex gap-3 p-4']" @click="goCourse(course.id)">
                <view :class="['bg-gradient-to-br from-[#C41E3A]/20 to-[#C9A96E]/20 flex items-center justify-center', activeTab === 'course' ? 'aspect-[4/3]' : 'w-24 h-16 rounded-lg flex-shrink-0']">
                  <text class="text-2xl text-[#C41E3A]">📚</text>
                </view>
                <view :class="activeTab === 'course' ? 'p-3' : 'flex-1 min-w-0'">
                  <text class="font-medium text-[#2C2C2C] text-sm line-clamp-2 block">{{ course.title }}</text>
                  <text class="text-xs text-[#999] mt-1 block">{{ course.teacher }}</text>
                  <view class="flex items-center gap-2 mt-1">
                    <view class="flex items-center gap-0.5">
                      <text class="text-xs text-[#C9A96E]">★</text>
                      <text class="text-xs text-[#C9A96E]">{{ course.rating }}</text>
                    </view>
                    <text class="text-xs text-[#999]">{{ formatNumber(course.studentCount) }}人学习</text>
                  </view>
                  <view class="flex items-center gap-2 mt-2">
                    <text class="text-[#C41E3A] font-bold">¥{{ course.price }}</text>
                    <text v-if="course.originalPrice" class="text-xs text-[#999] line-through">¥{{ course.originalPrice }}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>

          <!-- Product Results -->
          <view v-if="(activeTab === 'all' || activeTab === 'product') && results.products.length > 0" class="space-y-3">
            <view v-if="activeTab === 'all'" class="flex items-center justify-between">
              <text class="font-medium text-[#2C2C2C]">相关商品</text>
              <text class="text-xs text-[#C41E3A]" @click="activeTab = 'product'">查看全部</text>
            </view>
            <view class="grid grid-cols-2 gap-3">
              <view v-for="product in results.products" :key="product.id" class="bg-white rounded-2xl overflow-hidden" @click="goProduct(product.id)">
                <view class="aspect-square bg-gradient-to-br from-[#C41E3A]/10 to-[#C9A96E]/10 flex items-center justify-center">
                  <text class="text-3xl text-[#C41E3A]/50">🛍️</text>
                </view>
                <view class="p-3">
                  <text class="font-medium text-[#2C2C2C] text-sm line-clamp-2 block">{{ product.name }}</text>
                  <view class="flex items-center justify-between mt-2">
                    <view class="flex items-center gap-1">
                      <text class="text-[#C41E3A] font-bold">¥{{ product.price }}</text>
                      <text v-if="product.originalPrice" class="text-xs text-[#999] line-through">¥{{ product.originalPrice }}</text>
                    </view>
                    <text class="text-xs text-[#999]">{{ product.sales }}人购买</text>
                  </view>
                </view>
              </view>
            </view>
          </view>

          <!-- User Results -->
          <view v-if="(activeTab === 'all' || activeTab === 'user') && results.users.length > 0" class="space-y-3">
            <view v-if="activeTab === 'all'" class="flex items-center justify-between">
              <text class="font-medium text-[#2C2C2C]">相关用户</text>
              <text class="text-xs text-[#C41E3A]" @click="activeTab = 'user'">查看全部</text>
            </view>
            <view v-for="user in results.users" :key="user.id" class="bg-white rounded-2xl p-4 flex items-center gap-3" @click="goUser(user.id)">
              <view class="w-12 h-12 rounded-full bg-gradient-to-br from-[#C41E3A]/20 to-[#C9A96E]/20 flex items-center justify-center">
                <text class="text-lg text-[#C41E3A]">👤</text>
              </view>
              <view class="flex-1 min-w-0">
                <text class="font-medium text-[#2C2C2C] block">{{ user.name }}</text>
                <text v-if="user.bio" class="text-xs text-[#999] line-clamp-1 mt-0.5 block">{{ user.bio }}</text>
                <view class="flex items-center gap-1 mt-1 text-xs text-[#999]">
                  <text>{{ formatNumber(user.followers) }}粉丝</text>
                </view>
              </view>
              <view :class="['px-4 py-1.5 text-xs rounded-full', user.isFollowed ? 'bg-gray-100 text-[#666]' : 'bg-[#C41E3A] text-white']">{{ user.isFollowed ? '已关注' : '关注' }}</view>
            </view>
          </view>

          <!-- Empty State -->
          <view v-if="!loading && results.contents.length === 0 && results.circles.length === 0 && results.courses.length === 0 && results.products.length === 0 && results.users.length === 0" class="py-20 text-center">
            <view class="w-20 h-20 mx-auto mb-4 rounded-full bg-[#FAF8F5] flex items-center justify-center">
              <text class="text-2xl text-[#999]">🔍</text>
            </view>
            <text class="text-[#999] block">未找到相关结果</text>
            <text class="text-sm text-[#999] mt-1 block">换个关键词试试</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'

const tabs = [
  { key: 'all', label: '综合' },
  { key: 'content', label: '内容' },
  { key: 'circle', label: '圈子' },
  { key: 'course', label: '课程' },
  { key: 'product', label: '商品' },
  { key: 'user', label: '用户' },
]

const searchValue = ref('')
const activeTab = ref('all')
const loading = ref(true)
const aiExpanded = ref(true)
const keyword = ref('')

const aiSummary = { summary: '', keyPoints: [] as string[], relatedQuestions: [] as string[] }
const results = { contents: [] as any[], circles: [] as any[], courses: [] as any[], products: [] as any[], users: [] as any[] }

onMounted(() => {
  // 从路由参数获取关键词
  const pages = getCurrentPages()
  const currentPage = pages[pages.length - 1] as any
  if (currentPage && currentPage.$page && currentPage.$page.options) {
    const kw = currentPage.$page.options.keyword || ''
    keyword.value = kw
    searchValue.value = kw
  }

  // 构建AI摘要和搜索结果
  const kw = keyword.value || '八字'
  aiSummary.summary = `关于"${kw}"的搜索结果显示，这是国学领域的重要概念。根据平台内容分析，相关课程和文章主要涵盖基础理论、实践应用和案例分析三个方面。`
  aiSummary.keyPoints = ['基础理论知识体系完整', '实践案例丰富详实', '多位名师深度讲解']
  aiSummary.relatedQuestions = ['如何入门学习？', '有哪些经典书籍推荐？', '实际应用场景有哪些？']

  results.contents = [
    { id: '1', type: 'article' as const, title: `深入解读${kw}的核心要义`, summary: '本文从多个角度深入分析，帮助读者全面理解其内涵与外延...', cover: '', author: { id: '1', name: '张老师', avatar: '' }, likes: 328, comments: 56, createdAt: '2024-01-15' },
    { id: '2', type: 'video' as const, title: `${kw}入门必看教程`, summary: '零基础小白也能快速上手，系统学习核心知识点...', cover: '', author: { id: '2', name: '李讲师', avatar: '' }, likes: 892, comments: 124, createdAt: '2024-01-10' },
    { id: '3', type: 'post' as const, title: `我学习${kw}三年的心得体会`, summary: '分享我的学习历程和一些实用的学习方法...', cover: '', author: { id: '3', name: '老学员', avatar: '' }, likes: 156, comments: 38, createdAt: '2024-01-08' },
  ]
  results.circles = [
    { id: '1', name: `${kw}研习社`, description: '专注于国学知识的深度探讨与交流', memberCount: 12580, postCount: 3420 },
    { id: '2', name: `${kw}爱好者`, description: '志同道合的朋友一起学习成长', memberCount: 8960, postCount: 2180 },
  ]
  results.courses = [
    { id: '1', title: `${kw}系统精讲课`, price: 299, originalPrice: 599, teacher: '王教授', studentCount: 5680, rating: 4.9 },
    { id: '2', title: `${kw}实战应用班`, price: 199, originalPrice: 399, teacher: '赵讲师', studentCount: 3240, rating: 4.8 },
    { id: '3', title: `${kw}高级研修课`, price: 499, originalPrice: 999, teacher: '钱大师', studentCount: 1890, rating: 4.9 },
  ]
  results.products = [
    { id: '1', name: `${kw}经典教材`, price: 68, originalPrice: 98, sales: 2380 },
    { id: '2', name: `${kw}学习工具套装`, price: 128, originalPrice: 198, sales: 1560 },
  ]
  results.users = [
    { id: '1', name: '国学大师张三', bio: '专注国学研究30年，著有多部畅销书籍', followers: 128000, isFollowed: false },
    { id: '2', name: '李老师讲国学', bio: '每日分享国学智慧，让传统文化走进生活', followers: 86000, isFollowed: true },
  ]

  setTimeout(() => { loading.value = false }, 800)
})

function escapeHtml(str: string): string {
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;')
}

function highlightKeyword(text: string): string {
  const escaped = escapeHtml(text)
  if (!keyword.value) return escaped
  const escapedKeyword = escapeHtml(keyword.value)
  const regex = new RegExp(`(${escapeRegExp(escapedKeyword)})`, 'gi')
  return escaped.replace(regex, '<span class="text-[#C41E3A] font-medium">$1</span>')
}

function escapeRegExp(str: string) {
  return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
}

function formatNumber(num: number) {
  if (num >= 10000) return (num / 10000).toFixed(1) + '万'
  if (num >= 1000) return (num / 1000).toFixed(1) + 'k'
  return num.toString()
}

function handleSearch() {
  if (searchValue.value.trim()) {
    uni.redirectTo({ url: `/pages/search/result/index?keyword=${encodeURIComponent(searchValue.value.trim())}` })
  }
}

function searchRelated(q: string) {
  uni.navigateTo({ url: `/pages/search/result/index?keyword=${encodeURIComponent(q)}` })
}

function goBack() { uni.navigateBack() }
function goContent(item: { id: string; type: string }) {
  if (item.type === 'video') uni.navigateTo({ url: `/pages/videos/${item.id}/index` })
  else uni.navigateTo({ url: `/pages/articles/${item.id}/index` })
}
function goCircle(id: string) { uni.navigateTo({ url: `/pages/circles/${id}/index` }) }
function goCourse(id: string) { uni.navigateTo({ url: `/pages/courses/${id}/index` }) }
function goProduct(id: string) { uni.navigateTo({ url: `/pages/mall/product/id-detail/index?id=${id}` }) }
function goUser(id: string) { uni.navigateTo({ url: `/pages/users/${id}/index` }) }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
