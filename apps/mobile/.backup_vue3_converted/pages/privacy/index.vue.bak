<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-40 bg-[#FAF8F5]/95 backdrop-blur-lg border-b border-[#E8E0D5]">
      <view class="flex items-center gap-3 px-4 h-14">
        <view @click="goBack"><text class="text-lg text-[#2C2C2C]">←</text></view>
        <text class="font-semibold text-lg text-[#2C2C2C]">隐私设置</text>
      </view>
    </view>

    <!-- 骨架屏 -->
    <view v-if="loading" class="p-4">
      <view class="bg-white rounded-xl overflow-hidden shadow-sm mb-4">
        <view v-for="i in 5" :key="i" class="flex items-center justify-between px-4 py-4 border-b border-[#FAF8F5] animate-pulse">
          <view>
            <view class="w-28 h-4 bg-[#F0EBE5] rounded mb-1.5" />
            <view class="w-40 h-3 bg-[#F0EBE5] rounded" />
          </view>
          <view class="w-10 h-5 bg-[#F0EBE5] rounded-full" />
        </view>
      </view>
    </view>

    <!-- 主内容 -->
    <view v-else class="p-4">
      <!-- 隐私设置分组 -->
      <view class="bg-white rounded-xl overflow-hidden shadow-sm border border-[#E8E0D5] mb-4">
        <view class="px-4 py-3 bg-[#FAF8F5] border-b border-[#E8E0D5]">
          <text class="text-sm font-semibold text-[#2C2C2C]">🔒 隐私设置</text>
        </view>
        <view v-for="s in privacySettings" :key="s.key" class="flex items-center justify-between px-4 py-3.5 border-b border-[#FAF8F5] last:border-b-0">
          <view class="flex-1 mr-4">
            <text class="text-sm text-[#2C2C2C] block">{{ s.label }}</text>
            <text class="text-xs text-[#999] mt-0.5 block">{{ s.desc }}</text>
          </view>
          <switch :checked="s.value" color="#C41E3A" @change="toggleSetting(s.key)" />
        </view>
      </view>

      <!-- 消息通知设置 -->
      <view class="bg-white rounded-xl overflow-hidden shadow-sm border border-[#E8E0D5] mb-4">
        <view class="px-4 py-3 bg-[#FAF8F5] border-b border-[#E8E0D5]">
          <text class="text-sm font-semibold text-[#2C2C2C]">🔔 消息通知</text>
        </view>
        <view v-for="s in notificationSettings" :key="s.key" class="flex items-center justify-between px-4 py-3.5 border-b border-[#FAF8F5] last:border-b-0">
          <view class="flex-1 mr-4">
            <text class="text-sm text-[#2C2C2C] block">{{ s.label }}</text>
            <text class="text-xs text-[#999] mt-0.5 block">{{ s.desc }}</text>
          </view>
          <switch :checked="s.value" color="#C41E3A" @change="toggleNotification(s.key)" />
        </view>
      </view>

      <!-- 数据管理 -->
      <view class="bg-white rounded-xl overflow-hidden shadow-sm border border-[#E8E0D5] mb-4">
        <view class="px-4 py-3 bg-[#FAF8F5] border-b border-[#E8E0D5]">
          <text class="text-sm font-semibold text-[#2C2C2C]">📊 数据管理</text>
        </view>
        <view class="px-4 py-3.5 border-b border-[#FAF8F5] flex items-center justify-between" @click="clearCache">
          <view>
            <text class="text-sm text-[#2C2C2C] block">🗑 清除缓存</text>
            <text class="text-xs text-[#999] mt-0.5 block">当前缓存 {{ cacheSize }}</text>
          </view>
          <text class="text-base text-[#ccc]">›</text>
        </view>
        <view class="px-4 py-3.5 flex items-center justify-between" @click="exportData">
          <view>
            <text class="text-sm text-[#2C2C2C] block">📤 导出我的数据</text>
            <text class="text-xs text-[#999] mt-0.5 block">下载您的所有个人数据</text>
          </view>
          <text class="text-base text-[#ccc]">›</text>
        </view>
      </view>

      <!-- 账号操作 -->
      <view class="bg-white rounded-xl overflow-hidden shadow-sm border border-[#E8E0D5] mb-4">
        <view class="px-4 py-3 bg-[#FAF8F5] border-b border-[#E8E0D5]">
          <text class="text-sm font-semibold text-[#2C2C2C]">⚙️ 账号操作</text>
        </view>
        <view class="px-4 py-3.5 border-b border-[#FAF8F5] flex items-center justify-between" @click="deactivateAccount">
          <view>
            <text class="text-sm text-[#C41E3A] block">注销账号</text>
            <text class="text-xs text-[#999] mt-0.5 block">注销后所有数据将被清空</text>
          </view>
          <text class="text-base text-[#ccc]">›</text>
        </view>
        <view class="px-4 py-3.5 flex items-center justify-between" @click="goFeedback">
          <view>
            <text class="text-sm text-[#2C2C2C] block">💬 意见反馈</text>
            <text class="text-xs text-[#999] mt-0.5 block">帮助我们改进产品</text>
          </view>
          <text class="text-base text-[#ccc]">›</text>
        </view>
      </view>

      <!-- 说明底部 -->
      <view class="px-4 pb-6">
        <text class="text-xs text-[#999] leading-relaxed block">
          您可以在任何时候修改隐私设置。关闭某些选项可能会影响您的使用体验。详细的隐私保护措施请查看隐私政策。
        </text>
        <view class="flex items-center justify-center gap-4 mt-3">
          <text class="text-xs text-[#C41E3A]" @click="goPrivacyPolicy">隐私政策</text>
          <text class="text-xs text-[#ccc]">|</text>
          <text class="text-xs text-[#C41E3A]" @click="goUserAgreement">用户协议</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, reactive, onMounted } from 'vue'

const loading = ref(true)
const cacheSize = ref('23.5MB')

interface SettingItem {
  key: string
  label: string
  desc: string
  value: boolean
}

const privacySettings = reactive<SettingItem[]>([
  { key: 'profile_public', label: '公开个人主页', desc: '允许他人查看您的个人主页和学习记录', value: true },
  { key: 'follow_list_visible', label: '展示关注与粉丝', desc: '允许他人在您的个人主页看到关注和粉丝列表', value: true },
  { key: 'favorite_visible', label: '展示收藏内容', desc: '允许他人查看您的公开收藏内容', value: false },
  { key: 'browse_history', label: '展示浏览记录', desc: '允许好友查看您的浏览历史', value: false },
  { key: 'search_visible', label: '允许被搜索', desc: '允许他人通过手机号或昵称搜索到您', value: true },
  { key: 'recommend_friends', label: '好友推荐', desc: '基于您的关系链推荐可能认识的人', value: false },
  { key: 'data_collection', label: '个性化推荐', desc: '根据您的使用习惯优化内容推荐', value: true },
  { key: 'activity_visible', label: '学习动态可见', desc: '好友可查看您的学习动态和收藏', value: false },
])

const notificationSettings = reactive<SettingItem[]>([
  { key: 'push_like', label: '点赞通知', desc: '当有人点赞您的动态时推送通知', value: true },
  { key: 'push_comment', label: '评论通知', desc: '当有人评论您的动态时推送通知', value: true },
  { key: 'push_follow', label: '关注通知', desc: '当有人关注您时推送通知', value: true },
  { key: 'push_message', label: '私信通知', desc: '当收到新私信时推送通知', value: true },
  { key: 'push_system', label: '系统通知', desc: '接收系统公告和活动通知', value: true },
  { key: 'allow_dm', label: '允许私信', desc: '允许任何人给您发送私信', value: true },
])

onMounted(() => {
  setTimeout(() => { loading.value = false }, 1000)
})

function goBack() { uni.navigateBack() }

function toggleSetting(key: string) {
  const setting = privacySettings.find(s => s.key === key)
  if (setting) { setting.value = !setting.value }
}

function toggleNotification(key: string) {
  const setting = notificationSettings.find(s => s.key === key)
  if (setting) { setting.value = !setting.value }
}

function clearCache() {
  uni.showModal({
    title: '清除缓存',
    content: '确定要清除所有缓存数据吗？',
    success: (res) => {
      if (res.confirm) {
        cacheSize.value = '0KB'
        uni.showToast({ title: '缓存已清除', icon: 'success' })
      }
    },
  })
}

function exportData() {
  uni.showToast({ title: '数据导出(Mock)', icon: 'none' })
}

function deactivateAccount() {
  uni.showModal({
    title: '注销账号',
    content: '确定要注销账号吗？此操作不可撤销，所有数据将被永久删除。',
    confirmText: '确认注销',
    confirmColor: '#C41E3A',
    success: (res) => {
      if (res.confirm) {
        uni.showToast({ title: '注销申请已提交(Mock)', icon: 'none' })
      }
    },
  })
}

function goFeedback() {
  uni.navigateTo({ url: '/pages/mine/feedback/index' })
}

function goPrivacyPolicy() {
  uni.navigateTo({ url: '/pages/agreement/privacy/index' })
}

function goUserAgreement() {
  uni.navigateTo({ url: '/pages/agreement/user/index' })
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
