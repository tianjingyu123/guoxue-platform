<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- 导航栏 -->
    <view class="flex items-center justify-between px-4 h-12 bg-white border-b border-[#E8E0D5] shrink-0">
      <view class="p-1" @click="goBack">
        <text class="text-xl text-[#2C2C2C]">←</text>
      </view>
      <text class="text-base font-semibold text-[#2C2C2C]">通用工具</text>
      <view class="w-7 flex items-center justify-center" @click="onSearch">
        <text class="text-lg">🔍</text>
      </view>
    </view>

    <!-- 骨架屏 -->
    <view v-if="loading" class="flex-1 p-4">
      <view v-for="i in 3" :key="i" class="mb-6">
        <view class="h-4 w-20 bg-[#F0EBE5] rounded mb-3 skeleton-pulse" />
        <view class="grid grid-cols-2 gap-3">
          <view v-for="j in 4" :key="j" class="bg-white rounded-xl p-3.5 skeleton-pulse">
            <view class="flex items-center gap-3">
              <view class="w-9 h-9 rounded-full bg-[#F0EBE5] skeleton-pulse" />
              <view class="flex-1 space-y-1">
                <view class="h-3.5 w-16 bg-[#F0EBE5] rounded skeleton-pulse" />
                <view class="h-3 w-full bg-[#F0EBE5] rounded skeleton-pulse" />
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view v-else-if="filteredTools.length === 0" class="flex-1 flex flex-col items-center justify-center p-8">
      <text class="text-5xl mb-4">🔧</text>
      <text class="text-sm text-[#999] mb-2">未找到匹配工具</text>
      <text class="text-xs text-[#bbb]">试试其他关键词</text>
    </view>

    <!-- 主内容 -->
    <scroll-view v-else scroll-y class="flex-1 overflow-y-auto">
      <!-- 搜索框 -->
      <view class="sticky top-0 z-10 px-4 pt-3 pb-2 bg-[#FAF8F5]">
        <view class="flex items-center gap-2 bg-white rounded-xl px-3.5 h-10 border border-[#E8E0D5]">
          <text class="text-base text-[#999]">🔍</text>
          <input v-model="keyword" placeholder="搜索工具名称" placeholder-class="text-xs text-[#bbb]" class="flex-1 text-sm text-[#2C2C2C]" />
          <text v-if="keyword" class="text-base text-[#999] p-1" @click="keyword=''">✕</text>
        </view>
      </view>

      <!-- 工具使用提示 -->
      <view class="px-4 mb-2">
        <view class="bg-[#F5F1EB] rounded-xl p-3 flex items-center gap-2">
          <text class="text-sm text-[#C9A96E]">💡</text>
          <text class="text-xs text-[#666]">点击工具即可使用，标记「热门」的工具为高频使用工具</text>
        </view>
      </view>

      <view class="px-4 pb-6">
        <view v-for="group in toolGroups" :key="group.label" class="mb-5">
          <!-- 分类标题 -->
          <view class="flex items-center justify-between mb-2.5">
            <text class="text-sm font-semibold text-[#2C2C2C]">{{ group.label }}</text>
            <text class="text-xs text-[#999]">{{ group.tools.length }}个工具</text>
          </view>

          <!-- 工具网格 -->
          <view class="grid grid-cols-2 gap-3">
            <view v-for="t in group.tools" :key="t.name"
              class="bg-white rounded-xl p-3.5 shadow-sm active:opacity-80 relative"
              :class="t.hot ? 'border-l-2 border-[#C41E3A]' : ''"
              @click="onTool(t.name)">
              <view v-if="t.hot" class="absolute -top-1 -right-1 bg-[#C41E3A] text-white text-[9px] px-1.5 py-0.5 rounded-full">
                热门
              </view>
              <view class="flex items-center gap-3">
                <view class="w-9 h-9 rounded-full bg-[#F5F1EB] flex items-center justify-center text-xl shrink-0">
                  <text>{{ t.icon }}</text>
                </view>
                <view class="flex-1 min-w-0">
                  <text class="text-sm font-medium text-[#2C2C2C] block">{{ t.name }}</text>
                  <text class="text-[11px] text-[#999] block mt-0.5 truncate">{{ t.desc }}</text>
                </view>
                <text class="text-sm text-[#ccc]">›</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

const loading = ref(true)
const keyword = ref('')

interface Tool {
  name: string
  icon: string
  desc: string
  hot?: boolean
}

interface ToolGroup {
  label: string
  tools: Tool[]
}

const toolGroups = ref<ToolGroup[]>([
  {
    label: '📅 日历工具',
    tools: [
      { name: '万年历', icon: '📅', desc: '公历农历对照查询', hot: true },
      { name: '老黄历', icon: '📔', desc: '每日宜忌、吉时查询', hot: true },
      { name: '节气查询', icon: '🌾', desc: '二十四节气时间表' },
      { name: '星座运势', icon: '🌟', desc: '十二星座每日运势' },
      { name: '生肖运势', icon: '🐉', desc: '十二生肖每日运势', hot: true },
      { name: '纪念日', icon: '🎂', desc: '重要日期提醒设置' },
    ],
  },
  {
    label: '🔢 换算工具',
    tools: [
      { name: '时间换算', icon: '⏰', desc: '公历农历日期转换', hot: true },
      { name: '干支纪年', icon: '☯️', desc: '天干地支查询转换' },
      { name: '五行查询', icon: '🔥', desc: '五行属性快速查询' },
      { name: '纳音查询', icon: '🎵', desc: '六十甲子纳音五行' },
      { name: '生肖查询', icon: '🐭', desc: '年份生肖对照查询' },
      { name: '年龄计算', icon: '🎂', desc: '虚岁周岁精确计算' },
    ],
  },
  {
    label: '📖 查询工具',
    tools: [
      { name: '姓名测试', icon: '📝', desc: '姓名五格数理分析' },
      { name: '解梦查询', icon: '💤', desc: '周公解梦大全', hot: true },
      { name: '成语词典', icon: '📚', desc: '成语查询与释义' },
      { name: '诗词文库', icon: '📜', desc: '古诗词全文检索' },
      { name: '佛学词典', icon: '🙏', desc: '佛教术语解释' },
      { name: '道学辞典', icon: '☯️', desc: '道教用语查询' },
    ],
  },
  {
    label: '🧮 数理工具',
    tools: [
      { name: '八字排盘', icon: '📊', desc: '八字四柱排盘快速查询', hot: true },
      { name: '紫微排盘', icon: '⭐', desc: '紫微斗数命盘生成' },
      { name: '奇门排盘', icon: '🧭', desc: '奇门遁甲转盘/飞盘', hot: true },
      { name: '六爻起卦', icon: '🪙', desc: '六爻预测在线起卦' },
      { name: '梅花易数', icon: '🌺', desc: '梅花易数在线起卦' },
      { name: '号码吉凶', icon: '📱', desc: '手机号码吉凶测算' },
    ],
  },
])

const filteredTools = computed(() => {
  if (!keyword.value) return toolGroups.value.flatMap(g => g.tools)
  const kw = keyword.value.toLowerCase()
  return toolGroups.value.flatMap(g => g.tools).filter(t => t.name.includes(kw))
})

function onTool(name: string) {
  uni.showToast({ title: `${name} 即将开放`, icon: 'none' })
}

function onSearch() {
  /* 搜索由 keyword 驱动 */
}

function goBack() { uni.navigateBack() }

setTimeout(() => { loading.value = false }, 1000)
</script>

<style scoped>
.skeleton-pulse {
  animation: pulse 1.5s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.8; }
}
/* 样式由 Tailwind 处理 */
</style>
