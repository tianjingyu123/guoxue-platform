<template>
  <!-- Init Loading State (Suspense 对应) -->
  <view v-if="loading" class="fixed inset-0 bg-black flex items-center justify-center z-50">
    <view class="w-8 h-8 rounded-full" style="border: 2px solid rgba(255,255,255,0.3); border-top-color: #FFFFFF; animation: viewer-spin 1s linear infinite;" />
  </view>

  <!-- Main Viewer -->
  <view
    v-else
    class="fixed inset-0 bg-black select-none z-50"
    style="overflow: hidden;"
    @click="toggleControls"
  >
    <!-- 顶部栏 with gradient -->
    <view
      :class="['absolute top-0 left-0 right-0 z-10 flex items-center justify-between px-4 py-3', showControls ? 'opacity-100' : 'opacity-0']"
      style="background: linear-gradient(to bottom, rgba(0,0,0,0.6), transparent); transition: opacity 0.3s;"
      @click.stop
    >
      <view
        @click.stop="goBack"
        class="w-10 h-10 flex items-center justify-center rounded-full"
        style="background-color: rgba(0,0,0,0.3); cursor: pointer;"
        hover-class="viewer-btn-hover"
      >
        <text style="color: #FFFFFF; font-size: 18px; line-height: 1;">✕</text>
      </view>
      <text class="text-white text-sm font-medium">{{ currentIndex + 1 }} / {{ images.length }}</text>
      <view class="w-10" />
    </view>

    <!-- 图片区域 with touch handlers -->
    <view
      class="absolute inset-0 flex items-center justify-center overflow-hidden"
      @click.stop="onImageInteraction"
      @touchstart="onTouchStart"
      @touchmove="onTouchMove"
      @touchend="onTouchEnd"
    >
      <image
        :src="images[currentIndex]"
        mode="aspectFit"
        class="max-w-full max-h-full"
        :style="{
          transform: 'translate(' + position.x + 'px,' + position.y + 'px) scale(' + scale + ') rotate(' + rotation + 'deg)',
          transition: 'transform 0.2s',
        }"
      />
    </view>

    <!-- 左右切换箭头 -->
    <template v-if="images.length > 1 && showControls">
      <view
        @click.stop="goToPrev"
        :style="{
          position: 'absolute',
          left: '16px',
          top: '50%',
          transform: 'translateY(-50%)',
          zIndex: 10,
          opacity: currentIndex === 0 ? 0.3 : 1,
        }"
        class="w-10 h-10 flex items-center justify-center rounded-full"
        style="background-color: rgba(0,0,0,0.3); cursor: pointer; transition: opacity 0.3s;"
        hover-class="viewer-btn-hover"
      >
        <text style="color: #FFFFFF; font-size: 22px; line-height: 1;">❮</text>
      </view>
      <view
        @click.stop="goToNext"
        :style="{
          position: 'absolute',
          right: '16px',
          top: '50%',
          transform: 'translateY(-50%)',
          zIndex: 10,
          opacity: currentIndex === images.length - 1 ? 0.3 : 1,
        }"
        class="w-10 h-10 flex items-center justify-center rounded-full"
        style="background-color: rgba(0,0,0,0.3); cursor: pointer; transition: opacity 0.3s;"
        hover-class="viewer-btn-hover"
      >
        <text style="color: #FFFFFF; font-size: 22px; line-height: 1;">❯</text>
      </view>
    </template>

    <!-- 底部操作栏 with gradient -->
    <view
      :class="['absolute bottom-0 left-0 right-0 z-10', showControls ? 'opacity-100' : 'opacity-0']"
      style="background: linear-gradient(to top, rgba(0,0,0,0.6), transparent); transition: opacity 0.3s;"
      @click.stop
    >
      <!-- 圆点指示器 -->
      <view v-if="images.length > 1" class="flex items-center justify-center gap-1.5 py-3">
        <view
          v-for="(img, index) in images"
          :key="index"
          :class="['w-2 h-2 rounded-full transition-all', index === currentIndex ? 'bg-white w-4' : 'bg-white/50']"
          style="cursor: pointer;"
          @click="currentIndex = index"
        />
      </view>

      <!-- 操作按钮 (5个: 缩小/放大/旋转/保存/分享) -->
      <view class="flex items-center justify-center gap-6 pb-8 pt-2">
        <!-- 缩小 -->
        <view
          @click.stop="handleZoomOut"
          class="flex flex-col items-center gap-1"
          :style="{ opacity: scale <= 0.5 ? 0.5 : 1, color: 'rgba(255,255,255,0.8)', cursor: 'pointer' }"
        >
          <view class="w-10 h-10 flex items-center justify-center rounded-full" style="background-color: rgba(0,0,0,0.3);">
            <text style="color: #FFFFFF; font-size: 18px; font-weight: bold; line-height: 1;">−</text>
          </view>
          <text class="text-xs" style="color: rgba(255,255,255,0.8);">缩小</text>
        </view>

        <!-- 放大 -->
        <view
          @click.stop="handleZoomIn"
          class="flex flex-col items-center gap-1"
          :style="{ opacity: scale >= 5 ? 0.5 : 1, color: 'rgba(255,255,255,0.8)', cursor: 'pointer' }"
        >
          <view class="w-10 h-10 flex items-center justify-center rounded-full" style="background-color: rgba(0,0,0,0.3);">
            <text style="color: #FFFFFF; font-size: 18px; font-weight: bold; line-height: 1;">+</text>
          </view>
          <text class="text-xs" style="color: rgba(255,255,255,0.8);">放大</text>
        </view>

        <!-- 旋转 -->
        <view
          @click.stop="handleRotate"
          class="flex flex-col items-center gap-1"
          style="color: rgba(255,255,255,0.8); cursor: pointer;"
        >
          <view class="w-10 h-10 flex items-center justify-center rounded-full" style="background-color: rgba(0,0,0,0.3);">
            <text style="color: #FFFFFF; font-size: 16px; line-height: 1;">🔄</text>
          </view>
          <text class="text-xs" style="color: rgba(255,255,255,0.8);">旋转</text>
        </view>

        <!-- 保存 -->
        <view
          @click.stop="handleSave"
          class="flex flex-col items-center gap-1"
          style="color: rgba(255,255,255,0.8); cursor: pointer;"
        >
          <view class="w-10 h-10 flex items-center justify-center rounded-full" style="background-color: rgba(0,0,0,0.3);">
            <text style="color: #FFFFFF; font-size: 16px; line-height: 1;">⬇️</text>
          </view>
          <text class="text-xs" style="color: rgba(255,255,255,0.8);">保存</text>
        </view>

        <!-- 分享 (V0 对应 Share2) -->
        <view
          @click.stop="handleShare"
          class="flex flex-col items-center gap-1"
          style="color: rgba(255,255,255,0.8); cursor: pointer;"
        >
          <view class="w-10 h-10 flex items-center justify-center rounded-full" style="background-color: rgba(0,0,0,0.3);">
            <text style="color: #FFFFFF; font-size: 16px; line-height: 1;">🔗</text>
          </view>
          <text class="text-xs" style="color: rgba(255,255,255,0.8);">分享</text>
        </view>
      </view>
    </view>

    <!-- 缩放比例提示 -->
    <view
      v-if="scale !== 1"
      class="absolute pointer-events-none"
      style="top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 5;"
    >
      <view class="px-3 py-1.5 rounded-full text-sm font-medium" style="background-color: rgba(0,0,0,0.6); color: #FFFFFF;">
        <text>{{ Math.round(scale * 100) }}%</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'

// --- URL 安全校验 (防 SSRF) ---
function isValidImageUrl(url: string): boolean {
  try {
    const parsed = new URL(url)
    const hostname = parsed.hostname.toLowerCase().replace(/[.]$/, '')
    if (parsed.username || parsed.password) return false
    if (hostname === 'localhost' || hostname === '::1') return false
    if (/^127\.\d{1,3}\.\d{1,3}\.\d{1,3}$/.test(hostname)) return false
    if (hostname.startsWith('10.')) return false
    if (hostname.startsWith('192.168.')) return false
    if (/^172\.(1[6-9]|2[0-9]|3[01])\./.test(hostname)) return false
    if (hostname.startsWith('169.254.')) return false
    return /^https?:$/.test(parsed.protocol)
  } catch {
    return false
  }
}

// --- Mock images (V0 对应) ---
const defaultImages: string[] = [
  '/placeholder.svg?height=800&width=600&text=示例图片1',
  '/placeholder.svg?height=600&width=800&text=示例图片2',
  '/placeholder.svg?height=800&width=800&text=示例图片3',
]

// --- State ---
const loading = ref(true)
const images = ref<string[]>(defaultImages)
const currentIndex = ref(0)
const scale = ref(1)
const rotation = ref(0)
const position = ref({ x: 0, y: 0 })
const isDragging = ref(false)
const dragOffset = ref({ x: 0, y: 0 })
const showControls = ref(true)
const lastTapTime = ref(0)
const initialPinchDistance = ref(0)
let controlsTimer: ReturnType<typeof setTimeout> | null = null

// --- Lifecycle ---
onMounted(() => {
  // 从页面参数获取图片列表
  const pages = getCurrentPages()
  const currentPage = pages[pages.length - 1] as any
  const options = currentPage?.$page?.options || currentPage?.options || {}

  if (options.images) {
    const parsed = options.images
      .split(',')
      .map((s: string) => decodeURIComponent(s))
      .filter(isValidImageUrl)
    if (parsed.length > 0) {
      images.value = parsed
    }
  }

  if (options.index) {
    const idx = parseInt(options.index)
    if (!isNaN(idx) && idx >= 0 && idx < images.value.length) {
      currentIndex.value = idx
    }
  }

  loading.value = false
  startControlsTimer()
})

// --- Transform ---
function resetTransform() {
  scale.value = 1
  rotation.value = 0
  position.value = { x: 0, y: 0 }
}

// --- Controls visibility ---
function toggleControls() {
  showControls.value = !showControls.value
  if (showControls.value) startControlsTimer()
}

function startControlsTimer() {
  if (controlsTimer) clearTimeout(controlsTimer)
  controlsTimer = setTimeout(() => {
    showControls.value = false
  }, 3000)
}

// --- Navigation ---
function goToPrev() {
  if (currentIndex.value > 0) {
    currentIndex.value--
    resetTransform()
    showControls.value = true
    startControlsTimer()
  }
}

function goToNext() {
  if (currentIndex.value < images.value.length - 1) {
    currentIndex.value++
    resetTransform()
    showControls.value = true
    startControlsTimer()
  }
}

// --- Double-tap detection ---
function onImageInteraction() {
  const now = Date.now()
  if (now - lastTapTime.value < 300) {
    // Double tap: toggle zoom
    if (scale.value === 1) {
      scale.value = 2
    } else {
      resetTransform()
    }
    lastTapTime.value = 0
  } else {
    // Single tap: toggle controls
    toggleControls()
  }
  lastTapTime.value = now
}

// --- Touch handlers ---
function onTouchStart(e: any) {
  showControls.value = true
  startControlsTimer()

  if (e.touches.length === 1) {
    dragOffset.value = {
      x: e.touches[0].clientX - position.value.x,
      y: e.touches[0].clientY - position.value.y,
    }
    if (scale.value > 1) {
      isDragging.value = true
    }
  } else if (e.touches.length === 2) {
    const dx = e.touches[0].clientX - e.touches[1].clientX
    const dy = e.touches[0].clientY - e.touches[1].clientY
    initialPinchDistance.value = Math.sqrt(dx * dx + dy * dy)
  }
}

function onTouchMove(e: any) {
  if (e.touches.length === 1 && isDragging.value && scale.value > 1) {
    position.value = {
      x: e.touches[0].clientX - dragOffset.value.x,
      y: e.touches[0].clientY - dragOffset.value.y,
    }
  } else if (e.touches.length === 2 && initialPinchDistance.value > 0) {
    const dx = e.touches[0].clientX - e.touches[1].clientX
    const dy = e.touches[0].clientY - e.touches[1].clientY
    const dist = Math.sqrt(dx * dx + dy * dy)
    const delta = dist / initialPinchDistance.value
    scale.value = Math.min(Math.max(scale.value * delta, 0.5), 5)
    initialPinchDistance.value = dist
  }
}

function onTouchEnd(e: any) {
  isDragging.value = false
  // Swipe to switch image (only at scale 1)
  if (scale.value === 1 && e.changedTouches.length === 1) {
    const deltaX = e.changedTouches[0].clientX - (dragOffset.value.x + position.value.x)
    if (Math.abs(deltaX) > 80) {
      if (deltaX > 0) {
        goToPrev()
      } else {
        goToNext()
      }
    }
  }
}

// --- Toolbar actions ---
function handleZoomIn() {
  scale.value = Math.min(scale.value + 0.5, 5)
  showControls.value = true
  startControlsTimer()
}

function handleZoomOut() {
  scale.value = Math.max(scale.value - 0.5, 0.5)
  showControls.value = true
  startControlsTimer()
}

function handleRotate() {
  rotation.value = (rotation.value + 90) % 360
  showControls.value = true
  startControlsTimer()
}

function handleSave() {
  const url = images.value[currentIndex.value]
  if (!isValidImageUrl(url)) {
    uni.showToast({ title: '图片地址无效', icon: 'none' })
    return
  }
  uni.showLoading({ title: '保存中...' })
  uni.downloadFile({
    url,
    success: (res) => {
      if (res.statusCode === 200) {
        uni.saveImageToPhotosAlbum({
          filePath: res.tempFilePath,
          success: () => {
            uni.hideLoading()
            uni.showToast({ title: '已保存到相册', icon: 'success' })
          },
          fail: () => {
            uni.hideLoading()
            uni.showToast({ title: '保存失败', icon: 'none' })
          },
        })
      }
    },
    fail: () => {
      uni.hideLoading()
      uni.showToast({ title: '下载失败', icon: 'none' })
    },
  })
}

// V0 对应 Share2 功能
function handleShare() {
  const url = images.value[currentIndex.value]
  // uni-app 系统分享
  uni.shareWithSystem({
    summary: '分享图片',
    href: url,
    success: () => {
      uni.showToast({ title: '分享成功', icon: 'success' })
    },
    fail: () => {
      // 用户取消分享, 静默处理
    },
  })
}

function goBack() {
  uni.navigateBack()
}
</script>

<style scoped>
@keyframes viewer-spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
.viewer-btn-hover {
  background-color: rgba(0, 0, 0, 0.5) !important;
}
</style>
