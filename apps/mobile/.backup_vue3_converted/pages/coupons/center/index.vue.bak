<template>
  <view class="min-h-screen bg-[#FAF8F5] max-w-lg mx-auto">
    <!-- 顶部 -->
    <view class="sticky top-0 z-50 text-white" style="background:linear-gradient(to bottom right,#C41E3A,#C41E3A,#C9A96E)">
      <view class="flex items-center justify-between px-4 h-12">
        <view @click="goBack" class="p-2 -ml-2">
          <text class="text-lg text-white">&#8592;</text>
        </view>
        <text class="font-bold flex items-center gap-1">
          <text>&#127873;</text>
          <text>领券中心</text>
        </text>
        <text @click="goTo('/pages/coupons/index')" class="text-xs text-white/80">我的券</text>
      </view>

      <!-- 积分入口 -->
      <view class="px-4 pb-4">
        <view class="bg-white/10 border border-white/20 rounded-xl p-3">
          <view class="flex items-center justify-between">
            <view class="flex items-center gap-3">
              <view class="w-10 h-10 rounded-full bg-amber-500/20 flex items-center justify-center">
                <text class="text-amber-400 text-lg">&#128176;</text>
              </view>
              <view>
                <text class="text-white/70 text-xs">我的积分</text>
                <text class="text-xl font-bold text-white block">{{ userPoints }}</text>
              </view>
            </view>
            <view class="px-3 py-1.5 bg-white/20 text-white text-xs font-medium rounded-full">
              兑换礼品
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Tab切换 -->
    <view class="sticky top-[124px] z-40 bg-[#FAF8F5] border-b border-[#E8E0D5]">
      <view class="flex">
        <view v-for="tab in tabs" :key="tab.key" @click="activeTab = tab.key" :class="['flex-1 py-3 text-sm font-medium relative text-center transition-colors', activeTab === tab.key ? 'text-[#C41E3A]' : 'text-[#999]']">
          {{ tab.label }}
          <view v-if="activeTab === tab.key" class="absolute bottom-0 left-1/2 -translate-x-1/2 w-8 h-0.5 bg-[#C41E3A] rounded-full" />
        </view>
      </view>
    </view>

    <!-- 内容区 -->
    <view class="p-4 pb-32 space-y-4">
      <!-- 积分兑换区 -->
      <template v-if="activeTab === 'points'">
        <text class="text-sm text-[#999] mb-2 block">可用积分：{{ userPoints }}</text>
        <view class="space-y-3">
          <view v-for="coupon in pointsCoupons" :key="coupon.id" class="bg-white rounded-xl p-3 flex items-center gap-3">
            <!-- 券面值 -->
            <view class="w-16 h-16 rounded-lg flex flex-col items-center justify-center text-white" style="background:linear-gradient(to bottom right,#f59e0b,#f97316)">
              <template v-if="coupon.type === '折扣'">
                <text class="text-xl font-bold">{{ coupon.amount }}</text>
                <text class="text-[10px]">折</text>
              </template>
              <template v-else>
                <text class="text-[10px]">&#165;</text>
                <text class="text-xl font-bold">{{ coupon.amount }}</text>
              </template>
            </view>

            <!-- 信息 -->
            <view class="flex-1 min-w-0">
              <text class="font-medium text-sm line-clamp-1 block">{{ coupon.scope }}</text>
              <text class="text-xs text-[#999] block">{{ coupon.minAmount ? '满' + coupon.minAmount + '可用' : '无门槛' }}</text>
              <text class="text-xs text-amber-600 mt-1 flex items-center gap-1">
                <text>&#128176;</text>
                <text>{{ coupon.points }} 积分</text>
              </text>
            </view>

            <!-- 兑换/已兑换按钮 -->
            <view @click="handleReceive(coupon.id)" :class="['h-8 px-3 text-xs rounded-full flex items-center font-medium', canExchange(coupon) && !isReceived(coupon.id) ? 'bg-[#C41E3A] text-white' : 'bg-[#F5F1EB] text-[#999]']">
              <template v-if="isReceived(coupon.id)">
                <text>&#10003;</text>
                <text class="ml-1">已兑换</text>
              </template>
              <template v-else-if="canExchange(coupon)">
                <text>兑换</text>
              </template>
              <template v-else>
                <text>积分不足</text>
              </template>
            </view>
          </view>
        </view>

        <!-- 会员专属券 -->
        <view class="mt-6">
          <view class="flex items-center gap-2 mb-3">
            <text class="text-amber-500 text-lg">&#128081;</text>
            <text class="font-bold text-sm">会员专属券</text>
          </view>
          <view class="space-y-3">
            <view v-for="coupon in vipCoupons" :key="coupon.id" :class="['bg-white rounded-xl p-3 relative overflow-hidden', userVipLevel < coupon.vipLevel ? 'opacity-60' : '']">
              <view class="flex items-center gap-3">
                <view class="w-16 h-16 rounded-lg flex flex-col items-center justify-center text-white" style="background:linear-gradient(to bottom right,#a855f7,#ec4899)">
                  <text class="text-[10px]">&#165;</text>
                  <text class="text-xl font-bold">{{ coupon.amount }}</text>
                </view>
                <view class="flex-1 min-w-0">
                  <text class="font-medium text-sm line-clamp-1 block">{{ coupon.scope }}</text>
                  <text class="text-xs text-[#999] block">{{ coupon.minAmount ? '满' + coupon.minAmount + '可用' : '无门槛' }}</text>
                  <text class="text-[10px] px-1.5 py-0.5 rounded mt-1 inline-block text-white" style="background:linear-gradient(to right,#f59e0b,#f97316)">VIP{{ coupon.vipLevel }}专享</text>
                </view>
                <view @click="handleReceive(coupon.id)" :class="['h-8 px-3 text-xs rounded-full flex items-center font-medium', canVipGet(coupon) && !isReceived(coupon.id) ? 'bg-[#C41E3A] text-white' : 'bg-[#F5F1EB] text-[#999]']">
                  {{ isReceived(coupon.id) ? '已领取' : canVipGet(coupon) ? '领取' : '需VIP' + coupon.vipLevel }}
                </view>
              </view>
            </view>
          </view>
        </view>
      </template>

      <!-- 普通优惠券列表 -->
      <template v-else>
        <view class="space-y-3">
          <view v-for="coupon in filteredCoupons" :key="coupon.id" class="relative overflow-hidden rounded-xl h-24">
            <!-- 背景渐变 -->
            <view class="absolute inset-0" style="background:linear-gradient(to right,#C41E3A,#C41E3A,#C41E3A/0.9)" />

            <!-- 锯齿装饰 -->
            <view class="absolute right-[30%] top-0 bottom-0 flex flex-col justify-around py-2">
              <view v-for="i in 6" :key="i" class="w-3 h-3 rounded-full bg-[#FAF8F5] -mr-1.5" />
            </view>

            <view class="relative h-full flex">
              <!-- 左侧金额区 (30%) -->
              <view class="w-[30%] flex flex-col items-center justify-center text-white">
                <template v-if="coupon.type === '折扣'">
                  <view class="text-center">
                    <text class="text-3xl font-bold">{{ coupon.amount }}</text>
                    <text class="text-lg font-bold">折</text>
                  </view>
                </template>
                <template v-else>
                  <view class="text-center">
                    <text class="text-lg">&#165;</text>
                    <text class="text-3xl font-bold">{{ coupon.amount }}</text>
                  </view>
                </template>
                <text class="text-xs text-white/80 mt-0.5">{{ coupon.minAmount ? '满' + coupon.minAmount + '可用' : '无门槛' }}</text>
              </view>

              <!-- 右侧信息区 -->
              <view class="flex-1 flex items-center justify-between px-4 bg-white rounded-r-xl">
                <view>
                  <view class="flex items-center gap-1.5 mb-1">
                    <text class="text-[10px] px-1.5 py-0.5 rounded border text-[#C41E3A]" style="border-color:rgba(196,30,58,0.3)">{{ coupon.type }}券</text>
                    <text v-if="coupon.tag" :class="['text-[10px] px-1.5 py-0.5 rounded text-white', coupon.tag === '热门' ? 'bg-red-500' : coupon.tag === '限时' ? 'bg-orange-500' : coupon.tag === '新人' ? 'bg-green-500' : 'bg-[#C41E3A]']">{{ coupon.tag }}</text>
                  </view>
                  <text class="font-medium text-sm text-[#2C2C2C] block mb-0.5">{{ coupon.scope }}</text>
                  <text class="text-[10px] text-[#999] flex items-center gap-1">
                    <text>&#9200;</text>
                    <text>{{ coupon.startDate }} - {{ coupon.endDate }}</text>
                  </text>
                </view>

                <!-- 操作按钮 -->
                <template v-if="isReceived(coupon.id)">
                  <view @click="handleReceive(coupon.id)" class="h-8 px-4 text-xs rounded-full flex items-center font-medium border text-[#C41E3A]" style="border-color:rgba(196,30,58,0.3)">
                    <text>去使用</text>
                  </view>
                </template>
                <template v-else>
                  <view @click="handleReceive(coupon.id)" class="h-8 px-4 text-xs rounded-full flex items-center font-medium bg-[#C41E3A] text-white">
                    <text>领取</text>
                  </view>
                </template>
              </view>
            </view>

            <!-- 已领取绿色勾标记 -->
            <view v-if="isReceived(coupon.id)" class="absolute top-2 right-2">
              <view class="w-6 h-6 rounded-full bg-green-500 flex items-center justify-center">
                <text class="text-white text-sm">&#10003;</text>
              </view>
            </view>
          </view>
        </view>
      </template>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

function goBack() { uni.navigateBack() }
function goTo(url: string) { uni.navigateTo({ url }) }

interface Coupon {
  id: number
  amount: number
  type: string
  minAmount?: number
  scope: string
  startDate?: string
  endDate?: string
  tag?: string
}

interface PointsCoupon {
  id: number
  amount: number
  type: string
  minAmount?: number
  scope: string
  points: number
}

interface VipCoupon {
  id: number
  amount: number
  type: string
  minAmount?: number
  scope: string
  vipLevel: number
}

const availableCoupons: Coupon[] = [
  { id: 1, amount: 50, type: '满减', minAmount: 299, scope: '全部课程', startDate: '2026.05.10', endDate: '2026.06.30', tag: '热门' },
  { id: 2, amount: 20, type: '满减', minAmount: 99, scope: '全部商品', startDate: '2026.05.10', endDate: '2026.05.31', tag: '限时' },
  { id: 3, amount: 8, type: '折扣', scope: '指定课程', startDate: '2026.05.10', endDate: '2026.06.15', tag: '' },
  { id: 4, amount: 10, type: '无门槛', scope: '全部商品', startDate: '2026.05.10', endDate: '2026.05.20', tag: '新人' },
  { id: 5, amount: 100, type: '满减', minAmount: 599, scope: '精品课程', startDate: '2026.05.10', endDate: '2026.07.31', tag: '' },
]

const pointsCoupons: PointsCoupon[] = [
  { id: 101, amount: 5, type: '无门槛', scope: '全部商品', points: 500 },
  { id: 102, amount: 15, type: '满减', minAmount: 99, scope: '全部商品', points: 1000 },
  { id: 103, amount: 30, type: '满减', minAmount: 199, scope: '全部课程', points: 2000 },
]

const vipCoupons: VipCoupon[] = [
  { id: 201, amount: 88, type: '满减', minAmount: 388, scope: '全场通用', vipLevel: 2 },
  { id: 202, amount: 9, type: '折扣', scope: '精品课程', vipLevel: 3 },
]

const tabs = [
  { key: 'all' as const, label: '全部' },
  { key: 'course' as const, label: '课程券' },
  { key: 'product' as const, label: '商品券' },
  { key: 'points' as const, label: '积分兑' },
]

type TabKey = 'all' | 'course' | 'product' | 'points'

const receivedIds = ref<number[]>([])
const activeTab = ref<TabKey>('all')
const userPoints = 1580
const userVipLevel = 1

const handleReceive = (id: number) => {
  if (!receivedIds.value.includes(id)) {
    receivedIds.value.push(id)
  }
}

const isReceived = (id: number) => receivedIds.value.includes(id)
const canExchange = (coupon: PointsCoupon) => userPoints >= coupon.points
const canVipGet = (coupon: VipCoupon) => userVipLevel >= coupon.vipLevel

const filteredCoupons = computed(() => {
  return availableCoupons.filter(coupon => {
    if (activeTab.value === 'all') return true
    if (activeTab.value === 'course') return coupon.scope.includes('课程')
    if (activeTab.value === 'product') return coupon.scope.includes('商品')
    return true
  })
})
</script>

<style scoped>
</style>
