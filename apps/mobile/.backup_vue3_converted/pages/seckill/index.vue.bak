<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- Header + Countdown -->
    <header class="sticky top-0 z-50" style="background:linear-gradient(90deg,#ef4444,#f97316)">
      <view class="flex items-center justify-between px-4 h-12">
        <view @click="goBack" class="p-2 -ml-2">
          <text class="text-white text-lg">←</text>
        </view>
        <text class="font-bold text-white flex items-center gap-1">
          <text class="text-lg">⚡</text>
          限时秒杀
        </text>
        <view class="w-9" />
      </view>

      <!-- Countdown -->
      <view class="px-4 pb-4">
        <view class="flex items-center justify-center gap-2">
          <text class="text-white/80 text-sm">{{ currentSession?.status === 'ongoing' ? '距本场结束' : '距下场开始' }}</text>
          <view class="flex items-center gap-1">
            <text class="px-2.5 py-1.5 text-white text-lg font-bold rounded-lg" style="background:rgba(255,255,255,0.2)">{{ padZero(hours) }}</text>
            <text class="text-white text-lg font-bold">:</text>
            <text class="px-2.5 py-1.5 text-white text-lg font-bold rounded-lg" style="background:rgba(255,255,255,0.2)">{{ padZero(minutes) }}</text>
            <text class="text-white text-lg font-bold">:</text>
            <text class="px-2.5 py-1.5 text-white text-lg font-bold rounded-lg" style="background:rgba(255,255,255,0.2)">{{ padZero(seconds) }}</text>
          </view>
        </view>
      </view>
    </header>

    <!-- Session Tabs -->
    <view class="sticky z-40 bg-white border-b border-[#E8E0D5]" style="top:108px">
      <view class="flex overflow-x-auto" style="scrollbar-width:none">
        <view v-for="session in seckillSessions" :key="session.id"
          @click="activeSession = session.id"
          class="flex-shrink-0 flex flex-col items-center py-3 px-6 transition-colors relative"
          :class="activeSession === session.id ? 'text-[#C41E3A]' : 'text-[#999]'"
        >
          <text class="text-lg font-bold block">{{ session.time }}</text>
          <text class="text-[10px] px-1.5 py-0 mt-1 rounded border-0 inline-block"
            :class="session.status === 'ongoing' ? 'bg-red-500 text-white animate-pulse' :
                    session.status === 'upcoming' ? 'bg-[#C41E3A]/10 text-[#C41E3A]' :
                    'bg-[#F0EDE8] text-[#999]'"
          >{{ session.label }}</text>
          <view v-if="activeSession === session.id"
            class="absolute bottom-0 w-12 h-0.5 rounded-full bg-[#C41E3A]" style="left:50%;transform:translateX(-50%)"
          />
        </view>
      </view>
    </view>

    <!-- Product List -->
    <view class="p-4 pb-24 space-y-3">
      <view v-for="product in seckillProducts" :key="product.id" class="bg-white rounded-xl overflow-hidden">
        <view class="flex p-3 gap-3">
          <!-- Product Image -->
          <view @click="navigateTo('/pages/mall/product/' + product.id + '/index')" class="w-28 h-28 rounded-lg flex-shrink-0 relative overflow-hidden" style="background:#F0EDE8">
            <image v-if="product.image" :src="product.image" mode="aspectFill" class="w-full h-full" />
            <view v-else class="w-full h-full flex items-center justify-center">
              <text style="color:rgba(153,153,153,0.2)" class="text-3xl">🛒</text>
            </view>
            <!-- Discount Badge -->
            <view class="absolute top-0 left-0 bg-red-500 text-white text-[10px] font-bold px-2 py-0.5">
              {{ Math.round((1 - product.seckillPrice / product.originalPrice) * 100) }}% OFF
            </view>
          </view>

          <!-- Product Info -->
          <view class="flex-1 flex flex-col justify-between py-0.5">
            <view>
              <view @click="navigateTo('/pages/mall/product/' + product.id + '/index')">
                <text class="font-medium text-sm text-[#2C2C2C]" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:4rpx">{{ product.name }}</text>
              </view>
              <view class="flex items-baseline gap-2">
                <text class="text-xl text-red-500 font-bold">¥{{ product.seckillPrice }}</text>
                <text class="text-xs text-[#999]" style="text-decoration:line-through">¥{{ product.originalPrice }}</text>
              </view>
            </view>

            <!-- Progress + Action -->
            <view class="flex items-end justify-between gap-3">
              <!-- Stock Progress -->
              <view class="flex-1">
                <view class="flex items-center justify-between text-[10px] text-[#999] mb-1">
                  <text>已抢{{ product.soldPercent }}%</text>
                  <text>剩余{{ product.stock }}件</text>
                </view>
                <view class="h-1.5 rounded-full overflow-hidden" style="background:#fecaca">
                  <view class="h-full rounded-full transition-all" :style="{ width: product.soldPercent + '%', background: 'linear-gradient(90deg,#ef4444,#f97316)' }" />
                </view>
              </view>

              <!-- Action Button -->
              <view v-if="isOngoing" @click="handleBuy(product)"
                class="h-8 px-4 rounded-lg text-xs font-bold flex items-center"
                :class="product.soldPercent >= 100 ? 'bg-[#F0EDE8] text-[#999]' : 'text-white'"
                :style="product.soldPercent < 100 ? 'background:linear-gradient(90deg,#ef4444,#f97316)' : ''"
              >
                <text>{{ product.soldPercent >= 100 ? '已抢光' : '立即抢' }}</text>
              </view>
              <view v-else @click="handleRemind(product.id)"
                class="h-8 px-3 rounded-lg text-xs flex items-center gap-1"
                :class="remindedIds.includes(product.id) ? 'border border-[#C41E3A] text-[#C41E3A]' : 'bg-[#C41E3A] text-white'"
              >
                <text class="text-xs">{{ remindedIds.includes(product.id) ? '🔔 已提醒' : '🔔 提醒我' }}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Bottom Rules Bar -->
    <view class="fixed bottom-0 left-0 right-0 bg-white border-t border-[#E8E0D5]" style="padding-bottom:34px">
      <view class="px-4 py-2 flex items-center justify-between text-xs text-[#999]">
        <text>每人每件商品限购1件</text>
        <view @click="navigateTo('/pages/seckill/rules/index')" class="flex items-center text-[#C41E3A]">
          <text>活动规则 ›</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted, onBeforeUnmount } from 'vue'

const seckillSessions = [
  { id: 1, time: '10:00', status: 'ended', label: '已结束' },
  { id: 2, time: '14:00', status: 'ongoing', label: '抢购中' },
  { id: 3, time: '20:00', status: 'upcoming', label: '即将开始' },
  { id: 4, time: '22:00', status: 'upcoming', label: '即将开始' },
]

const seckillProducts = [
  { id: 1, name: '开光貔貅摆件·招财进宝', seckillPrice: 99, originalPrice: 299, soldPercent: 85, stock: 15, image: '' },
  { id: 2, name: '八字命理精讲课程', seckillPrice: 49, originalPrice: 199, soldPercent: 72, stock: 28, image: '' },
  { id: 3, name: '紫水晶七星阵', seckillPrice: 168, originalPrice: 399, soldPercent: 45, stock: 55, image: '' },
  { id: 4, name: '风水罗盘专业版', seckillPrice: 188, originalPrice: 468, soldPercent: 38, stock: 62, image: '' },
  { id: 5, name: '六爻预测入门课', seckillPrice: 29, originalPrice: 99, soldPercent: 92, stock: 8, image: '' },
  { id: 6, name: '转运葫芦挂件套装', seckillPrice: 58, originalPrice: 128, soldPercent: 65, stock: 35, image: '' },
]

const activeSession = ref(2)
const remindedIds = ref<number[]>([])

// Countdown
const hours = ref(0)
const minutes = ref(0)
const seconds = ref(0)
let timer: any = null

const endTime = new Date(Date.now() + 2 * 60 * 60 * 1000)

onMounted(() => {
  updateCountdown()
  timer = setInterval(updateCountdown, 1000)
})

onBeforeUnmount(() => {
  if (timer) clearInterval(timer)
})

function updateCountdown() {
  const diff = endTime.getTime() - Date.now()
  if (diff <= 0) {
    hours.value = 0
    minutes.value = 0
    seconds.value = 0
    return
  }
  hours.value = Math.floor(diff / 3600000)
  minutes.value = Math.floor((diff % 3600000) / 60000)
  seconds.value = Math.floor((diff % 60000) / 1000)
}

function padZero(n: number): string {
  return String(n).padStart(2, '0')
}

const currentSession = computed(() => seckillSessions.find(s => s.id === activeSession.value))
const isOngoing = computed(() => currentSession.value?.status === 'ongoing')

function handleRemind(productId: number) {
  const idx = remindedIds.value.indexOf(productId)
  if (idx > -1) {
    remindedIds.value.splice(idx, 1)
  } else {
    remindedIds.value.push(productId)
  }
}

function handleBuy(product: any) {
  if (product.soldPercent >= 100) return
  uni.showToast({ title: '抢购成功！', icon: 'success' })
}

function navigateTo(url: string) {
  uni.navigateTo({ url })
}

function goBack() { uni.navigateBack() }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
