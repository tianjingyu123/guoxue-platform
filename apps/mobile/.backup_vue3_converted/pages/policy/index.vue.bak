<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- 导航栏 -->
    <view class="flex items-center justify-between px-4 h-12 bg-white border-b border-[#E8E0D5] shrink-0">
      <view class="p-1" @click="goBack">
        <text class="text-xl text-[#2C2C2C]">←</text>
      </view>
      <text class="text-base font-semibold text-[#2C2C2C]">政策中心</text>
      <view class="w-7" />
    </view>

    <!-- 骨架屏 -->
    <view v-if="loading" class="flex-1 p-4">
      <view v-for="i in 4" :key="i" class="mb-4">
        <view class="h-5 w-24 bg-[#F0EBE5] rounded mb-3 skeleton-pulse" />
        <view v-for="j in 2" :key="j" class="bg-white rounded-xl p-3.5 mb-2 skeleton-pulse">
          <view class="flex items-center gap-3">
            <view class="w-9 h-9 rounded-full bg-[#F0EBE5] skeleton-pulse" />
            <view class="flex-1 space-y-1.5">
              <view class="h-4 w-28 bg-[#F0EBE5] rounded skeleton-pulse" />
              <view class="h-3 w-full bg-[#F0EBE5] rounded skeleton-pulse" />
              <view class="h-3 w-20 bg-[#F0EBE5] rounded skeleton-pulse" />
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view v-else-if="groups.length === 0" class="flex-1 flex flex-col items-center justify-center p-8">
      <text class="text-5xl mb-4">📋</text>
      <text class="text-sm text-[#999] mb-2">暂无政策文档</text>
      <text class="text-xs text-[#bbb]">相关政策正在制定中</text>
    </view>

    <!-- 主内容 -->
    <scroll-view v-else scroll-y class="flex-1 overflow-y-auto">
      <view class="p-4 pb-6">
        <!-- 搜索框 -->
        <view class="flex items-center gap-2 bg-white rounded-xl px-3.5 h-10 border border-[#E8E0D5] mb-4">
          <text class="text-base text-[#999]">🔍</text>
          <input v-model="keyword" placeholder="搜索政策名称" placeholder-class="text-xs text-[#bbb]" class="flex-1 text-sm text-[#2C2C2C]" />
        </view>

        <!-- 政策统计头部 -->
        <view class="flex items-center justify-between bg-white rounded-xl p-3.5 mb-4 shadow-sm">
          <view class="flex items-center gap-2">
            <text class="text-xl">📋</text>
            <text class="text-sm text-[#2C2C2C]">共 {{ totalPolicyCount }} 项政策文档</text>
          </view>
          <text class="text-xs text-[#C9A96E]" @click="onFeedback">意见反馈 ›</text>
        </view>
        <!-- 政策分类分组 -->
        <view v-for="group in groups" :key="group.label" class="mb-5">
          <view class="flex items-center gap-2 mb-2.5">
            <text class="text-sm font-semibold text-[#2C2C2C]">{{ group.icon }} {{ group.label }}</text>
            <text class="text-xs text-[#999]">{{ group.items.length }}项</text>
          </view>

          <view v-for="item in group.items" :key="item.title" class="bg-white rounded-xl p-3.5 mb-2 shadow-sm active:opacity-80" @click="goDetail(item.title)">
            <view class="flex items-start gap-3">
              <view class="w-9 h-9 rounded-full bg-[#F5F1EB] flex items-center justify-center text-lg shrink-0">
                <text>{{ item.icon }}</text>
              </view>
              <view class="flex-1 min-w-0">
                <view class="flex items-center gap-1.5">
                  <text class="text-sm font-medium text-[#2C2C2C]">{{ item.title }}</text>
                  <text v-if="item.isNew" class="text-[10px] bg-[#C41E3A] text-white px-1.5 py-0.5 rounded-full">NEW</text>
                </view>
                <text class="text-[12px] text-[#666] block mt-0.5 leading-relaxed">{{ item.desc }}</text>
                <view class="flex items-center gap-2 mt-1.5">
                  <text class="text-[11px] text-[#999]">📅 更新于 {{ item.updateTime }}</text>
                  <text v-if="item.version" class="text-[11px] text-[#999]">v{{ item.version }}</text>
                </view>
              </view>
              <text class="text-base text-[#ccc] self-center">›</text>
            </view>
          </view>
        </view>

        <!-- 反馈入口 -->
        <view class="mt-2 bg-white rounded-xl p-4 shadow-sm">
          <view class="flex items-center gap-3">
            <text class="text-2xl">💬</text>
            <view class="flex-1">
              <text class="text-sm font-medium text-[#2C2C2C] block">有疑问？反馈给我们</text>
              <text class="text-xs text-[#999]">如对政策内容有疑问，欢迎反馈</text>
            </view>
            <text class="text-sm text-[#C9A96E] font-medium" @click="onFeedback">反馈 ›</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
