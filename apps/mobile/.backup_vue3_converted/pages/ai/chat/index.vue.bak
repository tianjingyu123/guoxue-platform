<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-40 flex items-center gap-3 px-4 h-14 bg-white border-b border-[#E8E0D5]">
      <text class="text-lg text-[#2C2C2C]" @click="goBack">←</text>
      <text class="text-base font-semibold text-[#2C2C2C] flex-1 truncate">{{ agentName }}</text>
      <view class="flex items-center gap-2">
        <text v-if="!ttsSupported" class="text-xs text-[#999]">语音通话</text>
        <view
          v-else
          class="px-3 py-1 rounded-full text-xs transition-all duration-300"
          :class="voiceMode ? 'bg-[#E8F5E9] text-[#2E7D32] animate-pulse' : 'bg-[#F0F0F0]'"
          @click="toggleVoiceMode"
        >
          <text>{{ voiceMode ? '📞 通话中' : '📞' }}</text>
        </view>
      </view>
    </view>

    <!-- 风险提示 -->
    <view class="bg-[#FFF8E1] py-2.5 px-4 text-center">
      <text class="text-xs text-[#8D6E00]">⚠️ 内容由AI生成，仅供传统文化学习参考 ｜ 语音通话已就绪</text>
    </view>

    <!-- 消息列表 -->
    <scroll-view scroll-y class="flex-1 px-4 py-3 flex flex-col gap-5" :scroll-top="scrollTop" scroll-with-animation>
      <view v-for="(msg, i) in messages" :key="i" class="flex gap-3 items-start max-w-[90%]" :class="msg.role === 'user' ? 'self-end flex-row-reverse' : ''">
        <view v-if="msg.role === 'assistant'" class="w-14 h-14 rounded-full bg-[#EBE5FA] flex items-center justify-center text-2xl flex-shrink-0">
          <text>🤖</text>
        </view>
        <view class="rounded-2xl px-4 py-3 shadow-sm relative" :class="msg.role === 'user' ? 'bg-[#2C2C2C]' : 'bg-white'">
          <text class="text-sm leading-relaxed whitespace-pre-wrap break-all" :class="msg.role === 'user' ? 'text-white' : 'text-[#333]'">{{ msg.content }}</text>
          <!-- TTS 播放按钮 -->
          <view v-if="msg.role === 'assistant' && msg.content && ttsSupported" class="absolute bottom-1 right-2 px-2 py-1 bg-black/5 rounded-lg" @click="playTts(msg)">
            <text class="text-xs" :class="msg._playing ? 'text-[#2E7D32]' : ''">{{ msg._playing ? '⏸' : '🔊' }}</text>
          </view>
        </view>
        <view v-if="msg.role === 'user'" class="w-14 h-14 rounded-full bg-[#E3F2FD] flex items-center justify-center text-2xl flex-shrink-0">
          <text>👤</text>
        </view>
      </view>

      <!-- 流式输出 -->
      <view v-if="streaming" class="flex gap-3 items-start max-w-[90%]">
        <view class="w-14 h-14 rounded-full bg-[#EBE5FA] flex items-center justify-center text-2xl flex-shrink-0">
          <text>🤖</text>
        </view>
        <view class="rounded-2xl px-4 py-3 border border-dashed border-[#CCC] bg-white">
          <text class="text-sm leading-relaxed whitespace-pre-wrap break-all text-[#333]">
            {{ streamText }}<text class="animate-pulse text-[#8B5CF6]">|</text>
          </text>
        </view>
      </view>
    </scroll-view>

    <!-- 录音状态条 -->
    <view v-if="recording" class="flex items-center gap-4 px-4 py-3 bg-[#FFEBEE] border-t border-[#FFCDD2]">
      <view class="flex gap-1 items-end h-10">
        <view v-for="i in 5" :key="i" class="w-1.5 bg-[#E53935] rounded-sm animate-bounce" :style="{ height: (10 + i * 6) + 'px', animationDelay: (i * 0.1) + 's', animationDuration: '0.6s' }" />
      </view>
      <text class="flex-1 text-sm text-[#C62828]">正在聆听... ({{ recordSeconds }}秒)</text>
      <view class="px-4 py-2 bg-[#E53935] rounded-full" @click="stopRecord">
        <text class="text-white text-sm">⏹ 停止</text>
      </view>
    </view>

    <!-- 输入区 -->
    <view class="flex gap-3 px-4 py-4 bg-white border-t border-[#E8E0D5] items-center" style="padding-bottom: calc(16px + env(safe-area-inset-bottom))">
      <!-- 语音按钮 -->
      <view
        class="w-[72rpx] h-11 rounded-full flex items-center justify-center text-2xl flex-shrink-0 transition-colors duration-200"
        :class="recording ? 'bg-[#FFEBEE]' : ttsSupported ? 'bg-[#F0F0F0]' : 'bg-[#F0F0F0] opacity-40'"
        @click="startVoiceOrWarn"
      >
        <text>{{ recording ? '🎙️' : '🎤' }}</text>
      </view>
      <input
        v-model="input"
        class="flex-1 h-11 px-4 rounded-full bg-[#F5F5F5] text-sm"
        placeholder="打字或点🎤语音..."
        confirm-type="send"
        @confirm="send"
        :disabled="streaming"
      />
      <view
        class="w-[100rpx] h-11 rounded-full flex items-center justify-center flex-shrink-0 transition-colors duration-200"
        :class="!input.trim() || streaming ? 'bg-[#CCC]' : 'bg-[#8B5CF6]'"
        @click="send"
      >
        <text class="text-white text-sm">发送</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted, onUnmounted, nextTick } from 'vue'

const API_HOST = 'http://localhost:3000/api/v1'
const agentId = ref('')
const agentName = ref('智能体')
const input = ref('')
const messages = ref<Array<{ role: string; content: string; _playing?: boolean }>>([])
const streaming = ref(false)
const streamText = ref('')
const scrollTop = ref(0)

// 语音相关
const asrSupported = ref(false)
const ttsSupported = ref(false)
const recording = ref(false)
const recordSeconds = ref(0)
const voiceMode = ref(false)
let recorder: any = null
let recordTimer: any = null
let audioCtx: any = null

onMounted(() => {
  const pages = getCurrentPages()
  const page = pages[pages.length - 1] as any
  agentId.value = page.$page?.options?.agentId || page.options?.agentId || ''
  agentName.value = decodeURIComponent(page.$page?.options?.agentName || page.options?.agentName || '智能体')

  // 检测语音支持
  checkSpeechSupport()
})

onUnmounted(() => {
  stopTts()
  if (recordTimer) clearInterval(recordTimer)
  if (audioCtx) { audioCtx.destroy(); audioCtx = null }
})

function checkSpeechSupport() {
  // #ifdef APP-PLUS || MP-WEIXIN
  asrSupported.value = true
  ttsSupported.value = true
  // #endif
  // #ifdef H5
  asrSupported.value = !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia)
  ttsSupported.value = true
  // #endif
}

function goBack() { uni.navigateBack() }

function scrollToBottom() {
  nextTick(() => { scrollTop.value = 999999 })
}

// ===================== 语音输入 (ASR) =====================

function startVoiceOrWarn() {
  if (recording.value) return
  if (!asrSupported.value) {
    uni.showToast({ title: '当前环境不支持录音，请打字输入', icon: 'none' })
    return
  }
  startRecord()
}

function startRecord() {
  // #ifdef MP-WEIXIN
  recorder = uni.getRecorderManager()
  recorder.onStop((res: any) => handleRecordStop(res))
  recorder.start({ format: 'mp3', duration: 60000 })
  // #endif
  // #ifdef APP-PLUS
  recorder = uni.getRecorderManager()
  recorder.onStop((res: any) => handleRecordStop(res))
  recorder.start({ format: 'mp3', duration: 60000 })
  // #endif
  // #ifdef H5
  startH5Record()
  // #endif
  recording.value = true
  recordSeconds.value = 0
  recordTimer = setInterval(() => { recordSeconds.value++ }, 1000)
}

function stopRecord() {
  if (!recording.value) return
  // #ifdef MP-WEIXIN || APP-PLUS
  recorder.stop()
  // #endif
  // #ifdef H5
  stopH5Record()
  // #endif
  recording.value = false
  if (recordTimer) { clearInterval(recordTimer); recordTimer = null }
}

// H5 录音
let h5MediaRecorder: any = null
let h5Chunks: BlobPart[] = []

async function startH5Record() {
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true })
    h5MediaRecorder = new MediaRecorder(stream, { mimeType: 'audio/webm' })
    h5Chunks = []
    h5MediaRecorder.ondataavailable = (e: any) => { if (e.data.size > 0) h5Chunks.push(e.data) }
    h5MediaRecorder.onstop = async () => {
      const blob = new Blob(h5Chunks, { type: 'audio/webm' })
      await transcribeAudio(blob)
      stream.getTracks().forEach((t: any) => t.stop())
    }
    h5MediaRecorder.start()
  } catch (e) {
    recording.value = false
    uni.showToast({ title: '麦克风权限未授权', icon: 'none' })
  }
}

function stopH5Record() {
  if (h5MediaRecorder && h5MediaRecorder.state !== 'inactive') {
    h5MediaRecorder.stop()
  }
}

async function handleRecordStop(res: any) {
  const filePath = res.tempFilePath
  if (!filePath) return
  // #ifdef MP-WEIXIN || APP-PLUS
  const fs = uni.getFileSystemManager()
  const data = fs.readFileSync(filePath)
  const blob = new Blob([data], { type: 'audio/mp3' })
  await transcribeAudio(blob)
  // #endif
}

async function transcribeAudio(blob: Blob) {
  try {
    uni.showLoading({ title: '识别中...' })
    const base64 = await blobToBase64(blob)
    const token = uni.getStorageSync('token') || ''
    const resp = await uni.request({
      url: API_HOST + '/ai/asr/sentence',
      method: 'POST',
      data: { audio: base64, format: 'mp3' },
      header: { 'Authorization': 'Bearer ' + token },
    })
    uni.hideLoading()
    if (resp.statusCode === 201 && resp.data) {
      const text = (resp.data as any).text || (resp.data as any).result || ''
      if (text) {
        input.value = text
        if (voiceMode.value) {
          await send()
          if (voiceMode.value) {
            setTimeout(() => {
              if (voiceMode.value && !streaming.value) startRecord()
            }, 2000)
          }
        }
      }
    }
  } catch (e) {
    uni.hideLoading()
    uni.showToast({ title: '语音识别失败', icon: 'none' })
  }
}

function blobToBase64(blob: Blob): Promise<string> {
  return new Promise((resolve) => {
    const reader = new FileReader()
    reader.onloadend = () => resolve((reader.result as string).split(',')[1])
    reader.readAsDataURL(blob)
  })
}

// ===================== 语音输出 (TTS) =====================

async function playTts(msg: any) {
  if (msg._playing) {
    stopTts()
    msg._playing = false
    return
  }
  messages.value.forEach(m => { if (m !== msg) m._playing = false })
  msg._playing = true

  const token = uni.getStorageSync('token') || ''
  const text = msg.content.length > 500 ? msg.content.slice(0, 500) : msg.content

  try {
    const resp = await fetch(API_HOST + '/tts/synthesize', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + token,
      },
      body: JSON.stringify({ text, voice: '101001' }),
    })
    if (!resp.ok) throw new Error('TTS failed')
    const blob = await resp.blob()
    const blobUrl = URL.createObjectURL(blob)

    audioCtx = uni.createInnerAudioContext()
    audioCtx.src = blobUrl
    audioCtx.autoplay = true
    audioCtx.onEnded(() => { msg._playing = false; URL.revokeObjectURL(blobUrl) })
    audioCtx.onError(() => { msg._playing = false; URL.revokeObjectURL(blobUrl); uni.showToast({ title: '语音播放失败', icon: 'none' }) })
  } catch (e) {
    msg._playing = false
    uni.showToast({ title: '语音播放失败', icon: 'none' })
  }
}

function stopTts() {
  if (audioCtx) {
    audioCtx.stop()
    audioCtx.destroy()
    audioCtx = null
  }
}

// ===================== 语音通话模式 =====================

function toggleVoiceMode() {
  voiceMode.value = !voiceMode.value
  if (voiceMode.value) {
    uni.showToast({ title: '语音通话模式已开启，说完即答', icon: 'none' })
    setTimeout(() => startRecord(), 500)
  } else {
    if (recording.value) stopRecord()
    stopTts()
    uni.showToast({ title: '已切换为文字模式', icon: 'none' })
  }
}

// ===================== 发送消息 =====================

async function send() {
  const text = input.value.trim()
  if (!text || streaming.value) return
  input.value = ''
  stopTts()

  messages.value.push({ role: 'user', content: text })
  scrollToBottom()

  streaming.value = true
  streamText.value = ''

  try {
    const resp = await fetch(API_HOST + '/ai/agent/chat/' + agentId.value + '/stream', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + (uni.getStorageSync('token') || ''),
      },
      body: JSON.stringify({
        messages: messages.value.map(m => ({ role: m.role, content: m.content })),
      }),
    })

    const reader = resp.body?.getReader()
    if (!reader) throw new Error('不支持流式')

    const decoder = new TextDecoder()
    let buffer = ''

    while (true) {
      const { done, value } = await reader.read()
      if (done) break
      buffer += decoder.decode(value, { stream: true })
      const lines = buffer.split('\n')
      buffer = lines.pop() || ''
      for (const line of lines) {
        if (!line.startsWith('data: ')) continue
        try {
          const data = JSON.parse(line.slice(6))
          if (data.type === 'chunk') streamText.value += data.content
          else if (data.type === 'error') streamText.value += '\n[出错了: ' + data.message + ']'
        } catch (e) { /* skip */ }
      }
    }

    if (streamText.value) {
      messages.value.push({ role: 'assistant', content: streamText.value })
      if (voiceMode.value && streamText.value) {
        const lastMsg = messages.value[messages.value.length - 1]
        setTimeout(() => playTts(lastMsg), 300)
      }
    }
  } catch (e: any) {
    try {
      const fallback = await uni.request({
        url: API_HOST + '/ai/agent/chat/' + agentId.value,
        method: 'POST',
        data: { messages: messages.value.map(m => ({ role: m.role, content: m.content })) },
        header: { 'Authorization': 'Bearer ' + (uni.getStorageSync('token') || '') },
      })
      if (fallback.statusCode === 201 && fallback.data) {
        const data = fallback.data as any
        messages.value.push({ role: 'assistant', content: data.content || '抱歉，未能获取回复。' })
        if (voiceMode.value && data.content) {
          const lastMsg = messages.value[messages.value.length - 1]
          setTimeout(() => playTts(lastMsg), 300)
        }
      }
    } catch (e2) {
      messages.value.push({ role: 'assistant', content: '抱歉，网络连接失败，请稍后重试。' })
    }
  }

  streaming.value = false
  streamText.value = ''
  scrollToBottom()

  if (voiceMode.value) {
    setTimeout(() => {
      if (voiceMode.value && !streaming.value) startRecord()
    }, 3500)
  }
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
