<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- 顶部搜索栏 -->
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center gap-3 px-4 h-12">
        <view class="p-1" @click="goBack"><text class="text-xl text-[#2C2C2C]">←</text></view>
        <view class="flex-1 bg-[#FAF8F5] rounded-lg px-3 py-2 flex items-center gap-2 border border-[#E8E0D5]">
          <text class="text-xs text-[#999]">🔍</text>
          <input v-model="searchText" placeholder="搜索商品..." class="flex-1 text-xs text-[#2C2C2C] outline-none" @confirm="doSearch" />
        </view>
        <view class="relative" @click="goCart">
          <text class="text-xl">🛒</text>
          <view v-if="cartCount > 0" class="absolute -top-1 -right-2 min-w-[16px] h-4 bg-[#C41E3A] rounded-full flex items-center justify-center px-1">
            <text class="text-[10px] text-white font-medium">{{ cartCount }}</text>
          </view>
        </view>
      </view>

      <!-- 分类导航 -->
      <scroll-view scroll-x class="px-4 pb-2.5 whitespace-nowrap" show-scrollbar="false">
        <view v-for="cat in categories" :key="cat.key"
          :class="['inline-block px-4 py-1.5 rounded-full text-sm mr-2', activeCat === cat.key ? 'bg-[#C41E3A] text-white' : 'bg-[#F5F1EB] text-[#666]']"
          @click="activeCat = cat.key">
          <text>{{ cat.icon }} {{ cat.label }}</text>
        </view>
      </scroll-view>
    </view>

    <!-- 骨架屏 -->
    <view v-if="loading" class="flex-1 p-4">
      <view class="w-full h-36 bg-[#F0EBE5] rounded-xl mb-4 animate-pulse" />
      <view class="grid grid-cols-2 gap-3">
        <view v-for="i in 4" :key="i" class="bg-white rounded-xl animate-pulse">
          <view class="w-full h-36 bg-[#F0EBE5] rounded-t-xl" />
          <view class="p-3">
            <view class="w-3/4 h-3.5 bg-[#F0EBE5] rounded mb-2" />
            <view class="w-1/2 h-3 bg-[#F0EBE5] rounded mb-2" />
            <view class="w-1/3 h-4 bg-[#F0EBE5] rounded" />
          </view>
        </view>
      </view>
    </view>

    <!-- 主内容 -->
    <scroll-view v-else scroll-y class="flex-1">
      <!-- 限时秒杀 -->
      <view class="px-4 pt-4 mb-3">
        <view class="bg-gradient-to-r from-[#C41E3A] to-[#E74C3C] rounded-xl p-3 flex items-center gap-3">
          <view class="bg-white/20 rounded-lg px-3 py-2">
            <text class="text-white text-xs font-bold">限时秒杀</text>
          </view>
          <view class="flex-1">
            <text class="text-white text-xs">每日10点开抢</text>
          </view>
          <view class="flex items-center gap-1">
            <view class="bg-white/20 rounded px-1.5 py-0.5"><text class="text-white text-xs font-bold">{{ flashHours }}</text></view>
            <text class="text-white text-xs">:</text>
            <view class="bg-white/20 rounded px-1.5 py-0.5"><text class="text-white text-xs font-bold">{{ flashMins }}</text></view>
            <text class="text-white text-xs">:</text>
            <view class="bg-white/20 rounded px-1.5 py-0.5"><text class="text-white text-xs font-bold">{{ flashSecs }}</text></view>
          </view>
        </view>
      </view>

      <!-- 轮播Banner -->
      <view class="px-4 pt-4 mb-3">
        <swiper class="w-full h-36 rounded-xl overflow-hidden" indicator-dots indicator-color="rgba(255,255,255,0.4)" indicator-active-color="#C41E3A" autoplay circular>
          <swiper-item v-for="(b, i) in banners" :key="i" @click="goBanner(b)">
            <view class="w-full h-full bg-gradient-to-br rounded-xl flex items-center justify-center" :style="{ background: b.bg }">
              <view class="text-center px-4">
                <text class="text-white text-base font-semibold block mb-1">{{ b.title }}</text>
                <text class="text-white/80 text-xs">{{ b.subtitle }}</text>
              </view>
            </view>
          </swiper-item>
        </swiper>
      </view>

      <!-- 商品列表 -->
      <view class="px-4 pb-4">
        <view class="flex items-center justify-between mb-3 px-1">
          <text class="text-sm font-semibold text-[#2C2C2C]">{{ activeCatLabel }} · 推荐商品</text>
          <text class="text-xs text-[#999]">共 {{ filteredProducts.length }} 件</text>
        </view>

        <!-- 空状态 -->
        <view v-if="filteredProducts.length === 0" class="flex flex-col items-center justify-center py-16">
          <text class="text-5xl mb-4">📦</text>
          <text class="text-base text-[#2C2C2C] font-medium mb-2">暂无商品</text>
          <text class="text-sm text-[#999]">该分类下暂无商品，请查看其他分类</text>
        </view>

        <!-- 商品网格 -->
        <view v-else class="grid grid-cols-2 gap-3">
          <view v-for="p in filteredProducts" :key="p.id" class="bg-white rounded-xl overflow-hidden shadow-sm border border-[#E8E0D5]" @click="goProduct(p.id)">
            <view class="w-full h-36 bg-[#F0EBE5] flex items-center justify-center">
              <text class="text-4xl">{{ p.image }}</text>
            </view>
            <view class="p-3">
              <text class="text-sm text-[#2C2C2C] font-medium line-clamp-2 block h-10">{{ p.name }}</text>
              <view class="flex items-center gap-1 mt-1 mb-1.5">
                <view v-for="tag in p.tags" :key="tag" class="px-1.5 py-0.5 bg-[#C41E3A]/5 rounded text-[10px] text-[#C41E3A]">{{ tag }}</view>
              </view>
              <view class="flex items-center justify-between">
                <text class="text-base font-bold text-[#C41E3A]">¥{{ p.price }}</text>
                <text class="text-[10px] text-[#999]">已售 {{ p.sales }}</text>
              </view>
              <view @click.stop="addCart(p.id)" class="mt-2 pt-2 border-t border-[#FAF8F5] flex items-center justify-center gap-1">
                <text class="text-xs text-[#C41E3A]">🛒 加入购物车</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 热销推荐 -->
      <view class="px-4 pb-2">
        <view class="flex items-center gap-2 mb-3 px-1">
          <text class="text-sm font-semibold text-[#2C2C2C]">🔥 热销推荐</text>
          <text class="text-xs text-[#999]">大家都在买</text>
        </view>
        <scroll-view scroll-x class="whitespace-nowrap" show-scrollbar="false">
          <view v-for="p in hotProducts" :key="p.id" class="inline-block w-36 mr-3 bg-white rounded-xl overflow-hidden shadow-sm border border-[#E8E0D5]" @click="goProduct(p.id)">
            <view class="w-full h-28 bg-[#F0EBE5] flex items-center justify-center">
              <text class="text-3xl">{{ p.image }}</text>
            </view>
            <view class="p-2.5">
              <text class="text-xs text-[#2C2C2C] font-medium block truncate">{{ p.name }}</text>
              <view class="flex items-center justify-between mt-1">
                <text class="text-sm font-bold text-[#C41E3A]">¥{{ p.price }}</text>
                <text class="text-[10px] text-[#999]">已售{{ p.sales }}</text>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="h-5" />
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

const loading = ref(true)
const searchText = ref('')
const activeCat = ref('all')
const cartCount = ref(2)
const flashHours = ref('02')
const flashMins = ref('35')
const flashSecs = ref('48')

// 秒杀倒计时
onMounted(() => {
  setTimeout(() => { loading.value = false }, 1200)
  setInterval(() => {
    let s = parseInt(flashSecs.value) - 1
    let m = parseInt(flashMins.value)
    let h = parseInt(flashHours.value)
    if (s < 0) { s = 59; m-- }
    if (m < 0) { m = 59; h-- }
    if (h < 0) { h = 23; m = 59; s = 59 }
    flashHours.value = String(h).padStart(2, '0')
    flashMins.value = String(m).padStart(2, '0')
    flashSecs.value = String(s).padStart(2, '0')
  }, 1000)
})

const categories = [
  { key: 'all', label: '全部', icon: '📋' },
  { key: 'books', label: '经典书籍', icon: '📚' },
  { key: 'stationery', label: '文房雅器', icon: '🖌' },
  { key: 'jewelry', label: '吉祥饰品', icon: '📿' },
  { key: 'courses', label: '精品课程', icon: '🎓' },
  { key: 'incense', label: '香道用品', icon: '🪔' },
]

const activeCatLabel = computed(() => categories.find(c => c.key === activeCat.value)?.label || '')

const banners = [
  { title: '📚 新书上市 · 国学经典', subtitle: '限时8折，满99包邮', bg: 'linear-gradient(135deg, #C41E3A, #8B0000)', url: '' },
  { title: '🎋 文房雅器专场', subtitle: '笔墨纸砚，文人雅趣', bg: 'linear-gradient(135deg, #C9A96E, #8B6914)', url: '' },
  { title: '🧧 端午吉祥饰品', subtitle: '五帝钱 · 平安扣 · 红绳手链', bg: 'linear-gradient(135deg, #2C2C2C, #555)', url: '' },
]

interface Product {
  id: string
  name: string
  price: number
  sales: number
  image: string
  tags: string[]
  category: string
}

const products = ref<Product[]>([
  { id: '1', name: '《渊海子平》精装版', price: 168, sales: 128, image: '📖', tags: ['精装', '典藏'], category: 'books' },
  { id: '2', name: '五帝钱挂件（清代）', price: 68, sales: 256, image: '🪙', tags: ['招财', '风水'], category: 'jewelry' },
  { id: '3', name: '风水罗盘（专业版）', price: 268, sales: 56, image: '🧭', tags: ['专业', '风水'], category: 'jewelry' },
  { id: '4', name: '宣纸四尺整刀', price: 88, sales: 312, image: '📜', tags: ['文房', '书画'], category: 'stationery' },
  { id: '5', name: '《周易》全文注释本', price: 128, sales: 432, image: '📕', tags: ['畅销', '经典'], category: 'books' },
  { id: '6', name: '徽墨·松烟墨条', price: 58, sales: 167, image: '🖊', tags: ['文房', '礼品'], category: 'stationery' },
  { id: '7', name: '紫檀木念珠手串', price: 198, sales: 89, image: '📿', tags: ['修行', '礼品'], category: 'jewelry' },
  { id: '8', name: '八字命理入门课程', price: 299, sales: 523, image: '🎓', tags: ['热门', '零基础'], category: 'courses' },
  { id: '9', name: '天然艾草线香', price: 38, sales: 678, image: '🪔', tags: ['香道', '养生'], category: 'incense' },
  { id: '10', name: '《说文解字》影印版', price: 198, sales: 74, image: '📗', tags: ['学术', '工具书'], category: 'books' },
  { id: '11', name: '铜质鎏金莲花香炉', price: 328, sales: 43, image: '🏺', tags: ['香道', '供奉'], category: 'incense' },
  { id: '12', name: '六爻占卜入门课程', price: 199, sales: 345, image: '🎓', tags: ['占卜', '热门'], category: 'courses' },
])

const hotProducts = computed(() => [...products.value].sort((a, b) => b.sales - a.sales).slice(0, 6))

const filteredProducts = computed(() => {
  let list = products.value
  if (activeCat.value !== 'all') {
    list = list.filter(p => p.category === activeCat.value)
  }
  if (searchText.value.trim()) {
    const q = searchText.value.trim().toLowerCase()
    list = list.filter(p => p.name.toLowerCase().includes(q))
  }
  return list
})

function goBack() { uni.navigateBack() }

function doSearch() {
  uni.navigateTo({ url: `/pages/search/index?keyword=${encodeURIComponent(searchText.value)}` })
}

function addCart(id: string) {
  cartCount.value++
  uni.showToast({ title: '已加入购物车', icon: 'none' })
}

function goCart() {
  uni.navigateTo({ url: '/pages/store/cart/index' })
}

function goProduct(id: string) {
  uni.navigateTo({ url: `/pages/store/product/${id}/index` })
}

function goBanner(b: any) {
  if (b.link) {
    uni.navigateTo({ url: b.link })
  } else if (b.courseId) {
    uni.navigateTo({ url: `/pages/course/id-detail/index?id=${b.courseId}` })
  } else {
    uni.showToast({ title: '暂无详情', icon: 'none' })
  }
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
