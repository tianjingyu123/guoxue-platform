<template>
  <view class="flex flex-col h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="h-14 bg-gradient-to-r from-[#C41E3A] to-[#E8544E] flex items-center px-4 shrink-0 z-10">
      <view @click="goBack" class="p-1 mr-2"><text class="text-white text-xl">←</text></view>

      <view class="flex items-center flex-1 min-w-0 gap-2">
        <image :src="botDetail?.avatar" mode="aspectFill" class="w-8 h-8 rounded-full border-2 border-white/30" />
        <view class="min-w-0">
          <text class="text-white font-medium text-sm truncate block">{{ botDetail?.name || '加载中...' }}</text>
          <text class="text-white/70 text-xs">{{ botDetail?.isOfficial ? '官方认证' : '在线' }}</text>
        </view>
      </view>

      <view class="flex items-center gap-1">
        <view v-if="botDetail?.voiceEnabled" @click="handleVoiceCall" class="p-2">
          <text class="text-white text-lg">📞</text>
        </view>
        <view @click="showMenu = true" class="p-2">
          <text class="text-white text-lg">⋯</text>
        </view>
      </view>
    </view>

    <!-- 加载中 -->
    <view v-if="isLoading" class="flex-1 p-4">
      <view class="h-14 bg-gradient-to-r from-[#C41E3A] to-[#E8544E] flex items-center px-4">
        <view class="w-8 h-8 bg-white/20 rounded-full animate-pulse" />
        <view class="ml-3 flex-1">
          <view class="w-24 h-4 bg-white/20 rounded animate-pulse" />
          <view class="w-16 h-3 bg-white/20 rounded mt-1 animate-pulse" />
        </view>
      </view>
      <view class="flex-1 p-4 space-y-4">
        <view v-for="i in 3" :key="i" class="flex gap-3" :class="i % 2 === 0 ? 'flex-row-reverse' : ''">
          <view class="w-9 h-9 rounded-full bg-[#F0EBE5] animate-pulse shrink-0" />
          <view class="h-16 w-2/3 bg-[#F0EBE5] rounded-2xl animate-pulse" />
        </view>
      </view>
    </view>

    <!-- 对话区域 -->
    <scroll-view scroll-y class="flex-1 p-4 space-y-4" scroll-into-view="scrollBottom">
      <!-- 欢迎消息 -->
      <view v-if="messages.length === 0 && botDetail" class="space-y-4">
        <view class="flex gap-3">
          <image :src="botDetail.avatar" mode="aspectFill" class="w-9 h-9 rounded-full shrink-0" />
          <view class="max-w-[80%]">
            <view class="bg-white rounded-2xl rounded-tl-sm px-4 py-3 shadow-sm">
              <text class="text-sm text-gray-700 leading-relaxed">{{ botDetail.welcomeMessage }}</text>
            </view>
          </view>
        </view>

        <!-- 推荐问题 -->
        <view v-if="botDetail.suggestions && botDetail.suggestions.length > 0" class="pl-12">
          <text class="text-xs text-gray-500 mb-2 block">您可以这样问我：</text>
          <view class="flex flex-wrap gap-2">
            <view
              v-for="(suggestion, index) in botDetail.suggestions"
              :key="index"
              @click="handleSuggestionClick(suggestion)"
              class="px-3 py-1.5 bg-white border border-[#C41E3A]/20 text-[#C41E3A] text-xs rounded-full"
            >
              <text>{{ suggestion }}</text>
            </view>
          </view>
        </view>

        <!-- 能力说明 -->
        <view v-if="botDetail.capabilities" class="pl-12 pt-2">
          <view class="bg-[#C41E3A]/5 rounded-lg p-3">
            <text class="text-xs text-gray-500 mb-2 block">我的能力：</text>
            <view class="flex flex-wrap gap-1.5">
              <view v-for="(cap, index) in botDetail.capabilities" :key="index" class="px-2 py-0.5 bg-white text-xs text-gray-600 rounded">
                <text>{{ cap }}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 对话消息 -->
      <view
        v-for="message in messages"
        :key="message.id"
        :class="['flex gap-3', message.role === 'user' ? 'flex-row-reverse' : '']"
      >
        <!-- 头像 -->
        <image
          v-if="message.role === 'user'"
          src="/static/avatar-placeholder.png"
          mode="aspectFill"
          class="w-9 h-9 rounded-full shrink-0"
        />
        <image
          v-else
          :src="botDetail?.avatar"
          mode="aspectFill"
          class="w-9 h-9 rounded-full shrink-0"
        />

        <!-- 消息内容 -->
        <view :class="['max-w-[80%]', message.role === 'user' ? 'text-right' : '']">
          <!-- 文本消息 -->
          <view v-if="message.type === 'text' || !message.type">
            <view
              :class="['px-4 py-3 shadow-sm inline-block text-left', message.role === 'user' ? 'bg-[#C41E3A] text-white rounded-2xl rounded-tr-sm' : 'bg-white text-gray-700 rounded-2xl rounded-tl-sm']"
            >
              <view v-if="message.isStreaming" class="text-sm leading-relaxed">
                <text>{{ streamingText }}{{ streamingText ? '' : '' }}</text>
                <text class="inline-block w-1.5 h-4 bg-[#C41E3A] animate-pulse ml-0.5" />
              </view>
              <view v-else class="text-sm leading-relaxed">
                <text v-for="(line, li) in message.content.split('\n')" :key="li" class="block">
                  <text v-if="!line.trim()" class="block h-2" />
                  <text v-else-if="line.startsWith('# ')" class="text-base font-bold mt-2 mb-1 block">{{ line.slice(2) }}</text>
                  <text v-else-if="line.startsWith('## ')" class="text-sm font-bold mt-2 mb-1 block">{{ line.slice(3) }}</text>
                  <text v-else-if="line.match(/^\d+\.\s/)" class="block ml-4">{{ line }}</text>
                  <text v-else-if="line.startsWith('- ')" class="block ml-4">• {{ line.slice(2) }}</text>
                  <text v-else>{{ parseBold(line) }}</text>
                </text>
              </view>
            </view>
          </view>

          <!-- 图片消息 -->
          <view v-if="message.type === 'image' && message.attachment" :class="['rounded-2xl overflow-hidden shadow-sm', message.role === 'user' ? 'rounded-tr-sm' : 'rounded-tl-sm']">
            <image :src="message.attachment.url" mode="widthFix" class="max-w-full max-h-48" />
          </view>

          <!-- 文件消息 -->
          <view v-if="message.type === 'file' && message.attachment" :class="['px-4 py-3 shadow-sm flex items-center gap-2', message.role === 'user' ? 'bg-[#C41E3A] text-white rounded-2xl rounded-tr-sm' : 'bg-white text-gray-700 rounded-2xl rounded-tl-sm']">
            <text class="text-sm">📎</text>
            <text class="text-sm truncate">{{ message.attachment.name }}</text>
          </view>

          <!-- 时间 -->
          <text :class="['text-xs text-gray-400 mt-1 block', message.role === 'user' ? 'text-right pr-1' : 'pl-1']">
            {{ formatTime(message.createdAt) }}
          </text>
        </view>
      </view>

      <view id="scrollBottom" />
    </scroll-view>

    <!-- 使用限制提示 -->
    <view v-if="botDetail?.limits && !botDetail.isFree" class="px-4 py-2 bg-[#C9A96E]/10 border-t border-[#C9A96E]/20">
      <text class="text-xs text-[#C9A96E] text-center block">
        今日免费次数：{{ botDetail.limits.usedCount }}/{{ botDetail.limits.dailyFreeCount }}
        <text v-if="botDetail.limits.usedCount >= botDetail.limits.dailyFreeCount" @click="goUpgrade" class="ml-2 underline">升级会员</text>
      </text>
    </view>

    <!-- 底部输入区 -->
    <view class="shrink-0 bg-white border-t border-gray-100 px-4 py-3">
      <view class="flex items-center gap-2">
        <!-- 语音按钮 -->
        <view v-if="botDetail?.voiceEnabled" @click="handleVoiceToggle" :class="['p-2 shrink-0', isRecording ? 'text-[#C41E3A] bg-[#C41E3A]/10 rounded-full' : '']">
          <text class="text-lg">{{ isRecording ? '🎤' : '🎙' }}</text>
        </view>

        <!-- 输入框 -->
        <view class="flex-1 relative">
          <input
            v-model="inputValue"
            @confirm="handleSend"
            :placeholder="isRecording ? '正在录音...' : '输入您的问题...'"
            :disabled="isRecording || isSending"
            class="w-full pr-10 py-2.5 px-4 bg-gray-50 border border-gray-200 rounded-full text-sm outline-none text-[#2C2C2C]"
          />
          <!-- 附件按钮 -->
          <view v-if="botDetail?.fileEnabled" @click="chooseFile" class="absolute right-3 top-1/2 -translate-y-1/2">
            <text class="text-lg text-gray-500">📎</text>
          </view>
        </view>

        <!-- 发送按钮 -->
        <view
          @click="handleSend"
          :class="['w-10 h-10 rounded-full flex items-center justify-center shrink-0', inputValue.trim() && !isSending ? 'bg-[#C41E3A]' : 'bg-gray-200']"
        >
          <text class="text-white text-lg">{{ isSending ? '⏳' : '➤' }}</text>
        </view>
      </view>
    </view>

    <!-- 操作菜单 -->
    <view v-if="showMenu" class="fixed inset-0 z-50" @click="showMenu = false">
      <view class="absolute inset-0 bg-black/40" />
      <view class="absolute bottom-0 left-0 right-0 bg-white rounded-t-2xl pb-8" @click.stop>
        <view class="p-4 space-y-1">
          <view class="flex items-center gap-3 py-4 rounded-lg active:bg-[#F5F1EB]">
            <text class="text-lg">📋</text>
            <text class="text-sm text-[#2C2C2C]">历史记录</text>
          </view>
          <view class="flex items-center gap-3 py-4 rounded-lg active:bg-[#F5F1EB]">
            <text class="text-lg">📤</text>
            <text class="text-sm text-[#2C2C2C]">分享</text>
          </view>
          <view @click="goSettings" class="flex items-center gap-3 py-4 rounded-lg active:bg-[#F5F1EB]">
            <text class="text-lg">⚙</text>
            <text class="text-sm text-[#2C2C2C]">设置</text>
          </view>
          <view class="h-px bg-gray-100" />
          <view @click="clearChat" class="flex items-center gap-3 py-4 rounded-lg active:bg-[#F5F1EB]">
            <text class="text-lg">🗑</text>
            <text class="text-sm text-[#C41E3A]">清空对话</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted, nextTick } from 'vue'
import { onLoad } from '@dcloudio/uni-app'

interface BotDetail {
  id: number
  name: string
  avatar: string
  description: string
  isOfficial: boolean
  isFree: boolean
  voiceEnabled: boolean
  fileEnabled: boolean
  welcomeMessage: string
  suggestions: string[]
  capabilities: string[]
  limits?: { dailyFreeCount: number; usedCount: number }
}

interface ChatMessage {
  id: string
  role: 'user' | 'assistant'
  type?: 'text' | 'image' | 'file'
  content: string
  isStreaming?: boolean
  attachment?: { url: string; name: string; size?: number }
  createdAt: string
}

const botId = ref(0)
const botDetail = ref<BotDetail | null>(null)
const messages = ref<ChatMessage[]>([])
const inputValue = ref('')
const isLoading = ref(true)
const isSending = ref(false)
const isRecording = ref(false)
const streamingText = ref('')
const showMenu = ref(false)

function parseBold(text: string): string {
  // 简单处理 **bold** 语法 — 用富文本替代
  return text.replace(/\*\*(.*?)\*\*/g, '$1')
}

function formatTime(iso: string): string {
  if (!iso) return ''
  const d = new Date(iso)
  return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`
}

onLoad((options: any) => {
  botId.value = Number(options?.id) || 0
})

// 加载 Bot 详情和对话历史
async function loadData() {
  isLoading.value = true
  try {
    const [detailRes, historyRes] = await Promise.all([
      getBotDetail(botId.value),
      getChatHistory(botId.value)
    ])
    if (detailRes.code === 200) botDetail.value = detailRes.data
    if (historyRes.code === 200 && historyRes.data?.messages) {
      messages.value = historyRes.data.messages
    }
  } catch {
    // 错误处理
  } finally {
    isLoading.value = false
  }
}

async function handleSend() {
  if (!inputValue.value.trim() || isSending.value) return

  const userMessage: ChatMessage = {
    id: 'user_' + Date.now(),
    role: 'user',
    type: 'text',
    content: inputValue.value.trim(),
    createdAt: new Date().toISOString(),
  }

  messages.value.push(userMessage)
  inputValue.value = ''
  isSending.value = true
  streamingText.value = ''

  const aiMessageId = 'ai_' + Date.now()
  messages.value.push({
    id: aiMessageId,
    role: 'assistant',
    type: 'text',
    content: '',
    createdAt: new Date().toISOString(),
    isStreaming: true,
  })

  try {
    await sendMessageStream(
      botId.value,
      userMessage.content,
      {
        onStart: () => {},
        onToken: (token: string) => {
          streamingText.value += token
        },
        onComplete: (fullText: string) => {
          const idx = messages.value.findIndex(m => m.id === aiMessageId)
          if (idx >= 0) {
            messages.value[idx].content = fullText
            messages.value[idx].isStreaming = false
          }
          streamingText.value = ''
          isSending.value = false
          scrollToBottom()
        },
        onError: () => {
          isSending.value = false
        }
      }
    )
  } catch {
    isSending.value = false
  }
}

function handleSuggestionClick(suggestion: string) {
  inputValue.value = suggestion
}

function handleVoiceToggle() {
  isRecording.value = !isRecording.value
}

async function handleVoiceCall() {
  try {
    const res = await createVoiceRoom(botId.value)
    if (res.code === 200) {
      uni.showToast({ title: '语音房间已创建', icon: 'success' })
    }
  } catch {
    uni.showToast({ title: '创建语音房间失败', icon: 'none' })
  }
}

function chooseFile() {
  uni.chooseImage({
    count: 1,
    success: async (res) => {
      const file = res.tempFilePaths[0]
      try {
        const uploadRes = await uploadChatFile(botId.value, file)
        if (uploadRes.code === 200) {
          messages.value.push({
            id: 'file_' + Date.now(),
            role: 'user',
            type: 'image',
            content: '[上传了图片]',
            attachment: { url: file, name: '图片' },
            createdAt: new Date().toISOString(),
          })
        }
      } catch {
        uni.showToast({ title: '文件上传失败', icon: 'none' })
      }
    }
  })
}

function clearChat() {
  messages.value = []
  showMenu.value = false
}

function goSettings() {
  showMenu.value = false
  uni.navigateTo({ url: '/pages/bots/settings/index?id=' + botId.value })
}

function goUpgrade() {
  uni.navigateTo({ url: '/pages/notices/upgrade/index' })
}

function scrollToBottom() {
  nextTick(() => {
    const query = uni.createSelectorQuery()
    query.select('#scrollBottom').boundingClientRect()
  })
}

function goBack() { uni.navigateBack() }

// API 桩函数 (Mock 数据)
const mockMessages: ChatMessage[] = [
  { id: 'm1', role: 'assistant', type: 'text', content: '您好！我是热卜国学AI助手，可以为您解答八字命理、风水堪舆、奇门遁甲、六爻预测等方面的问题。请问有什么可以帮助您的？', createdAt: '2026-06-11T10:00:00' },
  { id: 'm2', role: 'user', type: 'text', content: '请帮我分析一下甲木日主生于子月的命理特点', createdAt: '2026-06-11T10:01:00' },
  { id: 'm3', role: 'assistant', type: 'text', content: '甲木日主生于子月（农历十一月），正值寒冬时节，水旺木休。以下是核心分析：\n\n**1. 日主状态**\n甲木在子月为"沐浴"之地，子中藏癸水为正印。水能生木，但冬季水冷木寒，甲木需要火来调候暖局。\n\n**2. 调候用神**\n子月甲木最需要的是**火**（丙火优先，丁火次之），其次是**土**（戊土制水）。若八字中火土两旺，则为上等格局。\n\n**3. 常见格局**\n- 若天干透丙火 + 地支有寅午戌 → 寒木向阳格\n- 若水过旺无制 → 水泛木浮，需戊土堤防', createdAt: '2026-06-11T10:01:30' },
  { id: 'm4', role: 'user', type: 'text', content: '如果八字中没有火怎么办？', createdAt: '2026-06-11T10:02:00' },
  { id: 'm5', role: 'assistant', type: 'text', content: '如果甲木日主子月生八字无火，属于**寒木格局**，需要特别注意：\n\n1. **性格特征**：为人内敛、思维缜密但容易优柔寡断，缺乏行动力\n2. **健康注意**：水旺木漂，易有肝胆问题、手脚冰凉、血液循环不佳\n3. **大运补救**：走**火运**（巳午未年）或**燥土运**（戌未年）时运势明显好转\n4. **风水调理**：居室宜选南向，多用红/紫色调，佩戴红玛瑙等火属性饰品\n\n建议您提供完整的八字排盘，我可以给出更精确的分析。', createdAt: '2026-06-11T10:02:30' },
]

async function getBotDetail(id: number): Promise<any> {
  return { code: 200, data: { id, name: '热卜AI助手', avatar: '', isOfficial: true, voiceEnabled: true, fileEnabled: true, welcomeMessage: '您好！我是热卜国学AI助手，有什么可以帮助您的吗？', suggestions: ['八字命理分析', '今日运势查询', '风水布局建议', '六爻占卜解卦', '奇门遁甲排盘'], capabilities: ['命理分析', '风水堪舆', '占卜解卦', '古籍查询', '起名改名'], isFree: true } }
}
async function getChatHistory(id: number): Promise<any> {
  return { code: 200, data: { messages: mockMessages } }
}
async function sendMessageStream(id: number, content: string, handlers: any): Promise<void> {
  handlers.onComplete('您好，我是AI助手！')
}
async function createVoiceRoom(id: number): Promise<any> {
  return { code: 200, data: { roomId: 'room_1' } }
}
async function uploadChatFile(id: number, filePath: string): Promise<any> {
  return { code: 200, data: { url: filePath, name: 'file' } }
}

onMounted(() => {
  loadData()
})
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
