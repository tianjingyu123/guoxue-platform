/* ---- 业务逻辑 ---- */
async function loadData() {
  loading.value = true
  error.value = null
  try {
    // 模拟 API 请求
    await new Promise(resolve => setTimeout(resolve, 600))
    const res = { code: 200, message: 'ok', data: mockVipCenterData() }
    if (res.code === 200) {
      data.value = res.data
      const defaultLevel = res.data.status.level !== 'none' ? res.data.status.level : 'pro'
      selectedLevel.value = defaultLevel
      const currentGroup = res.data.planGroups.find(g => g.level === defaultLevel)
      const popularPlan = currentGroup?.plans.find(p => p.popular)
      selectedPlan.value = popularPlan || currentGroup?.plans[0] || null
    } else {
      error.value = res.message
    }
  } catch {
    error.value = '加载失败，请稍后重试'
  } finally {
    loading.value = false
  }
}

onMounted(loadData)

function handleSelectLevel(level: VipLevel) {
  selectedLevel.value = level
  const group = data.value?.planGroups.find(g => g.level === level)
  const popularPlan = group?.plans.find(p => p.popular)
  selectedPlan.value = popularPlan || group?.plans[0] || null
}

function handleSelectPlan(plan: VipPlan) {
  selectedPlan.value = plan
}

async function handlePurchase() {
  if (!selectedPlan.value) return
  purchasing.value = true
  try {
    await new Promise(resolve => setTimeout(resolve, 1500))
    uni.showToast({ title: '购买成功', icon: 'success' })
    showPaySheet.value = false
    loadData()
  } catch {
    uni.showToast({ title: '购买失败', icon: 'error' })
  } finally {
    purchasing.value = false
  }
}

async function handleToggleAutoRenew() {
  if (autoRenewLoading.value || !data.value) return
  autoRenewLoading.value = true
  try {
    await new Promise(resolve => setTimeout(resolve, 500))
    const newVal = !data.value.status.autoRenew
    data.value = { ...data.value, status: { ...data.value.status, autoRenew: newVal } }
    uni.showToast({ title: newVal ? '已开启自动续费' : '已关闭自动续费', icon: 'success' })
  } catch {
    uni.showToast({ title: '操作失败', icon: 'error' })
  } finally {
    autoRenewLoading.value = false
  }
}

function goBack() {
  uni.navigateBack()
}

function goRecords() {
  uni.navigateTo({ url: '/pages/vip/records/index' })
}
