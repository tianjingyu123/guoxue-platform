    <view style="position:absolute;top:0;left:0;right:0;height:320px;background:linear-gradient(180deg,rgba(201,169,110,0.2) 0%,rgba(201,169,110,0.1) 50%,transparent 100%);pointer-events:none" />

    <!-- 顶部导航 -->
    <view style="position:sticky;top:0;z-index:40;padding-top:env(safe-area-inset-top)">
      <view style="display:flex;align-items:center;justify-content:space-between;padding:0 16px;height:56px">
        <view style="width:40px;display:flex;align-items:center;justify-content:center" @click="goBack">
          <text style="font-size:20px;color:#2C2C2C">←</text>
        </view>
        <text style="font-size:18px;font-weight:600;color:#2C2C2C">会员中心</text>
        <view @click="goRecords" style="padding:8px 0">
          <text style="font-size:14px;color:#C41E3A">购买记录</text>
        </view>
      </view>
    </view>

    <!-- ====== 骨架屏 ====== -->
    <block v-if="loading && !data">
      <view style="padding:0 16px;display:flex;flex-direction:column;gap:24px">
        <!-- 骨架 header -->
        <view style="display:flex;justify-content:center">
          <view class="skeleton-pulse" style="width:96px;height:20px;border-radius:4px"></view>
        </view>
        <!-- 骨架 card -->
        <view class="skeleton-pulse" style="background:#fff;border-radius:12px;height:176px"></view>
        <!-- 骨架 grid 1 -->
        <view>
          <view class="skeleton-pulse" style="width:80px;height:20px;border-radius:4px;margin-bottom:12px"></view>
          <view style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <view v-for="i in 4" :key="i" class="skeleton-pulse" style="background:#fff;border-radius:12px;height:128px"></view>
          </view>
        </view>
        <!-- 骨架 grid 2 -->
        <view>
          <view class="skeleton-pulse" style="width:96px;height:20px;border-radius:4px;margin-bottom:12px"></view>
          <view style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <view v-for="i in 4" :key="'s2-'+i" class="skeleton-pulse" style="background:#fff;border-radius:12px;height:80px"></view>
          </view>
        </view>
      </view>
    </block>

    <!-- ====== 错误状态 ====== -->
    <block v-else-if="error">
      <view style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80px 16px">
        <text style="font-size:40px;margin-bottom:16px">⚠️</text>
        <text style="font-size:14px;color:#999;margin-bottom:16px">{{ error }}</text>
        <view style="padding:10px 24px;background:#C41E3A;border-radius:999px" @click="loadData">
          <text style="color:#fff;font-size:14px">重新加载</text>
        </view>
      </view>
    </block>

    <!-- ====== 主内容 ====== -->
    <block v-if="data">
      <view style="position:relative;z-index:10;padding:0 16px;display:flex;flex-direction:column;gap:24px">

        <!-- ====== 会员卡片 ====== -->
        <view style="padding:24px;border-radius:12px;overflow:hidden;position:relative;background:linear-gradient(135deg,#C9A96E,rgba(201,169,110,0.9),rgba(196,30,58,0.8));box-shadow:0 20px 25px -5px rgba(201,169,110,0.2),0 10px 10px -5px rgba(201,169,110,0.04)">
          <!-- 装饰 SVG 图案 -->
          <view style="position:absolute;right:-40px;top:-40px;width:160px;height:160px;opacity:0.1">
            <svg viewBox="0 0 100 100" style="width:100%;height:100%;fill:currentColor;color:#fff">
              <circle cx="50" cy="50" r="48" fill="none" stroke="currentColor" stroke-width="2" />
              <path d="M50 2 A48 48 0 0 1 50 98 A24 24 0 0 1 50 50 A24 24 0 0 0 50 2" />
            </svg>
          </view>

          <view style="position:relative">
            <!-- 用户信息 -->
            <view style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
              <view style="width:56px;height:56px;border-radius:50%;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center">
                <text style="font-size:32px">👑</text>
              </view>
              <view style="flex:1">
                <view style="display:flex;align-items:center;gap:8px">
                  <text style="font-size:20px;font-weight:700;color:#fff">{{ data.status.level !== 'none' ? data.status.levelName : '热卜国学VIP' }}</text>
                  <text v-if="data.status.level !== 'none'" style="padding:2px 8px;border-radius:4px;font-size:10px;font-weight:500;background:rgba(255,255,255,0.2);color:#fff">{{ data.status.level.toUpperCase() }}</text>
                </view>
                <text style="font-size:14px;color:rgba(255,255,255,0.7);display:block">
                  {{ data.status.level !== 'none'
                    ? (data.status.isExpired ? '会员已过期' : '有效期至 ' + data.status.expireAt + '，还剩 ' + data.status.daysLeft + ' 天')
                    : '解锁全部特权，畅享国学智慧' }}
                </text>
              </view>
            </view>

            <!-- 核心数据 -->
            <view style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;padding-top:16px;border-top:1px solid rgba(255,255,255,0.2)">
              <view style="text-align:center">
                <text style="font-size:24px;font-weight:700;color:#fff;display:block">500+</text>
                <text style="font-size:12px;color:rgba(255,255,255,0.7)">免费课程</text>
              </view>
              <view style="text-align:center">
                <text style="font-size:24px;font-weight:700;color:#fff;display:block">无限</text>
                <text style="font-size:12px;color:rgba(255,255,255,0.7)">AI对话</text>
              </view>
              <view style="text-align:center">
                <text style="font-size:24px;font-weight:700;color:#fff;display:block">{{ data.status.points }}</text>
                <text style="font-size:12px;color:rgba(255,255,255,0.7)">会员积分</text>
              </view>
            </view>

            <!-- 自动续费 -->
            <view v-if="data.status.level !== 'none'" style="display:flex;align-items:center;justify-content:space-between;margin-top:16px;padding-top:16px;border-top:1px solid rgba(255,255,255,0.2)">
              <text style="font-size:14px;color:rgba(255,255,255,0.8)">自动续费</text>
              <view
                :style="{ width:'44px', height:'24px', borderRadius:'12px', padding:'2px', position:'relative', cursor:'pointer', background: data.status.autoRenew ? 'rgba(255,255,255,0.3)' : 'rgba(255,255,255,0.1)', opacity: autoRenewLoading ? 0.5 : 1 }"
                @click="!autoRenewLoading && handleToggleAutoRenew()"
              >
                <view :style="{ width:'20px', height:'20px', borderRadius:'10px', background:'#fff', transition:'all 0.2s', transform: data.status.autoRenew ? 'translateX(20px)' : 'translateX(0)' }" />
              </view>
            </view>
          </view>
        </view>

        <!-- ====== 等级选择 ====== -->
        <view>
          <text style="font-size:16px;font-weight:600;color:#2C2C2C;display:block;margin-bottom:12px">选择等级</text>
          <scroll-view scroll-x style="overflow-x:auto;padding-bottom:8px;white-space:nowrap">
            <view style="display:flex;gap:8px">
              <view
                v-for="group in data.planGroups" :key="group.level"
                :style="{
                  display:'inline-flex', padding:'6px 16px', borderRadius:'999px', fontSize:'14px', fontWeight:500,
                  whiteSpace:'nowrap', cursor:'pointer', transition:'all 0.2s',
                  background: selectedLevel === group.level ? levelColors[group.level].bg : '#fff',
                  color: selectedLevel === group.level ? '#fff' : '#2C2C2C',
                  border: selectedLevel === group.level ? 'none' : '1px solid #E8E0D5'
                }"
                @click="handleSelectLevel(group.level)"
              >
                <text>{{ group.levelName }}</text>
              </view>
            </view>
          </scroll-view>
          <text v-if="currentPlanGroup" style="font-size:14px;color:#999;display:block;margin-top:8px">{{ currentPlanGroup.description }}</text>
        </view>

        <!-- ====== 套餐选择 ====== -->
        <view>
          <text style="font-size:16px;font-weight:600;color:#2C2C2C;display:block;margin-bottom:12px">选择套餐</text>
          <view style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px">
            <view
              v-for="plan in currentPlanGroup?.plans" :key="plan.id"
              :style="{
                padding:'12px', borderRadius:'12px', cursor:'pointer', transition:'all 0.2s', position:'relative', overflow:'hidden',
                border: selectedPlan?.id === plan.id ? '2px solid #C9A96E' : '1px solid #E8E0D5',
                background: selectedPlan?.id === plan.id ? 'rgba(201,169,110,0.05)' : '#fff'
              }"
              @click="handleSelectPlan(plan)"
            >
              <!-- 标签 -->
              <view v-if="plan.popular" style="position:absolute;top:0;right:0;padding:2px 8px;font-size:10px;font-weight:500;border-radius:0 0 0 8px;background:#C9A96E;color:#fff">
                <text>推荐</text>
              </view>
              <view v-else-if="plan.discount" style="position:absolute;top:0;right:0;padding:2px 8px;font-size:10px;font-weight:500;border-radius:0 0 0 8px;background:#FF4D4F;color:#fff">
                <text>{{ plan.discount }}</text>
              </view>

              <text style="font-size:14px;font-weight:500;color:#2C2C2C;display:block;text-align:center">{{ plan.durationName }}</text>
              <view style="display:flex;align-items:baseline;justify-content:center;gap:2px;margin-top:8px">
                <text style="font-size:12px;color:#999">¥</text>
                <text style="font-size:24px;font-weight:700;color:#C41E3A">{{ plan.price }}</text>
              </view>
              <text v-if="plan.originalPrice > plan.price" style="font-size:12px;color:#999;text-decoration:line-through;display:block;text-align:center;margin-top:4px">¥{{ plan.originalPrice }}</text>
              <text style="font-size:12px;color:#C9A96E;display:block;text-align:center;margin-top:4px">¥{{ plan.dailyPrice }}/天</text>

              <!-- 选中指示 -->
              <view v-if="selectedPlan?.id === plan.id" style="position:absolute;top:8px;left:8px;width:20px;height:20px;border-radius:50%;background:#C9A96E;display:flex;align-items:center;justify-content:center">
                <text style="color:#fff;font-size:12px;font-weight:700">✓</text>
              </view>
            </view>
          </view>
        </view>

        <!-- ====== 会员权益 ====== -->
        <view>
          <text style="font-size:16px;font-weight:600;color:#2C2C2C;display:block;margin-bottom:12px">会员专属权益</text>
          <view style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <view
              v-for="benefit in data.benefits" :key="benefit.id"
              :style="{
                padding:'12px', borderRadius:'12px',
                background: benefit.levels.includes(selectedLevel) ? 'rgba(201,169,110,0.05)' : '#fff',
                border: benefit.levels.includes(selectedLevel) ? '1px solid rgba(201,169,110,0.3)' : '1px solid #E8E0D5',
                opacity: benefit.levels.includes(selectedLevel) ? 1 : 0.5
              }"
            >
              <view style="display:flex;align-items:flex-start;gap:12px">
                <view :style="{
                  width:'40px', height:'40px', borderRadius:'8px', display:'flex', alignItems:'center', justifyContent:'center', flexShrink:0,
                  background: benefit.levels.includes(selectedLevel) ? 'rgba(201,169,110,0.2)' : '#F5F1EB'
                }">
                  <text :style="{ fontSize:'20px', opacity: benefit.levels.includes(selectedLevel) ? 1 : 0.5 }">{{ benefitIconMap[benefit.icon] || '🎁' }}</text>
                </view>
                <view style="flex:1;min-width:0">
                  <text style="font-size:14px;font-weight:500;color:#2C2C2C;display:block">{{ benefit.title }}</text>
                  <text style="font-size:12px;color:#999;display:block;margin-top:2px;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical">{{ benefit.description }}</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- ====== 权益对比 ====== -->
        <view>
          <text style="font-size:16px;font-weight:600;color:#2C2C2C;display:flex;align-items:center;gap:8px;margin-bottom:12px">
            <text style="font-size:16px">📈</text>
            权益对比
          </text>
          <view style="background:#fff;border-radius:12px;overflow:hidden;border:1px solid #E8E0D5">
            <!-- 表头 -->
            <view style="display:flex;border-bottom:1px solid #E8E0D5">
              <view style="flex:1;padding:12px"><text style="font-size:12px;color:#999">权益项</text></view>
              <view v-for="lvl in ['basic','pro','premium']" :key="lvl" style="flex:1;padding:12px;text-align:center">
                <text :style="{ fontSize:'12px', fontWeight:500, color: selectedLevel === lvl ? '#C41E3A' : '#2C2C2C' }">{{ levelNames[lvl] }}</text>
              </view>
            </view>
            <!-- 数据行 -->
            <view v-for="(feature, idx) in comparisonFeatures" :key="idx" :style="{ display:'flex', borderBottom: idx < comparisonFeatures.length - 1 ? '1px solid #E8E0D5' : 'none' }">
              <view style="flex:1;padding:12px"><text style="font-size:12px;color:#2C2C2C">{{ feature.name }}</text></view>
              <view v-for="lvl in ['basic','pro','premium']" :key="lvl" style="flex:1;padding:12px;text-align:center">
                <text v-if="feature[lvl] === true" style="font-size:14px;color:#22c55e">✓</text>
                <text v-else-if="feature[lvl]" style="font-size:12px;color:#C9A96E">{{ feature[lvl] }}</text>
                <text v-else style="font-size:14px;color:#D9D9D9">✗</text>
              </view>
            </view>
            <!-- CTA 行 -->
            <view style="padding:12px;text-align:center;background:rgba(201,169,110,0.05)" @click="showPaySheet = true">
              <text style="font-size:14px;font-weight:500;color:#C41E3A">立即开通会员 →</text>
            </view>
          </view>
        </view>

        <!-- ====== 用户评价 ====== -->
        <view>
          <text style="font-size:16px;font-weight:600;color:#2C2C2C;display:block;margin-bottom:12px">会员评价</text>
          <view style="display:flex;flex-direction:column;gap:12px">
            <view v-for="(review, idx) in reviews" :key="idx" style="background:#fff;border-radius:12px;padding:12px">
              <view style="display:flex;align-items:flex-start;gap:12px">
                <view style="width:40px;height:40px;border-radius:50%;background:rgba(201,169,110,0.2);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                  <text style="font-size:14px;font-weight:500;color:#C9A96E">{{ review.avatar }}</text>
                </view>
                <view style="flex:1">
                  <view style="display:flex;align-items:center;justify-content:space-between">
                    <text style="font-size:14px;font-weight:500;color:#2C2C2C">{{ review.name }}</text>
                    <view style="display:flex;align-items:center;gap:2px">
                      <text v-for="i in 5" :key="i" style="font-size:12px;color:#C9A96E">⭐</text>
                    </view>
                  </view>
                  <text style="font-size:12px;color:#999;display:block;margin-top:4px">{{ review.content }}</text>
                  <text style="font-size:12px;color:#999;display:block;margin-top:8px">已开通{{ review.days }}天</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- ====== 常见问题 ====== -->
        <view>
          <text style="font-size:16px;font-weight:600;color:#2C2C2C;display:block;margin-bottom:12px">常见问题</text>
          <view style="background:#fff;border-radius:12px;overflow:hidden">
            <view v-for="(faq, idx) in faqs" :key="idx" :style="{ padding:'12px', borderTop: idx > 0 ? '1px solid #E8E0D5' : 'none' }">
              <text style="font-size:14px;font-weight:500;color:#2C2C2C;display:block">{{ faq.q }}</text>
              <text style="font-size:12px;color:#999;display:block;margin-top:4px">{{ faq.a }}</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- ====== 底部购买栏 ====== -->
    <view v-if="data && selectedPlan" style="position:fixed;bottom:0;left:0;right:0;background:rgba(250,248,245,0.95);backdrop-filter:blur(12px);border-top:1px solid #E8E0D5;z-index:50;padding-bottom:env(safe-area-inset-bottom)">
      <view style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;max-width:600px;margin:0 auto">
        <view>
          <view style="display:flex;align-items:baseline;gap:4px">
            <text style="font-size:14px;color:#999">¥</text>
            <text style="font-size:30px;font-weight:700;color:#C41E3A">{{ selectedPlan.price }}</text>
            <text style="font-size:14px;color:#999">/{{ selectedPlan.durationName }}</text>
          </view>
          <text style="font-size:12px;color:#999;text-decoration:line-through;display:block">原价 ¥{{ selectedPlan.originalPrice }}</text>
        </view>
        <view
          style="padding:0 32px;height:48px;border-radius:999px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;font-weight:500;background:linear-gradient(90deg,#C9A96E,#C41E3A);box-shadow:0 4px 20px rgba(201,169,110,0.3);cursor:pointer"
          @click="showPaySheet = true"
        >
          <text>{{ data.status.level === selectedLevel && !data.status.isExpired ? '续费' : '立即开通' }}</text>
        </view>
      </view>
    </view>

    <!-- ====== 支付方式选择弹窗 ====== -->
    <view v-if="showPaySheet" style="position:fixed;inset:0;z-index:1000">
      <!-- 蒙层 -->
      <view style="position:absolute;inset:0;background:rgba(0,0,0,0.5)" @click="showPaySheet = false" />
      <!-- 面板 -->
      <view style="position:absolute;bottom:0;left:0;right:0;background:#fff;border-radius:16px 16px 0 0;animation:slideUp 0.3s ease-out">
        <view style="display:flex;align-items:center;justify-content:space-between;padding:16px;border-bottom:1px solid #E8E0D5">
          <text style="font-size:16px;font-weight:600;color:#2C2C2C">选择支付方式</text>
          <text style="font-size:20px;color:#999;cursor:pointer" @click="showPaySheet = false">✕</text>
        </view>
        <view style="padding:16px;padding-bottom:calc(16px + env(safe-area-inset-bottom))">
          <!-- 订单摘要 -->
          <view v-if="selectedPlan" style="text-align:center;margin-bottom:16px;padding-bottom:16px;border-bottom:1px solid #E8E0D5">
            <text style="font-size:14px;color:#999;display:block">{{ selectedPlan.levelName }} · {{ selectedPlan.durationName }}</text>
            <text style="font-size:30px;font-weight:700;color:#C41E3A;display:block;margin-top:4px">
              <text style="font-size:18px">¥</text>{{ selectedPlan.price }}
            </text>
          </view>

          <!-- 支付方式 -->
          <view style="display:flex;flex-direction:column;gap:12px">
            <view
              v-for="method in paymentMethods" :key="method.value"
              :style="{
                display:'flex', alignItems:'center', gap:'12px', padding:'12px', borderRadius:'12px', cursor:'pointer',
                border: paymentMethod === method.value ? '1px solid #C41E3A' : '1px solid #E8E0D5',
                background: paymentMethod === method.value ? 'rgba(196,30,58,0.05)' : '#fff'
              }"
              @click="paymentMethod = method.value"
            >
              <!-- 单选圆点 -->
              <view :style="{
                width:'20px', height:'20px', borderRadius:'50%', border:'2px solid',
                display:'flex', alignItems:'center', justifyContent:'center', flexShrink:0,
                borderColor: paymentMethod === method.value ? '#C41E3A' : '#999'
              }">
                <view v-if="paymentMethod === method.value" style="width:12px;height:12px;border-radius:50%;background:#C41E3A" />
              </view>
              <!-- 图标 --><view :style="{ width:'32px', height:'32px', borderRadius:'8px', display:'flex', alignItems:'center', justifyContent:'center', flexShrink:0, background: method.bg }"><text style="color:#fff;font-size:12px;font-weight:700">{{ method.label[0] }}</text></view>
              <text style="font-size:14px;color:#2C2C2C">{{ method.label }}</text>
            </view>
          </view>

          <!-- 确认按钮 -->
          <view
            :style="{
              width:'100%', marginTop:'24px', height:'48px', borderRadius:'12px',
              display:'flex', alignItems:'center', justifyContent:'center',
              background: purchasing ? '#ccc' : '#C41E3A',
              color:'#fff', fontSize:'14px', fontWeight:500, cursor:'pointer'
            }"
            @click="handlePurchase"
          >
            <text>{{ purchasing ? '处理中...' : '确认支付' }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

/* ---- 类型定义 ---- */
type VipLevel = 'none' | 'basic' | 'pro' | 'premium'

interface VipPlan {
  id: string
  levelName: string
  durationName: string
  price: number
  originalPrice: number
  dailyPrice: number
  popular: boolean
  discount: string
}

interface VipPlanGroup {
  level: VipLevel
  levelName: string
  description: string
  plans: VipPlan[]
}

interface VipStatus {
  level: VipLevel
  levelName: string
  isExpired: boolean
  expireAt: string
  daysLeft: number
  points: number
  autoRenew: boolean
}

interface VipBenefit {
  id: string
  icon: string
  title: string
  description: string
  levels: VipLevel[]
}

interface VipCenterData {
  status: VipStatus
  planGroups: VipPlanGroup[]
  benefits: VipBenefit[]
}

/* ---- 状态 ---- */
const data = ref<VipCenterData | null>(null)
const loading = ref(true)
const error = ref<string | null>(null)
const selectedLevel = ref<VipLevel>('pro')
const selectedPlan = ref<VipPlan | null>(null)
const showPaySheet = ref(false)
const paymentMethod = ref<'wechat' | 'alipay' | 'balance'>('wechat')
const purchasing = ref(false)
const autoRenewLoading = ref(false)

/* ---- 常量 ---- */
const levelColors: Record<string, { bg: string }> = {
  none:  { bg: '#D9D9D9' },
  basic: { bg: '#C9A96E' },
  pro:   { bg: '#8B5CF6' },
  premium: { bg: 'linear-gradient(90deg,#C9A96E,#F97316)' },
}

const levelNames: Record<string, string> = {
  basic: '基础', pro: '专业', premium: '至尊',
}

const benefitIconMap: Record<string, string> = {
  crown: '👑',
