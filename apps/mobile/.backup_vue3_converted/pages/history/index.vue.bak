<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-6">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-40 bg-[#FAF8F5]/95 backdrop-blur-lg border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 h-14">
        <view class="p-2 -ml-2 rounded-full" @tap="goBack">
          <text class="w-5 h-5 text-[#2C2C2C]">←</text>
        </view>
        <text class="font-semibold text-base text-[#2C2C2C]">浏览历史</text>
        <view class="flex items-center gap-2">
          <text v-if="!isEditMode && history.length > 0" class="text-sm text-[#999]" @tap="handleClearAll">清空</text>
          <text v-if="history.length > 0" class="text-sm text-[#C41E3A]" @tap="toggleEditMode">
            {{ isEditMode ? "完成" : "管理" }}
          </text>
        </view>
      </view>
    </view>

    <!-- 编辑模式选择栏 -->
    <view v-if="isEditMode" class="flex items-center justify-between px-4 py-2 bg-[#F0EBE5]/30">
      <view class="flex items-center gap-2" @tap="handleSelectAll">
        <view class="w-5 h-5 rounded border border-[#999] flex items-center justify-center"
          :class="selectedIds.length === historyItems.length ? 'bg-[#C41E3A] border-[#C41E3A]' : ''">
          <text v-if="selectedIds.length === historyItems.length" class="text-white text-xs">✓</text>
        </view>
        <text class="text-sm text-[#999]">全选</text>
      </view>
      <text class="text-sm text-red-500" :class="selectedIds.length === 0 ? 'opacity-50' : ''" @tap="handleDelete">
        删除 ({{ selectedIds.length }})
      </text>
    </view>

    <!-- 历史列表 -->
    <view class="p-4">
      <!-- 加载骨架 -->
      <view v-if="loading" class="space-y-3">
        <view v-for="i in 5" :key="i" class="flex gap-3 p-3 rounded-xl">
          <view class="w-16 h-16 rounded-lg bg-[#F5F1EB] animate-pulse flex-shrink-0" />
          <view class="flex-1 space-y-2">
            <view class="h-4 w-20 bg-[#F5F1EB] rounded animate-pulse" />
            <view class="h-4 w-full bg-[#F5F1EB] rounded animate-pulse" />
            <view class="h-3 w-2/3 bg-[#F5F1EB] rounded animate-pulse" />
          </view>
        </view>
      </view>
      <!-- 错误 -->
      <view v-else-if="error" class="text-center py-20">
        <text class="text-[#999] mb-4 block">{{ error }}</text>
        <view class="px-6 py-2 bg-[#C41E3A] text-white rounded-full text-sm inline-block" @tap="fetchData">重试</view>
      </view>
      <!-- 空 -->
      <view v-else-if="history.length === 0" class="text-center py-20">
        <text class="text-4xl block mb-4 opacity-30">📖</text>
        <text class="text-[#999]">暂无浏览历史</text>
      </view>
      <!-- 列表 -->
      <view v-else class="space-y-6">
        <view v-for="(group, groupIndex) in history" :key="groupIndex" class="mb-6">
          <text class="text-sm font-medium text-[#999] mb-3 block">{{ group.date }}</text>
          <view class="space-y-2">
            <view v-for="item in group.items" :key="item.id" class="flex items-center gap-3 p-3 rounded-xl bg-white border border-[#E8E0D5]"
              @tap="isEditMode ? toggleSelect(item.id) : goTo(getTypeUrl(item.type, item.id))">
              <!-- 选择框 -->
              <view v-if="isEditMode"
                class="w-5 h-5 rounded border border-[#999] flex items-center justify-center flex-shrink-0"
                :class="selectedIds.includes(item.id) ? 'bg-[#C41E3A] border-[#C41E3A]' : ''"
                @tap.stop="toggleSelect(item.id)">
                <text v-if="selectedIds.includes(item.id)" class="text-white text-xs">✓</text>
              </view>
              <!-- 图标 -->
              <view class="w-12 h-12 rounded-lg flex items-center justify-center flex-shrink-0" :class="getTypeBg(item.type)">
                <text class="text-sm">{{ getTypeIcon(item.type) }}</text>
              </view>
              <!-- 信息 -->
              <view class="flex-1 min-w-0">
                <view class="flex items-center gap-2 mb-0.5 flex-wrap">
                  <text class="text-[10px] px-1.5 py-0.5 rounded-full" :class="getTypeColor(item.type)">{{ getTypeLabel(item.type) }}</text>
                  <text class="text-[10px] text-[#999]">{{ item.time }}</text>
                </view>
                <text class="font-medium text-sm text-[#2C2C2C] line-clamp-1 block">{{ item.title }}</text>
                <text class="text-xs text-[#999] mt-0.5 block">{{ item.subtitle }}</text>
                <!-- 课程进度条 -->
                <view v-if="item.type === 'course' && item.progress !== undefined" class="mt-2">
                  <view class="flex items-center justify-between text-[10px] text-[#999] mb-1">
                    <text>学习进度</text>
                    <text>{{ item.progress }}%</text>
                  </view>
                  <view class="h-1.5 bg-[#F5F1EB] rounded-full overflow-hidden">
                    <view class="h-full bg-[#C41E3A] rounded-full transition-all" :style="{ width: item.progress + '%' }" />
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部操作栏（编辑模式） -->
    <view v-if="isEditMode && selectedIds.length > 0" class="fixed bottom-0 left-0 right-0 bg-white border-t border-[#E8E0D5] p-4" style="padding-bottom: calc(env(safe-area-inset-bottom) + 16px);">
      <view class="flex items-center justify-between">
        <text class="text-sm text-[#C41E3A]" @tap="handleSelectAll">
          {{ selectedIds.length === historyItems.length ? '取消全选' : '全选' }}
        </text>
        <view class="flex items-center gap-2 px-6 py-2 bg-red-500 text-white rounded-full text-sm" @tap="handleDelete">
          <text class="text-xs">🗑</text>
          <text>删除 ({{ selectedIds.length }})</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

// 导航辅助
function goBack() { uni.navigateBack() }
function goTo(url: string) { uni.navigateTo({ url }) }

// 类型配置
interface TypeConfig {
  icon: string
  label: string
  color: string
  bg: string
}

const typeConfigs: Record<string, TypeConfig> = {
  course: { icon: '📚', label: '课程', color: 'bg-blue-500/10 text-blue-600', bg: 'bg-blue-50' },
  article: { icon: '📄', label: '文章', color: 'bg-purple-500/10 text-purple-600', bg: 'bg-purple-50' },
  product: { icon: '🛍', label: '商品', color: 'bg-orange-500/10 text-orange-600', bg: 'bg-orange-50' },
  circle: { icon: '👥', label: '圈子', color: 'bg-green-500/10 text-green-600', bg: 'bg-green-50' },
  classic: { icon: '📜', label: '古籍', color: 'bg-amber-500/10 text-amber-600', bg: 'bg-amber-50' },
  agent: { icon: '🤖', label: '智能体', color: 'bg-pink-500/10 text-pink-600', bg: 'bg-pink-50' },
}

function getTypeIcon(type: string): string {
  return typeConfigs[type]?.icon || '📄'
}
function getTypeLabel(type: string): string {
  return typeConfigs[type]?.label || type
}
function getTypeColor(type: string): string {
  return typeConfigs[type]?.color || 'bg-[#F0EBE5] text-[#999]'
}
function getTypeBg(type: string): string {
  return typeConfigs[type]?.bg || 'bg-[#F5F1EB]'
}

// 组件逻辑
const isEditMode = ref(false)
const selectedIds = ref<number[]>([])
const loading = ref(true)
const error = ref<string | null>(null)

interface HistoryItem {
  id: number
  type: string
  title: string
  subtitle: string
  time: string
  progress?: number
}

interface HistoryGroup {
  date: string
  items: HistoryItem[]
}

const history = ref<HistoryGroup[]>([])

const historyItems = computed(() => history.value.flatMap(g => g.items))

// 加载数据
const fetchData = async () => {
  loading.value = true
  error.value = null
  try {
    await new Promise(resolve => setTimeout(resolve, 500))
    history.value = [
      {
        date: '今天',
        items: [
          { id: 1, type: 'course', title: '八字命理入门到精通', subtitle: '第四讲：十神详解（上）', time: '2小时前', progress: 65 }
        ]
      },
      {
        date: '昨天',
        items: [
          { id: 2, type: 'article', title: '易经的智慧', subtitle: '易经入门指南', time: '昨天' },
          { id: 3, type: 'product', title: '天然黑曜石貔貅手链', subtitle: '招财转运', time: '昨天' },
        ]
      },
    ]
  } catch {
    error.value = '加载失败，请重试'
  } finally {
    loading.value = false
  }
}

onMounted(() => {
  fetchData()
})

const toggleSelect = (id: number) => {
  if (selectedIds.value.includes(id)) {
    selectedIds.value = selectedIds.value.filter(i => i !== id)
  } else {
    selectedIds.value = [...selectedIds.value, id]
  }
}

const handleSelectAll = () => {
  if (selectedIds.value.length === historyItems.value.length) {
    selectedIds.value = []
  } else {
    selectedIds.value = historyItems.value.map(i => i.id)
  }
}

const toggleEditMode = () => {
  isEditMode.value = !isEditMode.value
  if (!isEditMode.value) selectedIds.value = []
}

const handleDelete = async () => {
  if (selectedIds.value.length === 0) return
  history.value = history.value.map(group => ({
    ...group,
    items: group.items.filter(item => !selectedIds.value.includes(item.id))
  })).filter(group => group.items.length > 0)
  selectedIds.value = []
  isEditMode.value = false
  uni.showToast({ title: '已删除', icon: 'success' })
}

const handleClearAll = async () => {
  uni.showModal({
    title: '提示',
    content: '确定要清空全部浏览历史吗？',
    success: (res) => {
      if (res.confirm) {
        history.value = []
        uni.showToast({ title: '已清空', icon: 'success' })
      }
    }
  })
}

const getTypeUrl = (type: string, id: number): string => {
  const map: Record<string, string> = {
    course: '/pages/learn/',
    article: '/pages/article/',
    product: '/pages/mall/product/',
    circle: '/pages/circle/',
    classic: '/pages/classics/',
    agent: '/pages/agent/',
  }
  return (map[type] || '#') + id
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
