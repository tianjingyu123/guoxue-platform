<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <header class="sticky top-0 z-40 bg-white/95 border-b border-[#E8E0D5]" style="padding-top:env(safe-area-inset-top)">
      <view class="flex items-center justify-between px-4 h-14">
        <view @click="goBack" class="p-2 -ml-2">
          <text class="text-xl text-[#2C2C2C]">←</text>
        </view>
        <text class="font-semibold text-base text-[#2C2C2C]">我的投稿</text>
        <view class="w-9" />
      </view>
    </header>

    <!-- 筛选Tab -->
    <view class="sticky top-14 z-30 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center px-4 py-2 gap-2" style="overflow-x:auto;white-space:nowrap">
        <view v-for="tab in filterTabs" :key="tab.id" @click="activeFilter=tab.id" hover-class="hover-tab" :class="'flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium transition-colors ' + (activeFilter===tab.id ? 'bg-[#C41E3A] text-white' : 'bg-[#F5F1EB] text-[#999]')">
          <text>{{tab.label}}</text>
          <text :class="'text-xs ' + (activeFilter===tab.id ? 'text-white/80' : 'text-[#999]')">{{getCount(tab.id)}}</text>
        </view>
      </view>
    </view>

    <!-- 投稿列表 -->
    <view class="p-4 space-y-3">
      <view v-if="filteredSubmissions.length>0">
        <view v-for="submission in filteredSubmissions" :key="submission.id" class="bg-white rounded-xl overflow-hidden">
          <view class="flex gap-3 p-3">
            <!-- 封面缩略图 -->
            <view class="w-20 h-20 rounded-lg flex items-center justify-center" style="flex-shrink:0;background-color:#F5F1EB">
              <text class="text-2xl text-[#999]/40">📄</text>
            </view>

            <!-- 内容区 -->
            <view class="flex-1" style="min-width:0">
              <text class="font-medium text-sm text-[#2C2C2C]" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.3">{{submission.title}}</text>

              <view class="flex items-center gap-2 mt-1.5">
                <text :class="'text-[10px] px-1.5 py-0.5 rounded-full border ' + statusConfig[submission.status].colorClass">
                  {{getStatusIcon(submission.status)}} {{statusConfig[submission.status].label}}
                </text>
                <text class="text-[10px] text-[#999]">{{submission.submitTime}}</text>
              </view>

              <!-- 状态说明 -->
              <view v-if="submission.status==='approved'" class="flex items-center gap-3 mt-1.5">
                <text class="text-[10px] text-green-500">{{statusConfig.approved.description}}</text>
                <text v-if="submission.views" class="text-[10px] text-[#999]">{{submission.views}}阅读 · {{submission.likes}}点赞</text>
              </view>
              <text v-if="submission.status==='pending'" class="text-[10px] text-amber-500 mt-1.5" style="display:block">{{statusConfig.pending.description}}</text>
              <text v-if="submission.status==='rejected' && submission.reason" class="text-[10px] text-red-500 mt-1.5" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">原因：{{submission.reason}}</text>
            </view>
          </view>

          <!-- 未通过的操作按钮 -->
          <view v-if="submission.status==='rejected'" class="px-3 pb-3">
            <view @click="navigateTo('/pages/publish/index?draft='+submission.id)" class="flex items-center justify-center gap-1.5 w-full py-2 rounded-lg text-sm font-medium text-[#2C2C2C]" style="background-color:#F5F1EB" hover-class="hover-secondary-bg">
              <text class="text-sm">✏</text>
              <text>重新编辑</text>
            </view>
          </view>

          <!-- 已通过的查看入口 -->
          <view v-if="submission.status==='approved'" @click="navigateTo('/pages/article/'+submission.id+'/index')" class="flex items-center justify-between px-3 py-2 border-t border-[#E8E0D5]" hover-class="hover-secondary-bg-row">
            <text class="text-xs text-[#999]">查看文章</text>
            <text class="text-sm text-[#999]">›</text>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view v-else class="flex flex-col items-center justify-center py-20">
        <view class="w-20 h-20 rounded-full flex items-center justify-center mb-4" style="background-color:#F5F1EB">
          <text class="text-2xl text-[#999]/40">📄</text>
        </view>
        <text class="text-[#999] text-sm mb-2">暂无投稿记录</text>
        <text class="text-[#999]/70 text-xs text-center px-8 mb-6" style="display:block">优质文章可推送至首页获取更多曝光，去试试吧</text>
        <view @click="navigateTo('/pages/publish/index')" class="px-6 py-2.5 bg-[#C41E3A] text-white text-sm font-medium rounded-full" hover-class="hover-primary">
          <text>去发布文章</text>
        </view>
      </view>
    </view>

    <!-- 投稿说明 -->
    <view v-if="filteredSubmissions.length>0" class="px-4 pb-8">
      <view class="p-4 rounded-xl" style="background-color:rgba(245,241,235,0.5)">
        <text class="text-sm font-medium text-[#2C2C2C] mb-2" style="display:block">投稿说明</text>
        <view class="space-y-1.5 text-xs text-[#999]">
          <view class="flex items-start gap-2">
            <view class="w-1 h-1 rounded-full mt-1.5" style="flex-shrink:0;background-color:#999" />
            <text>文章审核一般在1-3个工作日内完成</text>
          </view>
          <view class="flex items-start gap-2">
            <view class="w-1 h-1 rounded-full mt-1.5" style="flex-shrink:0;background-color:#999" />
            <text>审核通过的文章将推荐至首页，获得更多曝光</text>
          </view>
          <view class="flex items-start gap-2">
            <view class="w-1 h-1 rounded-full mt-1.5" style="flex-shrink:0;background-color:#999" />
            <text>未通过的文章可根据建议修改后重新提交</text>
          </view>
          <view class="flex items-start gap-2">
            <view class="w-1 h-1 rounded-full mt-1.5" style="flex-shrink:0;background-color:#999" />
            <text>原创优质内容更容易获得推荐</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

const submissionsData = [
  { id: 1, title: "八字命理中的十神详解：从入门到精通", cover: "", submitTime: "2024-01-15 14:30", status: "pending", reviewTime: null, reason: null },
  { id: 2, title: "紫微斗数与八字命理的异同分析", cover: "", submitTime: "2024-01-14 10:20", status: "approved", reviewTime: "2024-01-14 16:45", reason: null, views: 1280, likes: 156 },
  { id: 3, title: "风水入门：家居布局的基本原则", cover: "", submitTime: "2024-01-13 09:15", status: "rejected", reviewTime: "2024-01-13 15:30", reason: "内容过于简短，建议补充深度分析和实际案例" },
  { id: 4, title: "论命理学在现代生活中的应用", cover: "", submitTime: "2024-01-12 16:00", status: "approved", reviewTime: "2024-01-12 20:10", reason: null, views: 2560, likes: 328 },
  { id: 5, title: "八字看婚姻：如何分析感情运势", cover: "", submitTime: "2024-01-11 11:30", status: "rejected", reviewTime: "2024-01-11 17:00", reason: "标题与内容不符，请修改后重新提交" },
]

const statusConfig: Record<string, any> = {
  pending: { label: "审核中", colorClass: "bg-amber-500/10 text-amber-500 border-amber-500/20", description: "预计1-3个工作日内完成审核" },
  approved: { label: "已通过", colorClass: "bg-green-500/10 text-green-500 border-green-500/20", description: "已推荐至首页" },
  rejected: { label: "未通过", colorClass: "bg-red-500/10 text-red-500 border-red-500/20", description: null },
}

const filterTabs = [
  { id: "all", label: "全部" },
  { id: "pending", label: "审核中" },
  { id: "approved", label: "已通过" },
  { id: "rejected", label: "未通过" },
]

const activeFilter = ref("all")

const filteredSubmissions = computed(() => {
  if (activeFilter.value === "all") return submissionsData
  return submissionsData.filter(s => s.status === activeFilter.value)
})

function getCount(status: string) {
  if (status === "all") return submissionsData.length
  return submissionsData.filter(s => s.status === status).length
}

function getStatusIcon(status: string) {
  switch (status) {
    case 'pending': return '🕐'
    case 'approved': return '✓'
    case 'rejected': return '⚠'
    default: return ''
  }
}

function navigateTo(url: string) {
  uni.navigateTo({ url })
}

function goBack() {
  uni.navigateBack()
}
</script>

<style scoped>
.hover-primary { opacity: 0.9; }
.hover-tab { opacity: 0.8; }
.hover-secondary-bg { background-color: #E8E0D5; }
.hover-secondary-bg-row { background-color: rgba(245, 241, 235, 0.5); }
</style>
