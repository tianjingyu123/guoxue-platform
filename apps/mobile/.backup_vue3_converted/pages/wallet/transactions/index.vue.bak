<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- 顶部导航 -->
    <view class="flex items-center justify-between px-4 h-12 bg-white border-b border-[#E8E0D5] flex-shrink-0">
      <view class="p-1" @click="goBack"><text class="text-xl text-[#2C2C2C]">←</text></view>
      <text class="text-base font-semibold text-[#2C2C2C]">交易记录</text>
      <view class="w-7" />
    </view>

    <!-- 筛选Tab -->
    <view class="flex gap-2 px-4 py-3 bg-white border-b border-[#E8E0D5]">
      <view v-for="t in TABS" :key="t.k" :class="['px-4 py-1.5 rounded-full text-sm transition-colors', tab===t.k ? 'bg-[#C41E3A] text-white shadow-sm' : 'bg-[#F5F1EB] text-[#666]']" @click="switchTab(t.k)">{{ t.v }}</view>
      <view class="ml-auto flex items-center gap-1 text-xs text-[#999] px-2 py-1.5 bg-[#F5F1EB] rounded-full active:bg-[#E8E0D5]" @click="showFilter = true">
        <text>📊</text>
        <text>筛选</text>
      </view>
    </view>

    <!-- 加载骨架 -->
    <view v-if="loading" class="p-4 animate-pulse">
      <view v-for="i in 6" :key="i" class="flex items-center gap-2.5 bg-white rounded-xl p-3.5 mb-2 border border-[#E8E0D5]">
        <view class="w-9 h-9 rounded-full bg-[#E8E0D5]" />
        <view class="flex-1 flex flex-col gap-1.5">
          <view class="h-3.5 bg-[#E8E0D5] rounded w-3/5" />
          <view class="h-3.5 bg-[#E8E0D5] rounded w-2/5" />
        </view>
        <view class="h-3.5 bg-[#E8E0D5] rounded w-1/5" />
      </view>
    </view>

    <!-- 空状态 -->
    <view v-else-if="!loading && list.length===0" class="flex-1 flex flex-col items-center justify-center py-20">
      <view class="w-20 h-20 rounded-full bg-[#F5F1EB] flex items-center justify-center mb-4">
        <text class="text-4xl opacity-40">📋</text>
      </view>
      <text class="text-sm font-medium text-[#2C2C2C] mb-1">暂无交易记录</text>
      <text class="text-xs text-[#999] text-center max-w-xs">交易记录将在您进行充值、购买、提现等操作后显示</text>
    </view>

    <!-- 列表 -->
    <scroll-view v-else scroll-y class="flex-1 px-4 overflow-y-auto" refresher-enabled @refresherrefresh="refreshData" :refresher-triggered="refreshing">
      <!-- 统计摘要 -->
      <view class="flex items-center justify-between bg-white rounded-2xl p-3.5 mb-3 mt-3 shadow-sm border border-[#E8E0D5]">
        <view class="flex items-center gap-1 text-xs text-[#999]">
          <text>共 {{ list.length }} 笔</text>
          <text>· 收入 ¥{{ incomeTotal }}</text>
          <text>· 支出 ¥{{ expenseTotal }}</text>
        </view>
        <text :class="'text-xs font-medium '+(netTotal>=0?'text-green-500':'text-[#C41E3A]')">{{ tab==='income' ? '收入' : tab==='expense' ? '支出' : '净收入' }}: ¥{{ netTotal }}</text>
      </view>

      <view v-for="(group, date) in grouped" :key="date">
        <text class="text-xs text-[#999] px-1.5 pt-2 pb-1.5 block font-medium bg-[#FAF8F5]">{{ date }}</text>
        <view v-for="item in group" :key="item.id" class="flex items-center gap-3 bg-white rounded-2xl p-3.5 mb-2 shadow-sm border border-[#E8E0D5] active:bg-[#FAF8F5]">
          <view :class="['w-10 h-10 rounded-full flex items-center justify-center text-lg font-bold flex-shrink-0', item.type==='income' ? 'bg-green-50 text-green-500' : 'bg-red-50 text-red-500']">
            <text>{{ item.type==='income'?'↓':'↑' }}</text>
          </view>
          <view class="flex-1 min-w-0">
            <view class="flex items-center gap-2">
              <text class="text-sm font-medium text-[#2C2C2C]">{{ item.title }}</text>
              <text v-if="item.status==='pending'" class="px-1.5 py-0.5 bg-amber-50 text-amber-600 text-[10px] rounded-full">处理中</text>
              <text v-if="item.status==='failed'" class="px-1.5 py-0.5 bg-red-50 text-red-500 text-[10px] rounded-full">失败</text>
            </view>
            <view class="flex items-center gap-2 text-[11px] text-[#999] mt-0.5">
              <text>{{ item.time }}</text>
              <text>·</text>
              <text>{{ item.statusLabel }}</text>
            </view>
          </view>
          <view class="text-right shrink-0">
            <text :class="['text-base font-semibold', item.type==='income' ? 'text-green-500' : 'text-[#2C2C2C]']">{{ item.type==='income'?'+':'-' }}¥{{ item.amount }}</text>
            <text v-if="item.balance" class="text-[10px] text-[#999] block mt-0.5">余额 ¥{{ item.balance }}</text>
          </view>
        </view>
      </view>

      <!-- 加载更多 -->
      <view v-if="hasMore" class="flex items-center justify-center py-4">
        <view class="px-6 py-2 rounded-full bg-white border border-[#E8E0D5] text-sm text-[#999] active:bg-[#F5F1EB]" @click="loadMore">
          <text>加载更多</text>
        </view>
      </view>
      <view v-else-if="list.length > 0" class="flex items-center justify-center py-4">
        <view class="flex items-center gap-2 text-xs text-[#999]">
          <view class="w-8 h-px bg-[#E8E0D5]" />
          <text>已显示全部 {{ list.length }} 笔记录</text>
          <view class="w-8 h-px bg-[#E8E0D5]" />
        </view>
      </view>

      <view class="h-6" />
    </scroll-view>

    <!-- 筛选弹窗 -->
    <view v-if="showFilter" class="fixed inset-0 z-50 bg-black/40 flex items-end" @click="showFilter=false">
      <view class="bg-white w-full rounded-t-3xl shadow-xl" @click.stop>
        <view class="flex items-center justify-between px-6 py-4 border-b border-[#E8E0D5]">
          <text class="text-base font-bold text-[#2C2C2C]">📊 筛选条件</text>
          <text class="text-xl text-[#999]" @click="showFilter=false">✕</text>
        </view>
        <view class="p-6">
          <text class="text-sm font-medium text-[#2C2C2C] block mb-3">交易状态</text>
          <view class="flex flex-wrap gap-2 mb-5">
            <view v-for="s in statusFilters" :key="s.key" :class="'px-3.5 py-1.5 rounded-full text-xs transition-colors '+(activeStatus===s.key?'bg-[#C41E3A] text-white shadow-sm':'bg-[#F5F1EB] text-[#666]')" @click="activeStatus=s.key">{{ s.label }}</view>
          </view>
          <text class="text-sm font-medium text-[#2C2C2C] block mb-3">时间范围</text>
          <view class="flex flex-wrap gap-2 mb-6">
            <view v-for="r in timeRanges" :key="r.key" :class="'px-3.5 py-1.5 rounded-full text-xs transition-colors '+(activeRange===r.key?'bg-[#C41E3A] text-white shadow-sm':'bg-[#F5F1EB] text-[#666]')" @click="activeRange=r.key">{{ r.label }}</view>
          </view>
          <view class="flex gap-3">
            <view class="flex-1 h-11 rounded-xl bg-[#F5F1EB] text-[#999] text-sm flex items-center justify-center active:bg-[#E8E0D5]" @click="resetFilter">重置</view>
            <view class="flex-1 h-11 rounded-xl bg-[#C41E3A] text-white text-sm flex items-center justify-center shadow-sm active:bg-[#B01A31]" @click="applyFilter">应用筛选</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

interface TxItem { id: string; title: string; type: string; amount: number; balance?: number; time: string; date: string; status: string; statusLabel: string }

const TABS = [{k:'all',v:'全部'},{k:'income',v:'收入'},{k:'expense',v:'支出'}]
const tab = ref('all')
const loading = ref(true)
const refreshing = ref(false)
const hasMore = ref(true)
const showFilter = ref(false)
const activeStatus = ref('all')
const activeRange = ref('all')
const list = ref<TxItem[]>([])

const statusFilters = ref([{ key: 'all', label: '全部' }, { key: 'done', label: '已完成' }, { key: 'pending', label: '进行中' }, { key: 'failed', label: '失败' }])
const timeRanges = ref([{ key: 'all', label: '全部' }, { key: '7d', label: '近7天' }, { key: '30d', label: '近30天' }, { key: '90d', label: '近90天' }])

const grouped = computed(() => {
  const g: Record<string, TxItem[]> = {}
  list.value.forEach(i => {
    if (!g[i.date]) g[i.date] = []
    g[i.date].push(i)
  })
  return g
})

const incomeTotal = computed(() => list.value.filter(i => i.type === 'income').reduce((s, i) => s + i.amount, 0))
const expenseTotal = computed(() => list.value.filter(i => i.type === 'expense').reduce((s, i) => s + i.amount, 0))
const netTotal = computed(() => tab.value === 'income' ? incomeTotal.value : tab.value === 'expense' ? expenseTotal.value : incomeTotal.value - expenseTotal.value)

function switchTab(k: string) { tab.value = k; loadData() }
function goBack() { uni.navigateBack() }
function resetFilter() {
  activeStatus.value = 'all'
  activeRange.value = 'all'
}
function applyFilter() {
  showFilter.value = false
  loadData()
}

async function loadData() {
  loading.value = true
  await new Promise(r => setTimeout(r, 500))
  const all: TxItem[] = [
    { id:'1', title:'悬赏回答被采纳', type:'income', amount:50, balance: 1250, time:'14:30', date:'2024年01月15日', status:'done', statusLabel:'已完成' },
    { id:'2', title:'国学币充值', type:'income', amount:200, balance: 1200, time:'09:00', date:'2024年01月14日', status:'done', statusLabel:'已完成' },
    { id:'3', title:'购买《渊海子平》', type:'expense', amount:168, balance: 1000, time:'10:15', date:'2024年01月13日', status:'done', statusLabel:'已完成' },
    { id:'4', title:'圈子会员续费', type:'expense', amount:99, balance: 1168, time:'11:00', date:'2024年01月12日', status:'done', statusLabel:'已完成' },
    { id:'5', title:'圈子收益分成', type:'income', amount:128, balance: 1267, time:'08:30', date:'2024年01月12日', status:'done', statusLabel:'已完成' },
    { id:'6', title:'提现到银行卡', type:'expense', amount:500, balance: 1139, time:'16:00', date:'2024年01月10日', status:'pending', statusLabel:'处理中' },
    { id:'7', title:'发布悬赏冻结', type:'expense', amount:30, balance: 1639, time:'15:20', date:'2024年01月09日', status:'done', statusLabel:'已完成' },
    { id:'8', title:'邀请好友奖励', type:'income', amount:20, balance: 1669, time:'12:00', date:'2024年01月08日', status:'done', statusLabel:'已完成' },
    { id:'9', title:'课程购买退款', type:'income', amount:299, balance: 1649, time:'10:00', date:'2024年01月07日', status:'done', statusLabel:'已完成' },
    { id:'10', title:'直播打赏支出', type:'expense', amount:66, balance: 1350, time:'20:00', date:'2024年01月06日', status:'done', statusLabel:'已完成' },
    { id:'11', title:'每日签到奖励', type:'income', amount:5, balance: 1416, time:'07:00', date:'2024年01月05日', status:'done', statusLabel:'已完成' },
    { id:'12', title:'付费咨询收入', type:'income', amount:88, balance: 1411, time:'15:30', date:'2024年01月04日', status:'done', statusLabel:'已完成' },
    { id:'13', title:'购买课程套餐', type:'expense', amount:399, balance: 1323, time:'09:00', date:'2024年01月03日', status:'done', statusLabel:'已完成' },
    { id:'14', title:'发布悬赏冻结', type:'expense', amount:50, balance: 1722, time:'16:00', date:'2024年01月02日', status:'done', statusLabel:'已完成' },
  ]

  let filtered = tab.value === 'all' ? all : all.filter(i => i.type === tab.value)
  if (activeStatus.value !== 'all') {
    filtered = filtered.filter(i => i.status === activeStatus.value)
  }
  if (activeRange.value !== 'all') {
    // Simplified date range filter for demo
  }
  list.value = filtered
  loading.value = false
}

async function refreshData() {
  refreshing.value = true
  await new Promise(r => setTimeout(r, 800))
  await loadData()
  refreshing.value = false
}

async function loadMore() {
  await new Promise(r => setTimeout(r, 600))
  hasMore.value = false
}

loadData()
</script>
<style scoped>
/* 样式由 Tailwind 处理 */
</style>
