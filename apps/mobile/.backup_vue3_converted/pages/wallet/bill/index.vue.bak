<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-24">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-10 text-white px-4 py-3 flex items-center justify-between" style="background:linear-gradient(90deg,#C41E3A,#A01830)">
      <view class="p-1 -ml-1" @click="goBack">
        <text class="text-white text-2xl">←</text>
      </view>
      <text class="font-semibold">账单详情</text>
      <view class="p-1" @click="handleExport">
        <text class="text-white text-lg">⬇️</text>
      </view>
    </view>

    <!-- 周期选择 -->
    <view class="bg-white px-4 py-3 border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between">
        <view class="flex gap-2">
          <view :class="['px-3 py-1 rounded-full text-sm', viewType === 'month' ? 'bg-[#C41E3A] text-white' : 'bg-[#FAF8F5] text-[#666]']" @click="viewType = 'month'">
            <text>月账单</text>
          </view>
          <view :class="['px-3 py-1 rounded-full text-sm', viewType === 'year' ? 'bg-[#C41E3A] text-white' : 'bg-[#FAF8F5] text-[#666]']" @click="viewType = 'year'">
            <text>年账单</text>
          </view>
        </view>
        <view class="flex items-center gap-2">
          <view @click="handlePrevPeriod" class="p-1">
            <text class="text-lg text-[#666]">‹</text>
          </view>
          <text class="text-[#2C2C2C] font-medium min-w-[100px] text-center">{{ formatPeriod }}</text>
          <view @click="handleNextPeriod" class="p-1">
            <text class="text-lg text-[#666]">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载态 -->
    <view v-if="loading" class="p-4 space-y-4">
      <view class="bg-white rounded-2xl p-6 h-64 animate-pulse" />
      <view class="bg-white rounded-2xl p-4 h-40 animate-pulse" />
    </view>

    <!-- 账单内容 -->
    <block v-if="!loading && bill">
      <!-- 收支概览 -->
      <view class="p-4">
        <view class="bg-white rounded-2xl p-6 shadow-sm">
          <view class="flex items-center justify-between">
            <!-- 圆环图 (SVG) -->
            <view class="relative w-32 h-32">
              <svg class="w-full h-full" style="transform:rotate(-90deg)" viewBox="0 0 128 128">
                <circle cx="64" cy="64" r="45" fill="none" stroke="#E8E0D5" stroke-width="12" />
                <circle cx="64" cy="64" r="45" fill="none" stroke="#4CAF50" stroke-width="12"
                  :stroke-dasharray="circumference"
                  :stroke-dashoffset="circumference * (1 - incomePercent / 100)"
                  stroke-linecap="round" />
                <circle cx="64" cy="64" r="45" fill="none" stroke="#C41E3A" stroke-width="12"
                  :stroke-dasharray="circumference"
                  :stroke-dashoffset="circumference * incomePercent / 100"
                  stroke-linecap="round" />
              </svg>
              <view class="absolute inset-0 flex flex-col items-center justify-center">
                <text class="text-xs text-[#999]">结余</text>
                <text :class="['text-lg font-bold', bill.balance >= 0 ? 'text-green-500' : 'text-[#C41E3A]']">{{ bill.balance >= 0 ? '+' : '' }}{{ bill.balance }}</text>
              </view>
            </view>

            <!-- 收支数据 -->
            <view class="flex-1 ml-6 space-y-4">
              <view class="flex items-center justify-between">
                <view class="flex items-center gap-2">
                  <view class="w-3 h-3 rounded-full bg-green-500" />
                  <text class="text-[#666] text-sm">收入</text>
                </view>
                <text class="text-green-500 font-semibold">+{{ bill.totalIncome.toFixed(2) }}</text>
              </view>
              <view class="flex items-center justify-between">
                <view class="flex items-center gap-2">
                  <view class="w-3 h-3 rounded-full bg-[#C41E3A]" />
                  <text class="text-[#666] text-sm">支出</text>
                </view>
                <text class="text-[#C41E3A] font-semibold">-{{ bill.totalExpense.toFixed(2) }}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 支出分类 -->
      <view v-if="expenseCategories.length > 0" class="px-4 mb-4">
        <view class="bg-white rounded-2xl overflow-hidden shadow-sm">
          <view class="px-4 py-3 border-b border-[#E8E0D5]">
            <text class="font-semibold text-[#2C2C2C]">支出分类</text>
          </view>
          <view v-for="(cat, index) in expenseCategories" :key="cat.category" :class="index !== expenseCategories.length - 1 ? 'border-b border-[#E8E0D5]' : ''">
            <view class="w-full px-4 py-3 flex items-center justify-between" @click="toggleCategory(cat.category)">
              <view class="flex items-center gap-3">
                <view class="w-10 h-10 rounded-full flex items-center justify-center" :style="{ backgroundColor: cat.color + '20' }">
                  <text :style="{ color: cat.color }" class="text-lg">{{ iconMap[cat.icon] || '🛍️' }}</text>
                </view>
                <view>
                  <text class="text-[#2C2C2C] font-medium block">{{ cat.name }}</text>
                  <text class="text-xs text-[#999] block">{{ cat.count }}笔交易</text>
                </view>
              </view>
              <view class="flex items-center gap-2">
                <view class="text-right">
                  <text :class="['font-semibold', cat.type === 'income' ? 'text-green-500' : 'text-[#2C2C2C]']">{{ cat.type === 'income' ? '+' : '-' }}{{ cat.amount.toFixed(2) }}</text>
                  <text class="text-xs text-[#999] block">占比{{ cat.percent }}%</text>
                </view>
                <text class="text-[#999] text-sm">{{ expandedCategories.includes(cat.category) ? '▲' : '▼' }}</text>
              </view>
            </view>
            <!-- 展开子项 -->
            <view v-if="expandedCategories.includes(cat.category)" class="bg-[#FAF8F5] px-4 py-2">
              <view v-for="(item, idx) in cat.items" :key="item.id" :class="['py-2 flex items-center justify-between', idx !== cat.items.length - 1 ? 'border-b border-[#E8E0D5]' : '']">
                <view>
                  <text class="text-sm text-[#2C2C2C] block">{{ item.title }}</text>
                  <text class="text-xs text-[#999] block">{{ item.createdAt }}</text>
                </view>
                <text :class="['text-sm font-medium', cat.type === 'income' ? 'text-green-500' : 'text-[#2C2C2C]']">{{ cat.type === 'income' ? '+' : '-' }}{{ item.amount.toFixed(2) }}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 收入分类 -->
      <view v-if="incomeCategories.length > 0" class="px-4 mb-4">
        <view class="bg-white rounded-2xl overflow-hidden shadow-sm">
          <view class="px-4 py-3 border-b border-[#E8E0D5]">
            <text class="font-semibold text-[#2C2C2C]">收入分类</text>
          </view>
          <view v-for="(cat, index) in incomeCategories" :key="cat.category" :class="index !== incomeCategories.length - 1 ? 'border-b border-[#E8E0D5]' : ''">
            <view class="w-full px-4 py-3 flex items-center justify-between" @click="toggleCategory(cat.category)">
              <view class="flex items-center gap-3">
                <view class="w-10 h-10 rounded-full flex items-center justify-center" :style="{ backgroundColor: cat.color + '20' }">
                  <text :style="{ color: cat.color }" class="text-lg">{{ iconMap[cat.icon] || '🛍️' }}</text>
                </view>
                <view>
                  <text class="text-[#2C2C2C] font-medium block">{{ cat.name }}</text>
                  <text class="text-xs text-[#999] block">{{ cat.count }}笔交易</text>
                </view>
              </view>
              <view class="flex items-center gap-2">
                <view class="text-right">
                  <text :class="['font-semibold', cat.type === 'income' ? 'text-green-500' : 'text-[#2C2C2C]']">{{ cat.type === 'income' ? '+' : '-' }}{{ cat.amount.toFixed(2) }}</text>
                  <text class="text-xs text-[#999] block">占比{{ cat.percent }}%</text>
                </view>
                <text class="text-[#999] text-sm">{{ expandedCategories.includes(cat.category) ? '▲' : '▼' }}</text>
              </view>
            </view>
            <!-- 展开子项 -->
            <view v-if="expandedCategories.includes(cat.category)" class="bg-[#FAF8F5] px-4 py-2">
              <view v-for="(item, idx) in cat.items" :key="item.id" :class="['py-2 flex items-center justify-between', idx !== cat.items.length - 1 ? 'border-b border-[#E8E0D5]' : '']">
                <view>
                  <text class="text-sm text-[#2C2C2C] block">{{ item.title }}</text>
                  <text class="text-xs text-[#999] block">{{ item.createdAt }}</text>
                </view>
                <text :class="['text-sm font-medium', cat.type === 'income' ? 'text-green-500' : 'text-[#2C2C2C]']">{{ cat.type === 'income' ? '+' : '-' }}{{ item.amount.toFixed(2) }}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- 底部导出按钮 -->
    <view class="fixed bottom-0 left-0 right-0 bg-white border-t border-[#E8E0D5] p-4">
      <view class="w-full h-12 rounded-xl bg-[#C41E3A] text-white flex items-center justify-center gap-2 font-medium" @click="handleExport">
        <text>⬇️</text>
        <text>{{ exporting ? '导出中...' : '导出账单PDF' }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

interface BillItem {
  id: string; title: string; amount: number; createdAt: string
}

interface BillCategory {
  category: string; name: string; icon: string; color: string; amount: number; percent: number; type: 'income' | 'expense'; count: number; items: BillItem[]
}

interface BillSummary {
  period: string; periodType: string; totalIncome: number; totalExpense: number; balance: number; categories: BillCategory[]
}

const mockBill: BillSummary = {
  period: '2024-01', periodType: 'month', totalIncome: 2580, totalExpense: 1890, balance: 690,
  categories: [
    { category: 'course', name: '课程学习', icon: 'BookOpen', color: '#C41E3A', amount: 680, percent: 36, type: 'expense', count: 3, items: [
      { id: '1', title: '周易六十四卦详解', amount: 298, createdAt: '2024-01-15 14:30' },
      { id: '2', title: '紫微斗数入门到精通', amount: 198, createdAt: '2024-01-12 10:20' },
      { id: '3', title: '奇门遁甲实战课程', amount: 184, createdAt: '2024-01-08 16:45' },
    ]},
    { category: 'shopping', name: '商品购物', icon: 'ShoppingBag', color: '#E85D04', amount: 520, percent: 28, type: 'expense', count: 2, items: [
      { id: '4', title: '罗盘专业版', amount: 320, createdAt: '2024-01-20 09:15' },
      { id: '5', title: '风水入门书籍套装', amount: 200, createdAt: '2024-01-05 11:30' },
    ]},
    { category: 'group', name: '拼团活动', icon: 'Users', color: '#2196F3', amount: 380, percent: 20, type: 'expense', count: 2, items: [
      { id: '6', title: '八字命理精讲(拼团)', amount: 199, createdAt: '2024-01-18 20:00' },
      { id: '7', title: '梅花易数入门(拼团)', amount: 181, createdAt: '2024-01-10 15:30' },
    ]},
    { category: 'recharge', name: '充值', icon: 'CreditCard', color: '#4CAF50', amount: 2000, percent: 78, type: 'income', count: 2, items: [
      { id: '8', title: '学习币充值', amount: 1000, createdAt: '2024-01-01 10:00' },
      { id: '9', title: '学习币充值', amount: 1000, createdAt: '2024-01-15 10:00' },
    ]},
    { category: 'reward', name: '奖励收入', icon: 'Gift', color: '#C9A96E', amount: 580, percent: 22, type: 'income', count: 5, items: [
      { id: '10', title: '邀请好友奖励', amount: 200, createdAt: '2024-01-22 12:00' },
      { id: '11', title: '签到奖励', amount: 100, createdAt: '2024-01-20 08:00' },
      { id: '12', title: '创作收益', amount: 280, createdAt: '2024-01-18 16:00' },
    ]},
  ],
}

const iconMap: Record<string, string> = {
  ShoppingBag: '🛍️', BookOpen: '📚', Users: '👥', CreditCard: '💳', ArrowUpRight: '↗️', Gift: '🎁',
}

const loading = ref(true)
const bill = ref<BillSummary | null>(null)
const currentDate = ref(new Date())
const viewType = ref<'month' | 'year'>('month')
const expandedCategories = ref<string[]>([])
const exporting = ref(false)

const formatPeriod = computed(() => {
  const d = currentDate.value
  if (viewType.value === 'month') return d.getFullYear() + '年' + (d.getMonth() + 1) + '月'
  return d.getFullYear() + '年'
})

const periodStr = computed(() => {
  const d = currentDate.value
  if (viewType.value === 'month') return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0')
  return String(d.getFullYear())
})

const incomeCategories = computed(() => bill.value?.categories.filter(c => c.type === 'income') || [])
const expenseCategories = computed(() => bill.value?.categories.filter(c => c.type === 'expense') || [])

const total = computed(() => (bill.value?.totalIncome || 0) + (bill.value?.totalExpense || 0))
const incomePercent = computed(() => total.value > 0 ? ((bill.value?.totalIncome || 0) / total.value) * 100 : 50)
const circumference = computed(() => 2 * Math.PI * 45)

onMounted(() => {
  loadBill()
})

function loadBill() {
  loading.value = true
  setTimeout(() => {
    bill.value = { ...mockBill, period: periodStr.value }
    loading.value = false
  }, 500)
}

function handlePrevPeriod() {
  const d = new Date(currentDate.value)
  if (viewType.value === 'month') d.setMonth(d.getMonth() - 1)
  else d.setFullYear(d.getFullYear() - 1)
  currentDate.value = d
  loadBill()
}

function handleNextPeriod() {
  const d = new Date(currentDate.value)
  if (viewType.value === 'month') d.setMonth(d.getMonth() + 1)
  else d.setFullYear(d.getFullYear() + 1)
  if (d <= new Date()) {
    currentDate.value = d
    loadBill()
  }
}

function toggleCategory(category: string) {
  const idx = expandedCategories.value.indexOf(category)
  if (idx >= 0) expandedCategories.value.splice(idx, 1)
  else expandedCategories.value.push(category)
}

function handleExport() {
  exporting.value = true
  setTimeout(() => {
    exporting.value = false
    uni.showToast({ title: '账单导出成功', icon: 'success' })
  }, 1000)
}

function goBack() { uni.navigateBack() }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
