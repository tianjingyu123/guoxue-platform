<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-20">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-50 bg-[#FAF8F5] border-b border-[#E8E0D5]" style="padding-top: var(--status-bar-height);">
      <view class="flex items-center px-4 h-12">
        <view @click="goTo('/pages/index/index')" class="p-1 mr-3">
          <text class="text-[#2C2C2C] text-lg">←</text>
        </view>
        <text class="font-medium text-[#2C2C2C]">平台公告</text>
      </view>
    </view>

    <!-- 分类筛选 -->
    <view class="sticky top-12 z-40 bg-[#FAF8F5] border-b border-[#E8E0D5]">
      <scroll-view scroll-x show-scrollbar="false" class="px-4 py-2">
        <view class="flex gap-2">
          <view
            v-for="type in announcementTypes"
            :key="type.id"
            @click="activeType = type.id"
            :class="['flex-shrink-0 px-3 py-1.5 rounded-full text-sm font-medium transition-colors', activeType === type.id ? 'bg-[#C41E3A] text-white' : 'bg-[#F5F1EB] text-[#999]']"
          >
            <text>{{ type.label }}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 公告列表 -->
    <view class="px-4 py-4 space-y-3">
      <!-- 置顶公告 -->
      <view v-if="topAnnouncements.length > 0" class="space-y-3">
        <view
          v-for="item in topAnnouncements"
          :key="item.id"
          class="p-4 rounded-xl border border-primary/30 bg-[#C41E3A]/5"
          @click="goTo('/pages/announcements/' + item.id + '/index')"
        >
          <view class="flex items-start gap-3">
            <view :class="['w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0', getTypeBg(item.type)]">
              <text :class="['w-5 h-5', getTypeColor(item.type)]">{{ getTypeIcon(item.type) }}</text>
            </view>
            <view class="flex-1 min-w-0">
              <view class="flex items-center gap-2">
                <view v-if="item.isTop" class="bg-red-500 text-white text-[10px] px-1.5 rounded">
                  <text>置顶</text>
                </view>
                <view v-if="item.isNew" class="bg-[#C41E3A] text-white text-[10px] px-1.5 rounded">
                  <text>NEW</text>
                </view>
              </view>
              <text class="font-medium mt-1 block">{{ item.title }}</text>
              <text class="text-xs text-[#999] mt-1 line-clamp-2 block">{{ item.summary }}</text>
              <view class="flex items-center justify-between mt-2">
                <text class="text-[10px] text-[#999] flex items-center gap-1">🕐 {{ item.time }}</text>
                <text class="text-[#999]">→</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 普通公告 -->
      <view v-if="normalAnnouncements.length > 0" class="space-y-3">
        <view
          v-for="item in normalAnnouncements"
          :key="item.id"
          class="p-4 rounded-xl border border-[#E8E0D5] bg-white"
          @click="goTo('/pages/announcements/' + item.id + '/index')"
        >
          <view class="flex items-start gap-3">
            <view :class="['w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0', getTypeBg(item.type)]">
              <text :class="['w-5 h-5', getTypeColor(item.type)]">{{ getTypeIcon(item.type) }}</text>
            </view>
            <view class="flex-1 min-w-0">
              <view class="flex items-center gap-2">
                <view v-if="item.isNew" class="bg-[#C41E3A] text-white text-[10px] px-1.5 rounded">
                  <text>NEW</text>
                </view>
              </view>
              <text class="text-sm font-medium text-[#2C2C2C] mt-1 block">{{ item.title }}</text>
              <text class="text-xs text-[#999] mt-1 line-clamp-2 block">{{ item.summary }}</text>
              <view class="flex items-center justify-between mt-2">
                <text class="text-[10px] text-[#999] flex items-center gap-1">🕐 {{ item.time }}</text>
                <text class="text-[#999]">→</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view v-if="filteredAnnouncements.length === 0" class="flex flex-col items-center justify-center py-20">
        <text class="text-4xl mb-4">📋</text>
        <text class="text-sm text-[#999]">暂无公告</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

// 导航辅助
function goBack() { uni.navigateBack() }
function goTo(url: string) { uni.navigateTo({ url }) }

// Mock 数据
const announcementTypes = [
  { id: "all", label: "全部" },
  { id: "notice", label: "平台通知" },
  { id: "activity", label: "活动公告" },
  { id: "update", label: "功能更新" },
  { id: "important", label: "重要公告" },
]

const announcements = [
  {
    id: 1, type: "important",
    title: "关于平台服务升级的通知",
    summary: "为提升用户体验，平台将于4月20日凌晨2:00-6:00进行系统升级维护，届时部分功能将暂停使用。",
    time: "2024-03-18", isTop: true, isNew: true,
  },
  {
    id: 2, type: "activity",
    title: "2024春季国学文化节活动开启",
    summary: "春暖花开，热卜国学平台联合多位名师举办春季国学文化节，精彩课程限时优惠，更有神秘大奖等你来拿！",
    time: "2024-03-15", isTop: true, isNew: true,
  },
  {
    id: 3, type: "update",
    title: "新功能上线：研究院正式开放申请",
    summary: "研究院是平台知识分享和学术交流的核心组织，现面向全体圈主开放申请，快来加入我们！",
    time: "2024-03-12", isTop: false, isNew: false,
  },
  {
    id: 4, type: "notice",
    title: "关于加强内容审核的说明",
    summary: "为维护平台良好的学习氛围，我们将进一步加强对平台内容的审核，请各位圈主和创作者遵守平台规范。",
    time: "2024-03-10", isTop: false, isNew: false,
  },
  {
    id: 5, type: "activity",
    title: "分站招募计划正式启动",
    summary: "成为热卜国学分站站长，享受专属权益和分佣收益，首批站长限时优惠中！",
    time: "2024-03-05", isTop: false, isNew: false,
  },
  {
    id: 6, type: "update",
    title: "APP新版本2.0发布",
    summary: "全新设计界面，优化课程播放体验，新增AI排盘助手功能，快来体验吧！",
    time: "2024-02-28", isTop: false, isNew: false,
  },
  {
    id: 7, type: "notice",
    title: "关于调整圈子管理规则的通知",
    summary: "为促进圈子健康发展，平台对圈子管理规则进行了部分调整，请各位圈主仔细阅读。",
    time: "2024-02-20", isTop: false, isNew: false,
  },
]

// 组件逻辑
const activeType = ref("all")

const filteredAnnouncements = computed(() =>
  activeType.value === "all"
    ? announcements
    : announcements.filter(a => a.type === activeType.value)
)

const topAnnouncements = computed(() =>
  filteredAnnouncements.value.filter(a => a.isTop)
)

const normalAnnouncements = computed(() =>
  filteredAnnouncements.value.filter(a => !a.isTop)
)

function getTypeIcon(type: string) {
  const icons: Record<string, string> = {
    notice: '🔔', activity: '🎁', update: '🔧', important: '⚠️'
  }
  return icons[type] || '📋'
}

function getTypeColor(type: string) {
  const colors: Record<string, string> = {
    notice: 'text-blue-500', activity: 'text-pink-500', update: 'text-green-500', important: 'text-red-500'
  }
  return colors[type] || 'text-[#999]'
}

function getTypeBg(type: string) {
  const bgs: Record<string, string> = {
    notice: 'bg-blue-500/10', activity: 'bg-pink-500/10', update: 'bg-green-500/10', important: 'bg-red-500/10'
  }
  return bgs[type] || 'bg-[#F5F1EB]'
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
