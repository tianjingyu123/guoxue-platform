  { label: '工作台', icon: '🏪', path: 'dashboard' },
  { label: '商品管理', icon: '📦', path: 'products' },
  { label: '订单管理', icon: '📋', path: 'orders' },
  { label: '营收分析', icon: '📊', path: 'revenue' },
  { label: '评价管理', icon: '⭐', path: 'reviews' },
  { label: '内容统计', icon: '📄', path: 'content-stats' },
