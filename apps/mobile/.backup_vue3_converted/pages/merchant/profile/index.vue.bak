  <view class="min-h-screen bg-[#FAF8F5] pb-32">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-50 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between h-14 px-4">
        <view class="flex items-center gap-3">
          <view @click="goBack" class="p-1">
            <text class="text-xl text-[#2C2C2C]">←</text>
          </view>
          <text class="text-lg font-semibold">店铺设置</text>
        </view>
        <view @click="goPreview" class="flex items-center gap-1 text-sm text-[#999]">
          <text>👁️</text>
          <text>预览</text>
        </view>
      </view>
    </view>

    <scroll-view scroll-y class="flex-1 p-4 space-y-4">
      <!-- 店铺Logo -->
      <view class="bg-white rounded-2xl p-4">
        <text class="font-medium mb-4 block">店铺形象</text>
        <view class="flex items-center gap-4">
          <view class="relative">
            <view class="w-20 h-20 rounded-xl bg-[#FAF8F5] flex items-center justify-center overflow-hidden">
              <text class="text-3xl">🏪</text>
            </view>
            <view class="absolute -bottom-1 -right-1 w-7 h-7 rounded-full bg-[#C41E3A] text-white flex items-center justify-center shadow-lg">
              <text class="text-sm">📷</text>
            </view>
          </view>
          <view class="flex-1">
            <text class="text-sm font-medium block">店铺Logo</text>
            <text class="text-xs text-[#999] mt-1">建议尺寸200x200px，支持JPG、PNG格式</text>
          </view>
        </view>
      </view>

      <!-- 基本信息 -->
      <view class="bg-white rounded-2xl p-4 space-y-4">
        <text class="font-medium">基本信息</text>

        <view class="space-y-2">
          <text class="text-sm font-medium">店铺名称</text>
          <input v-model="formData.name" placeholder="请输入店铺名称" maxlength="20" class="w-full px-3 py-2.5 bg-[#FAF8F5] rounded-xl text-sm" />
        </view>

        <view class="space-y-2">
          <text class="text-sm font-medium">店铺口号</text>
          <input v-model="formData.slogan" placeholder="一句话介绍您的店铺" maxlength="30" class="w-full px-3 py-2.5 bg-[#FAF8F5] rounded-xl text-sm" />
        </view>

        <view class="space-y-2">
          <text class="text-sm font-medium">店铺简介</text>
          <textarea v-model="formData.description" placeholder="详细介绍您的店铺" rows="4" class="w-full px-3 py-2.5 bg-[#FAF8F5] rounded-xl text-sm" />
        </view>
      </view>

      <!-- 联系方式 -->
      <view class="bg-white rounded-2xl p-4 space-y-4">
        <text class="font-medium">联系方式</text>

        <view class="space-y-2">
          <text class="text-sm font-medium flex items-center gap-2">
            <text>📞</text>
            联系电话
          </text>
          <input v-model="formData.phone" placeholder="请输入联系电话" class="w-full px-3 py-2.5 bg-[#FAF8F5] rounded-xl text-sm" />
        </view>

        <view class="space-y-2">
          <text class="text-sm font-medium flex items-center gap-2">
            <text>📍</text>
            店铺地址
          </text>
          <input v-model="formData.address" placeholder="请输入店铺地址（选填）" class="w-full px-3 py-2.5 bg-[#FAF8F5] rounded-xl text-sm" />
        </view>

        <view class="space-y-2">
          <text class="text-sm font-medium flex items-center gap-2">
            <text>🕐</text>
            营业时间
          </text>
          <input v-model="formData.businessHours" placeholder="例如: 09:00-21:00" class="w-full px-3 py-2.5 bg-[#FAF8F5] rounded-xl text-sm" />
        </view>
      </view>

      <!-- 营业设置 -->
      <view class="bg-white rounded-2xl p-4 space-y-4">
        <text class="font-medium">营业设置</text>

        <view class="flex items-center justify-between">
          <view>
            <text class="text-sm font-medium block">店铺营业状态</text>
            <text class="text-xs text-[#999] mt-0.5">关闭后买家将无法下单</text>
          </view>
          <switch :checked="formData.isOpen" @change="formData.isOpen = !formData.isOpen" color="#C41E3A" />
        </view>

        <view class="flex items-center justify-between">
          <view>
            <text class="text-sm font-medium block">自动回复</text>
            <text class="text-xs text-[#999] mt-0.5">买家首次咨询时自动回复</text>
          </view>
          <switch :checked="formData.autoReply" @change="formData.autoReply = !formData.autoReply" color="#C41E3A" />
        </view>

        <view v-if="formData.autoReply" class="space-y-2">
          <text class="text-sm font-medium">自动回复内容</text>
          <textarea v-model="formData.autoReplyContent" placeholder="请输入自动回复内容" rows="3" class="w-full px-3 py-2.5 bg-[#FAF8F5] rounded-xl text-sm" />
        </view>
      </view>

      <!-- 其他设置 -->
      <view class="bg-white rounded-2xl p-4">
        <view @click="goEditApplication" class="flex items-center justify-between py-2">
          <view>
            <text class="text-sm font-medium block">修改入驻资料</text>
            <text class="text-xs text-[#999] mt-0.5">修改营业执照、法人信息等</text>
          </view>
          <text class="text-[#999] text-lg">›</text>
        </view>
      </view>
    </scroll-view>

    <!-- 底部保存按钮 -->
    <view class="fixed bottom-0 left-0 right-0 p-4 bg-white border-t border-[#E8E0D5]">
      <view @click="handleSave" :class="['w-full py-3 rounded-xl text-center text-sm font-medium', isSaving ? 'opacity-50 bg-[#C41E3A] text-white' : 'bg-[#C41E3A] text-white']">
        <text>{{ isSaving ? '⏳ 保存中...' : '💾 保存修改' }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref } from 'vue'

const formData = ref({
  logo: '',
  name: '墨香阁文化',
  slogan: '传承国学经典，弘扬传统文化',
  description: '墨香阁专注于国学文化传播，提供命理、风水、书法等传统文化产品和服务。我们致力于让更多人了解和热爱中华优秀传统文化。',
  phone: '400-888-8888',
  address: '北京市朝阳区建国路88号',
  businessHours: '09:00-21:00',
  isOpen: true,
  autoReply: true,
  autoReplyContent: '您好，欢迎光临墨香阁！有什么可以帮您的吗？',
})

const isSaving = ref(false)

async function handleSave() {
  isSaving.value = true
  await new Promise(resolve => setTimeout(resolve, 1500))
  isSaving.value = false
  uni.showToast({ title: '保存成功', icon: 'success' })
}

function goPreview() {
  uni.navigateTo({ url: '/pages/merchant/shop-preview/index' })
}

function goEditApplication() {
  uni.navigateTo({ url: '/pages/merchant/edit-application/index' })
}

function goBack() { uni.navigateBack() }
</script>

