<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 py-3">
        <view @click="goBack" class="p-1">
          <text class="text-2xl text-[#2C2C2C]">←</text>
        </view>
        <text class="text-lg font-semibold text-[#2C2C2C]">内容统计</text>
        <view class="w-8" />
      </view>
    </view>

    <!-- 加载骨架 -->
    <view v-if="loading" class="p-4 space-y-4">
      <view class="grid grid-cols-2 gap-3">
        <view v-for="i in 4" :key="i" class="h-24 bg-gray-200 rounded-xl animate-pulse" />
      </view>
    </view>

    <!-- 错误状态 -->
    <view v-else-if="error" class="p-4">
      <view class="bg-white rounded-2xl p-8 text-center">
        <text class="text-4xl block mb-3">😵</text>
        <text class="text-[#999] block mb-4">{{ error }}</text>
        <view @click="loadData" class="inline-block px-6 py-2.5 bg-[#C41E3A] text-white rounded-xl text-sm font-medium">重新加载</view>
      </view>
    </view>

    <scroll-view v-else scroll-y class="flex-1 pb-20">
      <!-- 数据概览 -->
      <view class="mx-4 mt-4 grid grid-cols-2 gap-3">
        <view class="bg-white rounded-xl p-4 text-center shadow-sm">
          <text class="text-xs text-[#999] mb-1 block">发布商品</text>
          <text class="text-2xl font-bold text-[#2C2C2C] block">{{ stats.publishedProducts }}</text>
          <text class="text-xs text-[#999] mt-1 block">/ {{ stats.totalProducts }}</text>
        </view>
        <view class="bg-white rounded-xl p-4 text-center shadow-sm">
          <text class="text-xs text-[#999] mb-1 block">已发布文章</text>
          <text class="text-2xl font-bold text-[#2C2C2C] block">{{ stats.publishedArticles }}</text>
        </view>
        <view class="bg-white rounded-xl p-4 text-center shadow-sm">
          <text class="text-xs text-[#999] mb-1 block">总浏览数</text>
          <text class="text-2xl font-bold text-[#2C2C2C] block">{{ stats.totalViews.toLocaleString() }}</text>
        </view>
        <view class="bg-white rounded-xl p-4 text-center shadow-sm">
          <text class="text-xs text-[#999] mb-1 block">总点赞数</text>
          <text class="text-2xl font-bold text-[#2C2C2C] block">{{ stats.totalLikes.toLocaleString() }}</text>
        </view>
      </view>

      <!-- 内容详情 -->
      <view class="mx-4 mt-6 space-y-3">
        <view class="bg-white rounded-xl p-4 shadow-sm">
          <view class="flex items-center justify-between mb-4">
            <view class="flex items-center gap-2">
              <text class="text-lg text-[#C41E3A]">📄</text>
              <text class="font-semibold">商品</text>
            </view>
            <text class="text-sm text-[#999]">{{ stats.totalProducts }} 件</text>
          </view>
          <view class="grid grid-cols-2 gap-2">
            <view class="p-2 bg-[#FAF8F5] rounded-lg">
              <text class="text-xs text-[#999] mb-1 block">已发布</text>
              <text class="text-lg font-bold text-[#2C2C2C] block">{{ stats.publishedProducts }}</text>
            </view>
            <view class="p-2 bg-[#FAF8F5] rounded-lg">
              <text class="text-xs text-[#999] mb-1 block">草稿</text>
              <text class="text-lg font-bold text-[#2C2C2C] block">{{ stats.draftProducts }}</text>
            </view>
          </view>
        </view>

        <view class="bg-white rounded-xl p-4 shadow-sm">
          <view class="flex items-center justify-between mb-4">
            <view class="flex items-center gap-2">
              <text class="text-lg text-[#C9A96E]">📄</text>
              <text class="font-semibold">文章</text>
            </view>
            <text class="text-sm text-[#999]">{{ stats.publishedArticles }} 篇</text>
          </view>
          <view class="space-y-2">
            <view class="flex items-center justify-between">
              <text class="text-sm text-[#999]">总阅读</text>
              <text class="font-semibold">{{ stats.totalViews.toLocaleString() }}</text>
            </view>
            <view class="flex items-center justify-between">
              <text class="text-sm text-[#999]">总点赞</text>
              <text class="font-semibold">{{ stats.totalLikes.toLocaleString() }}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 内容列表 -->
      <view class="mx-4 mt-6">
        <text class="text-sm font-semibold text-[#2C2C2C] mb-3 block">内容列表</text>
        <view class="flex gap-2 mb-3 overflow-x-auto">
          <view v-for="t in typeFilters" :key="String(t.key)" @click="activeType = t.key" :class="['px-3 py-1.5 rounded-full text-sm whitespace-nowrap', activeType === t.key ? 'bg-[#C41E3A] text-white' : 'bg-[#FAF8F5] text-[#666]']">
            <text>{{ t.label }}</text>
          </view>
        </view>

        <view v-if="contents.length > 0" class="space-y-2">
          <view v-for="item in contents" :key="item.id" class="bg-white rounded-xl p-3 shadow-sm">
            <view class="flex items-start justify-between mb-2">
              <view class="flex-1">
                <view class="flex items-center gap-2 mb-1">
                  <text class="text-sm font-medium text-[#2C2C2C] line-clamp-1">{{ item.title }}</text>
                  <text :class="['px-1.5 py-0.5 rounded text-xs', getStatusColor(item.status)]">{{ item.status }}</text>
                </view>
                <text class="text-xs text-[#999]">{{ item.createdAt }}</text>
              </view>
            </view>
            <view class="flex items-center gap-3 text-xs text-[#999]">
              <text>👁 {{ item.views }}</text>
              <text>👍 {{ item.likes }}</text>
              <text v-if="item.sales !== undefined">🛒 {{ item.sales }} 件</text>
            </view>
          </view>
        </view>
        <view v-else class="bg-white rounded-2xl p-8 text-center">
          <text class="text-[#999]">暂无内容</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted, watch } from 'vue'

const typeFilters = [
  { key: null as null | string, label: '全部' },
  { key: '商品' as null | string, label: '商品' },
  { key: '文章' as null | string, label: '文章' },
]

const loading = ref(true)
const error = ref<string | null>(null)
const activeType = ref<null | string>(null)

const stats = ref({
  publishedProducts: 0,
  totalProducts: 0,
  publishedArticles: 0,
  draftProducts: 0,
  totalViews: 0,
  totalLikes: 0,
})

const contents = ref<{ id: string; title: string; status: string; views: number; likes: number; sales?: number; createdAt: string }[]>([])

function getStatusColor(status: string) {
  switch (status) {
    case '已发布': return 'bg-green-100 text-green-800'
    case '草稿': return 'bg-gray-100 text-gray-800'
    case '下架': return 'bg-red-100 text-red-800'
    default: return 'bg-gray-100 text-gray-800'
  }
}

async function loadData() {
  loading.value = true
  error.value = null
  try {
    // 模拟 API 请求
    await new Promise(resolve => setTimeout(resolve, 600))
    const filterType = activeType.value
    // 模拟根据筛选返回不同数据
    let filteredContents = [
      { id: '1', title: '《渊海子平》命理经典解读', status: '已发布', views: 2340, likes: 156, sales: 45, createdAt: '2024-01-15' },
      { id: '2', title: '紫微斗数入门指南', status: '草稿', views: 0, likes: 0, createdAt: '2024-01-14' },
      { id: '3', title: '八字合婚详解服务介绍', status: '已发布', views: 1890, likes: 98, sales: 12, createdAt: '2024-01-12' },
    ]
    if (filterType === '商品') {
      filteredContents = filteredContents.filter(item => item.sales !== undefined)
    } else if (filterType === '文章') {
      filteredContents = filteredContents.filter(item => item.sales === undefined)
    }
    stats.value = {
      publishedProducts: 128,
      totalProducts: 156,
      publishedArticles: 45,
      draftProducts: 28,
      totalViews: 12560,
      totalLikes: 890,
    }
    contents.value = filteredContents
  } catch {
    error.value = '加载失败，请重试'
  } finally {
    loading.value = false
  }
}

watch(activeType, () => { loadData() })

onMounted(() => { loadData() })

function goBack() {
  uni.navigateBack()
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
