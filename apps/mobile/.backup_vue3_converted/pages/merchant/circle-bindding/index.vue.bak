<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 py-3">
        <view @click="goBack" class="p-1">
          <text class="text-2xl text-[#2C2C2C]">←</text>
        </view>
        <text class="text-lg font-semibold text-[#2C2C2C]">绑定圈子</text>
        <view class="w-8" />
      </view>
    </view>

    <scroll-view scroll-y class="flex-1 pb-24">
      <!-- 说明 -->
      <view class="mx-4 mt-4 p-4 bg-[#C41E3A]/5 border border-[#C41E3A]/20 rounded-xl">
        <text class="font-semibold text-[#2C2C2C] mb-1 block">圈子绑定说明</text>
        <text class="text-sm text-[#666]">绑定圈子后，您可以在该圈子中发布内容、与圈主进行合作。请选择您希望合作的圈子。</text>
      </view>

      <!-- 搜索 -->
      <view class="mx-4 mt-4">
        <view class="relative">
          <text class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-[#999]">🔍</text>
          <input v-model="searchText" placeholder="搜索圈子名称或分类" class="w-full pl-10 pr-3 py-2.5 bg-white rounded-xl text-sm border border-[#E8E0D5]" />
        </view>
      </view>

      <!-- 圈子列表 -->
      <view class="mx-4 mt-4">
        <text class="text-sm font-semibold text-[#2C2C2C] mb-3 block">可绑定圈子 ({{ filteredCircles.length }})</text>
        <view class="space-y-2">
          <view v-for="circle in filteredCircles" :key="circle.id" @click="handleToggleCircle(circle.id)" hover-class="press-opacity-80" :class="['w-full p-4 rounded-xl border transition-all flex items-center justify-between', selectedCircles.includes(circle.id) ? 'border-[#C41E3A] bg-[#C41E3A]/5' : 'border-[#E8E0D5]']">
            <view class="flex items-center gap-3 flex-1">
              <view :class="['w-10 h-10 rounded-xl flex items-center justify-center', selectedCircles.includes(circle.id) ? 'bg-[#C41E3A] text-white' : 'bg-[#FAF8F5]']">
                <text v-if="selectedCircles.includes(circle.id)" class="text-lg">✓</text>
                <text v-else class="text-lg text-[#999]">👥</text>
              </view>
              <view>
                <text class="font-semibold text-[#2C2C2C] block">{{ circle.name }}</text>
                <view class="flex items-center gap-2 mt-1">
                  <text class="text-xs px-2 py-0.5 bg-[#FAF8F5] text-[#666] rounded-full">{{ circle.category }}</text>
                  <text class="text-xs text-[#999]">👥 {{ circle.members }} 人</text>
                </view>
              </view>
            </view>
            <text :class="['text-lg', selectedCircles.includes(circle.id) ? 'text-[#C41E3A]' : 'text-[#ccc]']">›</text>
          </view>
        </view>

        <!-- 空状态 -->
        <view v-if="filteredCircles.length === 0" class="bg-white rounded-2xl p-8 text-center">
          <text class="text-[#999]">未找到匹配的圈子</text>
        </view>
      </view>

      <!-- 统计 -->
      <view v-if="selectedCircles.length > 0" class="mx-4 mt-6 p-4 bg-[#FAF8F5] rounded-xl">
        <text class="text-sm text-[#999] mb-2 block">已选择 {{ selectedCircles.length }} 个圈子</text>
        <view class="space-y-1">
          <text v-for="c in selectedCircleList" :key="c.id" class="text-sm text-[#2C2C2C] block">• {{ c.name }}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 底部操作 -->
    <view class="fixed bottom-0 left-0 right-0 bg-white border-t border-[#E8E0D5] p-4" style="padding-bottom:calc(16px + env(safe-area-inset-bottom))">
      <view class="flex gap-3">
        <view @click="goBack" class="flex-1 py-3 border border-[#E8E0D5] rounded-xl text-center text-sm font-medium" hover-class="press-opacity-70">返回</view>
        <view @click="handleSubmit" hover-class="press-opacity-80" :class="['flex-1 py-3 rounded-xl text-center text-sm font-medium', (isSubmitting || selectedCircles.length === 0) ? 'opacity-50 bg-[#C41E3A] text-white' : 'bg-[#C41E3A] text-white']">
          {{ isSubmitting ? '提交中...' : '确认绑定' }}
        </view>
      </view>
    </view>

    <!-- 提交加载遮罩 -->
    <view v-if="isSubmitting" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40" @click.stop>
      <view class="bg-white rounded-2xl p-6 flex flex-col items-center gap-3" style="min-width:160px">
        <view class="w-8 h-8 rounded-full border-2 border-[#C41E3A] border-t-transparent" style="animation: spin 1s linear infinite" />
        <text class="text-sm text-[#2C2C2C]">提交中...</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

interface Circle {
  id: string
  name: string
  category: string
  members: number
  bound: boolean
}

const mockCircles: Circle[] = [
  { id: '1', name: '八字算命爱好者', category: '算命', members: 1250, bound: false },
  { id: '2', name: '紫微斗数研究', category: '占卜', members: 980, bound: true },
  { id: '3', name: '道教文化传承', category: '道教', members: 650, bound: false },
  { id: '4', name: '中医养生圈', category: '健康', members: 2100, bound: false },
  { id: '5', name: '古籍收藏交流', category: '文化', members: 380, bound: false },
  { id: '6', name: '国学经典讨论', category: '国学', members: 1520, bound: false },
]

const circles = ref(mockCircles)
const searchText = ref('')
const selectedCircles = ref<string[]>(mockCircles.filter(c => c.bound).map(c => c.id))
const isSubmitting = ref(false)

const filteredCircles = computed(() => {
  return circles.value.filter(circle =>
    circle.name.toLowerCase().includes(searchText.value.toLowerCase()) ||
    circle.category.toLowerCase().includes(searchText.value.toLowerCase())
  )
})

const selectedCircleList = computed(() => {
  return circles.value.filter(c => selectedCircles.value.includes(c.id))
})

function handleToggleCircle(id: string) {
  const idx = selectedCircles.value.indexOf(id)
  if (idx >= 0) {
    selectedCircles.value.splice(idx, 1)
  } else {
    selectedCircles.value.push(id)
  }
}

async function handleSubmit() {
  isSubmitting.value = true
  await new Promise(resolve => setTimeout(resolve, 1500))
  isSubmitting.value = false
  uni.showToast({ title: '绑定成功', icon: 'success' })
  setTimeout(() => uni.navigateTo({ url: '/pages/merchant/dashboard/index' }), 800)
}

function goBack() {
  uni.navigateBack()
}
</script>

<style scoped>
.press-opacity-80:active { opacity: 0.8; }
.press-opacity-70:active { opacity: 0.7; }

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
</style>
