        <view class="flex items-center gap-2 text-[#999]">
          <text class="text-base">🕐</text>
          <text>营业时间: {{ shopData.businessHours }}</text>
        </view>
      </view>
    </view>

    <!-- 商品列表 -->
    <view class="mt-4">
      <view class="px-4 sticky top-14 z-40 bg-[#FAF8F5] py-2">
        <view class="grid grid-cols-4 h-9 bg-[#F0EBE5] rounded-lg p-0.5">
          <view v-for="t in productTabs" :key="t.key" :class="['inline-flex items-center justify-center whitespace-nowrap rounded-md text-xs font-medium transition-all', activeProductTab === t.key ? 'bg-white text-[#2C2C2C] shadow-sm' : 'text-[#999]']">
            <text>{{ t.label }}</text>
          </view>
        </view>
      </view>

      <view class="px-4 mt-3">
        <view class="grid grid-cols-2 gap-3">
          <view v-for="product in filteredProducts" :key="product.id" class="bg-white rounded-2xl overflow-hidden">
            <view class="aspect-square bg-[#FAF8F5] flex items-center justify-center">
              <text class="text-4xl">📦</text>
            </view>
            <view class="p-3">
              <text class="text-sm font-medium line-clamp-2 block">{{ product.title }}</text>
              <view class="flex items-baseline gap-1 mt-2">
                <text class="text-base font-bold text-[#C41E3A]">¥{{ product.price }}</text>
                <text v-if="product.originalPrice" class="text-xs text-[#999] line-through">¥{{ product.originalPrice }}</text>
              </view>
              <text class="text-xs text-[#999] mt-1 block">已售 {{ product.sales }}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部购物车入口 -->
    <view class="fixed bottom-0 left-0 right-0 p-4 bg-white border-t border-[#E8E0D5]">
      <view class="flex items-center gap-3">
        <view class="relative w-10 h-10 border border-[#E8E0D5] rounded-xl flex items-center justify-center">
          <text class="text-lg">🛒</text>
          <text class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-[#C41E3A] text-[10px] text-white flex items-center justify-center">2</text>
        </view>
        <view class="flex-1 py-3 bg-[#C41E3A] text-white rounded-xl text-center text-sm font-medium">去购物车结算</view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

const shopData = {
  id: '1',
  name: '墨香阁文化',
  logo: '',
  slogan: '传承国学经典，弘扬传统文化',
  description: '墨香阁专注于国学文化传播，提供命理、风水、书法等传统文化产品和服务。',
  rating: 4.9,
  reviewCount: 328,
  followerCount: 1256,
  productCount: 45,
  salesCount: 2680,
  isFollowed: false,
  phone: '400-888-8888',
  address: '北京市朝阳区建国路88号',
  businessHours: '09:00-21:00',
  level: '金牌商家',
  badges: ['品质保障', '极速发货', '7天无理由'],
}

interface Product {
  id: string
  title: string
  price: number
  originalPrice: number | null
  sales: number
  image: string
}

const products: Product[] = [
  { id: '1', title: '滴天髓精解', price: 68, originalPrice: 98, sales: 328, image: '' },
  { id: '2', title: '子平真诠评注', price: 88, originalPrice: 128, sales: 215, image: '' },
  { id: '3', title: '文房四宝套装', price: 268, originalPrice: 368, sales: 56, image: '' },
  { id: '4', title: '紫砂茶壶礼盒', price: 588, originalPrice: null, sales: 12, image: '' },
  { id: '5', title: '八字命理基础课', price: 199, originalPrice: 299, sales: 456, image: '' },
  { id: '6', title: '毛笔书法入门套装', price: 128, originalPrice: 168, sales: 89, image: '' },
]

const productTabs = [
  { key: 'all', label: '全部' },
  { key: 'hot', label: '热销' },
  { key: 'new', label: '新品' },
  { key: 'price', label: '价格' },
]

const activeProductTab = ref('all')

const filteredProducts = computed(() => {
  if (activeProductTab.value === 'all') return products
  if (activeProductTab.value === 'hot') return [...products].sort((a, b) => b.sales - a.sales)
  if (activeProductTab.value === 'new') return [...products].reverse()
  if (activeProductTab.value === 'price') return [...products].sort((a, b) => a.price - b.price)
  return products
})

function goBack() { uni.navigateBack() }
</script>

