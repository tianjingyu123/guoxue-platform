<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-20">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-50 bg-white/80 backdrop-blur border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between h-14 px-4">
        <view @click="goBack">
          <text class="text-xl text-[#2C2C2C]">←</text>
        </view>
        <text class="text-lg font-semibold">店铺预览</text>
        <view class="p-1">
          <text>📤</text>
        </view>
      </view>
    </view>

    <!-- 店铺头部 -->
    <view class="bg-gradient-to-br from-[#C41E3A] to-[#C41E3A]/80 text-white p-4 pb-6">
      <view class="flex items-start gap-4">
        <view class="w-16 h-16 rounded-xl bg-white/20 flex items-center justify-center shrink-0">
          <text class="text-3xl">🏪</text>
        </view>
        <view class="flex-1 min-w-0">
          <view class="flex items-center gap-2">
            <text class="text-lg font-bold truncate">{{ shopData.name }}</text>
            <text class="px-1.5 py-0.5 rounded text-[10px] bg-amber-500/90 text-white shrink-0">{{ shopData.level }}</text>
          </view>
          <text class="text-sm text-white/80 mt-1 line-clamp-2 block">{{ shopData.slogan }}</text>
          <view class="flex items-center gap-3 mt-2 text-sm">
            <view class="flex items-center gap-1">
              <text class="text-amber-400 text-sm">★</text>
              <text class="font-medium">{{ shopData.rating }}</text>
            </view>
            <text class="text-white/60">|</text>
            <text>{{ shopData.followerCount }}关注</text>
            <text class="text-white/60">|</text>
            <text>{{ shopData.productCount }}商品</text>
          </view>
        </view>
      </view>
      <!-- 标签 -->
      <view class="flex flex-wrap gap-2 mt-4">
        <text v-for="badge in shopData.badges" :key="badge" class="px-2 py-0.5 rounded text-[10px] bg-white/20 text-white">
          {{ badge }}
        </text>
      </view>
    </view>

    <!-- 店铺数据 -->
    <view class="mx-4 -mt-3 relative z-10 bg-white rounded-2xl p-4 shadow-sm">
      <view class="grid grid-cols-4 gap-2 text-center">
        <view>
          <text class="text-lg font-bold text-[#2C2C2C] block">{{ shopData.productCount }}</text>
          <text class="text-xs text-[#999]">全部商品</text>
        </view>
        <view>
          <text class="text-lg font-bold text-[#2C2C2C] block">{{ shopData.salesCount }}</text>
          <text class="text-xs text-[#999]">总销量</text>
        </view>
        <view>
          <text class="text-lg font-bold text-[#2C2C2C] block">{{ shopData.reviewCount }}</text>
          <text class="text-xs text-[#999]">评价数</text>
        </view>
        <view>
          <text class="text-lg font-bold text-[#2C2C2C] block">{{ shopData.followerCount }}</text>
          <text class="text-xs text-[#999]">粉丝数</text>
        </view>
      </view>
      <!-- 操作按钮 -->
      <view class="flex gap-3 mt-4 pt-4 border-t border-[#E8E0D5]">
        <view class="flex-1 py-2 border border-[#E8E0D5] rounded-xl text-center text-xs">❤️ 关注店铺</view>
        <view class="flex-1 py-2 border border-[#E8E0D5] rounded-xl text-center text-xs">💬 联系客服</view>
      </view>
    </view>

    <!-- 店铺信息 -->
    <view class="mx-4 mt-3 bg-white rounded-2xl p-4">
      <text class="font-medium mb-3 block">店铺信息</text>
      <view class="space-y-2 text-sm">
        <view class="flex items-center gap-2 text-[#999]">
          <text class="text-base">📞</text>
          <text>{{ shopData.phone }}</text>
        </view>
        <view class="flex items-center gap-2 text-[#999]">
          <text class="text-base">📍</text>
