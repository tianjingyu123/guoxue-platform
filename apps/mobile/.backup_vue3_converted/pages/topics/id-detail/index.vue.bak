<template>
  <view class="min-h-screen bg-background pb-20">
    <!-- 顶部背景和导航 -->
    <view class="h-48 relative" style="background: linear-gradient(135deg, #C41E3A, #8B1528)">
      <view class="absolute top-0 left-0 right-0 flex items-center justify-between px-4 pt-12 z-10">
        <view class="w-10 h-10 rounded-full flex items-center justify-center" style="background: rgba(0,0,0,0.2); backdrop-filter: blur(12px)" @click="goBack">
          <text class="text-white text-xl">←</text>
        </view>
        <view class="w-10 h-10 rounded-full flex items-center justify-center" style="background: rgba(0,0,0,0.2); backdrop-filter: blur(12px)" @click="handleShare">
          <text class="text-white">📤</text>
        </view>
      </view>
      <!-- 装饰图案 -->
      <view class="absolute inset-0 opacity-10">
        <view class="absolute top-8 right-8 w-32 h-32 border-4 border-white rounded-full" />
        <view class="absolute bottom-4 left-4 w-16 h-16 border-2 border-white rounded-full" />
      </view>
    </view>

    <!-- 话题信息卡片 -->
    <view class="px-4 -mt-16 relative z-10">
      <view class="bg-white rounded-2xl p-5" style="box-shadow: 0 4px 20px rgba(0,0,0,0.08)">
        <view class="flex items-center gap-2 mb-3">
          <view class="w-10 h-10 rounded-xl flex items-center justify-center" style="background: linear-gradient(135deg, #C41E3A, #E84C3D)">
            <text class="text-white text-lg">#</text>
          </view>
          <text class="text-xl font-bold">{{ topic?.name }}</text>
        </view>
        <text class="text-sm leading-relaxed block mb-4" style="color: #666">{{ topic?.description }}</text>

        <view class="flex items-center gap-6 mb-4">
          <view class="flex items-center gap-1.5">
            <text class="text-muted-foreground">📄</text>
            <text class="text-sm" style="color: #666">
              <text class="font-semibold" style="color: #2C2C2C">{{ topic?.posts?.toLocaleString() }}</text> 篇内容
            </text>
          </view>
          <view class="flex items-center gap-1.5">
            <text class="text-muted-foreground">👥</text>
            <text class="text-sm" style="color: #666">
              <text class="font-semibold" style="color: #2C2C2C">{{ topic?.followers?.toLocaleString() }}</text> 人关注
            </text>
          </view>
        </view>

        <view class="w-full py-2.5 rounded-xl text-sm font-medium text-center" :class="isFollowed ? 'bg-secondary text-muted-foreground' : 'text-white'" :style="isFollowed ? '' : 'background: linear-gradient(to right, #C41E3A, #E84C3D)'" @click="handleFollow">
          {{ isFollowed ? '已关注' : '+ 关注话题' }}
        </view>
      </view>
    </view>

    <!-- Loading骨架 -->
    <view v-if="isLoading">
      <view class="h-48" style="background: linear-gradient(135deg, rgba(196,30,58,0.2), rgba(201,169,110,0.2)); animation: pulse 2s infinite" />
      <view class="px-4 -mt-8">
        <view class="bg-white rounded-2xl p-4" style="box-shadow: 0 1px 4px rgba(0,0,0,0.08)">
          <view class="h-6 w-32 bg-muted rounded mb-2" style="animation: pulse 2s infinite" />
          <view class="h-4 w-full bg-muted rounded mb-4" style="animation: pulse 2s infinite" />
          <view class="flex gap-4">
            <view class="h-8 w-20 bg-muted rounded" style="animation: pulse 2s infinite" />
            <view class="h-8 w-20 bg-muted rounded" style="animation: pulse 2s infinite" />
          </view>
        </view>
      </view>
      <view class="px-4 mt-4 space-y-3">
        <view v-for="i in 3" :key="i" class="bg-white rounded-xl p-4" style="animation: pulse 2s infinite">
          <view class="flex gap-3 mb-3">
            <view class="w-10 h-10 bg-muted rounded-full" />
            <view class="flex-1">
              <view class="h-4 w-24 bg-muted rounded mb-1" />
              <view class="h-3 w-16 bg-muted rounded" />
            </view>
          </view>
          <view class="h-4 w-full bg-muted rounded mb-2" />
          <view class="h-4 w-2/3 bg-muted rounded" />
        </view>
      </view>
    </view>

    <template v-else>
      <!-- 排序Tab -->
      <view class="px-4 mt-4">
        <view class="flex items-center gap-1 bg-white rounded-xl p-1">
          <view class="flex-1 flex items-center justify-center gap-1.5 py-2.5 rounded-lg text-sm font-medium" :class="sortBy === 'latest' ? 'text-white' : 'text-muted-foreground'" :style="sortBy === 'latest' ? 'background: linear-gradient(to right, #C41E3A, #E84C3D)' : ''" @click="sortBy = 'latest'">
            <text>🕐</text>
            <text>最新</text>
          </view>
          <view class="flex-1 flex items-center justify-center gap-1.5 py-2.5 rounded-lg text-sm font-medium" :class="sortBy === 'hot' ? 'text-white' : 'text-muted-foreground'" :style="sortBy === 'hot' ? 'background: linear-gradient(to right, #C41E3A, #E84C3D)' : ''" @click="sortBy = 'hot'">
            <text>🔥</text>
            <text>最热</text>
          </view>
        </view>
      </view>

      <!-- 帖子列表 -->
      <view class="px-4 mt-4 space-y-3">
        <!-- 空状态 -->
        <view v-if="posts.length === 0" class="flex flex-col items-center justify-center py-16">
          <view class="w-20 h-20 rounded-full bg-secondary flex items-center justify-center mb-4">
            <text class="text-3xl text-muted-foreground">📄</text>
          </view>
          <text class="text-muted-foreground mb-4">暂无相关内容</text>
          <view class="px-6 py-2 text-white rounded-full text-sm" style="background: linear-gradient(to right, #C41E3A, #E84C3D)" @click="handlePost">发布第一篇</view>
        </view>

        <view v-for="post in posts" :key="post.id" class="bg-white rounded-xl p-4" style="box-shadow: 0 2px 12px rgba(0,0,0,0.04)" @click="goToPost(post)">
          <!-- 来源标签 -->
          <view v-if="post.source" class="flex items-center gap-1.5 mb-3">
            <text class="px-2 py-0.5 rounded text-xs" :class="post.source.type === 'article' ? 'text-accent' : 'text-primary'" :style="post.source.type === 'article' ? 'background: rgba(201,169,110,0.1)' : 'background: rgba(196,30,58,0.1)'">
              {{ post.source.type === 'article' ? '文章' : '圈子' }}
            </text>
            <text class="text-xs text-muted-foreground">{{ post.source.name }}</text>
          </view>

          <!-- 作者信息 -->
          <view class="flex items-center gap-3 mb-3">
            <image :src="post.author.avatar" mode="aspectFill" class="w-10 h-10 rounded-full" />
            <view class="flex-1">
              <text class="text-sm font-medium block">{{ post.author.name }}</text>
              <text class="text-xs text-muted-foreground">{{ formatTime(post.createdAt) }}</text>
            </view>
          </view>

          <!-- 内容 -->
          <text class="text-sm leading-relaxed block mb-3 line-clamp-3">{{ post.content }}</text>

          <!-- 图片 -->
          <view v-if="post.images && post.images.length > 0" class="flex gap-2 mb-3">
            <view v-for="(img, i) in post.images.slice(0, 3)" :key="i" class="w-20 h-20 rounded-lg overflow-hidden bg-secondary">
              <image :src="img" mode="aspectFill" class="w-full h-full" />
            </view>
            <view v-if="post.images.length > 3" class="w-20 h-20 rounded-lg bg-secondary flex items-center justify-center">
              <text class="text-sm text-muted-foreground">+{{ post.images.length - 3 }}</text>
            </view>
          </view>

          <!-- 互动数据 -->
          <view class="flex items-center gap-4 text-xs text-muted-foreground">
            <text :class="post.isLiked ? 'text-primary' : ''">{{ post.likes }} 赞</text>
            <text>{{ post.comments }} 评论</text>
          </view>
        </view>
      </view>

      <!-- 底部发帖按钮 -->
      <view class="fixed bottom-20 right-4 z-50">
        <view class="w-14 h-14 rounded-full flex items-center justify-center" style="background: linear-gradient(to right, #C41E3A, #E84C3D); box-shadow: 0 4px 12px rgba(196,30,58,0.3)" @click="handlePost">
          <text class="text-white text-2xl">✚</text>
        </view>
      </view>
    </template>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

interface Topic {
  id: string; name: string; description: string; cover?: string
  posts: number; followers: number; isFollowed: boolean
}

interface TopicPost {
  id: string; type: 'post' | 'article'; content: string; images?: string[]
  author: { id: string; name: string; avatar: string }
  createdAt: string; likes: number; comments: number; isLiked: boolean
  source?: { type: 'circle' | 'article'; id: string; name: string }
}

const mockTopic: Topic = {
  id: '1', name: '八字入门',
  description: '探讨八字命理基础知识，分享学习心得，解答入门疑惑。适合初学者交流学习。',
  posts: 1280, followers: 5680, isFollowed: false,
}

const mockPosts: TopicPost[] = [
  {
    id: '1', type: 'post',
    content: '今天学习了八字中的十神关系，感觉对理解命局有很大帮助。分享一下我的笔记：正官代表约束、规矩，七杀代表压力、挑战...',
    images: ['/static/default-avatar.png'],
    author: { id: '1', name: '命理新手', avatar: '/static/default-avatar.png' },
    createdAt: new Date(Date.now() - 86400000).toISOString(),
    likes: 128, comments: 32, isLiked: false,
    source: { type: 'circle', id: '1', name: '八字研习社' },
  },
  {
    id: '2', type: 'article',
    content: '八字入门必知：天干地支的基本概念与记忆方法。很多初学者对天干地支感到困惑，本文将用最简单的方式帮你理解...',
    author: { id: '2', name: '周易大师', avatar: '/static/default-avatar.png' },
    createdAt: new Date(Date.now() - 86400000 * 2).toISOString(),
    likes: 356, comments: 89, isLiked: true,
    source: { type: 'article', id: '1', name: '专栏文章' },
  },
  {
    id: '3', type: 'post',
    content: '请教各位大神，八字中的日主弱是不是一定不好？我看了一些资料说身弱需要帮扶，但又有说法是身弱也有好命...',
    author: { id: '3', name: '求学者', avatar: '/static/default-avatar.png' },
    createdAt: new Date(Date.now() - 86400000 * 3).toISOString(),
    likes: 45, comments: 67, isLiked: false,
  },
]

const topic = ref<Topic | null>(null)
const posts = ref<TopicPost[]>([])
const isLoading = ref(true)
const sortBy = ref<'latest' | 'hot'>('latest')
const isFollowed = ref(false)
const topicId = ref('')

onMounted(() => {
  // @ts-ignore
  const pages = getCurrentPages()
  // @ts-ignore
  const currentPage = pages[pages.length - 1]
  // @ts-ignore
  if (currentPage && currentPage.options && currentPage.options.id) {
    // @ts-ignore
    topicId.value = currentPage.options.id
  }
  loadData()
})

const loadData = async () => {
  isLoading.value = true
  await new Promise(r => setTimeout(r, 800))
  topic.value = mockTopic
  posts.value = mockPosts
  isFollowed.value = mockTopic.isFollowed
  isLoading.value = false
}

function handleFollow() {
  const newState = !isFollowed.value
  isFollowed.value = newState
  if (topic.value) {
    topic.value = { ...topic.value, followers: topic.value.followers + (newState ? 1 : -1) }
  }
}

function handleShare() {
  uni.showActionSheet({ itemList: ['分享给好友', '复制链接'] })
}

function handlePost() {
  uni.navigateTo({ url: `/pages/publish/index?topic=${topicId.value}` })
}

function goToPost(post: TopicPost) {
  const url = post.source?.type === 'article'
    ? `/pages/article/${post.source.id}/index`
    : `/pages/post/${post.id}/index`
  uni.navigateTo({ url })
}

function formatTime(dateStr: string) {
  const date = new Date(dateStr)
  const now = new Date()
  const diff = now.getTime() - date.getTime()
  const hours = Math.floor(diff / (1000 * 60 * 60))
  if (hours < 24) return `${hours}小时前`
  const days = Math.floor(hours / 24)
  if (days < 30) return `${days}天前`
  return `${date.getMonth() + 1}/${date.getDate()}`
}

function goBack() { uni.navigateBack() }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
</style>
