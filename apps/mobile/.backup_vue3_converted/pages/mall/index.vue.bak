<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-6">
    <!-- AI搜索弹窗 -->
    <view v-if="aiSearchOpen" class="fixed inset-0 z-50 flex items-end justify-center">
      <view class="absolute inset-0 bg-black/40" @click="closeAISearch" />
      <view class="relative w-full bg-white rounded-t-2xl animate-slide-up px-4 pt-6 pb-8">
        <view class="flex items-center justify-between mb-4">
          <text class="text-lg font-semibold text-[#2C2C2C]">AI 智能搜索</text>
          <text class="text-xs text-[#999]" @click="closeAISearch">关闭</text>
        </view>
        <view class="relative mb-4">
          <input
            v-model="aiQuery"
            type="text"
            placeholder="用自然语言描述你想找的商品..."
            class="w-full h-11 pl-4 pr-10 rounded-xl bg-[#F5F1EB] text-sm text-[#2C2C2C] placeholder:text-[#999] focus:outline-none"
            @confirm="handleAISearchSubmit"
          />
          <text class="absolute right-3 top-1/2 -translate-y-1/2 text-sm">🔍</text>
        </view>
        <view class="flex flex-wrap gap-2">
          <view
            v-for="hint in aiHints"
            :key="hint"
            class="px-3 py-1.5 rounded-full bg-[#F5F1EB] text-xs text-[#2C2C2C]"
            @click="aiQuery = hint"
          >
            {{ hint }}
          </view>
        </view>
        <view class="mt-4 p-3 rounded-xl bg-[#FFF8F0] border border-[#E8E0D5]">
          <text class="text-xs text-[#C9A96E] leading-relaxed">
            AI搜索可理解自然语言描述，智能匹配最符合您需求的商品。例如："适合送给属龙朋友的礼物"
          </text>
        </view>
      </view>
    </view>

    <!-- 顶部搜索栏 -->
    <view class="sticky top-0 z-30 bg-[#FAF8F5] border-b border-[#E8E0D5]">
      <view class="px-4 py-3 flex items-center gap-2">
        <view class="relative flex-1">
          <text class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-[#999]">🔍</text>
          <input
            v-model="searchQuery"
            type="text"
            placeholder="搜索商品"
            class="w-full h-10 pl-10 pr-4 rounded-full bg-[#F5F1EB] border-0 text-sm text-[#2C2C2C] placeholder:text-[#999]"
            @confirm="handleSearch"
          />
        </view>
        <view class="w-9 h-9 rounded-full bg-[#C41E3A] flex items-center justify-center active:scale-90 transition-transform" @click="openAISearch">
          <text class="text-white text-sm">🤖</text>
        </view>
      </view>
    </view>

    <view class="px-4 space-y-5 pt-4">
      <!-- 功能快捷入口 -->
      <view class="grid grid-cols-4 gap-3">
        <view
          v-for="entry in quickEntries"
          :key="entry.id"
          class="flex flex-col items-center gap-1.5 py-3 rounded-xl bg-white relative active:scale-95 transition-transform duration-150"
          @click="goQuickEntry(entry.id)"
        >
          <view class="w-10 h-10 rounded-full bg-[#F2EFEA] flex items-center justify-center">
            <text class="text-base">{{ entry.icon }}</text>
          </view>
          <text class="text-xs text-[#2C2C2C]">{{ entry.label }}</text>
          <text
            v-if="entry.badge"
            class="absolute top-1 right-[25%] w-4 h-4 rounded-full bg-[#C41E3A] text-white text-[10px] flex items-center justify-center leading-none"
          >
            {{ entry.badge }}
          </text>
        </view>
      </view>

      <!-- 电商直播 -->
      <view>
        <view class="flex items-center justify-between mb-3">
          <view class="flex items-center gap-2">
            <text class="text-red-500 text-sm">📻</text>
            <text class="font-semibold text-[#2C2C2C] text-sm">直播带货</text>
            <view class="w-1.5 h-1.5 bg-red-500 rounded-full animate-pulse-dot" />
          </view>
          <view class="flex items-center text-xs text-[#999] active:opacity-60" @click="goLiveMore">
            <text>更多</text>
            <text class="text-sm ml-0.5">›</text>
          </view>
        </view>
        <scroll-view scroll-x class="w-full" enhanced :show-scrollbar="false">
          <view class="flex gap-2.5 pb-1 px-0.5">
            <view
              v-for="live in commerceLives"
              :key="live.id"
              class="flex-shrink-0 w-40"
            >
              <view class="bg-white rounded-xl overflow-hidden">
                <!-- 直播间封面 -->
                <view
                  :class="[
                    'relative flex items-center justify-center',
                    live.isLive ? 'aspect-[4/3]' : 'aspect-[4/3]'
                  ]"
                  :style="{ background: `linear-gradient(135deg, rgba(196,30,58,0.15), rgba(201,169,110,0.15))` }"
                >
                  <text class="text-3xl">📺</text>
                  <view v-if="live.isLive" class="absolute top-2 left-2 px-1.5 py-0.5 bg-red-500 text-white text-[10px] rounded-sm animate-pulse-dot">
                    LIVE
                  </view>
                  <view v-else class="absolute top-2 left-2 px-1.5 py-0.5 bg-[#C9A96E] text-white text-[10px] rounded-sm">
                    预告
                  </view>
                </view>
                <!-- 直播间信息 -->
                <view class="p-2.5">
                  <text class="text-xs font-medium text-[#2C2C2C] line-clamp-1 block leading-relaxed">{{ live.title }}</text>
                  <text class="text-[10px] text-[#999] block mt-0.5">{{ live.host }}</text>
                  <view class="flex items-center justify-between mt-1.5">
                    <text class="text-[10px] text-red-500">
                      {{ live.isLive ? formatViewers(live.viewers) + '人' : '预约中' }}
                    </text>
                    <text v-if="live.time" class="text-[10px] text-[#C9A96E]">{{ live.time }}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- Banner轮播 -->
      <view class="relative">
        <view class="overflow-hidden rounded-xl">
          <swiper
            :autoplay="true"
            :interval="4000"
            :duration="400"
            :circular="true"
            :indicator-dots="false"
            class="w-full"
            :style="{ height: bannerHeight + 'px' }"
            @change="onBannerChange"
          >
            <swiper-item v-for="banner in banners" :key="banner.id">
              <view
                class="w-full h-full rounded-xl px-5 flex flex-col justify-center"
                :style="{ background: `linear-gradient(90deg, ${banner.from}, ${banner.to})` }"
              >
                <text class="text-white text-xl font-bold">{{ banner.title }}</text>
                <text class="text-white/80 text-sm mt-1.5 leading-relaxed">{{ banner.subtitle }}</text>
              </view>
            </swiper-item>
          </swiper>
        </view>
        <!-- 自定义轮播指示器 -->
        <view class="flex justify-center gap-1.5 mt-3">
          <view
            v-for="(banner, index) in banners"
            :key="index"
            :class="[
              'h-1.5 rounded-full transition-all duration-300',
              index === bannerIndex ? 'w-4 bg-[#C41E3A]' : 'w-1.5 bg-[#999]/30'
            ]"
          />
        </view>
      </view>

      <!-- 商品分类 -->
      <view>
        <view class="flex items-center justify-between mb-3">
          <text class="font-semibold text-[#2C2C2C] text-sm">商品分类</text>
          <view class="flex items-center text-xs text-[#999] active:opacity-60" @click="goAllCategory">
            <text>全部分类</text>
            <text class="text-sm ml-0.5">›</text>
          </view>
        </view>
        <view class="grid grid-cols-4 gap-3">
          <view
            v-for="cat in categories"
            :key="cat.id"
            class="flex flex-col items-center gap-1.5 py-2.5 rounded-lg bg-white active:scale-90 transition-transform"
            @click="goCategory(cat.id)"
          >
            <text class="text-2xl leading-none">{{ cat.icon }}</text>
            <text class="text-xs text-[#2C2C2C]">{{ cat.name }}</text>
          </view>
        </view>
      </view>

      <!-- 为你推荐 -->
      <view>
        <view class="flex items-center justify-between mb-3">
          <text class="font-semibold text-[#2C2C2C] text-sm">为你推荐</text>
        </view>
        <view class="grid grid-cols-2 gap-2.5">
          <view
            v-for="product in products"
            :key="product.id"
            class="bg-white rounded-xl overflow-hidden active:scale-[0.98] transition-transform"
            @click="goProduct(product.id)"
          >
            <!-- 商品封面 -->
            <view class="aspect-square bg-[#F2EFEA] flex items-center justify-center relative">
              <text class="text-4xl text-[#999]/20">📦</text>
              <text
                v-if="product.tag"
                :class="[
                  'absolute top-1.5 left-1.5 px-1.5 py-0.5 text-white text-[10px] rounded-sm',
                  product.tag === '秒杀' ? 'bg-[#FF4D4F]' : 'bg-[#C41E3A]'
                ]"
              >
                {{ product.tag }}
              </text>
            </view>
            <!-- 商品信息 -->
            <view class="p-2.5">
              <text class="text-xs font-medium text-[#2C2C2C] line-clamp-2 block leading-relaxed min-h-[2.5rem]">
                {{ product.title }}
              </text>
              <view class="flex items-baseline gap-1.5 mt-1.5">
                <text class="text-sm text-[#C41E3A] font-semibold">¥{{ product.price }}</text>
                <text v-if="product.originalPrice" class="text-[10px] text-[#999] line-through">¥{{ product.originalPrice }}</text>
              </view>
              <text class="text-[10px] text-[#999] mt-1 block">
                已售{{ product.sales > 1000 ? (product.sales / 1000).toFixed(1) + 'k' : product.sales }}
              </text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'

// ===== 搜索相关 =====
const searchQuery = ref('')
const aiSearchOpen = ref(false)
const aiQuery = ref('')
const aiHints = ['适合属龙朋友的礼物', '办公室风水摆件', '易经入门书籍', '天然水晶手串']

function handleSearch() {
  if (!searchQuery.value.trim()) return
  uni.navigateTo({
    url: `/pages/mall/search/index?q=${encodeURIComponent(searchQuery.value.trim())}`
  })
}

function openAISearch() {
  aiSearchOpen.value = true
  aiQuery.value = ''
}
function closeAISearch() {
  aiSearchOpen.value = false
}
function handleAISearchSubmit() {
  if (!aiQuery.value.trim()) return
  closeAISearch()
  uni.showToast({ title: 'AI搜索: ' + aiQuery.value, icon: 'none' })
  // 跳转到搜索结果页
  uni.navigateTo({
    url: `/pages/mall/search/index?q=${encodeURIComponent(aiQuery.value.trim())}&ai=1`
  })
}

// ===== Banner 轮播 =====
const bannerIndex = ref(0)
const bannerHeight = ref(150)

function onBannerChange(e: any) {
  bannerIndex.value = e.detail.current
}

onMounted(() => {
  // 根据屏幕宽度计算 banner 高度 (2.5:1 比例)
  uni.getSystemInfo({
    success: (res: any) => {
      const screenWidth = res.windowWidth
      bannerHeight.value = Math.round(screenWidth / 2.5)
    }
  })
})

function formatViewers(count: number): string {
  if (count >= 10000) return (count / 10000).toFixed(1) + 'w'
  if (count >= 1000) return (count / 1000).toFixed(1) + 'k'
  return String(count)
}

// ===== 导航处理 =====
function goQuickEntry(id: string) {
  switch (id) {
    case 'orders':
      uni.navigateTo({ url: '/pages/orders/index' })
      break
    case 'cart':
      uni.switchTab({ url: '/pages/cart/index' })
      break
    case 'coupons':
      uni.navigateTo({ url: '/pages/coupons/index' })
      break
    case 'favorites':
      uni.navigateTo({ url: '/pages/favorites/index' })
      break
    default:
      uni.showToast({ title: '功能开发中', icon: 'none' })
  }
}

function goLiveMore() {
  uni.navigateTo({ url: '/pages/live/index?type=commerce' })
}

function goAllCategory() {
  uni.navigateTo({ url: '/pages/mall/category/index' })
}

function goCategory(catId: string) {
  if (catId === 'all') {
    uni.navigateTo({ url: '/pages/mall/category/index' })
  } else {
    uni.navigateTo({ url: `/pages/mall/category/index?cat=${catId}` })
  }
}

function goProduct(id: number) {
  uni.navigateTo({ url: `/pages/mall/product/id-detail/index?id=${id}` })
}

// ===== 功能入口数据 =====
const quickEntries = [
  { id: 'orders', label: '我的订单', icon: '📄' },
  { id: 'cart', label: '购物车', icon: '🛒', badge: 3 as const },
  { id: 'coupons', label: '优惠券', icon: '🏷️', badge: 2 as const },
  { id: 'favorites', label: '我的收藏', icon: '❤️' },
]

// ===== Banner 数据 =====
const banners = [
  { id: 1, title: '新人专享', subtitle: '首单立减20元', from: 'rgba(196,30,58,0.8)', to: '#C41E3A' },
  { id: 2, title: '国学典籍', subtitle: '周易全系列8折', from: 'rgba(201,169,110,0.8)', to: '#C9A96E' },
  { id: 3, title: '开运饰品', subtitle: '买二赠一', from: 'rgba(37,99,235,0.8)', to: '#2563EB' },
]

// ===== 分类数据 =====
const categories = [
  { id: 'books', name: '书籍', icon: '📚' },
  { id: 'culture', name: '文创', icon: '🎨' },
  { id: 'jewelry', name: '饰品', icon: '📿' },
  { id: 'peripheral', name: '周边', icon: '🎁' },
  { id: 'tools', name: '工具', icon: '🧭' },
  { id: 'incense', name: '香道', icon: '🕯️' },
  { id: 'tea', name: '茶器', icon: '🍵' },
  { id: 'all', name: '全部', icon: '⋯' },
]

// ===== 电商直播数据 =====
const commerceLives = [
  { id: 1, title: '开光吉祥物专场', host: '福缘阁主', viewers: 8920, isLive: true, time: undefined as string | undefined, reservations: undefined as number | undefined },
  { id: 2, title: '周易古籍珍藏版专场', host: '古籍书阁', viewers: 4150, isLive: true, time: undefined, reservations: undefined },
  { id: 3, title: '手工罗盘制作与售卖', host: '匠心堂', viewers: 0, isLive: false, time: '明天14:00', reservations: 526 },
]

// ===== 商品数据 =====
const products = [
  { id: 1, title: '周易正义·十三经注疏本', price: 68, originalPrice: 128, sales: 2341, tag: '热销' },
  { id: 2, title: '紫微斗数全书（精装版）', price: 98, originalPrice: 168, sales: 1856, tag: '新品' },
  { id: 3, title: '太极八卦铜摆件', price: 168, originalPrice: 298, sales: 892, tag: undefined as string | undefined },
  { id: 4, title: '天然黑曜石貔貅手链', price: 128, originalPrice: 258, sales: 1523, tag: '热销' },
  { id: 5, title: '檀香木罗盘摆件', price: 388, originalPrice: 588, sales: 456, tag: undefined },
  { id: 6, title: '梅花易数入门', price: 45, originalPrice: 78, sales: 3201, tag: '秒杀' },
  { id: 7, title: '六爻铜钱套装（古法铸造）', price: 88, originalPrice: 128, sales: 2156, tag: undefined },
  { id: 8, title: '沉香线香礼盒', price: 168, originalPrice: 268, sales: 678, tag: '新品' },
  { id: 9, title: '奇门遁甲精义', price: 88, originalPrice: 148, sales: 1234, tag: undefined },
  { id: 10, title: '紫水晶七星阵', price: 298, originalPrice: 498, sales: 345, tag: '热销' },
  { id: 11, title: '风水罗盘专业版', price: 688, originalPrice: 988, sales: 234, tag: undefined },
  { id: 12, title: '四库全书·术数类', price: 268, originalPrice: 398, sales: 567, tag: undefined },
]
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
@keyframes pulse-dot {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.4;
  }
}

@keyframes slide-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.animate-pulse-dot {
  animation: pulse-dot 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

.animate-slide-up {
  animation: slide-up 0.3s ease-out;
}

/* ===== 全局工具类 ===== */
.line-clamp-1 {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>
