                <text class="text-sm text-[#2C2C2C]">−</text>
              </view>
              <text class="w-6 text-center text-sm font-medium text-[#2C2C2C]">{{ item.quantity }}</text>
              <view @click.stop="updateCartQuantity(item.productId, 1)" class="w-7 h-7 rounded-full bg-[#F0EBE5] flex items-center justify-center">
