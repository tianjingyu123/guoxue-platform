  likes: number
  comments: number
  shares: number
  isLiked: boolean
  isCollected: boolean
  music: string
  products: Product[]
  hotComments: HotComment[]
}

interface CartItem {
  productId: string
  quantity: number
  product: Product
}

interface FloatingHeart {
  id: number
  x: number
  y: number
}

