// ==================== 工具函数 ====================

function formatNumber(num: number): string {
  if (num >= 10000) {
    return (num / 10000).toFixed(1) + '万'
  }
  return num.toString()
}

// ==================== 响应式状态 ====================

const currentIndex = ref(0)
const videos = ref<Video[]>(mockVideos)
const isPlaying = ref(true)
const isMuted = ref(false)
const showComments = ref(false)
const showProducts = ref(false)
const showCart = ref(false)
const floatingHearts = ref<FloatingHeart[]>([])
const cart = ref<CartItem[]>([])
const addedToCart = ref<string | null>(null)
const isTransitioning = ref(false)
const swipeOffset = ref(0)
const slideDirection = ref<'up' | 'down' | null>(null)
const screenHeight = ref(750)

// 触摸位置跟踪
let touchStartY = 0
let touchCurrentY = 0
let heartIdRef = 0

// 双击检测
let lastTapTime = 0
let clickTimer: ReturnType<typeof setTimeout> | null = null

// ==================== 计算属性 ====================

const currentVideo = computed(() => videos.value[currentIndex.value])
const prevVideo = computed(() => currentIndex.value > 0 ? videos.value[currentIndex.value - 1] : null)
const nextVideo = computed(() => currentIndex.value < videos.value.length - 1 ? videos.value[currentIndex.value + 1] : null)

const cartTotal = computed(() => cart.value.reduce((sum, item) => sum + item.quantity, 0))
const cartAmount = computed(() => cart.value.reduce((sum, item) => sum + item.quantity * item.product.price, 0))

// 视频容器偏移样式
const prevVideoStyle = computed(() => ({
  transform: `translateY(${-screenHeight.value - swipeOffset.value}px)`,
  transition: isTransitioning.value ? 'transform 0.3s ease-out' : 'none'
}))

const currentVideoStyle = computed(() => ({
  transform: `translateY(${-swipeOffset.value}px)`,
  transition: isTransitioning.value ? 'transform 0.3s ease-out' : 'none'
}))

const nextVideoStyle = computed(() => ({
  transform: `translateY(${screenHeight.value - swipeOffset.value}px)`,
  transition: isTransitioning.value ? 'transform 0.3s ease-out' : 'none'
}))

// ==================== 生命周期 ====================

onLoad((options) => {
  const videoId = options?.id as string
  if (videoId) {
    const index = videos.value.findIndex(v => v.id === videoId)
    if (index !== -1) {
      currentIndex.value = index
    }
  }
})

onMounted(() => {
  const sysInfo = uni.getSystemInfoSync()
  screenHeight.value = sysInfo.windowHeight || sysInfo.screenHeight || 750
})

// ==================== 触摸手势 ====================

function handleTouchStart(e: any) {
  if (showComments.value || showProducts.value || showCart.value) return
  touchStartY = e.touches[0].clientY
  touchCurrentY = e.touches[0].clientY
}

function handleTouchMove(e: any) {
  if (showComments.value || showProducts.value || showCart.value || isTransitioning.value) return
  touchCurrentY = e.touches[0].clientY
  const diff = touchStartY - touchCurrentY

  if ((diff > 0 && nextVideo.value) || (diff < 0 && prevVideo.value)) {
    swipeOffset.value = Math.max(-150, Math.min(150, diff))
  }
}

function handleTouchEnd() {
  if (showComments.value || showProducts.value || showCart.value || isTransitioning.value) return

  const diff = touchStartY - touchCurrentY
  const threshold = 80

  if (Math.abs(diff) > threshold) {
    if (diff > 0 && nextVideo.value) {
      slideDirection.value = 'up'
      isTransitioning.value = true
      swipeOffset.value = screenHeight.value

      setTimeout(() => {
        currentIndex.value += 1
        swipeOffset.value = 0
        isTransitioning.value = false
        slideDirection.value = null
        uni.redirectTo({ url: `/video/id-detail?id=${videos.value[currentIndex.value].id}` })
      }, 300)
    } else if (diff < 0 && prevVideo.value) {
      slideDirection.value = 'down'
      isTransitioning.value = true
      swipeOffset.value = -screenHeight.value

      setTimeout(() => {
        currentIndex.value -= 1
        swipeOffset.value = 0
        isTransitioning.value = false
        slideDirection.value = null
        uni.redirectTo({ url: `/video/id-detail?id=${videos.value[currentIndex.value].id}` })
      }, 300)
    }
  } else {
    swipeOffset.value = 0
  }
}

// ==================== 交互处理器 ====================

function handleVideoTap(e: any) {
  const now = Date.now()
  if (lastTapTime && now - lastTapTime < 300) {
    // 双击 -> 点赞 + 飘心动画
    if (clickTimer) {
      clearTimeout(clickTimer)
      clickTimer = null
    }

    const rect = (e.currentTarget as any)?.getBoundingClientRect?.()
    const touch = e.touches?.[0] || e.changedTouches?.[0] || {}
    const clientX = touch.clientX || e.detail?.x || 0
    const clientY = touch.clientY || e.detail?.y || 0

    if (rect) {
      const newHeart: FloatingHeart = {
        id: heartIdRef++,
        x: clientX - rect.left,
        y: clientY - rect.top
      }
      floatingHearts.value = [...floatingHearts.value, newHeart]
      setTimeout(() => {
        floatingHearts.value = floatingHearts.value.filter(h => h.id !== newHeart.id)
      }, 1000)
    }

    if (!currentVideo.value.isLiked) {
      handleLike()
    }
    lastTapTime = 0
    return
  }

  lastTapTime = now
  clickTimer = setTimeout(() => {
    if (lastTapTime === now) {
      isPlaying.value = !isPlaying.value
    }
    clickTimer = null
  }, 250)
}

function handleLike() {
  videos.value = videos.value.map((v, i) =>
    i === currentIndex.value
      ? { ...v, isLiked: !v.isLiked, likes: v.isLiked ? v.likes - 1 : v.likes + 1 }
      : v
  ) as Video[]
}

function handleCollect() {
  videos.value = videos.value.map((v, i) =>
    i === currentIndex.value
      ? { ...v, isCollected: !v.isCollected }
      : v
  ) as Video[]
}

function handleFollow() {
  videos.value = videos.value.map((v, i) =>
    i === currentIndex.value
      ? { ...v, author: { ...v.author, isFollowed: !v.author.isFollowed } }
      : v
  ) as Video[]
}

function handleAddToCart(product: Product) {
  cart.value = (() => {
    const existing = cart.value.find(item => item.productId === product.id)
    if (existing) {
      return cart.value.map(item =>
        item.productId === product.id
          ? { ...item, quantity: item.quantity + 1 }
          : item
      )
    }
    return [...cart.value, { productId: product.id, quantity: 1, product }]
  })()
  addedToCart.value = product.id
  setTimeout(() => { addedToCart.value = null }, 1500)
}

function updateCartQuantity(productId: string, delta: number) {
  const updated = cart.value.map(item => {
    if (item.productId === productId) {
      const newQty = item.quantity + delta
      if (newQty <= 0) return null
      return { ...item, quantity: newQty }
    }
    return item
  }).filter(Boolean) as CartItem[]
  cart.value = updated
}

function goBack() {
  uni.navigateBack()
}

function navigateToUser() {
  uni.navigateTo({ url: `/user/index?id=${currentVideo.value.author.id}` })
}
</script>

<style scoped>
/* 固定定位辅助 */
.fixed {
  position: fixed;
}
.inset-0 {
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

/* 飘心动画 */
@keyframes float-heart {
  0% {
    transform: scale(0) translateY(0);
    opacity: 1;
  }
  50% {
    transform: scale(1.2) translateY(-50px);
    opacity: 1;
  }
  100% {
    transform: scale(1) translateY(-100px);
    opacity: 0;
  }
}
.animate-float-heart {
  animation: float-heart 1s ease-out forwards;
}

/* 弹窗上滑动画 */
@keyframes slide-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}
.animate-slide-up {
  animation: slide-up 0.3s ease-out;
}

/* 音乐碟片旋转 */
@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
.animate-spin-custom {
  animation: spin 3s linear infinite;
}

/* 脉动提示 */
@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}
.animate-pulse-custom {
  animation: pulse 2s ease-in-out infinite;
}
</style>
