<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- 导航栏 -->
    <view class="flex items-center justify-between px-4 h-12 bg-white border-b border-[#E8E0D5] shrink-0">
      <view class="p-1" @click="goBack">
        <text class="text-xl text-[#2C2C2C]">←</text>
      </view>
      <text class="text-base font-semibold text-[#2C2C2C]">短视频</text>
      <view class="w-7 flex items-center justify-center" @click="onSearch">
        <text class="text-lg">🔍</text>
      </view>
    </view>

    <!-- 骨架屏 -->
    <view v-if="loading" class="flex-1 p-4">
      <view class="flex gap-2 mb-4">
        <view v-for="i in 4" :key="i" class="h-8 w-16 bg-[#F0EBE5] rounded-lg skeleton-pulse" />
      </view>
      <view class="grid grid-cols-2 gap-3">
        <view v-for="i in 6" :key="i" class="bg-white rounded-xl overflow-hidden shadow-sm">
          <view class="h-[120px] bg-[#F0EBE5] skeleton-pulse" />
          <view class="p-2.5 space-y-1.5">
            <view class="h-3.5 w-full bg-[#F0EBE5] rounded skeleton-pulse" />
            <view class="h-3 w-20 bg-[#F0EBE5] rounded skeleton-pulse" />
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view v-else-if="filteredVideos.length === 0" class="flex-1 flex flex-col items-center justify-center p-8">
      <text class="text-5xl mb-4">🎬</text>
      <text class="text-sm text-[#999] mb-2">当前分类暂无视频</text>
      <text class="text-xs text-[#bbb]">切换分类或稍后再来看看</text>
    </view>

    <!-- 主内容 -->
    <view v-else class="flex-1 flex flex-col">
      <!-- 分类 tab -->
      <view class="bg-[#C41E3A]/5 px-4 py-2 flex items-center gap-1">
        <text class="text-base text-[#C41E3A]">🔥</text>
        <text class="text-xs text-[#C41E3A]">共 {{ filteredVideos.length }} 个视频，下滑浏览更多</text>
      </view>
      <scroll-view scroll-x class="bg-white border-b border-[#E8E0D5]" show-scrollbar="false">
        <view class="flex px-3 gap-1 h-10 items-end">
          <view v-for="tab in categories" :key="tab.key" class="px-3.5 pb-2 text-sm whitespace-nowrap relative flex items-center gap-1" :class="activeTab === tab.key ? 'text-[#C41E3A] font-medium border-b-2 border-[#C41E3A]' : 'text-[#999]'" @click="switchTab(tab.key)">
            <text>{{ tab.label }}</text>
            <text v-if="tab.count" class="text-[10px] text-[#999]">({{ tab.count }})</text>
          </view>
        </view>
      </scroll-view>

      <!-- 视频瀑布流 -->
      <scroll-view scroll-y class="flex-1 overflow-y-auto" refresher-enabled @refresherrefresh="onRefresh" :refresher-triggered="refreshing">
        <view class="p-4">
          <view class="grid grid-cols-2 gap-3">
            <view v-for="v in filteredVideos" :key="v.id" class="bg-white rounded-xl overflow-hidden shadow-sm active:opacity-80" @click="goPlay(v.id)">
              <view class="relative">
                <view class="h-[130px] bg-gradient-to-br from-[#C9A96E] to-[#D4B87A] flex items-center justify-center text-4xl">
                  <text>{{ v.cover }}</text>
                </view>
                <!-- 时长标签 -->
                <view class="absolute bottom-1.5 right-1.5 bg-black/60 rounded px-1.5 py-0.5">
                  <text class="text-[10px] text-white">{{ v.duration }}</text>
                </view>
                <!-- 播放量 -->
                <view class="absolute bottom-1.5 left-1.5 bg-black/40 rounded px-1.5 py-0.5 flex items-center gap-1">
                  <text class="text-[10px] text-white">▶ {{ v.views }}</text>
                </view>
              </view>
              <view class="p-2.5">
                <text class="text-sm font-medium text-[#2C2C2C] leading-tight line-clamp-2">{{ v.title }}</text>
                <view class="flex items-center justify-between mt-1.5">
                  <text class="text-[11px] text-[#999] truncate mr-1">{{ v.author }}</text>
                  <text class="text-[10px] text-[#C9A96E] shrink-0">{{ v.categoryLabel }}</text>
                </view>
              </view>
            </view>
          </view>
          <!-- 加载更多 -->
          <view class="flex items-center justify-center py-4">
            <text class="text-xs text-[#bbb]">— 下拉加载更多 —</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

const loading = ref(true)
const refreshing = ref(false)
const activeTab = ref('all')

/** 当前分类的栏目描述文本 */
const tabDescription = computed(() => {
  const map: Record<string, string> = {
    all: '精选推荐内容',
    mingli: '命理知识分享',
    fengshui: '风水布局指南',
    yijing: '易经智慧解读',
    ziwei: '紫微斗数详解',
    qimen: '奇门遁甲教学',
    bazi: '八字命理入门',
  }
  return map[activeTab.value] || '精选推荐内容'
})

interface Video {
  id: string
  title: string
  author: string
  cover: string
  views: number
  duration: string
  category: string
  categoryLabel: string
}

const categories = [
  { key: 'all', label: '推荐' },
  { key: 'mingli', label: '命理' },
  { key: 'fengshui', label: '风水' },
  { key: 'yijing', label: '易经' },
  { key: 'ziwei', label: '紫微斗数' },
  { key: 'qimen', label: '奇门遁甲' },
  { key: 'bazi', label: '八字' },
].map(t => ({
  ...t,
  count: t.key === 'all' ? fullList.value.length : fullList.value.filter(v => v.category === t.key).length
}))

const fullList = ref<Video[]>([
  { id: '1', title: '一分钟了解易经：乾卦解读', author: '周易大师', cover: '☰', views: 12800, duration: '03:25', category: 'yijing', categoryLabel: '易经' },
  { id: '2', title: '八字入门基础：排盘步骤详解', author: '国学讲堂', cover: '📊', views: 8900, duration: '12:18', category: 'bazi', categoryLabel: '八字' },
  { id: '3', title: '居家风水布局：财位如何找', author: '风水徐师傅', cover: '🏠', views: 15200, duration: '08:45', category: 'fengshui', categoryLabel: '风水' },
  { id: '4', title: '紫微斗数14主星全解析', author: '紫微传承人', cover: '⭐', views: 6700, duration: '15:30', category: 'ziwei', categoryLabel: '紫微斗数' },
  { id: '5', title: '奇门遁甲排盘教程：新手必看', author: '奇门居士', cover: '🧭', views: 9800, duration: '20:12', category: 'qimen', categoryLabel: '奇门遁甲' },
  { id: '6', title: '八字十神详解：什么是正官', author: '命理工作室', cover: '📖', views: 5400, duration: '06:50', category: 'mingli', categoryLabel: '命理' },
  { id: '7', title: '风水罗盘使用入门教学', author: '风水大师', cover: '🧿', views: 11200, duration: '10:05', category: 'fengshui', categoryLabel: '风水' },
  { id: '8', title: '梅花易数起卦方法示范', author: '易学探索者', cover: '🌺', views: 4300, duration: '07:35', category: 'yijing', categoryLabel: '易经' },
  { id: '9', title: '六爻预测实战案例讲解', author: '六爻传人', cover: '🪙', views: 7200, duration: '14:20', category: 'mingli', categoryLabel: '命理' },
  { id: '10', title: '面相入门：五官看运势', author: '面相先生', cover: '👤', views: 11000, duration: '09:45', category: 'mingli', categoryLabel: '命理' },
  { id: '11', title: '大六壬占卜入门教程', author: '六壬居士', cover: '🌀', views: 3600, duration: '18:30', category: 'qimen', categoryLabel: '奇门遁甲' },
  { id: '12', title: '阳宅三要：门主灶布局', author: '杨公风水', cover: '🏘️', views: 8900, duration: '11:15', category: 'fengshui', categoryLabel: '风水' },
])

const filteredVideos = computed(() => {
  if (activeTab.value === 'all') return fullList.value
  return fullList.value.filter(v => v.category === activeTab.value)
})

function switchTab(key: string) {
  activeTab.value = key
}

function onRefresh() {
  refreshing.value = true
  setTimeout(() => { refreshing.value = false }, 1000)
}

function goBack() { uni.navigateBack() }

function goPlay(id: string) {
  uni.navigateTo({ url: `/pages/video/play/index?id=${id}` })
}

function onSearch() {
  uni.showToast({ title: '搜索功能即将开放', icon: 'none' })
}

/** 分类切换后顶部tag的样式优化 */
function getTabStyle(key: string) {
  return activeTab.value === key ? 'text-[#C41E3A] font-medium border-b-2 border-[#C41E3A]' : 'text-[#999]'
}

/** 格式化播放量为中文显示 */
function formatViewCount(count: number): string {
  if (count >= 10000) return (count / 10000).toFixed(1) + '万'
  if (count >= 1000) return (count / 1000).toFixed(1) + 'k'
  return String(count)
}

setTimeout(() => { loading.value = false }, 1000)
</script>

<style scoped>
.skeleton-pulse {
  animation: pulse 1.5s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.8; }
}
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
/* 样式由 Tailwind 处理 */
</style>
