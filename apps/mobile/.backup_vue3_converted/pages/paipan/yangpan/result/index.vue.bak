                <text class="text-[9px] text-muted-foreground align-top ml-px">{{ n.shiShenZhi }}</text>
              </view>
            </view>
            <view class="flex">
              <view v-for="(n, i) in liuNianData" :key="i" class="flex-1 pb-1 text-[10px] text-muted-foreground" :class="n.active ? 'bg-primary/8' : ''">{{ n.age }}岁</view>
            </view>
          </view>
