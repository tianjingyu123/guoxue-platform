<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

// 五行颜色
const wuxingColors: Record<string, string> = {
  '甲': 'text-green-600', '乙': 'text-green-600',
  '丙': 'text-red-500', '丁': 'text-red-500',
  '戊': 'text-yellow-600', '己': 'text-yellow-600',
  '庚': 'text-amber-500', '辛': 'text-amber-500',
  '壬': 'text-blue-500', '癸': 'text-blue-500',
  '子': 'text-wuxing-water', '丑': 'text-wuxing-earth',
  '寅': 'text-green-600', '卯': 'text-green-600',
  '辰': 'text-yellow-600', '巳': 'text-red-500',
  '午': 'text-red-500', '未': 'text-yellow-600',
  '申': 'text-amber-500', '酉': 'text-amber-500',
  '戌': 'text-yellow-600', '亥': 'text-wuxing-water',
}

const palaceNames: Record<number, string> = {
  4: '巽四宫', 9: '离九宫', 2: '坤二宫',
  3: '震三宫', 5: '中五宫', 7: '兑七宫',
  8: '艮八宫', 1: '坎一宫', 6: '乾六宫'
}
const palaceOrder = [4, 9, 2, 3, 5, 7, 8, 1, 6]

interface PalaceCell {
  bashen: string; jiuxing: string; bamen: string
  tianGan: string; diGan: string; anGan: string
  dipanShen: string; dipanMen: string
  kongwang: boolean; maXing: boolean
  changsheng: { tian: string; an: string }
  isZhifu?: boolean; isZhishi?: boolean
}

const palaceData: Record<number, PalaceCell> = {
  4: { bashen: '值符', jiuxing: '天蓬', bamen: '休门', tianGan: '戊', diGan: '庚', anGan: '癸', dipanShen: '腾蛇', dipanMen: '生', kongwang: true, maXing: false, changsheng: { tian: '长生', an: '沐浴' }, isZhifu: true },
  9: { bashen: '腾蛇', jiuxing: '天芮', bamen: '生门', tianGan: '己', diGan: '辛', anGan: '乙', dipanShen: '太阴', dipanMen: '伤', kongwang: false, maXing: true, changsheng: { tian: '冠带', an: '临官' } },
  2: { bashen: '太阴', jiuxing: '天冲', bamen: '伤门', tianGan: '庚', diGan: '壬', anGan: '丙', dipanShen: '六合', dipanMen: '杜', kongwang: false, maXing: false, changsheng: { tian: '帝旺', an: '衰' } },
  3: { bashen: '六合', jiuxing: '天辅', bamen: '杜门', tianGan: '辛', diGan: '癸', anGan: '丁', dipanShen: '白虎', dipanMen: '景', kongwang: true, maXing: false, changsheng: { tian: '墓', an: '死' } },
  5: { bashen: '勾陈', jiuxing: '天禽', bamen: '中宫', tianGan: '壬', diGan: '甲', anGan: '戊', dipanShen: '玄武', dipanMen: '死', kongwang: false, maXing: false, changsheng: { tian: '绝', an: '胎' } },
  7: { bashen: '白虎', jiuxing: '天心', bamen: '惊门', tianGan: '癸', diGan: '乙', anGan: '己', dipanShen: '九地', dipanMen: '惊', kongwang: false, maXing: false, changsheng: { tian: '养', an: '长生' } },
  8: { bashen: '玄武', jiuxing: '天柱', bamen: '死门', tianGan: '甲', diGan: '丙', anGan: '庚', dipanShen: '九天', dipanMen: '开', kongwang: false, maXing: false, changsheng: { tian: '沐浴', an: '冠带' } },
  1: { bashen: '九地', jiuxing: '天任', bamen: '景门', tianGan: '乙', diGan: '丁', anGan: '辛', dipanShen: '值符', dipanMen: '休', kongwang: false, maXing: true, changsheng: { tian: '临官', an: '帝旺' } },
  6: { bashen: '九天', jiuxing: '天英', bamen: '开门', tianGan: '丙', diGan: '戊', anGan: '壬', dipanShen: '勾陈', dipanMen: '生', kongwang: false, maXing: false, changsheng: { tian: '衰', an: '墓' }, isZhishi: true },
}

const daYunData = [
  { year: 1990, gan: '戊', zhi: '午', shiShen: '伤', shiShenZhi: '劫', age: 0 },
  { year: 1994, gan: '丁', zhi: '巳', shiShen: '比', shiShenZhi: '枭', age: 4 },
  { year: 2004, gan: '丙', zhi: '辰', shiShen: '劫', shiShenZhi: '食', age: 14 },
  { year: 2014, gan: '乙', zhi: '卯', shiShen: '枭', shiShenZhi: '枭', age: 24 },
  { year: 2024, gan: '甲', zhi: '寅', shiShen: '印', shiShenZhi: '印', age: 34, active: true },
  { year: 2034, gan: '癸', zhi: '丑', shiShen: '杀', shiShenZhi: '食', age: 44 },
  { year: 2044, gan: '壬', zhi: '子', shiShen: '官', shiShenZhi: '官', age: 54 },
  { year: 2054, gan: '辛', zhi: '亥', shiShen: '才', shiShenZhi: '官', age: 64 },
]

const liuNianData = [
  { year: 2024, gan: '甲', zhi: '辰', shiShen: '印', shiShenZhi: '食', age: 34 },
  { year: 2025, gan: '乙', zhi: '巳', shiShen: '枭', shiShenZhi: '枭', age: 35 },
  { year: 2026, gan: '丙', zhi: '午', shiShen: '劫', shiShenZhi: '劫', age: 36, active: true },
  { year: 2027, gan: '丁', zhi: '未', shiShen: '比', shiShenZhi: '食', age: 37 },
  { year: 2028, gan: '戊', zhi: '申', shiShen: '伤', shiShenZhi: '才', age: 38 },
  { year: 2029, gan: '己', zhi: '酉', shiShen: '食', shiShenZhi: '才', age: 39 },
  { year: 2030, gan: '庚', zhi: '戌', shiShen: '财', shiShenZhi: '伤', age: 40 },
  { year: 2031, gan: '辛', zhi: '亥', shiShen: '才', shiShenZhi: '官', age: 41 },
  { year: 2032, gan: '壬', zhi: '子', shiShen: '官', shiShenZhi: '官', age: 42 },
  { year: 2033, gan: '癸', zhi: '丑', shiShen: '杀', shiShenZhi: '食', age: 43 },
]

// 路由参数
const params = ref({
  name: '', gender: 'male', year: 1990, month: 1, day: 1, hour: 12, minute: 0,
  panMethod: 'zhuan', jigongMethod: 'kungong', startMethod: 'chaibu', anganMethod: 'zhishi'
})

// 状态
const showNotes = ref(false)
const selectedPalace = ref<number | null>(null)
const showChangsheng = ref(false)
const showDipanShen = ref(false)
const expandedDaYun = ref<number | null>(null)
const selectedKongwang = ref(2)

const sizhu = { year: { g: '庚', z: '午' }, month: { g: '戊', z: '寅' }, day: { g: '丁', z: '丑' }, hour: { g: '丁', z: '未' } }

const sizhuList = computed(() => [
  { label: '年柱', ...sizhu.year, ganColor: wuxingColors[sizhu.year.g] || '', zhiColor: wuxingColors[sizhu.year.z] || '' },
  { label: '月柱', ...sizhu.month, ganColor: wuxingColors[sizhu.month.g] || '', zhiColor: wuxingColors[sizhu.month.z] || '' },
  { label: '日柱', ...sizhu.day, ganColor: wuxingColors[sizhu.day.g] || '', zhiColor: wuxingColors[sizhu.day.z] || '' },
  { label: '时柱', ...sizhu.hour, ganColor: wuxingColors[sizhu.hour.g] || '', zhiColor: wuxingColors[sizhu.hour.z] || '' },
])

const kongwangData = [
  { label: '年', zhi: '子丑' }, { label: '月', zhi: '子丑' },
  { label: '日', zhi: '申酉' }, { label: '时', zhi: '寅卯' },
]

const panshi = computed(() => `${params.value.panMethod === 'zhuan' ? '转盘' : '飞盘'} ${params.value.jigongMethod === 'kungong' ? '坤宫' : '阳艮阴坤'} ${params.value.startMethod === 'chaibu' ? '拆补' : params.value.startMethod === 'maoshan' ? '茅山' : '置闰'}`)

onMounted(() => {
  // @ts-ignore
  const pages = getCurrentPages()
  // @ts-ignore
  const currentPage = pages[pages.length - 1]
  // @ts-ignore
  if (currentPage && currentPage.options) {
    // @ts-ignore
    const opts = currentPage.options
    if (opts.name) params.value.name = opts.name
    if (opts.gender) params.value.gender = opts.gender
    if (opts.year) params.value.year = Number(opts.year)
    if (opts.month) params.value.month = Number(opts.month)
    if (opts.day) params.value.day = Number(opts.day)
    if (opts.hour) params.value.hour = Number(opts.hour)
    if (opts.minute) params.value.minute = Number(opts.minute)
    if (opts.panMethod) params.value.panMethod = opts.panMethod
    if (opts.jigongMethod) params.value.jigongMethod = opts.jigongMethod
    if (opts.startMethod) params.value.startMethod = opts.startMethod
    if (opts.anganMethod) params.value.anganMethod = opts.anganMethod
  }
})

function goBack() { uni.navigateBack() }
function handleShare() { uni.showActionSheet({ itemList: ['分享给好友', '保存图片'] }) }

function togglePalace(palace: number) {
  selectedPalace.value = selectedPalace.value === palace ? null : palace
}

function toggleDaYun(i: number) {
  expandedDaYun.value = expandedDaYun.value === i ? null : i
}

function goToBazi() {
  const q = `name=${params.value.name}&gender=${params.value.gender}&year=${params.value.year}&month=${params.value.month}&day=${params.value.day}&hour=${params.value.hour}&minute=${params.value.minute}`
  uni.navigateTo({ url: `/pages/bazi/result/index?${q}` })
}

function handleAiAnalyze() {
  uni.showToast({ title: 'AI解析功能即将上线', icon: 'none' })
}

function handleSave() {
  uni.showToast({ title: '已保存', icon: 'success' })
}
</script>

