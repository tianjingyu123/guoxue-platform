                <text class="text-base font-bold block" :class="wuxingColors[liuNianData[idx % 10]?.gan || '甲']">{{ liuNianData[idx % 10]?.gan || '甲' }}</text>
                <text class="text-base font-bold block" :class="wuxingColors[liuNianData[idx % 10]?.zhi || '子']">{{ liuNianData[idx % 10]?.zhi || '子' }}</text>
