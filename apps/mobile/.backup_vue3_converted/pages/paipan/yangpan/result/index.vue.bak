                <text class="text-[9px] text-muted-foreground align-top ml-px">{{ d.shiShen }}</text>
              </view>
            </view>
            <view class="flex">
              <view v-for="(d, i) in daYunData" :key="i" class="flex-1 cursor-pointer" :class="d.active ? 'bg-primary/8' : expandedDaYun === i ? 'bg-secondary' : ''" @click="toggleDaYun(i)">
                <text class="text-xl font-black leading-none" :class="wuxingColors[d.zhi]">{{ d.zhi }}</text>
                <text class="text-[9px] text-muted-foreground align-top ml-px">{{ d.shiShenZhi }}</text>
