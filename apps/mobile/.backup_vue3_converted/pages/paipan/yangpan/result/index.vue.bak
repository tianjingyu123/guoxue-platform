      </view>

      <!-- AI解析和保存按钮 -->
      <view class="px-3 mt-4 flex gap-3">
        <view class="flex-1 py-3 rounded-xl text-white font-medium flex items-center justify-center gap-2" style="background: linear-gradient(to right, #8b5cf6, #a855f7, #6366f1); box-shadow: 0 4px 12px rgba(139,92,246,0.25)" @click="handleAiAnalyze">
          <text>✨</text>
          <text>AI智能解析</text>
