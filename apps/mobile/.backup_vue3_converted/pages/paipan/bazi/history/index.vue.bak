<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- 顶部导航 -->
    <header class="bg-white border-b border-[#E8E0D5] sticky top-0 z-20">
      <view class="flex items-center justify-between px-4 py-3">
        <view @click="goBack" class="flex items-center text-[#999] p-1 -ml-1">
          <text class="text-xl leading-none">←</text>
        </view>

        <!-- 切换标签 -->
        <view class="flex bg-[#F1EDE8] rounded-full p-0.5">
          <view class="px-5 py-1.5 text-sm font-medium rounded-full bg-white text-[#2C2C2C] shadow-sm">
            <text>用户列表</text>
          </view>
          <view @click="goCelebrities" class="px-5 py-1.5 text-sm font-medium rounded-full text-[#999] relative">
            <text>案例库</text>
            <text class="absolute -top-1 -right-1 px-1 py-0.5 text-[10px] font-medium text-[#b45309]" style="background:#fef3c7;border-radius:2px">VIP</text>
          </view>
        </view>

        <view @click="showMenu = !showMenu" class="p-1.5 rounded-full relative">
          <text class="text-lg text-[#999]">⋮</text>
        </view>
      </view>

      <!-- 下拉菜单 -->
      <view v-if="showMenu">
        <view class="fixed inset-0 z-10" @click="showMenu = false" />
        <view class="absolute right-3 top-12 bg-white rounded-xl shadow-xl z-20 py-2 min-w-[140px] animate-fade-in-down">
          <view @click="goGroups" class="w-full flex items-center gap-3 px-4 py-2.5 text-[#2C2C2C]/80 hover:bg-secondary/50 transition-colors">
            <text class="text-sm text-[#999]">👥</text>
            <text class="text-sm">分组编辑</text>
          </view>
          <view @click="setSelectMode('group')" class="w-full flex items-center gap-3 px-4 py-2.5 text-[#2C2C2C]/80 hover:bg-secondary/50 transition-colors">
            <text class="text-sm text-[#999]">📁</text>
            <text class="text-sm">修改分组</text>
          </view>
          <view @click="setSelectMode('pin')" class="w-full flex items-center gap-3 px-4 py-2.5 text-[#2C2C2C]/80 hover:bg-secondary/50 transition-colors">
            <text class="text-sm text-[#999]">⭐</text>
            <text class="text-sm">星标置顶</text>
          </view>
          <view @click="setSelectMode('delete')" class="w-full flex items-center gap-3 px-4 py-2.5 text-[#2C2C2C]/80 hover:bg-secondary/50 transition-colors">
            <text class="text-sm text-[#999]">🗑️</text>
            <text class="text-sm">批量删除</text>
          </view>
        </view>
      </view>
    </header>

    <!-- 搜索栏 -->
    <view class="bg-white px-4 py-3 border-b border-[#E8E0D5]/60">
      <view class="relative">
        <text class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-[#999]">🔍</text>
        <input
          type="text"
          placeholder="搜索客户名称"
          :value="searchQuery"
          @input="(e:any) => { searchQuery = e.detail.value }"
          class="w-full h-10 pl-9 pr-4 bg-[#F1EDE8] rounded-xl text-sm placeholder:text-[#999]/50 box-border"
          style="border:1px solid transparent"
        />
      </view>
    </view>

    <!-- 分组标签 -->
    <view class="bg-white px-4 py-2 border-b border-[#E8E0D5]/60 overflow-x-auto">
      <view class="flex gap-2" style="white-space:nowrap">
        <view v-for="g in groups" :key="g"
          @click="activeGroup = g"
          class="px-4 py-1.5 text-sm font-medium rounded-full transition-all"
          :class="activeGroup === g ? 'bg-[#C41E3A] text-white' : 'bg-[#F1EDE8] text-[#999]'"
        >
          <text>{{ g }}</text>
        </view>
      </view>
    </view>

    <!-- 记录列表 -->
    <view class="flex-1 bg-white">
      <view v-if="filteredRecords.length === 0" class="flex flex-col items-center justify-center py-20 text-[#999]">
        <text class="text-4xl mb-3 opacity-50">🔍</text>
        <text>暂无记录</text>
      </view>
      <view v-else class="divide-y divide-border/60">
        <view v-for="record in filteredRecords" :key="record.id"
          @click="navigateToDetail(record)"
          class="flex items-center gap-3 px-4 py-3 hover:bg-secondary/50 transition-colors"
        >
          <!-- 选择模式下的复选框 -->
          <view v-if="selectMode !== 'none'" @click="toggleSelect(record.id)">
            <view class="w-5 h-5 rounded-full border-2 flex items-center justify-center transition-all"
              :class="selectedIds.includes(record.id) ? 'border-primary bg-[#C41E3A]' : 'border-[#E8E0D5]'"
            >
              <text v-if="selectedIds.includes(record.id)" class="text-white text-xs leading-none">✓</text>
            </view>
          </view>

          <!-- 性别头像 -->
          <view class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0"
            :class="record.gender === 'male' ? 'bg-blue-50' : 'bg-pink-50'"
          >
            <svg class="w-6 h-6" :class="record.gender === 'male' ? 'text-blue-400' : 'text-pink-400'" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
            </svg>
          </view>

          <!-- 信息 -->
          <view class="flex-1 min-w-0">
            <view class="flex items-center gap-2">
              <text class="font-medium text-[#2C2C2C] truncate">{{ record.name }}</text>
              <text v-if="record.analyzed" class="px-1.5 py-0.5 text-xs text-[#b45309]" style="background:#fef3c7;border-radius:2px">已解析</text>
            </view>
            <view class="text-xs text-[#999] mt-0.5">{{ record.date }}</view>
          </view>

          <!-- 四柱八字 -->
          <view class="text-right flex-shrink-0">
            <view class="flex gap-0.5 text-sm font-medium justify-end">
              <text :class="tianGanColors[record.pillars.yearGan]">{{ record.pillars.yearGan }}</text>
              <text :class="tianGanColors[record.pillars.monthGan]">{{ record.pillars.monthGan }}</text>
              <text :class="tianGanColors[record.pillars.dayGan]">{{ record.pillars.dayGan }}</text>
              <text :class="tianGanColors[record.pillars.hourGan]">{{ record.pillars.hourGan }}</text>
            </view>
            <view class="flex gap-0.5 text-sm font-medium justify-end mt-0.5">
              <text :class="diZhiColors[record.pillars.yearZhi]">{{ record.pillars.yearZhi }}</text>
              <text :class="diZhiColors[record.pillars.monthZhi]">{{ record.pillars.monthZhi }}</text>
              <text :class="diZhiColors[record.pillars.dayZhi]">{{ record.pillars.dayZhi }}</text>
              <text :class="diZhiColors[record.pillars.hourZhi]">{{ record.pillars.hourZhi }}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 批量操作栏 - 删除模式 -->
    <view v-if="selectMode === 'delete'" class="sticky bottom-0 bg-white border-t border-[#E8E0D5] px-4 py-3 flex items-center gap-3">
      <view @click="selectAll" class="flex items-center gap-2">
        <view class="w-5 h-5 rounded-full border-2 flex items-center justify-center transition-all"
          :class="selectedIds.length === filteredRecords.length && filteredRecords.length > 0 ? 'border-primary bg-[#C41E3A]' : 'border-[#E8E0D5]'"
        >
          <text v-if="selectedIds.length === filteredRecords.length && filteredRecords.length > 0" class="text-white text-xs leading-none">✓</text>
        </view>
        <text class="text-sm text-[#2C2C2C]/80">全选</text>
      </view>
      <view class="flex-1 flex gap-2 justify-end">
        <view @click="cancelSelect" class="px-6 py-2.5 text-sm font-medium text-[#999] bg-[#F1EDE8] rounded-full">取消</view>
        <view @click="handleDelete" class="px-6 py-2.5 text-sm font-medium text-white rounded-full"
          :class="selectedIds.length > 0 ? '' : 'opacity-40'"
          :style="{ backgroundColor: selectedIds.length > 0 ? '#f87171' : '#fca5a5' }"
        >删除</view>
      </view>
    </view>

    <!-- 批量操作栏 - 置顶模式 -->
    <view v-if="selectMode === 'pin'" class="sticky bottom-0 bg-white border-t border-[#E8E0D5] px-4 py-3 flex items-center gap-3">
      <view class="flex-1 flex gap-3">
        <view @click="cancelSelect" class="flex-1 py-2.5 text-sm font-medium text-[#999] bg-[#F1EDE8] rounded-full text-center">取消</view>
        <view @click="handlePin" class="flex-1 py-2.5 text-sm font-medium text-white rounded-full text-center"
          :class="selectedIds.length > 0 ? '' : 'opacity-40'"
          :style="{ backgroundColor: selectedIds.length > 0 ? '#6b7280' : '#9ca3af' }"
        >置顶</view>
      </view>
    </view>

    <!-- 批量操作栏 - 修改分组模式 -->
    <view v-if="selectMode === 'group'" class="sticky bottom-0 bg-white border-t border-[#E8E0D5] px-4 py-3 flex items-center gap-3">
      <view @click="selectAll" class="flex items-center gap-2">
        <view class="w-5 h-5 rounded-full border-2 flex items-center justify-center transition-all"
          :class="selectedIds.length === filteredRecords.length && filteredRecords.length > 0 ? 'border-primary bg-[#C41E3A]' : 'border-[#E8E0D5]'"
        >
          <text v-if="selectedIds.length === filteredRecords.length && filteredRecords.length > 0" class="text-white text-xs leading-none">✓</text>
        </view>
        <text class="text-sm text-[#2C2C2C]/80">全选</text>
      </view>
      <view class="flex-1 flex gap-2 justify-end">
        <view @click="cancelSelect" class="px-6 py-2.5 text-sm font-medium text-[#999] bg-[#F1EDE8] rounded-full">取消</view>
        <view @click="showGroupPicker = true" class="px-6 py-2.5 text-sm font-medium text-white bg-[#C41E3A] rounded-full"
          :class="selectedIds.length > 0 ? '' : 'opacity-40'"
        >移动到分组</view>
      </view>
    </view>

    <!-- 分组选择弹窗 -->
    <view v-if="showGroupPicker" class="fixed inset-0 bg-black/40 z-50 flex items-end" @click="showGroupPicker = false">
      <view class="bg-white w-full rounded-t-2xl overflow-hidden" @click.stop>
        <view class="px-4 py-4 border-b border-[#E8E0D5] text-center">
          <text class="text-base font-semibold text-[#2C2C2C]">选择分组</text>
        </view>
        <scroll-view scroll-y class="max-h-[50vh]">
          <view v-for="g in groups.filter((g:string) => g !== '全部')" :key="g"
            @click="handleChangeGroup(g)"
            class="w-full px-4 py-4 text-left text-[#2C2C2C] border-b border-[#E8E0D5]/60 last:border-b-0 hover:bg-secondary/50 transition-colors"
          >
            <text>{{ g }}</text>
          </view>
        </scroll-view>
        <view class="p-4 border-t border-[#E8E0D5]">
          <view @click="showGroupPicker = false" class="w-full py-3 bg-[#F1EDE8] text-[#999] rounded-full font-medium text-center">取消</view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

// 五行颜色映射
const tianGanColors: Record<string, string> = {
  '甲': 'text-green-600', '乙': 'text-green-600',
  '丙': 'text-red-500', '丁': 'text-red-500',
  '戊': 'text-yellow-600', '己': 'text-yellow-600',
  '庚': 'text-amber-500', '辛': 'text-amber-500',
  '壬': 'text-blue-500', '癸': 'text-blue-500',
}

const diZhiColors: Record<string, string> = {
  '子': 'text-blue-500', '丑': 'text-yellow-600',
  '寅': 'text-green-600', '卯': 'text-green-600',
  '辰': 'text-yellow-600', '巳': 'text-red-500',
  '午': 'text-red-500', '未': 'text-yellow-600',
  '申': 'text-amber-500', '酉': 'text-amber-500',
  '戌': 'text-yellow-600', '亥': 'text-blue-500',
}

// 模拟数据
interface Pillars {
  yearGan: string; yearZhi: string; monthGan: string; monthZhi: string;
  dayGan: string; dayZhi: string; hourGan: string; hourZhi: string;
}
interface Record {
  id: number; name: string; gender: string; date: string;
  analyzed: boolean; pillars: Pillars; group: string;
}

const mockRecords: Record[] = [
  { id: 1, name: '孙哥儿子', gender: 'male', date: '05月08日 17:11', analyzed: true, pillars: { yearGan: '辛', yearZhi: '丑', monthGan: '丙', monthZhi: '申', dayGan: '甲', dayZhi: '午', hourGan: '壬', hourZhi: '申' }, group: '家人' },
  { id: 2, name: '未知', gender: 'male', date: '04月13日 22:54', analyzed: true, pillars: { yearGan: '癸', yearZhi: '亥', monthGan: '戊', monthZhi: '午', dayGan: '丁', dayZhi: '丑', hourGan: '丁', hourZhi: '未' }, group: '全部' },
  { id: 3, name: '亚楠闺女', gender: 'female', date: '02月17日 17:07', analyzed: false, pillars: { yearGan: '丙', yearZhi: '午', monthGan: '庚', monthZhi: '寅', dayGan: '辛', dayZhi: '酉', hourGan: '癸', hourZhi: '巳' }, group: '朋友' },
  { id: 4, name: '王雷', gender: 'male', date: '2025年12月26日', analyzed: true, pillars: { yearGan: '甲', yearZhi: '子', monthGan: '乙', monthZhi: '亥', dayGan: '己', dayZhi: '巳', hourGan: '壬', hourZhi: '申' }, group: '客户' },
  { id: 5, name: '老段女儿', gender: 'female', date: '2025年07月05日', analyzed: true, pillars: { yearGan: '庚', yearZhi: '子', monthGan: '己', monthZhi: '卯', dayGan: '癸', dayZhi: '酉', hourGan: '乙', hourZhi: '卯' }, group: '朋友' },
  { id: 6, name: '徐哥侄女', gender: 'female', date: '2024年12月05日', analyzed: true, pillars: { yearGan: '戊', yearZhi: '寅', monthGan: '己', monthZhi: '未', dayGan: '庚', dayZhi: '辰', hourGan: '癸', hourZhi: '未' }, group: '家人' },
]

const groups = ['全部', '家人', '朋友', '客户']

type SelectMode = 'none' | 'delete' | 'pin' | 'group'

const searchQuery = ref('')
const activeGroup = ref('全部')
const showMenu = ref(false)
const selectMode = ref<SelectMode>('none')
const selectedIds = ref<number[]>([])
const records = ref<Record[]>(mockRecords)
const showGroupPicker = ref(false)

const filteredRecords = computed(() => {
  return records.value.filter(record => {
    const matchesSearch = record.name.includes(searchQuery.value)
    const matchesGroup = activeGroup.value === '全部' || record.group === activeGroup.value
    return matchesSearch && matchesGroup
  })
})

function toggleSelect(id: number) {
  const idx = selectedIds.value.indexOf(id)
  if (idx >= 0) {
    selectedIds.value.splice(idx, 1)
  } else {
    selectedIds.value.push(id)
  }
}

function selectAll() {
  if (selectedIds.value.length === filteredRecords.value.length) {
    selectedIds.value = []
  } else {
    selectedIds.value = filteredRecords.value.map(r => r.id)
  }
}

function cancelSelect() {
  selectMode.value = 'none'
  selectedIds.value = []
}

function handleDelete() {
  if (selectedIds.value.length === 0) return
  uni.showModal({
    title: '确认删除',
    content: `确定删除选中的 ${selectedIds.value.length} 条记录吗？`,
    success: (res: any) => {
      if (res.confirm) {
        records.value = records.value.filter((r: any) => !selectedIds.value.includes(r.id))
        cancelSelect()
        uni.showToast({ title: '已删除', icon: 'success' })
      }
    }
  })
}

function handlePin() {
  cancelSelect()
}

function handleChangeGroup(newGroup: string) {
  records.value = records.value.map(r =>
    selectedIds.value.includes(r.id) ? { ...r, group: newGroup } : r
  )
  showGroupPicker.value = false
  cancelSelect()
}

function setSelectMode(mode: SelectMode) {
  selectMode.value = mode
  showMenu.value = false
}

function goBack() { uni.navigateBack() }
function goCelebrities() { uni.navigateTo({ url: '/pages/paipan/bazi/history/celebrities/index' }) }
function goGroups() { uni.navigateTo({ url: '/pages/paipan/bazi/history/groups/index' }) }

function navigateToDetail(record: Record) {
  if (selectMode.value !== 'none') return
  uni.navigateTo({ url: `/pages/paipan/bazi/detail/index?id=${record.id}` })
}
</script>

<style scoped>
.animate-fade-in-down {
  animation: fadeInDown 0.2s ease-out;
}
@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-4px); }
  to { opacity: 1; transform: translateY(0); }
}
</style>
