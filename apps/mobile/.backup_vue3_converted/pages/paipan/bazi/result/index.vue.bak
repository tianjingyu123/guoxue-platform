            <view class="w-4 h-4 rounded border-2 flex items-center justify-center" :class="opt==='真太阳时'?'border-primary bg-[#C41E3A]':'border-[#E8E0D5]'"><text v-if="opt==='真太阳时'" class="text-white text-xs">✓</text></view>
