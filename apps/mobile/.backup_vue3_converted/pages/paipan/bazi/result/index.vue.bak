<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- 顶部导航 -->
    <view class="bg-white border-b border-[#E8E0D5] sticky top-0 z-20">
      <view class="flex items-center justify-between px-3 py-2.5">
        <view @click="goBack" class="text-[#999]"><text class="text-2xl leading-none">←</text></view>
        <text class="text-base font-bold text-[#2C2C2C]">热卜八字</text>
        <view class="flex items-center gap-1">
          <view @click="showNotes=!showNotes" class="p-1 text-[#999]"><text>📖</text></view>
          <view class="p-1 text-[#999]"><text>📤</text></view>
        </view>
      </view>
      <!-- 模式切换 -->
      <view class="flex">
        <view v-for="m in modes" :key="m.key" @click="activeMode=m.key"
              class="flex-1 py-2.5 text-sm font-medium text-center border-b-2 transition-colors"
              :class="activeMode===m.key ? 'text-[#C41E3A] border-primary' : 'text-[#999] border-transparent'">
          <text>{{ m.label }}</text>
        </view>
      </view>
    </view>

    <scroll-view scroll-y class="flex-1">
      <!-- 传统模式 -->
      <template v-if="activeMode==='traditional'">
        <view class="p-2.5 space-y-2">
          <!-- 基本信息 -->
          <view class="bg-white rounded-lg border border-[#E8E0D5]">
            <view class="flex items-center justify-between px-3 py-2.5 border-b border-[#E8E0D5]">
              <view class="flex items-center gap-4 text-sm text-[#2C2C2C]">
                <text><text class="text-[#C41E3A] font-medium">名称：</text>{{ data.name }}</text>
                <text><text class="text-[#C41E3A] font-medium">性别：</text>{{ data.gender }}</text>
                <text><text class="text-[#C41E3A] font-medium">生肖：</text>{{ data.zodiac }}</text>
              </view>
            </view>
            <view class="px-3 py-2 text-sm flex items-center gap-2 border-b border-[#E8E0D5]">
              <text class="text-[#C41E3A] font-medium shrink-0">日期</text>
              <text class="text-[#2C2C2C]">{{ data.solarDate }}（{{ data.lunarDate }}）</text>
              <view @click="showEditModal=true" class="ml-auto p-0.5 text-[#999]"><text>✏️</text></view>
            </view>
            <view class="px-3 py-2 text-sm flex gap-2 border-b border-[#E8E0D5]">
              <text class="text-[#C41E3A] font-medium shrink-0">真太阳时</text>
              <text class="text-[#999]">{{ data.realSolarTime }}</text>
            </view>
            <view class="px-3 py-2 text-sm flex gap-2">
              <text class="text-[#C41E3A] font-medium shrink-0">节气</text>
              <text class="text-[#999]">{{ data.jieQi }}</text>
            </view>
          </view>

          <!-- 四柱主表 -->
          <view class="bg-white rounded-lg border border-[#E8E0D5] overflow-hidden">
            <view class="text-center">
              <view class="flex bg-[#C41E3A]/5 text-sm py-2">
                <view class="w-[52px] text-sm font-semibold text-[#C41E3A]"><text>四柱</text></view>
                <view v-for="(n,i) in colNames" :key="i" class="flex-1 text-sm font-semibold" :class="i===2?'text-[#C41E3A]':'text-[#2C2C2C]'"><text>{{ n }}</text></view>
              </view>
              <!-- 十神 -->
              <view class="flex border-t border-[#E8E0D5] text-sm py-1.5">
                <view class="w-[52px] text-[#C41E3A] font-medium"><text>十神</text></view>
                <view v-for="k in cols" :key="k" class="flex-1 text-[#999]"><text>{{ data.siZhu[k].shiShen }}</text></view>
              </view>
              <!-- 天干 -->
              <view class="flex bg-[#F5F1EB]/20 py-3">
                <view class="w-[52px] text-[#C41E3A] font-medium"><text>{{ data.qianKun }}</text></view>
                <view v-for="k in cols" :key="k" class="flex-1">
                  <text class="text-2xl font-black block leading-tight" :class="wxColor(data.siZhu[k].gan)">{{ data.siZhu[k].gan }}</text>
                  <text class="text-2xl font-black block leading-tight" :class="wxColor(data.siZhu[k].zhi)">{{ data.siZhu[k].zhi }}</text>
                </view>
              </view>
              <!-- 藏干 -->
              <view class="flex border-t border-[#E8E0D5] py-1.5 text-sm">
                <view class="w-[52px] text-[#C41E3A] font-medium"><text>藏干</text></view>
                <view v-for="k in cols" :key="k" class="flex-1">
                  <view class="flex justify-center gap-0.5">
                    <text v-for="(c,ci) in data.siZhu[k].cangGan" :key="ci" class="font-bold" :class="wxColor(c.gan)">{{ c.gan }}</text>
                  </view>
                  <view class="flex justify-center gap-0.5 text-[9px] text-[#999]">
                    <text v-for="(c,ci) in data.siZhu[k].cangGan" :key="ci">{{ c.shen }}</text>
                  </view>
                </view>
              </view>
              <!-- 纳音/地势/自坐/空亡 -->
              <template v-for="row in ['naYin','diShi','ziZuo','kongWang']" :key="row">
                <view class="flex border-t border-[#E8E0D5] py-1.5 text-sm">
                  <view class="w-[52px] text-[#C41E3A] font-medium"><text>{{ rowLabels[row] }}</text></view>
                  <view v-for="k in cols" :key="k" class="flex-1 text-[#999]"><text>{{ (data.siZhu[k] as any)[row] }}</text></view>
                </view>
              </template>
              <!-- 神煞 -->
              <view class="flex border-t border-[#E8E0D5] py-1.5 text-sm">
                <view class="w-[52px] text-[#C41E3A] font-medium"><text>神煞</text></view>
                <view v-for="k in cols" :key="k" class="flex-1 text-[#999] text-xs">
                  <text>{{ data.shenSha[k].slice(0,2).join('、') }}{{ data.shenSha[k].length>2 ? '...' : '' }}</text>
                </view>
              </view>
            </view>
            <view @click="showAllShenSha=!showAllShenSha" class="w-full py-2 border-t border-[#E8E0D5] flex items-center justify-center gap-1 text-xs text-[#C41E3A]">
              <text>{{ showAllShenSha ? '收起神煞' : '展开全部神煞' }}</text>
              <text class="text-xs">{{ showAllShenSha ? '▲' : '▼' }}</text>
            </view>
            <view v-if="showAllShenSha" class="border-t border-[#E8E0D5] bg-[#F5F1EB]/20 px-3 py-2.5">
              <view class="grid grid-cols-4 gap-x-2 gap-y-1">
                <view v-for="(k,ci) in cols" :key="k" class="text-center">
                  <text class="text-[#C41E3A] text-xs font-semibold mb-1 block">{{ colNames[ci] }}</text>
                  <text v-for="(s,si) in data.shenSha[k]" :key="si" class="text-[#999] text-xs leading-relaxed block">{{ s }}</text>
                </view>
              </view>
            </view>
          </view>

          <!-- 胎元/命宫/身宫/旺相 -->
          <view class="bg-white rounded-lg border border-[#E8E0D5] overflow-hidden">
            <view class="flex text-center">
              <view v-for="label in ['胎元','命宫','身宫']" :key="label" class="flex-1 py-2">
                <text class="text-lg font-black" :class="wxColor(data[labelMap[label]].gan)">{{ data[labelMap[label]].gan }}</text>
                <text class="text-lg font-black" :class="wxColor(data[labelMap[label]].zhi)">{{ data[labelMap[label]].zhi }}</text>
              </view>
              <view class="flex-1 py-2">
                <view class="flex flex-wrap justify-center gap-1">
                  <text v-for="(st,el) in data.wuxingState" :key="el" class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-semibold" :class="wxBgColor(el)">{{ el }}{{ st }}</text>
                </view>
              </view>
            </view>
            <view class="flex text-xs text-[#999] border-t border-[#E8E0D5] py-1 text-center">
              <view class="flex-1"><text>{{ data.taiYuan.naYin }}</text></view>
              <view class="flex-1"><text>{{ data.mingGong.naYin }}</text></view>
              <view class="flex-1"><text>{{ data.shenGong.naYin }}</text></view>
              <view class="flex-1" />
            </view>
          </view>

          <!-- 起运 -->
          <view class="bg-white rounded-lg border border-[#E8E0D5] px-3 py-2.5 text-sm text-[#999]">
            <text>{{ data.qiYun }}</text>
          </view>

          <!-- 大运 -->
          <view class="bg-white rounded-lg border border-[#E8E0D5] overflow-hidden">
            <view class="flex items-center justify-between px-3 py-2">
              <view class="flex items-center gap-1.5">
                <view class="w-0.5 h-3.5 bg-[#C41E3A] rounded-full" />
                <text class="text-sm font-semibold text-[#2C2C2C]">大运</text>
              </view>
              <text class="text-xs text-[#999]">点击展开流年</text>
            </view>
            <view class="text-center">
              <view class="flex text-[11px] text-[#999] pt-1">
                <view v-for="(d,i) in data.daYun" :key="i" class="flex-1"><text>{{ d.year }}</text></view>
              </view>
              <view class="flex">
                <view v-for="(d,i) in data.daYun" :key="i" @click="expandedDaYun=expandedDaYun===i?null:i"
                      class="flex-1 cursor-pointer transition-colors" :class="d.active?'bg-[#C41E3A]/5':expandedDaYun===i?'bg-[#F5F1EB]':''">
                  <text class="text-xl font-black leading-none" :class="wxColor(d.gan)">{{ d.gan }}</text>
                  <text class="text-[9px] text-[#999] align-top">{{ d.shiShen }}</text>
                </view>
              </view>
              <view class="flex">
                <view v-for="(d,i) in data.daYun" :key="i" @click="expandedDaYun=expandedDaYun===i?null:i"
                      class="flex-1 cursor-pointer transition-colors" :class="d.active?'bg-[#C41E3A]/5':expandedDaYun===i?'bg-[#F5F1EB]':''">
                  <text class="text-xl font-black leading-none" :class="wxColor(d.zhi)">{{ d.zhi }}</text>
                  <text class="text-[9px] text-[#999] align-top">{{ d.shiShenZhi }}</text>
                </view>
              </view>
            </view>
            <!-- 大运展开流年 -->
            <view v-if="expandedDaYun!==null" class="border-t border-[#E8E0D5] p-2.5 bg-[#F5F1EB]/30">
              <view class="flex justify-between items-center mb-2">
                <text class="text-xs text-[#2C2C2C] font-medium">{{ data.daYun[expandedDaYun].year }}-{{ data.daYun[expandedDaYun].year+9 }} 流年</text>
                <view @click="expandedDaYun=null" class="text-xs text-[#C41E3A]"><text>收起</text></view>
              </view>
              <view class="grid grid-cols-5 gap-1.5">
                <view v-for="(ln,li) in expandDaYunLiuNian(data.daYun[expandedDaYun])" :key="li" class="bg-white rounded p-1.5 text-center border border-[#E8E0D5]">
                  <view class="text-[10px] text-[#999]"><text>{{ ln.year }}</text></view>
                  <view><text class="text-base font-bold" :class="wxColor(ln.gan)">{{ ln.gan }}</text></view>
                  <view><text class="text-base font-bold" :class="wxColor(ln.zhi)">{{ ln.zhi }}</text></view>
                  <view class="text-[10px] text-[#999] mt-0.5"><text>{{ ln.age }}岁</text></view>
                </view>
              </view>
            </view>
          </view>

          <!-- 流年 -->
          <view class="bg-white rounded-lg border border-[#E8E0D5] overflow-hidden">
            <view class="flex items-center justify-between px-3 py-2">
              <view class="flex items-center gap-1.5">
                <view class="w-0.5 h-3.5 bg-[#C41E3A] rounded-full" />
                <text class="text-sm font-semibold text-[#2C2C2C]">流年</text>
              </view>
            </view>
            <view class="text-center">
              <view class="flex text-[11px] text-[#999] pt-1">
                <view v-for="(n,i) in data.liuNian" :key="i" class="flex-1"><text>{{ n.year }}</text></view>
              </view>
              <view class="flex">
                <view v-for="(n,i) in data.liuNian" :key="i" class="flex-1" :class="n.active?'bg-[#C41E3A]/5':''">
                  <text class="text-lg font-bold" :class="wxColor(n.gan)">{{ n.gan }}</text>
                  <text class="text-[9px] text-[#999] align-top">{{ n.shiShen }}</text>
                </view>
              </view>
              <view class="flex">
                <view v-for="(n,i) in data.liuNian" :key="i" class="flex-1" :class="n.active?'bg-[#C41E3A]/5':''">
                  <text class="text-lg font-bold" :class="wxColor(n.zhi)">{{ n.zhi }}</text>
                  <text class="text-[9px] text-[#999] align-top">{{ n.shiShenZhi }}</text>
                </view>
              </view>
              <view class="flex text-[10px] text-[#999] pb-1">
                <view v-for="(n,i) in data.liuNian" :key="i" class="flex-1" :class="n.active?'bg-[#C41E3A]/5':''"><text>{{ n.age }}岁</text></view>
              </view>
            </view>
          </view>

          <!-- 古籍参考 -->
          <view class="bg-white rounded-lg border border-[#E8E0D5] overflow-hidden">
            <view class="flex items-center justify-between px-3 py-2">
              <view class="flex items-center gap-1.5">
                <view class="w-0.5 h-3.5 bg-[#C41E3A] rounded-full" />
                <text class="text-sm font-semibold text-[#2C2C2C]">古籍参考</text>
              </view>
              <text class="text-xs text-[#C41E3A]">更多古籍</text>
            </view>
            <view class="grid grid-cols-4 gap-3 px-3 pb-3">
              <view v-for="b in classics" :key="b.id" @click="selectedClassic=selectedClassic===b.id?null:b.id" class="flex flex-col items-center gap-1">
                <view class="relative w-[68px] h-[92px] rounded-sm overflow-hidden shadow-sm" :class="selectedClassic===b.id?'ring-2 ring-primary shadow-md':''">
                  <view class="absolute inset-0 bg-gradient-to-b from-amber-100 via-amber-50 to-amber-100" />
                  <view class="absolute inset-0 opacity-[0.08]" style="background-image:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(120,80,40,0.3) 3px,rgba(120,80,40,0.3) 3.5px)" />
                  <view class="absolute left-0 top-0 bottom-0 w-3 bg-gradient-to-r from-amber-200/80 to-transparent border-r border-amber-300/40" />
                  <view class="absolute left-[4px] top-[14%] w-1 h-1 rounded-full bg-amber-400/50" />
                  <view class="absolute left-[4px] top-[46%] w-1 h-1 rounded-full bg-amber-400/50" />
                  <view class="absolute left-[4px] top-[78%] w-1 h-1 rounded-full bg-amber-400/50" />
                  <view class="absolute left-[14px] right-[6px] top-[10px] bottom-[10px] border border-amber-400/40 rounded-[1px] flex items-center justify-center">
                    <text class="text-[#C41E3A] font-bold text-[11px]" style="writing-mode:vertical-rl">{{ b.name }}</text>
                  </view>
                </view>
                <text class="text-xs leading-tight" :class="selectedClassic===b.id?'text-[#C41E3A] font-semibold':'text-[#999]'">{{ b.name }}</text>
              </view>
            </view>
            <!-- 古籍内容 -->
            <view v-if="selectedClassic && classicsContent[selectedClassic]" class="border-t border-[#E8E0D5] p-3 bg-[#F5F1EB]/30">
              <view class="flex gap-2 mb-2.5">
                <view v-for="m in ['原文','译文','对照']" :key="m" @click="classicMode=m as any"
                      class="px-3 py-1 text-xs rounded-full transition-colors"
                      :class="classicMode===m ? 'bg-[#C41E3A] text-white' : 'bg-white text-[#999] border border-[#E8E0D5]'">
                  <text>{{ m }}</text>
                </view>
              </view>
              <view class="bg-white rounded-lg p-3 border border-[#E8E0D5]">
                <text class="text-sm font-semibold text-[#2C2C2C] mb-1.5 block">{{ classicsContent[selectedClassic].title }}</text>
                <text class="text-sm text-[#999] leading-relaxed whitespace-pre-line block">
                  <template v-if="classicMode==='原文'">{{ classicsContent[selectedClassic].original }}</template>
                  <template v-else-if="classicMode==='译文'">{{ classicsContent[selectedClassic].translation }}</template>
                  <template v-else>
                    <text class="text-[#2C2C2C] font-medium">【原文】</text>{{ classicsContent[selectedClassic].original }}
                    {'\n\n'}
                    <text class="text-[#C41E3A] font-medium">【译文】</text>{{ classicsContent[selectedClassic].translation }}
                  </template>
                </text>
              </view>
            </view>
          </view>

          <!-- AI辅助分析 -->
          <view class="w-full bg-[#C41E3A] text-white py-3 rounded-lg font-medium flex items-center justify-center gap-2 text-center">
            <text>✨</text>
            <text>AI辅助分析</text>
          </view>
        </view>
      </template>

      <!-- 分析模式 -->
      <template v-else>
        <view class="p-2.5 space-y-2">
          <view class="bg-white rounded-lg border border-[#E8E0D5] px-3 py-2.5 flex items-center justify-between">
            <text class="text-sm text-[#2C2C2C]">
              <text class="text-[#C41E3A] font-medium">名称：</text>{{ data.name }}
              <text class="text-[#C41E3A] font-medium ml-3">性别：</text>{{ data.gender }}
              <text class="ml-3">出生于{{ data.solarDate }}（{{ data.lunarDate }}）</text>
            </text>
            <view @click="showEditModal=true" class="p-1 text-[#999]"><text>✏️</text></view>
          </view>

          <!-- 八柱总表 -->
          <view class="bg-white rounded-lg border border-[#E8E0D5] overflow-x-auto">
            <view class="text-sm" style="min-width:560px">
              <view class="flex bg-[#C41E3A]/5 py-1.5">
                <view class="w-9 text-xs text-[#999]" />
                <view v-for="(n,i) in colNames" :key="i" class="flex-1 text-sm font-semibold text-center" :class="i===2?'text-[#C41E3A]':'text-[#2C2C2C]'"><text>{{ n }}</text></view>
                <view v-for="h in ['大运','流年','流月','流日']" :key="h" class="flex-1 text-sm font-semibold text-[#2C2C2C] text-center bg-[#F5F1EB]/40"><text>{{ h }}</text></view>
              </view>
              <view class="flex border-t border-[#E8E0D5] text-xs text-[#999] py-0.5">
                <view class="w-9"><text>十神</text></view>
                <view v-for="k in cols" :key="k" class="flex-1 text-center"><text>{{ data.siZhu[k].shiShen }}</text></view>
                <view class="flex-1 text-center bg-[#F5F1EB]/20"><text>{{ analysisDaYun.shiShen }}</text></view>
                <view class="flex-1 text-center bg-[#F5F1EB]/20"><text>{{ analysisLiuNian.shiShen }}</text></view>
                <view class="flex-1 text-center bg-[#F5F1EB]/20"><text>{{ ganShiShen[analysisLiuYue.gan] }}</text></view>
                <view class="flex-1 text-center bg-[#F5F1EB]/20"><text>{{ ganShiShen[analysisLiuRi.gan] }}</text></view>
              </view>
              <view class="flex bg-[#F5F1EB]/10 py-0.5">
                <view class="w-9 text-xs text-[#C41E3A] font-medium"><text>{{ data.qianKun }}</text></view>
                <view v-for="k in cols" :key="k" class="flex-1 text-center"><text class="text-xl font-black" :class="wxColor(data.siZhu[k].gan)">{{ data.siZhu[k].gan }}</text></view>
                <view class="flex-1 text-center bg-[#F5F1EB]/20"><text class="text-xl font-black" :class="wxColor(analysisDaYun.gan)">{{ analysisDaYun.gan }}</text></view>
                <view class="flex-1 text-center bg-[#F5F1EB]/20"><text class="text-xl font-black" :class="wxColor(analysisLiuNian.gan)">{{ analysisLiuNian.gan }}</text></view>
                <view class="flex-1 text-center bg-[#F5F1EB]/20"><text class="text-xl font-black" :class="wxColor(analysisLiuYue.gan)">{{ analysisLiuYue.gan }}</text></view>
                <view class="flex-1 text-center bg-[#F5F1EB]/20"><text class="text-xl font-black" :class="wxColor(analysisLiuRi.gan)">{{ analysisLiuRi.gan }}</text></view>
              </view>
              <view class="flex bg-[#F5F1EB]/10 py-0.5">
                <view class="w-9" />
                <view v-for="k in cols" :key="k" class="flex-1 text-center"><text class="text-xl font-black" :class="wxColor(data.siZhu[k].zhi)">{{ data.siZhu[k].zhi }}</text></view>
                <view class="flex-1 text-center bg-[#F5F1EB]/20"><text class="text-xl font-black" :class="wxColor(analysisDaYun.zhi)">{{ analysisDaYun.zhi }}</text></view>
                <view class="flex-1 text-center bg-[#F5F1EB]/20"><text class="text-xl font-black" :class="wxColor(analysisLiuNian.zhi)">{{ analysisLiuNian.zhi }}</text></view>
                <view class="flex-1 text-center bg-[#F5F1EB]/20"><text class="text-xl font-black" :class="wxColor(analysisLiuYue.zhi)">{{ analysisLiuYue.zhi }}</text></view>
                <view class="flex-1 text-center bg-[#F5F1EB]/20"><text class="text-xl font-black" :class="wxColor(analysisLiuRi.zhi)">{{ analysisLiuRi.zhi }}</text></view>
              </view>
              <view class="flex border-t border-[#E8E0D5] text-xs py-1">
                <view class="w-9 text-[#C41E3A] font-medium"><text>藏干</text></view>
                <view v-for="k in cols" :key="k" class="flex-1 text-center">
                  <view class="flex justify-center gap-0.5">
                    <text v-for="(c,ci) in data.siZhu[k].cangGan" :key="ci" class="font-bold" :class="wxColor(c.gan)">{{ c.gan }}</text>
                  </view>
                  <view class="flex justify-center gap-0.5 text-[10px] text-[#999]">
                    <text v-for="(c,ci) in data.siZhu[k].cangGan" :key="ci">{{ c.shen }}</text>
                  </view>
                </view>
                <view v-for="item in [analysisDaYun,analysisLiuNian,analysisLiuYue,analysisLiuRi]" :key="item.zhi" class="flex-1 text-center bg-[#F5F1EB]/20">
                  <view class="flex justify-center gap-0.5"><text v-for="(c,ci) in zhiCangGan[item.zhi]||[]" :key="ci" class="font-bold" :class="wxColor(c.gan)">{{ c.gan }}</text></view>
                  <view class="flex justify-center gap-0.5 text-[10px] text-[#999]"><text v-for="(c,ci) in zhiCangGan[item.zhi]||[]" :key="ci">{{ c.shen }}</text></view>
                </view>
              </view>
            </view>
