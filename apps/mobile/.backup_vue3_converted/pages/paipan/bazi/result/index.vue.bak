                <view class="w-4.5 h-4.5 rounded-full border-2 flex items-center justify-center" :class="editGender==='女'?'border-primary':'border-[#E8E0D5]'"><text v-if="editGender==='女'" class="text-[#C41E3A] text-xs">●</text></view>
