    <view class="sticky top-0 z-50 bg-gradient-to-r from-primary to-primary/90 text-white shadow-lg" style="box-shadow:0 2px 12px rgba(196,30,58,0.1)">
      <view class="px-4 h-12 flex items-center justify-between">
        <view @click="goBack" class="flex items-center gap-0.5 text-white/80">
          <text class="text-2xl leading-none">←</text>
          <text class="text-sm">返回</text>
