<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- 顶部导航 -->
    <header class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 h-12">
        <view @click="goBack" class="p-1 -ml-1">
          <text class="text-2xl leading-none text-[#2C2C2C]">←</text>
        </view>
        <text class="text-base font-bold text-[#2C2C2C]">排盘记录</text>
        <view @click="showMenu = !showMenu" class="p-1 -mr-1 relative">
          <text class="text-lg text-[#2C2C2C]">⋮</text>
        </view>
      </view>

      <!-- 下拉菜单 -->
      <view v-if="showMenu">
        <view class="fixed inset-0 z-10" @click="showMenu = false" />
        <view class="absolute right-3 top-12 bg-white rounded-xl shadow-xl z-20 py-2 min-w-[140px] animate-fade-in-down">
          <view @click="goGroups" class="w-full flex items-center gap-3 px-4 py-2.5 text-[#2C2C2C]/80 hover:bg-secondary/50 transition-colors">
            <text class="text-sm text-[#999]">👥</text>
            <text class="text-sm">分组管理</text>
          </view>
          <view @click="setSelectMode('group')" class="w-full flex items-center gap-3 px-4 py-2.5 text-[#2C2C2C]/80 hover:bg-secondary/50 transition-colors">
            <text class="text-sm text-[#999]">📁</text>
            <text class="text-sm">修改分组</text>
          </view>
          <view @click="setSelectMode('pin')" class="w-full flex items-center gap-3 px-4 py-2.5 text-[#2C2C2C]/80 hover:bg-secondary/50 transition-colors">
            <text class="text-sm text-[#999]">📌</text>
            <text class="text-sm">批量置顶</text>
          </view>
          <view @click="setSelectMode('delete')" class="w-full flex items-center gap-3 px-4 py-2.5 text-[#2C2C2C]/80 hover:bg-secondary/50 transition-colors">
            <text class="text-sm text-[#999]">🗑️</text>
            <text class="text-sm">批量删除</text>
          </view>
        </view>
      </view>
    </header>

    <!-- 分组标签 -->
    <view class="px-4 py-3 border-b border-[#E8E0D5]">
      <scroll-view scroll-x class="flex gap-2" style="white-space:nowrap">
        <view v-for="group in groups" :key="group"
          @click="activeGroup = group"
          class="inline-flex px-4 py-1.5 rounded-full text-sm transition-colors"
          :class="activeGroup === group ? 'bg-[#C41E3A] text-white font-medium' : 'bg-[#F5F1EB]/50 text-[#999]'"
        >
          <text>{{ group }}</text>
        </view>
      </scroll-view>
    </view>

    <!-- 搜索栏 -->
    <view class="px-4 py-3 border-b border-[#E8E0D5]">
      <view class="relative">
        <text class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-[#999]">🔍</text>
        <input
          type="text"
          :value="searchQuery"
          @input="(e:any) => { searchQuery = e.detail.value }"
          placeholder="搜索事项、时间、局数..."
          class="w-full pl-9 pr-4 py-2.5 bg-[#F5F1EB]/50 rounded-full text-sm text-[#2C2C2C] placeholder:text-[#999] box-border"
        />
      </view>
    </view>

    <!-- 记录列表 -->
    <scroll-view scroll-y class="flex-1 px-4 py-3">
      <view v-if="filteredRecords.length === 0" class="flex flex-col items-center justify-center" style="height:16rem">
        <text class="text-lg text-[#999] mb-2">暂无记录</text>
        <text class="text-sm text-[#999]">开始排盘后，记录会显示在这里</text>
      </view>
      <view v-else class="space-y-3">
        <view v-for="record in filteredRecords" :key="record.id"
          class="bg-white rounded-xl overflow-hidden transition-all"
          :class="[
            selectMode !== 'none' ? 'cursor-pointer' : '',
            selectedIds.includes(record.id) ? 'ring-2 ring-primary' : '',
            record.pinned ? 'bg-amber-50/30' : '',
          ]"
          style="border:1px solid rgba(232,224,213,0.6)"
          @click="onRecordClick(record)"
        >
          <view class="flex">
            <view class="w-1 shrink-0" style="background:linear-gradient(180deg,#60a5fa,#6366f1)" />
            <view class="p-4 flex-1">
              <view class="flex items-start gap-3">
                <!-- 选择模式复选框 -->
                <view v-if="selectMode !== 'none'" @click.stop="toggleSelect(record.id)">
                  <view class="w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 mt-0.5 transition-all"
                    :class="selectedIds.includes(record.id) ? 'border-primary bg-[#C41E3A]' : 'border-[#E8E0D5]'"
                  >
                    <text v-if="selectedIds.includes(record.id)" class="text-white text-xs leading-none">✓</text>
                  </view>
                </view>

                <!-- 记录内容 -->
                <view class="flex-1">
                  <view class="flex items-center justify-between mb-2">
                    <view class="flex items-center gap-2">
                      <text v-if="record.pinned" class="text-sm text-amber-500">📌</text>
                      <text class="text-base font-semibold text-[#2C2C2C]">{{ record.matter || '未命名事项' }}</text>
                    </view>
                    <text class="text-[10px] text-[#C41E3A] px-2 py-0.5 rounded-full font-medium" style="background:rgba(196,30,58,0.1)">{{ record.group }}</text>
                  </view>
                  <view class="flex items-center gap-3 text-sm">
                    <text class="text-[#999]">{{ record.dateTime }}</text>
                    <text class="text-[#C41E3A] font-semibold px-2 py-0.5 rounded" style="background:rgba(196,30,58,0.05)">{{ record.ju }}</text>
                    <text class="text-[#999] text-xs">{{ record.panMethod }}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 批量操作栏 - 删除 -->
    <view v-if="selectMode === 'delete'" class="sticky bottom-0 bg-white border-t border-[#E8E0D5] px-4 py-3 flex items-center gap-3">
      <view @click="selectAll" class="flex items-center gap-2">
        <view class="w-5 h-5 rounded-full border-2 flex items-center justify-center transition-all"
          :class="selectedIds.length === filteredRecords.length && filteredRecords.length > 0 ? 'border-primary bg-[#C41E3A]' : 'border-[#E8E0D5]'"
        >
          <text v-if="selectedIds.length === filteredRecords.length && filteredRecords.length > 0" class="text-white text-xs leading-none">✓</text>
        </view>
        <text class="text-sm text-[#2C2C2C]/80">全选</text>
      </view>
      <view class="flex-1 flex gap-3 justify-end">
        <view @click="cancelSelect" class="px-6 py-2.5 text-sm font-medium text-[#999] bg-[#F5F1EB] rounded-full">取消</view>
        <view @click="handleDelete" class="px-6 py-2.5 text-sm font-medium text-white bg-red-500 rounded-full"
          :class="selectedIds.length > 0 ? '' : 'opacity-40'"
        >删除 {{ selectedIds.length > 0 ? `(${selectedIds.length })` : '' }}</view>
      </view>
    </view>

    <!-- 批量操作栏 - 置顶 -->
    <view v-if="selectMode === 'pin'" class="sticky bottom-0 bg-white border-t border-[#E8E0D5] px-4 py-3 flex items-center gap-3">
      <view @click="selectAll" class="flex items-center gap-2">
        <view class="w-5 h-5 rounded-full border-2 flex items-center justify-center transition-all"
          :class="selectedIds.length === filteredRecords.length && filteredRecords.length > 0 ? 'border-primary bg-[#C41E3A]' : 'border-[#E8E0D5]'"
        >
          <text v-if="selectedIds.length === filteredRecords.length && filteredRecords.length > 0" class="text-white text-xs leading-none">✓</text>
        </view>
        <text class="text-sm text-[#2C2C2C]/80">全选</text>
      </view>
      <view class="flex-1 flex gap-3 justify-end">
        <view @click="cancelSelect" class="px-6 py-2.5 text-sm font-medium text-[#999] bg-[#F5F1EB] rounded-full">取消</view>
        <view @click="handlePin" class="px-6 py-2.5 text-sm font-medium text-white bg-[#C41E3A] rounded-full"
          :class="selectedIds.length > 0 ? '' : 'opacity-40'"
        >置顶 {{ selectedIds.length > 0 ? `(${selectedIds.length})` : '' }}</view>
      </view>
    </view>

    <!-- 批量操作栏 - 修改分组 -->
    <view v-if="selectMode === 'group'" class="sticky bottom-0 bg-white border-t border-[#E8E0D5] px-4 py-3 flex items-center gap-3">
      <view @click="selectAll" class="flex items-center gap-2">
        <view class="w-5 h-5 rounded-full border-2 flex items-center justify-center transition-all"
          :class="selectedIds.length === filteredRecords.length && filteredRecords.length > 0 ? 'border-primary bg-[#C41E3A]' : 'border-[#E8E0D5]'"
        >
          <text v-if="selectedIds.length === filteredRecords.length && filteredRecords.length > 0" class="text-white text-xs leading-none">✓</text>
        </view>
        <text class="text-sm text-[#2C2C2C]/80">全选</text>
      </view>
      <view class="flex-1 flex gap-2 justify-end">
        <view @click="cancelSelect" class="px-6 py-2.5 text-sm font-medium text-[#999] bg-[#F5F1EB] rounded-full">取消</view>
        <view @click="showGroupPicker = true" class="px-6 py-2.5 text-sm font-medium text-white bg-[#C41E3A] rounded-full"
          :class="selectedIds.length > 0 ? '' : 'opacity-40'"
        >移动到分组</view>
      </view>
    </view>

    <!-- 分组选择弹窗 -->
    <view v-if="showGroupPicker" class="fixed inset-0 bg-black/40 z-50 flex items-end" @click="showGroupPicker = false">
      <view class="bg-white w-full rounded-t-2xl overflow-hidden" @click.stop>
        <view class="px-4 py-4 border-b border-[#E8E0D5] text-center">
          <text class="text-base font-semibold text-[#2C2C2C]">选择分组</text>
        </view>
        <scroll-view scroll-y class="max-h-[50vh]">
          <view v-for="g in groups.filter((g:string) => g !== '全部')" :key="g"
            @click="handleChangeGroup(g)"
            class="w-full px-4 py-4 text-left text-[#2C2C2C] border-b border-[#E8E0D5]/60 last:border-b-0 hover:bg-secondary/50 transition-colors"
          >
            <text>{{ g }}</text>
          </view>
        </scroll-view>
        <view class="p-4 border-t border-[#E8E0D5]">
          <view @click="showGroupPicker = false" class="w-full py-3 bg-[#F5F1EB] text-[#999] rounded-full font-medium text-center">取消</view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

const groups = ['全部', '工作事业', '财运投资', '感情婚姻', '健康出行', '其他']

interface Record {
  id: number; dateTime: string; matter: string; ju: string;
  panMethod: string; createdAt: string; group: string; pinned: boolean;
}

const mockRecords: Record[] = [
  { id: 1, dateTime: '2026-05-17 13:38', matter: '求财运势', ju: '阳遁3局', panMethod: '飞盘', createdAt: '2026-05-17', group: '财运投资', pinned: false },
  { id: 2, dateTime: '2026-05-16 09:20', matter: '出行吉凶', ju: '阴遁5局', panMethod: '转盘', createdAt: '2026-05-16', group: '健康出行', pinned: true },
  { id: 3, dateTime: '2026-05-15 15:45', matter: '合作洽谈', ju: '阳遁7局', panMethod: '飞盘', createdAt: '2026-05-15', group: '工作事业', pinned: false },
  { id: 4, dateTime: '2026-05-14 11:00', matter: '', ju: '阴遁2局', panMethod: '飞盘', createdAt: '2026-05-14', group: '其他', pinned: false },
  { id: 5, dateTime: '2026-05-13 08:30', matter: '面试求职', ju: '阳遁1局', panMethod: '转盘', createdAt: '2026-05-13', group: '工作事业', pinned: true },
]

type SelectMode = 'none' | 'delete' | 'pin' | 'group'

const searchQuery = ref('')
const activeGroup = ref('全部')
const showMenu = ref(false)
const selectMode = ref<SelectMode>('none')
const selectedIds = ref<number[]>([])
const records = ref<Record[]>(mockRecords)
const showGroupPicker = ref(false)

const filteredRecords = computed(() => {
  return records.value
    .filter(record =>
      (activeGroup.value === '全部' || record.group === activeGroup.value) &&
      (record.matter.includes(searchQuery.value) ||
       record.dateTime.includes(searchQuery.value) ||
       record.ju.includes(searchQuery.value))
    )
    .sort((a, b) => {
      if (a.pinned && !b.pinned) return -1
      if (!a.pinned && b.pinned) return 1
      return 0
    })
})

function toggleSelect(id: number) {
  const idx = selectedIds.value.indexOf(id)
  if (idx >= 0) selectedIds.value.splice(idx, 1)
  else selectedIds.value.push(id)
}

function selectAll() {
  if (selectedIds.value.length === filteredRecords.value.length) {
    selectedIds.value = []
  } else {
    selectedIds.value = filteredRecords.value.map(r => r.id)
  }
}

function cancelSelect() {
  selectMode.value = 'none'
  selectedIds.value = []
}

function handleDelete() {
  records.value = records.value.filter(r => !selectedIds.value.includes(r.id))
  cancelSelect()
}

function handlePin() {
  records.value = records.value.map(r =>
    selectedIds.value.includes(r.id) ? { ...r, pinned: true } : r
  )
  cancelSelect()
}

function handleChangeGroup(newGroup: string) {
  records.value = records.value.map(r =>
    selectedIds.value.includes(r.id) ? { ...r, group: newGroup } : r
  )
  showGroupPicker.value = false
  cancelSelect()
}

function setSelectMode(mode: SelectMode) {
  selectMode.value = mode
  showMenu.value = false
}

function onRecordClick(record: Record) {
  if (selectMode.value !== 'none') {
    toggleSelect(record.id)
  } else {
    uni.navigateTo({
      url: `/pages/paipan/qimen/result/index?matter=${encodeURIComponent(record.matter)}&ju=${encodeURIComponent(record.ju)}`
    })
  }
}

function goBack() { uni.navigateBack() }
function goGroups() { uni.navigateTo({ url: '/pages/paipan/qimen/history/groups/index' }) }
</script>

<style scoped>
.animate-fade-in-down {
  animation: fadeInDown 0.2s ease-out;
}
@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-4px); }
  to { opacity: 1; transform: translateY(0); }
}
</style>
