      <view class="absolute top-14 left-4">
        <view class="px-2 py-0.5 rounded text-xs text-white" :style="{ backgroundColor: courseData.type === 'free' ? '#22C55E' : '#C41E3A' }">
          <text>{{ courseData.type === 'free' ? '公益课程' : '收费课程' }}</text>
        </view>
