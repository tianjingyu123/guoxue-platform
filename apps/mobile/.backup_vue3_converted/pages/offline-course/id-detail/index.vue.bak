          <view class="flex items-center gap-2">
            <view class="w-8 h-8 rounded-full flex items-center justify-center text-xs" style="background-color:#F1EDE8;color:#2C2C2C">
              <text>{{ review.user?.charAt(0) || '用' }}</text>
            </view>
            <view class="flex-1">
              <text class="text-sm font-medium text-[#2C2C2C] block">{{ review.user }}</text>
              <view class="flex items-center gap-0.5 mt-0.5">
                <text v-for="s in 5" :key="s" class="text-xs" :style="{ color: s <= review.rating ? '#C9A96E' : 'rgba(153,153,153,0.3)' }">⭐</text>
              </view>
            </view>
            <text class="text-xs text-[#999]">{{ review.date }}</text>
          </view>
          <text class="text-sm text-[#999] mt-2 block">{{ review.content }}</text>
        </view>
      </view>
    </view>

    <!-- 温馨提示 -->
    <view class="px-4 mt-4 pb-28">
      <text class="font-semibold text-base text-[#2C2C2C] block mb-3">温馨提示</text>
      <view class="bg-white rounded-xl p-4 border border-[#E8E0D5]" style="background-color:rgba(241,237,232,0.3)">
        <view class="space-y-2">
          <view v-for="(tip, idx) in courseData.tips" :key="idx" class="flex items-start gap-2 text-sm text-[#999]">
            <text class="text-lg shrink-0 mt-0.5" style="color:#C9A96E">⚠️</text>
            <text>{{ tip }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="fixed bottom-0 left-0 right-0 bg-white border-t border-[#E8E0D5] px-4 flex items-center gap-3" style="height:64rpx;padding-bottom:env(safe-area-inset-bottom);height:calc(64rpx + env(safe-area-inset-bottom))">
      <view class="flex flex-col items-center justify-center" style="width:48rpx">
        <text class="text-[#999]">📞</text>
        <text class="text-[10px] text-[#999] mt-0.5">咨询</text>
      </view>

      <view
        v-if="isEnrolled"
        class="flex-1 py-3 rounded-xl text-sm text-center text-white font-semibold"
        style="background-color:#22C55E"
        @click="showSuccessModal = true"
      >
        <text>查看签到码</text>
      </view>
      <view
        v-else
        class="flex-1 py-3 rounded-xl text-sm text-center text-white font-semibold"
        :style="{ backgroundColor: courseData.remainingSeats === 0 ? '#F1EDE8' : '#C41E3A', color: courseData.remainingSeats === 0 ? '#999' : '#fff' }"
        @click="handleEnroll"
      >
        <text>{{ courseData.remainingSeats === 0 ? '名额已满' : courseData.type === 'paid' ? '立即报名 ¥' + courseData.price : '免费报名' }}</text>
      </view>
    </view>

    <!-- 支付弹窗 -->
    <view v-if="showPayModal" class="fixed inset-0 z-50 flex items-end justify-center" style="background-color:rgba(0,0,0,0.6)">
      <view class="w-full max-w-lg bg-white rounded-t-2xl">
        <view class="flex items-center justify-between p-4 border-b border-[#E8E0D5]">
          <text class="font-semibold text-[#2C2C2C]">确认报名</text>
          <view class="p-1" @click="showPayModal = false">
            <text class="text-[#999]">✕</text>
          </view>
        </view>

        <view class="p-4">
          <view class="flex items-center gap-3 p-3 rounded-xl mb-4" style="background-color:#F1EDE8">
            <view class="w-16 h-12 rounded flex items-center justify-center" style="background-color:#F1EDE8">
              <text class="text-lg" style="color:rgba(196,30,58,0.6)">📅</text>
            </view>
            <view class="flex-1 min-w-0">
              <text class="text-sm font-medium text-[#2C2C2C] line-clamp-1 block">{{ courseData.title }}</text>
              <text class="text-xs text-[#999] mt-0.5 block">{{ courseData.date }} {{ courseData.time }}</text>
            </view>
          </view>

          <text class="text-sm font-medium text-[#2C2C2C] block mb-3">选择支付方式</text>
          <view class="space-y-2 mb-4">
            <view
              v-for="method in paymentMethods"
              :key="method.id"
              class="flex items-center gap-3 p-3 rounded-xl border transition-colors"
              :style="{ borderColor: paymentMethod === method.id ? '#C41E3A' : '#E8E0D5', backgroundColor: paymentMethod === method.id ? 'rgba(196,30,58,0.05)' : 'transparent' }"
              @click="paymentMethod = method.id"
            >
              <text class="text-lg">{{ method.icon }}</text>
              <view class="flex-1">
                <text class="text-sm font-medium text-[#2C2C2C]">{{ method.name }}</text>
                <text v-if="method.balance !== undefined" class="text-xs text-[#999] ml-1">余额 {{ method.balance }} 币</text>
              </view>
              <view
                class="w-5 h-5 rounded-full border-2 flex items-center justify-center"
                :style="{ borderColor: paymentMethod === method.id ? '#C41E3A' : 'rgba(153,153,153,0.3)', backgroundColor: paymentMethod === method.id ? '#C41E3A' : 'transparent' }"
              >
                <text v-if="paymentMethod === method.id" class="text-white text-[10px]">✓</text>
              </view>
            </view>
          </view>

          <view class="flex items-center justify-between py-3 border-t border-[#E8E0D5]">
            <text class="text-sm text-[#999]">应付金额</text>
            <text class="text-xl font-bold" style="color:#C41E3A">{{ paymentMethod === 'coin' ? courseData.price * 10 + ' 币' : '¥' + courseData.price }}</text>
          </view>

          <view class="w-full py-3 rounded-xl text-sm text-center text-white font-semibold mt-2" style="background-color:#C41E3A" @click="handlePay">
            <text>确认支付</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 报名成功弹窗 -->
    <view v-if="showSuccessModal" class="fixed inset-0 z-50 flex items-center justify-center p-4" style="background-color:rgba(0,0,0,0.6)">
      <view class="w-full max-w-sm bg-white rounded-2xl overflow-hidden">
        <view class="p-6 text-center" style="background:linear-gradient(to bottom right,#22C55E,#16A34A)">
          <view class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-3" style="background-color:rgba(255,255,255,0.2)">
            <text class="text-3xl text-white">✅</text>
          </view>
          <text class="text-lg font-bold text-white block">报名成功</text>
          <text class="text-sm text-white/80 block mt-1">请保存签到码，到场签到使用</text>
        </view>

        <view class="p-6">
          <view class="rounded-xl p-4 text-center" style="background-color:#F1EDE8">
            <view class="w-40 h-40 bg-white rounded-lg mx-auto flex items-center justify-center mb-3">
              <text class="text-6xl text-[#2C2C2C]">📱</text>
            </view>
            <text class="text-sm text-[#2C2C2C] font-medium block">{{ courseData.title }}</text>
            <text class="text-xs text-[#999] mt-1 block">{{ courseData.date }} {{ courseData.time }}</text>
            <text class="text-xs text-[#999] mt-1 block">签到码：RB20260515001</text>
          </view>

          <view class="flex items-center gap-3 mt-4">
            <view class="flex-1 flex items-center justify-center gap-2 py-2.5 border border-[#E8E0D5] rounded-xl text-sm text-[#2C2C2C]" @click="handleCopyCode">
              <text>📋</text>
              <text>复制签到码</text>
            </view>
            <view class="flex-1 flex items-center justify-center gap-2 py-2.5 border border-[#E8E0D5] rounded-xl text-sm text-[#2C2C2C]">
              <text>⬇️</text>
              <text>保存图片</text>
            </view>
          </view>

          <view class="w-full py-3 rounded-xl text-sm text-center text-white font-semibold mt-4" style="background-color:#C41E3A" @click="showSuccessModal = false">
            <text>我知道了</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref } from 'vue'

const isEnrolled = ref(false)
const showPayModal = ref(false)
const showSuccessModal = ref(false)
const paymentMethod = ref<'coin' | 'wechat' | 'alipay'>('wechat')
const isCollected = ref(false)

const paymentMethods = [
  { id: 'wechat', name: '微信支付', icon: '💳' },
  { id: 'alipay', name: '支付宝', icon: '💰' },
  { id: 'coin', name: '国学币支付', icon: '🪙', balance: 1280 },
]

const courseData = {
  id: 1,
  title: '八字命理入门实战班（第12期）',
  cover: '',
  type: 'paid',
  price: 299,
  originalPrice: 599,
  totalSeats: 30,
  remainingSeats: 8,
  enrolledCount: 22,
  date: '2026年5月15日',
  time: '09:00 - 17:00',
  duration: '1天（8课时）',
  location: {
    name: '热卜国学·北京朝阳驿站',
    address: '北京市朝阳区建国路88号SOHO现代城A座1208室',
    phone: '010-88888888',
  },
  instructor: {
    name: '周易大师',
    title: '资深命理师',
    intro: '从业20年，曾任多家上市公司命理顾问，累计咨询案例超10000例。擅长八字精批、事业财运分析、婚姻感情指导。',
    rating: 4.9,
    students: 3560,
  },
  description: '本期课程为八字命理入门实战班，适合零基础学员系统学习八字排盘与分析方法。\n\n课程内容：\n1. 天干地支基础知识\n2. 八字排盘实操演练\n3. 十神体系与命局分析\n4. 大运流年推断方法\n5. 实战案例分析与点评',
  tips: [
    '请提前15分钟到场签到',
    '自备笔记本和笔，讲义现场发放',
    '如需退款，请在开课前24小时申请',
    '报名后不可转让，如有特殊情况请联系客服',
  ],
  reviews: [
    { id: 1, user: '易学小白', rating: 5, content: '老师讲得很清楚，零基础也能听懂，收获满满！', date: '2026-04-20' },
    { id: 2, user: '命理爱好者', rating: 5, content: '实战案例很多，学完就能上手分析，推荐！', date: '2026-04-18' },
  ],
}

function handleEnroll() {
  if (courseData.type === 'free') {
    isEnrolled.value = true
    showSuccessModal.value = true
  } else {
    showPayModal.value = true
  }
}

function handlePay() {
  showPayModal.value = false
  isEnrolled.value = true
  showSuccessModal.value = true
}

function handleCopyCode() {
  uni.setClipboardData({ data: 'RB20260515001' })
  uni.showToast({ title: '已复制', icon: 'success' })
}

function handleShare() {
  uni.setClipboardData({ data: 'https://rebu.com/offline-course/' + courseData.id })
  uni.showToast({ title: '链接已复制', icon: 'success' })
}

function handleNavigate() {
  uni.showToast({ title: '导航功能开发中', icon: 'none' })
}

function handleCall() {
  uni.makePhoneCall({ phoneNumber: courseData.location.phone })
}

function goToReviews() {
  uni.navigateTo({ url: '/pages/offline-course/reviews/index' })
}

function goBack() { uni.navigateBack() }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
