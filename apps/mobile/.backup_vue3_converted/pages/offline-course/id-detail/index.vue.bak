              <text class="font-semibold text-[#2C2C2C]">{{ courseData.instructor.name }}</text>
              <view class="px-1.5 py-0.5 rounded text-[10px]" style="background-color:rgba(201,169,110,0.2);color:#C9A96E">
                <text>V</text>
              </view>
            </view>
            <text class="text-xs text-[#999] mt-0.5 block">{{ courseData.instructor.title }}</text>
            <view class="flex items-center gap-3 mt-1 text-xs text-[#999]">
              <text class="flex items-center gap-1">⭐ {{ courseData.instructor.rating }}</text>
