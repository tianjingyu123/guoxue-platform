<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-50 bg-white/95 backdrop-blur-lg border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between h-12 px-4">
        <view @click="goBack"><text class="text-xl text-[#2C2C2C]">←</text></view>
        <text class="font-semibold text-base text-[#2C2C2C]">消息中心</text>
        <view @click="handleMarkAllAsRead" class="text-xs text-[#C41E3A]">全部已读</view>
      </view>

      <!-- Tab导航 -->
      <view class="flex items-center px-4 pb-2 gap-2">
        <view
          v-for="tab in tabs"
          :key="tab.id"
          @click="activeTab = tab.id"
          :class="['flex-1 flex items-center justify-center gap-1.5 py-2 rounded-lg text-sm font-medium relative', activeTab === tab.id ? 'bg-[#C41E3A] text-white' : 'bg-[#F5F1EB] text-[#999]']"
        >
          <text class="text-sm">{{ tab.icon }}</text>
          <text>{{ tab.label }}</text>
          <view v-if="unreadCounts[tab.id] > 0" :class="['absolute -top-1 -right-1 min-w-[18px] h-[18px] rounded-full text-[10px] font-bold flex items-center justify-center', activeTab === tab.id ? 'bg-white text-[#C41E3A]' : 'bg-[#C41E3A] text-white']">
            <text>{{ unreadCounts[tab.id] > 99 ? '99+' : unreadCounts[tab.id] }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view v-if="loading" class="p-4">
      <view v-for="i in 4" :key="i" class="flex gap-2.5 bg-white rounded-xl p-3 mb-2.5 shadow-sm animate-pulse">
        <view class="w-10 h-10 rounded-full bg-[#E8E0D5]" />
        <view class="flex-1 flex flex-col gap-1.5 justify-center">
          <view class="h-3.5 bg-[#E8E0D5] rounded w-3/5" />
          <view class="h-3 bg-[#E8E0D5] rounded w-2/5" />
        </view>
      </view>
    </view>

    <!-- 错误状态 -->
    <view v-else-if="error" class="text-center py-20">
      <text class="text-4xl text-[#E8E0D5] block mb-3">⚠</text>
      <text class="text-[#999] text-sm block mb-4">{{ error }}</text>
      <view @click="fetchData" class="inline-block px-6 py-2 bg-[#C41E3A] text-white rounded-full text-sm">重试</view>
    </view>

    <!-- 消息列表 -->
    <main v-else class="p-4">
      <view v-if="filteredMessages.length === 0" class="text-center py-20">
        <text class="text-4xl text-[#E8E0D5] block mb-3">💬</text>
        <text class="text-[#999] text-sm">暂无消息</text>
      </view>

      <view class="space-y-3">
        <view
          v-for="message in filteredMessages"
          :key="message.id"
          @click="handleMarkAsRead(message)"
          :class="['bg-white rounded-xl p-3 transition-all', !message.isRead ? 'bg-[#C41E3A]/5 border border-[#C41E3A]/20' : 'border border-transparent']"
        >
          <view class="flex gap-3">
            <!-- 头像/图标 -->
            <view class="relative flex-shrink-0">
              <image v-if="message.avatar" :src="message.avatar" mode="aspectFill" class="w-10 h-10 rounded-full" />
              <view v-else class="w-10 h-10 rounded-full bg-[#F5F1EB] flex items-center justify-center">
                <text class="text-lg">{{ getMessageIcon(message.category) }}</text>
              </view>
              <text v-if="!message.isRead" class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-[#C41E3A] ring-2 ring-white" />
            </view>

            <!-- 内容 -->
            <view class="flex-1 min-w-0">
              <view class="flex items-center justify-between gap-2">
                <view class="flex items-center gap-2 min-w-0">
                  <text :class="['text-sm font-medium truncate', !message.isRead ? 'text-[#2C2C2C]' : 'text-[#999]']">
                    {{ message.title }}
                  </text>
                  <view class="text-[10px] px-1.5 py-0 border border-[#E8E0D5] rounded text-[#999] flex-shrink-0">
                    <text>{{ message.category }}</text>
                  </view>
                </view>
                <text class="text-[10px] text-[#999] flex-shrink-0">{{ message.time }}</text>
              </view>
              <text :class="['text-xs mt-1 line-clamp-2 block', !message.isRead ? 'text-[#2C2C2C]/80' : 'text-[#999]']">
                {{ message.content }}
              </text>
            </view>

            <!-- 已读状态 -->
            <view v-if="message.isRead" class="flex-shrink-0 self-center">
              <text class="text-sm text-[#999]/50">✓✓</text>
            </view>
          </view>
        </view>
      </view>
    </main>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

type MessageType = 'interaction' | 'system' | 'income'

interface Message {
  id: number
  title: string
  content: string
  type: MessageType
  category: string
  time: string
  isRead: boolean
  avatar?: string
  link?: string
}

interface MessageUnreadCounts {
  interaction: number
  system: number
  income: number
}

const tabs = [
  { id: 'interaction' as MessageType, label: '互动消息', icon: '💬' },
  { id: 'system' as MessageType, label: '系统通知', icon: '🔔' },
  { id: 'income' as MessageType, label: '收益提醒', icon: '💰' },
]

const activeTab = ref<MessageType>('interaction')
const loading = ref(true)
const error = ref<string | null>(null)
const messages = ref<Message[]>([])
const unreadCounts = ref<MessageUnreadCounts>({ interaction: 0, system: 0, income: 0 })

const filteredMessages = computed(() => messages.value.filter(m => m.type === activeTab.value))

// 获取消息图标
function getMessageIcon(category: string): string {
  const icons: Record<string, string> = {
    '评论': '💬', '点赞': '❤️', '关注': '👤', '加入圈子': '👥',
    '课程上新': '📚', '直播预告': '📻', '会员到期': '🔔', '活动通知': '🎁',
    '课程收益': '💰', '打赏收入': '🎁', '分销收益': '🛍', '提现通知': '✓',
  }
  return icons[category] || '🔔'
}

async function fetchData() {
  loading.value = true
  error.value = null
  try {
    const [messagesRes, countsRes] = await Promise.all([
      getMessages(),
      getUnreadCounts(),
    ])
    if (messagesRes.code === 200) messages.value = messagesRes.data
    if (countsRes.code === 200) unreadCounts.value = countsRes.data
  } catch {
    error.value = '加载失败，请重试'
  } finally {
    loading.value = false
  }
}

async function handleMarkAsRead(message: Message) {
  if (!message.isRead) {
    await markAsRead(message.id)
    messages.value = messages.value.map(m =>
      m.id === message.id ? { ...m, isRead: true } : m
    )
    unreadCounts.value = {
      ...unreadCounts.value,
      [activeTab.value]: Math.max(0, unreadCounts.value[activeTab.value] - 1)
    }
  }
  if (message.link) {
    uni.navigateTo({ url: message.link })
  }
}

async function handleMarkAllAsRead() {
  await markAllAsRead(activeTab.value)
  messages.value = messages.value.map(m =>
    m.type === activeTab.value ? { ...m, isRead: true } : m
  )
  unreadCounts.value = { ...unreadCounts.value, [activeTab.value]: 0 }
  uni.showToast({ title: '已全部标记已读', icon: 'success' })
}

function goBack() { uni.navigateBack() }

// API 桩函数 (Mock 数据)
const mockMessages: Message[] = [
  { id: 1, title: '张大师 赞了你的文章', content: '你的文章《八字命理学习心得》获得了新的点赞', type: 'interaction', category: '点赞', time: '2分钟前', isRead: false, avatar: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=80&q=80' },
  { id: 2, title: '李明华 评论了你的帖子', content: '说得很好，五行生克关系讲解得很透彻，受益匪浅！', type: 'interaction', category: '评论', time: '15分钟前', isRead: false, avatar: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=80&q=80' },
  { id: 3, title: '系统通知', content: '你的账号已通过实名认证，现在可以正常使用所有功能', type: 'system', category: '系统通知', time: '1小时前', isRead: false },
  { id: 4, title: '王老师 关注了你', content: '风水堪舆学院王老师开始关注你的动态', type: 'interaction', category: '关注', time: '2小时前', isRead: false, avatar: 'https://images.unsplash.com/photo-1560250097-0b93528c311a?w=80&q=80' },
  { id: 5, title: '课程上新通知', content: '《紫微飞星进阶秘传》新课上线，林道长主讲，限时优惠458元', type: 'system', category: '课程上新', time: '3小时前', isRead: true },
  { id: 6, title: '收益到账提醒', content: '你的课程分销收益已到账，金额 ¥128.00，可前往钱包查看', type: 'income', category: '课程收益', time: '昨天', isRead: false },
  { id: 7, title: '林道长 邀请你加入圈子', content: '邀请你加入「紫微斗数研习社」，与1800位易友一起交流', type: 'interaction', category: '加入圈子', time: '昨天', isRead: false, avatar: 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=80&q=80' },
  { id: 8, title: '直播预告通知', content: '今晚20:00，赵先生将在直播间讲解奇门遁甲飞盘排盘实战案例', type: 'system', category: '直播预告', time: '昨天', isRead: true },
  { id: 9, title: '打赏收入提醒', content: '用户「易学爱好者」打赏了你的文章 ¥10.00', type: 'income', category: '打赏收入', time: '2天前', isRead: true },
  { id: 10, title: '提现成功通知', content: '你申请的提现 ¥500.00 已处理，预计1-3个工作日到账', type: 'income', category: '提现通知', time: '3天前', isRead: true },
  { id: 11, title: '系统通知', content: '你发布的内容因违反社区规范已被下架，如有疑问请联系客服', type: 'system', category: '系统通知', time: '5天前', isRead: true },
  { id: 12, title: '赵先生 评论了你的文章', content: '案例选得很好，对于初学者来说非常有参考价值', type: 'interaction', category: '评论', time: '1周前', isRead: true, avatar: 'https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=80&q=80' },
]

async function getMessages(): Promise<any> {
  return { code: 200, data: mockMessages }
}
async function getUnreadCounts(): Promise<any> {
  const interaction = mockMessages.filter(m => m.type === 'interaction' && !m.isRead).length
  const system = mockMessages.filter(m => m.type === 'system' && !m.isRead).length
  const income = mockMessages.filter(m => m.type === 'income' && !m.isRead).length
  return { code: 200, data: { interaction, system, income } }
}
async function markAsRead(id: number): Promise<any> {
  return { code: 200 }
}
async function markAllAsRead(type: string): Promise<any> {
  return { code: 200 }
}

onMounted(() => {
  fetchData()
})
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
