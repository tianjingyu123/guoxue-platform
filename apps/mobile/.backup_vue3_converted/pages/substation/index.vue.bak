<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- 导航栏 -->
    <view class="flex items-center justify-between px-4 h-12 bg-white border-b border-[#E8E0D5] shrink-0">
      <view class="p-1" @click="goBack">
        <text class="text-xl text-[#2C2C2C]">←</text>
      </view>
      <text class="text-base font-semibold text-[#2C2C2C]">全部分站</text>
      <view class="w-7 flex items-center justify-center" @click="onMapView">
        <text class="text-lg">📍</text>
      </view>
    </view>

    <!-- 骨架屏 -->
    <view v-if="loading" class="flex-1 p-4">
      <view class="w-full h-10 bg-[#F0EBE5] rounded-xl mb-4 skeleton-pulse" />
      <view v-for="i in 4" :key="i" class="flex gap-3 bg-white rounded-xl p-3.5 mb-3 shadow-sm">
        <view class="w-11 h-11 rounded-full bg-[#F0EBE5] skeleton-pulse shrink-0" />
        <view class="flex-1 space-y-2">
          <view class="h-4 w-28 bg-[#F0EBE5] rounded skeleton-pulse" />
          <view class="h-3 w-40 bg-[#F0EBE5] rounded skeleton-pulse" />
          <view class="h-3 w-32 bg-[#F0EBE5] rounded skeleton-pulse" />
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view v-else-if="filteredList.length === 0" class="flex-1 flex flex-col items-center justify-center p-8">
      <text class="text-5xl mb-4">🔍</text>
      <text class="text-sm text-[#999] mb-2">未找到匹配的分站</text>
      <text class="text-xs text-[#bbb]">试试其他关键词搜索</text>
    </view>

    <!-- 主内容 -->
    <scroll-view v-else scroll-y class="flex-1 overflow-y-auto" refresher-enabled @refresherrefresh="onRefresh" :refresher-triggered="refreshing">
      <!-- 搜索框 -->
      <view class="sticky top-0 z-10 px-4 pt-3 pb-2 bg-[#FAF8F5]">
        <view class="flex items-center gap-2 bg-white rounded-xl px-3.5 h-10 border border-[#E8E0D5]">
          <text class="text-base text-[#999]">🔍</text>
          <input v-model="keyword" placeholder="搜索分站名称或地址" placeholder-class="text-xs text-[#bbb]" class="flex-1 text-sm text-[#2C2C2C]" @input="onSearch" />
          <text v-if="keyword" class="text-base text-[#999] p-1" @click="keyword='';onSearch()">✕</text>
        </view>
      </view>

      <!-- 附近分站推荐 -->
      <view class="px-4 mb-3">
        <view class="flex items-center gap-1 mb-2">
          <text class="text-sm font-semibold text-[#2C2C2C]">📍 附近分站</text>
          <text class="text-xs text-[#C9A96E] font-medium">查看全部 ›</text>
        </view>
        <scroll-view scroll-x class="flex-row gap-3" show-scrollbar="false">
          <view class="flex gap-3 w-max">
            <view v-for="s in nearbyList" :key="s.id" class="bg-gradient-to-br from-[#C9A96E] to-[#D4B87A] rounded-xl p-3 w-[150px] shrink-0" @click="goStation(s.id)">
              <text class="text-white text-sm font-semibold block truncate">{{ s.name }}</text>
              <text class="text-white/80 text-[11px] block mt-1">{{ s.distance }}</text>
              <text class="text-white/70 text-[11px] block">会员 {{ s.members }}人</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- 热门推荐 -->
      <view class="px-4 mb-3">
        <view class="flex items-center gap-1.5 mb-2">
          <text class="text-sm font-semibold text-[#2C2C2C]">🏆 官方推荐</text>
        </view>
        <scroll-view scroll-x class="flex-row" show-scrollbar="false">
          <view class="flex gap-2.5 w-max">
            <view v-for="s in hotStations" :key="'hot-' + s.id" class="bg-gradient-to-br from-[#C41E3A] to-[#E57373] rounded-xl px-3.5 py-2.5 w-[130px] shrink-0" @click="goStation(s.id)">
              <text class="text-white text-sm font-semibold block truncate">{{ s.name }}</text>
              <text class="text-white/70 text-[11px] block mt-0.5">{{ s.members }}会员 · {{ s.teachers }}教师</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- 全部列表标题 -->
      <view class="px-4 mb-2">
        <text class="text-xs font-semibold text-[#2C2C2C]">全部 {{ filteredList.length }} 个分站</text>
      </view>

      <!-- 分站卡片列表 -->
      <view class="px-4 pb-4">
        <view v-for="s in filteredList" :key="s.id" class="flex gap-3 bg-white rounded-xl p-3.5 mb-2.5 shadow-sm active:opacity-80" @click="goStation(s.id)">
          <view class="w-11 h-11 rounded-full bg-gradient-to-br from-[#C9A96E] to-[#D4B87A] text-white flex items-center justify-center text-base font-medium shrink-0">
            {{ s.name[0] }}
          </view>
          <view class="flex-1 min-w-0">
            <view class="flex items-center gap-1.5">
              <text class="text-sm font-medium text-[#2C2C2C] truncate">{{ s.name }}</text>
              <text v-if="s.isOfficial" class="text-[10px] bg-[#C41E3A] text-white px-1.5 py-0.5 rounded leading-none">官方</text>
            </view>
            <text class="text-xs text-[#999] block mt-0.5 truncate">{{ s.address }}</text>
            <view class="flex items-center gap-3 mt-1">
              <text class="text-[11px] text-[#bbb]">👤 {{ s.members }}会员</text>
              <text class="text-[11px] text-[#bbb]">👨‍🏫 {{ s.teachers }}教师</text>
            </view>
          </view>
          <text class="text-base text-[#ccc] self-center">›</text>
        </view>
      </view>

      <!-- 底部信息提示 -->
      <view class="px-4 mb-3">
        <view class="bg-[#F5F1EB] rounded-xl p-3 flex items-center gap-2">
          <text class="text-sm text-[#C9A96E]">💡</text>
          <text class="text-xs text-[#666]">申请创建新分站需填写基本信息，经平台审核通过后方可上线运营</text>
        </view>
      </view>
      <!-- 创建分站入口 -->
      <view class="px-4 pb-8">
        <view class="flex items-center justify-center gap-2 py-3.5 border-2 border-dashed border-[#E8E0D5] rounded-xl bg-white" @click="onCreate">
          <text class="text-lg text-[#C9A96E]">✚</text>
          <text class="text-sm text-[#C9A96E] font-medium">创建新分站</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

const loading = ref(true)
const refreshing = ref(false)
const keyword = ref('')

interface Station {
  id: string
  name: string
  address: string
  members: number
  teachers: number
  distance?: string
  isOfficial?: boolean
}

const allList = ref<Station[]>([
  { id: '1', name: '北京朝阳分站', address: '北京市朝阳区建国路88号', members: 356, teachers: 12, isOfficial: true },
  { id: '2', name: '北京海淀分站', address: '北京市海淀区中关村大街18号', members: 218, teachers: 8 },
  { id: '3', name: '上海静安分站', address: '上海市静安区南京西路1266号', members: 189, teachers: 6 },
  { id: '4', name: '广州天河分站', address: '广州市天河区天河路385号', members: 267, teachers: 10 },
  { id: '5', name: '深圳南山分站', address: '深圳市南山区科技南路18号', members: 145, teachers: 5 },
  { id: '6', name: '杭州西湖分站', address: '杭州市西湖区文三路478号', members: 198, teachers: 7 },
  { id: '7', name: '成都锦江分站', address: '成都市锦江区红星路三段99号', members: 234, teachers: 9, isOfficial: true },
  { id: '8', name: '武汉光谷分站', address: '武汉市洪山区珞喻路726号', members: 167, teachers: 4 },
  { id: '9', name: '南京鼓楼分站', address: '南京市鼓楼区中山北路200号', members: 198, teachers: 6 },
  { id: '10', name: '重庆渝中分站', address: '重庆市渝中区解放碑步行街', members: 223, teachers: 8, isOfficial: true },
  { id: '11', name: '西安雁塔分站', address: '西安市雁塔区小寨东路', members: 156, teachers: 5 },
])

const nearbyList = computed(() => {
  return allList.value.filter(s => s.isOfficial).slice(0, 3).map((s, i) => ({
    ...s,
    distance: i === 0 ? '距离 1.2km' : i === 1 ? '距离 3.5km' : '距离 5.8km',
  }))
})

const filteredList = computed(() => {
  if (!keyword.value) return allList.value
  const kw = keyword.value.toLowerCase()
  return allList.value.filter(s => s.name.includes(kw) || s.address.includes(kw))
})

function onSearch() {
  /* 搜索由 computed 自动处理 */
}

function onRefresh() {
  refreshing.value = true
  setTimeout(() => { refreshing.value = false }, 1000)
}

function goBack() { uni.navigateBack() }

function goStation(id: string) {
  uni.navigateTo({ url: `/pages/station/index?id=${id}` })
}

/** 热门推荐 - 取前4个有官方标记的分站 */
const hotStations = computed(() => allList.value.filter(s => s.isOfficial).slice(0, 4))

function onCreate() {
  uni.showToast({ title: '创建分站功能即将开放', icon: 'none' })
}

function onMapView() {
  uni.showToast({ title: '地图视图即将开放', icon: 'none' })
}

// 加载骨架
setTimeout(() => { loading.value = false }, 1000)
</script>

<style scoped>
.skeleton-pulse {
  animation: pulse 1.5s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.8; }
}
/* 样式由 Tailwind 处理 */
</style>
