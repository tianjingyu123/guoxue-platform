<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <header class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5] flex items-center px-4 h-12 gap-3">
      <view @click="goBack" class="p-1"><text class="text-xl text-[#2C2C2C]">←</text></view>
      <text class="text-base font-semibold text-[#2C2C2C]">续费会员</text>
    </header>

    <!-- 当前状态 -->
    <view class="mx-4 mt-4 p-4 rounded-xl flex items-center gap-3" style="background:rgba(251,191,36,0.1);border:1px solid rgba(251,191,36,0.3)">
      <text class="text-3xl text-amber-500 shrink-0">👑</text>
      <view>
        <text class="text-sm font-semibold text-[#2C2C2C] block">专业会员</text>
        <text class="text-xs text-[#999] mt-0.5 flex items-center gap-1">
          <text class="text-orange-500">⚠️</text>
          到期时间：2024-02-20（还剩 30 天）
        </text>
      </view>
    </view>

    <view class="px-4 mt-6">
      <text class="text-sm font-semibold text-[#2C2C2C] block mb-3">选择续费时长</text>

      <!-- 方案选择 -->
      <view class="grid grid-cols-3 gap-3 mb-6">
        <view v-for="p in plans" :key="p.id" @click="selected = p.id"
          class="relative flex flex-col items-center py-4 px-2 rounded-xl transition-all"
          :style="selected === p.id ? 'border:2px solid #C41E3A;background:rgba(196,30,58,0.05)' : 'border:2px solid rgba(232,224,213,0.6);background:white'">
          <text v-if="p.tag" class="absolute -top-2.5 left-1/2 -translate-x-1/2 text-[10px] font-bold px-2 py-0.5 rounded-full whitespace-nowrap"
            :class="p.highlight ? 'bg-[#C41E3A] text-white' : 'bg-amber-400 text-white'">{{ p.tag }}</text>
          <text class="text-xs text-[#999] mb-1">{{ p.label }}</text>
          <text class="text-xl font-black text-[#2C2C2C]">¥{{ p.price }}</text>
          <text class="text-[10px] text-[#999] line-through mt-0.5">¥{{ p.originalPrice }}</text>
          <text class="text-[10px] text-[#C41E3A] mt-1">约 ¥{{ p.perMonth }}/月</text>
          <view v-if="selected === p.id" class="absolute bottom-2 right-2 w-4 h-4 rounded-full bg-[#C41E3A] flex items-center justify-center">
            <text class="text-[10px] text-white">✓</text>
          </view>
        </view>
      </view>

      <!-- 自动续费 -->
      <view @click="autoRenew = !autoRenew" class="flex items-center gap-3 w-full p-3 bg-white rounded-xl mb-6" style="border:1px solid rgba(232,224,213,0.6)">
        <view class="w-10 h-5 rounded-full transition-all flex items-center px-0.5"
          :class="autoRenew ? 'bg-[#C41E3A]' : 'bg-[#E8E0D5]'">
          <view class="w-4 h-4 rounded-full bg-white shadow transition-transform"
            :class="autoRenew ? 'translate-x-5' : 'translate-x-0'" />
        </view>
        <view class="flex-1">
          <text class="text-sm font-medium text-[#2C2C2C] flex items-center gap-1.5">🔄 自动续费</text>
          <text class="text-xs text-[#999] mt-0.5 block">到期前 7 天自动扣款，随时可取消</text>
        </view>
      </view>

      <!-- 续费权益 -->
      <view class="p-4 rounded-xl mb-6" style="background:rgba(250,248,245,0.5)">
        <text class="text-xs font-semibold text-[#2C2C2C] block mb-2">续费后享有权益</text>
        <view class="grid grid-cols-2 gap-y-2">
          <view v-for="b in benefits" :key="b" class="flex items-center gap-1.5 text-xs text-[#999]">
            <text class="text-[#C41E3A]">✓</text>
            {{ b }}
          </view>
        </view>
      </view>
    </view>

    <!-- 底部提交 -->
    <view class="fixed bottom-0 left-0 right-0 bg-[#FAF8F5] border-t border-[#E8E0D5] px-4 py-4 flex items-center gap-4">
      <view>
        <text class="text-lg font-black text-[#C41E3A]">¥{{ currentPlan.price }}</text>
        <text class="text-xs text-[#999]">原价 ¥{{ currentPlan.originalPrice }}</text>
      </view>
      <view @click="!paying && handlePay()" class="flex-1 py-3 text-center text-white text-base font-semibold rounded-xl" :style="{ background: paying ? '#E8A0A8' : '#C41E3A' }">
        {{ paying ? '处理中...' : '立即续费' }}
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

interface Plan {
  id: string; label: string; price: string; originalPrice: string
  perMonth: string; highlight?: boolean; tag?: string; months: number
}

const plans: Plan[] = [
  { id: '1', label: '1个月', price: '28', originalPrice: '38', perMonth: '28', months: 1 },
  { id: '2', label: '3个月', price: '68', originalPrice: '114', perMonth: '22.7', months: 3, tag: '热门' },
  { id: '3', label: '12个月', price: '198', originalPrice: '456', perMonth: '16.5', months: 12, highlight: true, tag: '最优惠' },
]

const benefits = ['不限次排盘解读', '命理分析报告', '专家一对一咨询', '海量古籍资料', 'AI 智能助手', 'VIP 专属课程']

const selected = ref('3')
const autoRenew = ref(false)
const paying = ref(false)

const currentPlan = computed(() => plans.find(p => p.id === selected.value)!)

async function handlePay() {
  paying.value = true
  await new Promise(r => setTimeout(r, 1500))
  paying.value = false
  uni.showToast({ title: '续费成功', icon: 'success' })
  setTimeout(() => uni.navigateTo({ url: '/pages/vip/index' }), 800)
}

function goBack() { uni.navigateBack() }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
