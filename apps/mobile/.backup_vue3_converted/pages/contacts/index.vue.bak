<template>
<view class="min-h-screen bg-[#FAF8F5] max-w-lg mx-auto">
  <!-- 顶部导航 -->
  <view class="sticky top-0 z-50 bg-[#FAF8F5]/95 border-b border-[#E8E0D5]">
    <view class="flex items-center gap-3 px-4 h-14">
      <view @click="goBack" class="p-2 -ml-2">
        <text class="w-5 h-5 text-[#2C2C2C]">←</text>
      </view>
      <text class="font-semibold text-lg text-[#2C2C2C]">通讯录</text>
    </view>

    <!-- 搜索栏 -->
    <view class="px-4 pb-3">
      <view class="relative">
        <text class="absolute left-3 top-1/2 -translate-y-1/2 text-[#999]">🔍</text>
        <input v-model="searchQuery" @input="onSearchInput" placeholder="搜索用户昵称或ID" class="w-full h-10 pl-10 pr-10 rounded-full bg-[#F5F1EB] text-sm text-[#2C2C2C] placeholder:text-[#999]" />
        <view v-if="searchQuery" @tap="searchQuery = ''" class="absolute right-3 top-1/2 -translate-y-1/2 p-1">
          <text class="text-[#999]">✕</text>
        </view>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="pb-20" style="height: calc(100vh - 120px);">
    <!-- 搜索结果 -->
    <view v-if="isSearching" class="p-4">
      <text class="text-sm text-[#999] mb-3 block">
        {{ searchResults.length > 0 ? `找到 ${searchResults.length} 个用户` : '未找到相关用户' }}
      </text>

      <view v-if="searchResults.length > 0" class="bg-white rounded-xl overflow-hidden">
        <view v-for="(user, idx) in searchResults" :key="user.id" @click="goTo('/pages/chat/id-detail?id=' + user.id)" :class="['flex items-center gap-3 p-3', idx < searchResults.length - 1 ? 'border-b border-[#E8E0D5]/60' : '']">
          <view class="relative w-11 h-11 rounded-full bg-[#F5F1EB] flex items-center justify-center">
            <text class="text-sm text-[#2C2C2C]">{{ user.name[0] }}</text>
            <text v-if="user.isOnline" class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 rounded-full border-2 border-white"></text>
          </view>
          <view class="flex-1 min-w-0">
            <view class="flex items-center gap-1.5">
              <text class="font-medium text-sm text-[#2C2C2C]">{{ user.name }}</text>
              <text v-if="user.isVerified" class="text-[10px] px-1 py-0 bg-[#C9A96E]/20 text-[#C9A96E] rounded">V</text>
            </view>
            <text class="text-xs text-[#999] line-clamp-1">{{ user.intro }}</text>
          </view>
          <view class="w-8 h-8 rounded-full bg-[#C41E3A]/10 flex items-center justify-center">
            <text class="text-[#C41E3A] text-sm">💬</text>
          </view>
        </view>
      </view>

      <view v-else class="flex flex-col items-center justify-center py-12">
        <view class="w-20 h-20 rounded-full bg-[#F5F1EB] flex items-center justify-center mb-4">
          <text class="text-3xl text-[#999]">🔍</text>
        </view>
        <text class="text-[#999] text-sm">未找到相关用户</text>
        <text class="text-[#999]/70 text-xs mt-1">试试其他关键词</text>

        <!-- 发现更多 -->
        <view class="w-full mt-8 px-4">
          <view class="flex items-center justify-between mb-3">
            <view class="flex items-center gap-2">
              <text class="text-[#C9A96E]">✨</text>
              <text class="text-sm font-medium text-[#2C2C2C]">发现更多</text>
            </view>
            <text @click="goTo('/pages/discover')" class="text-xs text-[#C41E3A]">查看全部</text>
          </view>
          <view class="divide-y divide-border bg-white rounded-xl">
            <view v-for="user in recommendedUsers.slice(0, 3)" :key="user.id" class="flex items-center gap-3 p-3">
              <view class="w-11 h-11 rounded-full bg-[#F5F1EB] flex items-center justify-center">
                <text class="text-sm text-[#2C2C2C]">{{ user.name[0] }}</text>
              </view>
              <view class="flex-1 min-w-0">
                <view class="flex items-center gap-1.5">
                  <text class="font-medium text-sm text-[#2C2C2C]">{{ user.name }}</text>
                  <text class="text-[10px] px-1 py-0 bg-[#C9A96E]/20 text-[#C9A96E] rounded">V</text>
                  <text class="text-[10px] px-1.5 py-0 border border-primary/30 text-[#C41E3A] rounded">{{ user.role }}</text>
                </view>
                <text class="text-xs text-[#999] line-clamp-1">{{ user.followers.toLocaleString() }} 粉丝</text>
              </view>
              <view class="px-3 py-1.5 bg-[#C41E3A] text-white text-xs font-medium rounded-full">关注</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 通讯录分组 -->
    <view v-else class="p-4 space-y-3">
      <view v-for="group in contactGroups" :key="group.id" class="bg-white rounded-xl overflow-hidden">
        <!-- 分组标题 -->
        <view @tap="toggleGroup(group.id)" class="flex items-center gap-3 p-4">
          <view :class="['w-10 h-10 rounded-xl flex items-center justify-center', group.bgColor]">
            <text>{{ group.icon }}</text>
          </view>
          <view class="flex-1">
            <text class="font-medium text-sm text-[#2C2C2C] block">{{ group.name }}</text>
            <text class="text-xs text-[#999]">{{ getTotalMembers(group) }} 人</text>
          </view>
          <text :class="['text-[#999] transition-transform', expandedGroups.includes(group.id) ? 'rotate-90' : '']">›</text>
        </view>

        <!-- 子分组 -->
        <view v-if="expandedGroups.includes(group.id)" class="border-t border-[#E8E0D5]">
          <view v-for="subGroup in group.subGroups" :key="subGroup.name">
            <view @tap="toggleSubGroup(subGroup.name)" class="flex items-center justify-between px-4 py-2 bg-[#F5F1EB]/30">
              <text class="text-xs text-[#999]">{{ subGroup.name }} ({{ subGroup.members.length }})</text>
              <text :class="['text-xs', expandedSubGroups.includes(subGroup.name) ? 'rotate-90' : '']">›</text>
            </view>
            <view v-if="expandedSubGroups.includes(subGroup.name)">
              <view v-for="member in subGroup.members" :key="member.id" @click="goTo('/pages/chat/id-detail?id=' + member.id)" class="flex items-center gap-3 p-3 ml-4">
                <view class="relative w-10 h-10 rounded-full bg-[#F5F1EB] flex items-center justify-center">
                  <text class="text-sm text-[#2C2C2C]">{{ member.name[0] }}</text>
                  <text v-if="member.isOnline" class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-green-500 rounded-full border-2 border-background"></text>
                </view>
                <view class="flex-1 min-w-0">
                  <view class="flex items-center gap-1.5">
                    <text class="font-medium text-sm text-[#2C2C2C]">{{ member.name }}</text>
                    <text v-if="member.isVerified" class="text-[10px] px-1 py-0 bg-[#C9A96E]/20 text-[#C9A96E] rounded">V</text>
                  </view>
                  <text class="text-xs text-[#999] line-clamp-1">{{ member.intro }}</text>
                </view>
                <text class="text-[#C41E3A] text-sm">💬</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
</template>

<script setup lang="ts">
import { ref, reactive, computed, onMounted, watch } from 'vue'
import { onLoad, onShow, onHide } from '@dcloudio/uni-app'

// 导航辅助
function goBack() { uni.navigateBack() }
function goTo(url: string) { uni.navigateTo({ url }) }

// 分组数据
const contactGroups = [
  {
    id: 'circle', name: '我的圈友', icon: '👥', color: 'text-[#C41E3A]', bgColor: 'bg-[#C41E3A]/10',
    subGroups: [
      { name: '八字命理研习社', members: [{ id: 1, name: '李明远', intro: '命理学爱好者', isOnline: true }, { id: 2, name: '王晓燕', intro: '紫微斗数从业者', isOnline: false, isVerified: true }, { id: 3, name: '张道长', intro: '道家文化传承人', isOnline: true }] },
      { name: '风水堪舆学院', members: [{ id: 4, name: '陈风水', intro: '风水师，从业10年', isOnline: true, isVerified: true }, { id: 5, name: '刘易经', intro: '易经研究者', isOnline: false }] }
    ]
  },
  {
    id: 'student', name: '我的学员/老师', icon: '🎓', color: 'text-[#C9A96E]', bgColor: 'bg-[#C9A96E]/10',
    subGroups: [
      { name: '我的老师', members: [{ id: 6, name: '周易大师', intro: '八字命理资深讲师', isOnline: true, isVerified: true, role: '讲师' }] },
      { name: '我的学员', members: [{ id: 7, name: '小明', intro: '八字入门学员', isOnline: false }, { id: 8, name: '小红', intro: '紫微斗数学员', isOnline: true }, { id: 9, name: '小华', intro: '风水基础学员', isOnline: false }] }
    ]
  },
  {
    id: 'following', name: '我关注的', icon: '❤️', color: 'text-rose-500', bgColor: 'bg-rose-500/10',
    subGroups: [
      { name: '关注的用户', members: [{ id: 10, name: '国学大咖', intro: '知名国学自媒体', isOnline: true, isVerified: true }, { id: 11, name: '命理小王', intro: '八字命理科普博主', isOnline: false }, { id: 12, name: '风水达人', intro: '风水布局专家', isOnline: true, isVerified: true }] }
    ]
  }
]

const allUsers = [
  { id: 101, name: '张三丰', intro: '太极拳传承人，武当山道长', isOnline: true, isVerified: true },
  { id: 102, name: '李清照', intro: '诗词爱好者，古典文学研究', isOnline: false },
  { id: 103, name: '王阳明', intro: '心学研究者，国学讲师', isOnline: true, isVerified: true },
  { id: 104, name: '苏东坡', intro: '书法爱好者，美食评论家', isOnline: false },
  { id: 105, name: '诸葛亮', intro: '易经研究，奇门遁甲专家', isOnline: true, isVerified: true },
]

const recommendedUsers = [
  { id: 201, name: '周易大师', intro: '八字命理资深讲师', isOnline: true, isVerified: true, role: '讲师', followers: 12800 },
  { id: 202, name: '张玄风', intro: '紫微斗数传承人', isOnline: true, isVerified: true, role: '圈主', followers: 8560 },
  { id: 203, name: '陈风水', intro: '风水堪舆专家', isOnline: false, isVerified: true, role: '讲师', followers: 6280 },
  { id: 204, name: '李易安', intro: '国学传播者', isOnline: true, isVerified: true, role: '圈主', followers: 25600 },
]

const searchQuery = ref('')
const expandedGroups = ref<string[]>(['circle'])
const expandedSubGroups = ref<string[]>([])

const isSearching = computed(() => searchQuery.value.trim().length > 0)

const searchResults = computed(() => {
  if (!isSearching.value) return []
  const query = searchQuery.value.toLowerCase()
  return allUsers.filter(user =>
    user.name.toLowerCase().includes(query) ||
    user.intro.toLowerCase().includes(query)
  )
})

const onSearchInput = () => {
  // search is reactive via computed
}

const toggleGroup = (groupId: string) => {
  const idx = expandedGroups.value.indexOf(groupId)
  if (idx >= 0) {
    expandedGroups.value.splice(idx, 1)
  } else {
    expandedGroups.value.push(groupId)
  }
}

const toggleSubGroup = (subGroupName: string) => {
  const idx = expandedSubGroups.value.indexOf(subGroupName)
  if (idx >= 0) {
    expandedSubGroups.value.splice(idx, 1)
  } else {
    expandedSubGroups.value.push(subGroupName)
  }
}

const getTotalMembers = (group: typeof contactGroups[0]) => {
  return group.subGroups.reduce((sum, sub) => sum + sub.members.length, 0)
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
