<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-24">
    <!-- 奖励动画 -->
    <view v-if="showRewardAnim" class="fixed inset-0 z-50 flex items-center justify-center pointer-events-none">
      <view class="px-6 py-3 rounded-full shadow-lg flex items-center gap-2" style="background:linear-gradient(90deg,#C9A96E,#E8C878);color:white;animation:bounce 1s">
        <text>🪙</text>
        <text class="text-lg font-bold">+{{earnedPoints}} 积分</text>
      </view>
    </view>

    <!-- 顶部背景 -->
    <view class="relative overflow-hidden px-4 pt-12 pb-24" style="background:linear-gradient(180deg,#C41E3A,#A01830)">
      <!-- 装饰 -->
      <view class="absolute top-0 right-0 w-40 h-40 rounded-full bg-white/5" style="transform:translateY(-50%) translateX(50%)" />
      <view class="absolute bottom-0 left-0 w-32 h-32 rounded-full bg-white/5" style="transform:translateY(50%) translateX(-50%)" />

      <!-- 导航 -->
      <view class="flex items-center justify-between mb-6 relative z-10">
        <view @click="goBack" class="p-2 -ml-2">
          <text class="text-white text-xl">←</text>
        </view>
        <text class="text-lg font-bold text-white">每日任务</text>
        <view @click="navigateTo('/pages/points/exchange/index')" class="p-2 -mr-2">
          <text class="text-white text-xl">🎁</text>
        </view>
      </view>

      <!-- 积分展示 -->
      <view class="text-center relative z-10">
        <view class="flex items-center justify-center gap-2 mb-1">
          <text class="text-lg" style="color:#FFD700">🪙</text>
          <text class="text-sm text-white/80">我的积分</text>
        </view>
        <text class="text-4xl font-black text-white mb-2" style="display:block">{{totalPoints.toLocaleString()}}</text>
        <text class="text-sm text-white/60" style="display:block">今日已获 +{{todayEarnedPoints}} 积分</text>
      </view>
    </view>

    <!-- 签到卡片 -->
    <view class="px-4 relative z-10" style="margin-top:-64rpx">
      <view class="bg-white rounded-2xl shadow-lg p-4 mb-4">
        <!-- 签到头部 -->
        <view class="flex items-center justify-between mb-4">
          <view class="flex items-center gap-2">
            <view class="w-10 h-10 rounded-full flex items-center justify-center" style="background:linear-gradient(135deg,#FF6B35,#FF8C42)">
              <text class="text-white">🔥</text>
            </view>
            <view>
              <text class="text-sm font-bold text-[#2C2C2C]" style="display:block">连续签到 {{streak}} 天</text>
              <text class="text-xs text-[#999]" style="display:block">再签{{7-(streak%7)}}天可获100积分大奖</text>
            </view>
          </view>
          <view @click="handleCheckIn" :class="'px-5 py-2 rounded-full text-sm font-bold transition-all ' + (todayCheckedIn ? 'bg-[#E8E0D5] text-[#999]' : 'text-white shadow-md')" :style="!todayCheckedIn ? 'background:linear-gradient(90deg,#C41E3A,#E74C3C)' : ''">
            <text>{{todayCheckedIn ? '已签到' : '签到'}}</text>
          </view>
        </view>

        <!-- 签到日历 -->
        <view class="grid grid-cols-7 gap-2" style="display:flex;gap:8rpx">
          <view v-for="(reward,index) in checkInRewards" :key="reward.day" style="flex:1">
            <view style="text-align:center">
              <view :class="'w-full rounded-xl flex flex-col items-center justify-center mb-1 relative overflow-hidden ' + (
                weekCheckIns[index] ? 'text-white' :
                isToday(index) ? 'border-2 border-dashed border-[#C41E3A]' : ''
              )" :style="{
                aspectRatio:'1/1',
                background: weekCheckIns[index] ? 'linear-gradient(135deg,#C41E3A,#E74C3C)' :
                           isToday(index) ? 'linear-gradient(135deg,#FFF5F0,#FFE4D6)' : '#F5F0E8'
              }">
                <text v-if="weekCheckIns[index]" class="text-white" style="font-size:20rpx">✓</text>
                <text v-else-if="reward.isSpecial" class="text-[#C9A96E]" style="font-size:20rpx">🏆</text>
                <text v-else class="text-[#C9A96E]" style="font-size:16rpx">🪙</text>
                <view v-if="reward.isSpecial && !weekCheckIns[index]" class="absolute -top-1 -right-1 w-4 h-4 rounded-full flex items-center justify-center" style="background-color:#FF6B35">
                  <text class="text-white font-bold" style="font-size:8rpx">!</text>
                </view>
              </view>
              <text :class="'text-[10px] ' + (reward.isSpecial ? 'text-[#C9A96E] font-bold' : 'text-[#666]')">+{{reward.points}}</text>
              <text class="text-[10px] text-[#999]" style="display:block">第{{reward.day}}天</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 任务列表 -->
      <view class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <!-- 任务头部 -->
        <view class="p-4 border-b border-[#F5F0E8] flex items-center justify-between">
          <view class="flex items-center gap-2">
            <text class="text-lg text-[#C41E3A]">📅</text>
            <text class="font-bold text-[#2C2C2C]">每日任务</text>
          </view>
          <text class="text-sm text-[#999]">已完成 <text class="text-[#C41E3A] font-bold">{{completedCount}}</text>/{{tasks.length}}</text>
        </view>

        <!-- 任务项 -->
        <view class="divide-y divide-[#F5F0E8]">
          <view v-for="task in tasks" :key="task.id" class="p-4 flex items-center gap-4">
            <!-- 图标 -->
            <view :class="'w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 ' + (task.completed ? 'bg-[#E8F5E9]' : 'bg-[#FFF5F0]')">
              <text :class="task.completed ? 'text-[#4CAF50]' : 'text-[#FF6B35]'" class="text-lg">
                {{task.completed ? '✓' : task.icon}}
              </text>
            </view>

            <!-- 信息 -->
            <view class="flex-1" style="min-width:0">
              <view class="flex items-center gap-2 mb-1">
                <text class="font-medium text-[#2C2C2C]">{{task.title}}</text>
                <text class="text-xs px-2 py-0.5 rounded-full" style="color:#C9A96E;background-color:#C9A96E/10">+{{task.points}}积分</text>
              </view>
              <text class="text-xs text-[#999] mb-2" style="display:block">{{task.description}}</text>
              <!-- 进度条 -->
              <view v-if="!task.completed && task.target>1" class="flex items-center gap-2">
                <view class="flex-1 h-1.5 rounded-full overflow-hidden" style="background-color:#F5F0E8">
                  <view class="h-full rounded-full transition-all" :style="{width:(task.progress/task.target*100)+'%',background:'linear-gradient(90deg,#FF6B35,#FF8C42)'}" />
                </view>
                <text class="text-xs text-[#999]">{{task.progress}}/{{task.target}}</text>
              </view>
            </view>

            <!-- 操作按钮 -->
            <view @click="handleTaskAction(task)" :class="'px-4 py-2 rounded-full text-sm font-medium flex-shrink-0 transition-all ' + (
              task.completed ? 'bg-[#E8F5E9] text-[#4CAF50]' : 'text-white'
            )" :style="!task.completed ? 'background:linear-gradient(90deg,#FF6B35,#FF8C42)' : ''">
              <text>{{task.completed ? '已完成' : task.action}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 积分兑换入口 -->
      <view @click="navigateTo('/pages/points/exchange/index')" class="mt-4 p-4 rounded-2xl flex items-center justify-between" style="background:linear-gradient(90deg,#C9A96E,#E8C878)">
        <view class="flex items-center gap-3">
          <view class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center">
            <text class="text-white text-xl">🎁</text>
          </view>
          <view>
            <text class="text-white font-bold" style="display:block">积分商城</text>
            <text class="text-white/80 text-sm" style="display:block">用积分兑换精美好礼</text>
          </view>
        </view>
        <text class="text-lg text-white/80">›</text>
      </view>

      <!-- 规则说明 -->
      <view class="mt-4 p-4 bg-white rounded-2xl">
        <text class="text-sm font-bold text-[#2C2C2C] mb-2" style="display:block">活动规则</text>
        <view class="text-xs text-[#999] space-y-1">
          <text style="display:block">1. 每日任务每天0点重置，请及时完成</text>
          <text style="display:block">2. 连续签到7天可获得100积分大奖</text>
          <text style="display:block">3. 断签后连续天数重新计算</text>
          <text style="display:block">4. 积分可在积分商城兑换课程、实物等奖品</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

interface DailyTask {
  id: string
  title: string
  description: string
  icon: string
  points: number
  progress: number
  target: number
  completed: boolean
  action: string
  actionUrl: string
}

const checkInRewards = [
  { day: 1, points: 5 },
  { day: 2, points: 10 },
  { day: 3, points: 15 },
  { day: 4, points: 20 },
  { day: 5, points: 30 },
  { day: 6, points: 40 },
  { day: 7, points: 100, isSpecial: true },
]

const mockTasks: DailyTask[] = [
  { id: "read", title: "阅读文章", description: "阅读任意1篇文章", icon: "📚", points: 10, progress: 0, target: 1, completed: false, action: "去阅读", actionUrl: "/pages/discover/index" },
  { id: "comment", title: "发表评论", description: "在任意内容下发表评论", icon: "💬", points: 15, progress: 0, target: 1, completed: false, action: "去评论", actionUrl: "/pages/discover/index" },
  { id: "share", title: "分享内容", description: "分享任意内容给好友", icon: "📤", points: 20, progress: 0, target: 1, completed: false, action: "去分享", actionUrl: "/pages/discover/index" },
  { id: "study", title: "学习课程", description: "学习课程满10分钟", icon: "👁", points: 30, progress: 5, target: 10, completed: false, action: "去学习", actionUrl: "/pages/mine/my-courses/index" },
  { id: "collect", title: "收藏内容", description: "收藏2篇喜欢的内容", icon: "⭐", points: 10, progress: 1, target: 2, completed: false, action: "去收藏", actionUrl: "/pages/discover/index" },
]

const isLoading = ref(false)
const totalPoints = ref(1280)
const streak = ref(4)
const todayCheckedIn = ref(false)
const tasks = ref<DailyTask[]>(mockTasks.map(t => ({...t})))
const showRewardAnim = ref(false)
const earnedPoints = ref(0)
const weekCheckIns = ref<boolean[]>([true, true, true, true, false, false, false])

onMounted(() => {
  // 从 localStorage 加载数据
  try {
    const saved = uni.getStorageSync('daily_tasks_data')
    if (saved) {
      const data = JSON.parse(saved)
      const today = new Date().toDateString()
      if (data.lastCheckIn === today) {
        todayCheckedIn.value = true
      }
      if (data.streak) streak.value = data.streak
      if (data.points) totalPoints.value = data.points
      if (data.tasks) tasks.value = data.tasks
      if (data.weekCheckIns) weekCheckIns.value = data.weekCheckIns
    }
  } catch (e) {
    console.error('Failed to load saved data')
  }
})

function saveData(updates: any) {
  try {
    const saved = uni.getStorageSync('daily_tasks_data')
    const data = saved ? JSON.parse(saved) : {}
    const newData = { ...data, ...updates }
    uni.setStorageSync('daily_tasks_data', JSON.stringify(newData))
  } catch (e) {
    console.error('Failed to save data')
  }
}

function handleCheckIn() {
  if (todayCheckedIn.value) return

  const newStreak = streak.value + 1
  const rewardIndex = Math.min(newStreak - 1, 6)
  const reward = checkInRewards[rewardIndex].points
  const newPoints = totalPoints.value + reward
  const dayIndex = new Date().getDay()
  weekCheckIns.value[dayIndex === 0 ? 6 : dayIndex - 1] = true

  todayCheckedIn.value = true
  streak.value = newStreak
  totalPoints.value = newPoints
  earnedPoints.value = reward
  showRewardAnim.value = true

  saveData({
    lastCheckIn: new Date().toDateString(),
    streak: newStreak,
    points: newPoints,
    weekCheckIns: weekCheckIns.value,
  })

  setTimeout(() => showRewardAnim.value = false, 2000)
}

function completeTask(taskId: string) {
  const task = tasks.value.find(t => t.id === taskId)
  if (!task || task.completed) return

  task.completed = true
  task.progress = task.target
  totalPoints.value += task.points
  earnedPoints.value = task.points
  showRewardAnim.value = true

  saveData({
    tasks: tasks.value.map(t => ({ ...t })),
    points: totalPoints.value,
  })

  setTimeout(() => showRewardAnim.value = false, 2000)
}

function handleTaskAction(task: DailyTask) {
  if (task.completed) return
  if (task.progress >= task.target - 1) {
    completeTask(task.id)
  } else {
    navigateTo(task.actionUrl)
  }
}

function isToday(index: number) {
  return index === (new Date().getDay() === 0 ? 6 : new Date().getDay() - 1)
}

const todayEarnedPoints = computed(() => {
  const taskPoints = tasks.value.filter(t => t.completed).reduce((sum, t) => sum + t.points, 0)
  const checkInPoint = todayCheckedIn.value ? checkInRewards[Math.min(streak.value - 1, 6)].points : 0
  return taskPoints + checkInPoint
})

const completedCount = computed(() => tasks.value.filter(t => t.completed).length)

function navigateTo(url: string) {
  uni.navigateTo({ url })
}

function goBack() {
  uni.navigateBack()
}
</script>

<style scoped>
@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}
</style>
