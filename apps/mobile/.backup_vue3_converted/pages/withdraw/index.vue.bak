<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-24">
    <!-- ===== 提现成功页 ===== -->
    <template v-if="showSuccess">
      <view class="min-h-screen bg-[#FAF8F5] flex flex-col items-center justify-center p-6">
        <view class="w-20 h-20 rounded-full flex items-center justify-center mb-6" style="background:rgba(34,197,94,0.2)">
          <text class="text-4xl text-green-500">✅</text>
        </view>
        <text class="text-xl font-bold text-[#2C2C2C] mb-2">提现申请已提交</text>
        <text class="text-sm text-[#999] text-center mb-2">提现金额：¥{{ numAmount.toFixed(2) }}</text>
        <text class="text-xs text-[#999] text-center mb-8">预计1-3个工作日内到账，请注意查收</text>
        <view class="flex gap-3 w-full max-w-xs">
          <view @click="goEarnings" class="flex-1 py-3 text-center text-sm font-medium rounded-xl" style="background:#F5F1EB;color:#2C2C2C">返回收益</view>
          <view @click="goHome" class="flex-1 py-3 text-center text-sm font-medium text-white rounded-xl" style="background:#C41E3A">返回首页</view>
        </view>
      </view>
    </template>

    <!-- ===== 提现表单 ===== -->
    <template v-else>
      <!-- 顶部导航 -->
      <header class="sticky top-0 z-50 bg-[#FAF8F5]/95 backdrop-blur-lg border-b border-[#E8E0D5]">
        <view class="flex items-center justify-between h-14 px-4">
          <view @click="goBack" class="p-1"><text class="text-xl text-[#2C2C2C]">←</text></view>
          <text class="font-semibold text-[#2C2C2C]">申请提现</text>
          <view @click="goRecords" class="text-sm text-[#C41E3A]">提现记录</view>
        </view>
      </header>

      <view class="p-4 space-y-4">
        <!-- 可提现余额 -->
        <view class="p-5 rounded-xl" style="background:linear-gradient(135deg,rgba(201,169,110,0.2),rgba(201,169,110,0.1),transparent);border:1px solid rgba(201,169,110,0.2)">
          <text class="text-sm text-[#999] block mb-1">可提现余额</text>
          <view class="flex items-baseline gap-1">
            <text class="text-sm" style="color:#C9A96E">¥</text>
            <text class="text-4xl font-bold" style="color:#C9A96E">{{ availableBalance.toLocaleString() }}</text>
          </view>
          <text class="text-xs text-[#999] block mt-2">累计已提现 ¥12,580.00</text>
        </view>

        <!-- 提现金额输入 -->
        <view class="p-4 bg-white rounded-xl" style="border:1px solid rgba(232,224,213,0.6)">
          <view class="flex items-center justify-between mb-3">
            <text class="text-sm text-[#2C2C2C] font-medium">提现金额</text>
            <text @click="handleWithdrawAll" class="text-sm text-[#C41E3A]">全部提现</text>
          </view>
          <view class="flex items-center gap-2 pb-3" style="border-bottom:1px solid rgba(232,224,213,0.6)">
            <text class="text-2xl font-semibold text-[#2C2C2C]">¥</text>
            <input v-model="amount" type="digit" placeholder="请输入提现金额"
              class="flex-1 text-2xl font-semibold bg-transparent outline-none" style="color:#2C2C2C" />
          </view>
          <view class="flex items-center gap-2 mt-3 text-xs text-[#999]">
            <text>⚠️</text>
            <text>最低提现金额 ¥{{ minAmount.toFixed(2) }}</text>
          </view>
          <text v-if="numAmount > 0 && numAmount < minAmount" class="text-xs text-red-500 block mt-2">提现金额不能低于 ¥{{ minAmount.toFixed(2) }}</text>
          <text v-if="numAmount > availableBalance" class="text-xs text-red-500 block mt-2">提现金额不能超过可提现余额</text>
        </view>

        <!-- 提现方式 -->
        <view class="p-4 bg-white rounded-xl" style="border:1px solid rgba(232,224,213,0.6)">
          <text class="text-sm font-medium text-[#2C2C2C] block mb-3">提现方式</text>
          <view class="space-y-2">
            <view v-for="method in withdrawMethods" :key="method.id" @click="selectedMethod = method.id"
              class="flex items-center gap-3 p-3 rounded-xl transition-all"
              :style="selectedMethod === method.id ? 'border:1px solid #C41E3A;background:rgba(196,30,58,0.05)' : 'border:1px solid rgba(232,224,213,0.6)'">
              <text class="text-2xl">{{ method.icon }}</text>
              <view class="flex-1">
                <text class="text-sm font-medium text-[#2C2C2C] block">{{ method.name }}</text>
                <text v-if="method.bound" class="text-xs text-[#999]">{{ method.account }}</text>
                <text v-else class="text-xs text-[#C41E3A]">点击绑定</text>
              </view>
              <text v-if="selectedMethod === method.id" class="text-lg text-[#C41E3A]">✅</text>
            </view>
          </view>
          <view @click="goManageAccounts" class="flex items-center justify-center gap-1 mt-3 py-2 text-sm text-[#C41E3A]">
            💳 管理收款账户 ›
          </view>
        </view>

        <!-- 费用明细 -->
        <view v-if="numAmount > 0" class="p-4 bg-white rounded-xl" style="border:1px solid rgba(232,224,213,0.6)">
          <text class="text-sm font-medium text-[#2C2C2C] block mb-3">费用明细</text>
          <view class="space-y-2 text-sm">
            <view class="flex items-center justify-between">
              <text class="text-[#999]">提现金额</text>
              <text class="text-[#2C2C2C]">¥{{ numAmount.toFixed(2) }}</text>
            </view>
            <view class="flex items-center justify-between">
              <text class="text-[#999]">手续费（0.6%）<text class="text-[10px] ml-1 px-1" style="background:rgba(250,248,245,0.5)">平台补贴</text></text>
              <text class="text-[#999] line-through">-¥{{ serviceFee }}</text>
            </view>
            <view class="flex items-center justify-between pt-2" style="border-top:1px solid rgba(232,224,213,0.6)">
              <text class="font-medium text-[#2C2C2C]">实际到账</text>
              <text class="font-bold text-lg" style="color:#C9A96E">¥{{ numAmount.toFixed(2) }}</text>
            </view>
          </view>
        </view>

        <!-- 到账时间说明 -->
        <view class="flex items-start gap-2 p-3 rounded-xl" style="background:rgba(250,248,245,0.5)">
          <text class="text-[#999] mt-0.5">🕐</text>
          <view class="text-xs text-[#999]">
            <text class="block mb-1">到账时间说明：</text>
            <text class="block">• 微信零钱：预计T+1个工作日到账</text>
            <text class="block">• 支付宝：预计T+1个工作日到账</text>
            <text class="block">• 银行卡：预计T+1至T+3个工作日到账</text>
          </view>
        </view>

        <!-- 提现须知 -->
        <view class="text-xs text-[#999] space-y-1">
          <text class="block">提现须知：</text>
          <text class="block">1. 单笔提现限额：¥100 - ¥50,000</text>
          <text class="block">2. 每日最多可提现3次</text>
          <text class="block">3. 提现申请提交后，预计1-3个工作日内审核完成</text>
          <text class="block">4. 如有疑问，请联系客服</text>
        </view>
      </view>

      <!-- 底部固定操作栏 -->
      <view class="fixed bottom-0 left-0 right-0 bg-[#FAF8F5]/95 backdrop-blur-lg border-t border-[#E8E0D5] p-4">
        <view @click="handleSubmit"
          class="w-full py-3.5 rounded-xl font-medium text-center transition-all"
          :class="isValidAmount ? 'bg-[#C41E3A] text-white' : 'bg-[#E8E0D5] text-[#999]'"
        >
          {{ numAmount > 0 ? `确认提现 ¥${numAmount.toFixed(2)}` : '请输入提现金额' }}
        </view>
      </view>
    </template>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

const amount = ref('')
const selectedMethod = ref('wechat')
const showSuccess = ref(false)

const availableBalance = 3680.50
const minAmount = 100

const withdrawMethods = [
  { id: 'wechat', name: '微信零钱', icon: '💚', account: '微信用户_张三', bound: true },
  { id: 'alipay', name: '支付宝', icon: '💙', account: '138****8888', bound: true },
  { id: 'bank', name: '银行卡', icon: '💳', account: '工商银行 尾号8888', bound: true },
]

const numAmount = computed(() => parseFloat(amount.value) || 0)
const isValidAmount = computed(() => numAmount.value >= minAmount && numAmount.value <= availableBalance)
const serviceFee = computed(() => numAmount.value > 0 ? Math.max(numAmount.value * 0.006, 0.1).toFixed(2) : '0.00')
const actualAmount = computed(() => numAmount.value > 0 ? (numAmount.value - parseFloat(serviceFee.value)).toFixed(2) : '0.00')

function handleWithdrawAll() {
  amount.value = availableBalance.toFixed(2)
}

function handleSubmit() {
  if (isValidAmount.value) {
    showSuccess.value = true
  }
}

function goBack() { uni.navigateBack() }
function goEarnings() { uni.navigateTo({ url: '/pages/earnings/index' }) }
function goHome() { uni.switchTab({ url: '/pages/home/index' }) }
function goRecords() { uni.navigateTo({ url: '/pages/withdraw/records/index' }) }
function goManageAccounts() { uni.navigateTo({ url: '/pages/settings/bind-account/index' }) }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
