              <text class="text-[12px] text-[#666] mb-2 block">易学工具大全，算法精准，功能全面</text>
              <view class="flex items-center gap-1.5">
                <text v-for="t in ['八字','紫微','六爻','奇门']" :key="t"
                  class="px-2 py-0.5 rounded-full bg-white/70 text-[10px] text-[#C9A96E] border border-[#C9A96E]/25 font-medium"
                >{{ t }}</text>
              </view>
            </view>
            <!-- CTA -->
            <view class="flex items-center gap-1 px-3.5 py-2 rounded-full text-white text-[13px] font-medium flex-shrink-0"
              style="background: #C41E3A; box-shadow: 0 3px 12px rgba(196,30,58,0.25);">
              <text>立即体验</text>
              <text class="text-xs">→</text>
            </view>
          </view>
        </view>
