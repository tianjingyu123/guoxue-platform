<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- ==================== AppHeader ==================== -->
    <view class="fixed top-0 left-0 right-0 z-50 bg-[#FAF8F5]/95" style="backdrop-filter: blur(8px); padding-top: env(safe-area-inset-top)">
      <view class="max-w-lg mx-auto">
        <!-- 搜索栏 + 通知 -->
        <view class="flex items-center gap-3 h-12 px-4">
          <view class="flex-1" @click="goSearch">
            <view class="flex items-center h-8 px-3 rounded-full bg-[#F2EFEA] border border-[#E8E0D5]">
              <text class="text-sm">🔍</text>
              <view class="flex items-center gap-0.5 px-1 py-0.5 mx-1.5 rounded-full bg-violet-100">
                <text class="text-xs">✨</text>
              </view>
              <text class="text-[13px] text-[#999] truncate">搜索内容...</text>
            </view>
          </view>
          <view class="relative p-2 rounded-full" @click="goMessages">
            <text class="text-xl">🔔</text>
            <view class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-[#C41E3A] animate-pulse" />
          </view>
        </view>

        <!-- Tab导航栏 -->
        <view class="flex items-center h-10 px-4 border-b border-[#E8E0D5]">
          <view class="flex-1 flex items-center gap-6">
            <view v-for="tab in headerTabs" :key="tab" class="relative py-2" @click="activeTab = tab">
              <text :class="['text-[15px] font-semibold transition-all', activeTab === tab ? 'text-[#C41E3A]' : 'text-[#999]']">{{ tab }}</text>
              <view v-if="activeTab === tab" class="absolute bottom-0 left-1/2 -translate-x-1/2 w-5 h-[3px] bg-[#C41E3A] rounded-full transition-all duration-300" />
            </view>
          </view>
          <view class="p-1.5 rounded-full" @click="goPublish">
            <text class="text-base text-[#999]">➕</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ==================== 主内容区 ==================== -->
    <view class="pt-[88px]">
      <!-- HomeBanner 轮播 -->
      <view class="relative mx-4 mt-2 mb-3 rounded-xl overflow-hidden">
        <view class="relative h-36 overflow-hidden rounded-xl"
          @touchstart="onBannerTouchStart"
          @touchend="onBannerTouchEnd"
        >
          <view v-for="(banner, i) in banners" :key="banner.id"
            :class="['absolute inset-0 transition-all duration-300 ease-out',
              i === bannerCurrent ? 'opacity-100 translate-x-0' :
              i < bannerCurrent ? 'opacity-0 -translate-x-full' : 'opacity-0 translate-x-full']"
            @click="goBanner(banner)"
          >
            <view class="w-full h-full bg-gradient-to-br from-[#C41E3A]/20 to-[#C9A96E]/20 flex items-center justify-center">
              <text class="text-4xl">{{ i === 0 ? '📚' : i === 1 ? '📡' : '🎁' }}</text>
            </view>
            <view class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent" />
            <view class="absolute bottom-3 left-4 right-12">
              <text class="text-white text-sm font-medium line-clamp-1">{{ banner.title }}</text>
            </view>
          </view>
        </view>
        <!-- 指示器 -->
        <view v-if="banners.length > 1" class="absolute bottom-2 right-3 flex items-center gap-1">
          <view v-for="(b, i) in banners" :key="i"
            :class="['rounded-full transition-all duration-300',
              i === bannerCurrent ? 'w-4 h-1.5 bg-white' : 'w-1.5 h-1.5 bg-white/50']"
            @click="goBannerTo(i)"
          />
        </view>
      </view>

      <!-- QuickEntryGrid 10宫格 -->
      <view class="mx-4 mb-4">
        <view class="grid grid-cols-5 gap-y-3">
          <view v-for="entry in quickEntries" :key="entry.id"
            class="flex flex-col items-center gap-1.5 active:scale-95 transition-transform"
            @click="goEntry(entry)"
          >
            <view :class="['relative w-12 h-12 rounded-xl flex items-center justify-center', entry.bgColor]">
              <text :class="['text-lg', entry.color]">{{ entry.emoji }}</text>
              <view v-if="entry.badge"
                :class="['absolute -top-1 -right-1 px-1.5 py-0.5 rounded-full text-[9px] font-bold text-white',
                  entry.badge === 'AI' ? 'bg-gradient-to-r from-violet-500 to-purple-500' : 'bg-[#C41E3A]']"
              >{{ entry.badge }}</view>
            </view>
            <text class="text-[11px] text-[#333] font-medium">{{ entry.name }}</text>
          </view>
        </view>
      </view>

      <!-- ==================== HomeFeed ==================== -->

      <!-- 排盘引导大卡 -->
      <view class="mx-[5px] sm:mx-3 mb-1.5" @click="goPaipan">
        <view class="overflow-hidden rounded-2xl active:scale-[0.99] transition-all duration-300 relative"
          style="background: linear-gradient(135deg, #FAF3E8 0%, #FDF8F0 40%, #FAF3E8 100%); border: 1px solid rgba(201,169,110,0.35); box-shadow: 0 2px 16px rgba(201,169,110,0.15), 0 1px 4px rgba(0,0,0,0.04);"
        >
          <view class="relative px-4 py-3.5 flex items-center gap-4">
            <!-- 太极图标 -->
            <view class="relative w-[52px] h-[52px] rounded-2xl flex items-center justify-center flex-shrink-0"
              style="background: linear-gradient(135deg, #C9A96E, #B8985F); box-shadow: 0 0 16px rgba(201,169,110,0.35);">
              <text class="text-2xl text-white">☯</text>
            </view>
            <!-- 文案 -->
            <view class="flex-1 min-w-0">
              <view class="flex items-center gap-2 mb-0.5">
                <text class="font-serif font-bold text-[17px] text-[#2C2C2C]">排盘工具</text>
                <text class="px-1.5 py-0.5 rounded bg-[#C41E3A]/10 text-[#C41E3A] text-[9px] font-medium">免费使用</text>
