      <!-- 瀑布流 Feed -->
      <view class="px-[5px] sm:px-3 pb-24">
        <view class="columns-2 gap-1.5 space-y-0">
          <!-- Feed卡片渲染 -->
          <template v-for="item in visibleFeedItems" :key="item.id">
            <view class="break-inside-avoid mb-1.5"
              @touchstart="(e: any) => onCardLongPressStart(item.id, e)"
              @touchend="onCardLongPressEnd"
              @touchcancel="onCardLongPressEnd"
            >
              <!-- 纯文字卡片 -->
              <view v-if="!item.cover" class="block" @click="goFeedItem(item)">
