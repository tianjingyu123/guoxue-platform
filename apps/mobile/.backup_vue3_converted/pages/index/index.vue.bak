  { id: 4, name: '起名助手',  desc: '姓名五行吉凶分析',   intro: '输入生辰智能推荐好名',     gradient: 'agent-sky',  online: true, users: '9.8万',  isHot: false },
]

const liked = ref(new Set<number>())
const hidden = ref(new Set<number>())
const loadingMore = ref(false)
const hasMore = ref(true)
const contextMenu = ref<{ id: number; x: number; y: number } | null>(null)
const showBackTop = ref(false)
let longPressTimer: ReturnType<typeof setTimeout> | null = null

const visibleFeedItems = computed(() => feedItems.filter(it => !hidden.value.has(it.id)))

function typeLabel(type: string) {
  const map: Record<string, string> = { live: '直播', article: '文章', post: '帖子', course: '课程', product: '好物', video: '视频', ebook: '古籍', circle: '圈子' }
  return map[type] || type
}

function coverEmoji(type: string) {
  const map: Record<string, string> = { live: '📡', course: '📚', video: '🎬', ebook: '📖', product: '🛍️', article: '📄' }
  return map[type] || '📄'
}

function agentGradientClass(agent: typeof agents[0]) {
  const map: Record<string, string> = {
    'agent-warm': 'bg-gradient-to-br from-[#C41E3A] via-[#E74C3C] to-[#F39C12] bg-[length:200%_200%] animate-[gradient-flow_3s_ease_infinite]',
    'agent-cool': 'bg-gradient-to-br from-[#4A90D9] via-[#722ED1] to-[#9B59B6] bg-[length:200%_200%] animate-[gradient-flow_3s_ease_infinite]',
    'agent-earth': 'bg-gradient-to-br from-[#52C41A] via-[#1890FF] to-[#722ED1] bg-[length:200%_200%] animate-[gradient-flow_3s_ease_infinite]',
    'agent-sky': 'bg-gradient-to-br from-[#1890FF] via-[#4A90D9] to-[#52C41A] bg-[length:200%_200%] animate-[gradient-flow_3s_ease_infinite]',
  }
  return map[agent.gradient] || ''
}

function agentEmoji(agent: typeof agents[0]) {
  const map: Record<string, string> = { '八字大师': '☰', '紫微顾问': '✦', '风水先生': '◎', '起名助手': '✎' }
  return map[agent.name] || '🤖'
}

function formatNum(n: number) {
  if (n >= 10000) return (n / 10000).toFixed(1) + '万'
  if (n >= 1000) return (n / 1000).toFixed(1) + 'k'
  return String(n)
}

function toggleLike(id: number) {
  const n = new Set(liked.value)
  n.has(id) ? n.delete(id) : n.add(id)
  liked.value = n
}

function hideCard(id: number) {
  const n = new Set(hidden.value)
  n.add(id)
  hidden.value = n
  contextMenu.value = null
}

function onCardLongPressStart(id: number, e: any) {
  const x = e.touches?.[0]?.clientX || 0
  const y = e.touches?.[0]?.clientY || 0
  longPressTimer = setTimeout(() => { contextMenu.value = { id, x, y } }, 500)
}

function onCardLongPressEnd() {
  if (longPressTimer) { clearTimeout(longPressTimer); longPressTimer = null }
}

function handleLoadMore() {
  if (loadingMore.value || !hasMore.value) return
  loadingMore.value = true
  setTimeout(() => { loadingMore.value = false }, 1000)
}

// ==================== BottomNav ====================
const bottomTabs = [
  { id: 'home', label: '首页', emoji: '🏠', page: '/pages/index/index' },
  { id: 'circle', label: '圈子', emoji: '👥', page: '/pages/circles/index' },
  { id: 'paipan', label: '排盘', emoji: '☯', page: '/pages/paipan/index' },
  { id: 'discover', label: '发现', emoji: '🧭', page: '/pages/discover/index' },
  { id: 'profile', label: '我的', emoji: '👤', page: '/pages/profile/index' },
]
const currentPage = ref('home')

function isTabActive(id: string) { return currentPage.value === id }

function switchTab(tab: typeof bottomTabs[0]) {
  if (tab.id === 'home') return
  uni.switchTab({ url: tab.page }).catch(() => {
    uni.navigateTo({ url: tab.page })
  })
}

// ==================== 导航方法 ====================
function goSearch() { uni.navigateTo({ url: '/pages/search/index' }) }
function goMessages() { uni.navigateTo({ url: '/pages/messages/index' }) }
function goPublish() { uni.showToast({ title: '发布功能开发中', icon: 'none' }) }
function goChat() { uni.navigateTo({ url: '/pages/ai/chat/index' }) }
function goPaipan() { uni.navigateTo({ url: '/pages/paipan/index' }) }

function goBanner(b: typeof banners[0]) { uni.navigateTo({ url: b.link }) }

function goEntry(entry: typeof quickEntries[0]) { uni.navigateTo({ url: entry.link }) }

function goFeedItem(item: typeof feedItems[0]) {
  const routes: Record<string, string> = {
    live: '/pages/live/id-detail/index',
    course: '/pages/courses/id-detail/index',
    video: '/pages/video/detail/index',
    ebook: '/pages/classics/reader/index',
    product: '/pages/mall/product/index',
    article: '/pages/article/detail/index',
    post: '/pages/post/detail/index',
  }
  const url = routes[item.type] || '/pages/article/detail/index'
  uni.navigateTo({ url: url + '?id=' + item.id })
}

function goAgentChat(agent: typeof agents[0]) {
  uni.navigateTo({ url: '/pages/ai/chat/index?agentId=' + agent.id + '&agentName=' + encodeURIComponent(agent.name) })
}

function scrollToTop() {
  uni.pageScrollTo({ scrollTop: 0, duration: 300 })
  showBackTop.value = false
}

// ==================== 生命周期 ====================
onMounted(() => {
  startBannerAutoPlay()
})

onPageScroll((e: any) => {
  showBackTop.value = e.scrollTop > 1800
})

onUnmounted(() => {
  if (bannerTimer) clearInterval(bannerTimer)
  if (longPressTimer) clearTimeout(longPressTimer)
})
</script>

