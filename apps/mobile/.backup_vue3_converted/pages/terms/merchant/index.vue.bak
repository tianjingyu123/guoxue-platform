<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- ==================== 加载骨架屏 ==================== -->
    <view v-if="isLoading" class="min-h-screen bg-[#FAF8F5]">
      <view class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5] flex items-center px-4 h-12 gap-3 animate-pulse">
        <view class="w-5 h-5 bg-[#E8E0D5] rounded" />
        <view class="w-32 h-4 bg-[#E8E0D5] rounded" />
      </view>
      <view class="px-4 py-6 pb-20 max-w-2xl mx-auto animate-pulse">
        <view class="w-48 h-6 bg-[#E8E0D5] rounded mb-1" />
        <view class="w-36 h-3 bg-[#E8E0D5] rounded mb-6" />
        <view class="w-full h-10 bg-[#E8E0D5] rounded mb-6" />
        <view v-for="i in 7" :key="i" class="mb-6">
          <view class="w-40 h-4 bg-[#E8E0D5] rounded mb-2" />
          <view class="w-full h-16 bg-[#E8E0D5] rounded" />
        </view>
      </view>
    </view>

    <!-- ==================== 真实内容 ==================== -->
    <template v-else>
      <view class="min-h-screen bg-[#FAF8F5]">
        <!-- 顶栏 -->
        <view class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5] flex items-center px-4 h-12 gap-3">
          <view @click="goBack"><text class="text-lg text-[#2C2C2C]">←</text></view>
          <text class="text-base font-semibold text-[#2C2C2C]">商家入驻协议</text>
        </view>

        <!-- 正文 -->
        <view class="px-4 py-6 pb-20 max-w-2xl mx-auto">
          <text class="text-xl font-bold text-[#2C2C2C] mb-1 block">商家入驻服务协议</text>
          <text class="text-xs text-[#999] mb-6 block">最后更新：2024年01月01日</text>
          <text class="text-sm text-[#999] leading-relaxed mb-6 block">
            本协议规定了商家在儒布国学文化平台开展经营活动的权利与义务，请在申请入驻前仔细阅读。
          </text>

          <view v-for="s in sections" :key="s.title" class="mb-6">
            <text class="text-sm font-semibold text-[#2C2C2C] mb-2 block">{{ s.title }}</text>
            <text class="text-sm text-[#999] leading-relaxed block">{{ s.content }}</text>
          </view>
        </view>
      </view>
    </template>
  </view>
</template>

<script setup lang="ts">
import { ref } from 'vue'

// ==================== 加载状态 ====================
const isLoading = ref(true)

// ==================== 协议数据 ====================
interface Section {
  title: string
  content: string
}

const sections: Section[] = [
  { title: '1. 商家资质要求', content: '申请成为儒布平台商家，须具备合法的营业执照或个体工商户登记证明；具备履行本协议及提供相关服务的能力；不存在违法经营记录。个人讲师须提供身份证明及专业资质证书。' },
  { title: '2. 平台规则遵守', content: '商家须遵守平台内容审核规范，不得发布违法违规内容；须保证商品/服务信息的真实性和准确性；须按时履行与用户达成的交易；须妥善处理用户投诉。' },
  { title: '3. 佣金与结算', content: '平台对商家销售额收取相应比例的服务费，具体费率详见商家后台费率说明。平台每月结算上月收入，T+7个工作日内打款至绑定账户。如有税务问题，商家须自行承担。' },
  { title: '4. 商家义务', content: '商家须保证课程/服务内容的真实性与质量；须按照约定时间提供服务；须如实开具发票；须保护用户个人信息不外泄；须配合平台进行必要的审核和抽查。' },
  { title: '5. 违规处理', content: '商家违反平台规则，平台有权采取以下措施：警告并要求整改；下架违规商品；暂停商家权限；解除合作关系并追缴违规所得。情节严重者，平台将向相关部门举报。' },
  { title: '6. 知识产权', content: '商家保证所提供的内容不侵犯任何第三方知识产权。因商家内容引发的知识产权纠纷，由商家自行承担法律责任和赔偿损失。' },
  { title: '7. 协议终止', content: '双方均可提前30天书面通知对方终止本协议。协议终止后，平台将结算商家应得款项，商家须停止使用平台提供的所有资源和工具。' },
]

// ==================== 交互 ====================
const goBack = () => uni.navigateBack()

// ==================== 生命周期 ====================
setTimeout(() => { isLoading.value = false }, 500)
</script>

