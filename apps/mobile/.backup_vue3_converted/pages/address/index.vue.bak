<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-24">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-40 bg-[#FAF8F5]/95 backdrop-blur-lg border-b border-[#E8E0D5] safe-area-pt">
      <view class="flex items-center justify-between px-4 h-14">
        <view class="p-2 -ml-2" @click="goBack">
          <text class="text-lg">←</text>
        </view>
        <text class="font-semibold text-base">收货地址</text>
        <view class="w-9" />
      </view>
    </view>

    <!-- 地址列表 -->
    <view class="p-4 space-y-3">
      <view v-if="addresses.length === 0" class="flex flex-col items-center justify-center py-20">
        <view class="w-20 h-20 rounded-full bg-[#F5F1EB] flex items-center justify-center mb-4">
          <text class="text-2xl">📍</text>
        </view>
        <text class="text-[#999] text-sm">暂无收货地址</text>
        <text class="text-[#999]/70 text-xs mt-1">添加地址后可快速下单</text>
      </view>

      <view
        v-for="address in addresses"
        :key="address.id"
        class="relative overflow-hidden"
      >
        <!-- 滑动删除按钮 -->
        <view
          class="absolute right-0 top-0 bottom-0 w-20 bg-[#FF4D4F] flex items-center justify-center transition-opacity"
          :class="swipedId === address.id ? 'opacity-100' : 'opacity-0 pointer-events-none'"
          @tap="showDeleteConfirm = address.id"
        >
          <text class="text-white text-lg">🗑</text>
        </view>

        <view
          class="p-4 transition-transform bg-white border-b border-[#E8E0D5]"
          :class="swipedId === address.id ? '-translate-x-20' : ''"
          @tap="swipedId === address.id ? swipedId = null : handleSelectAddress(address)"
        >
          <view class="flex items-start justify-between">
            <view class="flex-1">
              <view class="flex items-center gap-2 mb-1">
                <text class="font-medium">{{ address.name }}</text>
                <text class="text-[#999]">{{ address.phone }}</text>
                <view v-if="address.isDefault" class="bg-[#C41E3A]/10 text-[#C41E3A] text-xs px-2 py-0.5 rounded-full">
                  <text>默认</text>
                </view>
              </view>
              <text class="text-sm text-[#999]">
                {{ address.province }}{{ address.city !== address.province ? address.city : '' }}{{ address.district }}{{ address.street }}{{ address.detail }}
              </text>
            </view>
            <view class="flex items-center gap-2 ml-3 shrink-0">
              <view class="p-1" @tap.stop="openEditModal(address)">
                <text class="text-[#C41E3A] text-sm">编辑</text>
              </view>
            </view>
          </view>
          <view v-if="!address.isDefault" class="mt-3 pt-3 border-t border-[#E8E0D5]" @tap.stop="handleSetDefault(address.id)">
            <text class="text-xs text-[#C41E3A]">设为默认地址</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 删除确认弹窗 -->
    <view v-if="showDeleteConfirm" class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center" @tap="showDeleteConfirm = null">
      <view class="bg-white rounded-xl mx-8 w-80 p-6" @tap.stop>
        <text class="text-lg font-medium block text-center mb-4">确认删除</text>
        <text class="text-[#999] text-sm block text-center mb-6">删除后无法恢复，确定要删除该地址吗？</text>
        <view class="flex gap-3">
          <view class="flex-1 py-2.5 rounded-lg bg-[#F5F1EB] text-center" @tap="showDeleteConfirm = null">
            <text>取消</text>
          </view>
          <view class="flex-1 py-2.5 rounded-lg bg-[#C41E3A] text-white text-center" @tap="handleDelete(showDeleteConfirm)">
            <text>删除</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 编辑弹窗 -->
    <view v-if="showEditModal" class="fixed inset-0 z-50 bg-black/50 flex flex-col justify-end" @tap="showEditModal = false">
      <view class="bg-white rounded-t-2xl max-h-[80vh] overflow-y-auto" @tap.stop>
        <view class="flex items-center justify-between p-4 border-b border-[#E8E0D5]">
          <text class="font-semibold">{{ editingAddress ? '编辑地址' : '新增地址' }}</text>
          <view class="p-1" @tap="showEditModal = false">
            <text class="text-lg">✕</text>
          </view>
        </view>

        <view class="p-4 space-y-4">
          <!-- 收货人 -->
          <view class="flex items-center gap-3">
            <text class="text-sm w-16 shrink-0">收货人</text>
            <input
              v-model="form.name"
              class="flex-1 h-10 px-3 bg-[#F5F1EB] rounded-lg text-sm"
              placeholder="请输入收货人姓名"
            />
          </view>

          <!-- 手机号 -->
          <view class="flex items-center gap-3">
            <text class="text-sm w-16 shrink-0">手机号</text>
            <input
              v-model="form.phone"
              class="flex-1 h-10 px-3 bg-[#F5F1EB] rounded-lg text-sm"
              type="number"
              maxlength="11"
              placeholder="请输入手机号"
            />
          </view>

          <!-- 所在地区 -->
          <view class="flex items-center gap-3" @tap="showRegionPicker = true">
            <text class="text-sm w-16 shrink-0">所在地区</text>
            <view class="flex-1 h-10 px-3 bg-[#F5F1EB] rounded-lg flex items-center">
              <text :class="form.province ? 'text-sm' : 'text-sm text-[#999]'">
                {{ form.province ? form.province + ' ' + form.city + ' ' + form.district : '请选择省市区' }}
              </text>
            </view>
            <text class="text-[#999]">›</text>
          </view>

          <!-- 街道 -->
          <view class="flex items-center gap-3">
            <text class="text-sm w-16 shrink-0">街道</text>
            <input
              v-model="form.street"
              class="flex-1 h-10 px-3 bg-[#F5F1EB] rounded-lg text-sm"
              placeholder="请输入街道信息"
            />
          </view>

          <!-- 详细地址 -->
          <view class="flex items-start gap-3">
            <text class="text-sm w-16 shrink-0 mt-2">详细地址</text>
            <textarea
              v-model="form.detail"
              class="flex-1 h-20 px-3 py-2 bg-[#F5F1EB] rounded-lg text-sm"
              placeholder="请输入门牌号等详细地址"
            />
          </view>

          <!-- 默认地址 -->
          <view class="flex items-center justify-between">
            <text class="text-sm">设为默认地址</text>
            <view
              class="w-11 h-6 rounded-full transition-colors"
              :class="form.isDefault ? 'bg-[#C41E3A]' : 'bg-gray-300'"
              @tap="form.isDefault = !form.isDefault"
            >
              <view class="w-5 h-5 rounded-full bg-white shadow mt-0.5 transition-transform" :class="form.isDefault ? 'translate-x-5' : 'translate-x-0.5'" />
            </view>
          </view>
        </view>

        <view class="p-4">
          <view class="w-full py-3 bg-[#C41E3A] text-white text-center rounded-lg" @tap="handleSave">
            <text class="font-medium">保存</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 地区选择器 -->
    <view v-if="showRegionPicker" class="fixed inset-0 z-50 bg-black/50 flex flex-col justify-end" @tap="showRegionPicker = false">
      <view class="bg-white rounded-t-2xl" @tap.stop>
        <view class="flex items-center justify-between p-4 border-b border-[#E8E0D5]">
          <view class="flex gap-2">
            <text :class="regionStep === 'province' ? 'font-semibold' : 'text-[#999]'" @tap="regionStep = 'province'">省份</text>
            <text v-if="form.province" :class="regionStep === 'city' ? 'font-semibold' : 'text-[#999]'" @tap="regionStep = 'city'">城市</text>
            <text v-if="form.city" :class="regionStep === 'district' ? 'font-semibold' : 'text-[#999]'" @tap="regionStep = 'district'">区县</text>
          </view>
          <view class="p-1" @tap="showRegionPicker = false">
            <text class="text-lg">✕</text>
          </view>
        </view>
        <view class="max-h-64 overflow-y-auto p-2">
          <view
            v-for="item in currentRegionOptions"
            :key="item"
            class="py-3 px-4 border-b border-[#E8E0D5]/50"
            :class="isRegionSelected(item) ? 'text-[#C41E3A] font-medium' : ''"
            @tap="handleSelectRegion(item)"
          >
            <text>{{ item }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部添加按钮 -->
    <view class="fixed bottom-0 left-0 right-0 p-4 bg-[#FAF8F5] border-t border-[#E8E0D5] safe-area-bottom">
      <view class="w-full py-3 bg-[#C41E3A] text-white text-center rounded-lg" @tap="openEditModal()">
        <text class="font-medium">+ 新增收货地址</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, reactive } from 'vue'

function goBack() { uni.navigateBack() }
function goTo(url: string) { uni.navigateTo({ url }) }

interface Address {
  id: number
  name: string
  phone: string
  province: string
  city: string
  district: string
  street: string
  detail: string
  isDefault: boolean
}

const initialAddresses: Address[] = [
  { id: 1, name: '张三', phone: '138****8888', province: '北京市', city: '北京市', district: '朝阳区', street: '建国路88号', detail: '国贸中心A座1808室', isDefault: true },
  { id: 2, name: '李四', phone: '139****9999', province: '上海市', city: '上海市', district: '浦东新区', street: '陆家嘴环路1000号', detail: '恒生银行大厦12层', isDefault: false },
  { id: 3, name: '王五', phone: '137****7777', province: '广东省', city: '深圳市', district: '南山区', street: '科技园南路', detail: '腾讯大厦8楼', isDefault: false },
]

const regions: { [key: string]: string[] } = {
  '北京市': ['北京市'],
  '上海市': ['上海市'],
  '广东省': ['广州市', '深圳市', '东莞市', '佛山市'],
  '浙江省': ['杭州市', '宁波市', '温州市'],
  '江苏省': ['南京市', '苏州市', '无锡市'],
  '四川省': ['成都市', '绵阳市', '德阳市'],
}

const districtRegions: { [key: string]: string[] } = {
  '北京市': ['朝阳区', '海淀区', '东城区', '西城区', '丰台区'],
  '上海市': ['浦东新区', '黄浦区', '静安区', '徐汇区', '长宁区'],
  '广州市': ['天河区', '越秀区', '荔湾区', '白云区'],
  '深圳市': ['南山区', '福田区', '罗湖区', '宝安区'],
  '杭州市': ['西湖区', '上城区', '下城区', '江干区'],
  '成都市': ['锦江区', '青羊区', '金牛区', '武侯区'],
}

const addresses = ref<Address[]>(initialAddresses)
const showEditModal = ref(false)
const showDeleteConfirm = ref<number | null>(null)
const editingAddress = ref<Address | null>(null)
const swipedId = ref<number | null>(null)

const form = reactive({
  name: '',
  phone: '',
  province: '',
  city: '',
  district: '',
  street: '',
  detail: '',
  isDefault: false,
})

const showRegionPicker = ref(false)
const regionStep = ref<'province' | 'city' | 'district'>('province')

const provinces = ['北京市', '上海市', '广东省', '浙江省', '江苏省', '四川省']

const currentRegionOptions = computed(() => {
  if (regionStep.value === 'province') return provinces
  if (regionStep.value === 'city') return regions[form.province] || []
  return districtRegions[form.city] || []
})

function isRegionSelected(value: string): boolean {
  if (regionStep.value === 'province') return form.province === value
  if (regionStep.value === 'city') return form.city === value
  return form.district === value
}

function handleSelectAddress(_addr: Address) {
  // 选择地址逻辑
}

function openEditModal(address?: Address) {
  if (address) {
    editingAddress.value = address
    form.name = address.name
    form.phone = address.phone
    form.province = address.province
    form.city = address.city
    form.district = address.district
    form.street = address.street
    form.detail = address.detail
    form.isDefault = address.isDefault
  } else {
    editingAddress.value = null
    form.name = ''
    form.phone = ''
    form.province = ''
    form.city = ''
    form.district = ''
    form.street = ''
    form.detail = ''
    form.isDefault = addresses.value.length === 0
  }
  showEditModal.value = true
}

function handleSave() {
  if (!form.name || !form.phone || !form.province || !form.detail) {
    uni.showToast({ title: '请完善地址信息', icon: 'none' })
    return
  }

  if (editingAddress.value) {
    // 编辑模式
    const idx = addresses.value.findIndex((a) => a.id === editingAddress.value!.id)
    if (idx >= 0) {
      addresses.value[idx] = { ...addresses.value[idx], ...form }
    }
    if (form.isDefault) {
      addresses.value.forEach((a) => { a.isDefault = a.id === editingAddress.value!.id })
    }
  } else {
    // 新增模式
    const newId = Math.max(...addresses.value.map((a) => a.id), 0) + 1
    if (form.isDefault) {
      addresses.value.forEach((a) => { a.isDefault = false })
    }
    addresses.value.push({ id: newId, ...form })
  }
  showEditModal.value = false
}

function handleDelete(id: number) {
  addresses.value = addresses.value.filter((a) => a.id !== id)
  showDeleteConfirm.value = null
  swipedId.value = null
}

function handleSetDefault(id: number) {
  addresses.value = addresses.value.map(addr => ({
    ...addr,
    isDefault: addr.id === id
  }))
}

function handleSelectRegion(value: string) {
  if (regionStep.value === 'province') {
    form.province = value
    form.city = ''
    form.district = ''
    regionStep.value = 'city'
  } else if (regionStep.value === 'city') {
    form.city = value
    form.district = ''
    regionStep.value = 'district'
  } else {
    form.district = value
    showRegionPicker.value = false
    regionStep.value = 'province'
  }
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
