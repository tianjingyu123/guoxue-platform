<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- ===== 导航栏 ===== -->
    <view class="sticky top-0 z-20 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 h-14">
        <view @click="goBack" class="p-2 -ml-2 active:opacity-60">
          <text class="text-xl text-[#2C2C2C] leading-none">←</text>
        </view>
        <text class="font-medium text-[#2C2C2C]">通讯录</text>
        <view class="flex items-center gap-1">
          <view @click="showSearch = true" class="p-2 active:opacity-60">
            <text class="text-lg leading-none">🔍</text>
          </view>
          <view @click="goTo('/pages/im/add-friend/index')" class="p-2 -mr-2 active:opacity-60">
            <text class="text-lg leading-none">👤+</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 主内容 ===== -->
    <view class="flex-1 flex overflow-hidden relative">
      <!-- 好友列表 -->
      <scroll-view scroll-y class="flex-1 overflow-y-auto" style="padding-right:24px;height:100%"
        @scroll="onListScroll" :scroll-into-view="scrollIntoViewId" scroll-with-animation>
        <!-- 加载骨架屏 -->
        <view v-if="loading" class="p-4 space-y-4">
          <view v-for="i in 8" :key="i" class="flex items-center gap-3">
            <view class="w-12 h-12 rounded-full animate-pulse" style="background:rgba(200,200,200,0.3)" />
            <view class="flex-1 space-y-2">
              <view class="h-4 w-24 rounded animate-pulse" style="background:rgba(200,200,200,0.3)" />
              <view class="h-3 w-32 rounded animate-pulse" style="background:rgba(200,200,200,0.3)" />
            </view>
          </view>
        </view>

        <!-- 错误态 -->
        <view v-else-if="error" class="flex flex-col items-center py-20">
          <text class="text-5xl text-[#E8E0D5] block mb-4">😵</text>
          <text class="text-[#999] text-sm mb-1">{{ error }}</text>
          <view @click="loadFriends" class="mt-3 px-6 py-2 bg-[#C41E3A] text-white text-sm rounded-full active:opacity-90">
            重试
          </view>
        </view>

        <!-- 分组列表 -->
        <view v-else-if="groups.length > 0">
          <view v-for="group in groups" :key="group.letter">
            <!-- 字母标题（sticky） -->
            <view :id="'letter-' + group.letter"
              class="sticky top-0 z-10 px-4 py-1.5"
              style="background:rgba(250,248,245,0.85);backdrop-filter:blur(4px)">
              <text class="text-xs font-medium text-[#999]">{{ group.letter }}</text>
            </view>
            <!-- 好友列表 -->
            <view class="px-2">
              <view v-for="friend in group.friends" :key="friend.id" @click="selectFriend(friend)"
                class="flex items-center gap-3 p-3 rounded-lg active:bg-[#F5F1EB]/50 transition-colors">
                <view class="relative">
                  <image :src="friend.avatar" mode="aspectFill" class="w-12 h-12 rounded-full bg-[#F5F1EB]" />
                  <view v-if="friend.isOnline"
                    class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 rounded-full border-2 border-white" />
                </view>
                <view class="flex-1 min-w-0">
                  <view class="flex items-center gap-2">
                    <text class="font-medium text-sm text-[#2C2C2C] truncate">{{ friend.remark || friend.nickname }}</text>
                    <text v-if="friend.remark" class="text-xs text-[#999] shrink-0">({{ friend.nickname }})</text>
                  </view>
                  <text v-if="friend.signature" class="text-xs text-[#999] truncate block mt-0.5">{{ friend.signature }}</text>
                  <text v-else-if="!friend.isOnline && friend.lastActiveAt" class="text-xs text-[#999] block mt-0.5">{{ friend.lastActiveAt }}活跃</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 空态 -->
        <view v-else class="flex flex-col items-center py-20">
          <text class="text-5xl block mb-4 opacity-30">👥</text>
          <text class="text-[#999] text-sm">暂无好友</text>
          <text class="text-[#999] text-xs mt-1">快去添加好友吧</text>
        </view>
      </scroll-view>

      <!-- 右侧字母索引条 -->
      <view v-if="letterList.length > 0"
        class="absolute right-0 top-0 bottom-0 w-6 flex flex-col items-center justify-center py-2 z-20">
        <view v-for="(letter, index) in letterList" :key="letter" @click="scrollToLetter(letter, index)"
          class="w-5 h-5 flex items-center justify-center text-[10px] font-medium transition-colors active:opacity-60"
          :class="activeLetterIndex === index ? 'text-[#C41E3A] bg-[#C41E3A]/10 rounded-full' : 'text-[#999]'">
          <text>{{ letter }}</text>
        </view>
      </view>
    </view>

    <!-- ===== 搜索弹层（全屏） ===== -->
    <view v-if="showSearch" class="fixed inset-0 z-50 bg-white flex flex-col">
      <view class="flex items-center gap-3 px-4 py-3 border-b border-[#E8E0D5]">
        <view class="flex-1 relative">
          <text class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-[#999] z-10">🔍</text>
          <input v-model="searchKeyword" @input="handleSearchInput" placeholder="搜索昵称、备注"
            class="w-full h-9 pl-9 pr-8 bg-[#F5F1EB] rounded-full text-sm outline-none box-border"
            focus @confirm="handleSearch" />
          <text v-if="searchKeyword" @click="clearSearch"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-[#999] text-sm leading-none active:opacity-60">✕</text>
        </view>
        <text @click="closeSearch" class="text-[#C41E3A] text-sm active:opacity-60">取消</text>
      </view>

      <scroll-view scroll-y class="flex-1 p-4">
        <!-- 搜索中骨架 -->
        <view v-if="isSearching" class="space-y-3 py-4">
          <view v-for="i in 3" :key="i" class="flex items-center gap-3">
            <view class="w-10 h-10 rounded-full animate-pulse" style="background:rgba(200,200,200,0.3)" />
            <view class="h-4 w-24 rounded animate-pulse" style="background:rgba(200,200,200,0.3)" />
          </view>
        </view>

        <!-- 搜索结果 -->
        <template v-else-if="searchKeyword">
          <view v-if="searchResults.length > 0" class="space-y-1">
            <view v-for="f in searchResults" :key="f.id" @click="selectFriend(f)"
              class="flex items-center gap-3 p-3 rounded-lg active:bg-[#F5F1EB] transition-colors">
              <image :src="f.avatar" mode="aspectFill" class="w-10 h-10 rounded-full bg-[#F5F1EB]" />
              <view class="flex-1 min-w-0">
                <text class="text-sm font-medium text-[#2C2C2C] block truncate">{{ f.remark || f.nickname }}</text>
                <text class="text-xs text-[#999] block truncate">{{ f.signature }}</text>
              </view>
            </view>
          </view>
          <view v-else class="text-center py-12">
            <text class="block text-sm text-[#999]">未找到相关好友</text>
          </view>
        </template>

        <!-- 初始提示 -->
        <view v-else class="text-center py-12">
          <text class="block text-sm text-[#999]">输入关键词搜索好友</text>
        </view>
      </scroll-view>
    </view>

    <!-- ===== 好友操作弹窗（底部弹窗） ===== -->
    <view v-if="selectedFriend" class="fixed inset-0 z-50 bg-black/40" @click="selectedFriend = null">
      <view class="absolute bottom-0 left-0 right-0 bg-white rounded-t-2xl p-4 pb-8" style="padding-bottom:calc(32px + env(safe-area-inset-bottom))" @click.stop>
        <view class="flex items-center gap-4 py-4">
          <view class="relative">
            <image :src="selectedFriend.avatar" mode="aspectFill" class="w-16 h-16 rounded-full bg-[#F5F1EB]" />
            <view v-if="selectedFriend.isOnline"
              class="absolute bottom-0 right-0 w-4 h-4 bg-green-500 rounded-full border-2 border-white" />
          </view>
          <view class="flex-1 min-w-0">
            <text class="text-lg font-semibold text-[#2C2C2C] block">{{ selectedFriend.remark || selectedFriend.nickname }}</text>
            <text v-if="selectedFriend.remark" class="text-sm text-[#999] block">昵称: {{ selectedFriend.nickname }}</text>
            <text v-if="selectedFriend.signature" class="text-sm text-[#999] block mt-1">{{ selectedFriend.signature }}</text>
            <text :class="['text-xs mt-1 block', selectedFriend.isOnline ? 'text-green-500' : 'text-[#999]']">
              {{ selectedFriend.isOnline ? '在线' : selectedFriend.lastActiveAt ? selectedFriend.lastActiveAt + '活跃' : '离线' }}
            </text>
          </view>
        </view>

        <view class="grid grid-cols-2 gap-3">
          <view @click="handleFriendAction('chat')"
            class="py-3 bg-[#C41E3A] text-white rounded-full text-center text-sm font-medium active:opacity-90 transition-all flex items-center justify-center gap-2">
            <text>💬</text>
            <text>发消息</text>
          </view>
          <view @click="handleFriendAction('profile')"
            class="py-3 border border-[#E8E0D5] rounded-full text-center text-sm text-[#2C2C2C] active:bg-[#F5F1EB] transition-all flex items-center justify-center gap-2">
            <text>👤</text>
            <text>查看主页</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

// ===== 类型定义 =====
interface FriendItem {
  id: string
  nickname: string
  remark?: string
  avatar: string
  signature?: string
  isOnline: boolean
  lastActiveAt?: string
}

interface FriendGroup {
  letter: string
  friends: FriendItem[]
}

// ===== 状态 =====
const loading = ref(true)
const error = ref<string | null>(null)
const groups = ref<FriendGroup[]>([])
const letterList = ref<string[]>([])
const activeLetterIndex = ref(0)
const scrollIntoViewId = ref('')

// 搜索
const showSearch = ref(false)
const searchKeyword = ref('')
const searchResults = ref<FriendItem[]>([])
const isSearching = ref(false)

// 好友操作
const selectedFriend = ref<FriendItem | null>(null)

// ===== Mock 数据 =====
const mockFriends: FriendItem[] = [
  { id: 'a1', nickname: '安乐先生', remark: '安老师', avatar: '', signature: '易学传承人', isOnline: true },
  { id: 'f1', nickname: '福缘阁主', avatar: '', signature: '吉祥物专家', isOnline: true, lastActiveAt: '10分钟前' },
  { id: 'g1', nickname: '国学传承者', avatar: '', signature: '弘扬中华文化', isOnline: false, lastActiveAt: '2小时前' },
  { id: 'l1', nickname: '李淳风', avatar: '', signature: '风水命理大师', isOnline: true },
  { id: 'l2', nickname: '刘伯温', avatar: '', signature: '奇门遁甲传承', isOnline: false, lastActiveAt: '昨天' },
  { id: 'z1', nickname: '周易大师', avatar: '', signature: '八字命理研究者', isOnline: false, lastActiveAt: '3天前' },
  { id: 'z2', nickname: '张玄风', remark: '老张', avatar: '', signature: '紫微斗数专家', isOnline: true },
  { id: 'z3', nickname: '紫微传承人', avatar: '', signature: '斗数传承', isOnline: false, lastActiveAt: '1周前' },
]

// ===== 按首字母分组 =====
function groupByPinyin(items: FriendItem[]): FriendGroup[] {
  const groups: Record<string, FriendItem[]> = {}
  const pinyinMap: Record<string, string> = {
    '安': 'A', '乐': 'L', '福': 'F', '国': 'G', '李': 'L',
    '刘': 'L', '周': 'Z', '张': 'Z', '紫': 'Z',
  }

  for (const f of items) {
    const firstChar = f.remark ? f.remark[0] : f.nickname[0]
    let letter = pinyinMap[firstChar] || 'Z'
    // 按拼音首字母匹配
    const code = firstChar.charCodeAt(0)
    if (code >= 0xB0C5 && code <= 0xB2C0) letter = 'A'
    else if (code >= 0xB2C1 && code <= 0xB4ED) letter = 'B'
    else if (code >= 0xB4EE && code <= 0xB6E9) letter = 'C'
    else if (code >= 0xB6EA && code <= 0xB7A1) letter = 'D'
    else if (code >= 0xB7A2 && code <= 0xB8C0) letter = 'E'
    else if (code >= 0xB8C1 && code <= 0xB9DD) letter = 'F'
    else if (code >= 0xB9DE && code <= 0xBBF6) letter = 'G'
    else if (code >= 0xBBF7 && code <= 0xBFA5) letter = 'H'
    else if (code >= 0xBFA6 && code <= 0xC0DB) letter = 'J'
    else if (code >= 0xC0DC && code <= 0xC54F) letter = 'K'
    else if (code >= 0xC550 && code <= 0xC666) letter = 'L'
    else if (code >= 0xC667 && code <= 0xC86E) letter = 'M'
    else if (code >= 0xC86F && code <= 0xC9D9) letter = 'N'
    else if (code >= 0xC9DA && code <= 0xCBD7) letter = 'O'
    else if (code >= 0xCBD8 && code <= 0xCCD5) letter = 'P'
    else if (code >= 0xCCD6 && code <= 0xCEB9) letter = 'Q'
    else if (code >= 0xCEBA && code <= 0xD0D9) letter = 'R'
    else if (code >= 0xD0DA && code <= 0xD3E8) letter = 'S'
    else if (code >= 0xD3E9 && code <= 0xD6D2) letter = 'T'
    else if (code >= 0xD6D3 && code <= 0xD8DE) letter = 'W'
    else if (code >= 0xD8DF && code <= 0xDAF9) letter = 'X'
    else if (code >= 0xDAFA && code <= 0xDDF9) letter = 'Y'
    else if (code >= 0xDDFA && code <= 0xE05B) letter = 'Z'

    if (!groups[letter]) groups[letter] = []
    groups[letter].push(f)
  }

  return Object.keys(groups).sort().map(letter => ({
    letter,
    friends: groups[letter],
  }))
}

// ===== 生命周期 =====
onMounted(() => {
  loadFriends()
})

// ===== 数据加载 =====
function loadFriends() {
  loading.value = true
  error.value = null

  // 模拟 API 调用
  setTimeout(() => {
    try {
      const grouped = groupByPinyin(mockFriends)
      groups.value = grouped
      letterList.value = grouped.map(g => g.letter)
    } catch {
      error.value = '网络错误，请重试'
    } finally {
      loading.value = false
    }
  }, 500)
}

// ===== 字母索引跳转 =====
function scrollToLetter(letter: string, index: number) {
  activeLetterIndex.value = index
  scrollIntoViewId.value = 'letter-' + letter
}

// ===== 列表滚动监听 =====
function onListScroll(e: any) {
  // 简化实现：不实时追踪每个分组的位置
  // 在 scroll-view 中无法完美复刻 Web 的 getBoundingClientRect
}

// ===== 搜索 =====
function handleSearchInput(e: any) {
  const val = e?.detail?.value ?? searchKeyword.value
  if (!val.trim()) {
    searchResults.value = []
    return
  }
}

function handleSearch() {
  const keyword = searchKeyword.value.trim()
  if (!keyword) {
    searchResults.value = []
    return
  }

  isSearching.value = true
  setTimeout(() => {
    // 模拟搜索 API
    const results = mockFriends.filter(f =>
      (f.remark || f.nickname).includes(keyword) ||
      (f.signature || '').includes(keyword)
    )
    searchResults.value = results
    isSearching.value = false
  }, 300)
}

function clearSearch() {
  searchKeyword.value = ''
  searchResults.value = []
}

function closeSearch() {
  showSearch.value = false
  searchKeyword.value = ''
  searchResults.value = []
}

// ===== 好友操作 =====
function selectFriend(f: FriendItem) {
  if (showSearch.value) {
    showSearch.value = false
    searchKeyword.value = ''
    searchResults.value = []
  }
  selectedFriend.value = f
}

function handleFriendAction(action: 'chat' | 'profile') {
  if (!selectedFriend.value) return
  const id = selectedFriend.value.id
  selectedFriend.value = null

  if (action === 'chat') {
    goTo('/pages/im/chat/id-detail/index?id=' + id)
  } else {
    goTo('/pages/user/index?id=' + id)
  }
}

// ===== 导航 =====
function goBack() {
  uni.navigateBack()
}

function goTo(url: string) {
  uni.navigateTo({ url })
}
</script>

<style scoped>
.animate-pulse {
  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* scroll-view 内 sticky 支持 */
view[style*="position: sticky"] {
  position: -webkit-sticky;
  position: sticky;
}

.transition-colors {
  transition: background-color 0.2s ease;
}
</style>
