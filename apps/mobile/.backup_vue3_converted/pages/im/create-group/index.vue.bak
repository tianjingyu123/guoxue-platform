<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center px-4 h-12 gap-3">
        <view @click="step === 'name' ? step = 'select' : goBack()" class="p-1 -ml-1"><text class="text-xl text-[#2C2C2C]">←</text></view>
        <text class="text-base font-semibold text-[#2C2C2C] flex-1">{{ step === 'select' ? '创建群聊' : '群聊设置' }}</text>
        <text v-if="step === 'select' && selected.length >= 2" @click="toNameStep" class="text-[#C41E3A] text-sm font-medium" hover-class="press-opacity-80">下一步</text>
      </view>
    </view>

    <!-- 选择好友 -->
    <view v-if="step === 'select'" class="px-4 pt-4 pb-24">
      <view class="relative mb-4">
        <text class="absolute left-3 top-1/2 -translate-y-1/2 text-[#999]">🔍</text>
        <input v-model="search" placeholder="搜索好友" class="w-full pl-9 pr-3 py-2.5 bg-white border border-[#E8E0D5] rounded-xl text-sm outline-none" />
      </view>

      <view v-if="selected.length > 0" class="mb-4">
        <text class="text-xs text-[#999] mb-2 block">已选 {{ selected.length }} 人（至少选 2 人）</text>
        <view class="flex gap-2 flex-wrap">
          <view v-for="f in selectedFriends" :key="f.id" @click="toggle(f.id)" class="relative">
            <view class="w-10 h-10 rounded-full bg-gradient-to-br from-[#C41E3A] to-[#E74C3C] flex items-center justify-center text-white text-sm">{{ f.name[0] }}</view>
            <text class="absolute -top-0.5 -right-0.5 w-4 h-4 bg-[#C41E3A] rounded-full text-white text-[10px] flex items-center justify-center">✕</text>
          </view>
        </view>
      </view>

      <view class="space-y-2">
        <view v-for="friend in filtered" :key="friend.id" @click="toggle(friend.id)" hover-class="press-opacity-80" class="flex items-center gap-3 p-3 rounded-xl border border-[#E8E0D5] bg-white">
          <view :class="['w-5 h-5 rounded-full border-2 flex items-center justify-center flex-shrink-0', selected.includes(friend.id) ? 'bg-[#C41E3A] border-[#C41E3A]' : 'border-[#E8E0D5]']">
            <text v-if="selected.includes(friend.id)" class="text-white text-xs">✓</text>
          </view>
          <view class="w-10 h-10 rounded-full bg-gradient-to-br from-[#C41E3A] to-[#E74C3C] flex items-center justify-center text-white text-sm flex-shrink-0">{{ friend.name[0] }}</view>
          <view class="flex-1 min-w-0">
            <text class="text-sm font-medium text-[#2C2C2C] block">{{ friend.name }}</text>
            <text class="text-xs text-[#999] block">{{ friend.bio }}</text>
          </view>
        </view>
      </view>

      <!-- 底部下一步按钮 -->
      <view v-if="selected.length >= 2" class="fixed bottom-0 left-0 right-0 px-4 pb-6 pt-3 bg-white border-t border-[#E8E0D5]" style="padding-bottom:calc(16px + env(safe-area-inset-bottom))">
        <view @click="toNameStep" hover-class="press-opacity-90" class="w-full py-3 bg-[#C41E3A] text-white rounded-xl text-center text-base font-medium">
          <text>下一步（已选 {{ selected.length }} 人）</text>
        </view>
      </view>
    </view>

    <!-- 群聊设置 -->
    <view v-else class="px-4 pt-6 pb-24 space-y-6">
      <view class="flex flex-col items-center gap-3">
        <view class="w-20 h-20 rounded-2xl bg-gray-100 border-2 border-dashed border-[#E8E0D5] flex flex-col items-center justify-center">
          <text class="text-[#999]">📷</text>
          <text class="text-xs text-[#999]">群头像</text>
        </view>
        <view class="flex gap-1 flex-wrap justify-center max-w-xs">
          <view v-for="f in selectedFriends" :key="f.id" class="w-7 h-7 rounded-full bg-gradient-to-br from-[#C41E3A] to-[#E74C3C] flex items-center justify-center text-white text-[10px]">{{ f.name[0] }}</view>
        </view>
      </view>

      <view>
        <text class="text-sm font-medium text-[#2C2C2C] mb-1.5 block">群聊名称</text>
        <input v-model="groupName" placeholder="设置群聊名称" maxlength="20" class="w-full px-3 py-2.5 bg-white border border-[#E8E0D5] rounded-xl text-sm outline-none" />
        <text class="text-xs text-[#999] text-right mt-1 block">{{ groupName.length }}/20</text>
      </view>

      <view class="flex items-center gap-2 p-3 bg-gray-50 rounded-xl">
        <text class="text-sm text-[#999]">群成员：{{ selected.length + 1 }} 人（含自己）</text>
      </view>

      <view class="fixed bottom-0 left-0 right-0 px-4 pb-6 pt-3 bg-white border-t border-[#E8E0D5]">
        <view @click="doCreate" hover-class="press-opacity-90" :class="['w-full py-3 rounded-xl text-center text-base font-medium flex items-center justify-center gap-2', loading || !groupName.trim() ? 'bg-gray-200 text-gray-400' : 'bg-[#C41E3A] text-white']">
          <view v-if="loading" class="w-4 h-4 rounded-full border-2 border-white border-t-transparent" style="animation: spin 0.8s linear infinite;" />
          <text>{{ loading ? '创建中...' : '创建群聊' }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

interface Friend { id: string; name: string; avatar: string; bio: string }

const friends: Friend[] = [
  { id: '1', name: '周易大师', avatar: '', bio: '八字命理' },
  { id: '2', name: '张玄风', avatar: '', bio: '紫微斗数' },
  { id: '3', name: '李玄机', avatar: '', bio: '易经占卜' },
  { id: '4', name: '王德华', avatar: '', bio: '风水堪舆' },
  { id: '5', name: '林奇门', avatar: '', bio: '奇门遁甲' },
  { id: '6', name: '陈梅花', avatar: '', bio: '梅花易数' },
]

const search = ref('')
const selected = ref<string[]>([])
const groupName = ref('')
const step = ref<'select' | 'name'>('select')
const loading = ref(false)

const filtered = computed(() => friends.filter(f => f.name.includes(search.value) || f.bio.includes(search.value)))
const selectedFriends = computed(() => friends.filter(f => selected.value.includes(f.id)))

function toggle(id: string) {
  if (selected.value.includes(id)) {
    selected.value = selected.value.filter(x => x !== id)
  } else {
    selected.value.push(id)
  }
}

function toNameStep() {
  if (selected.value.length < 2) { uni.showToast({ title: '至少选择2人', icon: 'none' }); return }
  // 自动生成群名称
  const names = selectedFriends.value.map(f => f.name).join('、')
  groupName.value = names.length > 15 ? names.slice(0, 15) + '…' : names
  step.value = 'name'
}

function doCreate() {
  if (!groupName.value.trim()) { uni.showToast({ title: '请输入群名称', icon: 'none' }); return }
  loading.value = true
  setTimeout(() => {
    loading.value = false
    uni.showToast({ title: '创建成功', icon: 'success' })
    setTimeout(() => uni.navigateBack(), 800)
  }, 1000)
}

function goBack() { uni.navigateBack() }
</script>

<style scoped>
.press-opacity-90:active { opacity: 0.9; }
.press-opacity-80:active { opacity: 0.8; }

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
</style>
