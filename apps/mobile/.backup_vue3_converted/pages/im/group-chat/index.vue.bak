// ==================== Mock API (Structured stubs mirroring real API shapes) ====================

function delay(ms: number): Promise<void> {
  return new Promise(resolve => setTimeout(resolve, ms))
}

/** 模拟获取群详情 */
async function mockGetGroupDetail(groupId: number): Promise<{ code: number; data: GroupDetail | null }> {
  await delay(300)
  return { code: 200, data: { ...MOCK_GROUP_DETAIL, id: groupId } }
}

/** 模拟获取聊天历史 */
async function mockGetGroupChatHistory(
  groupId: number,
  cursor?: number,
  limit?: number,
): Promise<{ code: number; data: { messages: GroupChatMessage[]; nextCursor?: number; hasMore: boolean } | null }> {
  await delay(400)
  const allMessages = MOCK_MESSAGES.map(m => ({ ...m })).reverse()
  const pageSize = limit || 20
  const startIdx = cursor ? allMessages.findIndex(m => m.id === cursor) : 0
  const page = allMessages.slice(startIdx, startIdx + pageSize)
  const hasMore = startIdx + pageSize < allMessages.length
  const nextCursor = hasMore ? page[page.length - 1]?.id : undefined
  return { code: 200, data: { messages: page.reverse(), nextCursor, hasMore } }
}

/** 模拟获取群成员 */
async function mockGetGroupMembers(groupId: number): Promise<{ code: number; data: GroupMember[] }> {
  await delay(300)
  return { code: 200, data: MOCK_MEMBERS.map(m => ({ ...m })) }
}

/** 模拟搜索@成员 */
async function mockSearchGroupMembersForAt(groupId: number, keyword: string): Promise<{ code: number; data: GroupMember[] }> {
  await delay(200)
  let results = MOCK_MEMBERS.map(m => ({ ...m }))
  if (keyword) {
    const kw = keyword.toLowerCase()
    results = results.filter(m => m.nickname.toLowerCase().includes(kw) || m.remark.toLowerCase().includes(kw))
  }
  results = results.filter(m => m.id !== CURRENT_USER_ID)
  return { code: 200, data: results }
}

/** 模拟发送消息 */
async function mockSendGroupMessage(params: {
  groupId: number
  type: string
  content: string
  atMembers?: number[]
}): Promise<{ code: number; data: { messageId: number; timestamp: number } }> {
  await delay(600)
  return { code: 200, data: { messageId: Date.now(), timestamp: Date.now() } }
}

/** 模拟撤回消息 */
async function mockWithdrawGroupMessage(groupId: number, messageId: number): Promise<{ code: number }> {
  await delay(300)
  return { code: 200 }
}

// ==================== Page State ====================

const groupDetail = ref<GroupDetail | null>(null)
const messages = ref<GroupChatMessage[]>([])
const members = ref<GroupMember[]>([])
const loading = ref(true)
const error = ref<string | null>(null)
const refreshing = ref(false)
const hasMoreHistory = ref(true)
const historyCursor = ref<number | undefined>(undefined)

const inputText = ref('')
const sending = ref(false)
const showMorePanel = ref(false)
const showMembersSheet = ref(false)
const showNoticeSheet = ref(false)
const showAtList = ref(false)
const atSearchKeyword = ref('')
const atSearchResults = ref<GroupMember[]>([])
const selectedAtMembers = ref<number[]>([])
const selectedMessage = ref<GroupChatMessage | null>(null)
const inputFocusFlag = ref(false)

// 滚动锚点
const scrollAnchor = ref('endRef')

// 安全区域适配
const envSafeArea = ref('12px')

// ==================== Computed ====================

const onlineCount = computed(() => {
  // 模拟在线计算
  return members.value.filter((_, i) => i % 3 === 0).length
})

const memberDisplayList = computed(() => {
  return members.value.slice(0, 10)
})

// ==================== Lifecycle ====================

onMounted(() => {
  // 获取系统安全区域
  uni.getSystemInfo({
    success: (res) => {
      const bottom = (res as any).safeArea?.bottom || 0
      const height = res.windowHeight || 0
      const safeBottom = bottom > height ? 0 : height - bottom
      envSafeArea.value = safeBottom > 0 ? safeBottom + 12 + 'px' : '12px'
    },
  })

  loadChat()
})

// ==================== Data Loading ====================

function getGroupId(): number {
  try {
    const pages = getCurrentPages()
    const currentPage = pages[pages.length - 1] as any
    const id = currentPage?.options?.id
    return id ? Number(id) : 1
  } catch {
    return 1
  }
}

async function loadChat() {
  loading.value = true
  error.value = null
  try {
    const groupId = getGroupId()
    const [detailRes, historyRes, membersRes] = await Promise.all([
      mockGetGroupDetail(groupId),
      mockGetGroupChatHistory(groupId, undefined, 30),
      mockGetGroupMembers(groupId),
    ])

    if (detailRes.code === 200 && detailRes.data) {
      groupDetail.value = detailRes.data
    }
    if (historyRes.code === 200 && historyRes.data) {
      messages.value = historyRes.data.messages
      hasMoreHistory.value = historyRes.data.hasMore
      historyCursor.value = historyRes.data.nextCursor
    }
    if (membersRes.code === 200 && membersRes.data) {
      members.value = membersRes.data
    }
  } catch (err) {
    error.value = '加载失败，请检查网络后重试'
  } finally {
    loading.value = false
    nextTick(() => scrollToBottom())
  }
}

/** 下拉加载更多历史消息 */
async function onLoadMoreHistory() {
  if (refreshing.value || !hasMoreHistory.value) return
  refreshing.value = true
  try {
    const groupId = getGroupId()
    const res = await mockGetGroupChatHistory(groupId, historyCursor.value, 20)
    if (res.code === 200 && res.data) {
      const olderMessages = res.data.messages
      messages.value = [...olderMessages, ...messages.value]
      hasMoreHistory.value = res.data.hasMore
      historyCursor.value = res.data.nextCursor
    }
  } catch {
    uni.showToast({ title: '加载历史消息失败', icon: 'none' })
  } finally {
    refreshing.value = false
  }
}

// ==================== Message Sending ====================

async function handleSend() {
  if (!inputText.value.trim() && selectedAtMembers.value.length === 0) return
  if (sending.value) return

  const content = inputText.value
  inputText.value = ''
  sending.value = true

  try {
    const groupId = getGroupId()
    const res = await mockSendGroupMessage({
      groupId,
      type: 'text',
      content,
      atMembers: selectedAtMembers.value.length > 0 ? [...selectedAtMembers.value] : undefined,
    })

    if (res.code === 200 && res.data) {
      const newMessage: GroupChatMessage = {
        id: res.data.messageId,
        senderId: CURRENT_USER_ID,
        senderName: '我',
        senderAvatar: '',
        senderRole: groupDetail.value?.myRole,
        type: 'text',
        content,
        atMembers: selectedAtMembers.value.length > 0 ? [...selectedAtMembers.value] : undefined,
        status: 'sending',
        isWithdrawn: false,
        createdAt: new Date().toLocaleString('zh-CN'),
        timestamp: res.data.timestamp,
      }
      messages.value.push(newMessage)
      selectedAtMembers.value = []
      showMorePanel.value = false
      nextTick(() => scrollToBottom())

      // 模拟依次更新消息状态：sending → sent → delivered
      setTimeout(() => {
        updateMessageStatus(newMessage.id, 'sent')
      }, 500)
      setTimeout(() => {
        updateMessageStatus(newMessage.id, 'delivered')
      }, 1500)
    }
  } catch {
    uni.showToast({ title: '发送失败', icon: 'none' })
  } finally {
    sending.value = false
  }
}

function updateMessageStatus(messageId: number, status: GroupChatMessage['status']) {
  const idx = messages.value.findIndex(m => m.id === messageId)
  if (idx !== -1) {
    messages.value[idx] = { ...messages.value[idx], status }
  }
}

// ==================== @ Mention ====================

function handleSelectAtMember(member: GroupMember) {
  if (!selectedAtMembers.value.includes(member.id)) {
    selectedAtMembers.value.push(member.id)
    inputText.value += `@${member.nickname} `
  }
  showAtList.value = false
  atSearchKeyword.value = ''
  focusInput()
}

function handleAtAll() {
  inputText.value += '@所有人 '
  showAtList.value = false
  focusInput()
}

function showAtMemberList() {
  showAtList.value = !showAtList.value
  showMorePanel.value = false
  if (showAtList.value) {
    loadAtSearchResults()
  }
}

async function loadAtSearchResults() {
  const groupId = getGroupId()
  const res = await mockSearchGroupMembersForAt(groupId, atSearchKeyword.value)
  if (res.code === 200 && res.data) {
    atSearchResults.value = res.data.filter(m => m.id !== CURRENT_USER_ID)
  }
}

function onAtSearchInput() {
  loadAtSearchResults()
}

function focusInput() {
  inputFocusFlag.value = false
  nextTick(() => {
    inputFocusFlag.value = true
  })
}

/** 检测输入中是否包含@符号 */
function detectAtTrigger(val: string) {
  if (val.endsWith('@') && !showAtList.value) {
    showAtMemberList()
  }
}

watch(inputText, (val) => {
  detectAtTrigger(val)
})

// ==================== Message Actions ====================

function onMessageLongPress(msg: GroupChatMessage) {
  uni.vibrateShort?.()
  selectedMessage.value = msg
}

function closeMessageAction() {
  selectedMessage.value = null
}

async function handleWithdraw(message: GroupChatMessage) {
  const groupId = getGroupId()
  const res = await mockWithdrawGroupMessage(groupId, message.id)
  if (res.code === 200) {
    const idx = messages.value.findIndex(m => m.id === message.id)
    if (idx !== -1) {
      messages.value[idx] = { ...messages.value[idx], isWithdrawn: true }
    }
    uni.showToast({ title: '消息已撤回', icon: 'success' })
  }
  selectedMessage.value = null
}

function handleCopy(content: string) {
  uni.setClipboardData({
    data: content,
    success: () => {
      uni.showToast({ title: '已复制到剪贴板', icon: 'success' })
    },
  })
  selectedMessage.value = null
}

function canWithdrawMessage(timestamp: number): boolean {
  // 2分钟内可撤回
  return Date.now() - timestamp < 120000
}

// ==================== More Panel Actions ====================

function handleAlbum() {
  uni.chooseImage({
    count: 1,
    success: (res) => {
      const tempPath = res.tempFilePaths[0]
      // 模拟发送图片消息
      const newMessage: GroupChatMessage = {
        id: Date.now(),
        senderId: CURRENT_USER_ID,
        senderName: '我',
        senderAvatar: '',
        senderRole: groupDetail.value?.myRole,
        type: 'image',
        content: '',
        image: { url: tempPath },
        status: 'sending',
        isWithdrawn: false,
        createdAt: new Date().toLocaleString('zh-CN'),
        timestamp: Date.now(),
      }
      messages.value.push(newMessage)
      showMorePanel.value = false
      nextTick(() => scrollToBottom())
      // 模拟上传完成
      setTimeout(() => {
        updateMessageStatus(newMessage.id, 'delivered')
      }, 1000)
    },
  })
}

function handleCamera() {
  uni.chooseImage({
    count: 1,
    sourceType: ['camera'],
    success: (res) => {
      const tempPath = res.tempFilePaths[0]
      const newMessage: GroupChatMessage = {
        id: Date.now(),
        senderId: CURRENT_USER_ID,
        senderName: '我',
        senderAvatar: '',
        senderRole: groupDetail.value?.myRole,
        type: 'image',
        content: '',
        image: { url: tempPath },
        status: 'sending',
        isWithdrawn: false,
        createdAt: new Date().toLocaleString('zh-CN'),
        timestamp: Date.now(),
      }
      messages.value.push(newMessage)
      showMorePanel.value = false
      nextTick(() => scrollToBottom())
      setTimeout(() => {
        updateMessageStatus(newMessage.id, 'delivered')
      }, 1000)
    },
  })
}

function handleVoiceCall() {
  uni.showToast({ title: '语音功能开发中', icon: 'none' })
}

// ==================== Keyboard & Input ====================

function onInputKeydown(e: any) {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault?.()
    handleSend()
  }
}

// ==================== Scroll ====================

function scrollToBottom() {
  nextTick(() => {
    scrollAnchor.value = 'endRef'
  })
}

// ==================== Navigation ====================

function goBack() {
  uni.navigateBack()
}

function navigateToUser(userId: number) {
  uni.navigateTo({ url: `/pages/user/profile/index?id=${userId}` })
}

function previewImage(url: string) {
  uni.previewImage({ urls: [url] })
}

// ==================== Utilities ====================

function getGroupRoleName(role: string): string {
  const map: Record<string, string> = {
    owner: '群主',
    admin: '管理员',
    moderator: '版主',
    member: '成员',
  }
  return map[role] || role
}

function getRoleBadgeClass(role: string): string {
  switch (role) {
    case 'owner': return 'bg-[#C9A96E]/10 text-[#C9A96E]'
    case 'admin': return 'bg-blue-100 text-blue-600'
    case 'moderator': return 'bg-purple-100 text-purple-600'
    default: return 'bg-[#C9A96E]/10 text-[#C9A96E]'
  }
}

function formatMessageTime(timestamp: number): string {
  const date = new Date(timestamp)
  const now_ = new Date()
  const pad = (n: number) => n.toString().padStart(2, '0')

  // 今天只显示时间
  if (date.toDateString() === now_.toDateString()) {
    return `${pad(date.getHours())}:${pad(date.getMinutes())}`
  }
  // 昨天显示 昨天 HH:mm
  const yesterday = new Date(now_)
  yesterday.setDate(yesterday.getDate() - 1)
  if (date.toDateString() === yesterday.toDateString()) {
    return `昨天 ${pad(date.getHours())}:${pad(date.getMinutes())}`
  }
  // 更早显示日期
  return `${pad(date.getMonth() + 1)}/${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}`
}

function formatTimeShort(timestamp: number): string {
  const date = new Date(timestamp)
  const pad = (n: number) => n.toString().padStart(2, '0')
  return `${pad(date.getHours())}:${pad(date.getMinutes())}`
}

function shouldShowTimeLabel(msg: GroupChatMessage, idx: number): boolean {
  if (idx === 0) return true
  const prev = messages.value[idx - 1]
  if (!prev) return true
  // 两条消息间隔超过5分钟显示时间
  return msg.timestamp - prev.timestamp > 300000
}

function getMemberAvatarBg(name: string): string {
  return MEMBER_BG_COLORS[name] || 'bg-gradient-to-br from-[#999] to-[#ccc]'
}

function getMemberTextColor(name: string): string {
  return MEMBER_TEXT_COLORS[name] || 'text-[#999]'
}

function getBubbleClass(msg: GroupChatMessage): string {
  if (msg.senderId === CURRENT_USER_ID) {
    return 'rounded-2xl px-4 py-2.5 bg-[#C41E3A] text-white rounded-tr-sm max-w-full inline-block'
  }
  if (msg.type === 'image' && msg.image) {
    return 'inline-block'
  }
  return 'rounded-2xl px-4 py-2.5 bg-[#F5F1EB] text-[#2C2C2C] rounded-tl-sm max-w-full inline-block'
}
</script>

<style scoped>
/* ===== Tailwind 补充样式 ===== */

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.animate-spin {
  animation: spin 1s linear infinite;
  display: inline-block;
}

@keyframes slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.animate-slide-up {
  animation: slide-up 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.transition-transform {
  transition: transform 0.2s ease;
}
.rotate-45 {
  transform: rotate(45deg);
}

.line-clamp-1 {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.whitespace-pre-wrap {
  white-space: pre-wrap;
}
.break-words {
  word-break: break-word;
}

.opacity-50 {
  opacity: 0.5;
}

/* hover/active 状态 */
.active\:opacity-80:active {
  opacity: 0.8;
}
.active\:opacity-60:active {
  opacity: 0.6;
}

/* 滚动条隐藏 */
scroll-view ::-webkit-scrollbar {
  display: none;
}
