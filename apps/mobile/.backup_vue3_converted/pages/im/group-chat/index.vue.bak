<template>
  <!-- ===== 加载状态 ===== -->
  <view v-if="loading" class="min-h-screen bg-[#FAF8F5] flex items-center justify-center">
    <view class="text-center">
      <text class="inline-block text-lg text-[#C41E3A] animate-spin">⟳</text>
      <text class="text-sm text-[#999] mt-2 block">加载中...</text>
    </view>
  </view>

  <!-- ===== 错误状态 ===== -->
  <view v-else-if="error || !groupDetail" class="min-h-screen bg-[#FAF8F5] flex flex-col items-center justify-center gap-4 px-4">
    <text class="text-sm text-[#999]">{{ error || '群聊不存在' }}</text>
    <view
      class="px-6 py-2 bg-[#C41E3A] text-white rounded-full text-sm active:opacity-80"
      @click="loadChat"
    >重新加载</view>
  </view>

  <!-- ===== 主界面 ===== -->
  <view v-else class="min-h-screen bg-[#FAF8F5] flex flex-col">

    <!-- ===== 导航栏 ===== -->
    <header class="sticky top-0 z-20 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 h-14">
        <view class="flex items-center gap-3">
          <view @click="goBack" class="p-1 -ml-1"><text class="text-xl text-[#2C2C2C]">←</text></view>
          <view>
            <text class="font-medium text-sm text-[#2C2C2C] block line-clamp-1 max-w-[160px]">{{ groupDetail.name }}</text>
            <text class="text-xs text-[#999] block">{{ onlineCount }}人在线 / {{ groupDetail.memberCount }}人</text>
          </view>
        </view>
        <view class="flex items-center gap-3">
          <text class="text-sm text-[#999]">⋮</text>
        </view>
      </view>
    </header>

    <!-- ===== 群公告 ===== -->
    <view
      v-if="groupDetail.notice"
      class="mx-4 mt-2 p-3 bg-amber-50 rounded-lg flex items-center gap-2 cursor-pointer active:bg-amber-100"
      @click="showNoticeSheet = true"
    >
      <text class="text-amber-600 shrink-0 text-xs">📢</text>
      <text class="text-xs text-amber-800 line-clamp-1 flex-1">{{ groupDetail.notice }}</text>
      <text class="text-amber-600 text-xs shrink-0">详情 ›</text>
    </view>

    <!-- ===== 消息列表（支持下拉加载更多历史） ===== -->
    <scroll-view
      scroll-y
      class="flex-1 px-4 py-4"
      :scroll-into-view="scrollAnchor"
      :refresher-enabled="true"
      :refresher-triggered="refreshing"
      @refresherrefresh="onLoadMoreHistory"
    >
      <!-- 加载更多提示 -->
      <view v-if="hasMoreHistory" class="text-center py-3">
        <text class="text-xs text-[#999]">下拉加载更多...</text>
      </view>
      <view v-if="!hasMoreHistory && messages.length > 0" class="text-center py-3">
        <text class="text-xs text-[#999]">— 没有更多消息了 —</text>
      </view>

      <view v-for="(msg, idx) in messages" :key="msg.id">
        <!-- 时间标签 -->
        <view
          v-if="shouldShowTimeLabel(msg, idx)"
          class="flex justify-center py-2"
        >
          <text class="text-xs text-[#999] bg-[#F0EBE5] px-2 py-1 rounded">{{ formatMessageTime(msg.timestamp) }}</text>
        </view>

        <!-- 撤回消息提示 -->
        <view
          v-if="msg.isWithdrawn"
          class="flex justify-center py-2"
        >
          <text class="text-xs text-[#999]">{{ msg.senderId === CURRENT_USER_ID ? '你' : msg.senderName }}撤回了一条消息</text>
        </view>

        <!-- 正常消息气泡 -->
        <view
          v-else
          class="flex gap-2 mb-3"
          :class="msg.senderId === CURRENT_USER_ID ? 'flex-row-reverse' : ''"
        >
          <!-- 头像（非自己） -->
          <view
            v-if="msg.senderId !== CURRENT_USER_ID"
            class="relative shrink-0"
            @click="navigateToUser(msg.senderId)"
          >
            <view
              class="w-10 h-10 rounded-full flex items-center justify-center text-white text-sm font-medium"
              :class="getMemberAvatarBg(msg.senderName)"
            >
              <text>{{ msg.senderName ? msg.senderName[0].toUpperCase() : '?' }}</text>
            </view>
            <!-- 角色角标（群主 / 管理员 / 版主） -->
            <text
              v-if="msg.senderRole === 'owner'"
              class="absolute -bottom-0.5 -right-0.5 bg-white rounded-full text-[10px] leading-none"
            >👑</text>
            <text
              v-else-if="msg.senderRole === 'admin'"
              class="absolute -bottom-0.5 -right-0.5 bg-white rounded-full text-[10px] leading-none"
            >🛡</text>
            <text
              v-else-if="msg.senderRole === 'moderator'"
              class="absolute -bottom-0.5 -right-0.5 bg-white rounded-full text-[10px] leading-none"
            >⭐</text>
          </view>

          <!-- 消息内容区域 -->
          <view
            :class="[
              'max-w-[70%] flex flex-col',
              msg.senderId === CURRENT_USER_ID ? 'items-end' : 'items-start'
            ]"
          >
            <!-- 发送者名称 + 角色标签 -->
            <view
              v-if="msg.senderId !== CURRENT_USER_ID"
              class="flex items-center gap-1 mb-1 ml-1"
            >
              <text class="text-xs font-medium" :class="getMemberTextColor(msg.senderName)">{{ msg.senderName }}</text>
              <!-- 角色标签 -->
              <text
                v-if="msg.senderRole && msg.senderRole !== 'member'"
                class="text-[10px] px-1.5 py-0.5 rounded leading-normal"
                :class="getRoleBadgeClass(msg.senderRole)"
              >{{ getGroupRoleName(msg.senderRole) }}</text>
            </view>

            <!-- 消息气泡（支持长按操作菜单） -->
            <view
              :class="getBubbleClass(msg)"
              @longpress="onMessageLongPress(msg)"
              @click.stop="selectedMessage = msg"
            >
              <!-- 文本消息 -->
              <view v-if="msg.type === 'text'">
                <text v-if="msg.atAll" class="text-blue-400 text-sm">@所有人 </text>
                <text class="text-sm whitespace-pre-wrap break-words leading-relaxed">{{ msg.content }}</text>
              </view>

              <!-- 图片消息 -->
              <image
                v-else-if="msg.type === 'image' && msg.image"
                :src="msg.image.url"
                mode="aspectFit"
                class="max-w-[200px] max-h-[200px] rounded-lg"
                @click.stop="previewImage(msg.image!.url)"
              />

              <!-- 语音消息 -->
              <view
                v-else-if="msg.type === 'voice' && msg.voice"
                class="flex items-center gap-2 min-w-[80px]"
              >
                <text v-if="msg.senderId === CURRENT_USER_ID" class="text-sm">{{ msg.voice.duration }}"</text>
                <text class="text-base">🎤</text>
                <text v-if="msg.senderId !== CURRENT_USER_ID" class="text-sm">{{ msg.voice.duration }}"</text>
              </view>
            </view>

            <!-- 消息状态图标（仅自己消息） -->
            <view v-if="msg.senderId === CURRENT_USER_ID" class="flex items-center gap-0.5 mt-0.5 mr-1">
              <text
                v-if="msg.status === 'sending'"
                class="text-[10px] text-[#999]"
              >⟳</text>
              <text
                v-else-if="msg.status === 'sent'"
                class="text-[10px] text-[#999]"
              >✓</text>
              <text
                v-else-if="msg.status === 'delivered'"
                class="text-[10px] text-[#999]"
              >✓✓</text>
              <text
                v-else-if="msg.status === 'read'"
                class="text-[10px] text-blue-500"
              >✓✓</text>
              <text
                v-else-if="msg.status === 'failed'"
                class="text-[10px] text-[#FF4D4F]"
              >⚠</text>
            </view>

            <!-- 时间戳（他人消息） -->
            <text
              v-if="msg.senderId !== CURRENT_USER_ID && shouldShowTimeLabel(msg, idx)"
              class="text-[10px] text-[#ccc] mt-0.5 ml-1"
            >{{ formatTimeShort(msg.timestamp) }}</text>
          </view>
        </view>
      </view>
      <view id="endRef" />
    </scroll-view>

    <!-- ===== 消息操作菜单（长按弹出） ===== -->
    <view
      v-if="selectedMessage"
      class="fixed inset-0 z-50"
      @click="closeMessageAction"
    >
      <view class="absolute inset-0 bg-black/30" />
      <view
        class="absolute bottom-0 left-0 right-0 bg-white rounded-t-2xl animate-slide-up px-4 pb-8 pt-4"
        @click.stop
      >
        <!-- 操作标题 -->
        <view class="flex items-center justify-between mb-3 px-1">
          <text class="text-sm font-medium text-[#2C2C2C]">消息操作</text>
          <text class="text-lg text-[#999]" @click="closeMessageAction">✕</text>
        </view>

        <!-- 操作按钮 -->
        <view class="flex gap-4">
          <!-- 复制文本 -->
          <view
            v-if="selectedMessage.type === 'text'"
            class="flex flex-col items-center gap-1.5 px-4 py-3 rounded-xl bg-[#FAF8F5] active:bg-[#F0EBE5] min-w-[80px]"
            @click="handleCopy(selectedMessage.content)"
          >
            <text class="text-xl">📋</text>
            <text class="text-xs text-[#2C2C2C]">复制</text>
          </view>

          <!-- 撤回消息 -->
          <view
            v-if="selectedMessage.senderId === CURRENT_USER_ID && canWithdrawMessage(selectedMessage.timestamp)"
            class="flex flex-col items-center gap-1.5 px-4 py-3 rounded-xl bg-[#FAF8F5] active:bg-[#F0EBE5] min-w-[80px]"
            @click="handleWithdraw(selectedMessage)"
          >
            <text class="text-xl">🗑</text>
            <text class="text-xs text-[#2C2C2C]">撤回</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== @成员列表 ===== -->
    <view
      v-if="showAtList"
      class="absolute bottom-28 left-0 right-0 mx-4 z-30"
    >
      <view class="bg-white border border-[#E8E0D5] rounded-xl shadow-lg max-h-64 overflow-y-auto">
        <!-- 搜索框 -->
        <view class="p-2 border-b border-[#E8E0D5]">
          <input
            v-model="atSearchKeyword"
            placeholder="搜索成员..."
            class="w-full h-9 px-3 bg-[#FAF8F5] rounded-full text-sm outline-none text-[#2C2C2C]"
            @input="onAtSearchInput"
          />
        </view>

        <!-- @所有人（仅群主/管理员） -->
        <view
          v-if="groupDetail.myRole === 'owner' || groupDetail.myRole === 'admin'"
          class="flex items-center gap-3 px-4 py-3 border-b border-[#E8E0D5] active:bg-[#F5F1EB]"
          @click="handleAtAll"
        >
          <view class="w-10 h-10 rounded-full bg-[#C41E3A]/10 flex items-center justify-center shrink-0">
            <text class="text-sm text-[#C41E3A] font-bold">@</text>
          </view>
          <text class="font-medium text-sm text-[#2C2C2C]">@所有人</text>
        </view>

        <!-- 成员搜索结果 -->
        <view
          v-for="member in atSearchResults"
          :key="member.id"
          class="flex items-center gap-3 px-4 py-3 active:bg-[#F5F1EB]"
          @click="handleSelectAtMember(member)"
        >
          <view
            class="w-10 h-10 rounded-full flex items-center justify-center text-white text-sm font-medium shrink-0"
            :class="getMemberAvatarBg(member.nickname)"
          >
            <text>{{ (member.remark || member.nickname)[0] }}</text>
          </view>
          <view class="flex-1 min-w-0">
            <text class="text-sm font-medium text-[#2C2C2C] block">{{ member.remark || member.nickname }}</text>
            <text
              v-if="member.role !== 'member'"
              class="text-xs text-[#999]"
            >{{ getGroupRoleName(member.role) }}</text>
          </view>
        </view>

        <!-- 无结果 -->
        <view
          v-if="atSearchResults.length === 0 && atSearchKeyword"
          class="text-center py-4"
        >
          <text class="text-xs text-[#999]">未找到匹配成员</text>
        </view>
      </view>
    </view>

    <!-- ===== 更多功能面板（4格布局） ===== -->
    <view
      v-if="showMorePanel"
      class="border-t border-[#E8E0D5] bg-white px-4 py-4"
    >
      <view class="grid grid-cols-4 gap-4">
        <!-- 相册 -->
        <view
          class="flex flex-col items-center gap-2 active:opacity-60"
          @click="handleAlbum"
        >
          <view class="w-14 h-14 rounded-xl bg-[#F5F1EB] flex items-center justify-center">
            <text class="text-green-600 text-2xl">🖼</text>
          </view>
          <text class="text-xs text-[#2C2C2C]">相册</text>
        </view>

        <!-- 拍照 -->
        <view
          class="flex flex-col items-center gap-2 active:opacity-60"
          @click="handleCamera"
        >
          <view class="w-14 h-14 rounded-xl bg-[#F5F1EB] flex items-center justify-center">
            <text class="text-blue-600 text-2xl">📷</text>
          </view>
          <text class="text-xs text-[#2C2C2C]">拍照</text>
        </view>

        <!-- @成员 -->
        <view
          class="flex flex-col items-center gap-2 active:opacity-60"
          @click="showAtMemberList"
        >
          <view class="w-14 h-14 rounded-xl bg-[#F5F1EB] flex items-center justify-center">
            <text class="text-purple-600 text-2xl font-bold">@</text>
          </view>
          <text class="text-xs text-[#2C2C2C]">@成员</text>
        </view>

        <!-- 语音 -->
        <view
          class="flex flex-col items-center gap-2 active:opacity-60"
          @click="handleVoiceCall"
        >
          <view class="w-14 h-14 rounded-xl bg-[#F5F1EB] flex items-center justify-center">
            <text class="text-orange-600 text-2xl">🎤</text>
          </view>
          <text class="text-xs text-[#2C2C2C]">语音</text>
        </view>
      </view>
    </view>

    <!-- ===== 底部输入区 ===== -->
    <view
      class="sticky bottom-0 bg-white border-t border-[#E8E0D5] px-4 py-3 z-20"
      :style="{ paddingBottom: envSafeArea }"
    >
      <!-- 输入行 -->
      <view class="flex items-center gap-2">
        <!-- + 展开更多面板 -->
        <view
          class="w-9 h-9 rounded-full flex items-center justify-center shrink-0"
          :class="showMorePanel ? 'bg-[#C41E3A]' : 'bg-[#F5F1EB]'"
          @click="showMorePanel = !showMorePanel"
        >
          <text
            :class="[
              'text-xl transition-transform duration-200',
              showMorePanel ? 'rotate-45 text-white' : 'text-[#2C2C2C]'
            ]"
          >+</text>
        </view>

        <!-- 文本输入 -->
        <view class="flex-1 relative">
          <input
            v-model="inputText"
            :focus="inputFocusFlag"
            placeholder="发送消息..."
            class="w-full px-4 py-2 bg-[#FAF8F5] rounded-full text-sm outline-none text-[#2C2C2C] border border-[#E8E0D5]"
            @confirm="handleSend"
            @keydown="onInputKeydown"
          />
        </view>

        <!-- 发送按钮 -->
        <view
          v-if="inputText.trim().length > 0 || selectedAtMembers.length > 0"
          class="w-9 h-9 rounded-full flex items-center justify-center bg-[#C41E3A] active:opacity-80 shrink-0"
          :class="{ 'opacity-50': sending }"
          @click="handleSend"
        >
          <text
            v-if="sending"
            class="inline-block text-white text-sm animate-spin"
          >⟳</text>
          <text v-else class="text-white text-base">➤</text>
        </view>
      </view>
    </view>

    <!-- ===== 群成员面板（底部弹出） ===== -->
    <view
      v-if="showMembersSheet"
      class="fixed inset-0 z-50"
      @click="showMembersSheet = false"
    >
      <view class="absolute inset-0 bg-black/40" />
      <view
        class="absolute bottom-0 left-0 right-0 bg-white rounded-t-2xl max-h-[80vh] overflow-y-auto animate-slide-up"
        @click.stop
      >
        <!-- 顶部拖拽条 -->
        <view class="w-10 h-1 bg-[#E8E0D5] rounded-full mx-auto mt-3 mb-2" />

        <!-- 面板标题 -->
        <view class="flex items-center justify-between px-5 py-3 border-b border-[#E8E0D5]">
          <text class="font-medium text-[#2C2C2C]">群聊信息</text>
          <text
            class="text-lg text-[#999] p-1"
            @click="showMembersSheet = false"
          >✕</text>
        </view>

        <!-- 群头像和名称 -->
        <view class="px-5 py-4 border-b border-[#E8E0D5]">
          <view class="flex items-center gap-3">
            <view
              v-if="!groupDetail.avatar"
              class="w-14 h-14 rounded-lg bg-gradient-to-br from-[#C41E3A] to-[#E74C3C] flex items-center justify-center text-white text-xl font-medium shrink-0"
            >
              <text>{{ groupDetail.name[0] }}</text>
            </view>
            <image
              v-else
              :src="groupDetail.avatar"
              class="w-14 h-14 rounded-lg shrink-0"
            />
            <view class="flex-1">
              <text class="font-medium text-[#2C2C2C] block">{{ groupDetail.name }}</text>
              <text class="text-sm text-[#999] block">{{ groupDetail.memberCount }}人</text>
            </view>
          </view>
        </view>

        <!-- 群成员网格 -->
        <view class="px-5 py-4 border-b border-[#E8E0D5]">
          <view class="flex items-center justify-between mb-3">
            <text class="text-sm text-[#999]">群成员 <text class="text-[#C41E3A]">{{ members.length }}</text></text>
            <view class="flex items-center gap-1">
              <text class="text-xs text-[#999]">邀请</text>
              <text class="text-[#C41E3A] text-sm">+</text>
            </view>
          </view>
          <view class="grid grid-cols-5 gap-3">
            <view
              v-for="member in memberDisplayList"
              :key="member.id"
              class="flex flex-col items-center gap-1"
            >
              <view class="relative">
                <view
                  class="w-11 h-11 rounded-full flex items-center justify-center text-white text-sm font-medium"
                  :class="getMemberAvatarBg(member.nickname)"
                >
                  <text>{{ (member.remark || member.nickname)[0].toUpperCase() }}</text>
                </view>
                <!-- 角色角标 -->
                <text
                  v-if="member.role === 'owner'"
                  class="absolute -bottom-0.5 -right-0.5 bg-white rounded-full text-[10px] leading-none shadow-sm"
                >👑</text>
                <text
                  v-else-if="member.role === 'admin'"
                  class="absolute -bottom-0.5 -right-0.5 bg-white rounded-full text-[10px] leading-none shadow-sm"
                >🛡</text>
                <text
                  v-else-if="member.role === 'moderator'"
                  class="absolute -bottom-0.5 -right-0.5 bg-white rounded-full text-[10px] leading-none shadow-sm"
                >⭐</text>
              </view>
              <text class="text-xs text-center line-clamp-1 w-full text-[#2C2C2C]">{{ member.nickname }}</text>
            </view>
          </view>
        </view>

        <!-- 群公告入口 -->
        <view
          v-if="groupDetail.notice"
          class="px-5 py-4 border-b border-[#E8E0D5] active:bg-[#FAF8F5]"
          @click="showMembersSheet = false; showNoticeSheet = true"
        >
          <view class="flex items-center justify-between mb-1">
            <text class="text-sm text-[#999]">群公告</text>
            <text class="text-xs text-[#999]">›</text>
          </view>
          <text class="text-sm text-[#2C2C2C] block line-clamp-2 leading-relaxed">{{ groupDetail.notice }}</text>
        </view>

        <!-- 我的角色 -->
        <view class="px-5 py-4 border-b border-[#E8E0D5]">
          <view class="flex items-center justify-between">
            <text class="text-sm text-[#999]">我在本群的身份</text>
            <text class="text-sm font-medium text-[#2C2C2C]">{{ getGroupRoleName(groupDetail.myRole) }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 群公告详情面板 ===== -->
    <view
      v-if="showNoticeSheet"
      class="fixed inset-0 z-50"
      @click="showNoticeSheet = false"
    >
      <view class="absolute inset-0 bg-black/40" />
      <view
        class="absolute bottom-0 left-0 right-0 bg-white rounded-t-2xl animate-slide-up max-h-[70vh] overflow-y-auto"
        @click.stop
      >
        <view class="w-10 h-1 bg-[#E8E0D5] rounded-full mx-auto mt-3 mb-2" />
        <view class="px-5 pb-8 pt-2">
          <text class="font-medium text-lg text-[#2C2C2C] block mb-4">群公告</text>

          <view v-if="groupDetail.noticeDetail">
            <view class="flex items-center gap-2 text-sm text-[#999] mb-4">
              <text>{{ groupDetail.noticeDetail.publisher }}</text>
              <text>发布于 {{ groupDetail.noticeDetail.publishedAt }}</text>
            </view>
            <text class="text-sm text-[#2C2C2C] leading-relaxed whitespace-pre-wrap block">{{ groupDetail.noticeDetail.content }}</text>
          </view>

          <text v-else class="text-sm text-[#999]">暂无群公告</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted, nextTick, computed, watch } from 'vue'

// ==================== Types ====================

interface GroupDetail {
  id: number
  name: string
  avatar: string
  memberCount: number
  myRole: 'owner' | 'admin' | 'moderator' | 'member'
  notice: string
  noticeDetail?: {
    publisher: string
    publishedAt: string
    content: string
  }
}

interface ChatImage {
  url: string
  width?: number
  height?: number
}

interface ChatVoice {
  duration: number
}

interface GroupChatMessage {
  id: number
  senderId: number
  senderName: string
  senderAvatar: string
  senderRole?: 'owner' | 'admin' | 'moderator' | 'member'
  type: 'text' | 'image' | 'voice'
  content: string
  image?: ChatImage
  voice?: ChatVoice
  atAll?: boolean
  atMembers?: number[]
  status: 'sending' | 'sent' | 'delivered' | 'read' | 'failed'
  isWithdrawn: boolean
  createdAt: string
  timestamp: number
}

interface GroupMember {
  id: number
  nickname: string
  avatar: string
  remark: string
  role: 'owner' | 'admin' | 'moderator' | 'member'
}

// ==================== Constants ====================

const CURRENT_USER_ID = 0

// 角色显示的背景色映射
const MEMBER_BG_COLORS: Record<string, string> = {
  '周易大师': 'bg-gradient-to-br from-[#C41E3A] to-[#E74C3C]',
