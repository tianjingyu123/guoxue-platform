<template>
  <!-- 加载状态 -->
  <view v-if="loading" class="min-h-screen bg-[#FAF8F5] flex items-center justify-center">
    <view class="text-center">
      <text class="inline-block text-lg text-[#C41E3A] animate-spin">⟳</text>
      <text class="text-sm text-[#999] mt-2 block">加载中...</text>
    </view>
  </view>

  <!-- 错误/空状态 -->
  <view v-else-if="error || !groupDetail" class="min-h-screen bg-[#FAF8F5] flex flex-col items-center justify-center gap-4 px-4">
    <text class="text-sm text-[#999]">{{ error || '群聊不存在' }}</text>
    <view class="px-6 py-2 bg-[#C41E3A] text-white rounded-full text-sm" @click="loadChat">重试</view>
  </view>

  <!-- 主界面 -->
  <view v-else class="min-h-screen bg-[#FAF8F5] flex flex-col">

    <!-- ===== 导航栏 ===== -->
    <header class="sticky top-0 z-20 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 h-14">
        <view class="flex items-center gap-3">
          <view @click="goBack" class="p-1 -ml-1"><text class="text-xl text-[#2C2C2C]">←</text></view>
          <view>
            <text class="font-medium text-sm text-[#2C2C2C] block line-clamp-1">{{ groupDetail.name }}</text>
            <text class="text-xs text-[#999] block">{{ onlineCount }}人在线 / {{ groupDetail.memberCount }}人</text>
          </view>
        </view>
        <view @click="showMembersSheet = true" class="p-1 -mr-1"><text class="text-xl text-[#666]">⋮</text></view>
      </view>
    </header>

    <!-- ===== 群公告 ===== -->
    <view v-if="groupDetail.notice" @click="showNoticeSheet = true" class="mx-4 mt-2 p-3 bg-amber-50 rounded-lg flex items-center gap-2 cursor-pointer">
      <text class="text-amber-600 shrink-0">🔔</text>
      <text class="text-xs text-amber-800 line-clamp-1 flex-1">{{ groupDetail.notice }}</text>
      <text class="text-amber-600 text-xs shrink-0">›</text>
    </view>

    <!-- ===== 消息列表 ===== -->
    <scroll-view scroll-y class="flex-1 px-4 py-4" :scroll-into-view="scrollAnchor">
      <view v-for="(msg, idx) in messages" :key="msg.id">
        <!-- 时间标签 -->
        <view v-if="shouldShowTimeLabel(msg, idx)" class="flex justify-center py-2">
          <text class="text-xs text-[#999]">{{ formatMessageTime(msg.timestamp) }}</text>
        </view>

        <!-- 撤回消息 -->
        <view v-if="msg.isWithdrawn" class="text-center text-xs text-[#999] py-2">
          <text>{{ msg.senderId === CURRENT_USER_ID ? '你' : msg.senderName }}撤回了一条消息</text>
        </view>

        <!-- 正常消息 -->
        <view v-else :class="['flex gap-2 mb-3', msg.senderId === CURRENT_USER_ID ? 'flex-row-reverse' : '']">
          <!-- 头像（非自己） -->
          <view v-if="msg.senderId !== CURRENT_USER_ID" class="relative shrink-0" @click="navigateToUser(msg.senderId)">
            <view class="w-10 h-10 rounded-full bg-gradient-to-br from-[#C41E3A] to-[#E74C3C] flex items-center justify-center text-white text-sm">
              <text>{{ msg.senderName[0] || '?' }}</text>
            </view>
            <text v-if="msg.senderRole === 'owner'" class="absolute -bottom-0.5 -right-0.5 bg-[#FAF8F5] rounded-full text-[10px] px-0.5 leading-none">👑</text>
            <text v-else-if="msg.senderRole === 'admin'" class="absolute -bottom-0.5 -right-0.5 bg-[#FAF8F5] rounded-full text-[10px] px-0.5 leading-none">🛡</text>
          </view>

          <!-- 消息内容 -->
          <view :class="['max-w-[70%] flex flex-col', msg.senderId === CURRENT_USER_ID ? 'items-end' : 'items-start']">
            <!-- 发送者名称 -->
            <view v-if="msg.senderId !== CURRENT_USER_ID" class="text-xs text-[#999] mb-1 ml-1">
              <text>{{ msg.senderName }}</text>
              <text v-if="msg.senderRole && msg.senderRole !== 'member'" class="text-[#C41E3A]"> ({{ getGroupRoleName(msg.senderRole) }})</text>
            </view>

            <!-- 气泡 -->
            <view
              :class="getBubbleClass(msg)"
              @click.stop="selectedMessage = msg"
            >
              <!-- 文本消息 -->
              <view v-if="msg.type === 'text'">
                <text v-if="msg.atAll" class="text-blue-400">@所有人 </text>
                <text class="text-sm whitespace-pre-wrap break-words">{{ msg.content }}</text>
              </view>

              <!-- 图片消息 -->
              <image
                v-else-if="msg.type === 'image' && msg.image"
                :src="msg.image.url"
                mode="aspectFit"
                class="max-w-[200px] rounded-lg"
                @click.stop="previewImage(msg.image!.url)"
              />

              <!-- 语音消息 -->
              <view v-else-if="msg.type === 'voice' && msg.voice" class="flex items-center gap-2 min-w-[80px]">
                <text class="text-lg">🎤</text>
                <text class="text-sm">{{ msg.voice.duration }}"</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view id="endRef" />
    </scroll-view>

    <!-- ===== 消息操作菜单 ===== -->
    <view v-if="selectedMessage" class="fixed inset-0 z-50" @click="selectedMessage = null">
      <view class="absolute inset-0 bg-black/20" />
      <view class="absolute bottom-20 left-1/2 -translate-x-1/2 bg-white rounded-xl shadow-lg p-2 flex gap-1" @click.stop>
        <!-- 复制 -->
        <view v-if="selectedMessage.type === 'text'" class="flex flex-col items-center gap-1 px-3 py-2" @click="handleCopy(selectedMessage.content)">
          <text class="text-lg">📋</text>
          <text class="text-xs text-[#2C2C2C]">复制</text>
        </view>
        <!-- 撤回 -->
        <view
          v-if="selectedMessage.senderId === CURRENT_USER_ID && canWithdrawMessage(selectedMessage.timestamp)"
          class="flex flex-col items-center gap-1 px-3 py-2"
          @click="handleWithdraw(selectedMessage)"
        >
          <text class="text-lg">🗑</text>
          <text class="text-xs text-[#2C2C2C]">撤回</text>
        </view>
      </view>
    </view>

    <!-- ===== @成员列表 ===== -->
    <view v-if="showAtList" class="absolute bottom-24 left-0 right-0 mx-4 bg-white border border-[#E8E0D5] rounded-xl shadow-lg max-h-64 overflow-y-auto z-30">
      <view class="p-2 border-b border-[#E8E0D5]">
        <input
          v-model="atSearchKeyword"
          placeholder="搜索成员..."
          class="w-full h-8 px-3 bg-[#F5F1EB] rounded-full text-sm outline-none text-[#2C2C2C]"
          @input="onAtSearchInput"
        />
      </view>
      <!-- @所有人 -->
      <view
        v-if="groupDetail.myRole === 'owner' || groupDetail.myRole === 'admin'"
        class="flex items-center gap-3 px-4 py-3 border-b border-[#E8E0D5]"
        hover-class="bg-[#F5F1EB]"
        @click="handleAtAll"
      >
        <view class="w-10 h-10 rounded-full bg-[#C41E3A]/10 flex items-center justify-center shrink-0">
          <text class="text-[#C41E3A]">👥</text>
        </view>
        <text class="font-medium text-sm text-[#2C2C2C]">@所有人</text>
      </view>
      <!-- 成员搜索结果 -->
      <view
        v-for="member in atSearchResults"
        :key="member.id"
        class="flex items-center gap-3 px-4 py-3"
        hover-class="bg-[#F5F1EB]"
        @click="handleSelectAtMember(member)"
      >
        <view class="w-10 h-10 rounded-full bg-gradient-to-br from-[#C41E3A] to-[#E74C3C] flex items-center justify-center text-white text-sm shrink-0">
          <text>{{ (member.remark || member.nickname)[0] }}</text>
        </view>
        <view class="flex-1 min-w-0">
          <text class="text-sm font-medium text-[#2C2C2C] block">{{ member.remark || member.nickname }}</text>
          <text v-if="member.role !== 'member'" class="text-xs text-[#999]">{{ getGroupRoleName(member.role) }}</text>
        </view>
      </view>
    </view>

    <!-- ===== 更多功能面板 ===== -->
    <view v-if="showMorePanel" class="border-t border-[#E8E0D5] bg-white px-4 py-4">
      <view class="grid grid-cols-4 gap-4">
        <view class="flex flex-col items-center gap-2" @click="handleAlbum">
          <view class="w-12 h-12 rounded-xl bg-[#F5F1EB] flex items-center justify-center">
            <text class="text-green-600 text-2xl">🖼</text>
          </view>
          <text class="text-xs text-[#2C2C2C]">相册</text>
        </view>
        <view class="flex flex-col items-center gap-2" @click="handleCamera">
          <view class="w-12 h-12 rounded-xl bg-[#F5F1EB] flex items-center justify-center">
            <text class="text-blue-600 text-2xl">📷</text>
          </view>
          <text class="text-xs text-[#2C2C2C]">拍照</text>
        </view>
        <view class="flex flex-col items-center gap-2" @click="handleAtMemberBtn">
          <view class="w-12 h-12 rounded-xl bg-[#F5F1EB] flex items-center justify-center">
            <text class="text-purple-600 text-2xl">@</text>
          </view>
          <text class="text-xs text-[#2C2C2C]">@成员</text>
        </view>
        <view class="flex flex-col items-center gap-2" @click="handleVoiceCall">
          <view class="w-12 h-12 rounded-xl bg-[#F5F1EB] flex items-center justify-center">
            <text class="text-orange-600 text-2xl">🎤</text>
          </view>
          <text class="text-xs text-[#2C2C2C]">语音</text>
        </view>
      </view>
    </view>

    <!-- ===== 底部输入区 ===== -->
    <view class="sticky bottom-0 bg-white border-t border-[#E8E0D5] px-4 py-3" :style="{ paddingBottom: envSafeArea }">
      <view class="flex items-center gap-2">
        <!-- 加号按钮 -->
        <view
          class="w-10 h-10 rounded-full flex items-center justify-center shrink-0"
          :class="showMorePanel ? 'bg-[#C41E3A]' : 'bg-[#F5F1EB]'"
          @click="showMorePanel = !showMorePanel"
        >
          <text :class="['text-lg transition-transform', showMorePanel ? 'rotate-45 text-white' : 'text-[#2C2C2C]']">+</text>
        </view>

        <!-- 文本输入 -->
        <view class="flex-1 relative">
          <input
            v-model="inputText"
            :focus="inputFocusFlag"
            placeholder="发送消息..."
            class="w-full px-4 py-2.5 bg-[#FAF8F5] rounded-full text-sm outline-none text-[#2C2C2C]"
            @confirm="handleSend"
            @keydown="onInputKeydown"
          />
        </view>

        <!-- 发送按钮 -->
        <view v-if="inputText.trim() || selectedAtMembers.length > 0">
          <view
            class="w-10 h-10 rounded-full flex items-center justify-center bg-[#C41E3A]"
            :class="{ 'opacity-50': sending }"
            @click="handleSend"
          >
            <text v-if="sending" class="inline-block text-white text-lg animate-spin">⟳</text>
            <text v-else class="text-white text-lg">➤</text>
          </view>
        </view>
        <view v-else class="w-10 h-10 rounded-full bg-[#F5F1EB] flex items-center justify-center" @click="showMorePanel = !showMorePanel">
          <text class="text-lg text-[#2C2C2C]">+</text>
        </view>
      </view>
    </view>

    <!-- ===== 群成员侧边栏 ===== -->
    <view v-if="showMembersSheet" class="fixed inset-0 z-50" @click="showMembersSheet = false">
      <view class="absolute inset-0 bg-black/40" />
      <view class="absolute bottom-0 left-0 right-0 bg-white rounded-t-2xl max-h-[80vh] overflow-y-auto animate-slide-up" @click.stop>
        <view class="w-10 h-1 bg-[#E8E0D5] rounded-full mx-auto mt-3" />
        <view class="flex items-center justify-between px-4 py-4 border-b border-[#E8E0D5]">
          <text class="font-medium text-[#2C2C2C]">群聊信息</text>
          <text @click="showMembersSheet = false" class="text-lg text-[#999]">✕</text>
        </view>

        <!-- 群头像和名称 -->
        <view class="p-4 border-b border-[#E8E0D5]">
          <view class="flex items-center gap-3">
            <view v-if="!groupDetail.avatar" class="w-14 h-14 rounded-lg bg-gradient-to-br from-[#C41E3A] to-[#E74C3C] flex items-center justify-center text-white text-xl shrink-0">
              <text>{{ groupDetail.name[0] }}</text>
            </view>
            <image v-else :src="groupDetail.avatar" class="w-14 h-14 rounded-lg shrink-0" />
            <view class="flex-1">
              <text class="font-medium text-[#2C2C2C] block">{{ groupDetail.name }}</text>
              <text class="text-sm text-[#999] block">{{ groupDetail.memberCount }}人</text>
            </view>
          </view>
        </view>

        <!-- 群成员 -->
        <view class="p-4 border-b border-[#E8E0D5]">
          <view class="flex items-center justify-between mb-3">
            <text class="text-sm text-[#999]">群成员</text>
            <view class="text-[#C41E3A]">
              <text class="text-sm">查看全部 ›</text>
            </view>
          </view>
          <view class="grid grid-cols-5 gap-3">
            <view v-for="member in memberDisplayList" :key="member.id" class="flex flex-col items-center gap-1">
              <view class="relative">
                <view class="w-10 h-10 rounded-full bg-gradient-to-br from-[#C41E3A] to-[#E74C3C] flex items-center justify-center text-white text-sm shrink-0">
                  <text>{{ (member.remark || member.nickname)[0] }}</text>
                </view>
                <text v-if="member.role === 'owner'" class="absolute -bottom-0.5 -right-0.5 bg-[#FAF8F5] rounded-full text-[10px] px-0.5 leading-none">👑</text>
                <text v-else-if="member.role === 'admin'" class="absolute -bottom-0.5 -right-0.5 bg-[#FAF8F5] rounded-full text-[10px] px-0.5 leading-none">🛡</text>
              </view>
              <text class="text-xs text-center line-clamp-1 w-full text-[#2C2C2C]">{{ member.nickname }}</text>
            </view>
          </view>
        </view>

        <!-- 群公告入口 -->
        <view v-if="groupDetail.notice" class="p-4 border-b border-[#E8E0D5]" @click="showMembersSheet = false; showNoticeSheet = true">
          <view class="flex items-center justify-between">
            <text class="text-sm text-[#999]">群公告</text>
            <text class="text-xs text-[#999]">›</text>
          </view>
          <text class="text-sm text-[#2C2C2C] block mt-2 line-clamp-2">{{ groupDetail.notice }}</text>
        </view>

        <!-- 我的角色 -->
        <view class="p-4 border-b border-[#E8E0D5]">
          <view class="flex items-center justify-between">
            <text class="text-sm text-[#999]">我在本群的身份</text>
            <text class="text-sm text-[#2C2C2C]">{{ getGroupRoleName(groupDetail.myRole) }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 群公告详情 ===== -->
    <view v-if="showNoticeSheet" class="fixed inset-0 z-50" @click="showNoticeSheet = false">
      <view class="absolute inset-0 bg-black/40" />
      <view class="absolute bottom-0 left-0 right-0 bg-white rounded-t-2xl animate-slide-up" @click.stop>
        <view class="w-10 h-1 bg-[#E8E0D5] rounded-full mx-auto mt-3 mb-2" />
        <view class="px-4 pb-6">
          <text class="font-medium text-lg text-[#2C2C2C] block mb-4">群公告</text>
          <view v-if="groupDetail.noticeDetail">
            <view class="flex items-center gap-2 text-sm text-[#999] mb-4">
              <text>{{ groupDetail.noticeDetail.publisher }}</text>
              <text>发布于 {{ groupDetail.noticeDetail.publishedAt }}</text>
            </view>
            <text class="text-sm text-[#2C2C2C] leading-relaxed whitespace-pre-wrap block">{{ groupDetail.noticeDetail.content }}</text>
          </view>
          <text v-else class="text-sm text-[#999]">暂无群公告</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted, nextTick, computed, watch } from 'vue'

// ==================== Types ====================
interface GroupDetail {
  id: number
  name: string
  avatar: string
  memberCount: number
  notice: string
  noticeDetail?: {
    publisher: string
    publishedAt: string
    content: string
  }
  myRole: 'owner' | 'admin' | 'member'
}

interface GroupChatMessage {
  id: number
  senderId: number
  senderName: string
  senderAvatar: string
  senderRole?: 'owner' | 'admin' | 'member'
  type: 'text' | 'image' | 'voice'
  content: string
  image?: { url: string }
  voice?: { duration: number }
  atAll?: boolean
  atMembers?: number[]
  status: 'sending' | 'sent' | 'delivered' | 'read' | 'failed'
  isWithdrawn: boolean
  createdAt: string
  timestamp: number
}

interface GroupMember {
  id: number
  nickname: string
  avatar: string
  remark: string
  role: 'owner' | 'admin' | 'member'
}

// ==================== Constants ====================
const CURRENT_USER_ID = 0

// ==================== Mock Data ====================
const now = Date.now()

const MOCK_GROUP_DETAIL: GroupDetail = {
  id: 1,
  name: '国学堂交流群',
  avatar: '',
  memberCount: 128,
  notice: '欢迎加入国学堂交流群，请遵守群规，文明交流，禁止广告。',
  noticeDetail: {
    publisher: '群主-周易大师',
    publishedAt: '2024-01-15',
    content: '欢迎加入国学堂交流群！本群致力于弘扬中华传统文化，交流八字命理、风水堪舆、六爻占卜等国学知识。请各位群友遵守以下群规：\n1. 禁止发广告\n2. 文明交流\n3. 禁止人身攻击\n4. 禁止讨论政治敏感话题',
  },
  myRole: 'member',
}

const MOCK_MEMBERS: GroupMember[] = [
  { id: 1, nickname: '周易大师', avatar: '', remark: '', role: 'owner' },
  { id: 2, nickname: '张玄风', avatar: '', remark: '', role: 'admin' },
  { id: 3, nickname: '李玄机', avatar: '', remark: '', role: 'admin' },
  { id: 4, nickname: '王德华', avatar: '', remark: '', role: 'member' },
  { id: 5, nickname: '林奇门', avatar: '', remark: '', role: 'member' },
  { id: 6, nickname: '陈梅花', avatar: '', remark: '', role: 'member' },
  { id: 7, nickname: '易学新人', avatar: '', remark: '', role: 'member' },
  { id: 8, nickname: '风水小白', avatar: '', remark: '', role: 'member' },
  { id: 9, nickname: '命理初学', avatar: '', remark: '', role: 'member' },
  { id: 10, nickname: '国学传承', avatar: '', remark: '', role: 'member' },
]

const MOCK_MESSAGES: GroupChatMessage[] = [
  {
    id: 1, senderId: 1, senderName: '周易大师', senderAvatar: '', senderRole: 'owner',
    type: 'text', content: '大家好！欢迎加入国学堂交流群', status: 'read',
    isWithdrawn: false, createdAt: '', timestamp: now - 600000,
  },
  {
    id: 2, senderId: CURRENT_USER_ID, senderName: '我', senderAvatar: '',
    type: 'text', content: '老师好！刚学习八字，请多关照', status: 'read',
    isWithdrawn: false, createdAt: '', timestamp: now - 570000,
  },
  {
    id: 3, senderId: 1, senderName: '周易大师', senderAvatar: '', senderRole: 'owner',
    type: 'text', content: '欢迎新同学，有问题随时提问', status: 'read',
    isWithdrawn: false, createdAt: '', timestamp: now - 540000,
  },
  {
    id: 4, senderId: 2, senderName: '张玄风', senderAvatar: '', senderRole: 'admin',
    type: 'text', content: '对，我们这里有八字、风水、六爻各种老师', status: 'read',
    isWithdrawn: false, createdAt: '', timestamp: now - 510000,
  },
  {
    id: 5, senderId: CURRENT_USER_ID, senderName: '我', senderAvatar: '',
    type: 'text', content: '太好了，我想先学八字排盘', status: 'read',
    isWithdrawn: false, createdAt: '', timestamp: now - 480000,
  },
  {
    id: 6, senderId: 1, senderName: '周易大师', senderAvatar: '', senderRole: 'owner',
    type: 'text', content: '可以看群文件里的入门教程，有基础的排盘方法', status: 'read',
    isWithdrawn: false, createdAt: '', timestamp: now - 450000,
  },
  {
    id: 7, senderId: 3, senderName: '李玄机', senderAvatar: '', senderRole: 'admin',
    type: 'image', content: '', status: 'read',
    image: { url: 'https://picsum.photos/seed/guoxue/400/300' },
    isWithdrawn: false, createdAt: '', timestamp: now - 300000,
  },
  {
    id: 8, senderId: CURRENT_USER_ID, senderName: '我', senderAvatar: '',
    type: 'text', content: '好的，我去看看，谢谢老师！', status: 'read',
    isWithdrawn: false, createdAt: '', timestamp: now - 240000,
  },
  {
    id: 9, senderId: 1, senderName: '周易大师', senderAvatar: '', senderRole: 'owner',
    type: 'text', content: '大家有好的学习资料也可以分享到群里 @所有人', status: 'read',
    atAll: true,
    isWithdrawn: false, createdAt: '', timestamp: now - 180000,
  },
]

// ==================== Mock API Functions ====================
function delay(ms: number): Promise<void> {
  return new Promise(resolve => setTimeout(resolve, ms))
}

async function mockGetGroupDetail(_groupId: number): Promise<{ code: number; data: GroupDetail | null }> {
  await delay(300)
  return { code: 200, data: { ...MOCK_GROUP_DETAIL, id: _groupId } }
}

async function mockGetGroupChatHistory(_groupId: number): Promise<{ code: number; data: { messages: GroupChatMessage[] } | null }> {
  await delay(400)
  return { code: 200, data: { messages: MOCK_MESSAGES.map(m => ({ ...m })) } }
}

async function mockGetGroupMembers(_groupId: number): Promise<{ code: number; data: GroupMember[] }> {
  await delay(300)
  return { code: 200, data: MOCK_MEMBERS.map(m => ({ ...m })) }
}

async function mockSearchGroupMembersForAt(_groupId: number, keyword: string): Promise<{ code: number; data: GroupMember[] }> {
  await delay(200)
  let results = MOCK_MEMBERS.map(m => ({ ...m }))
  if (keyword) {
    results = results.filter(m => m.nickname.includes(keyword) || m.remark.includes(keyword))
  }
  results = results.filter(m => m.id !== CURRENT_USER_ID)
  return { code: 200, data: results }
}

async function mockSendGroupMessage(_params: {
  groupId: number
  type: string
  content: string
  atMembers?: number[]
}): Promise<{ code: number; data: { messageId: number; timestamp: number } }> {
  await delay(600)
  return { code: 200, data: { messageId: Date.now(), timestamp: Date.now() } }
}

async function mockWithdrawGroupMessage(_groupId: number, _messageId: number): Promise<{ code: number }> {
  await delay(300)
  return { code: 200 }
}

// ==================== State ====================
const groupDetail = ref<GroupDetail | null>(null)
const messages = ref<GroupChatMessage[]>([])
const members = ref<GroupMember[]>([])
const loading = ref(true)
const error = ref<string | null>(null)

const inputText = ref('')
const sending = ref(false)
const showMorePanel = ref(false)
const showMembersSheet = ref(false)
const showNoticeSheet = ref(false)
const showAtList = ref(false)
const atSearchKeyword = ref('')
const atSearchResults = ref<GroupMember[]>([])
const selectedAtMembers = ref<number[]>([])
const selectedMessage = ref<GroupChatMessage | null>(null)

// 输入框焦点控制
const inputFocusFlag = ref(false)

// 滚动控制
const scrollAnchor = ref('endRef')
let scrollCounter = 0

// 安全区域适配
const envSafeArea = ref('12px')

// ==================== Computed ====================
// 在线人数（模拟：每3人中有1人在线）
const onlineCount = computed(() => {
  return members.value.filter((_, i) => i % 3 === 0).length
})

// 成员列表（最多显示10个）
const memberDisplayList = computed(() => {
  return members.value.slice(0, 10)
})

// ==================== Lifecycle ====================
onMounted(() => {
  // 获取安全区域高度
  uni.getSystemInfo({
    success: (res) => {
      const bottom = res.safeArea?.bottom || 0
      const height = res.windowHeight || 0
      const safeBottom = bottom > height ? 0 : height - bottom
      envSafeArea.value = safeBottom > 0 ? (safeBottom + 12) + 'px' : '12px'
    },
  })

  loadChat()
})

// ==================== Data Loading ====================
async function loadChat() {
  loading.value = true
  error.value = null
  try {
    const groupId = getGroupId()
    const [detailRes, historyRes, membersRes] = await Promise.all([
      mockGetGroupDetail(groupId),
      mockGetGroupChatHistory(groupId),
      mockGetGroupMembers(groupId),
    ])

    if (detailRes.code === 200 && detailRes.data) {
      groupDetail.value = detailRes.data
    }
    if (historyRes.code === 200 && historyRes.data) {
      messages.value = historyRes.data.messages
    }
    if (membersRes.code === 200 && membersRes.data) {
      members.value = membersRes.data
    }
  } catch {
    error.value = '加载失败'
  } finally {
    loading.value = false
    nextTick(() => scrollToBottom())
  }
}

function getGroupId(): number {
  const pages = getCurrentPages()
  const currentPage = pages[pages.length - 1] as any
  const id = currentPage?.options?.id
  return id ? Number(id) : 1
}

// ==================== Message Sending ====================
async function handleSend() {
  if (!inputText.value.trim() && selectedAtMembers.value.length === 0) return
  if (sending.value) return

  const content = inputText.value
  inputText.value = ''
  sending.value = true

  try {
    const groupId = getGroupId()
    const res = await mockSendGroupMessage({
      groupId,
      type: 'text',
      content,
      atMembers: selectedAtMembers.value.length > 0 ? selectedAtMembers.value : undefined,
    })

    if (res.code === 200 && res.data) {
      const newMessage: GroupChatMessage = {
        id: res.data.messageId,
        senderId: CURRENT_USER_ID,
        senderName: '我',
        senderAvatar: '',
        senderRole: groupDetail.value?.myRole,
        type: 'text',
        content,
        atMembers: selectedAtMembers.value.length > 0 ? selectedAtMembers.value : undefined,
        status: 'sending',
        isWithdrawn: false,
        createdAt: new Date().toLocaleString('zh-CN'),
        timestamp: res.data.timestamp,
      }
      messages.value.push(newMessage)
      selectedAtMembers.value = []
      scrollToBottom()

      // 模拟发送成功
      setTimeout(() => {
        const idx = messages.value.findIndex(m => m.id === newMessage.id)
        if (idx !== -1) {
          messages.value[idx] = { ...messages.value[idx], status: 'delivered' }
        }
      }, 500)
    }
  } catch {
    uni.showToast({ title: '发送失败', icon: 'none' })
  } finally {
    sending.value = false
  }
}

// ==================== @ Mention Handling ====================
function handleSelectAtMember(member: GroupMember) {
  if (!selectedAtMembers.value.includes(member.id)) {
    selectedAtMembers.value.push(member.id)
    inputText.value += `@${member.nickname} `
  }
  showAtList.value = false
  atSearchKeyword.value = ''
  focusInput()
}

function handleAtAll() {
  inputText.value += '@所有人 '
  showAtList.value = false
  focusInput()
}

function showAtMemberList() {
  showAtList.value = true
  showMorePanel.value = false
  loadAtSearchResults()
}

async function loadAtSearchResults() {
  const groupId = getGroupId()
  const res = await mockSearchGroupMembersForAt(groupId, atSearchKeyword.value)
  if (res.code === 200 && res.data) {
    atSearchResults.value = res.data.filter(m => m.id !== CURRENT_USER_ID)
  }
}

function onAtSearchInput() {
  loadAtSearchResults()
}

function focusInput() {
  inputFocusFlag.value = false
  nextTick(() => {
    inputFocusFlag.value = true
  })
}

// @检测
function detectAtInInput(val: string) {
  if (val.endsWith('@') && !showAtList.value) {
    showAtMemberList()
  }
}

// 监听输入框内容变化，检测@符号
watch(inputText, (val) => {
  detectAtInInput(val)
})

// ==================== Message Actions ====================
async function handleWithdraw(message: GroupChatMessage) {
  const groupId = getGroupId()
  const res = await mockWithdrawGroupMessage(groupId, message.id)
  if (res.code === 200) {
    const idx = messages.value.findIndex(m => m.id === message.id)
    if (idx !== -1) {
      messages.value[idx] = { ...messages.value[idx], isWithdrawn: true }
    }
    uni.showToast({ title: '消息已撤回', icon: 'success' })
  }
  selectedMessage.value = null
}

function handleCopy(content: string) {
  uni.setClipboardData({
    data: content,
    success: () => {
      uni.showToast({ title: '已复制', icon: 'success' })
    },
  })
  selectedMessage.value = null
}

// ==================== More Panel Actions ====================
function handleAlbum() {
  uni.showToast({ title: '相册功能开发中', icon: 'none' })
}

function handleCamera() {
  uni.showToast({ title: '拍照功能开发中', icon: 'none' })
}

function handleAtMemberBtn() {
  showAtMemberList()
}

function handleVoiceCall() {
  uni.showToast({ title: '语音功能开发中', icon: 'none' })
}

// ==================== Keyboard & Input ====================
function onInputKeydown(e: any) {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault?.()
    handleSend()
  }
}

// ==================== Scroll ====================
function scrollToBottom() {
  nextTick(() => {
    scrollCounter++
    scrollAnchor.value = 'endRef'
    setTimeout(() => {
      scrollAnchor.value = ''
    }, 50)
  })
}

// ==================== Navigation ====================
function goBack() {
  uni.navigateBack()
}

function navigateToUser(userId: number) {
  if (userId === CURRENT_USER_ID) {
    uni.navigateTo({ url: '/pages/user/profile/index' })
  } else {
    uni.navigateTo({ url: '/pages/user/profile/index?id=' + userId })
  }
}

function previewImage(url: string) {
  uni.previewImage({ urls: [url] })
}

// ==================== Utilities ====================
function getGroupRoleName(role: string): string {
  switch (role) {
    case 'owner': return '群主'
    case 'admin': return '管理员'
    case 'member': return '成员'
    default: return role
  }
}

function formatMessageTime(timestamp: number): string {
  const date = new Date(timestamp)
  const pad = (n: number) => n.toString().padStart(2, '0')
  return `${pad(date.getHours())}:${pad(date.getMinutes())}`
}

function shouldShowTimeLabel(msg: GroupChatMessage, idx: number): boolean {
  if (idx === 0) return true
  const prev = messages.value[idx - 1]
  if (!prev) return true
  return msg.timestamp - prev.timestamp > 300000 // 5分钟
}

function canWithdrawMessage(timestamp: number): boolean {
  return Date.now() - timestamp < 120000 // 2分钟
}

function getBubbleClass(msg: GroupChatMessage): string {
  return msg.senderId === CURRENT_USER_ID
    ? 'rounded-2xl px-4 py-2.5 bg-[#C41E3A] text-white rounded-tr-sm'
    : 'rounded-2xl px-4 py-2.5 bg-[#F5F1EB] rounded-tl-sm'
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.animate-spin {
  animation: spin 1s linear infinite;
  display: inline-block;
}

/* 底部面板滑入动画 */
@keyframes slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.animate-slide-up {
  animation: slide-up 0.25s ease-out;
}

/* 旋转过渡 */
.transition-transform {
  transition: transform 0.2s ease;
}
.rotate-45 {
  transform: rotate(45deg);
}

/* 行数限制 */
.line-clamp-1 {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 文字换行 */
.whitespace-pre-wrap {
  white-space: pre-wrap;
}
.break-words {
  word-break: break-word;
}

/* 不透明度 */
.opacity-50 {
  opacity: 0.5;
}

.animate-spin {
  animation: spin 1s linear infinite;
  display: inline-block;
}

.animate-slide-up {
  animation: slide-up 0.25s ease-out;
}
</style>
