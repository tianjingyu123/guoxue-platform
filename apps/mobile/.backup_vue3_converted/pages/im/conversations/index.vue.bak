<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-10 bg-white border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between p-4">
        <view class="flex items-center gap-3">
          <view @click="goBack"><text class="text-xl text-[#2C2C2C]">←</text></view>
          <text class="text-lg font-semibold text-[#2C2C2C]">消息</text>
          <view v-if="totalUnread > 0" class="bg-[#F0EBE5] text-xs px-2 py-0.5 rounded-full text-[#999]">{{ totalUnread > 99 ? '99+' : totalUnread }}</view>
        </view>
        <view @click="showSearch = true"><text class="text-lg text-[#999]">🔍</text></view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view v-if="loading">
      <view v-for="i in 5" :key="i" class="flex items-center gap-3 p-4">
        <view class="w-12 h-12 rounded-full bg-[#F0EBE5] animate-pulse" />
        <view class="flex-1 space-y-2">
          <view class="h-4 w-24 bg-[#F0EBE5] rounded animate-pulse" />
          <view class="h-3 w-40 bg-[#F0EBE5] rounded animate-pulse" />
        </view>
      </view>
    </view>

    <!-- 错误状态 -->
    <view v-else-if="error" class="text-center py-20">
      <text class="text-4xl text-[#E8E0D5] block mb-3">⚠</text>
      <text class="text-[#999] text-sm block mb-4">{{ error }}</text>
      <view @click="loadConversations" class="inline-block px-6 py-2 bg-[#C41E3A] text-white rounded-full text-sm">重试</view>
    </view>

    <!-- 会话列表 -->
    <view v-else class="divide-y divide-[#FAF8F5]">
      <view v-for="conv in conversations" :key="conv.id" class="relative overflow-hidden">
        <!-- 左滑操作按钮 -->
        <view
          :class="['absolute right-0 top-0 bottom-0 flex transition-transform duration-200', swipedId === conv.id ? 'translate-x-0' : 'translate-x-full']"
        >
          <view
            @click="deleteConfirm(conv)"
            class="w-20 bg-[#C41E3A] text-white flex items-center justify-center"
          >
            <text class="text-lg">🗑</text>
          </view>
        </view>

        <!-- 会话内容 -->
        <view
          :class="['flex items-center gap-3 p-4 bg-white transition-transform duration-200', swipedId === conv.id ? '-translate-x-20' : 'translate-x-0', conv.isPinned ? 'bg-[#F0EBE5]/30' : '']"
          @click="enterChat(conv)"
          @touchstart="onTouchStart($event, conv.id)"
        >
          <!-- 头像 -->
          <view class="relative flex-shrink-0">
            <image
              :src="conv.targetAvatar || '/static/avatar-placeholder.png'"
              mode="aspectFill"
              class="w-12 h-12 rounded-full bg-[#F0EBE5]"
            />
            <!-- 未读角标 -->
            <view v-if="conv.unreadCount > 0 && !conv.isMuted" class="absolute -top-1 -right-1 min-w-5 h-5 px-1.5 flex items-center justify-center bg-[#C41E3A] text-white text-[10px] font-bold rounded-full">
              {{ conv.unreadCount > 99 ? '99+' : conv.unreadCount }}
            </view>
            <!-- 免打扰红点 -->
            <view v-if="conv.unreadCount > 0 && conv.isMuted" class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 bg-[#999]/50 rounded-full" />
            <!-- 类型标识 -->
            <view v-if="conv.type !== 'private'" class="absolute -bottom-0.5 -right-0.5 w-5 h-5 rounded-full bg-[#C41E3A] text-white flex items-center justify-center">
              <text class="text-[10px]">{{ conv.type === 'group' ? '👥' : conv.type === 'system' ? '🔔' : conv.type === 'service' ? '🎧' : '' }}</text>
            </view>
          </view>

          <!-- 内容 -->
          <view class="flex-1 min-w-0">
            <view class="flex items-center justify-between gap-2">
              <view class="flex items-center gap-1.5 min-w-0">
                <text :class="['truncate text-sm', conv.unreadCount > 0 ? 'font-semibold text-[#2C2C2C]' : 'text-[#2C2C2C]/80']">{{ conv.targetName }}</text>
                <text v-if="conv.isPinned" class="text-xs text-[#C41E3A] flex-shrink-0">📌</text>
                <text v-if="conv.isMuted" class="text-xs text-[#999] flex-shrink-0">🔇</text>
              </view>
              <text class="text-[10px] text-[#999] flex-shrink-0">{{ conv.lastMessage?.time || '' }}</text>
            </view>
            <view class="mt-0.5">
              <text v-if="conv.draft" class="text-sm text-[#C41E3A] truncate block">[草稿] {{ conv.draft }}</text>
              <text v-else :class="['text-sm truncate block', conv.unreadCount > 0 ? 'text-[#666]/70' : 'text-[#999]']">{{ getMessageSummary(conv.lastMessage) }}</text>
            </view>
          </view>

          <!-- 更多按钮 -->
          <view class="p-1 -mr-1 text-[#999]" @click.stop="showActionsMenu(conv)">
            <text class="text-lg">⋯</text>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view v-if="conversations.length === 0" class="text-center py-20">
        <text class="text-4xl text-[#E8E0D5] block mb-3">💬</text>
        <text class="text-[#999] text-sm">暂无消息</text>
      </view>
    </view>

    <!-- 搜索弹层 -->
    <view v-if="showSearch" class="fixed inset-0 z-50 bg-white">
      <view class="flex items-center gap-3 p-4 border-b border-[#E8E0D5]">
        <view class="flex-1 relative">
          <text class="absolute left-3 top-1/2 -translate-y-1/2 text-[#999]">🔍</text>
          <input
            v-model="searchKeyword"
            placeholder="搜索好友或聊天记录"
            class="w-full pl-9 pr-9 py-2.5 bg-[#F5F1EB] rounded-xl text-sm outline-none text-[#2C2C2C]"
            focus
          />
          <text v-if="searchKeyword" @click="searchKeyword = ''" class="absolute right-3 top-1/2 -translate-y-1/2 text-[#999]">✕</text>
        </view>
        <text @click="showSearch = false" class="text-[#C41E3A] text-sm">取消</text>
      </view>

      <view v-if="searching" class="text-center text-[#999] py-8 text-sm">搜索中...</view>

      <view v-else-if="searchResults" class="p-4 space-y-4">
        <!-- 好友结果 -->
        <view v-if="searchResults.friends && searchResults.friends.length > 0">
          <text class="text-sm font-medium text-[#999] block mb-2">好友</text>
          <view class="space-y-1">
            <view
              v-for="friend in searchResults.friends"
              :key="friend.id"
              class="flex items-center gap-3 p-3 rounded-lg"
              hover-class="bg-[#F5F1EB]"
              @click="goToChat(friend.id, 'private')"
            >
              <image :src="friend.avatar || '/static/avatar-placeholder.png'" mode="aspectFill" class="w-10 h-10 rounded-full" />
              <view>
                <text class="text-sm font-medium text-[#2C2C2C] block">{{ friend.remark || friend.nickname }}</text>
                <text v-if="friend.signature" class="text-xs text-[#999] truncate block">{{ friend.signature }}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 会话结果 -->
        <view v-if="searchResults.conversations && searchResults.conversations.length > 0">
          <text class="text-sm font-medium text-[#999] block mb-2">聊天记录</text>
          <view class="space-y-1">
            <view
              v-for="conv in searchResults.conversations"
              :key="conv.id"
              class="flex items-center gap-3 p-3 rounded-lg"
              hover-class="bg-[#F5F1EB]"
              @click="enterSearchResult(conv)"
            >
              <image :src="conv.targetAvatar || '/static/avatar-placeholder.png'" mode="aspectFill" class="w-10 h-10 rounded-full" />
              <view class="flex-1 min-w-0">
                <text class="text-sm font-medium text-[#2C2C2C] block">{{ conv.targetName }}</text>
                <text class="text-xs text-[#999] truncate block">{{ getMessageSummary(conv.lastMessage) }}</text>
              </view>
            </view>
          </view>
        </view>

        <view v-if="(!searchResults.friends || searchResults.friends.length === 0) && (!searchResults.conversations || searchResults.conversations.length === 0)" class="text-center text-[#999] py-8 text-sm">
          未找到相关结果
        </view>
      </view>

      <view v-else class="text-center text-[#999] py-8 text-sm">
        输入关键词搜索好友或聊天记录
      </view>
    </view>

    <!-- 操作菜单 -->
    <view v-if="showActions" class="fixed inset-0 z-50" @click="showActions = false">
      <view class="absolute inset-0 bg-black/40" />
      <view class="absolute bottom-0 left-0 right-0 bg-white rounded-t-2xl pb-8" @click.stop>
        <view class="space-y-1 py-2 px-4">
          <view
            class="flex items-center gap-3 py-4 rounded-lg active:bg-[#F5F1EB]"
            @click="handleTogglePin"
          >
            <text class="text-lg">📌</text>
            <text class="text-sm text-[#2C2C2C]">{{ activeConversation?.isPinned ? '取消置顶' : '置顶聊天' }}</text>
          </view>
          <view
            class="flex items-center gap-3 py-4 rounded-lg active:bg-[#F5F1EB]"
            @click="handleToggleMute"
          >
            <text class="text-lg">🔇</text>
            <text class="text-sm text-[#2C2C2C]">{{ activeConversation?.isMuted ? '取消免打扰' : '消息免打扰' }}</text>
          </view>
          <view
            class="flex items-center gap-3 py-4 rounded-lg active:bg-[#F5F1EB]"
            @click="handleDelete"
          >
            <text class="text-lg">🗑</text>
            <text class="text-sm text-[#C41E3A]">删除会话</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 删除确认弹窗 -->
    <view v-if="showDeleteConfirm" class="fixed inset-0 z-50 flex items-center justify-center px-6">
      <view class="absolute inset-0 bg-black/50" @click="showDeleteConfirm = false" />
      <view class="relative bg-white rounded-2xl p-6 w-full max-w-sm">
        <text class="text-lg font-semibold text-[#2C2C2C] block mb-2">删除会话</text>
        <text class="text-sm text-[#999] block mb-6">确定要删除与"{{ activeConversation?.targetName }}"的会话吗？聊天记录将被清空且无法恢复。</text>
        <view class="flex gap-3">
          <view @click="showDeleteConfirm = false" class="flex-1 py-3 bg-[#F5F1EB] text-[#666] rounded-xl text-center text-sm font-medium">取消</view>
          <view @click="confirmDelete" class="flex-1 py-3 bg-[#C41E3A] text-white rounded-xl text-center text-sm font-medium">
            {{ actionLoading ? '删除中...' : '删除' }}
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, watch, onMounted } from 'vue'

interface ConversationItem {
  id: string
  targetId?: string
  targetName: string
  targetAvatar?: string
  type: 'private' | 'group' | 'system' | 'service'
  unreadCount: number
  isPinned: boolean
  isMuted: boolean
  draft?: string
  lastMessage?: {
    type?: string
    content?: string
    time?: string
  }
  updatedAt: string
}

interface FriendItem {
  id: string
  nickname: string
  remark?: string
  avatar?: string
  signature?: string
}

const conversations = ref<ConversationItem[]>([])
const totalUnread = ref(0)
const loading = ref(true)
const error = ref<string | null>(null)

// 搜索
const showSearch = ref(false)
const searchKeyword = ref('')
const searchResults = ref<{ conversations: ConversationItem[]; friends: FriendItem[] } | null>(null)
const searching = ref(false)

// 操作
const activeConversation = ref<ConversationItem | null>(null)
const showActions = ref(false)
const showDeleteConfirm = ref(false)
const actionLoading = ref(false)

// 左滑
const swipedId = ref<string | null>(null)
let touchStartX = 0
let touchStartY = 0

function onTouchStart(e: any, id: string) {
  const touch = e.touches[0]
  touchStartX = touch.clientX
  touchStartY = touch.clientY

  const handleMove = (evt: any) => {
    const t = evt.touches[0]
    const diffX = touchStartX - t.clientX
    const diffY = Math.abs(touchStartY - t.clientY)
    if (diffY < 30 && diffX > 50) {
      swipedId.value = id
    } else if (diffX < -30) {
      swipedId.value = null
    }
  }

  const handleEnd = () => {
    document.removeEventListener('touchmove', handleMove as any)
    document.removeEventListener('touchend', handleEnd)
  }

  document.addEventListener('touchmove', handleMove as any)
  document.addEventListener('touchend', handleEnd)
}

// 加载会话列表
async function loadConversations() {
  try {
    loading.value = true
    error.value = null
    const res = await getConversations()
    if (res.code === 200 && res.data) {
      const sorted = [...res.data.list].sort((a: ConversationItem, b: ConversationItem) => {
        if (a.isPinned !== b.isPinned) return a.isPinned ? -1 : 1
        return new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime()
      })
      conversations.value = sorted
      totalUnread.value = res.data.totalUnread
    } else {
      error.value = res.message || '加载失败'
    }
  } catch {
    error.value = '网络错误，请重试'
  } finally {
    loading.value = false
  }
}

// 搜索防抖
watch(searchKeyword, (val) => {
  if (!val.trim()) {
    searchResults.value = null
    return
  }
  const timer = setTimeout(async () => {
    searching.value = true
    try {
      const res = await searchConversationsAndFriends(val)
      if (res.code === 200 && res.data) {
        searchResults.value = res.data
      }
    } finally {
      searching.value = false
    }
  }, 300)
  return () => clearTimeout(timer)
})

function getMessageSummary(lastMsg: any): string {
  if (!lastMsg) return ''
  if (lastMsg.type === 'image') return '[图片]'
  if (lastMsg.type === 'file') return '[文件]'
  if (lastMsg.type === 'voice') return '[语音]'
  return lastMsg.content || ''
}

function enterChat(conv: ConversationItem) {
  if (swipedId.value) {
    swipedId.value = null
    return
  }
  if (conv.type === 'private') {
    uni.navigateTo({ url: '/pages/im/chat/id-detail/index?id=' + (conv.targetId || conv.id) })
  } else if (conv.type === 'group') {
    uni.navigateTo({ url: '/pages/im/group-chat/id-detail/index?id=' + (conv.targetId || conv.id) })
  } else if (conv.type === 'service') {
    uni.navigateTo({ url: '/pages/im/customer-service/index' })
  } else if (conv.type === 'system') {
    uni.navigateTo({ url: '/pages/messages/index' })
  }
}

function enterSearchResult(conv: ConversationItem) {
  showSearch.value = false
  enterChat(conv)
}

function goToChat(id: string, type: string) {
  showSearch.value = false
  if (type === 'private') {
    uni.navigateTo({ url: '/pages/im/chat/id-detail/index?id=' + id })
  }
}

function showActionsMenu(conv: ConversationItem) {
  activeConversation.value = conv
  showActions.value = true
}

function deleteConfirm(conv: ConversationItem) {
  activeConversation.value = conv
  showDeleteConfirm.value = true
}

async function handleTogglePin() {
  if (!activeConversation.value || actionLoading.value) return
  actionLoading.value = true
  try {
    const res = await togglePinConversation(activeConversation.value.id, !activeConversation.value.isPinned)
    if (res.code === 200) {
      const updated = conversations.value.map(c =>
        c.id === activeConversation.value!.id ? { ...c, isPinned: !c.isPinned } : c
      )
      updated.sort((a, b) => {
        if (a.isPinned !== b.isPinned) return a.isPinned ? -1 : 1
        return new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime()
      })
      conversations.value = updated
      showActions.value = false
    }
  } finally {
    actionLoading.value = false
  }
}

async function handleToggleMute() {
  if (!activeConversation.value || actionLoading.value) return
  actionLoading.value = true
  try {
    const res = await toggleMuteConversation(activeConversation.value.id, !activeConversation.value.isMuted)
    if (res.code === 200) {
      conversations.value = conversations.value.map(c =>
        c.id === activeConversation.value!.id ? { ...c, isMuted: !c.isMuted } : c
      )
      showActions.value = false
    }
  } finally {
    actionLoading.value = false
  }
}

async function confirmDelete() {
  if (!activeConversation.value) return
  actionLoading.value = true
  try {
    const res = await deleteConversation(activeConversation.value.id)
    if (res.code === 200) {
      conversations.value = conversations.value.filter(c => c.id !== activeConversation.value!.id)
      showDeleteConfirm.value = false
      showActions.value = false
      swipedId.value = null
    }
  } finally {
    actionLoading.value = false
  }
}

function handleDelete() {
  showActions.value = false
  showDeleteConfirm.value = true
}

function goBack() { uni.navigateBack() }

// API 桩函数 (Mock 数据)
const mockConversations: ConversationItem[] = [
  { id: 'c1', targetName: '八字命理研习社', targetAvatar: 'https://images.unsplash.com/photo-1512820790803-83ca734da794?w=80&q=80', type: 'group', unreadCount: 5, isPinned: true, isMuted: false, lastMessage: { type: 'text', content: '张大师: 今天的案例很有启发性', time: '10:32' }, updatedAt: '2026-06-11T10:32:00' },
  { id: 'c2', targetName: '林道长', targetAvatar: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=80&q=80', type: 'private', unreadCount: 2, isPinned: false, isMuted: false, lastMessage: { type: 'text', content: '好的，我帮你看一下这个命盘', time: '09:15' }, updatedAt: '2026-06-11T09:15:00' },
  { id: 'c3', targetName: '风水堪舆学院', targetAvatar: 'https://images.unsplash.com/photo-1497366216548-37526070297c?w=80&q=80', type: 'group', unreadCount: 0, isPinned: true, isMuted: true, lastMessage: { type: 'text', content: '王大师: 阳宅布局的核心是纳气', time: '昨天' }, updatedAt: '2026-06-10T18:00:00' },
  { id: 'c4', targetName: '热卜国学助手', targetAvatar: '', type: 'service', unreadCount: 1, isPinned: false, isMuted: false, lastMessage: { type: 'text', content: '您预约的课程将在明天开始', time: '昨天' }, updatedAt: '2026-06-10T10:00:00' },
  { id: 'c5', targetName: '陈老师', type: 'private', unreadCount: 0, isPinned: false, isMuted: false, lastMessage: { type: 'text', content: '六爻预测确实需要多练习', time: '2天前' }, updatedAt: '2026-06-09T15:30:00' },
  { id: 'c6', targetName: '紫微斗数交流群', targetAvatar: 'https://images.unsplash.com/photo-1532074205216-d0e1f4b87368?w=80&q=80', type: 'group', unreadCount: 12, isPinned: false, isMuted: false, lastMessage: { type: 'text', content: '李同学: 十二宫位的飞星变化...', time: '3天前' }, updatedAt: '2026-06-08T20:00:00' },
  { id: 'c7', targetName: '平台通知', type: 'system', unreadCount: 3, isPinned: false, isMuted: false, lastMessage: { type: 'text', content: '系统升级公告：v2.5版本已发布', time: '1周前' }, updatedAt: '2026-06-04T08:00:00' },
]

const mockFriends: FriendItem[] = [
  { id: 'f1', name: '张大师', avatar: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=80&q=80', isOnline: true },
  { id: 'f2', name: '林道长', avatar: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=80&q=80', isOnline: true },
  { id: 'f3', name: '王大师', avatar: 'https://images.unsplash.com/photo-1560250097-0b93528c311a?w=80&q=80', isOnline: false },
  { id: 'f4', name: '陈老师', avatar: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=80&q=80', isOnline: false },
]

async function getConversations(): Promise<any> {
  return { code: 200, data: { list: mockConversations, totalUnread: mockConversations.reduce((s, c) => s + c.unreadCount, 0) } }
}
async function searchConversationsAndFriends(keyword: string): Promise<any> {
  const kw = keyword.toLowerCase()
  const conversations = mockConversations.filter(c => c.targetName.toLowerCase().includes(kw))
  const friends = mockFriends.filter(f => f.name.toLowerCase().includes(kw))
  return { code: 200, data: { conversations, friends } }
}
async function togglePinConversation(id: string, pin: boolean): Promise<any> {
  return { code: 200 }
}
async function toggleMuteConversation(id: string, mute: boolean): Promise<any> {
  return { code: 200 }
}
async function deleteConversation(id: string): Promise<any> {
  return { code: 200 }
}

onMounted(() => {
  loadConversations()
})
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
