<template>
  <view class="min-h-screen bg-[#FAF8F5] pb-20">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 h-14">
        <view @click="goBack"><text class="text-xl text-[#2C2C2C]">←</text></view>
        <text class="text-base font-semibold text-[#2C2C2C]">公告详情</text>
        <view @click="handleShare" class="p-2 -mr-2"><text class="text-lg text-[#999]">📤</text></view>
      </view>
    </view>

    <!-- 加载骨架 -->
    <view v-if="loading" class="p-4 space-y-4">
      <view class="h-8 w-3/4 bg-[#F0EBE5] rounded animate-pulse" />
      <view class="flex items-center gap-4">
        <view class="h-5 w-20 bg-[#F0EBE5] rounded animate-pulse" />
        <view class="h-5 w-32 bg-[#F0EBE5] rounded animate-pulse" />
      </view>
      <view class="h-40 w-full bg-[#F0EBE5] rounded animate-pulse" />
      <view class="space-y-2">
        <view class="h-4 w-full bg-[#F0EBE5] rounded animate-pulse" />
        <view class="h-4 w-full bg-[#F0EBE5] rounded animate-pulse" />
        <view class="h-4 w-3/4 bg-[#F0EBE5] rounded animate-pulse" />
      </view>
    </view>

    <!-- 错误状态 -->
    <view v-else-if="error" class="flex flex-col items-center justify-center py-20">
      <text class="text-3xl mb-3">⚠</text>
      <text class="text-[#999] text-sm mb-4">{{ error }}</text>
      <view @click="loadNotice" class="px-6 py-2 bg-[#C41E3A] text-white rounded-full text-sm">重试</view>
    </view>

    <!-- 公告不存在 -->
    <view v-else-if="!notice" class="flex flex-col items-center justify-center py-20">
      <text class="text-4xl text-[#999] mb-4">⚠</text>
      <text class="text-[#999] text-sm">公告不存在或已删除</text>
      <view @click="goBack" class="mt-4 px-6 py-2 border border-[#E8E0D5] rounded-full text-sm text-[#2C2C2C]">返回列表</view>
    </view>

    <!-- 公告正文 -->
    <main v-else class="p-4 space-y-6">
      <!-- 公告封面 -->
      <view v-if="notice.cover" class="rounded-xl overflow-hidden">
        <image :src="notice.cover" mode="aspectFill" class="w-full h-48" />
      </view>

      <!-- 标题和元信息 -->
      <view class="space-y-3">
        <view class="flex items-center gap-2">
          <view v-if="notice.isPinned" class="bg-[#C41E3A] text-white text-xs px-2 py-0.5 rounded">置顶</view>
          <view :class="['text-xs px-2 py-0.5 rounded flex items-center gap-1', typeColor]">
            <text class="text-xs">{{ typeIcon }}</text>
            <text>{{ getNoticeTypeLabel(notice.type) }}</text>
          </view>
        </view>

        <text class="text-xl font-bold text-[#2C2C2C] block leading-tight">{{ notice.title }}</text>

        <view class="flex items-center gap-4 text-sm text-[#999]">
          <text class="flex items-center gap-1">📅 {{ notice.publishedAt }}</text>
          <text class="flex items-center gap-1">👁 {{ notice.viewCount }} 次阅读</text>
        </view>
      </view>

      <!-- 分隔线 -->
      <view class="border-t border-[#E8E0D5]" />

      <!-- 公告正文 -->
      <view class="bg-white rounded-xl p-4">
        <text class="text-sm text-[#555] leading-relaxed whitespace-pre-line">{{ notice.content }}</text>
      </view>

      <!-- 相关链接 -->
      <view v-if="notice.link" class="bg-white rounded-xl p-4">
        <text class="text-sm font-medium text-[#2C2C2C] mb-2 block">相关链接</text>
        <a :href="notice.link" class="text-sm text-[#C41E3A] flex items-center gap-1">
          <text>查看详情</text>
          <text class="text-xs">→</text>
        </a>
      </view>

      <!-- 附件 -->
      <view v-if="notice.attachments && notice.attachments.length > 0" class="bg-white rounded-xl p-4">
        <text class="text-sm font-medium text-[#2C2C2C] mb-3 block">附件</text>
        <view class="space-y-2">
          <view v-for="(attachment, index) in notice.attachments" :key="index" class="flex items-center gap-3 p-3 bg-[#F5F1EB]/50 rounded-lg">
            <view class="w-10 h-10 rounded-lg bg-[#C41E3A]/10 flex items-center justify-center">
              <text class="text-lg">📄</text>
            </view>
            <view class="flex-1 min-w-0">
              <text class="text-sm font-medium text-[#2C2C2C] truncate block">{{ attachment.name }}</text>
              <text v-if="attachment.size" class="text-xs text-[#999]">{{ (attachment.size / 1024).toFixed(1) }} KB</text>
            </view>
            <text class="text-xs text-[#C41E3A]">下载</text>
          </view>
        </view>
      </view>

      <!-- 发布信息 -->
      <view class="text-center text-xs text-[#999] pt-4">
        <text class="block">由 热卜平台 发布</text>
        <text class="block">发布时间：{{ notice.publishedAt }}</text>
      </view>
    </main>

    <!-- 底部操作栏 -->
    <view class="fixed bottom-0 left-0 right-0 bg-white/95 backdrop-blur border-t border-[#E8E0D5] px-4 py-3" style="padding-bottom:calc(12px + env(safe-area-inset-bottom))">
      <view class="flex gap-3">
        <view @click="goBack" class="flex-1 py-3 border border-[#E8E0D5] rounded-xl text-center text-sm text-[#2C2C2C]">返回列表</view>
        <view @click="handleShare" class="flex-1 py-3 bg-[#C41E3A] text-white rounded-xl text-center text-sm font-medium flex items-center justify-center gap-2">
          <text>📤</text>
          <text>分享公告</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'
import { onLoad } from '@dcloudio/uni-app'

interface NoticeAttachment {
  name: string
  url: string
  size?: number
}

interface NoticeDetail {
  id: number
  title: string
  summary: string
  content: string
  type: string
  cover?: string
  isPinned: boolean
  isRead: boolean
  publishedAt: string
  viewCount: number
  link?: string
  attachments?: NoticeAttachment[]
}

const noticeId = ref(0)
const notice = ref<NoticeDetail | null>(null)
const loading = ref(true)
const error = ref<string | null>(null)

const typeIcons: Record<string, string> = {
  announcement: '📢',
  activity: '🎁',
  update: '⚙',
  warning: '⚠',
}
const typeColors: Record<string, string> = {
  announcement: 'bg-blue-100 text-blue-600',
  activity: 'bg-orange-100 text-orange-600',
  update: 'bg-green-100 text-green-600',
  warning: 'bg-red-100 text-red-600',
}

const typeIcon = computed(() => typeIcons[notice.value?.type || 'announcement'] || '📢')
const typeColor = computed(() => typeColors[notice.value?.type || 'announcement'] || 'bg-gray-100 text-gray-600')

onLoad((options: any) => {
  noticeId.value = Number(options?.id) || 0
})

async function loadNotice() {
  loading.value = true
  try {
    const response = await getNoticeDetail(noticeId.value)
    if (response.code === 200 && response.data) {
      notice.value = response.data
      if (!response.data.isRead) {
        await markNoticeRead(noticeId.value)
      }
    }
  } catch (e) {
    error.value = '加载失败'
  } finally {
    loading.value = false
  }
}

function getNoticeTypeLabel(type: string): string {
  const labels: Record<string, string> = {
    announcement: '公告',
    activity: '活动',
    update: '更新',
    warning: '警告',
  }
  return labels[type] || type
}

function handleShare() {
  if (!notice.value) return
  uni.setClipboardData({
    data: `https://rebugx.cn/notices/${notice.value?.id || ''}`,
    success: () => uni.showToast({ title: '链接已复制', icon: 'success' })
  })
}

function goBack() { uni.navigateBack() }

// Mock数据
function getMockNotice(id: number): NoticeDetail {
  return {
    id, title: '系统升级维护通知', summary: '平台将于本周六进行系统维护',
    content: '尊敬的用户：\n\n为了提供更好的服务体验，平台将于本周六（1月20日）凌晨2:00-6:00进行系统升级维护。\n\n维护期间，以下功能将暂停使用：\n1. 在线支付\n2. 直播推流\n3. 文件上传\n\n请提前安排好您的工作，给您带来的不便敬请谅解。\n\n热卜平台运营团队\n2024年1月15日',
    type: 'announcement', isPinned: true, isRead: false,
    publishedAt: '2024-01-15 10:00', viewCount: 1280,
    attachments: [{ name: '系统维护详情说明.pdf', url: '#', size: 245760 }],
  }
}

// API 桩函数
async function getNoticeDetail(id: number): Promise<any> {
  return { code: 200, data: getMockNotice(id) }
}
async function markNoticeRead(id: number): Promise<any> {
  return { code: 200 }
}

onMounted(() => {
  loadNotice()
})
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
