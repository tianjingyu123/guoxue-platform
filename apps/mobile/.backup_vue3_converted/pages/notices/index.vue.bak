<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between h-14 px-4">
        <view @click="goBack"><text class="text-xl text-[#2C2C2C]">←</text></view>
        <text class="text-base font-semibold text-[#2C2C2C]">平台公告</text>
        <view class="w-10" />
      </view>

      <!-- 筛选栏 -->
      <view class="px-4 pb-3 overflow-x-auto">
        <scroll-view scroll-x class="flex gap-2 whitespace-nowrap">
          <view
            v-for="option in filterOptions"
            :key="option.value"
            @click="filter = option.value; page = 1"
            :class="['px-3 py-1.5 rounded-full text-sm inline-block transition-colors', filter === option.value ? 'bg-[#C41E3A] text-white' : 'bg-[#F5F1EB] text-[#999]']"
          >
            <text>{{ option.label }}</text>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- 加载中 -->
    <view v-if="loading" class="p-4 space-y-3">
      <view v-for="i in 4" :key="i" class="bg-white rounded-xl p-4 animate-pulse">
        <view class="h-4 bg-[#F0EBE5] rounded w-3/4 mb-2" />
        <view class="h-3 bg-[#F0EBE5] rounded w-full mb-2" />
        <view class="h-3 bg-[#F0EBE5] rounded w-1/2" />
      </view>
    </view>

    <!-- 错误状态 -->
    <view v-else-if="error" class="text-center py-20">
      <text class="text-4xl text-[#E8E0D5] block mb-3">⚠</text>
      <text class="text-[#999] text-sm block mb-4">{{ error }}</text>
      <view @click="loadData(1, filter)" class="inline-block px-6 py-2 bg-[#C41E3A] text-white rounded-full text-sm">重试</view>
    </view>

    <!-- 公告列表 -->
    <view v-else class="p-4 space-y-3">
      <view v-if="notices.length === 0" class="text-center py-20">
        <text class="text-4xl text-[#E8E0D5] block mb-3">📢</text>
        <text class="text-[#999] text-sm">当前没有任何公告信息</text>
      </view>

      <view
        v-for="notice in notices"
        :key="notice.id"
        @click="goDetail(notice.id)"
        :class="['bg-white rounded-xl p-4 transition-all', !notice.isRead ? 'border-l-2 border-l-[#C41E3A]' : '']"
      >
        <view class="flex items-start gap-3">
          <!-- 封面图 -->
          <image v-if="notice.cover" :src="notice.cover" mode="aspectFill" class="w-20 h-14 rounded object-cover flex-shrink-0" />

          <view class="flex-1 min-w-0">
            <!-- 标题行 -->
            <view class="flex items-center gap-2 mb-1">
              <text v-if="notice.isPinned" class="text-xs text-[#C41E3A]">📌</text>
              <text v-if="!notice.isRead" class="w-2 h-2 rounded-full bg-[#C41E3A] flex-shrink-0" />
              <text :class="['text-sm font-medium line-clamp-1', !notice.isRead ? 'text-[#2C2C2C]' : 'text-[#999]']">
                {{ notice.title }}
              </text>
            </view>

            <!-- 摘要 -->
            <text class="text-xs text-[#999] line-clamp-2 block mb-2">{{ notice.summary }}</text>

            <!-- 底部信息 -->
            <view class="flex items-center justify-between">
              <view class="flex items-center gap-2">
                <view :class="['text-[10px] px-1.5 py-0.5 rounded', getTypeColor(notice.type)]">
                  <text>{{ getTypeLabel(notice.type) }}</text>
                </view>
                <text class="text-[10px] text-[#999]">{{ formatTime(notice.publishedAt) }}</text>
              </view>
              <view class="flex items-center gap-1 text-[10px] text-[#999]">
                <text>👁</text>
                <text>{{ notice.viewCount > 10000 ? (notice.viewCount / 10000).toFixed(1) + '万' : notice.viewCount }}</text>
                <text class="text-xs">›</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 加载更多 -->
      <view v-if="hasMore" @click="handleLoadMore" class="w-full py-3 text-sm text-[#999] flex items-center justify-center gap-2">
        <text v-if="loadingMore">⏳ 加载中...</text>
        <text v-else>点击加载更多</text>
      </view>

      <view v-if="!hasMore && notices.length > 0" class="text-center text-xs text-[#999] py-4">
        已加载全部公告
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, watch, onMounted } from 'vue'

interface NoticeItem {
  id: number
  title: string
  summary: string
  type: string
  cover?: string
  isPinned: boolean
  isRead: boolean
  publishedAt: string
  viewCount: number
}

const filterOptions = [
  { value: 'all', label: '全部' },
  { value: 'system', label: '系统' },
  { value: 'update', label: '更新' },
  { value: 'activity', label: '活动' },
  { value: 'maintenance', label: '维护' },
  { value: 'policy', label: '政策' },
]

const notices = ref<NoticeItem[]>([])
const loading = ref(true)
const error = ref<string | null>(null)
const filter = ref<string>('all')
const page = ref(1)
const loadingMore = ref(false)
const hasMore = ref(false)

// 加载数据
async function loadData(pageNum: number, typeFilter: string, append = false) {
  try {
    if (pageNum === 1) loading.value = true
    else loadingMore.value = true
    error.value = null

    const response = await getNoticeList({
      page: pageNum,
      pageSize: 10,
      type: typeFilter === 'all' ? undefined : typeFilter,
    })

    if (response.code === 200) {
      if (append) {
        notices.value = [...notices.value, ...response.data.list]
      } else {
        notices.value = response.data.list
      }
      hasMore.value = response.data.hasMore
      page.value = pageNum
    } else {
      error.value = response.message || '加载失败'
    }
  } catch {
    error.value = '网络错误，请重试'
  } finally {
    loading.value = false
    loadingMore.value = false
  }
}

// 筛选变化时重新加载
watch(filter, (val) => {
  loadData(1, val)
})

function handleLoadMore() {
  if (!loadingMore.value && hasMore.value) {
    loadData(page.value + 1, filter.value, true)
  }
}

function formatTime(timeStr: string): string {
  const date = new Date(timeStr)
  const now = new Date()
  const diff = now.getTime() - date.getTime()
  if (diff < 3600000) return `${Math.floor(diff / 60000)}分钟前`
  if (diff < 86400000) return `${Math.floor(diff / 3600000)}小时前`
  if (diff < 604800000) return `${Math.floor(diff / 86400000)}天前`
  return `${date.getMonth() + 1}月${date.getDate()}日`
}

function getTypeColor(type: string): string {
  const colors: Record<string, string> = {
    system: 'bg-blue-100 text-blue-600',
    update: 'bg-green-100 text-green-600',
    activity: 'bg-orange-100 text-orange-600',
    maintenance: 'bg-yellow-100 text-yellow-600',
    policy: 'bg-purple-100 text-purple-600',
  }
  return colors[type] || 'bg-gray-100 text-gray-600'
}

function getTypeLabel(type: string): string {
  const labels: Record<string, string> = {
    system: '系统',
    update: '更新',
    activity: '活动',
    maintenance: '维护',
    policy: '政策',
  }
  return labels[type] || type
}

function goDetail(id: number) {
  uni.navigateTo({ url: `/pages/notices/id-detail/index?id=${id}` })
}

function goBack() { uni.navigateBack() }

// API 桩函数 (Mock 数据)
const mockNotices: NoticeItem[] = [
  { id: 1, title: '【系统升级】热卜国学 v2.5 版本更新公告', summary: '新增奇门遁甲飞盘排盘、八字合婚报告优化、社区圈子功能上线，修复若干已知问题', type: 'update', cover: 'https://images.unsplash.com/photo-1558618666-fcd25c85f82e?w=200&q=80', isPinned: true, isRead: false, publishedAt: '2026-06-10', viewCount: 12580 },
  { id: 2, title: '端午节特别活动 — 国学知识问答赢好礼', summary: '参与国学知识挑战赛，赢取会员卡、课程优惠券、实体书籍等精美礼品', type: 'activity', cover: 'https://images.unsplash.com/photo-1606185540833-4d242cf5ada9?w=200&q=80', isPinned: true, isRead: false, publishedAt: '2026-06-09', viewCount: 8930 },
  { id: 3, title: '关于平台内容审核规则调整的通知', summary: '为维护平台内容质量，所有发布的文章和帖子将增加AI辅助审核流程', type: 'policy', isPinned: false, isRead: true, publishedAt: '2026-06-08', viewCount: 4560 },
  { id: 4, title: '服务器维护公告 — 6月15日凌晨停机维护', summary: '将于6月15日 02:00-04:00 进行服务器升级维护，届时平台将暂时不可用', type: 'maintenance', isPinned: false, isRead: true, publishedAt: '2026-06-07', viewCount: 6780 },
  { id: 5, title: '《八字命理系统精讲》新课程上线', summary: '张师傅主讲，52节课系统学习八字排盘与命理分析，限时优惠268元', type: 'system', cover: 'https://images.unsplash.com/photo-1512820790803-83ca734da794?w=200&q=80', isPinned: false, isRead: false, publishedAt: '2026-06-06', viewCount: 10200 },
  { id: 6, title: '热卜国学用户服务协议更新', summary: '根据最新法律法规要求，我们对用户服务协议和隐私政策进行了修订', type: 'policy', isPinned: false, isRead: true, publishedAt: '2026-06-05', viewCount: 2340 },
  { id: 7, title: '社区圈子功能正式上线', summary: '现已支持创建国学兴趣圈子、圈内发帖讨论、签到打卡等功能', type: 'update', isPinned: false, isRead: false, publishedAt: '2026-06-04', viewCount: 7560 },
  { id: 8, title: '风水堪舆实战班限时优惠', summary: '王大师主讲，48节课涵盖阳宅风水布局详解，原价599现价299', type: 'activity', cover: 'https://images.unsplash.com/photo-1497366216548-37526070297c?w=200&q=80', isPinned: false, isRead: true, publishedAt: '2026-06-03', viewCount: 5430 },
  { id: 9, title: '直播预告：奇门遁甲实战案例分析', summary: '6月12日晚20:00，赵先生将在直播间详解奇门遁甲飞盘案例', type: 'activity', isPinned: false, isRead: false, publishedAt: '2026-06-02', viewCount: 3890 },
  { id: 10, title: '平台支付系统升级完成通知', summary: '支付系统已升级至最新版本，新增支持多种支付方式，请放心使用', type: 'system', isPinned: false, isRead: true, publishedAt: '2026-06-01', viewCount: 4120 },
  { id: 11, title: '六一儿童节特别企划：宝宝起名专题', summary: '李老师特别策划，从八字五行到音律美学，为宝宝取一个好名字', type: 'activity', cover: 'https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?w=200&q=80', isPinned: false, isRead: true, publishedAt: '2026-05-31', viewCount: 9100 },
  { id: 12, title: '关于严厉打击虚假宣传内容的公告', summary: '近期发现有部分用户发布夸大虚假的命理预测内容，平台将进行专项整治', type: 'policy', isPinned: false, isRead: true, publishedAt: '2026-05-30', viewCount: 5670 },
]

async function getNoticeList(params: any): Promise<any> {
  const { page = 1, pageSize = 10, type } = params
  let list = mockNotices
  if (type) {
    list = list.filter(n => n.type === type)
  }
  const start = (page - 1) * pageSize
  const paged = list.slice(start, start + pageSize)
  return { code: 200, data: { list: paged, hasMore: start + pageSize < list.length } }
}

onMounted(() => {
  loadData(1, 'all')
})
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
