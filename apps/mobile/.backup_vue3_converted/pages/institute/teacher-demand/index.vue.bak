<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <header class="sticky top-0 z-10 bg-[#FAF8F5]/95 border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 py-3">
        <view class="flex items-center gap-3">
          <view @click="goBack" class="p-1"><text class="text-xl leading-none">←</text></view>
          <text class="text-lg font-semibold">课程需求大厅</text>
        </view>
        <!-- 视角切换 -->
        <view class="flex rounded-lg overflow-hidden" style="border:1px solid rgba(232,224,213,0.6)">
          <view @click="viewMode='teacher'"
            class="px-3 py-1 text-xs"
            :class="viewMode==='teacher' ? 'bg-[#C41E3A] text-white' : 'text-[#999]'">老师视角</view>
          <view @click="viewMode='station'"
            class="px-3 py-1 text-xs"
            :class="viewMode==='station' ? 'bg-[#C41E3A] text-white' : 'text-[#999]'">驿站视角</view>
        </view>
      </view>
    </header>

    <!-- Tab切换 -->
    <view class="px-4 py-2 flex gap-2 overflow-x-auto border-b border-[#E8E0D5]" style="white-space:nowrap">
      <view v-for="tab in tabs" :key="tab.id" @click="activeTab = tab.id"
        class="inline-flex px-3 py-1 rounded-full text-xs"
        :class="activeTab === tab.id ? 'bg-[#C41E3A] text-white' : 'bg-white text-[#999]'"
        style="border:1px solid rgba(232,224,213,0.6)">{{ tab.label }}</view>
    </view>

    <!-- 需求列表 -->
    <view class="px-4 py-3 space-y-3">
      <view v-for="demand in filteredDemands" :key="demand.id"
        @click="goToDemandDetail(demand.id)"
        class="bg-white rounded-xl p-3" style="border:1px solid rgba(232,224,213,0.6)">
        <!-- 驿站信息 -->
        <view class="flex items-center gap-2 pb-2 mb-2" style="border-bottom:1px solid rgba(232,224,213,0.6)">
          <view class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:rgba(59,130,246,0.1)">
            <text class="text-sm">🏛️</text>
          </view>
          <view class="flex-1 min-w-0">
            <text class="text-sm font-medium block" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ demand.stationName }}</text>
            <text class="text-[10px] text-[#999] flex items-center gap-1">📍 {{ demand.stationLocation }}</text>
          </view>
          <text class="text-[10px] px-2 py-0.5 rounded" :style="`background:${statusConfig[demand.status].bgColor};color:${statusConfig[demand.status].color}`">
            {{ statusConfig[demand.status].label }}
          </text>
        </view>

        <!-- 需求内容 -->
        <text class="font-medium text-[#2C2C2C]">{{ demand.title }}</text>
        <text class="text-xs text-[#999] mt-1 block" style="overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical">{{ demand.description }}</text>

        <!-- 标签 -->
        <view class="flex flex-wrap gap-1 mt-2">
          <text class="text-[10px] px-2 py-0.5 rounded-full bg-white text-[#999]" style="border:1px solid rgba(232,224,213,0.6)">{{ demand.specialty }}</text>
          <text class="text-[10px] px-2 py-0.5 rounded-full bg-white text-[#999]" style="border:1px solid rgba(232,224,213,0.6)">{{ demand.duration }}</text>
          <text class="text-[10px] px-2 py-0.5 rounded-full bg-white text-[#999]" style="border:1px solid rgba(232,224,213,0.6)">{{ demand.studentCount }}人班</text>
        </view>

        <!-- 底部信息 -->
        <view class="flex items-center justify-between mt-3 pt-2" style="border-top:1px solid rgba(232,224,213,0.6)">
          <view class="flex items-center gap-3 text-[10px] text-[#999]">
            <text class="flex items-center gap-1">📅 {{ demand.date.split(' ')[0] }}</text>
            <text class="flex items-center gap-1">👥 {{ demand.applicants }}人申请</text>
          </view>
          <view class="text-right">
            <text class="text-[10px] text-[#999]">预算 </text>
            <text class="text-sm font-medium text-[#C41E3A]">¥{{ (demand.budget.min / 1000).toFixed(0) }}k-{{ (demand.budget.max / 1000).toFixed(0) }}k</text>
          </view>
        </view>

        <!-- 老师视角：申请按钮 -->
        <view v-if="viewMode === 'teacher' && demand.status === 'recruiting'"
          @click="handleApply(demand)"
          class="w-full mt-3 py-2 bg-[#C41E3A] text-white rounded-full text-center text-xs">申请授课</view>
      </view>
    </view>

    <!-- 驿站视角：发布需求按钮 -->
    <view v-if="viewMode === 'station'"
      class="fixed bottom-0 left-0 right-0 p-4 bg-[#FAF8F5]" style="border-top:1px solid rgba(232,224,213,0.6)">
      <view @click="handlePublish" class="w-full py-3 bg-[#C41E3A] text-white rounded-full text-center text-sm font-medium flex items-center justify-center gap-2">
        <text>+</text>
        <text>发布课程需求</text>
      </view>
    </view>
    <view v-if="viewMode === 'station'" class="h-20" />
  </view>
</template>
<script setup lang="ts">
import { ref, computed } from 'vue'

type DemandStatus = 'recruiting' | 'matched' | 'confirmed' | 'completed' | 'cancelled'

interface TeacherDemand {
  id: number
  stationName: string
  stationAvatar: string
  stationLocation: string
  title: string
  specialty: string
  date: string
  duration: string
  studentCount: number
  budget: { min: number; max: number }
  status: DemandStatus
  applicants: number
  description: string
  requirements: string[]
  createdAt: string
}

const viewMode = ref<'station' | 'teacher'>('teacher')
const activeTab = ref('all')

const statusConfig: Record<string, { label: string; color: string; bgColor: string }> = {
  recruiting: { label: '招募中', color: '#16a34a', bgColor: 'rgba(22,163,74,0.1)' },
  matched: { label: '已匹配', color: '#2563eb', bgColor: 'rgba(37,99,235,0.1)' },
  confirmed: { label: '已确认', color: '#c41e3a', bgColor: 'rgba(196,30,58,0.1)' },
  completed: { label: '已完成', color: '#999999', bgColor: 'rgba(153,153,153,0.1)' },
  cancelled: { label: '已取消', color: '#ef4444', bgColor: 'rgba(239,68,68,0.1)' },
}

const mockDemands: TeacherDemand[] = [
  {
    id: 1, stationName: '北京国学驿站', stationAvatar: '', stationLocation: '北京·朝阳区',
    title: '八字命理高级班授课老师', specialty: '八字命理',
    date: '2024-04-15 至 2024-04-17', duration: '3天/18课时', studentCount: 30,
    budget: { min: 15000, max: 25000 }, status: 'recruiting', applicants: 5,
    description: '招募资深八字命理老师，为高级班学员授课，要求有丰富的实战经验和教学经验。',
    requirements: ['5年以上授课经验', '研究院成员优先', '可提供往期课程录像'], createdAt: '2024-03-18'
  },
  {
    id: 2, stationName: '上海易学馆', stationAvatar: '', stationLocation: '上海·静安区',
    title: '紫微斗数入门班讲师', specialty: '紫微斗数',
    date: '2024-04-20 至 2024-04-21', duration: '2天/12课时', studentCount: 25,
    budget: { min: 8000, max: 12000 }, status: 'recruiting', applicants: 3,
    description: '招募紫微斗数讲师，负责入门班教学，需要有系统的教学大纲。',
    requirements: ['3年以上授课经验', '有完整教学体系', '善于与学员互动'], createdAt: '2024-03-20'
  },
  {
    id: 3, stationName: '广州玄学堂', stationAvatar: '', stationLocation: '广州·天河区',
    title: '风水堪舆实地教学', specialty: '风水堪舆',
    date: '2024-05-01 至 2024-05-03', duration: '3天实地考察', studentCount: 15,
    budget: { min: 20000, max: 35000 }, status: 'matched', applicants: 8,
    description: '组织风水实地考察教学，需要老师带队讲解真实案例。',
    requirements: ['高级讲师', '本地有多个可考察案例', '配合度高'], createdAt: '2024-03-15'
  },
  {
    id: 4, stationName: '成都周易学社', stationAvatar: '', stationLocation: '成都·武侯区',
    title: '易经基础班周末课程', specialty: '易经占卜',
    date: '2024-04-06、07、13、14', duration: '4天/24课时', studentCount: 40,
    budget: { min: 12000, max: 18000 }, status: 'confirmed', applicants: 6,
    description: '周末易经基础课程，面向零基础学员。',
    requirements: ['教学经验丰富', '课程内容通俗易懂', '周末时间充裕'], createdAt: '2024-03-10'
  },
]

const tabs = [
  { id: 'all', label: '全部' },
  { id: 'recruiting', label: '招募中' },
  { id: 'matched', label: '已匹配' },
  { id: 'completed', label: '已完成' },
]

const filteredDemands = computed(() => {
  if (activeTab.value === 'all') return mockDemands
  return mockDemands.filter(d => d.status === activeTab.value)
})

function handleApply(demand: TeacherDemand) {
  uni.showToast({ title: `已申请「${demand.title}」`, icon: 'success' })
}

function handlePublish() {
  uni.navigateTo({ url: '/pages/institute/teacher-demand/create/index' })
}

function goToDemandDetail(id: number) {
  uni.navigateTo({ url: `/pages/institute/demands/id-detail/index?id=${id}` })
}

function goBack() { uni.navigateBack() }
</script>
<style scoped>
/* 样式由 Tailwind 处理 */
</style>
