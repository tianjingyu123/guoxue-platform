<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-40 bg-[#FAF8F5]/95 backdrop-blur border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 py-3">
        <view class="flex items-center gap-3">
          <view @click="goBack" class="p-1">
            <text class="w-5 h-5 text-[#2C2C2C]" style="font-size:20px">←</text>
          </view>
          <text class="text-lg font-semibold">研究院成员</text>
        </view>
        <view class="text-xs px-2 py-1 bg-[#F0EBE5] rounded-full text-[#999]">{{ members.length }}人</view>
      </view>
    </view>

    <!-- 搜索栏 -->
    <view class="px-4 py-3 border-b border-[#E8E0D5]">
      <view class="relative">
        <text class="absolute left-3 top-1/2 -translate-y-1/2 text-[#999]" style="font-size:14px">🔍</text>
        <input v-model="searchKeyword" placeholder="搜索成员姓名或擅长领域"
          class="w-full h-10 pl-9 pr-4 rounded-lg bg-[#F5F1EB]/30 border-0 text-sm text-[#2C2C2C] placeholder:text-[#999] box-border" />
      </view>
    </view>

    <!-- 统计卡片 -->
    <view class="px-4 py-3">
      <view class="grid grid-cols-3 gap-2">
        <view class="text-center p-3 rounded-xl bg-blue-50">
          <text class="text-lg font-bold text-blue-500 block">{{ members.length }}</text>
          <text class="text-[10px] text-[#999]">总成员</text>
        </view>
        <view class="text-center p-3 rounded-xl bg-purple-50">
          <text class="text-lg font-bold text-purple-500 block">{{ leadership }}</text>
          <text class="text-[10px] text-[#999]">管理层</text>
        </view>
        <view class="text-center p-3 rounded-xl bg-green-50">
          <text class="text-lg font-bold text-green-500 block">{{ teacherCount }}</text>
          <text class="text-[10px] text-[#999]">人才库</text>
        </view>
      </view>
    </view>

    <!-- 筛选Tab -->
    <view class="px-4 py-2 flex gap-2">
      <view v-for="opt in filterOptions" :key="opt.id" @click="activeFilter=opt.id"
        :class="'px-3 py-1.5 rounded-full text-xs transition-colors ' + (activeFilter===opt.id?'bg-[#C41E3A] text-white':'bg-[#F0EBE5] text-[#2C2C2C]')">
        <text>{{ opt.label }}</text>
      </view>
    </view>

    <!-- 骨架屏 -->
    <view v-if="loading" class="px-4 py-3">
      <view v-for="i in 3" :key="i" class="bg-white border border-[#E8E0D5] rounded-xl p-3 mb-3">
        <view class="flex gap-3">
          <view class="w-14 h-14 rounded-full bg-[#F0EBE5]" />
          <view class="flex-1">
            <view class="h-4 w-28 bg-[#F0EBE5] rounded mb-2" />
            <view class="h-3 w-40 bg-[#F0EBE5] rounded mb-2" />
            <view class="h-3 w-24 bg-[#F0EBE5] rounded" />
          </view>
        </view>
      </view>
    </view>

    <!-- 成员列表 -->
    <scroll-view v-else scroll-y class="px-4 py-3 pb-24">
      <view v-for="m in filteredMembers" :key="m.id" class="bg-white border border-[#E8E0D5] rounded-xl p-3 mb-3" @click="goMemberDetail(m.id)">
        <view class="flex gap-3">
          <!-- 头像 -->
          <view class="relative flex-shrink-0">
            <view class="w-14 h-14 rounded-full flex items-center justify-center text-lg font-bold" :class="roleConfig[m.role].bgClass + ' ' + roleConfig[m.role].colorClass">
              <text>{{ m.name[0] }}</text>
            </view>
          </view>
          <!-- 信息 -->
          <view class="flex-1 min-w-0">
            <view class="flex items-center gap-2 flex-wrap">
              <text class="font-medium text-[#2C2C2C]">{{ m.name }}</text>
              <text :class="'text-[10px] px-1.5 py-0 rounded ' + roleConfig[m.role].badgeClass">{{ roleConfig[m.role].label }}</text>
              <text v-if="m.isOnlineTeacher" class="text-[10px] px-1.5 py-0 bg-green-50 text-green-600 rounded">人才库</text>
            </view>
            <text class="text-xs text-[#999] block mt-0.5">擅长：{{ m.field }}</text>
            <view class="flex items-center gap-3 mt-1.5 text-[10px] text-[#999]">
              <text>分享{{ m.contributions }}次</text>
              <text v-if="m.location">{{ m.location }}</text>
            </view>
          </view>
          <text class="text-[#999] self-center flex-shrink-0" style="font-size:16px">❯</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>
<script setup lang="ts">
import {ref,computed,onMounted} from 'vue'

const loading = ref(true)

onMounted(() => {
  setTimeout(() => { loading.value = false }, 500)
})

type MemberRole='chairman'|'secretary'|'vice_chairman'|'member'

const members=[
  {id:1,name:'张道玄',role:'chairman' as MemberRole,field:'八字命理',contributions:48,isOnlineTeacher:true,location:'北京'},
  {id:2,name:'李易安',role:'secretary' as MemberRole,field:'紫微斗数',contributions:36,isOnlineTeacher:true,location:'上海'},
  {id:3,name:'王明德',role:'vice_chairman' as MemberRole,field:'风水堪舆',contributions:28,isOnlineTeacher:true,location:'广州'},
  {id:4,name:'陈太极',role:'member' as MemberRole,field:'易经占卜',contributions:18,isOnlineTeacher:false,location:'成都'},
]

const roleConfig:Record<MemberRole,{label:string;colorClass:string;bgClass:string;badgeClass:string;order:number}>={
  chairman:{label:'主席',colorClass:'text-amber-600',bgClass:'bg-amber-50',badgeClass:'bg-amber-50 text-amber-600',order:1},
  secretary:{label:'秘书长',colorClass:'text-purple-600',bgClass:'bg-purple-50',badgeClass:'bg-purple-50 text-purple-600',order:2},
  vice_chairman:{label:'副主席',colorClass:'text-blue-600',bgClass:'bg-blue-50',badgeClass:'bg-blue-50 text-blue-600',order:3},
  member:{label:'成员',colorClass:'text-gray-600',bgClass:'bg-gray-50',badgeClass:'bg-gray-100 text-gray-500',order:4},
}

const searchKeyword=ref('')
const activeFilter=ref('all')

const filterOptions=[
  {id:'all',label:'全部'},
  {id:'chairman',label:'主席团'},
  {id:'teacher',label:'人才库'},
]

const leadership=computed(()=>members.filter(m=>m.role!=='member').length)
const teacherCount=computed(()=>members.filter(m=>m.isOnlineTeacher).length)

const filteredMembers=computed(()=>{
  let filtered=members.filter(m=>{
    if(activeFilter.value==='chairman') return m.role==='chairman'||m.role==='secretary'||m.role==='vice_chairman'
    if(activeFilter.value==='teacher') return m.isOnlineTeacher
    return true
  })
  if(searchKeyword.value){
    filtered=filtered.filter(m=>m.name.includes(searchKeyword.value)||m.field.includes(searchKeyword.value))
  }
  return filtered.sort((a,b)=>roleConfig[a.role].order-roleConfig[b.role].order)
})

function goBack(){uni.navigateBack()}
function goMemberDetail(id:number){uni.navigateTo({url:'/pages/institute/member/detail?id='+id})}
</script>
