<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-40 bg-[#FAF8F5]/95 backdrop-blur-lg border-b border-[#E8E0D5]" style="padding-top:env(safe-area-inset-top)">
      <view class="flex items-center justify-between px-4 h-14">
        <view class="p-2 -ml-2" @click="goBack">
          <text>←</text>
        </view>
        <text class="font-semibold text-base text-[#2C2C2C]">权限申请演示</text>
        <view class="w-9" />
      </view>
    </view>

    <!-- 全屏引导页模式 -->
    <template v-if="showFullPage">
      <view class="flex flex-col items-center justify-center min-h-[80vh] px-8 text-center">
        <view class="w-24 h-24 rounded-full bg-[#C41E3A]/10 flex items-center justify-center mb-6">
          <text class="text-4xl">{{ fullPageIcon }}</text>
        </view>
        <text class="text-xl font-bold text-[#2C2C2C] mb-2">{{ fullPageLabel }}申请</text>
        <text class="text-sm text-[#999] mb-8">
          为了提供更好的服务，我们需要获取{{ fullPageLabel }}。请在系统弹窗中选择"允许"。
        </text>
        <view class="w-full py-4 bg-[#C41E3A] text-white text-sm font-medium rounded-2xl text-center mb-3" hover-class="hover-primary" @click="handleFullPageAllow">
          <text>允许权限</text>
        </view>
        <view class="py-3 text-sm text-[#999]" @click="showFullPage = false">
          <text>暂不开启</text>
        </view>
      </view>
    </template>

    <!-- 正常演示页面 -->
    <template v-else>
      <view class="p-4 space-y-4">
        <text class="text-sm text-[#999] mb-4 block">
          点击下方按钮查看不同权限类型的引导弹窗效果
        </text>

        <!-- 半屏弹窗演示 -->
        <view class="p-4 bg-white rounded-xl border border-[#E8E0D5]">
          <text class="font-medium text-sm text-[#2C2C2C] mb-3 block">半屏弹窗模式</text>
          <view class="grid grid-cols-2 gap-3">
            <view
              v-for="p in permissions"
              :key="p.type"
              class="flex items-center gap-2 p-3 bg-[#F5F1EB]/50 rounded-xl"
              hover-class="hover-secondary"
              @click="openPermissionModal(p.type, false)"
            >
              <text class="text-lg">{{ p.icon }}</text>
              <text class="text-sm text-[#2C2C2C]">{{ p.label }}</text>
            </view>
          </view>
        </view>

        <!-- 已拒绝状态演示 -->
        <view class="p-4 bg-white rounded-xl border border-[#E8E0D5]">
          <text class="font-medium text-sm text-[#2C2C2C] mb-3 block">已拒绝状态</text>
          <view
            class="w-full flex items-center gap-2 p-3 bg-red-500/10 rounded-xl"
            hover-class="hover-red"
            @click="openPermissionModal('camera', true)"
          >
            <text class="text-red-500">📷</text>
            <text class="text-sm text-[#2C2C2C]">相机权限（已拒绝）</text>
          </view>
        </view>

        <!-- 全屏引导页演示 -->
        <view class="p-4 bg-white rounded-xl border border-[#E8E0D5]">
          <text class="font-medium text-sm text-[#2C2C2C] mb-3 block">全屏引导页模式</text>
          <view class="grid grid-cols-2 gap-3">
            <view
              v-for="p in permissions.slice(0, 2)"
              :key="p.type"
              class="flex items-center gap-2 p-3 bg-[#C9A96E]/10 rounded-xl"
              hover-class="hover-accent"
              @click="openFullPage(p.type)"
            >
              <text class="text-lg">{{ p.icon }}</text>
              <text class="text-sm text-[#2C2C2C]">{{ p.label }}</text>
            </view>
          </view>
        </view>
      </view>
    </template>

    <!-- 权限弹窗（半屏模拟） -->
    <view v-if="activeModal" class="fixed inset-0 z-50 flex items-end">
      <view class="absolute inset-0 bg-black/40" @click="activeModal = null" />
      <view class="relative w-full bg-white rounded-t-3xl px-6 pt-6 pb-8">
        <view class="w-10 h-1 bg-[#E8E0D5] rounded-full mx-auto mb-6" />
        <view class="text-center mb-6">
          <text class="text-4xl mb-3 block">{{ activePermIcon }}</text>
          <text class="text-lg font-bold text-[#2C2C2C] block">需要{{ activePermLabel }}权限</text>
          <text class="text-sm text-[#999] mt-2 block">
            {{ isDenied ? '您之前拒绝了此权限，请前往系统设置手动开启' : '为了提供更好的服务，请允许我们获取此权限' }}
          </text>
        </view>
        <view
          class="w-full py-4 bg-[#C41E3A] text-white text-sm font-medium rounded-2xl text-center mb-3"
          hover-class="hover-primary"
          @click="handlePermissionAllow"
        >
          <text>{{ isDenied ? '前往设置' : '允许' }}</text>
        </view>
        <view v-if="!isDenied" class="py-3 text-sm text-[#999] text-center" hover-class="hover-secondary-text" @click="handlePermissionDeny">
          <text>暂不开启</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

function goBack() { uni.navigateBack() }

const permissions = [
  { type: 'camera', icon: '📷', label: '相机权限', color: 'text-blue-500' },
  { type: 'microphone', icon: '🎤', label: '麦克风权限', color: 'text-green-500' },
  { type: 'photos', icon: '🖼', label: '相册权限', color: 'text-purple-500' },
  { type: 'location', icon: '📍', label: '位置权限', color: 'text-orange-500' },
  { type: 'notification', icon: '🔔', label: '通知权限', color: 'text-red-500' },
]

const activeModal = ref<string | null>(null)
const isDenied = ref(false)
const showFullPage = ref(false)
const fullPageType = ref('camera')

const activePerm = computed(() => permissions.find((p) => p.type === activeModal.value))
const activePermIcon = computed(() => activePerm.value?.icon || '')
const activePermLabel = computed(() => activePerm.value?.label || '')

const fullPagePerm = computed(() => permissions.find((p) => p.type === fullPageType.value))
const fullPageIcon = computed(() => fullPagePerm.value?.icon || '')
const fullPageLabel = computed(() => fullPagePerm.value?.label || '')

function openPermissionModal(type: string, denied: boolean) {
  isDenied.value = denied
  activeModal.value = type
}

function openFullPage(type: string) {
  fullPageType.value = type
  showFullPage.value = true
}

function handlePermissionAllow() {
  uni.showToast({ title: '权限已开启', icon: 'success' })
  activeModal.value = null
}

function handlePermissionDeny() {
  uni.showToast({ title: '已暂时跳过，部分功能将受限', icon: 'none' })
  activeModal.value = null
}

function handleFullPageAllow() {
  uni.showToast({ title: '权限已开启', icon: 'success' })
  showFullPage.value = false
}
</script>

<style scoped>
.hover-primary {
  opacity: 0.9;
}
.hover-secondary {
  background-color: #F5F1EB;
}
.hover-secondary-text {
  opacity: 0.7;
}
.hover-red {
  background-color: rgba(239, 68, 68, 0.2);
}
.hover-accent {
  background-color: rgba(201, 169, 110, 0.2);
}
</style>
