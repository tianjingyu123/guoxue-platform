      </view>
    </view>

    <!-- 名额记录 -->
    <view v-if="activeTab === 'quota'" class="px-4 mt-4 space-y-3">
      <view v-for="record in quotaRecords" :key="record.id" class="bg-white rounded-xl p-4 border border-[#E8E0D5]">
        <view class="flex items-center gap-3">
          <view :class="['w-10 h-10 rounded-xl flex items-center justify-center', record.type === 'self' ? 'bg-[#C41E3A]/10' : 'bg-yellow-50']">
