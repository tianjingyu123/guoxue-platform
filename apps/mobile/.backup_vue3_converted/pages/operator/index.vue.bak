            <text class="text-sm font-bold text-green-600 block">¥{{ member.earnings }}</text>
            <text class="text-[10px] text-[#999]">产生收益</text>
          </view>
          <view class="text-center">
            <text class="text-sm font-bold text-[#C41E3A] block">¥{{ member.myBonus }}</text>
            <text class="text-[10px] text-[#999]">我的奖励</text>
          </view>
        </view>
      </view>
      <view v-if="operatorData.quota.available > 0" @click="goInvite" class="bg-white rounded-xl p-4 border-2 border-dashed border-[#C41E3A]/30 bg-[#C41E3A]/5 flex items-center justify-center gap-2 text-[#C41E3A]">
        <text class="text-lg">＋</text>
