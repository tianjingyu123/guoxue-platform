        <view @click="activeTab = 'quota'" :class="['flex-1 py-2 text-center text-sm font-medium rounded-md', activeTab === 'quota' ? 'bg-white text-[#2C2C2C] shadow-sm' : 'text-[#999]']">名额记录</view>
