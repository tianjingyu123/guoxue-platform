<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <!-- 骨架屏 -->
    <view v-if="loading" class="flex-1 flex flex-col items-center justify-center px-8">
      <view class="w-20 h-20 rounded-full bg-[#F0EBE5] animate-pulse mb-6" />
      <view class="w-40 h-6 bg-[#F0EBE5] animate-pulse rounded mb-3" />
      <view class="w-56 h-4 bg-[#F0EBE5] animate-pulse rounded mb-10" />
      <view class="w-full h-12 bg-[#F0EBE5] animate-pulse rounded-xl mb-3" />
      <view class="w-full h-12 bg-[#F0EBE5] animate-pulse rounded-xl mb-3" />
      <view class="w-full h-12 bg-[#F0EBE5] animate-pulse rounded-xl mb-6" />
      <view class="w-32 h-4 bg-[#F0EBE5] animate-pulse rounded" />
    </view>

    <!-- 主内容 -->
    <scroll-view v-else scroll-y class="flex-1">
      <!-- 装饰顶栏 -->
      <view class="h-24 bg-gradient-to-b from-[#C41E3A] to-[#C41E3A]/0 absolute top-0 left-0 right-0 z-0" />

      <view class="relative z-10 flex flex-col items-center px-8 pt-14 pb-8">
        <!-- Logo -->
        <view class="w-20 h-20 rounded-full bg-gradient-to-br from-[#C41E3A] to-[#E74C3C] flex items-center justify-center mb-5 shadow-lg" style="box-shadow: 0 4px 20px rgba(196,30,58,0.3)">
          <text class="text-3xl text-white">儒</text>
        </view>
        <text class="text-2xl font-bold text-[#2C2C2C] mb-1" style="font-family: 'STKaiti', serif;">热卜国学</text>
        <text class="text-sm text-[#999] mb-2">传承国学智慧 · 通达人生之道</text>

        <!-- 活动提示轮播 -->
        <view class="bg-[#C41E3A]/5 rounded-full px-4 py-1.5 mb-8 border border-[#C41E3A]/10">
          <text class="text-xs text-[#C41E3A]">🎉 {{ hotTips[currentTipIndex] }}</text>
        </view>

        <!-- 手机号登录表单 -->
        <view class="w-full mb-6">
          <view class="bg-white rounded-xl px-4 py-3 mb-3 flex items-center gap-3 border border-[#E8E0D5]">
            <text class="text-lg">📱</text>
            <input v-model="phone" type="text" maxlength="11" placeholder="请输入手机号" class="flex-1 text-sm text-[#2C2C2C] outline-none" />
          </view>
          <view class="bg-white rounded-xl px-4 py-3 mb-4 flex items-center gap-3 border border-[#E8E0D5]">
            <text class="text-lg">🔐</text>
            <input v-model="password" type="password" placeholder="请输入密码" class="flex-1 text-sm text-[#2C2C2C] outline-none" />
            <text class="text-xs text-[#999] whitespace-nowrap" @click="goForgetPwd">忘记密码?</text>
          </view>

          <!-- 登录按钮 -->
          <view class="w-full py-3 bg-gradient-to-r from-[#C41E3A] to-[#E74C3C] rounded-xl text-center shadow-md" style="box-shadow: 0 4px 12px rgba(196,30,58,0.25)" @click="handleLogin">
            <text class="text-white text-base font-semibold">登 录</text>
          </view>
        </view>

        <!-- 分隔线 -->
        <view class="w-full flex items-center gap-3 mb-6">
          <view class="flex-1 h-px bg-[#E8E0D5]" />
          <text class="text-xs text-[#999]">其他方式</text>
          <view class="flex-1 h-px bg-[#E8E0D5]" />
        </view>

        <!-- 第三方登录 -->
        <view class="flex items-center justify-center gap-8 mb-8">
          <view class="flex flex-col items-center gap-1.5" @click="wechatLogin">
            <view class="w-12 h-12 rounded-full bg-[#07C160] flex items-center justify-center shadow-sm">
              <text class="text-2xl text-white">💚</text>
            </view>
            <text class="text-xs text-[#999]">微信登录</text>
          </view>
          <view class="flex flex-col items-center gap-1.5" @click="smsLogin">
            <view class="w-12 h-12 rounded-full bg-[#C9A96E] flex items-center justify-center shadow-sm">
              <text class="text-2xl text-white">📱</text>
            </view>
            <text class="text-xs text-[#999]">短信验证码</text>
          </view>
          <view class="flex flex-col items-center gap-1.5" @click="register">
            <view class="w-12 h-12 rounded-full bg-[#F0EBE5] flex items-center justify-center shadow-sm">
              <text class="text-2xl text-[#2C2C2C]">✚</text>
            </view>
            <text class="text-xs text-[#999]">注册账号</text>
          </view>
        </view>

        <!-- 协议勾选 -->
        <view class="flex items-start gap-2 mb-6 px-2" @click="agree = !agree">
          <view :class="['w-4 h-4 rounded border mt-0.5 flex items-center justify-center shrink-0', agree ? 'bg-[#C41E3A] border-[#C41E3A]' : 'border-[#ccc]']">
            <text v-if="agree" class="text-white text-[10px]">✓</text>
          </view>
          <text class="text-xs text-[#999] leading-relaxed">
            登录即表示同意<text class="text-[#C41E3A]" @click.stop="goAgreement('user')">《用户协议》</text>和<text class="text-[#C41E3A]" @click.stop="goAgreement('privacy')">《隐私政策》</text>
          </text>
        </view>

        <!-- 快捷登录提示 -->
        <view class="flex items-center gap-2 mt-6 mb-3 w-full">
          <view class="flex-1 h-px bg-[#E8E0D5]" />
          <text class="text-xs text-[#999]">或使用验证码</text>
          <view class="flex-1 h-px bg-[#E8E0D5]" />
        </view>

        <!-- 验证码登录入口 -->
        <view class="bg-white rounded-xl px-4 py-3 mb-4 flex items-center gap-3 border border-[#E8E0D5]">
          <text class="text-lg">✉️</text>
          <input v-model="smsPhone" type="text" maxlength="11" placeholder="手机号快速登录" class="flex-1 text-sm text-[#2C2C2C] outline-none" />
          <view class="px-3 py-1.5 bg-[#C9A96E] rounded-lg" @click="sendSmsCode">
            <text class="text-xs text-white">{{ smsCountdown > 0 ? smsCountdown + 's' : '获取验证码' }}</text>
          </view>
        </view>

        <!-- 游客模式 -->
        <view class="border border-[#E8E0D5] rounded-xl py-3 w-full text-center" @click="enterAsGuest">
          <text class="text-sm text-[#999]">› 先逛逛 · 游客模式</text>
        </view>

        <!-- 底部品牌说明 -->
        <view class="mt-6 text-center">
          <text class="text-xs text-[#ccc]">热卜国学 v2.1.0</text>
        </view>

        <!-- 其他入口 -->
        <view class="flex items-center justify-center gap-6 mt-3">
          <text class="text-xs text-[#999]" @click="goHelp">🆘 帮助</text>
          <text class="text-xs text-[#ccc]">|</text>
          <text class="text-xs text-[#999]" @click="goAgreement('privacy')">🔒 隐私</text>
          <text class="text-xs text-[#ccc]">|</text>
          <text class="text-xs text-[#999]" @click="goService">💬 客服</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'

const loading = ref(true)
const phone = ref('')
const password = ref('')
const smsPhone = ref('')
const agree = ref(true)
const smsCountdown = ref(0)
let smsTimer: ReturnType<typeof setInterval> | null = null

// 热门活动轮播文案
const hotTips = ref([
  '注册即送100积分',
  '邀请好友得50元券',
  '每日签到领福利',
  '新用户首单8折',
])

const currentTipIndex = ref(0)

onMounted(() => {
  setTimeout(() => { loading.value = false }, 1200)
  // 轮播提示
  setInterval(() => {
    currentTipIndex.value = (currentTipIndex.value + 1) % hotTips.value.length
  }, 3000)
})

onMounted(() => {
  setTimeout(() => { loading.value = false }, 1200)
})

function goBack() { uni.navigateBack() }

function goHelp() { uni.navigateTo({ url: '/pages/help/index' }) }
function goService() { uni.navigateTo({ url: '/pages/im/chat/index' }) }

function sendSmsCode() {
  if (!smsPhone.value || smsPhone.value.length !== 11) {
    uni.showToast({ title: '请输入正确的手机号', icon: 'none' })
    return
  }
  smsCountdown.value = 60
  smsTimer = setInterval(() => {
    smsCountdown.value--
    if (smsCountdown.value <= 0 && smsTimer) {
      clearInterval(smsTimer)
      smsTimer = null
    }
  }, 1000)
  uni.showToast({ title: '验证码已发送(Mock)', icon: 'none' })
}

function handleLogin() {
  if (!phone.value) { uni.showToast({ title: '请输入手机号', icon: 'none' }); return }
  if (!password.value) { uni.showToast({ title: '请输入密码', icon: 'none' }); return }
  if (!agree.value) { uni.showToast({ title: '请先同意用户协议', icon: 'none' }); return }
  uni.showLoading({ title: '登录中...' })
  setTimeout(() => {
    uni.hideLoading()
    uni.showToast({ title: '登录成功(Mock)', icon: 'success' })
    uni.switchTab({ url: '/pages/index/index' })
  }, 1500)
}

function wechatLogin() {
  uni.showToast({ title: '微信登录(Mock)', icon: 'none' })
}

function smsLogin() {
  uni.navigateTo({ url: '/pages/auth/sms-login/index' })
}

function register() {
  uni.navigateTo({ url: '/pages/auth/register/index' })
}

function goForgetPwd() {
  uni.navigateTo({ url: '/pages/auth/forget-password/index' })
}

function goAgreement(type: string) {
  uni.navigateTo({ url: `/pages/agreement/${type}/index` })
}

function enterAsGuest() {
  uni.showToast({ title: '游客模式(Mock)', icon: 'none' })
  uni.switchTab({ url: '/pages/index/index' })
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
