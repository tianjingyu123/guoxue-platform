<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5] flex items-center px-4 h-12 gap-3">
      <view @click="goBack">
        <text class="text-xl text-[#2C2C2C] leading-none">←</text>
      </view>
      <text class="text-base font-semibold text-[#2C2C2C]">邮箱找回密码</text>
    </view>

    <!-- 加载骨架屏 -->
    <view v-if="loading" class="px-6 pt-8">
      <view class="flex justify-center mb-6">
        <view class="w-16 h-16 rounded-full bg-[#F0EBE5] animate-pulse" />
      </view>
      <view class="h-5 w-32 bg-[#F0EBE5] rounded mx-auto mb-2 animate-pulse" />
      <view class="h-4 w-48 bg-[#F0EBE5] rounded mx-auto mb-8 animate-pulse" />
      <view class="space-y-4">
        <view class="h-4 w-20 bg-[#F0EBE5] rounded animate-pulse" />
        <view class="h-10 w-full bg-[#F0EBE5] rounded-lg animate-pulse" />
        <view class="h-4 w-20 bg-[#F0EBE5] rounded animate-pulse" />
        <view class="h-10 w-full bg-[#F0EBE5] rounded-lg animate-pulse" />
        <view class="h-11 w-full bg-[#F0EBE5] rounded-lg animate-pulse" />
      </view>
    </view>

    <!-- 步骤指示器 -->
    <view v-else class="px-6 pt-6">
      <view class="flex items-center justify-center mb-8">
        <view v-for="(step, index) in steps" :key="step.key" class="flex items-center">
          <view class="flex flex-col items-center">
            <view
              class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold transition-all duration-300"
              :class="currentStep >= index ? 'bg-[#C41E3A] text-white' : 'bg-[#F0EBE5] text-[#999]'"
            >
              <text v-if="currentStep > index">✓</text>
              <text v-else>{{ index + 1 }}</text>
            </view>
            <text
              class="text-[10px] mt-1 whitespace-nowrap transition-colors duration-300"
              :class="currentStep >= index ? 'text-[#C41E3A] font-medium' : 'text-[#999]'"
            >{{ step.label }}</text>
          </view>
          <view
            v-if="index < steps.length - 1"
            class="w-12 h-[2px] mx-1 mt-[-18px] transition-colors duration-300"
            :class="currentStep > index ? 'bg-[#C41E3A]' : 'bg-[#F0EBE5]'"
          />
        </view>
      </view>

      <!-- 步骤1: 输入邮箱 -->
      <view v-if="currentStep === 0">
        <view class="flex justify-center mb-6">
          <view class="w-16 h-16 rounded-full bg-[#C41E3A]/10 flex items-center justify-center">
            <text class="text-3xl">📧</text>
          </view>
        </view>
        <text class="text-xl font-bold text-[#2C2C2C] text-center block mb-2">验证您的邮箱</text>
        <text class="text-sm text-[#999] text-center block mb-8">输入注册邮箱并完成验证</text>

        <view class="space-y-4">
          <view>
            <label class="text-sm font-medium text-[#2C2C2C] mb-1.5 block">邮箱地址</label>
            <input
              class="w-full h-10 px-3 py-2 text-sm bg-[#FAF8F5] border border-[#E8E0D5] rounded-lg box-border placeholder:text-[#999] focus:border-[#C41E3A] focus:outline-none"
              v-model="email"
              type="text"
              placeholder="请输入注册邮箱"
              @input="validateEmail"
            />
            <text v-if="emailError" class="text-xs text-[#FF4D4F] mt-1 block">{{ emailError }}</text>
          </view>

          <view
            class="w-full h-11 rounded-lg flex items-center justify-center text-base font-semibold transition-colors"
            :class="email && !emailError
              ? 'bg-[#C41E3A] text-white'
              : 'bg-[#F0EBE5] text-[#999] cursor-not-allowed'"
            @click="sendCode"
          >
            <text>发送验证邮件</text>
          </view>
        </view>
      </view>

      <!-- 步骤2: 输入验证码 -->
      <view v-if="currentStep === 1">
        <view class="flex justify-center mb-6">
          <view class="w-16 h-16 rounded-full bg-[#C41E3A]/10 flex items-center justify-center">
            <text class="text-3xl">🔐</text>
          </view>
        </view>
        <text class="text-xl font-bold text-[#2C2C2C] text-center block mb-2">验证邮箱</text>
        <text class="text-sm text-[#999] text-center block mb-2">验证码已发送至 {{ email }}</text>
        <text class="text-xs text-[#C9A96E] text-center block mb-8">请检查收件箱和垃圾邮件</text>

        <view class="space-y-4">
          <view>
            <label class="text-sm font-medium text-[#2C2C2C] mb-1.5 block">验证码</label>
            <view class="flex gap-2">
              <input
                class="flex-1 h-10 px-3 py-2 text-sm bg-[#FAF8F5] border border-[#E8E0D5] rounded-lg box-border placeholder:text-[#999] focus:border-[#C41E3A] focus:outline-none"
                v-model="code"
                type="digit"
                placeholder="6位验证码"
                maxlength="6"
              />
              <view
                class="flex-shrink-0 h-10 px-4 rounded-lg flex items-center justify-center text-sm font-medium transition-colors"
                :class="cd > 0
                  ? 'bg-[#F0EBE5] text-[#999] cursor-not-allowed'
                  : 'bg-[#C41E3A] text-white'"
                @click="resendCode"
              >
                <text>{{ cd > 0 ? cd + 's后重发' : '重新发送' }}</text>
              </view>
            </view>
            <text class="text-xs text-[#999] mt-1 block">验证码有效期为15分钟</text>
          </view>

          <view
            class="w-full h-11 rounded-lg flex items-center justify-center text-base font-semibold transition-colors"
            :class="code.length === 6
              ? 'bg-[#C41E3A] text-white'
              : 'bg-[#F0EBE5] text-[#999] cursor-not-allowed'"
            @click="verifyCode"
          >
            <text>验证</text>
          </view>

          <view class="flex justify-center">
            <text class="text-xs text-[#999]" @click="currentStep = 0">← 返回修改邮箱</text>
          </view>
        </view>
      </view>

      <!-- 步骤3: 设置新密码 -->
      <view v-if="currentStep === 2">
        <view class="flex justify-center mb-6">
          <view class="w-16 h-16 rounded-full bg-[#C41E3A]/10 flex items-center justify-center">
            <text class="text-3xl">🔑</text>
          </view>
        </view>
        <text class="text-xl font-bold text-[#2C2C2C] text-center block mb-2">设置新密码</text>
        <text class="text-sm text-[#999] text-center block mb-8">请输入您的新登录密码</text>

        <view class="space-y-4">
          <view>
            <label class="text-sm font-medium text-[#2C2C2C] mb-1.5 block">新密码</label>
            <input
              class="w-full h-10 px-3 py-2 text-sm bg-[#FAF8F5] border border-[#E8E0D5] rounded-lg box-border placeholder:text-[#999] focus:border-[#C41E3A] focus:outline-none"
              v-model="newPassword"
              type="password"
              placeholder="请设置8-20位新密码"
            />
            <text v-if="passwordStrength" class="text-xs mt-1 block" :class="passwordStrengthColor">{{ passwordStrength }}</text>
          </view>
          <view>
            <label class="text-sm font-medium text-[#2C2C2C] mb-1.5 block">确认密码</label>
            <input
              class="w-full h-10 px-3 py-2 text-sm bg-[#FAF8F5] border border-[#E8E0D5] rounded-lg box-border placeholder:text-[#999] focus:border-[#C41E3A] focus:outline-none"
              v-model="confirmPassword"
              type="password"
              placeholder="请再次输入新密码"
            />
            <text v-if="confirmError" class="text-xs text-[#FF4D4F] mt-1 block">{{ confirmError }}</text>
          </view>

          <view
            class="w-full h-11 rounded-lg flex items-center justify-center text-base font-semibold transition-colors"
            :class="canReset
              ? 'bg-[#C41E3A] text-white'
              : 'bg-[#F0EBE5] text-[#999] cursor-not-allowed'"
            @click="resetPassword"
          >
            <text>重置密码</text>
          </view>
        </view>
      </view>

      <!-- 步骤4: 完成 -->
      <view v-if="currentStep === 3">
        <view class="flex flex-col items-center pt-8">
          <view class="w-20 h-20 rounded-full bg-green-50 border-4 border-green-200 flex items-center justify-center mb-6 animate-bounce">
            <text class="text-4xl">✅</text>
          </view>
          <text class="text-2xl font-bold text-[#2C2C2C] mb-2">密码重置成功</text>
          <text class="text-sm text-[#999] text-center mb-8">请使用新密码登录您的账号</text>

          <view class="w-full space-y-3">
            <view
              class="w-full h-11 rounded-lg bg-[#C41E3A] text-white flex items-center justify-center text-base font-semibold"
              @click="goToLogin"
            >
              <text>立即登录</text>
            </view>
            <view
              class="w-full h-11 rounded-lg border border-[#E8E0D5] text-[#2C2C2C] flex items-center justify-center text-sm"
              @click="goBack"
            >
              <text>返回首页</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 发送成功提示 -->
    <view v-if="showSentToast" class="fixed top-16 left-4 right-4 z-50 bg-white rounded-xl shadow-lg border border-[#E8E0D5] p-4 flex items-start gap-3 animate-slide-down">
      <text class="text-green-500 text-lg flex-shrink-0">📤</text>
      <view class="flex-1">
        <text class="text-sm font-medium text-[#2C2C2C] block">邮件已发送</text>
        <text class="text-xs text-[#999] mt-0.5 block">验证邮件已发送至 {{ email }}，请查看并按指引操作</text>
      </view>
      <text class="text-[#999] text-sm flex-shrink-0" @click="showSentToast = false">✕</text>
    </view>

    <!-- 底部安全区 -->
    <view class="h-8" />
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'

interface Step {
  key: string
  label: string
}

const steps: Step[] = [
  { key: 'email', label: '输入邮箱' },
  { key: 'verify', label: '验证邮箱' },
  { key: 'password', label: '设置密码' },
  { key: 'done', label: '完成' },
]

// 加载状态
const loading = ref(true)
setTimeout(() => { loading.value = false }, 800)

// 表单数据
const email = ref('')
const code = ref('')
const newPassword = ref('')
const confirmPassword = ref('')
const currentStep = ref(0)
const cd = ref(0)
const showSentToast = ref(false)
const emailError = ref('')

// 密码验证
const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
function validateEmail() {
  if (!email.value) {
    emailError.value = ''
    return
  }
  emailError.value = emailRegex.test(email.value) ? '' : '请输入有效的邮箱地址'
}

const passwordStrength = computed(() => {
  const pwd = newPassword.value
  if (!pwd) return ''
  if (pwd.length < 8) return '密码长度至少8位'
  if (/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!@#$%])/.test(pwd)) return '强密码'
  if (/^(?=.*[a-zA-Z])(?=.*\d)/.test(pwd)) return '中等级别'
  return '弱密码，建议包含字母和数字'
})

const passwordStrengthColor = computed(() => {
  const s = passwordStrength.value
  if (s === '强密码') return 'text-green-500'
  if (s === '中等级别') return 'text-[#C9A96E]'
  if (s) return 'text-[#FF4D4F]'
  return ''
})

const confirmError = computed(() => {
  if (!confirmPassword.value) return ''
  return confirmPassword.value === newPassword.value ? '' : '两次输入的密码不一致'
})

const canReset = computed(() => {
  return newPassword.value.length >= 8 && confirmPassword.value === newPassword.value
})

// 发送验证码
function sendCode() {
  if (!email.value || emailError.value) return
  uni.showToast({ title: '发送中...', icon: 'loading' })
  setTimeout(() => {
    currentStep.value = 1
    showSentToast.value = true
    setTimeout(() => { showSentToast.value = false }, 4000)
    startCountdown()
  }, 1000)
}

function resendCode() {
  if (cd.value > 0) return
  uni.showToast({ title: '已重新发送', icon: 'success' })
  startCountdown()
}

function startCountdown() {
  cd.value = 60
  const t = setInterval(() => {
    cd.value--
    if (cd.value <= 0) clearInterval(t)
  }, 1000)
}

// 验证码验证
function verifyCode() {
  if (code.value.length !== 6) {
    uni.showToast({ title: '请输入6位验证码', icon: 'none' })
    return
  }
  uni.showToast({ title: '验证成功', icon: 'success' })
  setTimeout(() => { currentStep.value = 2 }, 500)
}

// 重置密码
function resetPassword() {
  if (!canReset.value) return
  if (newPassword.value !== confirmPassword.value) return
  uni.showToast({ title: '密码重置中...', icon: 'loading' })
  setTimeout(() => {
    currentStep.value = 3
  }, 1200)
}

function goToLogin() {
  uni.showToast({ title: '跳转登录页', icon: 'none' })
  setTimeout(() => uni.navigateBack(), 500)
}

function goBack() { uni.navigateBack() }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
@keyframes slide-down {
  from { transform: translateY(-20px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
.animate-slide-down { animation: slide-down 0.3s ease-out; }
</style>
