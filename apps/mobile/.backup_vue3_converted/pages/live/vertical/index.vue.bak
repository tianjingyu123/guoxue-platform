<template>
  <view
    class="fixed inset-0 bg-black"
    @doubletap="handleDoubleTap"
  >
    <!-- 视频背景 -->
    <view class="absolute inset-0">
      <view class="w-full h-full bg-gradient-to-br from-gray-700 to-gray-900" />
      <view class="absolute inset-0 bg-gradient-to-b from-black/50 via-transparent to-black/80" />
    </view>

    <!-- 顶部信息栏 -->
    <view class="absolute top-0 left-0 right-0 z-20 p-4 pt-12">
      <view class="flex items-center justify-between">
        <!-- 主播信息 -->
        <view class="flex items-center gap-2 bg-black/40 backdrop-blur-md rounded-full p-1 pr-3">
          <view class="relative">
            <view class="w-10 h-10 rounded-full overflow-hidden border-2 border-[#C41E3A] bg-[#F5F1EB] flex items-center justify-center">
              <text class="text-sm text-[#666]">{{ mockRoom.hostName[0] }}</text>
            </view>
            <view class="absolute -bottom-0.5 left-1/2 -translate-x-1/2 bg-[#C41E3A] text-white text-[8px] px-1.5 rounded-sm font-medium">
              LIVE
            </view>
          </view>
          <view>
            <view class="flex items-center gap-1">
              <text class="text-white text-sm font-medium">{{ mockRoom.hostName }}</text>
              <view class="flex items-center gap-0.5 bg-gradient-to-r from-amber-500 to-orange-500 rounded-full px-1.5 py-0.5">
                <text class="text-white text-[10px] font-medium">Lv.{{ mockRoom.hostLevel }}</text>
              </view>
            </view>
            <text class="text-white/70 text-xs block">{{ formatCount(mockRoom.followers) }} 粉丝</text>
          </view>
          <view
            @click="isFollowing = !isFollowing"
            :class="['ml-1 px-3 py-1 rounded-full text-xs font-medium transition-all', isFollowing ? 'bg-white/20 text-white/80' : 'bg-[#C41E3A] text-white']"
          >
            <text>{{ isFollowing ? '已关注' : '关注' }}</text>
          </view>
        </view>

        <!-- 右侧：观看人数 + 关闭 -->
        <view class="flex items-center gap-2">
          <view class="flex items-center gap-1 bg-black/40 backdrop-blur-md rounded-full px-3 py-1.5">
            <text class="text-white/70 text-sm">👥</text>
            <text class="text-white text-xs">{{ formatCount(viewerCount) }}</text>
          </view>
          <view @click="goBack" class="w-8 h-8 bg-black/40 backdrop-blur-md rounded-full flex items-center justify-center">
            <text class="text-white text-lg">✕</text>
          </view>
        </view>
      </view>

      <!-- 在线观众头像 -->
      <view class="flex items-center mt-3 gap-1">
        <view v-for="(avatar, i) in mockRoom.onlineAvatars" :key="i" class="w-6 h-6 rounded-full bg-[#F5F1EB] border border-white/40 -ml-1 first:ml-0 flex items-center justify-center">
          <text class="text-[6px] text-[#666]">{{ ['小','李','王'][i] }}</text>
        </view>
        <text class="text-white/60 text-xs ml-1">+{{ formatCount(viewerCount - 3) }}</text>
      </view>
    </view>

    <!-- 礼物动画 -->
    <view v-for="anim in giftAnimations" :key="anim.id" class="absolute left-4 top-1/3 z-30">
      <view class="bg-gradient-to-r from-[#C41E3A]/90 to-[#C9A96E]/90 backdrop-blur-sm rounded-full px-4 py-2 flex items-center gap-3">
        <view class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center text-2xl">
          <text>{{ anim.gift.icon }}</text>
        </view>
        <view>
          <text class="text-white text-sm font-medium block">{{ anim.user }}</text>
          <text class="text-white/80 text-xs block">送出 {{ anim.gift.name }}</text>
        </view>
      </view>
    </view>

    <!-- 飘心动画 -->
    <view class="absolute right-4 bottom-44 w-16 h-32 pointer-events-none z-20">
      <view
        v-for="heart in floatingHearts"
        :key="heart.id"
        class="absolute bottom-0 left-1/2"
        :style="{ transform: 'translateX(' + heart.x + 'px) scale(' + heart.scale + ')', animation: 'floatUp 1.5s ease-out forwards' }"
      >
        <text class="text-3xl text-[#C41E3A]">❤️</text>
      </view>
    </view>

    <!-- 弹幕区域 -->
    <view class="absolute left-4 bottom-44 w-72 z-10">
      <view class="max-h-52 overflow-y-auto space-y-1.5" id="commentsContainer">
        <view v-for="comment in comments" :key="comment.id" class="animate-in slide-in-from-left duration-300" style="animation-duration: 300ms">
          <!-- 系统消息 -->
          <view v-if="comment.type === 'system'" class="inline-block bg-[#C9A96E]/80 backdrop-blur-sm rounded-lg px-2.5 py-1">
            <text class="text-white text-xs">{{ comment.content }}</text>
          </view>
          <!-- 进场消息 -->
          <view v-else-if="comment.type === 'enter'" class="inline-block bg-white/15 backdrop-blur-sm rounded-lg px-2.5 py-1">
            <text class="text-[#C9A96E] text-xs">{{ comment.userName }} </text>
            <text class="text-white/60 text-xs">{{ comment.content }}</text>
          </view>
          <!-- 礼物消息 -->
          <view v-else-if="comment.type === 'gift'" class="inline-block bg-gradient-to-r from-[#C41E3A]/50 to-[#C9A96E]/50 backdrop-blur-sm rounded-lg px-2.5 py-1">
            <text class="text-[#FFD700] text-xs">{{ comment.userName }} </text>
            <text class="text-white text-xs">送出 {{ comment.giftInfo?.icon }} × {{ comment.giftInfo?.count }}</text>
          </view>
          <!-- 普通文本弹幕 -->
          <view v-else class="inline-block bg-black/30 backdrop-blur-sm rounded-lg px-2.5 py-1">
            <text :class="['text-xs', comment.isHost ? 'text-[#C41E3A]' : 'text-[#C9A96E]']">{{ comment.userName }}:</text>
            <text class="text-white text-xs ml-1">{{ comment.content }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 商品浮窗 -->
    <view v-if="currentProduct" @click="showProductDetailPanel(currentProduct)" class="absolute left-4 right-4 bottom-[120px] z-10">
      <view class="bg-black/50 backdrop-blur-md rounded-xl p-2.5 flex items-center gap-3">
        <view class="relative w-12 h-12 rounded-lg overflow-hidden flex-shrink-0 bg-gray-600">
          <view class="absolute inset-0 bg-gradient-to-br from-gray-500 to-gray-700" />
          <view class="absolute top-0 left-0 bg-[#C41E3A] text-white text-[8px] px-1 py-0.5 rounded-br">
            讲解中
          </view>
        </view>
        <view class="flex-1 min-w-0">
          <text class="text-white text-sm line-clamp-1 block">{{ currentProduct.name }}</text>
          <view class="flex items-center gap-2 mt-0.5">
            <text class="text-[#C41E3A] font-bold text-sm">¥{{ currentProduct.price }}</text>
            <text class="text-white/40 text-xs line-through">¥{{ currentProduct.originalPrice }}</text>
          </view>
        </view>
        <view class="bg-[#C41E3A] text-white text-xs px-3 py-1.5 rounded-full font-medium">
          去购买
        </view>
      </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="absolute bottom-0 left-0 right-0 z-20" style="padding-bottom: max(8px, env(safe-area-inset-bottom))">
      <view class="px-4 pb-4 pt-2">
        <view class="flex items-center gap-2">
          <!-- 弹幕输入框 -->
          <view @click="showCommentInput = true" class="flex-1 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2.5 text-white/50 text-sm">
            说点什么...
          </view>

          <!-- 商品列表按钮 -->
          <view @click="showProductList = true" class="relative w-11 h-11 bg-[#C41E3A] rounded-full flex items-center justify-center">
            <text class="text-white text-lg">🛒</text>
            <view class="absolute -top-0.5 -right-0.5 min-w-4 h-4 bg-[#C9A96E] rounded-full flex items-center justify-center px-1">
              <text class="text-white text-[10px] font-bold">{{ mockProducts.length }}</text>
            </view>
          </view>

          <!-- 礼物按钮 -->
          <view @click="showGiftPanel = true" class="w-11 h-11 bg-gradient-to-br from-amber-500 to-orange-500 rounded-full flex items-center justify-center">
            <text class="text-white text-lg">🎁</text>
          </view>

          <!-- 点赞按钮 -->
          <view @click="handleDoubleTap" class="w-11 h-11 bg-white/10 backdrop-blur-sm rounded-full flex items-center justify-center">
            <text class="text-[#C41E3A] text-xl">❤️</text>
          </view>

          <!-- 分享按钮 -->
          <view @click="handleShare" class="w-11 h-11 bg-white/10 backdrop-blur-sm rounded-full flex items-center justify-center">
            <text class="text-white text-lg">📤</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 弹幕输入框弹窗 -->
    <view v-if="showCommentInput" class="fixed inset-0 z-50" @click="showCommentInput = false">
      <view class="absolute bottom-0 left-0 right-0 bg-[#1a1a1a] p-4 pb-8" @click.stop>
        <view class="flex items-center gap-3">
          <input
            v-model="commentInput"
            placeholder="发送弹幕..."
            class="flex-1 bg-white/10 rounded-full px-4 py-3 text-white placeholder-white/40 outline-none text-sm"
            focus
            @confirm="handleSendComment"
          />
          <view
            @click="handleSendComment"
            :class="['w-12 h-12 rounded-full flex items-center justify-center', commentInput.trim() ? 'bg-[#C41E3A]' : 'bg-gray-600']"
          >
            <text class="text-white text-lg">➤</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 礼物面板 -->
    <view v-if="showGiftPanel" class="fixed inset-0 z-50 bg-black/60" @click="showGiftPanel = false">
      <view class="absolute bottom-0 left-0 right-0 bg-[#1a1a1a] rounded-t-3xl p-4 pb-8" @click.stop>
        <view class="flex items-center justify-between mb-4">
          <text class="text-white font-medium">送礼物</text>
          <text @click="showGiftPanel = false" class="text-white/60">✕</text>
        </view>
        <view class="grid grid-cols-4 gap-3">
          <view
            v-for="gift in mockGifts"
            :key="gift.id"
            @click="handleSendGift(gift)"
            class="flex flex-col items-center gap-1.5 p-3 bg-white/5 rounded-xl"
          >
            <text class="text-3xl">{{ gift.icon }}</text>
            <text class="text-white text-xs">{{ gift.name }}</text>
            <text class="text-[#C9A96E] text-[10px]">{{ gift.price }}热币</text>
          </view>
        </view>
        <view class="mt-4 flex items-center justify-between">
          <text class="text-white/60 text-xs">余额：520 热币</text>
          <text class="text-[#C41E3A] text-xs">充值</text>
        </view>
      </view>
    </view>

    <!-- 商品列表弹窗 -->
    <view v-if="showProductList" class="fixed inset-0 z-50 bg-black/60" @click="showProductList = false">
      <view class="absolute bottom-0 left-0 right-0 bg-[#1a1a1a] rounded-t-3xl max-h-[70vh] flex flex-col" @click.stop>
        <view class="flex items-center justify-between p-4 border-b border-white/10">
          <text class="text-white font-medium">直播间好物</text>
          <text @click="showProductList = false" class="text-white/60">✕</text>
        </view>
        <view class="flex-1 overflow-y-auto p-4 space-y-3">
          <view
            v-for="(product, idx) in mockProducts"
            :key="product.id"
            @click="selectProduct(product)"
            class="w-full flex items-center gap-3 p-3 bg-white/5 rounded-xl"
          >
            <view class="relative">
              <view class="absolute -left-1 -top-1 w-5 h-5 bg-[#C41E3A] rounded-full flex items-center justify-center text-white text-[10px] font-bold z-10">
                <text>{{ idx + 1 }}</text>
              </view>
              <view class="w-16 h-16 rounded-lg overflow-hidden bg-gray-600">
                <view class="w-full h-full bg-gradient-to-br from-gray-500 to-gray-700" />
              </view>
              <view v-if="product.isExplaining" class="absolute bottom-0 left-0 right-0 bg-[#C41E3A] text-white text-[8px] text-center py-0.5">
                讲解中
              </view>
            </view>
            <view class="flex-1 min-w-0">
              <text class="text-white text-sm line-clamp-2 block">{{ product.name }}</text>
              <view class="flex items-center gap-2 mt-1">
                <text class="text-[#C41E3A] font-bold">¥{{ product.price }}</text>
                <text class="text-white/40 text-xs line-through">¥{{ product.originalPrice }}</text>
              </view>
              <text class="text-white/50 text-xs block mt-0.5">已售 {{ product.sold }}</text>
            </view>
            <view class="bg-[#C41E3A] text-white text-xs px-4 py-2 rounded-full font-medium">
              抢
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 商品详情弹窗 -->
    <view v-if="showProductDetail && selectedProduct" class="fixed inset-0 z-50 bg-black/60" @click="showProductDetail = false">
      <view class="absolute bottom-0 left-0 right-0 bg-white rounded-t-3xl max-h-[80vh] flex flex-col" @click.stop>
        <view class="p-4 border-b border-gray-100">
          <view class="flex items-start gap-4">
            <view class="w-24 h-24 rounded-xl overflow-hidden flex-shrink-0 bg-gray-100">
              <view class="w-full h-full bg-gradient-to-br from-gray-300 to-gray-400" />
            </view>
            <view class="flex-1">
              <text class="text-[#2C2C2C] font-medium line-clamp-2 block">{{ selectedProduct.name }}</text>
              <view class="flex items-baseline gap-2 mt-2">
                <text class="text-[#C41E3A] text-xl font-bold">¥{{ selectedProduct.price }}</text>
                <text class="text-gray-400 text-sm line-through">¥{{ selectedProduct.originalPrice }}</text>
              </view>
              <view class="flex items-center gap-3 mt-1 text-xs text-gray-500">
                <text>已售 {{ selectedProduct.sold }}</text>
                <text>库存 {{ selectedProduct.stock }}</text>
              </view>
            </view>
            <text @click="showProductDetail = false" class="text-gray-400 text-xl">✕</text>
          </view>
        </view>
        <view class="p-4 flex gap-3">
          <view class="flex-1 py-3 bg-[#C9A96E] text-white rounded-full font-medium text-center">
            加入购物车
          </view>
          <view class="flex-1 py-3 bg-[#C41E3A] text-white rounded-full font-medium text-center">
            立即购买
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted, onUnmounted, nextTick } from 'vue'

// ============================================================
// Types
// ============================================================
interface Comment {
  id: string; userName: string; content: string; type: 'text' | 'gift' | 'system' | 'enter'
  isHost?: boolean; giftInfo?: { name: string; icon: string; count: number }
}

interface LiveProduct {
  id: string; name: string; cover: string; price: number; originalPrice: number
  stock: number; sold: number; isExplaining?: boolean
}

interface LiveGift {
  id: string; name: string; icon: string; price: number
}

// ============================================================
// Mock data
// ============================================================
const mockRoom = {
  id: '1',
  title: '开光吉祥物专场：招财貔貅限时特惠',
  hostName: '福缘阁主',
  hostAvatar: '',
  hostLevel: 5,
  followers: 12800,
  viewerCount: 8920,
  likeCount: 32100,
  onlineAvatars: ['1', '2', '3'],
}

const initialComments: Comment[] = [
  { id: '1', userName: '系统', content: '欢迎来到直播间，请文明观看', type: 'system' },
  { id: '2', userName: '易学爱好者', content: '主播讲得太好了！', type: 'text' },
]

const commentPool = [
  { userName: '国学新人', content: '这个怎么买？', type: 'text' as const },
  { userName: '风水迷', content: '价格很实惠', type: 'text' as const },
  { userName: '命理小白', content: '主播介绍一下', type: 'text' as const },
  { userName: '易道弟子', content: '666', type: 'text' as const },
  { userName: '玄学爱好者', content: '抢到了！', type: 'text' as const },
  { userName: '福气满满', content: '什么时候发货？', type: 'text' as const },
]

const enterPool = ['紫微门人', '风水小白', '命理初学', '国学传承', '易学新手']

const mockProducts: LiveProduct[] = [
  { id: '1', name: '开光招财貔貅摆件 天然黑曜石', cover: '', price: 299, originalPrice: 599, stock: 56, sold: 1280, isExplaining: true },
  { id: '2', name: '五帝钱挂件 真品铜钱招财镇宅', cover: '', price: 128, originalPrice: 268, stock: 128, sold: 2350 },
  { id: '3', name: '天然黄水晶转运葫芦', cover: '', price: 168, originalPrice: 328, stock: 89, sold: 890 },
]

const mockGifts: LiveGift[] = [
  { id: '1', name: '小红花', icon: '🌸', price: 1 },
  { id: '2', name: '鼓掌', icon: '👏', price: 5 },
  { id: '3', name: '比心', icon: '💕', price: 10 },
  { id: '4', name: '皇冠', icon: '👑', price: 50 },
  { id: '5', name: '火箭', icon: '🚀', price: 100 },
  { id: '6', name: '城堡', icon: '🏰', price: 520 },
]

// ============================================================
// State
// ============================================================
const isFollowing = ref(false)
const comments = ref<Comment[]>([...initialComments])
const likeCount = ref(mockRoom.likeCount)
const viewerCount = ref(mockRoom.viewerCount)
const floatingHearts = ref<{ id: number; x: number; scale: number }[]>([])
const commentInput = ref('')
const showCommentInput = ref(false)
const showGiftPanel = ref(false)
const showProductList = ref(false)
const showProductDetail = ref(false)
const selectedProduct = ref<LiveProduct | null>(null)
const giftAnimations = ref<{ id: number; gift: LiveGift; user: string }[]>([])

let heartId = 0
let giftId = 0
let commentTimer: ReturnType<typeof setInterval> | null = null

const currentProduct = computed(() => mockProducts.find(p => p.isExplaining) || mockProducts[0])

// ============================================================
// Lifecycle
// ============================================================
onMounted(() => {
  // 模拟新弹幕
  commentTimer = setInterval(() => {
    const rand = Math.random()
    if (rand < 0.7) {
      const c = commentPool[Math.floor(Math.random() * commentPool.length)]
      comments.value = [...comments.value.slice(-20), {
        id: Date.now().toString(),
        userName: c.userName,
        content: c.content,
        type: c.type,
      }]
    } else {
      const userName = enterPool[Math.floor(Math.random() * enterPool.length)]
      comments.value = [...comments.value.slice(-20), {
        id: Date.now().toString(),
        userName,
        content: '进入了直播间',
        type: 'enter',
      }]
      viewerCount.value++
    }
    scrollComments()
  }, 2500)
})

onUnmounted(() => {
  if (commentTimer) clearInterval(commentTimer)
})

function scrollComments() {
  nextTick(() => {
    const container = document.getElementById('commentsContainer')
    if (container) container.scrollTop = container.scrollHeight
  })
}

// ============================================================
// Methods
// ============================================================
function handleDoubleTap() {
  likeCount.value++
  const id = heartId++
  const x = Math.random() * 60 - 30
  const scale = 0.8 + Math.random() * 0.4
  floatingHearts.value = [...floatingHearts.value, { id, x, scale }]
  setTimeout(() => {
    floatingHearts.value = floatingHearts.value.filter(h => h.id !== id)
  }, 1500)
}

function handleSendComment() {
  if (!commentInput.value.trim()) return
  comments.value = [...comments.value.slice(-20), {
    id: Date.now().toString(),
    userName: '我',
    content: commentInput.value,
    type: 'text',
  }]
  commentInput.value = ''
  showCommentInput.value = false
  scrollComments()
}

function handleSendGift(gift: LiveGift) {
  const id = giftId++
  giftAnimations.value = [...giftAnimations.value, { id, gift, user: '我' }]
  comments.value = [...comments.value.slice(-20), {
    id: Date.now().toString(),
    userName: '我',
    content: '',
    type: 'gift',
    giftInfo: { name: gift.name, icon: gift.icon, count: 1 },
  }]
  setTimeout(() => {
    giftAnimations.value = giftAnimations.value.filter(g => g.id !== id)
  }, 3000)
  showGiftPanel.value = false
  scrollComments()
}

function showProductDetailPanel(product: LiveProduct) {
  selectedProduct.value = product
  showProductDetail.value = true
}

function selectProduct(product: LiveProduct) {
  selectedProduct.value = product
  showProductDetail.value = true
  showProductList.value = false
}

function formatCount(count: number): string {
  if (count >= 10000) return (count / 10000).toFixed(1) + '万'
  return String(count)
}

function handleShare() {
  uni.showActionSheet({ itemList: ['分享到微信', '分享到朋友圈', '复制链接'] })
}

function goBack() { uni.navigateBack() }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
