<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-20 bg-white border-b border-[#E8E0D5]">
      <view class="px-4 py-3 flex items-center gap-3">
        <view @click="goBack" class="p-1 -ml-1">
          <text class="text-2xl text-[#2C2C2C]">←</text>
        </view>
        <text class="text-lg font-semibold text-[#2C2C2C]">直播回放</text>
      </view>

      <!-- 搜索栏 -->
      <view class="px-4 pb-3 flex items-center gap-3">
        <view class="flex-1 relative">
          <text class="absolute left-3 top-1/2 -translate-y-1/2 text-[#999999]">🔍</text>
          <input
            v-model="searchQuery"
            placeholder="搜索讲师或标题"
            class="w-full pl-10 pr-10 py-2.5 bg-[#F5F5F5] rounded-full text-sm placeholder:text-[#999999] outline-none"
          />
          <text v-if="searchQuery" @click="searchQuery = ''" class="absolute right-3 top-1/2 -translate-y-1/2 text-[#999999]">✕</text>
        </view>
        <view @click="showSortSheet = true" class="flex items-center gap-1 px-3 py-2 text-sm text-[#666666] bg-[#F5F5F5] rounded-full">
          <text>⚙</text>
          <text>{{ sortOptions.find(o => o.value === sortBy)?.label }}</text>
        </view>
      </view>
    </view>

    <!-- 回放列表 -->
    <view class="p-4">
      <!-- 加载骨架 -->
      <view v-if="loading" class="space-y-4">
        <view v-for="i in 4" :key="i" class="bg-white rounded-2xl overflow-hidden animate-pulse">
          <view class="flex gap-3 p-3">
            <view class="w-36 h-20 bg-gray-200 rounded-xl flex-shrink-0" />
            <view class="flex-1 py-1">
              <view class="h-4 bg-gray-200 rounded w-full mb-2" />
              <view class="h-3 bg-gray-200 rounded w-2/3 mb-3" />
              <view class="flex gap-3">
                <view class="h-3 bg-gray-200 rounded w-16" />
                <view class="h-3 bg-gray-200 rounded w-16" />
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view v-else-if="filteredReplays.length === 0" class="py-20 text-center">
        <view class="w-20 h-20 mx-auto mb-4 rounded-full bg-[#F5F5F5] flex items-center justify-center">
          <text class="text-3xl text-[#CCCCCC]">▶</text>
        </view>
        <text class="text-[#999999] block mb-2">暂无回放内容</text>
        <text class="text-sm text-[#CCCCCC] block">{{ searchQuery ? '换个关键词试试' : '精彩内容即将上线' }}</text>
      </view>

      <!-- 回放列表 -->
      <view v-else class="space-y-3">
        <view
          v-for="replay in filteredReplays"
          :key="replay.id"
          @click="goTo('/pages/live/id-detail/index?id=' + replay.id + '&mode=replay')"
          class="bg-white rounded-2xl overflow-hidden shadow-sm active:opacity-90"
        >
          <view class="flex gap-3 p-3">
            <!-- 封面 -->
            <view class="relative w-36 h-20 flex-shrink-0 rounded-xl overflow-hidden bg-gray-100">
              <view class="w-full h-full bg-gradient-to-br from-gray-300 to-gray-400" />
              <!-- 回放标识 -->
              <view class="absolute top-1.5 left-1.5 px-1.5 py-0.5 bg-black/60 rounded text-[10px] text-white flex items-center gap-0.5">
                <text class="text-white text-[10px]">▶</text>
                <text>回放</text>
              </view>
              <!-- 时长 -->
              <view class="absolute bottom-1.5 right-1.5 px-1.5 py-0.5 bg-black/60 rounded text-[10px] text-white">
                <text>{{ formatDuration(replay.duration || 0) }}</text>
              </view>
            </view>

            <!-- 信息 -->
            <view class="flex-1 min-w-0 py-0.5 flex flex-col justify-between">
              <text class="text-sm font-medium text-[#2C2C2C] line-clamp-2 leading-snug block">
                {{ replay.title }}
              </text>

              <view class="space-y-1.5">
                <!-- 讲师 -->
                <view class="flex items-center gap-1.5">
                  <view class="w-4 h-4 rounded-full bg-[#F5F1EB] flex items-center justify-center">
                    <text class="text-[6px] text-[#666]">{{ replay.host.name[0] }}</text>
                  </view>
                  <text class="text-xs text-[#666666]">{{ replay.host.name }}</text>
                  <text class="text-[10px] text-[#999999] px-1.5 py-0.5 bg-[#F5F5F5] rounded">{{ replay.category }}</text>
                </view>

                <!-- 数据 -->
                <view class="flex items-center gap-3 text-xs text-[#999999]">
                  <text class="flex items-center gap-1">👁 {{ formatViews(replay.viewers) }}次播放</text>
                  <text>{{ formatDate(replay.endTime || '') }}</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 加载更多 -->
        <view v-if="hasMore" @click="loadMore" class="w-full py-3 text-sm text-[#666666] text-center">
          <text>加载更多</text>
        </view>

        <view v-if="!hasMore && filteredReplays.length > 0" class="py-4 text-center">
          <text class="text-xs text-[#CCCCCC]">已显示全部回放</text>
        </view>
      </view>
    </view>

    <!-- 排序面板 -->
    <view v-if="showSortSheet" class="fixed inset-0 z-50">
      <view class="absolute inset-0 bg-black/50" @click="showSortSheet = false" />
      <view class="absolute bottom-0 left-0 right-0 bg-white rounded-t-3xl">
        <view class="flex items-center justify-between p-4 border-b border-[#E8E0D5]">
          <text class="text-base font-medium text-[#2C2C2C]">排序方式</text>
          <text @click="showSortSheet = false" class="text-[#999999]">✕</text>
        </view>
        <view class="p-4 space-y-2">
          <view
            v-for="option in sortOptions"
            :key="option.value"
            @click="selectSort(option.value)"
            :class="['w-full py-3 rounded-xl text-center transition-colors', sortBy === option.value ? 'bg-[#C41E3A]/10 text-[#C41E3A] font-medium' : 'bg-[#F5F5F5] text-[#666666]']"
          >
            <text>{{ option.label }}</text>
          </view>
        </view>
        <view class="h-safe-area-inset-bottom" />
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

interface ReplayHost {
  id: string; name: string; avatar: string; followers: number
}

interface LiveRoom {
  id: string; title: string; cover: string; status: string
  host: ReplayHost; viewers: number; likes: number; duration?: number
  startTime?: string; endTime?: string; category: string
}

const mockReplays: LiveRoom[] = [
  { id: '1', title: '《周易》六十四卦详解 - 乾卦篇', cover: '', status: 'replay', host: { id: 'h1', name: '张道长', avatar: '', followers: 12800 }, viewers: 8520, likes: 2340, duration: 7200, endTime: '2024-01-15T20:00:00Z', category: '易经' },
  { id: '2', title: '紫微斗数入门：命盘基础解读', cover: '', status: 'replay', host: { id: 'h2', name: '李命师', avatar: '', followers: 9600 }, viewers: 6230, likes: 1890, duration: 5400, endTime: '2024-01-14T19:30:00Z', category: '紫微斗数' },
  { id: '3', title: '八字命理：如何看流年运势', cover: '', status: 'replay', host: { id: 'h3', name: '王半仙', avatar: '', followers: 15200 }, viewers: 12800, likes: 3560, duration: 6800, endTime: '2024-01-13T20:00:00Z', category: '八字命理' },
  { id: '4', title: '梅花易数：起卦与断卦技巧', cover: '', status: 'replay', host: { id: 'h4', name: '赵易师', avatar: '', followers: 7800 }, viewers: 4520, likes: 1230, duration: 4800, endTime: '2024-01-12T19:00:00Z', category: '梅花易数' },
  { id: '5', title: '风水布局：家居风水入门', cover: '', status: 'replay', host: { id: 'h5', name: '陈风水', avatar: '', followers: 11200 }, viewers: 9800, likes: 2780, duration: 5600, endTime: '2024-01-11T20:30:00Z', category: '风水' },
]

const sortOptions = [
  { value: 'latest', label: '最新发布' },
  { value: 'popular', label: '最多播放' },
  { value: 'duration', label: '时长最长' },
]

const loading = ref(true)
const replays = ref<LiveRoom[]>([])
const searchQuery = ref('')
const sortBy = ref('latest')
const showSortSheet = ref(false)
const hasMore = ref(true)

onMounted(() => {
  loadReplays()
})

function loadReplays() {
  loading.value = true
  setTimeout(() => {
    let sorted = [...mockReplays]
    if (sortBy.value === 'popular') {
      sorted.sort((a, b) => b.viewers - a.viewers)
    } else if (sortBy.value === 'duration') {
      sorted.sort((a, b) => (b.duration || 0) - (a.duration || 0))
    }
    replays.value = sorted
    hasMore.value = false
    loading.value = false
  }, 500)
}

const filteredReplays = computed(() => {
  if (!searchQuery.value) return replays.value
  const q = searchQuery.value.toLowerCase()
  return replays.value.filter(r => r.title.toLowerCase().includes(q) || r.host.name.toLowerCase().includes(q))
})

function selectSort(value: string) {
  sortBy.value = value
  showSortSheet.value = false
  loadReplays()
}

function loadMore() {
  // 模拟加载更多
  hasMore.value = false
}

function formatDuration(seconds: number): string {
  const h = Math.floor(seconds / 3600)
  const m = Math.floor((seconds % 3600) / 60)
  return h > 0 ? `${h}小时${m}分钟` : `${m}分钟`
}

function formatViews(num: number): string {
  if (num >= 10000) return (num / 10000).toFixed(1) + '万'
  return String(num)
}

function formatDate(dateStr: string): string {
  const date = new Date(dateStr)
  const now = new Date()
  const diff = now.getTime() - date.getTime()
  const days = Math.floor(diff / (1000 * 60 * 60 * 24))
  if (days === 0) return '今天'
  if (days === 1) return '昨天'
  if (days < 7) return `${days}天前`
  if (days < 30) return `${Math.floor(days / 7)}周前`
  return `${date.getMonth() + 1}月${date.getDate()}日`
}

function goBack() { uni.navigateBack() }
function goTo(url: string) { uni.navigateTo({ url }) }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
