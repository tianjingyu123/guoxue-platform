<template>
  <view class="min-h-screen bg-[#0f0f0f] flex flex-col">
    <!-- ===== 横屏提示 - 手机竖屏时显示 ===== -->
    <view class="fixed inset-0 bg-black/95 z-50 flex items-center justify-center">
      <view class="text-center text-white px-8">
        <view class="w-16 h-16 mx-auto mb-4 rounded-full bg-white/10 flex items-center justify-center">
          <text class="text-white text-3xl">📱</text>
        </view>
        <text class="text-lg font-medium mb-2 block">请将手机横屏观看</text>
        <text class="text-sm text-white/60 block">或使用平板/电脑获得更好的学习体验</text>
        <view @click="goBack" class="mt-6 px-6 py-2 bg-white/10 rounded-full text-sm inline-block">
          <text>返回直播列表</text>
        </view>
      </view>
    </view>

    <!-- ===== 主内容区 ===== -->
    <view class="flex-1 flex flex-col relative" style="display: none;">
      <!-- 顶部信息栏 -->
      <view class="absolute top-0 left-0 right-0 z-20 flex items-center justify-between px-4 py-3 bg-gradient-to-b from-black/80 to-transparent">
        <view class="flex items-center gap-3">
          <view @click="goBack" class="text-white/80">
            <text class="text-lg">✕</text>
          </view>
          <view class="w-10 h-10 rounded-full overflow-hidden border-2 border-[#C41E3A] bg-[#F5F1EB] flex items-center justify-center flex-shrink-0">
            <text class="text-sm text-[#666]">{{ mockRoom.hostName[0] }}</text>
          </view>
          <view>
            <text class="text-white text-sm font-medium line-clamp-1 max-w-md block">{{ mockRoom.title }}</text>
            <view class="flex items-center gap-2 text-white/60 text-xs">
              <text>{{ mockRoom.hostName }}</text>
              <text>·</text>
              <text>{{ mockRoom.hostTitle }}</text>
            </view>
          </view>
        </view>
        <view class="flex items-center gap-4">
          <view class="flex items-center gap-1.5 text-white/80 text-sm">
            <text class="text-[10px]">👥</text>
            <text>{{ mockRoom.viewers.toLocaleString() }}</text>
          </view>
          <view class="flex items-center gap-1.5 text-[#C41E3A] text-sm">
            <view class="w-2 h-2 bg-[#C41E3A] rounded-full" />
            <text>直播中</text>
            <text class="text-white/60 ml-1">{{ mockRoom.duration }}</text>
          </view>
        </view>
      </view>

      <!-- 视频/课件区域 -->
      <view class="flex-1 relative bg-black">
        <!-- 课件展示 -->
        <view :class="['absolute inset-0 flex items-center justify-center', showVideo ? 'z-0' : 'z-10']">
          <view class="w-full h-full bg-gradient-to-br from-[#1a1a2e] to-[#16213e] flex items-center justify-center">
            <view class="text-center">
              <text class="text-6xl mb-4 opacity-20 block">☯</text>
              <text class="text-white/40 text-lg block">{{ mockSlides[currentSlide - 1]?.title }}</text>
              <text class="text-white/20 text-sm block mt-2">第 {{ currentSlide }} / {{ mockSlides.length }} 页</text>
            </view>
          </view>
          <!-- 翻页按钮 -->
          <template v-if="!followSlide">
            <view
              @click="currentSlide = Math.max(1, currentSlide - 1)"
              class="absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 bg-black/50 rounded-full flex items-center justify-center"
            >
              <text class="text-white">‹</text>
            </view>
            <view
              @click="currentSlide = Math.min(mockSlides.length, currentSlide + 1)"
              class="absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 bg-black/50 rounded-full flex items-center justify-center"
            >
              <text class="text-white">›</text>
            </view>
          </template>
        </view>

        <!-- 讲师视频画面 -->
        <view :class="[
          'absolute transition-all duration-300',
          showVideo ? 'inset-0 z-10' : 'bottom-4 right-4 w-52 h-40 z-20 rounded-xl overflow-hidden shadow-2xl border border-white/10'
        ]">
          <view class="w-full h-full bg-gradient-to-br from-gray-800 to-gray-900 flex items-center justify-center">
            <view class="text-center">
              <view class="w-20 h-20 rounded-full bg-white/10 flex items-center justify-center mx-auto mb-2">
                <text class="text-white/40 text-sm">{{ mockRoom.hostName[0] }}</text>
              </view>
              <text class="text-white/40 text-sm block">讲师画面</text>
            </view>
          </view>
        </view>

        <!-- 切换按钮 -->
        <view
          @click="showVideo = !showVideo"
          class="absolute bottom-4 left-4 z-30 bg-black/60 text-white px-4 py-2 rounded-full text-sm flex items-center gap-2"
        >
          <text class="text-sm">📖</text>
          <text>{{ showVideo ? '显示课件' : '显示视频' }}</text>
        </view>

        <!-- 全屏按钮 -->
        <view class="absolute top-16 right-4 z-30 w-10 h-10 bg-black/60 rounded-full flex items-center justify-center">
          <text class="text-white">⛶</text>
        </view>

        <!-- 音量按钮 -->
        <view
          @click="isMuted = !isMuted"
          class="absolute top-16 right-16 z-30 w-10 h-10 bg-black/60 rounded-full flex items-center justify-center"
        >
          <text class="text-white">{{ isMuted ? '🔇' : '🔊' }}</text>
        </view>
      </view>

      <!-- 课件缩略图列表 -->
      <view class="h-20 bg-[#1a1a1a] border-t border-white/10 flex items-center px-4 gap-3 overflow-x-auto">
        <view
          v-for="(slide, idx) in mockSlides"
          :key="slide.id"
          @click="followSlide = false; currentSlide = idx + 1"
          :class="[
            'flex-shrink-0 w-28 h-14 rounded-lg border-2 overflow-hidden relative',
            currentSlide === idx + 1 ? 'border-[#C41E3A]' : 'border-transparent'
          ]"
        >
          <view class="absolute inset-0 bg-gradient-to-br from-[#1a1a2e] to-[#16213e]" />
          <view class="absolute inset-0 flex items-center justify-center">
            <text class="text-white/60 text-xs">{{ idx + 1 }}</text>
          </view>
          <view v-if="currentSlide === idx + 1" class="absolute bottom-0 inset-x-0 bg-[#C41E3A] text-white text-[10px] text-center py-0.5">
            <text>当前</text>
          </view>
        </view>
        <view class="flex-shrink-0 w-px h-10 bg-white/10" />
        <view
          @click="followSlide = true"
          :class="[
            'flex-shrink-0 px-4 py-2 rounded-full text-sm font-medium',
            followSlide ? 'bg-[#C41E3A] text-white' : 'bg-white/10 text-white/70'
          ]"
        >
          <text>跟随讲师</text>
        </view>
      </view>
    </view>

    <!-- ===== 右侧互动面板 ===== -->
    <view class="w-80 flex flex-col bg-[#1a1a1a] border-l border-white/10" style="display: none;">
      <!-- Tab切换 -->
      <view class="flex border-b border-white/10">
        <view
          v-for="tab in rightTabs"
          :key="tab.key"
          @click="activeTab = tab.key"
          :class="[
            'flex-1 py-3 text-sm font-medium relative text-center',
            activeTab === tab.key ? 'text-white' : 'text-white/50'
          ]"
        >
          <text>{{ tab.label }}</text>
          <view v-if="activeTab === tab.key" class="absolute bottom-0 left-1/2 -translate-x-1/2 w-8 h-0.5 bg-[#C41E3A] rounded-full" />
        </view>
      </view>

      <!-- 聊天区 -->
      <template v-if="activeTab === 'chat'">
        <view class="flex-1 overflow-y-auto p-3 flex flex-col gap-3">
          <view v-for="msg in messages" :key="msg.id" class="flex gap-2">
            <view class="w-7 h-7 rounded-full bg-gradient-to-br from-[#C41E3A]/50 to-[#C9A96E]/50 flex items-center justify-center flex-shrink-0">
              <text class="text-white text-xs">{{ msg.userName[0] }}</text>
            </view>
            <view class="flex-1">
              <view class="flex items-center gap-2">
                <text class="text-white/50 text-xs">{{ msg.userName }}</text>
                <text class="text-white/30 text-[10px]">{{ msg.time }}</text>
              </view>
              <text class="text-white/90 text-sm block mt-0.5">{{ msg.content }}</text>
            </view>
          </view>
        </view>

        <view class="p-3 border-t border-white/10 flex flex-col gap-3">
          <view class="flex items-center justify-between">
            <view
              @click="handleLike"
              :class="['flex items-center gap-1.5 text-sm', liked ? 'text-[#C41E3A]' : 'text-white/60']"
            >
              <text>❤️</text>
              <text>{{ likeCount.toLocaleString() }}</text>
            </view>
            <view
              @click="handleApplyMic"
              :class="[
                'flex items-center gap-1.5 text-sm px-3 py-1.5 rounded-full',
                micStatus === 'none' ? 'bg-white/10 text-white' :
                micStatus === 'applying' ? 'bg-amber-500/20 text-amber-400' :
                micStatus === 'waiting' ? 'bg-blue-500/20 text-blue-400' :
                'bg-green-500/20 text-green-400'
              ]"
            >
              <text>{{ micLabel }}</text>
            </view>
            <view class="text-white/60">
              <text>📤</text>
            </view>
          </view>

          <view class="flex gap-2">
            <input
              v-model="newMessage"
              @confirm="handleSendMessage"
              placeholder="发送消息..."
              class="flex-1 bg-white/10 text-white text-sm rounded-full px-4 py-2.5 outline-none placeholder:text-white/40"
            />
            <view @click="handleSendMessage" class="w-10 h-10 bg-[#C41E3A] rounded-full flex items-center justify-center">
              <text class="text-white text-sm">📨</text>
            </view>
          </view>
        </view>
      </template>

      <!-- 问答区 -->
      <template v-if="activeTab === 'qa'">
        <view class="flex border-b border-white/10">
          <view
            v-for="tab in questionTabs"
            :key="tab.key"
            @click="questionTab = tab.key"
            :class="['flex-1 py-2.5 text-xs text-center', questionTab === tab.key ? 'text-white bg-white/5' : 'text-white/50']"
          >
            <text>{{ tab.label }} ({{ tab.count }})</text>
          </view>
        </view>

        <view class="flex-1 overflow-y-auto p-3 flex flex-col gap-3">
          <view v-if="filteredQuestions.length === 0" class="text-center py-12">
            <text class="text-white/40 text-sm block">暂无{{ questionTab === 'pending' ? '待解答' : '已解答' }}问题</text>
          </view>
          <view v-for="q in filteredQuestions" :key="q.id" class="bg-white/5 rounded-xl p-3">
            <view class="flex items-start gap-2">
              <view class="w-7 h-7 rounded-full bg-gradient-to-br from-[#C41E3A]/50 to-[#C9A96E]/50 flex items-center justify-center flex-shrink-0">
                <text class="text-white text-xs">{{ q.userName[0] }}</text>
              </view>
              <view class="flex-1">
                <view class="flex items-center gap-2">
                  <text class="text-white/50 text-xs">{{ q.userName }}</text>
                  <text class="text-white/30 text-[10px]">{{ q.time }}</text>
                  <text v-if="!q.isPublic" class="text-[10px] bg-white/10 text-white/50 px-1.5 py-0.5 rounded">私密</text>
                </view>
                <text class="text-white text-sm block mt-1">{{ q.content }}</text>
                <view v-if="q.status === 'answered' && q.answer" class="mt-2 pl-3 border-l-2 border-green-500">
                  <text class="text-green-400 text-xs flex items-center gap-1 block mb-1">✓ 讲师回复</text>
                  <text class="text-white/80 text-sm block">{{ q.answer }}</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view class="p-3 border-t border-white/10 flex flex-col gap-2">
          <view class="flex items-center gap-2 text-xs">
            <view
              @click="isPublicQuestion = true"
              :class="['px-2.5 py-1 rounded-full', isPublicQuestion ? 'bg-white/10 text-white' : 'text-white/50']"
            >
              <text>公开提问</text>
            </view>
            <view
              @click="isPublicQuestion = false"
              :class="['px-2.5 py-1 rounded-full', !isPublicQuestion ? 'bg-white/10 text-white' : 'text-white/50']"
            >
              <text>私密提问</text>
            </view>
          </view>
          <view class="flex gap-2">
            <input
              v-model="newQuestion"
              @confirm="handleAskQuestion"
              placeholder="输入您的问题..."
              class="flex-1 bg-white/10 text-white text-sm rounded-lg px-3 py-2.5 outline-none placeholder:text-white/40"
            />
            <view
              @click="handleAskQuestion"
              :class="['px-4 py-2 rounded-lg text-sm font-medium', newQuestion.trim() ? 'bg-[#C41E3A] text-white' : 'bg-white/10 text-white/30']"
            >
              <text>提问</text>
            </view>
          </view>
        </view>
      </template>

      <!-- 资料区 -->
      <template v-if="activeTab === 'files'">
        <view class="flex-1 overflow-y-auto p-3 flex flex-col gap-2">
          <view v-for="file in mockFiles" :key="file.id" class="flex items-center gap-3 p-3 bg-white/5 rounded-xl">
            <view class="w-10 h-10 rounded-lg bg-[#C41E3A]/20 flex items-center justify-center">
              <text class="text-[#C41E3A]">📄</text>
            </view>
            <view class="flex-1 min-w-0">
              <text class="text-white text-sm block truncate">{{ file.name }}</text>
              <text class="text-white/40 text-xs block">{{ file.size }}</text>
            </view>
            <view class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center">
              <text class="text-white/60">⬇</text>
            </view>
          </view>
        </view>
      </template>

      <!-- 简介区 -->
      <template v-if="activeTab === 'intro'">
        <view class="flex-1 overflow-y-auto p-4">
          <view class="text-center mb-6">
            <view class="w-20 h-20 rounded-full overflow-hidden mx-auto border-2 border-[#C41E3A] bg-[#F5F1EB] flex items-center justify-center">
              <text class="text-lg text-[#666]">{{ mockRoom.hostName[0] }}</text>
            </view>
            <text class="text-white font-medium block mt-3">{{ mockRoom.hostName }}</text>
            <text class="text-white/50 text-sm block">{{ mockRoom.hostTitle }}</text>
            <text class="text-white/40 text-xs block mt-1">{{ mockRoom.followers.toLocaleString() }} 粉丝</text>
          </view>
          <view class="flex flex-col gap-4">
            <view>
              <text class="text-white/70 text-xs block mb-2">课程介绍</text>
              <text class="text-white/90 text-sm leading-relaxed block">{{ mockRoom.title }}</text>
            </view>
            <view>
              <text class="text-white/70 text-xs block mb-2">讲师简介</text>
              <text class="text-white/70 text-sm leading-relaxed block">
                {{ mockRoom.hostName }}，资深易学研究员，从事周易研究二十余年，著有《周易入门》《八字命理精解》等多部著作。
              </text>
            </view>
          </view>
        </view>
      </template>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted, onUnmounted } from 'vue'

// ============================================================
// Mock data
// ============================================================
const mockRoom = {
  id: '1',
  title: '《周易》六十四卦精讲 - 第12讲：泰卦与否卦',
  hostName: '张明远',
  hostAvatar: '',
  hostTitle: '易学研究员',
  followers: 12800,
  viewers: 1856,
  likes: 4520,
  duration: '45:32',
  category: '易经',
}

const mockSlides = [
  { id: '1', pageNum: 1, title: '第一章：泰卦概述' },
  { id: '2', pageNum: 2, title: '泰卦卦象解读' },
  { id: '3', pageNum: 3, title: '泰卦六爻详解' },
  { id: '4', pageNum: 4, title: '否卦概述' },
  { id: '5', pageNum: 5, title: '泰否对比分析' },
]

interface Question {
  id: string
  userName: string
  userAvatar: string
  content: string
  isPublic: boolean
  status: 'pending' | 'answered'
  answer?: string
  time: string
}

const initialQuestions: Question[] = [
  { id: '1', userName: '学员A', userAvatar: '', content: '泰卦和否卦的核心区别是什么？', isPublic: true, status: 'answered', answer: '泰卦象征天地交泰、上下沟通，否卦象征天地不交、闭塞不通。一通一塞，正是相反相成。', time: '12:35' },
  { id: '2', userName: '学员B', userAvatar: '', content: '否极泰来这个成语和这两卦有关系吗？', isPublic: true, status: 'pending', time: '12:38' },
  { id: '3', userName: '学员C', userAvatar: '', content: '请问老师，泰卦在占卜中一般代表什么含义？', isPublic: true, status: 'pending', time: '12:42' },
]

interface Message {
  id: string
  userName: string
  content: string
  time: string
}

const initialMessages: Message[] = [
  { id: '1', userName: '易学爱好者', content: '老师讲得太清楚了', time: '12:30' },
  { id: '2', userName: '国学小白', content: '终于理解了泰卦的含义', time: '12:32' },
  { id: '3', userName: '命理研究', content: '这个课程质量真高', time: '12:34' },
]

const mockFiles = [
  { id: '1', name: '泰卦与否卦详解讲义.pdf', size: '2.3MB', type: 'pdf' },
  { id: '2', name: '六十四卦速查表.pdf', size: '1.5MB', type: 'pdf' },
  { id: '3', name: '本课思维导图.png', size: '890KB', type: 'image' },
]

// ============================================================
// Tab configs
// ============================================================
const rightTabs = [
  { key: 'chat', label: '聊天' },
  { key: 'qa', label: '问答' },
  { key: 'files', label: '资料' },
  { key: 'intro', label: '简介' },
]

const questionTabs = [
  { key: 'pending', label: '待解答', count: 0 },
  { key: 'answered', label: '已解答', count: 0 },
]

// ============================================================
// State
// ============================================================
const currentSlide = ref(3)
const followSlide = ref(true)
const showVideo = ref(true)
const isFullscreen = ref(false)
const isMuted = ref(false)
const activeTab = ref<'chat' | 'qa' | 'files' | 'intro'>('chat')
const questionTab = ref<'pending' | 'answered'>('pending')
const questions = ref<Question[]>(initialQuestions)
const messages = ref<Message[]>(initialMessages)
const newMessage = ref('')
const newQuestion = ref('')
const isPublicQuestion = ref(true)
const micStatus = ref<'none' | 'applying' | 'waiting' | 'connected'>('none')
const liked = ref(false)
const likeCount = ref(mockRoom.likes)

// 模拟消息定时器
let mockMsgTimer: ReturnType<typeof setInterval> | null = null

// ============================================================
// Computed
// ============================================================
const filteredQuestions = computed(() => {
  return questions.value.filter(q => q.status === questionTab.value)
})

const micLabel = computed(() => {
  switch (micStatus.value) {
    case 'none': return '🙋 举手'
    case 'applying': return '申请中...'
    case 'waiting': return '⏳ 排队中'
    case 'connected': return '🔇 结束'
  }
})

// ============================================================
// Lifecycle
// ============================================================
onMounted(() => {
  // 更新问答Tab计数
  questionTabs[0].count = questions.value.filter(q => q.status === 'pending').length
  questionTabs[1].count = questions.value.filter(q => q.status === 'answered').length

  // 模拟新消息
  const comments = ['学到了', '受益匪浅', '老师讲得好', '涨知识了', '感谢分享']
  const users = ['玄学新人', '易道弟子', '国学迷', '命理初学', '风水爱好']
  mockMsgTimer = setInterval(() => {
    const now = new Date()
    const time = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`
    messages.value.push({
      id: Date.now().toString(),
      userName: users[Math.floor(Math.random() * users.length)],
      content: comments[Math.floor(Math.random() * comments.length)],
      time,
    })
    // Keep last 20
    if (messages.value.length > 20) {
      messages.value = messages.value.slice(-20)
    }
  }, 5000)
})

onUnmounted(() => {
  if (mockMsgTimer) clearInterval(mockMsgTimer)
})

// ============================================================
// Methods
// ============================================================
function handleSendMessage() {
  if (!newMessage.value.trim()) return
  const now = new Date()
  const time = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`
  messages.value.push({
    id: Date.now().toString(),
    userName: '我',
    content: newMessage.value,
    time,
  })
  newMessage.value = ''
}

function handleAskQuestion() {
  if (!newQuestion.value.trim()) return
  const now = new Date()
  const time = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`
  questions.value.push({
    id: Date.now().toString(),
    userName: '我',
    userAvatar: '',
    content: newQuestion.value,
    isPublic: isPublicQuestion.value,
    status: 'pending',
    time,
  })
  newQuestion.value = ''
}

function handleApplyMic() {
  if (micStatus.value === 'none') {
    micStatus.value = 'applying'
    setTimeout(() => { micStatus.value = 'waiting' }, 1000)
  } else if (micStatus.value === 'waiting') {
    micStatus.value = 'none'
  } else if (micStatus.value === 'connected') {
    micStatus.value = 'none'
  }
}

function handleLike() {
  if (!liked.value) {
    liked.value = true
    likeCount.value += 1
  }
}

function goBack() {
  uni.navigateBack()
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
