<template>
  <view v-if="!live" class="min-h-screen bg-[#FAF8F5] flex items-center justify-center">
    <text class="text-[#999]">直播不存在</text>
  </view>

  <!-- ================================================================ -->
  <!-- 横屏 OBS 知识授课布局                                                -->
  <!-- ================================================================ -->
  <view v-else-if="live.orientation === 'horizontal'" class="fixed inset-0 bg-[#1a1a2e] flex flex-col overflow-hidden">
    <!-- ===== 非全屏模式 ===== -->
    <template v-if="!isFullscreen">
      <!-- 顶部主播信息栏 -->
      <view class="h-10 bg-[#1a1a2e] border-b border-white/10 flex items-center justify-between px-4 flex-shrink-0">
        <view class="flex items-center gap-3">
          <view @click="goBack" class="w-8 h-8 rounded-full bg-black/30 flex items-center justify-center">
            <text class="text-white text-lg">←</text>
          </view>
          <view class="w-7 h-7 rounded-full border border-[#C41E3A] bg-[#F5F1EB] flex items-center justify-center overflow-hidden flex-shrink-0">
            <text class="text-[10px] text-[#666]">{{ live.hostName[0] }}</text>
          </view>
          <text class="text-white text-sm font-medium">{{ live.hostName }}</text>
          <text class="text-white/50 text-xs">|</text>
          <text class="text-white/70 text-xs truncate max-w-[200px]">{{ live.title }}</text>
        </view>
        <view class="flex items-center gap-3">
          <view class="flex items-center gap-1">
            <text class="text-white/60 text-[10px]">👁</text>
            <text class="text-white/60 text-xs">{{ formatCount(live.viewerCount) }}</text>
          </view>
          <view
            @click="isFollowing = !isFollowing"
            :class="['h-6 px-3 rounded-full text-[10px] flex items-center',
              isFollowing ? 'bg-white/10 text-white' : 'bg-[#C41E3A] text-white']"
          >
            <text>{{ isFollowing ? '已关注' : '关注' }}</text>
          </view>
          <view class="w-7 h-7 rounded-full flex items-center justify-center">
            <text class="text-white/70">📤</text>
          </view>
        </view>
      </view>

      <!-- 主视频播放区 (16:9) -->
      <view class="relative bg-black flex-shrink-0" style="padding-top: 56.25%">
        <view class="absolute inset-0 flex items-center justify-center">
          <view class="text-center opacity-20">
            <view class="w-24 h-24 rounded-xl bg-white/10 flex items-center justify-center mx-auto mb-3">
              <text class="text-4xl">📊</text>
            </view>
            <text class="text-white/50 text-sm">OBS课件直播画面</text>
          </view>
        </view>

        <!-- 全屏按钮 -->
        <view @click="isFullscreen = true" class="absolute right-3 bottom-3 w-9 h-9 rounded-lg bg-black/60 flex items-center justify-center">
          <text class="text-white">⛶</text>
        </view>

        <!-- 弹幕浮层 -->
        <view v-if="!isMuted && danmakuList.length > 0" class="absolute left-3 bottom-14 z-10 max-w-[60%] flex flex-col gap-1">
          <view v-for="d in danmakuList.slice(-3)" :key="d.id" class="inline-block px-2 py-0.5 bg-black/40 rounded">
            <text class="text-[14px]" style="opacity: 0.7">
              <text class="text-[#C41E3A] mr-1.5">{{ d.user }}</text>
              <text class="text-white">{{ d.content }}</text>
            </text>
          </view>
        </view>
      </view>

      <!-- 底部Tab互动区 -->
      <view class="flex-1 flex flex-col min-h-0 bg-white">
        <view class="flex border-b border-[#E8E0D5] flex-shrink-0">
          <view
            v-for="tab in bottomTabs"
            :key="tab.key"
            @click="activeBottomTab = tab.key"
            :class="[
              'flex-1 py-2.5 text-sm font-medium relative text-center',
              activeBottomTab === tab.key ? 'text-[#C41E3A]' : 'text-[#999]'
            ]"
          >
            <text>{{ tab.label }}</text>
            <view v-if="activeBottomTab === tab.key" class="absolute bottom-0 left-1/2 -translate-x-1/2 w-5 h-0.5 bg-[#C41E3A] rounded-full" />
          </view>
        </view>

        <view class="flex-1 overflow-y-auto">
          <!-- 讨论Tab -->
          <view v-if="activeBottomTab === 'chat'" class="flex flex-col h-full">
            <view class="flex-1 p-3 flex flex-col gap-2 overflow-y-auto">
              <view v-for="d in danmakuList" :key="d.id" class="flex items-start gap-2">
                <view class="w-6 h-6 rounded-full bg-[#C41E3A]/10 flex items-center justify-center flex-shrink-0">
                  <text class="text-[10px] text-[#C41E3A]">{{ d.user[0] }}</text>
                </view>
                <view class="min-w-0">
                  <text class="text-xs text-[#999] block">{{ d.user }}</text>
                  <text class="text-sm break-words">{{ d.content }}</text>
                </view>
              </view>
            </view>
            <view class="p-3 border-t border-[#E8E0D5] flex-shrink-0">
              <view class="flex items-center gap-2 h-9 px-3 bg-[#F1EDE8] rounded-full">
                <input
                  v-model="message"
                  placeholder="发送弹幕..."
                  @confirm="handleSendMessage"
                  class="flex-1 bg-transparent text-sm placeholder:text-[#999] outline-none"
                />
                <view @click="isMuted = !isMuted" :class="['w-6 h-6 rounded-full flex items-center justify-center', isMuted ? 'text-[#999]' : 'text-[#C41E3A]']">
                  <text class="text-xs">💬</text>
                </view>
                <view @click="handleSendMessage" class="w-6 h-6 rounded-full bg-[#C41E3A] flex items-center justify-center">
                  <text class="text-white text-[10px]">📨</text>
                </view>
              </view>
            </view>
          </view>

          <!-- 课件Tab -->
          <view v-if="activeBottomTab === 'slides'" class="p-3 flex flex-col gap-2">
            <text class="text-xs text-[#999] mb-1">当前课件进度</text>
            <view
              v-for="(slide, i) in mockSlides"
              :key="slide.id"
              :class="['flex items-center gap-3 p-2.5 rounded-lg border transition-colors', slide.isCurrent ? 'border-[#C41E3A] bg-[#C41E3A]/5' : 'border-[#E8E0D5]']"
            >
              <view :class="['w-6 h-6 rounded-full flex items-center justify-center text-xs font-medium flex-shrink-0', slide.isCurrent ? 'bg-[#C41E3A] text-white' : 'bg-[#F1EDE8] text-[#999]']">
                <text>{{ i + 1 }}</text>
              </view>
              <text :class="['text-sm flex-1', slide.isCurrent && 'font-medium']">{{ slide.title }}</text>
              <view v-if="slide.isCurrent" class="text-[10px] px-2 py-0.5 bg-[#C41E3A]/10 text-[#C41E3A] rounded">
                <text>讲解中</text>
              </view>
            </view>
          </view>

          <!-- 问答Tab -->
          <view v-if="activeBottomTab === 'qa'" class="p-3 flex flex-col gap-3">
            <view class="flex items-center justify-between mb-1">
              <text class="text-xs text-[#999]">观众提问</text>
              <view class="h-7 px-3 rounded-full border border-[#E8E0D5] flex items-center text-xs">
                <text class="mr-1">💬</text>
                <text>我要提问</text>
              </view>
            </view>
            <view
              v-for="qa in mockQA"
              :key="qa.id"
              :class="['p-3 rounded-lg border', qa.isOnWall ? 'border-[#C41E3A] bg-[#C41E3A]/5' : 'border-[#E8E0D5]']"
            >
              <view class="flex items-center gap-2 mb-1.5">
                <view class="w-5 h-5 rounded-full bg-[#F1EDE8] flex items-center justify-center">
                  <text class="text-[8px] text-[#999]">{{ qa.user[0] }}</text>
                </view>
                <text class="text-xs text-[#999]">{{ qa.user }}</text>
                <text class="text-[10px] text-[#999]/60">{{ qa.time }}</text>
                <view v-if="qa.isOnWall" class="text-[8px] px-1 py-0.5 bg-[#C41E3A] text-white rounded">
                  <text>已上墙</text>
                </view>
              </view>
              <text class="text-sm">{{ qa.question }}</text>
            </view>
          </view>

          <!-- 资料Tab -->
          <view v-if="activeBottomTab === 'files'" class="p-3 flex flex-col gap-2">
            <text class="text-xs text-[#999] mb-1">本课资料</text>
            <view
              v-for="file in mockFiles"
              :key="file.id"
              class="flex items-center gap-3 p-3 rounded-lg border border-[#E8E0D5]"
            >
              <view class="w-10 h-10 rounded-lg bg-[#C41E3A]/10 flex items-center justify-center flex-shrink-0">
                <text class="text-[#C41E3A]">📄</text>
              </view>
              <view class="flex-1 min-w-0">
                <text class="text-sm font-medium block truncate">{{ file.name }}</text>
                <text class="text-xs text-[#999]">{{ file.size }}</text>
              </view>
              <view class="h-7 px-3 rounded-full border border-[#E8E0D5] flex items-center text-xs">
                <text>下载</text>
              </view>
            </view>
          </view>

          <!-- 简介Tab -->
          <view v-if="activeBottomTab === 'intro'" class="p-4 flex flex-col gap-4">
            <view>
              <text class="text-sm font-semibold block mb-2">课程介绍</text>
              <text class="text-sm text-[#999] leading-relaxed">
                本课程将深入讲解紫微斗数命盘的解读方法，包括十二宫位的含义、主星特性分析、四化飞星运用等核心内容。适合有一定基础的学员进阶学习。
              </text>
            </view>
            <view>
              <text class="text-sm font-semibold block mb-2">讲师简介</text>
              <view class="flex items-start gap-3">
                <view class="w-12 h-12 rounded-full border-2 border-[#C41E3A] bg-[#F5F1EB] flex items-center justify-center overflow-hidden flex-shrink-0">
                  <text class="text-sm text-[#666]">{{ live.hostName[0] }}</text>
                </view>
                <view>
                  <text class="text-sm font-medium block">{{ live.hostName }}</text>
                  <text class="text-xs text-[#999] block">{{ live.hostTitle }}</text>
                  <text class="text-xs text-[#999] block mt-1">{{ formatCount(live.followerCount) }}粉丝</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 横屏提示 -->
      <view class="fixed top-14 left-1/2 -translate-x-1/2 z-50 px-4 py-2 bg-black/80 backdrop-blur-md rounded-full flex items-center gap-2">
        <text class="text-white text-xs">🔄</text>
        <text class="text-white text-xs">旋转手机获得最佳观看体验</text>
        <view @click="isFullscreen = true" class="ml-2 px-2 py-0.5 rounded-full bg-[#C41E3A]">
          <text class="text-white text-xs">全屏</text>
        </view>
      </view>
    </template>

    <!-- ===== 全屏模式 ===== -->
    <template v-else>
      <view class="fixed inset-0 bg-[#1a1a2e] overflow-hidden" @click="resetControlsTimer" @touchstart="resetControlsTimer">
        <!-- 全屏视频画面 -->
        <view class="absolute inset-0 flex items-center justify-center bg-black">
          <view class="text-center opacity-20">
            <view class="w-40 h-40 rounded-2xl bg-white/10 flex items-center justify-center mx-auto mb-4">
              <text class="text-6xl">📊</text>
            </view>
            <text class="text-white/50 text-lg">OBS课件直播画面</text>
            <text class="text-white/30 text-sm block mt-2">16:9 横屏 · 沉浸式授课</text>
          </view>
        </view>

        <!-- 顶部控制栏 -->
        <view :class="[
          'absolute top-0 left-0 right-0 z-30 transition-all duration-300',
          showFullscreenControls ? 'opacity-100' : 'opacity-0 pointer-events-none'
        ]">
          <view class="bg-gradient-to-b from-black/80 via-black/40 to-transparent px-6 py-4">
            <view class="flex items-center justify-between">
              <view class="flex items-center gap-4">
                <view class="w-10 h-10 rounded-full border-2 border-[#C41E3A] bg-[#F5F1EB] flex items-center justify-center overflow-hidden flex-shrink-0">
                  <text class="text-sm text-[#666]">{{ live.hostName[0] }}</text>
                </view>
                <view>
                  <view class="flex items-center gap-2">
                    <text class="text-white font-medium">{{ live.hostName }}</text>
                    <view class="text-[10px] px-1.5 py-0.5 rounded bg-[#C41E3A]/20 text-[#C41E3A] border border-[#C41E3A]/30">
                      <text>直播中</text>
                    </view>
                  </view>
                  <text class="text-white/60 text-sm block truncate max-w-[300px]">{{ live.title }}</text>
                </view>
              </view>

              <view class="flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10">
                <text class="text-white/70 text-[10px]">👁</text>
                <text class="text-white text-sm">{{ formatCount(live.viewerCount) }}人观看</text>
              </view>

              <view class="flex items-center gap-3">
                <view class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/10">
                  <text class="text-white text-sm">📤</text>
                  <text class="text-white text-sm">分享</text>
                </view>
                <view @click="isFullscreen = false" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/10">
                  <text class="text-white text-sm">⛶</text>
                  <text class="text-white text-sm">退出全屏</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 底部控制栏 -->
        <view :class="[
          'absolute bottom-0 left-0 right-0 z-30 transition-all duration-300',
          showFullscreenControls ? 'opacity-100' : 'opacity-0 pointer-events-none'
        ]">
          <view class="bg-gradient-to-t from-black/80 via-black/40 to-transparent px-6 py-4">
            <view class="flex items-center justify-between">
              <view class="flex items-center gap-4">
                <view class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center">
                  <text class="text-white">▶</text>
                </view>
                <view class="flex items-center gap-2">
                  <view @click="isVolumeMuted = !isVolumeMuted" class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center">
                    <text class="text-white">{{ isVolumeMuted ? '🔇' : '🔊' }}</text>
                  </view>
                  <view class="w-24 h-1 bg-white/20 rounded-full overflow-hidden">
                    <view class="h-full bg-white rounded-full" :style="{ width: isVolumeMuted ? '0%' : '70%' }" />
                  </view>
                </view>
              </view>

              <view class="flex items-center gap-4">
                <view
                  @click="isMuted = !isMuted"
                  :class="['flex items-center gap-1.5 px-3 py-1.5 rounded-full', isMuted ? 'bg-white/10' : 'bg-[#C41E3A]/80']"
                >
                  <text class="text-white text-sm">💬</text>
                  <text class="text-white text-sm">{{ isMuted ? '弹幕已关' : '弹幕已开' }}</text>
                </view>
              </view>

              <view class="flex items-center gap-3">
                <view @click="showChatPanel = true" class="flex items-center gap-1.5 px-4 py-2 rounded-full bg-white/10">
                  <text class="text-white text-sm">💬</text>
                  <text class="text-white text-sm">讨论</text>
                </view>
                <view @click="showFullscreenGiftPanel = true" class="flex items-center gap-1.5 px-4 py-2 rounded-full bg-gradient-to-r from-amber-500/80 to-orange-500/80">
                  <text class="text-white">🎁</text>
                  <text class="text-white text-sm">打赏</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 全屏弹幕 -->
        <view v-if="!isMuted && danmakuList.length > 0" class="absolute left-6 bottom-24 z-20 max-w-[40%] flex flex-col gap-2">
          <view v-for="d in danmakuList.slice(-4)" :key="d.id">
            <view class="inline-block px-3 py-1.5 bg-black/60 backdrop-blur-sm rounded-full">
              <text class="text-sm">
                <text class="text-[#C41E3A] mr-2">{{ d.user }}</text>
                <text class="text-white/90">{{ d.content }}</text>
              </text>
            </view>
          </view>
        </view>

        <!-- 讨论浮窗 -->
        <view v-if="showChatPanel" class="fixed inset-0 z-40" @click="showChatPanel = false">
          <view class="absolute right-0 top-0 bottom-0 w-80 bg-[#1a1a2e]/95 backdrop-blur-md border-l border-white/10 flex flex-col" @click.stop>
            <view class="flex items-center justify-between px-4 py-3 border-b border-white/10">
              <text class="text-white font-medium">实时讨论</text>
              <view @click="showChatPanel = false"><text class="text-white/60">✕</text></view>
            </view>
            <view class="flex-1 overflow-y-auto p-4 flex flex-col gap-3">
              <view v-for="d in danmakuList" :key="d.id" class="flex items-start gap-2">
                <view class="w-7 h-7 rounded-full bg-[#C41E3A]/20 flex items-center justify-center flex-shrink-0">
                  <text class="text-[10px] text-[#C41E3A]">{{ d.user[0] }}</text>
                </view>
                <view>
                  <text class="text-xs text-white/50 block">{{ d.user }}</text>
                  <text class="text-sm text-white/90">{{ d.content }}</text>
                </view>
              </view>
            </view>
            <view class="p-3 border-t border-white/10">
              <view class="flex items-center gap-2 h-10 px-4 bg-white/10 rounded-full">
                <input
                  v-model="message"
                  placeholder="发送弹幕..."
                  @confirm="handleSendMessage"
                  class="flex-1 bg-transparent text-sm text-white placeholder:text-white/40 outline-none"
                />
                <view @click="handleSendMessage" class="w-7 h-7 rounded-full bg-[#C41E3A] flex items-center justify-center">
                  <text class="text-white text-xs">📨</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 全屏礼物面板 -->
      <view v-if="showFullscreenGiftPanel" class="fixed inset-0 z-50 bg-black/60" @click="showFullscreenGiftPanel = false">
        <view class="absolute bottom-0 left-0 right-0 bg-[#1a1a2e] rounded-t-2xl p-6" @click.stop>
          <view class="flex items-center justify-between mb-5">
            <text class="text-white font-semibold text-lg">送礼物</text>
            <view @click="showFullscreenGiftPanel = false"><text class="text-white/60">✕</text></view>
          </view>
          <view class="grid grid-cols-6 gap-4">
            <view v-for="g in fullscreenGifts" :key="g.name" class="flex flex-col items-center gap-2 p-4 rounded-xl bg-white/5 border border-white/10">
              <text class="text-3xl">{{ g.icon }}</text>
              <text class="text-white text-sm">{{ g.name }}</text>
              <text class="text-amber-400 text-xs">{{ g.price }}币</text>
            </view>
          </view>
        </view>
      </view>
    </template>
  </view>

  <!-- ================================================================ -->
  <!-- 竖屏直播布局                                                       -->
  <!-- ================================================================ -->
  <view v-else class="fixed inset-0 bg-black flex flex-col overflow-hidden">
    <!-- 全屏视频区 -->
    <view class="absolute inset-0 bg-gradient-to-b from-gray-900 via-gray-800 to-gray-900">
      <view class="absolute inset-0 flex items-center justify-center">
        <view class="text-center opacity-30">
          <view class="w-24 h-24 rounded-full bg-white/10 flex items-center justify-center mx-auto mb-4">
            <text class="text-4xl">{{ live.type === 'commerce' ? '🛍️' : '📖' }}</text>
          </view>
          <text class="text-white/50 text-sm">直播画面</text>
        </view>
      </view>
    </view>

    <!-- ===== 顶部信息栏 ===== -->
    <view
      :class="['absolute top-0 left-0 right-0 z-30 transition-all duration-300', headerCollapsed ? 'opacity-70' : 'opacity-100']"
      @click="headerCollapsed = false"
    >
      <view class="bg-gradient-to-b from-black/70 via-black/40 to-transparent px-4 pt-12 pb-3">
        <view class="flex items-center justify-between">
          <!-- 主播信息胶囊 -->
          <view class="flex items-center gap-2 px-1.5 py-1.5 pr-3 bg-black/40 backdrop-blur-md rounded-full">
            <view class="relative">
              <view class="w-10 h-10 rounded-full border-2 border-red-500 bg-[#F5F1EB] flex items-center justify-center overflow-hidden">
                <text class="text-sm text-[#666]">{{ live.hostName[0] }}</text>
              </view>
              <view class="absolute bottom-0 right-0 w-3 h-3 bg-red-500 rounded-full border-2 border-black" />
            </view>
            <view class="min-w-0">
              <view class="flex items-center gap-1.5">
                <text class="text-sm font-medium text-white truncate max-w-[80px]">{{ live.hostName }}</text>
              </view>
              <text class="text-[10px] text-white/60">{{ formatCount(live.followerCount) }} 粉丝</text>
            </view>
            <view
              @click.stop="isFollowing = !isFollowing"
              :class="['h-7 px-3 rounded-full text-xs flex items-center ml-1', isFollowing ? 'bg-white/20 text-white' : 'bg-red-500 text-white']"
            >
              <text>{{ isFollowing ? '已关注' : '关注' }}</text>
            </view>
          </view>

          <!-- 右侧：在线人数 + 关闭 -->
          <view class="flex items-center gap-2">
            <view class="flex items-center gap-1 px-2.5 py-1.5 bg-black/40 backdrop-blur-md rounded-full">
              <text class="text-white/80 text-[10px]">👥</text>
              <text class="text-xs text-white">{{ formatCount(live.viewerCount) }}</text>
            </view>
            <view @click="goBack" class="w-8 h-8 rounded-full bg-black/40 backdrop-blur-md flex items-center justify-center">
              <text class="text-white">✕</text>
            </view>
          </view>
        </view>

        <!-- 标题 -->
        <view class="mt-2 overflow-hidden">
          <text class="text-xs text-white/80 truncate block">{{ live.title }}</text>
        </view>
      </view>
    </view>

    <!-- ===== 右上角人气榜 ===== -->
    <view class="absolute top-36 right-3 z-20">
      <view
        @click="showRank = !showRank"
        class="flex items-center gap-1 px-2 py-1 bg-gradient-to-r from-amber-500/80 to-orange-500/80 backdrop-blur-md rounded-full"
      >
        <text class="text-white text-[10px]">👑</text>
        <text class="text-[10px] text-white font-medium">榜单</text>
        <text class="text-white text-[10px]">{{ showRank ? '▲' : '▼' }}</text>
      </view>

      <!-- 榜单展开 -->
      <view v-if="showRank" class="mt-2 w-36 bg-black/60 backdrop-blur-md rounded-xl p-2 flex flex-col gap-1.5">
