    <!-- ===== 左侧弹幕 + 系统消息 ===== -->
    <view class="absolute left-3 bottom-44 right-24 z-10 flex flex-col gap-2 pointer-events-none">
      <!-- 系统消息 -->
      <view v-for="msg in systemMessages.slice(-1)" :key="msg.id"
        :class="['px-3 py-1.5 rounded-full text-xs w-fit max-w-full',
          msg.type === 'enter' ? 'bg-white/10 text-white/80' :
          msg.type === 'gift' ? 'bg-gradient-to-r from-amber-500/30 to-orange-500/30 text-amber-200' :
          'bg-gradient-to-r from-red-500/30 to-pink-500/30 text-pink-200']">
