                  <text class="text-red-400 font-bold text-base">¥{{ product.price }}</text>
                  <text class="text-[10px] text-white/40 line-through">¥{{ product.originalPrice }}</text>
                </view>
                <view class="flex items-center justify-between mt-1.5">
                  <text class="text-[10px] text-white/40">已售{{ product.sales }}</text>
                  <view
                    @click="handleAddToCart(product.id)"
                    :class="['px-3 py-1 rounded-full text-xs font-medium', product.isExplaining ? 'bg-red-500 text-white' : 'bg-white/10 text-white']"
                  >
                    <text>{{ product.isExplaining ? '抢购' : '加购' }}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 底部购物车 -->
        <view v-if="cartCount > 0" class="p-3 border-t border-white/10 flex-shrink-0">
          <view class="w-full py-2.5 bg-red-500 text-white rounded-full text-sm font-medium flex items-center justify-center gap-2">
            <text>🛒</text>
            <text>去结算 ({{ cartCount }})</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted, onUnmounted } from 'vue'

// ============================================================
// Mock data
// ============================================================
interface LiveRoomData {
  id: string
  title: string
  type: 'knowledge' | 'commerce'
  orientation: 'vertical' | 'horizontal'
  hostName: string
  hostAvatar: string
  hostTitle: string
  followerCount: number
  viewerCount: number
  likeCount: number
  isFollowed: boolean
}

const mockLiveData: Record<string, LiveRoomData> = {
  '1': {
    id: '1',
    title: '八字命理入门：如何快速解读四柱八字',
    type: 'knowledge',
    orientation: 'vertical',
    hostName: '易道先生',
    hostAvatar: '',
    hostTitle: '国学易经研究员',
    followerCount: 12800,
    viewerCount: 12580,
    likeCount: 58600,
    isFollowed: false,
  },
  '2': {
    id: '2',
    title: '开光吉祥物专场：招财貔貅、转运葫芦限时特惠',
    type: 'commerce',
    orientation: 'vertical',
    hostName: '福缘阁主',
    hostAvatar: '',
    hostTitle: '福缘阁创始人',
    followerCount: 8500,
    viewerCount: 8920,
    likeCount: 32100,
    isFollowed: false,
  },
  '3': {
    id: '3',
    title: '紫微斗数命盘解读实战课程',
    type: 'knowledge',
    orientation: 'horizontal',
    hostName: '紫微大师',
    hostAvatar: '',
    hostTitle: '紫微斗数传承人',
    followerCount: 15600,
    viewerCount: 5630,
    likeCount: 28900,
    isFollowed: false,
  },
}

// 课件数据
const mockSlides = [
  { id: 1, title: '第一章：紫微斗数概述', isCurrent: false },
  { id: 2, title: '第二章：十二宫位详解', isCurrent: false },
  { id: 3, title: '第三章：主星特性分析', isCurrent: true },
  { id: 4, title: '第四章：四化飞星入门', isCurrent: false },
  { id: 5, title: '第五章：命盘实例解读', isCurrent: false },
]

// 商品数据
const mockProducts = [
  { id: 'p1', name: '开光招财貔貅摆件', price: 299, originalPrice: 599, image: '', sales: 1280, stock: 56, isExplaining: true },
  { id: 'p2', name: '天然黄水晶转运葫芦', price: 168, originalPrice: 328, image: '', sales: 890, stock: 128, isExplaining: false },
  { id: 'p3', name: '紫檀木雕福禄寿三星', price: 1680, originalPrice: 2999, image: '', sales: 156, stock: 23, isExplaining: false },
]

// 弹幕
const mockDanmaku = [
  { id: 1, user: '易学爱好者', content: '讲得太好了！', type: 'normal' },
  { id: 2, user: '命理初学', content: '老师这个怎么看大运？', type: 'normal' },
  { id: 3, user: '紫微门人', content: '666', type: 'normal' },
  { id: 4, user: '风水小白', content: '感谢老师分享', type: 'normal' },
  { id: 5, user: '国学传承', content: '受益匪浅', type: 'normal' },
]

// 系统消息
const mockSystemMessages = [
  { id: 1, type: 'enter', user: '玄学新人', content: '进入了直播间' },
  { id: 2, type: 'gift', user: '易道弟子', content: '送出太极', giftIcon: '☯️' },
  { id: 3, type: 'buy', user: '福气满满', content: '购买了 开光招财貔貅摆件' },
]

// 打赏榜
const mockRankList = [
  { rank: 1, user: '易道传人', avatar: '', amount: 8888 },
  { rank: 2, user: '国学守护', avatar: '', amount: 5666 },
  { rank: 3, user: '玄学爱好', avatar: '', amount: 3288 },
]

// 国学风礼物
const giftList = [
  { id: 1, name: '太极', icon: '☯️', price: 1 },
  { id: 2, name: '梅花', icon: '🌸', price: 10 },
  { id: 3, name: '竹简', icon: '📜', price: 52 },
  { id: 4, name: '罗盘', icon: '🧭', price: 99 },
  { id: 5, name: '如意', icon: '🪬', price: 199 },
  { id: 6, name: '龙凤', icon: '🐉', price: 520 },
  { id: 7, name: '金元宝', icon: '🪙', price: 999 },
  { id: 8, name: '聚宝盆', icon: '🏆', price: 1888 },
]

// 横屏全屏礼物
const fullscreenGifts = [
  { name: '太极', price: 1, icon: '☯️' },
  { name: '梅花', price: 10, icon: '🌸' },
  { name: '竹简', price: 52, icon: '📜' },
  { name: '罗盘', price: 99, icon: '🧭' },
  { name: '玉如意', price: 199, icon: '🔮' },
  { name: '金元宝', price: 520, icon: '🏆' },
]

// 横屏底部Tab
const bottomTabs = [
  { key: 'chat', label: '讨论' },
  { key: 'slides', label: '课件' },
  { key: 'qa', label: '问答' },
  { key: 'files', label: '资料' },
  { key: 'intro', label: '简介' },
]

// 问答数据
const mockQA = [
  { id: 1, user: '易学小白', question: '老师，命宫化忌是不是一定不好？', time: '12:35', isOnWall: true },
  { id: 2, user: '紫微迷', question: '天机星在夫妻宫怎么解读？', time: '12:38', isOnWall: false },
  { id: 3, user: '命理爱好者', question: '太阴落陷需要注意什么？', time: '12:42', isOnWall: false },
]

// 资料数据
const mockFiles = [
  { id: 1, name: '紫微斗数入门讲义.pdf', size: '2.3MB', type: 'pdf' },
  { id: 2, name: '命盘实例分析案例集.pdf', size: '5.1MB', type: 'pdf' },
  { id: 3, name: '本课思维导图.png', size: '890KB', type: 'image' },
]

// ============================================================
// State
// ============================================================
const liveId = ref('1')
const live = ref<LiveRoomData | null>(null)

const isFollowing = ref(false)
const likeCount = ref(0)
const showProducts = ref(false)
const showGifts = ref(false)
const showRank = ref(false)
const message = ref('')
const danmakuList = ref<typeof mockDanmaku>([])
const systemMessages = ref<typeof mockSystemMessages>([])
const cartCount = ref(0)
const isMuted = ref(false)
const floatingHearts = ref<{ id: number; x: number }[]>([])
const headerCollapsed = ref(false)

// 竖屏电商状态
const currentProduct = ref(mockProducts[0])
const salesNotifications = ref<{ id: number; user: string; product: string }[]>([])
const liveSalesCount = ref(1280)
const salesAnimating = ref(false)

// 横屏OBS状态
const isFullscreen = ref(false)
const isVolumeMuted = ref(false)
const activeBottomTab = ref('chat')
const showFullscreenGiftPanel = ref(false)
const showChatPanel = ref(false)
const showFullscreenControls = ref(true)
const controlsTimer = ref<ReturnType<typeof setTimeout> | null>(null)

// 定时器引用
let danmakuTimer: ReturnType<typeof setInterval> | null = null
let systemMsgTimer: ReturnType<typeof setInterval> | null = null
let salesTimer: ReturnType<typeof setInterval> | null = null
let headerTimer: ReturnType<typeof setTimeout> | null = null

// ============================================================
// Lifecycle
// ============================================================
onMounted(() => {
  // 获取路由参数
  const pages = getCurrentPages()
  const currentPage = pages[pages.length - 1] as any
  if (currentPage?.options?.id) {
    liveId.value = currentPage.options.id
  }

  live.value = mockLiveData[liveId.value] || mockLiveData['1']
  if (!live.value) return

  likeCount.value = live.value.likeCount

  // 模拟弹幕滚动
  let danmakuIndex = 0
  danmakuTimer = setInterval(() => {
    if (danmakuIndex < mockDanmaku.length) {
      danmakuList.value = [...danmakuList.value.slice(-3), mockDanmaku[danmakuIndex]]
      danmakuIndex++
    } else {
      danmakuIndex = 0
    }
  }, 2500)

  // 模拟系统消息
  let sysIndex = 0
  systemMsgTimer = setInterval(() => {
    if (sysIndex < mockSystemMessages.length) {
      systemMessages.value = [...systemMessages.value.slice(-1), mockSystemMessages[sysIndex]]
      sysIndex++
    } else {
      sysIndex = 0
    }
  }, 4000)

  // 自动收起顶部栏
  headerTimer = setTimeout(() => {
    headerCollapsed.value = true
  }, 5000)

  // 模拟实时已售通知（电商直播）
  if (live.value.type === 'commerce') {
    const names = ['福气满满', '招财进宝', '玄学新人', '易道弟子', '国学传承', '命理初学', '紫微门人']
    salesTimer = setInterval(() => {
      const randomUser = names[Math.floor(Math.random() * names.length)]
      const randomProduct = mockProducts[Math.floor(Math.random() * mockProducts.length)]
      const notification = { id: Date.now(), user: randomUser, product: randomProduct.name.slice(0, 8) }
      salesNotifications.value = [...salesNotifications.value.slice(-2), notification]

      const increment = Math.floor(Math.random() * 3) + 1
      liveSalesCount.value += increment
      salesAnimating.value = true
      setTimeout(() => { salesAnimating.value = false }, 600)

      setTimeout(() => {
        salesNotifications.value = salesNotifications.value.filter(n => n.id !== notification.id)
      }, 3000)
    }, 4000)
  }
})

onUnmounted(() => {
  if (danmakuTimer) clearInterval(danmakuTimer)
  if (systemMsgTimer) clearInterval(systemMsgTimer)
  if (salesTimer) clearInterval(salesTimer)
  if (headerTimer) clearTimeout(headerTimer)
  if (controlsTimer.value) clearTimeout(controlsTimer.value)
})

// ============================================================
// Methods
// ============================================================
function formatCount(count: number): string {
  if (count >= 10000) return (count / 10000).toFixed(1) + '万'
  return String(count)
}

function handleLike() {
  likeCount.value += 1
  const newHeart = { id: Date.now(), x: Math.random() * 40 - 20 }
  floatingHearts.value = [...floatingHearts.value, newHeart]
  setTimeout(() => {
    floatingHearts.value = floatingHearts.value.filter(h => h.id !== newHeart.id)
  }, 1500)
}

function handleAddToCart(productId: string) {
  cartCount.value += 1
}

function handleSendMessage() {
  if (!message.value.trim()) return
  danmakuList.value = [
    ...danmakuList.value.slice(-3),
    { id: Date.now(), user: '我', content: message.value, type: 'normal' },
  ]
  message.value = ''
}

function resetControlsTimer() {
  if (controlsTimer.value) clearTimeout(controlsTimer.value)
  showFullscreenControls.value = true
  controlsTimer.value = setTimeout(() => {
    showFullscreenControls.value = false
  }, 3000)
}

function goBack() {
  uni.navigateBack()
}
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
@keyframes heart {
  0% { opacity: 1; transform: translateY(0) scale(1); }
  100% { opacity: 0; transform: translateY(-100px) scale(0.5); }
}
</style>
