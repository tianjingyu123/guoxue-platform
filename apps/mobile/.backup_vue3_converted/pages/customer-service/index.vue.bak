<template>
  <view class="flex flex-col h-screen bg-[#FAF8F5]">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 h-14">
        <view class="flex items-center gap-3">
          <view @click="goBack" class="p-2 -ml-2">
            <text class="text-xl text-[#2C2C2C]">←</text>
          </view>
          <view class="w-9 h-9 rounded-full bg-[#C41E3A]/10 flex items-center justify-center">
            <text class="text-xs text-[#C41E3A]">客</text>
          </view>
          <view>
            <view class="flex items-center gap-2">
              <text class="font-medium text-sm text-[#2C2C2C]">智能客服</text>
              <text v-if="sessionStatus === 'waiting'" class="text-[10px] px-1.5 py-0.5 rounded bg-[#F5F1EB] text-[#999]">排队中</text>
              <text v-if="sessionStatus === 'human'" class="text-[10px] px-1.5 py-0.5 rounded bg-green-500 text-white">人工服务</text>
            </view>
            <text class="text-[11px] text-[#999] block">{{ config?.workingHours ? '服务时间 ' + config.workingHours : '在线服务' }}</text>
          </view>
        </view>

        <view v-if="sessionStatus === 'ai'" @click="showTransferDialog = true" class="px-3 py-1.5 border border-[#E8E0D5] rounded-lg text-xs flex items-center gap-1 text-[#666]">
          <text>🎧</text>
          <text>转人工</text>
        </view>
        <view v-if="sessionStatus === 'waiting'" @click="handleCancelTransfer" class="px-3 py-1.5 border border-[#E8E0D5] rounded-lg text-xs text-[#666]">取消排队</view>
      </view>
    </view>

    <!-- 加载中 -->
    <view v-if="isLoading" class="flex-1 flex flex-col items-center justify-center">
      <text class="text-[#999] text-sm">连接客服中...</text>
    </view>

    <!-- 对话区域 -->
    <scroll-view v-else ref="scrollViewRef" scroll-y class="flex-1 px-4 py-4" scroll-with-animation :scroll-into-view="scrollToId">
      <view class="max-w-3xl mx-auto space-y-4">
        <view v-for="(msg, msgIndex) in messages" :key="msg.id" :id="'msg-' + msg.id">
          <!-- 系统消息 -->
          <view v-if="msg.role === 'system'" class="flex justify-center">
            <view class="bg-[#F0EBE5]/50 rounded-lg px-4 py-2 text-sm text-[#999] text-center max-w-xs">
              <view v-if="msg.type === 'transfer' && msg.transfer" class="flex items-center gap-2">
                <text class="animate-spin text-sm">⏳</text>
                <text>排队中 第{{ msg.transfer.queuePosition }}位 预计{{ msg.transfer.estimatedWait }}</text>
              </view>
              <text v-if="msg.type !== 'transfer'">{{ msg.content }}</text>
            </view>
          </view>

          <!-- 用户消息 -->
          <view v-if="msg.role === 'user'" class="flex justify-end mb-2">
            <view class="max-w-[80%]">
              <view v-if="msg.type === 'image' && msg.image" class="max-w-[200px] rounded-lg overflow-hidden mb-1">
                <image :src="msg.image.url" mode="aspectFill" class="w-full h-auto" />
              </view>
              <view v-if="msg.type === 'text'" class="bg-[#C41E3A] text-white rounded-2xl rounded-tr-sm px-4 py-2.5">
                <text class="text-sm">{{ msg.content }}</text>
              </view>
              <view class="text-[10px] text-[#999] text-right mt-1">{{ formatTime(msg.createdAt) }}</view>
            </view>
          </view>

          <!-- AI/人工消息 -->
          <view v-if="msg.role === 'assistant' || msg.role === 'human'" class="flex gap-3 mb-2">
            <view class="w-8 h-8 rounded-full bg-[#C41E3A]/10 flex items-center justify-center flex-shrink-0">
              <text class="text-xs text-[#C41E3A]">{{ msg.role === 'human' ? '人' : 'AI' }}</text>
            </view>
            <view class="flex-1 space-y-2">
              <view class="bg-[#F0EBE5] rounded-2xl rounded-tl-sm px-4 py-3 max-w-[85%]">
                <!-- 消息内容 -->
                <view class="text-sm text-[#2C2C2C] leading-relaxed">
                  <text>{{ msg.content }}</text>
                  <text v-if="msg.isStreaming" class="inline-block w-2 h-4 bg-[#C41E3A] ml-1 animate-pulse" />
                </view>

                <!-- 知识引用 -->
                <view v-if="msg.references && msg.references.length > 0" class="mt-3 pt-3 border-t border-[#E8E0D5]/50">
                  <text class="text-xs text-[#999] mb-2 block">相关帮助：</text>
                  <view class="space-y-1">
                    <view v-for="ref in msg.references" :key="ref.id" @click="goToUrl(ref.url)" class="flex items-center gap-1 text-xs text-[#C41E3A]">
                      <text>🔗</text>
                      <text>{{ ref.title }}</text>
                    </view>
                  </view>
                </view>
              </view>

              <!-- 推荐问题 -->
              <view v-if="msg.suggestions && msg.suggestions.length > 0" class="flex flex-wrap gap-2">
                <text v-for="(suggestion, i) in msg.suggestions" :key="i"
                  @click="handleSend(suggestion)"
                  class="inline-block px-3 py-1.5 rounded-full text-xs border border-[#E8E0D5] text-[#666] bg-white"
                >
                  {{ suggestion }}
                </text>
              </view>

              <!-- 满意度评价 -->
              <view v-if="!msg.isStreaming && msg.type === 'text' && !msg.rating" class="flex items-center gap-2">
                <text class="text-[10px] text-[#999]">这条回复有帮助吗？</text>
                <text @click="startRating(msg.id, 'positive')" class="text-sm text-[#999] px-1">👍</text>
                <text @click="startRating(msg.id, 'negative')" class="text-sm text-[#999] px-1">👎</text>
              </view>
              <view v-if="msg.rating" class="flex items-center gap-1 text-[10px] text-[#999]">
                <text v-if="msg.rating.value === 'positive'" class="text-green-500">👍 已反馈有帮助</text>
                <text v-else>👎 已反馈</text>
              </view>
            </view>
          </view>
        </view>
        <view id="msg-end" />
      </view>
    </scroll-view>

    <!-- 快捷建议 -->
    <view v-if="suggestions.length > 0" class="px-4 py-2 border-t border-[#E8E0D5]">
      <scroll-view scroll-x class="flex gap-2" style="white-space: nowrap;">
        <text v-for="(suggestion, i) in suggestions" :key="i"
          @click="handleSend(suggestion)"
          class="inline-block px-3 py-1.5 bg-[#F5F1EB] text-sm text-[#999] rounded-full"
        >
          {{ suggestion }}
        </text>
      </scroll-view>
    </view>

    <!-- 图片上传区域 -->
    <view v-if="uploadPreview" class="px-4 py-2 border-t border-[#E8E0D5] bg-white">
      <view class="flex items-center gap-2">
        <view class="relative w-12 h-12 rounded-lg bg-[#F5F1EB] overflow-hidden">
          <image :src="uploadPreview" mode="aspectFill" class="w-full h-full" />
          <view @click="uploadPreview = ''" class="absolute -top-1.5 -right-1.5 w-4 h-4 rounded-full bg-[#FF4D4F] flex items-center justify-center">
            <text class="text-white text-[8px]">✕</text>
          </view>
        </view>
        <text class="text-xs text-[#999]">点击发送上传图片</text>
      </view>
    </view>

    <!-- 输入区域 -->
    <view class="border-t border-[#E8E0D5] bg-white/95 px-4 py-3" style="padding-bottom: calc(env(safe-area-inset-bottom) + 12px);">
      <view class="flex items-center gap-3">
        <text @click="handleImageTap" class="text-lg text-[#999] px-1">📷</text>
        <input v-model="inputValue" @confirm="handleSend()" placeholder="请输入您的问题..." :disabled="isSending"
          class="flex-1 h-10 px-4 rounded-full bg-[#F5F1EB] text-sm text-[#2C2C2C] placeholder:text-[#999] outline-none" />
        <view @click="handleSend()" :class="['w-10 h-10 rounded-full flex items-center justify-center', inputValue.trim() && !isSending ? 'bg-[#C41E3A]' : 'bg-[#F5F1EB]']">
          <text v-if="isSending" class="text-white text-sm animate-spin">⏳</text>
          <text v-else :class="inputValue.trim() ? 'text-white' : 'text-[#999]'" class="text-sm">➤</text>
        </view>
      </view>
    </view>

    <!-- 转人工对话框 -->
    <view v-if="showTransferDialog" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-6">
      <view class="bg-white rounded-2xl overflow-hidden w-full max-w-sm">
        <view class="p-5">
          <text class="font-semibold text-lg text-[#2C2C2C] block mb-2">转接人工客服</text>
          <text class="text-sm text-[#999] block mb-2">
            <text v-if="true">当前有 {{ config?.currentQueueCount || 3 }} 人排队，预计等待约 {{ Math.ceil((config?.currentQueueCount || 3) * 2) }} 分钟。</text>
          </text>
          <text class="text-sm text-[#999] block">是否确认转接人工客服？</text>
        </view>
        <view class="flex border-t border-[#E8E0D5]">
          <view @click="showTransferDialog = false" class="flex-1 py-3 text-center text-sm text-[#666]" style="border-right:1px solid #E8E0D5;">取消</view>
          <view @click="handleTransfer" :class="['flex-1 py-3 text-center text-sm font-medium', isTransferring ? 'text-[#999]' : 'text-[#C41E3A]']">
            {{ isTransferring ? '转接中...' : '确认转接' }}
          </view>
        </view>
      </view>
    </view>

    <!-- 负面评价详情对话框 -->
    <view v-if="showRatingDialog" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-6">
      <view class="bg-white rounded-2xl overflow-hidden w-full max-w-sm">
        <view class="p-5">
          <text class="font-semibold text-lg text-[#2C2C2C] block mb-1">反馈问题</text>
          <text class="text-sm text-[#999] block mb-4">感谢您的反馈，请告诉我们这条回复哪里不满意，帮助我们改进。</text>
          <textarea v-model="ratingComment" placeholder="请描述您的问题或建议（选填）"
            class="w-full h-24 px-3 py-2 text-sm bg-[#F5F1EB] rounded-xl border-0 resize-none outline-none placeholder:text-[#999]"
            maxlength="200" />
        </view>
        <view class="flex border-t border-[#E8E0D5]">
          <view @click="showRatingDialog = false; ratingValue = null; ratingComment = ''" class="flex-1 py-3 text-center text-sm text-[#666]" style="border-right:1px solid #E8E0D5;">取消</view>
          <view @click="handleSubmitRating" class="flex-1 py-3 text-center text-sm font-medium text-[#C41E3A]">提交反馈</view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, nextTick } from 'vue'
import { onMounted } from 'vue'

type CSSessionStatus = 'ai' | 'human' | 'waiting'

interface CSMessage {
  id: string
  role: 'user' | 'assistant' | 'human' | 'system'
  type: 'text' | 'image' | 'transfer'
  content: string
  isStreaming?: boolean
  image?: { url: string }
  transfer?: { queuePosition: number; estimatedWait: string }
  suggestions?: string[]
  references?: { id: string; title: string; url: string }[]
  rating?: { value: 'positive' | 'negative'; comment?: string }
  createdAt: string
}

interface CSConfig {
  workingHours?: string
  welcomeMessage: string
  suggestions: string[]
  isHumanAvailable?: boolean
  currentQueueCount?: number
}

const messages = ref<CSMessage[]>([])
const inputValue = ref('')
const sessionStatus = ref<CSSessionStatus>('ai')
const config = ref<CSConfig | null>(null)
const sessionId = ref('')
const isLoading = ref(true)
const isSending = ref(false)
const isTransferring = ref(false)
const showTransferDialog = ref(false)
const showRatingDialog = ref(false)
const ratingMessageId = ref('')
const ratingValue = ref<'positive' | 'negative' | null>(null)
const ratingComment = ref('')
const suggestions = ref<string[]>([])
const uploadPreview = ref('')
const scrollToId = ref('')
const scrollViewRef = ref<any>(null)

const mockReplies: Record<string, string> = {
  '你好': '您好！我是热卜国学智能客服，很高兴为您服务！您可以问我关于课程、排盘、订单等方面的问题。',
  '课程': '我们有丰富的国学课程体系，包括八字命理、紫微斗数、风水堪舆、周易八卦等。您可以前往「课程」页面浏览全部课程。',
  '排盘': '排盘工具是我们平台的核心功能，支持八字、紫微斗数、风水等多种排盘方式。进入首页点击底部「排盘」即可使用。',
  '订单': '您可以在「我的」-「我的订单」中查看所有订单记录。如需售后帮助，请描述具体问题。',
  '充值': '在「我的」-「钱包」页面可以进行充值，支持微信和支付宝支付。国学币与人民币比例为10:1。',
  '客服': '我就是智能客服小助手！如果我的回答不能解决您的问题，可以点击右上角「转人工」联系人工客服。',
}

// Mock API calls
const getCSConfig = async (): Promise<{ code: number; data: CSConfig }> => ({
  code: 200,
  data: {
    workingHours: '09:00-21:00',
    welcomeMessage: '您好！我是热卜国学智能客服助手，很高兴为您服务。我可以帮您解答关于课程学习、排盘使用、订单支付等方面的问题。请描述您的问题。',
    suggestions: ['课程购买问题', '如何使用排盘', '账户充值', '联系老师', '退款政策'],
    isHumanAvailable: true,
    currentQueueCount: 3,
  }
})

const getOrCreateCSSession = async () => ({ code: 200, data: { id: 'session_' + Date.now() } })

onMounted(async () => {
  try {
    const [configRes] = await Promise.all([getCSConfig()])
    if (configRes.code === 200) {
      config.value = configRes.data
      const welcomeMsg: CSMessage = {
        id: 'welcome', role: 'assistant', type: 'text',
        content: configRes.data.welcomeMessage,
        suggestions: configRes.data.suggestions,
        createdAt: new Date().toISOString(),
      }
      messages.value = [welcomeMsg]
      suggestions.value = configRes.data.suggestions
    }
    sessionId.value = 'session_' + Date.now()
  } finally {
    isLoading.value = false
  }
  scrollToBottom()
})

function scrollToBottom() {
  nextTick(() => {
    scrollToId.value = 'msg-end'
  })
}

function formatTime(isoStr: string): string {
  const d = new Date(isoStr)
  return d.getHours().toString().padStart(2, '0') + ':' + d.getMinutes().toString().padStart(2, '0')
}

// 发送消息
async function handleSend(content?: string) {
  const text = content || inputValue.value.trim()
  if (!text || isSending.value) return

  // If there's an image preview, send as image
  if (uploadPreview.value) {
    const imgMsg: CSMessage = {
      id: 'img_' + Date.now(), role: 'user', type: 'image',
      content: '', image: { url: uploadPreview.value },
      createdAt: new Date().toISOString(),
    }
    messages.value.push(imgMsg)
    uploadPreview.value = ''
    scrollToBottom()
    return
  }

  inputValue.value = ''
  isSending.value = true
  suggestions.value = []

  const userMsg: CSMessage = {
    id: 'user_' + Date.now(), role: 'user', type: 'text',
    content: text, createdAt: new Date().toISOString(),
  }
  messages.value.push(userMsg)
  scrollToBottom()

  // Add AI reply placeholder with streaming
  const aiMsgId = 'ai_' + Date.now()
  const aiMsg: CSMessage = {
    id: aiMsgId, role: 'assistant', type: 'text',
    content: '', isStreaming: true, createdAt: new Date().toISOString(),
  }
  messages.value.push(aiMsg)
  scrollToBottom()

  // Mock streaming reply
  const reply = Object.entries(mockReplies).find(([key]) => text.includes(key))
  const responseText = reply
    ? reply[1]
    : '感谢您的咨询！我已收到您的问题：「' + text + '」。我们的知识库正在为您查找最准确的答案。如需人工服务，请点击右上角「转人工」。'

  // Simulate streaming effect
  let displayedText = ''
  for (let i = 0; i < responseText.length; i++) {
    await new Promise(resolve => setTimeout(resolve, 20 + Math.random() * 30))
    displayedText += responseText[i]
    messages.value = messages.value.map(msg =>
      msg.id === aiMsgId ? { ...msg, content: displayedText } : msg
    )
    scrollToBottom()
  }

  // Complete
  const followUpSuggestions = ['转人工客服', '发送订单号', '查看帮助中心', '结束对话']

  messages.value = messages.value.map(msg =>
    msg.id === aiMsgId
      ? {
          ...msg,
          isStreaming: false,
          suggestions: followUpSuggestions,
          references: [
            { id: 'ref1', title: '帮助中心 - 常见问题', url: '/pages/help/index' },
            { id: 'ref2', title: '如何联系人工客服', url: '/pages/help/index?q=contact' },
          ]
        }
      : msg
  )
  isSending.value = false
  suggestions.value = followUpSuggestions
  scrollToBottom()
}

// 图片上传
function handleImageTap() {
  uni.chooseImage({
    count: 1,
    sizeType: ['compressed'],
    success: (res) => {
      if (res.tempFilePaths && res.tempFilePaths.length > 0) {
        uploadPreview.value = res.tempFilePaths[0]
      }
    }
  })
}

// 转人工
async function handleTransfer() {
  isTransferring.value = true
  sessionStatus.value = 'waiting'
  const sysMsg: CSMessage = {
    id: 'transfer_' + Date.now(), role: 'system', type: 'transfer',
    content: '已为您转接人工客服，当前排队3人，预计等待5分钟',
    transfer: { queuePosition: 3, estimatedWait: '5分钟' },
    createdAt: new Date().toISOString(),
  }
  messages.value.push(sysMsg)
  isTransferring.value = false
  showTransferDialog.value = false
  scrollToBottom()
}

function handleCancelTransfer() {
  sessionStatus.value = 'ai'
  const sysMsg: CSMessage = {
    id: 'cancel_' + Date.now(), role: 'system', type: 'text',
    content: '已取消排队，继续由智能客服为您服务',
    createdAt: new Date().toISOString(),
  }
  messages.value.push(sysMsg)
  scrollToBottom()
}

// 评价
function startRating(messageId: string, value: 'positive' | 'negative') {
  ratingMessageId.value = messageId
  ratingValue.value = value
  if (value === 'negative') {
    showRatingDialog.value = true
  } else {
    // Directly submit positive rating
    messages.value = messages.value.map(msg =>
      msg.id === messageId
        ? { ...msg, rating: { value: 'positive' as const } }
        : msg
    )
    uni.showToast({ title: '感谢您的反馈！', icon: 'none' })
  }
}

function handleSubmitRating() {
  if (!ratingValue.value) return
  messages.value = messages.value.map(msg =>
    msg.id === ratingMessageId.value
      ? { ...msg, rating: { value: ratingValue.value as 'positive' | 'negative', comment: ratingComment.value || undefined } }
      : msg
  )
  showRatingDialog.value = false
  ratingMessageId.value = ''
  ratingValue.value = null
  ratingComment.value = ''
  uni.showToast({ title: '感谢您的反馈！', icon: 'none' })
}

function goToUrl(url: string) {
  uni.navigateTo({ url })
}

function goBack() { uni.navigateBack() }
</script>

<style scoped>
.animate-pulse {
  animation: pulse 1s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
.animate-spin {
  animation: spin 1s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
</style>
