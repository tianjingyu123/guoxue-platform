<template>
  <view class="min-h-screen bg-[#FAF8F5]">
    <!-- ===== 已认证通过 ===== -->
    <template v-if="status === 'approved'">
      <view class="min-h-screen bg-[#FAF8F5] flex flex-col items-center justify-center px-8 text-center">
        <text class="text-5xl text-green-500 mb-4">✅</text>
        <text class="text-xl font-bold text-[#2C2C2C] mb-2">认证已通过</text>
        <text class="text-sm text-[#999]">您已是平台认证讲师，享有专属权益。</text>
      </view>
    </template>

    <!-- ===== 审核中 ===== -->
    <template v-else-if="status === 'pending'">
      <view class="min-h-screen bg-[#FAF8F5] flex flex-col items-center justify-center px-8 text-center">
        <text class="text-5xl text-orange-500 mb-4">⏳</text>
        <text class="text-xl font-bold text-[#2C2C2C] mb-2">审核中</text>
        <text class="text-sm text-[#999]">您的认证申请正在审核中，预计 3-5 个工作日完成。</text>
      </view>
    </template>

    <!-- ===== 认证表单 ===== -->
    <template v-else>
      <header class="sticky top-0 z-10 bg-[#FAF8F5] border-b border-[#E8E0D5] flex items-center px-4 h-12 gap-3">
        <view @click="goBack" class="p-1"><text class="text-xl text-[#2C2C2C]">←</text></view>
        <text class="text-base font-semibold text-[#2C2C2C]">讲师认证</text>
      </header>

      <!-- 步骤进度 -->
      <view class="flex items-center px-6 pt-5 pb-4 gap-2">
        <view v-for="s in 3" :key="s" class="flex items-center flex-1">
          <view class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold shrink-0"
            :class="step >= s ? 'bg-[#C41E3A] text-white' : 'bg-[#F0EBE5] text-[#999]'">{{ s }}</view>
          <view v-if="s < 3" class="flex-1 h-0.5 mx-1" :class="step > s ? 'bg-[#C41E3A]' : 'bg-[#F0EBE5]'" />
        </view>
      </view>
      <view class="flex justify-between px-6 mb-6 text-xs text-[#999]">
        <text :class="step >= 1 ? 'text-[#C41E3A]' : ''">基本信息</text>
        <text :class="step >= 2 ? 'text-[#C41E3A]' : ''">资质证明</text>
        <text :class="step >= 3 ? 'text-[#C41E3A]' : ''">完成</text>
      </view>

      <!-- 步骤1：基本信息 -->
      <view v-if="step === 1" class="px-4 pb-24 space-y-4">
        <view v-for="f in step1Fields" :key="f.key">
          <text class="text-sm font-medium text-[#2C2C2C] block mb-1.5">{{ f.label }}</text>
          <input v-model="form[f.key]" :placeholder="f.placeholder"
            class="w-full h-11 px-3 rounded-xl text-sm box-border" style="border:1px solid rgba(232,224,213,0.6);background:#FAF8F5" />
        </view>
        <view>
          <text class="text-sm font-medium text-[#2C2C2C] block mb-1.5">个人简介</text>
          <textarea v-model="form.bio" placeholder="请介绍您的专业背景、教学经验和研究成果"
            class="w-full px-3 py-2 text-sm rounded-lg resize-none box-border" rows="4"
            style="border:1px solid rgba(232,224,213,0.6);background:#FAF8F5" />
        </view>
        <view class="fixed bottom-0 left-0 right-0 bg-[#FAF8F5] border-t border-[#E8E0D5] px-4 py-4">
          <view @click="step = 2"
            class="w-full py-3 text-center text-white font-medium rounded-xl"
            :class="form.realName && form.specialty ? 'bg-[#C41E3A]' : 'bg-[#ccc]'"
          >下一步</view>
        </view>
      </view>

      <!-- 步骤2：资质证明 -->
      <view v-if="step === 2" class="px-4 pb-24 space-y-4">
        <text class="text-xs text-[#999] block mb-2">请上传专业资质证书，支持 JPG、PNG 格式，单张不超过 5MB。</text>
        <view v-for="f in certFields" :key="f.key">
          <text class="text-sm font-medium text-[#2C2C2C] block mb-1.5">{{ f.label }}</text>
          <view @click="uploadCert(f.key)"
            class="border-2 border-dashed rounded-xl p-6 flex flex-col items-center gap-2"
            :class="form[f.key] ? 'border-[#C41E3A]/50 bg-[#C41E3A]/5' : 'border-[#E8E0D5]'">
            <template v-if="form[f.key]">
              <text class="text-3xl text-[#C41E3A]">📄</text>
              <text class="text-sm text-[#C41E3A] font-medium">已上传</text>
            </template>
            <template v-else>
              <text class="text-3xl text-[#999]">📤</text>
              <text class="text-sm text-[#999]">点击上传证书图片</text>
            </template>
          </view>
        </view>
        <view class="fixed bottom-0 left-0 right-0 bg-[#FAF8F5] border-t border-[#E8E0D5] px-4 py-4 flex gap-3">
          <view @click="step = 1" class="flex-1 py-3 text-center text-sm font-medium rounded-xl" style="border:1px solid rgba(232,224,213,0.6);color:#2C2C2C">上一步</view>
          <view @click="handleSubmit" class="flex-1 py-3 text-center text-white text-sm font-medium rounded-xl" style="background:#C41E3A">
            {{ loading ? '⏳ 提交中...' : '提交申请' }}
          </view>
        </view>
      </view>

      <!-- 步骤3：提交成功 -->
      <view v-if="step === 3" class="flex flex-col items-center justify-center px-8 text-center" style="min-height:60vh">
        <text class="text-5xl text-green-500 mb-4">✅</text>
        <text class="text-xl font-bold text-[#2C2C2C] mb-2">申请已提交</text>
        <text class="text-sm text-[#999] mb-8">您的讲师认证申请已收到，我们将在 3-5 个工作日内完成审核，结果将通过站内通知告知您。</text>
        <view @click="goHome" class="w-full py-3 text-center text-white font-medium rounded-xl" style="background:#C41E3A">返回首页</view>
      </view>
    </template>
  </view>
</template>

<script setup lang="ts">
import { ref, reactive } from 'vue'

type CertStatus = 'none' | 'pending' | 'approved' | 'rejected'

const status = ref<CertStatus>('none')
const step = ref(1)
const loading = ref(false)

const form = reactive<Record<string, string>>({
  realName: '', idCard: '', specialty: '', experience: '', bio: '',
  cert1: '', cert2: '',
})

const step1Fields = [
  { key: 'realName', label: '真实姓名', placeholder: '请输入真实姓名' },
  { key: 'idCard', label: '身份证号', placeholder: '请输入18位身份证号' },
  { key: 'specialty', label: '专业领域', placeholder: '如：八字命理、风水堪舆' },
  { key: 'experience', label: '从业年限', placeholder: '如：5年' },
]

const certFields = [
  { key: 'cert1', label: '资质证书 1（必填）' },
  { key: 'cert2', label: '资质证书 2（选填）' },
]

function uploadCert(key: string) {
  form[key] = 'uploaded'
  uni.showToast({ title: '上传成功', icon: 'success' })
}

async function handleSubmit() {
  if (loading.value) return
  loading.value = true
  await new Promise(resolve => setTimeout(resolve, 1500))
  loading.value = false
  step.value = 3
}

function goBack() { uni.navigateBack() }
function goHome() { uni.switchTab({ url: '/pages/home/index' }) }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
