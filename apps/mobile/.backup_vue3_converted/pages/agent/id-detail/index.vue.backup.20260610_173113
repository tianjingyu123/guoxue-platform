        </view>
        <view :class="['max-w-[80%] rounded-2xl px-4 py-3', msg.role === 'user' ? 'bg-[#C41E3A] text-white rounded-tr-md' : 'bg-[#F5F1EB] text-[#2C2C2C] rounded-tl-md']">
          <text class="text-sm leading-relaxed">{{ msg.content }}</text>
          <!-- 推荐卡片区域 -->
          <view v-if="msg.recommendations && msg.recommendations.length" class="mt-3 space-y-2">
            <text class="text-xs text-[#999] flex items-center gap-1">✨ 为您推荐</text>
            <view v-for="(rec, idx) in msg.recommendations" :key="idx">
              <!-- 课程推荐 -->
              <view v-if="rec.type === 'course'" @click="goTo('/pages/course/' + rec.data.id + '/index')" class="flex gap-3 p-3 rounded-xl bg-gradient-to-r from-primary/5 to-accent/5 border border-primary/10">
                <view class="w-16 h-16 rounded-xl bg-gradient-to-br from-primary/20 to-accent/20 flex items-center justify-center flex-shrink-0">
