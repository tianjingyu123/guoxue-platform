<template>
  <view class="min-h-screen bg-[#FAF8F5] flex flex-col">
    <view class="flex items-center justify-between px-4 h-12 bg-white border-b border-[#E8E0D5] shrink-0">
      <view class="p-1" @click="goBack"><text class="text-xl text-[#2C2C2C]">&#8249;</text></view>
      <text class="text-base font-semibold text-[#2C2C2C]">智能体</text>
      <view class="w-7" />
    </view>

    <!-- 加载骨架屏 -->
    <view v-if="loading" class="flex-1 p-4 space-y-3">
      <view class="flex gap-2 mb-2">
        <view v-for="i in 4" :key="i" class="h-8 w-16 bg-[#F0EDE8] rounded-full animate-pulse" />
      </view>
      <view v-for="i in 5" :key="i" class="flex items-center gap-3 bg-white rounded-xl p-3.5 animate-pulse">
        <view class="w-12 h-12 bg-[#F0EDE8] rounded-xl" />
        <view class="flex-1 space-y-2">
          <view class="h-4 w-2/3 bg-[#F0EDE8] rounded" />
          <view class="h-3 w-4/5 bg-[#F0EDE8] rounded" />
        </view>
      </view>
    </view>

    <!-- 主体 -->
    <view v-else class="flex-1 flex flex-col">
      <!-- 分类Tab -->
      <view class="flex gap-2 px-4 py-3 bg-white border-b border-[#E8E0D5] overflow-x-auto">
        <view
          v-for="t in categories" :key="t.key"
          @click="activeCat = t.key"
          :class="['px-4 py-1.5 rounded-full text-sm whitespace-nowrap shrink-0', activeCat === t.key ? 'bg-[#C41E3A] text-white' : 'bg-[#F5F1EB] text-[#999]']"
        >{{ t.label }}</view>
      </view>

      <scroll-view scroll-y class="flex-1 p-4 overflow-y-auto">
        <view v-if="filteredAgents.length === 0" class="text-center py-20">
          <text class="text-4xl text-[#E8E0D5] block mb-3">🤖</text>
          <text class="text-[#999] text-sm">暂无智能体</text>
        </view>

        <!-- 按分类分组 -->
        <view v-for="agent in filteredAgents" :key="agent.id" class="flex items-start gap-3 bg-white rounded-xl p-3.5 mb-2.5 shadow-sm" @click="goChat(agent)">
          <view class="w-11 h-11 rounded-xl flex items-center justify-center shrink-0" :style="{ background: agent.gradient }">
            <text>{{ agent.icon }}</text>
          </view>
          <view class="flex-1 min-w-0">
            <view class="flex items-center gap-2">
              <text class="text-sm font-medium text-[#2C2C2C]">{{ agent.name }}</text>
              <view v-if="agent.hot" class="px-1.5 py-0.5 bg-[#C41E3A]/10 text-[#C41E3A] text-[10px] rounded">热门</view>
              <view v-if="agent.new" class="px-1.5 py-0.5 bg-blue-50 text-blue-500 text-[10px] rounded">新</view>
            </view>
            <text class="text-xs text-[#999] mt-0.5 block">{{ agent.desc }}</text>
            <view class="flex items-center gap-2 mt-1.5">
              <text class="text-[10px] text-[#C9A96E] bg-[#C9A96E]/10 px-1.5 py-0.5 rounded">{{ agent.tag }}</text>
              <text class="text-[10px] text-[#999]">{{ agent.usage }} 次对话</text>
            </view>
          </view>
          <text class="text-lg text-[#ccc] shrink-0">&#8250;</text>
        </view>
        <view class="h-5" />
      </scroll-view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

interface Agent {
  id: string
  name: string
  icon: string
  desc: string
  tag: string
  gradient: string
  hot: boolean
  new: boolean
  usage: string
  category: string
}

const loading = ref(true)
const activeCat = ref('all')

const categories = [
  { key: 'all', label: '全部' },
  { key: 'bazi', label: '八字命理' },
  { key: 'ziwei', label: '紫微斗数' },
  { key: 'zhanbu', label: '占卜预测' },
  { key: 'fengshui', label: '风水堪舆' },
  { key: 'other', label: '其他' },
]

const agents = ref<Agent[]>([
  { id: '1', name: '八字命理大师', icon: '🧮', desc: '专业八字排盘与命理解读，四柱分析+大运流年', tag: '八字', gradient: 'linear-gradient(135deg, #C41E3A20, #C9A96E20)', hot: true, new: false, usage: '12.8万', category: 'bazi' },
  { id: '2', name: '紫微斗数分析师', icon: '⭐', desc: '十二宫四化深度解析，格局论断+流月推演', tag: '紫微', gradient: 'linear-gradient(135deg, #722ED120, #4A90D920)', hot: true, new: false, usage: '9.6万', category: 'ziwei' },
  { id: '3', name: '六爻占卜师', icon: '🪷', desc: '铜钱卦象专业断事，六爻纳甲+世应用神', tag: '六爻', gradient: 'linear-gradient(135deg, #F59E0B20, #EF444420)', hot: true, new: false, usage: '15.3万', category: 'zhanbu' },
  { id: '4', name: '奇门遁甲军师', icon: '🏛️', desc: '奇门排盘与运筹帷幄，阳盘阴盘+飞盘转盘', tag: '奇门', gradient: 'linear-gradient(135deg, #52C41A20, #C9A96E20)', hot: false, new: true, usage: '5.2万', category: 'zhanbu' },
  { id: '5', name: '风水堪舆顾问', icon: '🏔️', desc: '阳宅阴宅风水布局，八宅玄空+寻龙点穴', tag: '风水', gradient: 'linear-gradient(135deg, #4A90D920, #52C41A20)', hot: false, new: false, usage: '7.8万', category: 'fengshui' },
  { id: '6', name: '择日通书师', icon: '📅', desc: '黄道吉日精选，建除十二神+二十八宿', tag: '择日', gradient: 'linear-gradient(135deg, #C9A96E20, #F59E0B20)', hot: false, new: false, usage: '3.4万', category: 'other' },
  { id: '7', name: '梅花易数师', icon: '🌸', desc: '象数理占，观物取象，随时随地起卦断事', tag: '梅花', gradient: 'linear-gradient(135deg, #EC489920, #F59E0B20)', hot: false, new: true, usage: '4.1万', category: 'zhanbu' },
  { id: '8', name: '姓名学专家', icon: '📛', desc: '五格剖象+三才配置+生肖喜忌综合分析', tag: '姓名', gradient: 'linear-gradient(135deg, #64748B20, #3B82F620)', hot: false, new: false, usage: '2.6万', category: 'other' },
])

const filteredAgents = computed(() => {
  if (activeCat.value === 'all') return agents.value
  return agents.value.filter(a => a.category === activeCat.value)
})

onMounted(() => {
  setTimeout(() => { loading.value = false }, 400)
})

function goBack() { uni.navigateBack() }
function goChat(a: Agent) { uni.navigateTo({ url: `/pages/agent/id-detail/index?id=${a.id}` }) }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
</style>
