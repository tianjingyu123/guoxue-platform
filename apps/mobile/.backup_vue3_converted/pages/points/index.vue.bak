<template>
  <!-- 骨架屏 -->
  <view v-if="loading" class="min-h-screen bg-[#FAF8F5] animate-pulse">
    <view class="h-14 bg-white" />
    <view class="mx-4 mt-4 h-44 rounded-xl bg-gray-200" />
    <view class="mx-4 mt-6 h-52 rounded-xl bg-gray-200" />
    <view class="mx-4 mt-6 grid grid-cols-2 gap-3">
      <view v-for="i in 4" :key="i" class="h-32 rounded-xl bg-gray-200" />
    </view>
    <view class="mx-4 mt-6 h-40 rounded-xl bg-gray-200" />
  </view>

  <!-- 错误状态 -->
  <view v-else-if="error" class="min-h-screen bg-[#FAF8F5] flex flex-col items-center justify-center px-4">
    <text class="text-5xl mb-4">😅</text>
    <text class="text-base font-medium text-[#2C2C2C] mb-2">加载失败</text>
    <text class="text-sm text-[#999] mb-6">{{ error }}</text>
    <view class="px-8 py-2.5 bg-[#C41E3A] text-white text-sm font-medium rounded-full" @click="fetchData">
      重新加载
    </view>
  </view>

  <!-- 主内容 -->
  <view v-else class="min-h-screen bg-[#FAF8F5] pb-6">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-40 bg-white/95 border-b border-[#E8E0D5]" style="backdrop-filter:blur(12px)">
      <view class="flex items-center justify-between px-4 h-14">
        <view class="p-1" @click="goBack">
          <text class="text-xl text-[#2C2C2C]">←</text>
        </view>
        <text class="font-semibold text-base text-[#2C2C2C]">积分中心</text>
        <text class="text-sm text-[#C41E3A]" @click="goTo('/pages/points/history/index')">明细</text>
      </view>
    </view>

    <!-- 积分余额卡片 -->
    <view class="px-4 pt-4">
      <view class="relative overflow-hidden p-5 rounded-xl" style="background:linear-gradient(135deg,#C9A96E,rgba(201,169,110,0.8),#CA8A04)">
        <!-- 装饰图案 -->
        <view class="absolute -right-6 -top-6 w-24 h-24 rounded-full bg-white/10" />
        <view class="absolute -right-2 top-8 w-16 h-16 rounded-full bg-white/5" />

        <view class="relative z-10">
          <view class="flex items-center gap-2 mb-2">
            <text class="text-lg text-white/80">🪙</text>
            <text class="text-white/80 text-sm">我的积分</text>
          </view>
          <view class="text-4xl font-bold text-white mb-1">
            {{ formatNumber(userPoints) }}
          </view>
          <text class="text-white/70 text-xs">100积分 = ¥1.00，可在兑换时抵扣</text>

          <!-- 积分数据 -->
          <view v-if="pointsInfo" class="flex items-center gap-6 mt-4 pt-4 border-t border-white/20">
            <view>
              <text class="text-white/60 text-xs">累计获取</text>
              <text class="text-white font-medium block">{{ formatNumber(pointsInfo.totalEarned) }}</text>
            </view>
            <view>
              <text class="text-white/60 text-xs">累计使用</text>
              <text class="text-white font-medium block">{{ formatNumber(pointsInfo.totalSpent) }}</text>
            </view>
            <view>
              <text class="text-white/60 text-xs">今日获取</text>
              <text class="text-white font-medium block">+{{ pointsInfo.todayEarned }}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 积分获取任务 -->
    <view class="px-4 mt-6">
      <view class="flex items-center justify-between mb-3">
        <text class="font-semibold text-base text-[#2C2C2C]">如何获取积分</text>
        <view class="flex items-center gap-1" @click="goTo('/pages/points/tasks/index')">
          <text class="text-xs text-[#999]">更多任务</text>
          <text class="text-xs text-[#999]">›</text>
        </view>
      </view>

      <view class="bg-white rounded-xl divide-y divide-[#E8E0D5] overflow-hidden">
        <view v-for="task in tasks" :key="task.id" class="flex items-center justify-between p-3">
          <view class="flex items-center gap-3">
            <view class="w-10 h-10 rounded-xl bg-[#C9A96E]/10 flex items-center justify-center">
              <text class="text-lg text-[#C9A96E]">{{ iconEmoji[task.icon] || '📅' }}</text>
            </view>
            <view>
              <view class="flex items-center gap-2">
                <text class="text-sm font-medium text-[#2C2C2C]">{{ task.title }}</text>
                <view class="text-[10px] px-1.5 py-0.5 bg-[#C9A96E]/10 text-[#C9A96E] rounded font-medium">
                  +{{ task.points }}积分
                </view>
              </view>
              <text class="text-xs text-[#999] mt-0.5 block">
                {{ task.limit }}
                <text v-if="task.current !== undefined">({{ task.current }}/{{ task.max }})</text>
              </text>
            </view>
          </view>

          <view v-if="task.completed" class="flex items-center gap-1 text-xs bg-green-500/10 text-green-500 rounded px-2 py-0.5 font-medium">
            <text>✅</text>
            <text>已完成</text>
          </view>
          <view v-else class="px-3 py-1.5 bg-[#C41E3A] text-white text-xs font-medium rounded-full" @click="handleTaskAction(task)">
            {{ task.action }}
          </view>
        </view>
      </view>
    </view>

    <!-- 积分兑换 -->
    <view class="px-4 mt-6">
      <view class="flex items-center justify-between mb-3">
        <text class="font-semibold text-base text-[#2C2C2C]">积分兑换</text>
        <view class="flex items-center gap-1" @click="goTo('/pages/points/exchange/index')">
          <text class="text-xs text-[#999]">全部商品</text>
          <text class="text-xs text-[#999]">›</text>
        </view>
      </view>

      <view class="grid grid-cols-2 gap-3">
        <view
          v-for="item in exchangeItems"
          :key="item.id"
          :class="['bg-white rounded-xl p-3', userPoints >= item.points ? 'cursor-pointer' : 'opacity-60']"
          @click="userPoints >= item.points && handleExchange(item)"
        >
          <view class="flex items-center gap-2 mb-2">
            <view class="w-8 h-8 rounded-lg bg-[#F5F1EB] flex items-center justify-center">
              <text class="text-base" :class="item.color || 'text-[#C9A96E]'">{{ iconEmoji[item.icon] || '🎁' }}</text>
            </view>
            <view class="text-[10px] px-1 py-0.5 border border-[#999]/30 text-[#999] rounded">
              剩{{ item.stock }}
            </view>
          </view>
          <text class="text-sm font-medium text-[#2C2C2C] block">{{ item.title }}</text>
          <view class="flex items-center justify-between mt-2">
            <view class="flex items-center gap-1">
              <text class="text-sm">🪙</text>
              <text class="text-sm font-medium text-[#C9A96E]">{{ item.points }}</text>
            </view>
            <view
              :class="[
                'px-2.5 py-1 text-xs font-medium rounded-full',
                userPoints >= item.points
                  ? 'bg-[#C41E3A] text-white'
                  : 'bg-[#F5F1EB] text-[#999]'
              ]"
            >
              {{ userPoints >= item.points ? '兑换' : '积分不足' }}
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 积分明细预览 -->
    <view class="px-4 mt-6">
      <view class="flex items-center justify-between mb-3">
        <text class="font-semibold text-base text-[#2C2C2C]">近期明细</text>
        <view class="flex items-center gap-1" @click="goTo('/pages/points/history/index')">
          <text class="text-xs text-[#999]">全部记录</text>
          <text class="text-xs text-[#999]">›</text>
        </view>
      </view>

      <view class="bg-white rounded-xl divide-y divide-[#E8E0D5] overflow-hidden">
        <view v-for="item in history" :key="item.id" class="flex items-center justify-between p-3">
          <view>
            <text class="text-sm text-[#2C2C2C] block">{{ item.title }}</text>
            <text class="text-xs text-[#999] mt-0.5 block">{{ item.time }}</text>
          </view>
          <text :class="['text-sm font-medium', item.type === 'earn' ? 'text-green-500' : 'text-[#C41E3A]']">
            {{ item.points > 0 ? '+' : '' }}{{ item.points }}
          </text>
        </view>
      </view>
    </view>

    <!-- 积分说明 -->
    <view class="px-4 mt-6">
      <view class="p-3 rounded-xl bg-[#F5F1EB]/50">
        <text class="text-xs text-[#999]">
          <text class="font-medium text-[#2C2C2C]">积分说明：</text>
          积分可用于兑换优惠券、国学币、会员体验及实物礼品。积分有效期为获取后12个月，请及时使用。
        </text>
      </view>
    </view>
  </view>

  <!-- 兑换确认弹窗 -->
  <view
    v-if="showExchangeModal && selectedItem"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/60"
    @click.stop
  >
    <view class="w-[85%] max-w-sm p-5 bg-white rounded-xl" style="animation:fadeInZoom 0.2s ease-out">
      <view v-if="!exchangeSuccess">
        <view class="text-center mb-4">
          <view class="w-16 h-16 rounded-full bg-[#C9A96E]/10 flex items-center justify-center mx-auto mb-3">
            <text class="text-3xl">🎁</text>
          </view>
          <text class="font-semibold text-lg text-[#2C2C2C] block">确认兑换</text>
          <text class="text-sm text-[#999] mt-1 block">
            使用 <text class="text-[#C9A96E] font-medium">{{ selectedItem.points }}积分</text> 兑换
          </text>
        </view>

        <view class="p-3 rounded-xl bg-[#F5F1EB]/50 mb-4">
          <text class="text-sm font-medium text-[#2C2C2C] block text-center">{{ selectedItem.title }}</text>
        </view>

        <text class="text-xs text-[#999] text-center block mb-4">
          兑换后积分余额：{{ formatNumber(userPoints - selectedItem.points) }}
        </text>

        <view class="flex gap-3">
          <view
            class="flex-1 py-2.5 bg-[#F5F1EB] text-[#2C2C2C] text-sm font-medium rounded-xl text-center"
            @click="closeModal"
          >
            取消
          </view>
          <view
            class="flex-1 py-2.5 bg-[#C41E3A] text-white text-sm font-medium rounded-xl text-center"
            @click="confirmExchange"
          >
            确认兑换
          </view>
        </view>
      </view>

      <view v-else class="text-center py-4">
        <view class="w-16 h-16 rounded-full bg-green-500/10 flex items-center justify-center mx-auto mb-3">
          <text class="text-3xl">✅</text>
        </view>
        <text class="font-semibold text-lg text-[#2C2C2C] block">兑换成功</text>
        <text class="text-sm text-[#999] mt-1 block">
          {{ selectedItem.title }} 已发放至您的账户
        </text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'

// ==================== 类型定义 ====================
interface PointsInfo {
  balance: number
  totalEarned: number
  totalSpent: number
  todayEarned: number
}

interface PointsTask {
  id: string
  icon: string
  title: string
  points: number
  limit: string
  current?: number
  max?: number
  completed: boolean
  action: string
}

interface PointsHistoryItem {
  id: string
  title: string
  type: 'earn' | 'spend'
  points: number
  time: string
}

interface PointsExchangeItem {
  id: string
  icon: string
  title: string
  points: number
  stock: number
  color?: string
}

// ==================== 图标映射（lucide-react → emoji） ====================
const iconEmoji: Record<string, string> = {
  Calendar: '📅',
  FileText: '📄',
  Users: '👥',
  ShoppingBag: '🛍️',
  Ticket: '🎫',
  Coins: '🪙',
  Crown: '👑',
  Package: '📦',
  Gift: '🎁',
}

// ==================== 状态 ====================
const loading = ref(true)
const error = ref<string | null>(null)
const pointsInfo = ref<PointsInfo | null>(null)
const tasks = ref<PointsTask[]>([])
const history = ref<PointsHistoryItem[]>([])
const exchangeItems = ref<PointsExchangeItem[]>([])
const showExchangeModal = ref(false)
const selectedItem = ref<PointsExchangeItem | null>(null)
const exchangeSuccess = ref(false)

// ==================== Mock 数据 ====================
const mockPointsInfo: PointsInfo = {
  balance: 1280,
  totalEarned: 5680,
  totalSpent: 4400,
  todayEarned: 45,
}

const mockTasks: PointsTask[] = [
  { id: '1', icon: 'Calendar', title: '每日签到', points: 5, limit: '每日1次', current: 1, max: 1, completed: true, action: '签到' },
  { id: '2', icon: 'FileText', title: '浏览文章', points: 10, limit: '每日3篇', current: 2, max: 3, completed: false, action: '去浏览' },
  { id: '3', icon: 'Users', title: '邀请好友', points: 50, limit: '每日上限5人', current: 0, max: 5, completed: false, action: '去邀请' },
  { id: '4', icon: 'ShoppingBag', title: '购买课程', points: 100, limit: '每单1次', completed: false, action: '去购买' },
]

const mockHistory: PointsHistoryItem[] = [
  { id: '1', title: '每日签到', type: 'earn', points: 5, time: '今天 09:00' },
  { id: '2', title: '兑换优惠券', type: 'spend', points: -100, time: '昨天 15:30' },
  { id: '3', title: '完成悬赏回答', type: 'earn', points: 20, time: '前天 14:00' },
  { id: '4', title: '邀请好友注册', type: 'earn', points: 50, time: '2024/12/20 10:00' },
]

const mockExchangeItems: PointsExchangeItem[] = [
  { id: '1', icon: 'Ticket', title: '10元优惠券', points: 100, stock: 50 },
  { id: '2', icon: 'Coins', title: '国学币50枚', points: 500, stock: 100 },
  { id: '3', icon: 'Crown', title: '月卡会员', points: 1000, stock: 20 },
  { id: '4', icon: 'Package', title: '国学书籍盲盒', points: 2000, stock: 10 },
]

// ==================== 计算属性 ====================
const userPoints = ref(0)

// ==================== 方法 ====================
function formatNumber(num: number): string {
  return num.toLocaleString()
}

function goBack() {
  uni.navigateBack()
}

function goTo(url: string) {
  uni.navigateTo({ url })
}

async function fetchData() {
  loading.value = true
  error.value = null
  try {
    // 模拟网络请求
    await new Promise(resolve => setTimeout(resolve, 600))
    pointsInfo.value = mockPointsInfo
    tasks.value = mockTasks
    history.value = mockHistory
    exchangeItems.value = mockExchangeItems
    userPoints.value = mockPointsInfo.balance
  } catch (err) {
    error.value = '网络异常，请检查网络连接后重试'
  } finally {
    loading.value = false
  }
}

function handleExchange(item: PointsExchangeItem) {
  if (pointsInfo.value && userPoints.value >= item.points) {
    selectedItem.value = item
    showExchangeModal.value = true
  }
}

function closeModal() {
  showExchangeModal.value = false
  exchangeSuccess.value = false
  selectedItem.value = null
}

async function confirmExchange() {
  if (!selectedItem.value) return

  // 模拟兑换请求
  await new Promise(resolve => setTimeout(resolve, 500))
  exchangeSuccess.value = true

  // 更新积分余额
  if (pointsInfo.value) {
    pointsInfo.value.balance -= selectedItem.value.points
    userPoints.value = pointsInfo.value.balance
  }

  setTimeout(() => {
    closeModal()
  }, 2000)
}

function handleTaskAction(task: PointsTask) {
  uni.showToast({ title: `前往${task.action}`, icon: 'none' })
}

// ==================== 生命周期 ====================
onMounted(() => {
  fetchData()
})
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
@keyframes fadeInZoom {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.animate-pulse {
  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}
</style>
