<template>
  <view class="min-h-screen bg-background">
    <!-- 顶部导航 -->
    <view class="sticky top-0 z-10 bg-background border-b border-[#E8E0D5]">
      <view class="flex items-center justify-between px-4 py-3">
        <view class="p-1" @click="goBack">
          <text class="text-xl">←</text>
        </view>
        <text class="text-lg font-semibold">积分任务</text>
        <view class="w-8" />
      </view>
    </view>

    <!-- Loading骨架 -->
    <view v-if="loading">
      <view class="p-4 space-y-4">
        <view class="h-36 rounded-2xl" style="background: #e5e5e5; animation: pulse 2s infinite" />
        <view class="space-y-3">
          <view v-for="i in 4" :key="i" class="h-20 rounded-xl" style="background: #e5e5e5; animation: pulse 2s infinite" />
        </view>
      </view>
    </view>

    <!-- 错误状态 -->
    <view v-else-if="error" class="flex flex-col items-center justify-center py-20">
      <text class="text-3xl mb-3">⚠</text>
      <text class="text-muted-foreground mb-4">{{ error }}</text>
      <view class="px-6 py-2 bg-primary text-white rounded-full text-sm" @click="loadData">重试</view>
    </view>

    <template v-else>
      <view class="pb-20">
        <!-- 积分总览 -->
        <view v-if="pointsInfo" class="mx-4 mt-4 p-5 rounded-2xl text-white" style="background: linear-gradient(135deg, #C9A96E, #d97706)">
          <view class="flex items-start justify-between mb-4">
            <view>
              <text class="text-sm block mb-1" style="opacity: 0.8">当前积分</text>
              <text class="text-4xl font-bold block">{{ pointsInfo.balance.toLocaleString() }}</text>
              <text class="text-sm block mt-1" style="opacity: 0.7">今日已获 +{{ pointsInfo.todayEarned }}</text>
            </view>
            <view class="px-3 py-1.5 rounded-full text-sm font-medium flex items-center gap-1" style="background: rgba(255,255,255,0.2)" @click="goToExchange">
              积分兑换 <text>›</text>
            </view>
          </view>
          <!-- 任务完成进度 -->
          <view class="space-y-1.5">
            <view class="flex items-center justify-between text-sm">
              <text style="opacity: 0.8">今日任务进度</text>
              <text class="font-semibold">{{ completedCount }}/{{ totalTasks }}</text>
            </view>
            <view class="h-2 rounded-full" style="background: rgba(255,255,255,0.2)">
              <view class="h-2 rounded-full bg-white" :style="{ width: totalTasks > 0 ? (completedCount / totalTasks) * 100 + '%' : '0%' }" />
            </view>
          </view>
        </view>

        <!-- 任务列表 -->
        <view class="mx-4 mt-5">
          <text class="text-sm font-semibold mb-3 block">可完成任务</text>
          <view class="space-y-2">
            <view v-for="(task, idx) in tasks" :key="task.id" class="p-4 bg-card rounded-xl border border-[#E8E0D5]" :class="task.completed ? 'opacity-60' : ''">
              <view class="flex items-center gap-3">
                <view class="w-10 h-10 rounded-full flex items-center justify-center shrink-0" :class="TASK_COLORS[idx % TASK_COLORS.length]">
                  <text>{{ TASK_ICONS[task.icon] || '📅' }}</text>
                </view>
                <view class="flex-1 min-w-0">
                  <view class="flex items-center gap-2">
                    <text class="font-medium">{{ task.title }}</text>
                    <text class="text-[10px] px-1.5 py-0 rounded" style="background: rgba(251,191,36,0.2); color: #92400e">+{{ task.points }} 积分</text>
                  </view>
                  <text class="text-xs text-muted-foreground mt-0.5 block">{{ task.limit }}</text>
                  <view v-if="task.max !== undefined && task.current !== undefined" class="mt-2">
                    <view class="flex items-center justify-between text-xs text-muted-foreground mb-1">
                      <text>进度</text>
                      <text>{{ task.current }}/{{ task.max }}</text>
                    </view>
                    <view class="h-1.5 rounded-full bg-secondary">
                      <view class="h-1.5 rounded-full bg-primary" :style="{ width: (task.current / task.max) * 100 + '%' }" />
                    </view>
                  </view>
                </view>
                <view class="shrink-0">
                  <view v-if="task.completed" class="flex items-center gap-1 text-xs text-green-600">
                    <text>✓</text>
                    <text>已完成</text>
                  </view>
                  <view v-else class="h-7 px-3 rounded-lg text-xs text-white bg-primary flex items-center" @click="handleComplete(task)">
                    <text>{{ completing === task.id ? '...' : task.action }}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 其他获取方式 -->
        <view class="mx-4 mt-6 p-4 rounded-xl bg-muted/50">
          <text class="text-sm font-semibold mb-2 block">更多积分获取方式</text>
          <view class="text-xs text-muted-foreground space-y-1">
            <text class="block">• 每次消费 ¥1 = 1 积分</text>
            <text class="block">• 邀请好友注册 = 100 积分</text>
            <text class="block">• 参与平台活动可获得额外积分</text>
          </view>
        </view>
      </view>
    </template>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

interface PointsInfo { balance: number; totalEarned: number; totalSpent: number; todayEarned: number }

interface PointsTask {
  id: number; title: string; points: number; limit: string
  icon: string; action: string; completed: boolean
  max?: number; current?: number
}

const TASK_ICONS: Record<string, string> = { Calendar: '📅', FileText: '📄', Users: '👥', ShoppingBag: '🛒' }
const TASK_COLORS = ['text-primary bg-primary/10', 'text-blue-600 bg-blue-50', 'text-green-600 bg-green-50', 'text-amber-600 bg-amber-50', 'text-purple-600 bg-purple-50']

const loading = ref(true)
const error = ref<string | null>(null)
const pointsInfo = ref<PointsInfo | null>(null)
const tasks = ref<PointsTask[]>([])
const completing = ref<number | null>(null)

const completedCount = computed(() => tasks.value.filter(t => t.completed).length)
const totalTasks = computed(() => tasks.value.length)

onMounted(() => { loadData() })

const loadData = async () => {
  loading.value = true
  error.value = null
  try {
    await new Promise(r => setTimeout(r, 500))
    pointsInfo.value = { balance: 680, totalEarned: 1200, totalSpent: 520, todayEarned: 15 }
    tasks.value = [
      { id: 1, title: '每日签到', points: 5, limit: '每日1次', icon: 'Calendar', action: '签到', completed: false },
      { id: 2, title: '浏览文章', points: 10, limit: '每日上限3篇', icon: 'FileText', action: '去浏览', completed: false, max: 3, current: 1 },
      { id: 3, title: '回答问题', points: 20, limit: '每日上限5个', icon: 'Users', action: '去回答', completed: false, max: 5, current: 0 },
      { id: 4, title: '邀请好友', points: 100, limit: '无上限', icon: 'Users', action: '去邀请', completed: false },
      { id: 5, title: '购买课程', points: 50, limit: '每日1次', icon: 'ShoppingBag', action: '去购买', completed: true },
    ]
  } catch {
    error.value = '加载失败，请重试'
  } finally {
    loading.value = false
  }
}

const handleComplete = async (task: PointsTask) => {
  if (task.completed || completing.value !== null) return
  completing.value = task.id
  try {
    await new Promise(r => setTimeout(r, 500))
    tasks.value = tasks.value.map(t => t.id === task.id ? { ...t, completed: true } : t)
    if (pointsInfo.value) {
      pointsInfo.value = {
        ...pointsInfo.value,
        balance: pointsInfo.value.balance + task.points,
        todayEarned: pointsInfo.value.todayEarned + task.points,
      }
    }
  } finally {
    completing.value = null
  }
}

function goBack() { uni.navigateBack() }
function goToExchange() { uni.navigateTo({ url: '/pages/points/exchange/index' }) }
</script>

<style scoped>
/* 样式由 Tailwind 处理 */
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
</style>
