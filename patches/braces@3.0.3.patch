diff --git a/lib/depth-guard.js b/lib/depth-guard.js
new file mode 100644
index 000000000..330e6e0ea
--- /dev/null
+++ b/lib/depth-guard.js
@@ -0,0 +1,24 @@
+'use strict';
+
+// 限定所有公开AST入口的嵌套深度，避免递归访问耗尽原生调用栈。
+const MAX_DEPTH = 128;
+const fail = () => {
+  const error = new SyntaxError('Brace pattern exceeds safe AST depth or contains a cycle');
+  error.code = 'BRACES_AST_DEPTH_LIMIT';
+  throw error;
+};
+const assertDepth = ast => {
+  const pending = [[ast, 0]];
+  const seen = new WeakSet();
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (depth > MAX_DEPTH) fail();
+    if (!node || typeof node !== 'object') continue;
+    if (seen.has(node)) fail();
+    seen.add(node);
+    if (Array.isArray(node.nodes)) {
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
+module.exports = { assertDepth, MAX_DEPTH, fail };
