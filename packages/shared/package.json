{
  "name": "@guoxue/shared",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./paipan": {
      "types": "./dist/paipan/index.d.ts",
      "default": "./dist/paipan/index.js"
    },
    "./paipan/*": {
      "types": "./dist/paipan/*.d.ts",
      "default": "./dist/paipan/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
