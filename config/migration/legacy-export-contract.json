          "targetFile": "users.csv",
          "targetColumn": "legacy_user_id"
        }
      ]
    },
    {
      "name": "stations.csv",
      "required": true,
      "minRows": 0,
      "keyColumns": ["legacy_station_id"],
      "requiredColumns": [
        "legacy_station_id",
        "legacy_owner_user_id",
        "station_code",
        "station_name",
