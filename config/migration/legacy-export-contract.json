      "nonNegativeDecimalColumns": ["amount", "pay_amount"],
      "timestampColumns": ["paid_at", "refunded_at", "updated_at"],
      "allowedValues": {
        "order_type": ["MEMBER", "COURSE", "OTHER"],
        "status": ["PENDING", "PAID", "COMPLETED", "REFUNDED", "CANCELLED"]
      },
      "foreignKeys": [
        {
          "column": "legacy_user_id",
          "targetFile": "users.csv",
          "targetColumn": "legacy_user_id"
        }
      ]
    },
    {
      "name": "course_entitlements.csv",
      "required": true,
      "minRows": 0,
      "keyColumns": ["legacy_entitlement_id"],
