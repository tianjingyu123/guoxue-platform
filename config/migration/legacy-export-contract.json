{
  "contractVersion": 1,
  "sourceSystem": "choofine_rebuguoxue",
  "format": "UTF-8 CSV（带表头；时间必须含时区；手机号按文本导出）",
  "files": [
    {
      "name": "users.csv",
      "required": true,
      "minRows": 1,
      "keyColumns": ["legacy_user_id"],
      "retainColumns": ["legacy_user_id"],
      "requiredColumns": [
        "legacy_user_id",
        "phone",
        "nickname",
        "avatar",
        "status",
        "created_at",
        "updated_at"
      ],
      "oneOfColumns": [["phone", "nickname"]],
      "optionalPatternColumns": {
        "phone": "^1\\d{10}$"
      },
      "timestampColumns": ["created_at", "updated_at"],
      "allowedValues": {
        "status": ["ACTIVE", "DISABLED", "BANNED"]
      }
    },
    {
      "name": "wechat_auth.csv",
      "required": true,
      "minRows": 0,
      "keyColumns": ["legacy_auth_id"],
      "requiredColumns": [
        "legacy_auth_id",
        "legacy_user_id",
        "openid",
        "unionid",
        "app_context",
        "created_at",
        "updated_at"
      ],
      "oneOfColumns": [["openid", "unionid"]],
      "timestampColumns": ["created_at", "updated_at"],
      "foreignKeys": [
        {
          "column": "legacy_user_id",
          "targetFile": "users.csv",
          "targetColumn": "legacy_user_id"
        }
      ]
    },
    {
      "name": "members.csv",
      "required": true,
      "minRows": 0,
