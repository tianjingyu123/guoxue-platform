        "member_expire",
        "amount",
        "order_no",
        "paid_at",
        "updated_at"
      ],
      "timestampColumns": ["member_expire", "paid_at", "updated_at"],
      "nonNegativeDecimalColumns": ["amount"],
      "allowedValues": {
        "member_level": ["MONTHLY", "QUARTERLY", "YEARLY", "LIFETIME"]
      },
      "foreignKeys": [
        {
          "column": "legacy_user_id",
          "targetFile": "users.csv",
          "targetColumn": "legacy_user_id"
        }
      ]
    },
    {
      "name": "wallet_balances.csv",
      "required": true,
      "minRows": 0,
