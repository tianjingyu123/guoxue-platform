        "legacy_order_id",
        "course_title",
        "paid_at",
        "expires_at",
        "status",
        "updated_at"
      ],
      "timestampColumns": ["paid_at", "expires_at", "updated_at"],
      "allowedValues": {
        "status": ["ACTIVE", "EXPIRED", "REFUNDED", "CANCELLED"]
      },
      "foreignKeys": [
        {
          "column": "legacy_user_id",
          "targetFile": "users.csv",
          "targetColumn": "legacy_user_id"
        },
        {
          "column": "legacy_order_id",
          "targetFile": "orders.csv",
          "targetColumn": "legacy_order_id",
