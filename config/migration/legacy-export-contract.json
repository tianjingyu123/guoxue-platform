        "amount",
        "balance_after",
        "order_no",
        "occurred_at",
        "updated_at"
      ],
      "decimalColumns": ["amount", "balance_after"],
      "timestampColumns": ["occurred_at", "updated_at"],
      "foreignKeys": [
        {
          "column": "legacy_user_id",
          "targetFile": "users.csv",
          "targetColumn": "legacy_user_id"
        }
      ]
    },
    {
