{
  "schemaVersion": 1,
  "kind": "guoxue-business-journeys",
  "apiOrigin": "https://pre-api.example.com",
  "qaPrefix": "QA_RELEASE_ACCEPTANCE",
  "auth": {
    "user": "QA_USER_TOKEN",
    "merchant": "QA_MERCHANT_TOKEN"
  },
  "secrets": {},
  "journeys": [
    {
      "id": "public-readiness",
      "mode": "read",
      "steps": [
        {
          "id": "health",
          "method": "GET",
          "path": "/api/v1/health",
          "expectStatus": [200],
          "expectJson": [
            {
              "pointer": "/data/status",
              "exists": true
            }
          ]
        },
        {
          "id": "product-catalog",
          "method": "GET",
          "path": "/api/v1/shop/products?page=1&pageSize=1",
          "expectStatus": [200]
        }
      ]
    },
    {
      "id": "authenticated-user",
      "mode": "read",
      "steps": [
        {
          "id": "current-user",
          "method": "GET",
          "path": "/api/v1/auth/me",
          "auth": "user",
          "expectStatus": [200]
        }
      ]
    },
    {
      "id": "merchant-operations",
      "mode": "read",
      "steps": [
        {
          "id": "merchant-dashboard",
          "method": "GET",
          "path": "/api/v1/merchant-backend/dashboard",
          "auth": "merchant",
          "expectStatus": [200]
        },
        {
          "id": "inventory-overview",
          "method": "GET",
          "path": "/api/v1/merchant-backend/inventory/overview",
          "auth": "merchant",
          "expectStatus": [200]
        },
        {
          "id": "purchase-orders",
          "method": "GET",
          "path": "/api/v1/merchant-backend/purchase-orders?page=1&pageSize=1",
          "auth": "merchant",
          "expectStatus": [200]
        }
      ]
    }
  ]
}
