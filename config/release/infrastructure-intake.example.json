    "certificateRenewalOwner": "待填写",
    "certificateFallbackOwner": "待填写",
    "certificateRenewalProcedureVerified": false,
    "certificatePublicHandshakeVerified": false
  },
  "storage": {
    "provider": "cos",
    "bucket": "pending",
    "region": "pending",
    "privateRead": true,
    "corsConfigured": false,
    "lifecycleConfigured": false,
    "signedUrlVerified": false
  },
  "migration": {
    "sourceDatabaseAccessVerified": false,
    "targetDatabaseAccessVerified": false,
    "dnsChangeAccessVerified": false,
