{
  "schemaVersion": 2,
  "kind": "guoxue-new-infrastructure-intake",
  "deployTarget": "tencent",
  "server": {
    "provider": "腾讯云",
    "region": "ap-beijing",
    "osFamily": "linux",
    "architecture": "x86_64",
    "cpuCores": 4,
    "memoryMb": 8192,
    "diskGb": 100,
    "ingressMode": "clb",
    "clbId": "pending",
    "sshUser": "deploy",
    "sshHostFingerprint": "pending",
    "securityGroupReviewed": false
  },
  "database": {
    "provider": "腾讯云 PostgreSQL",
