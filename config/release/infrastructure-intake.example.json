  "operations": {
    "backupOwner": "待填写",
    "cutoverOwner": "待填写",
    "rollbackOwner": "待填写",
    "technicalApprover": "待填写",
    "businessApprover": "待填写",
    "monitoringConfigured": false,
    "alertTested": false,
    "restoreDrillCompleted": false
