# 本文件只列迁移关键项。复制到服务器私有目录后填写，严禁提交真实密钥。
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@NEW_DB_HOST:5432/guoxue?sslmode=require
REDIS_URL=rediss://USER:PASSWORD@NEW_REDIS_HOST:6380
JWT_SECRET=change-me
JWT_PREVIOUS_SECRETS=
ENCRYPTION_KEY=change-me-exactly-32-bytes
BIGSCREEN_SECRET=change-me

PUBLIC_DOMAIN=api.example.com
PUBLIC_API_URL=https://api.example.com
PUBLIC_H5_URL=https://api.example.com/h5/
PUBLIC_ASSET_ORIGIN=https://cdn.example.com
COOKIE_DOMAIN=.example.com

# 双域并行期间同时允许新旧来源，稳定后删除旧来源。
CORS_ORIGIN=https://api.example.com,https://admin.example.com,https://old.example.com
WS_CORS_ORIGIN=https://api.example.com,https://admin.example.com
MIGRATION_OLD_ORIGINS=https://old.example.com

VITE_API_URL=https://api.example.com/api/v1
VITE_PUBLIC_H5_URL=https://api.example.com/h5/
VITE_PUBLIC_ASSET_ORIGIN=https://cdn.example.com

WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/v1/shop/pay/notify
